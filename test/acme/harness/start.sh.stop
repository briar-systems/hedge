#!/bin/sh
# stop every process started by start.sh.
set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
run="$root/.tools/run"
for name in proxy pebble challtestsrv; do
    if [ -f "$run/$name.pid" ]; then
        kill "$(cat "$run/$name.pid")" 2>/dev/null || true
        rm -f "$run/$name.pid"
    fi
done
exit 0
