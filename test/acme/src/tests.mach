    acme.close(?deployment.manager);
    serve.stop(?quic_controls, ?server.runtime);
    fs.remove_all(?a, directory::Path);
    ret 0;
}

val MANAGEMENT_PORT: u16 = 8055;

fun put_str(target: *u8, at: usize, value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) {
        target[at + i] = value[i];
        i = i + 1;
    }
    ret at + i;
}

fun put_number(target: *u8, at: usize, value: usize) usize {
    var digits: [20]u8;
    var count: usize = 0;
    var remaining: usize = value;
    for (true) {
        digits[count] = ('0' + (remaining % 10)::u8);
        count = count + 1;
        remaining = remaining / 10;
        if (remaining == 0) { brk; }
    }
    var i: usize = 0;
    for (i < count) {
        target[at + i] = digits[count - 1 - i];
        i = i + 1;
    }
    ret at + count;
}

fun send_all(stream: *tcp.Stream, data: *u8, len: usize) bool {
    var sent: usize = 0;
    for (sent < len) {
        val written: res[usize, io_error.Error] = tcp.stream_write(stream,
            ?data[sent], len - sent);
        if (sel written.err) { ret false; }
        val count: usize = written.ok;
        if (count == 0) { ret false; }
        sent = sent + count;
    }
    ret true;
}

# posts one json document to the challenge test server's management api, which
# is what publishes the dns record the authority then resolves
fun manage(path: str, body: *u8, len: usize) bool {
    var head: [512]u8;
    var at: usize = put_str(?head[0], 0, "POST ");
    at = put_str(?head[0], at, path);
    at = put_str(?head[0], at,
        " HTTP/1.1\r\nhost: 127.0.0.1:8055\r\nconnection: close\r\ncontent-type: application/json\r\ncontent-length: ");
    at = put_number(?head[0], at, len);
    at = put_str(?head[0], at, "\r\n\r\n");
    val connected: res[tcp.Stream, io_error.Error] = tcp.connect(
        ip.endpoint(127, 0, 0, 1, MANAGEMENT_PORT));
    if (sel connected.err) { ret false; }
    var stream: tcp.Stream = connected.ok;
    tcp.stream_set_read_timeout(?stream, 5000);
    var ok: bool = send_all(?stream, ?head[0], at)
        && send_all(?stream, body, len);
    var reply: [1024]u8;
    var total: usize = 0;
    for (ok && total < 1024) {
        val received: res[usize, io_error.Error] = tcp.stream_read(?stream,
            ?reply[total], 1024 - total);
        if (sel received.err) { brk; }
        val count: usize = received.ok;
        if (count == 0) { brk; }
        total = total + count;
    }
    tcp.stream_close(?stream);
    ret ok && total > 12 && reply[9] == '2';
}

rec Zone {
    published: usize;
    withdrawn: usize;
    body:      [512]u8;
}

fun zone_document(zone: *Zone, name: view.View, value: view.View) usize {
    var at: usize = put_str(?zone.body[0], 0, "{\"host\":\"");
    var i: usize = 0;
    for (i < name.len) {
        zone.body[at + i] = name.data[i];
        i = i + 1;
    }
    at = at + name.len;
    at = put_str(?zone.body[0], at, "\",\"value\":\"");
    i = 0;
    for (i < value.len) {
        zone.body[at + i] = value.data[i];
        i = i + 1;
    }
    at = at + value.len;
    ret put_str(?zone.body[0], at, "\"}");
}

fun zone_publish(context: ptr, name: view.View, value: view.View) bool {
    val zone: *Zone = context::*Zone;
    val length: usize = zone_document(zone, name, value);
    if (!manage("/set-txt", ?zone.body[0], length)) { ret false; }
    zone.published = zone.published + 1;
    ret true;
}

fun zone_withdraw(context: ptr, name: view.View, value: view.View) bool {
    val zone: *Zone = context::*Zone;
    var body: [512]u8;
    var at: usize = put_str(?body[0], 0, "{\"host\":\"");
    var i: usize = 0;
    for (i < name.len) {
        body[at + i] = name.data[i];
        i = i + 1;
    }
    at = at + name.len;
    at = put_str(?body[0], at, "\"}");
    zone.withdrawn = zone.withdrawn + 1;
    ret manage("/clear-txt", ?body[0], at);
}

test "live: dns-01 issues a certificate through a publisher" {
    var quic_controls: quic_runtime.ControlView;
    var memory: [262144]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 262144))) { ret 1; }
    val directory: str = "out/acme-dns01";
    fs.remove_all(?a, directory::Path);

    var client: Client;
    val name_len: usize = unique_name(?client, "dns01");
    var deployment: Deployment;
    var i: usize = 0;
    for (i < name_len) {
        deployment.name[i] = client.name[i];
        i = i + 1;
    }
    configure_acme(?deployment, directory, name_len);
    deployment.graph.acme.challenge = schema.CHALLENGE_DNS_01;
    var zone: Zone;
    zone.published = 0;
    zone.withdrawn = 0;
    val publisher: challenge.Publisher = challenge.Publisher{
        ctx: (?zone)::ptr, publish: zone_publish, withdraw: zone_withdraw};
    # http-01 has no route here on purpose: the only way this certificate can
    # be issued is through the published record
    if (acme.open(?deployment.manager, ?a, ?deployment.graph) != acme.INVALID) {
        ret 2;
    }
    if (acme.open_with_publisher(?deployment.manager, ?a, ?deployment.graph,
        publisher) != acme.OK) { ret 3; }
    var server: Server;
    if (!boot_at(?server, acme.challenge_table(?deployment.manager),
        "127.0.0.1:0", 0)) {
        acme.close(?deployment.manager);
        ret 4;
    }
    if (!drive_manager(?server, ?deployment, acme.INSTALLING)) {
        acme.close(?deployment.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 5;
    }
    if (zone.published != 1 || zone.withdrawn != 1) {
        acme.close(?deployment.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 6;
    }
    if (acme.chain_count(?deployment.manager) < 2) {
        acme.close(?deployment.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 7;
    }
    acme.installed(?deployment.manager, wall_now());
    acme.close(?deployment.manager);
    serve.stop(?quic_controls, ?server.runtime);
    fs.remove_all(?a, directory::Path);
    ret 0;
}

fun configure_tls_alpn(deployment: *Deployment) {
    val graph: *schema.Graph = ?deployment.graph;
    graph.features.tls = true;
    graph.limits.max_connections = POOL;
    graph.limits.max_connections_per_peer = POOL;
    graph.listener_count = 1;
    val public: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?public.name, "public");
    schema.set_text(?public.address, "127.0.0.1:5001");
    schema.set_text(?public.tls_policy, "public");
    schema.clear_text(?public.budget);
    public.transport = schema.TRANSPORT_TCP;
    public.protocols = schema.PROTOCOL_HTTP1;
    public.backlog = 16;
    public.accept_depth = 4;
    graph.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?graph.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate,
        "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key,
        "test/interop/fixtures/api.key");
    policy.has_default = true;
    schema.set_text(?policy.default_name, "api.example.com");
    graph.host_count = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 0;
    graph.service_count = 1;
    val fixed_service: *schema.Service = ?graph.services[0];
    schema.set_text(?fixed_service.name, "fixed");
    fixed_service.kind = schema.SERVICE_FIXED;
    schema.set_text(?fixed_service.target, "ok\n");
    schema.clear_text(?fixed_service.budget);
    schema.set_text(?fixed_service.content_type, "text/plain");
    fixed_service.status = 200;
    graph.route_count = 1;
    schema.set_text(?graph.routes[0].name, "all");
    schema.set_text(?graph.routes[0].host, "site");
    schema.set_text(?graph.routes[0].path, "/**");
    schema.set_text(?graph.routes[0].service, "fixed");
    schema.clear_text(?graph.routes[0].budget);
}

fun drive_composition(runtime: *composition.Runtime, wanted: acme.State) bool {
    var quic_controls: quic_runtime.ControlView;
    var rounds: usize = 0;
    val deadline: i64 = monotonic_ns() + 120000000000;
    for (rounds < MAX_ROUNDS) {
        serve.poll(?quic_controls, ?runtime.serving, 1);
        if (acme.state(runtime.certificates) == wanted) { ret true; }
        if (acme.failure_count(runtime.certificates) != 0) {
            val cause: problem.Error = acme.last_failure(runtime.certificates);
            var detail: str = cause.detail;
            if (detail == nil) { detail = ""; }
            print.eprintlnf("manager failed: kind {} code {} status {} {}",
                cause.kind::i64, cause.code::i64, cause.http.status::i64,
                detail);
            ret false;
        }
        if (monotonic_ns() > deadline) { ret false; }
        rounds = rounds + 1;
    }
    ret false;
}

test "live: production composition issues through its TLS-ALPN credential" {
    var controls: composition.Controls;
    var a: allocator.Allocator;
    if (!page_ok(page.make(?a))) { ret 1; }
    val directory: str = "out/acme-tlsalpn01";
    fs.remove_all(?a, directory::Path);
    var client: Client;
    val name_len: usize = unique_name(?client, "tlsalpn01");
    var deployment: Deployment;
    var i: usize = 0;
    for (i < name_len) {
        deployment.name[i] = client.name[i];
        i = i + 1;
    }
    configure_acme(?deployment, directory, name_len);
    deployment.graph.acme.challenge = schema.CHALLENGE_TLS_ALPN_01;
    configure_tls_alpn(?deployment);
    val runtime_memory: res[*composition.Runtime, allocator.Error] =
        allocator.allocate[composition.Runtime](?a, 1);
    val storage_memory: res[*composition.PlanStorage, allocator.Error] =
        allocator.allocate[composition.PlanStorage](?a, 1);
    if (sel runtime_memory.err) { ret 2; }
    if (sel storage_memory.err) { ret 2; }
    val composed: *composition.Runtime =
        runtime_memory.ok;
    val plan_storage: *composition.PlanStorage =
        storage_memory.ok;
    var diagnostics: schema.Diagnostics;
    val started: composition.StartReport = composition.start(composed, ?controls, ?a,
        ?deployment.graph, 1, plan_storage, ?diagnostics,
        composition.default_options());
    if (started.status != composition.START_OK) {
        print.eprintln(started.detail);
        ret 3;
    }
    if (!drive_composition(composed, acme.INSTALLING)) {
        composition.stop(composed, ?controls);
        ret 4;
    }
    val listener_policy: *hedge_tls.Policy = hedge_tls.policy_at(
        composed.certificate_policy);
    if (composed.alpn_challenge.presented != 1
     || composed.alpn_challenge.withdrawn != 1
     || tlsalpn.presenting(?composed.alpn_challenge)
     || listener_policy == nil || listener_policy.challenge_live
     || listener_policy.challenge_retiring
     || acme.chain_count(composed.certificates) < 2) {
        composition.stop(composed, ?controls);
        ret 5;
    }
    if (composition.install_certificate(composed, wall_now()) != hedge_tls.OK
     || acme.issued_count(composed.certificates) != 1
     || acme.state(composed.certificates) != acme.IDLE) {
        composition.stop(composed, ?controls);
        ret 6;
    }
    val stopped: composition.StopReport = composition.stop(composed, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0
     || stopped.cleanup_failures != 0 || hedge_tls.count() != 0) { ret 7; }
    fs.remove_all(?a, directory::Path);
    ret 0;
}

test "live: a renewed certificate rotates without disturbing a live connection" {
    var quic_controls: quic_runtime.ControlView;
    var memory: [262144]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 262144))) { ret 1; }
    val directory: str = "out/acme-rotation";
    fs.remove_all(?a, directory::Path);
    var client: Client;
    val name_len: usize = unique_name(?client, "rotate");
    var deployment: Deployment;
    var i: usize = 0;
    for (i < name_len) {
        deployment.name[i] = client.name[i];
        i = i + 1;
    }
    configure_acme(?deployment, directory, name_len);
    if (acme.open(?deployment.manager, ?a, ?deployment.graph) != acme.OK) {
        ret 2;
    }
    var server: Server;
    if (!boot(?server, acme.challenge_table(?deployment.manager))) {
        acme.close(?deployment.manager);
        ret 3;
    }
    if (!drive_manager(?server, ?deployment, acme.INSTALLING)) {
        acme.close(?deployment.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 4;
    }
    var tls_graph: schema.Graph;
    schema.reset_graph(?tls_graph);
    tls_graph.tls_policy_count = 1;
    val configured: *schema.TlsPolicy = ?tls_graph.tls_policies[0];
    schema.set_text(?configured.name, "managed");
    configured.identity_count = 1;
    schema.set_text(?configured.identities[0].server_name, "api.example.com");
    schema.set_text(?configured.identities[0].certificate,
        "test/interop/fixtures/api.pem");
    schema.set_text(?configured.identities[0].key, "test/interop/fixtures/api.key");
    configured.has_default = true;
    schema.set_text(?configured.default_name, "api.example.com");
    hedge_tls.reset();
    if (hedge_tls.publish("public", configured, schema.PROTOCOL_HTTP1)
        != hedge_tls.OK || hedge_tls.install_acme(0, ?deployment.manager)
        != hedge_tls.OK) {
        acme.close(?deployment.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 5;
    }
    acme.installed(?deployment.manager, wall_now());

    # a connection established on the first certificate holds its lease for
    # its whole life
    val listener_policy: *hedge_tls.Policy = hedge_tls.policy_at(0);
    var established: protocol.Held;
    if (listener_policy == nil || protocol.acquire(?listener_policy.bindings,
        (?deployment.name[0])::str, ?established) != protocol.OK) {
        acme.close(?deployment.manager);
        serve.stop(?quic_controls, ?server.runtime);
        hedge_tls.destroy();
        ret 7;
    }
    val original: *u8 = established.lease.identity.chain.certificates.der;

    # the certificate is renewed while that connection is still open
    acme.close(?deployment.manager);
    var renewing: Deployment;
    i = 0;
    for (i < name_len) {
        renewing.name[i] = deployment.name[i];
        i = i + 1;
    }
    configure_acme(?renewing, directory, name_len);
    renewing.graph.acme.renew_before_seconds = 31536000;
    if (acme.open(?renewing.manager, ?a, ?renewing.graph) != acme.OK) {
        serve.stop(?quic_controls, ?server.runtime);
        ret 8;
    }
    if (!handler.bind(?server.binding,
        acme.challenge_table(?renewing.manager))) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 9;
    }
    if (!drive_manager(?server, ?renewing, acme.INSTALLING)) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 10;
    }
    if (hedge_tls.install_acme(0, ?renewing.manager) != hedge_tls.OK) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 13;
    }

    # the established connection still holds the certificate it handshook on
    if (established.lease.identity.chain.certificates.der != original) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 14;
    }
    # a connection that arrives after the rotation gets the renewed one
    var arriving: protocol.Held;
    if (protocol.acquire(?listener_policy.bindings, (?renewing.name[0])::str, ?arriving)
        != protocol.OK) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 16;
    }
    if (arriving.lease.identity.chain.certificates.der == original) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 17;
    }
    # and the old generation stays alive until its last lease is gone
    if (hedge_tls.retired_reclaimable(0)) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 18;
    }
    if (protocol.release(?established) != protocol.OK) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 19;
    }
    if (!hedge_tls.retired_reclaimable(0)) {
        acme.close(?renewing.manager);
        serve.stop(?quic_controls, ?server.runtime);
        ret 20;
    }
    protocol.release(?arriving);
    acme.installed(?renewing.manager, wall_now());
    acme.close(?renewing.manager);
    serve.stop(?quic_controls, ?server.runtime);
    hedge_tls.destroy();
    fs.remove_all(?a, directory::Path);
    ret 0;
}

# the authority's own https interface, reached directly rather than through
# the harness's plain-http front end
rec SecureFixture {
    request:  [8192]u8;
    response: [65536]u8;
    items:    [64]field.Field;
    engine:   transport.Transport;
    session:  session.Session;
    account:  keys.Key;
    anchors:  anchors.Anchors;
}

fun secure_fixture(fixture: *SecureFixture, a: *allocator.Allocator,
    bundle: str, directory: str) bool {
    if (anchors.load_bundle(?fixture.anchors, a, bundle) != anchors.OK) {
        ret false;
    }
    if (!keys.generate(?fixture.account)) { ret false; }
    if (!transport.make(?fixture.engine, ?fixture.request[0], 8192,
        ?fixture.response[0], 65536, ?fixture.items[0], 64,
        session.limits().response_fields, transport.literal_addresses())) {
        ret false;
    }
    if (!transport.set_trust(?fixture.engine,
        anchors.store(?fixture.anchors))) { ret false; }
    # the address comes from the origin; the name that is verified comes from
    # the url, and they are deliberately not the same thing
    if (!transport.set_origin(?fixture.engine, transport.secure_origin(
        ip.endpoint(127, 0, 0, 1, SECURE_PORT)))) { ret false; }
    ret session.make(?fixture.session, text_view(directory)) == session.OK;
}

fun secure_discover(fixture: *SecureFixture) session.Status {
    if (session.begin_discovery(?fixture.session) != session.PENDING) {
        ret session.FAILED;
    }
    var status: session.Status = session.PENDING;
    var rounds: usize = 0;
    val deadline: i64 = monotonic_ns() + 30000000000;
    for (status == session.PENDING && rounds < MAX_ROUNDS) {
        status = session.poll(?fixture.session, ?fixture.engine,
            ?fixture.account, wall_now());
        if (monotonic_ns() > deadline) { brk; }
        rounds = rounds + 1;
    }
    ret status;
}

fun secure_release(fixture: *SecureFixture) {
    session.release(?fixture.session);
    transport.destroy(?fixture.engine);
    keys.destroy(?fixture.account);
}

test "live: the authority is reached over tls and verified against its ca" {
    var memory: [1048576]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 1048576))) { ret 1; }
    var fixture: SecureFixture;
    if (!secure_fixture(?fixture, ?a, AUTHORITY_CA, SECURE_DIRECTORY)) {
        ret 2;
    }
    if (anchors.count(?fixture.anchors) == 0) {
        secure_release(?fixture);
        ret 3;
    }
    if (secure_discover(?fixture) != session.OK) {
        secure_release(?fixture);
        ret 4;
    }
    if (!session.discovered(?fixture.session)) {
        secure_release(?fixture);
        ret 5;
    }
    # the directory came back over the tls connection, not the plain front end
    val found: ac.Directory = session.directory(?fixture.session);
    if (found.new_order_url.len == 0 || found.new_account_url.len == 0
     || found.new_nonce_url.len == 0) {
        secure_release(?fixture);
        ret 6;
    }
    session.complete(?fixture.session, ?fixture.engine);
    secure_release(?fixture);
    ret 0;
}

test "live: two tls authority sessions coexist across generations" {
    var memory: [1048576]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 1048576))) { ret 1; }
    val before: usize = origination.live();
    var active: SecureFixture;
    var superseded: SecureFixture;
    if (!secure_fixture(?active, ?a, AUTHORITY_CA, SECURE_DIRECTORY)) {
        ret 2;
    }
    if (!secure_fixture(?superseded, ?a, AUTHORITY_CA, SECURE_DIRECTORY)) {
        secure_release(?active);
        ret 2;
    }
    if (session.begin_discovery(?active.session) != session.PENDING
     || session.begin_discovery(?superseded.session) != session.PENDING) {
        secure_release(?active);
        secure_release(?superseded);
        ret 3;
    }
    var active_status: session.Status = session.PENDING;
    var superseded_status: session.Status = session.PENDING;
    var peak: usize = origination.live();
    var rounds: usize = 0;
    val deadline: i64 = monotonic_ns() + 30000000000;
    for ((active_status == session.PENDING
        || superseded_status == session.PENDING) && rounds < MAX_ROUNDS) {
        if (active_status == session.PENDING) {
            active_status = session.poll(?active.session, ?active.engine,
                ?active.account, wall_now());
        }
        if (superseded_status == session.PENDING) {
            superseded_status = session.poll(?superseded.session,
                ?superseded.engine, ?superseded.account, wall_now());
        }
        val current: usize = origination.live();
        if (current > peak) { peak = current; }
        if (monotonic_ns() > deadline) { brk; }
        rounds = rounds + 1;
    }
    if (active_status != session.OK || superseded_status != session.OK
     || peak < before + 2 || !session.discovered(?active.session)
     || !session.discovered(?superseded.session)) {
        secure_release(?active);
        secure_release(?superseded);
        ret 4;
    }
    session.complete(?active.session, ?active.engine);
    session.complete(?superseded.session, ?superseded.engine);
    secure_release(?active);
    secure_release(?superseded);
    if (origination.live() != before) { ret 5; }
    ret 0;
}

test "live: an authority outside the configured anchors is refused" {
    var memory: [1048576]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 1048576))) { ret 1; }
    var fixture: SecureFixture;
    # a real certificate that is not this authority's issuer
    if (!secure_fixture(?fixture, ?a, UNRELATED_CERTIFICATE,
        SECURE_DIRECTORY)) { ret 2; }
    if (secure_discover(?fixture) != session.FAILED) {
        secure_release(?fixture);
        ret 3;
    }
    # it failed in the handshake and never fell back to cleartext
    if (transport.cause(?fixture.engine) != transport.CAUSE_HANDSHAKE) {
        secure_release(?fixture);
        ret 4;
    }
    if (session.discovered(?fixture.session)) {
        secure_release(?fixture);
        ret 5;
    }
    secure_release(?fixture);
    ret 0;
}

test "live: an authority whose certificate names someone else is refused" {
    var memory: [1048576]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 1048576))) { ret 1; }
    var fixture: SecureFixture;
    # the right anchors, the right address, a name the certificate does not
    # carry: the chain verifies and the identity does not
    if (!secure_fixture(?fixture, ?a, AUTHORITY_CA, MISMATCHED_DIRECTORY)) {
        ret 2;
    }
    if (secure_discover(?fixture) != session.FAILED) {
        secure_release(?fixture);
        ret 3;
    }
    if (transport.cause(?fixture.engine) != transport.CAUSE_HANDSHAKE) {
        secure_release(?fixture);
        ret 4;
    }
    secure_release(?fixture);
    ret 0;
}

val STAGING_DIRECTORY: str = "https://acme-staging-v02.api.letsencrypt.org/directory";
val STAGING_HOST: str = "acme-staging-v02.api.letsencrypt.org";

# staging's own api endpoint is secured by an ordinary webpki chain, not by the
# staging pseudo-root. that root is the anchor for certificates staging issues
# to us, which is a different trust decision, and anchoring this test to it
# refused the authority correctly for the wrong reason. a deployment reaching a
# public authority verifies it against its system trust store, so this does too.
test "live: a public authority is reached over tls and verified" {
    # the local authority proves the mechanism; this proves it against a real
    # public endpoint, with a real chain and a name resolved from dns. it needs
    # outbound network access, which the harness needs anyway to build.
    var memory: [1048576]u8;
    var arena: fixed.FixedState;
    var a: allocator.Allocator;
    if (!fixed_ok(fixed.make(?a, ?arena, ?memory[0], 1048576))) { ret 1; }
    var fixture: SecureFixture;
    val loaded: anchors.Status = anchors.load_bundle(?fixture.anchors, ?a,
        SYSTEM_ANCHORS);
    if (loaded != anchors.OK) {
        print.eprintlnf("anchors: {} loading {}", loaded::i64, SYSTEM_ANCHORS);
        ret 2;
    }
    if (!keys.generate(?fixture.account)) { ret 4; }
    if (!transport.make(?fixture.engine, ?fixture.request[0], 8192,
        ?fixture.response[0], 65536, ?fixture.items[0], 64,
        session.limits().response_fields, transport.literal_addresses())) {
        ret 5;
    }
    if (!transport.set_trust(?fixture.engine,
        anchors.store(?fixture.anchors))) { ret 6; }
    var endpoint: ip.Endpoint;
    if (!transport.resolve_endpoint(text_view(STAGING_HOST), 443, ?endpoint)) {
        secure_release(?fixture);
        ret 7;
    }
    if (!transport.set_origin(?fixture.engine,
        transport.secure_origin(endpoint))) {
        secure_release(?fixture);
        ret 8;
    }
    if (session.make(?fixture.session, text_view(STAGING_DIRECTORY))
        != session.OK) {
        secure_release(?fixture);
        ret 9;
    }
    val outcome: session.Status = secure_discover(?fixture);
    if (outcome != session.OK) {
        val cause: problem.Error = session.failure(?fixture.session);
        var detail: str = cause.detail;
        if (detail == nil) { detail = ""; }
        print.eprintlnf("staging: outcome {} stage {} cause {} tls {} kind {} code {} {}",
            outcome::i64, transport.stage(?fixture.engine)::i64,
            transport.cause(?fixture.engine)::i64,
            origination.failure(fixture.engine.tls)::i64,
            cause.kind::i64, cause.code::i64, detail);
        secure_release(?fixture);
        ret 10;
    }
    val found: ac.Directory = session.directory(?fixture.session);
    if (found.new_order_url.len == 0 || found.new_account_url.len == 0
     || found.new_nonce_url.len == 0) {
        secure_release(?fixture);
        ret 11;
    }
    # the urls the public authority published are its own, not the ones a
    # local harness hands back
    if (!body_contains(found.new_order_url.data, found.new_order_url.len,
        "acme-staging-v02.api.letsencrypt.org")) {
        secure_release(?fixture);
        ret 12;
    }
    session.complete(?fixture.session, ?fixture.engine);
    secure_release(?fixture);
    ret 0;
}
