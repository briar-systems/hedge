# dispatch: a request's target and host against a compiled plan
#
# the plan is fixed: a wildcard host, an exact host with two names that must
# outrank it, and a host that routes one path. the input is the request

use hedge.config.schema;
use hedge.dispatch.middleware;
use hedge.dispatch.plan;
use hedge.service;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.target;
use http.router.router;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view;

use fuzz.input;
use fuzz.verdict;

var routes:   [8]router.CompiledRoute;
var segments: [64]router.Segment;
var specs:    [8]router.Route;
var entries:  [8]plan.Entry;
var services: [8]service.Descriptor;
var chains:   [8]middleware.Middleware;
var text:     [2048]u8;
var storage:  plan.Storage;
var compiled: plan.Plan;
var graph:    schema.Graph;
var resolver: service.Resolver;
var ready:    bool;

fun host_at(index: usize, name: str, first: str, second: str) {
    val host: *schema.Host = ?graph.hosts[index];
    schema.set_text(?host.name, name);
    schema.set_text(?host.server_names[0], first);
    host.server_name_count = 1;
    if (second != nil) {
        schema.set_text(?host.server_names[1], second);
        host.server_name_count = 2;
    }
}

fun service_at(index: usize, name: str) {
    schema.set_text(?graph.services[index].name, name);
    graph.services[index].kind = schema.SERVICE_FIXED;
    schema.set_text(?graph.services[index].target, "ok");
    graph.services[index].status = 200;
}

fun route_at(index: usize, name: str, host: str, path: str, service_name: str) {
    schema.set_text(?graph.routes[index].name, name);
    schema.set_text(?graph.routes[index].host, host);
    schema.set_text(?graph.routes[index].path, path);
    schema.set_text(?graph.routes[index].service, service_name);
}

fun prepare() bool {
    if (ready) { ret true; }
    schema.reset_graph(?graph);
    schema.set_text(?graph.server_name, "fuzz");
    graph.host_count = 3;
    host_at(0, "wild", "*.example.test", nil);
    host_at(1, "exact", "other.example.test", "api.example.test");
    host_at(2, "plain", "example.test", nil);
    graph.service_count = 3;
    service_at(0, "wildsvc");
    service_at(1, "apisvc");
    service_at(2, "greetsvc");
    graph.route_count = 3;
    route_at(0, "wildroute", "wild", "/**", "wildsvc");
    route_at(1, "apiroute", "exact", "/**", "apisvc");
    route_at(2, "greetroute", "plain", "/greet", "greetsvc");
    if (!plan.make_storage(?storage, ?routes[0], 8, ?segments[0], 64, ?specs[0], 8,
        ?entries[0], 8, ?services[0], 8, ?chains[0], 8, ?text[0], 2048)) { ret false; }
    resolver = service.no_resolver();
    ready    = plan.compile(?compiled, 1, ?graph, storage, ?resolver, nil).status == plan.PLAN_OK;
    ret ready;
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

rec Name {
    bytes:    [256]u8;
    length:   usize;
    usable:   bool;
    has_port: bool;
}

# the host the request's one Host field names: lowercase, without a port
fun name_of(fields: *field.Fields) Name {
    var name: Name;
    name.length   = 0;
    name.usable   = false;
    name.has_port = false;
    var count: usize = 0;
    var i:     usize = 0;
    for (i < fields.len) {
        if (field.name_equal(fields.items[i].name, view.view("host", 4))) { count = count + 1; }
        i = i + 1;
    }
    val found: *field.Field = field.find_first(fields, view.view("host", 4));
    if (count != 1 || found == nil || found.value.len > 255) { ret name; }
    var end: usize = found.value.len;
    var at:  usize = end;
    for (at > 0 && found.value.data[at - 1] >= '0' && found.value.data[at - 1] <= '9') {
        at = at - 1;
    }
    if (at > 0 && at < end && found.value.data[at - 1] == ':') {
        end           = at - 1;
        name.has_port = true;
    }
    i = 0;
    for (i < end) {
        name.bytes[i] = lower(found.value.data[i]);
        i             = i + 1;
    }
    name.length = end;
    name.usable = true;
    ret name;
}

fun is(name: *Name, text_value: str) bool {
    val length: usize = str_len(text_value);
    if (name.length != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (name.bytes[i] != text_value[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun under_wildcard(name: *Name) bool {
    val suffix: str = ".example.test";
    if (name.length <= 13) { ret false; }
    var i: usize = 0;
    for (i < 13) {
        if (name.bytes[name.length - 13 + i] != suffix[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a dns name of plain labels: letters, digits and inner hyphens
fun plain_name(name: *Name) bool {
    var label: usize = 0;
    var i:     usize = 0;
    for (i < name.length) {
        val c: u8 = name.bytes[i];
        if (c == '.') {
            if (label == 0 || name.bytes[i - 1] == '-') { ret false; }
            label = 0;
        }
        or ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || (c == '-' && label != 0)) {
            label = label + 1;
            if (label > 63) { ret false; }
        }
        or { ret false; }
        i = i + 1;
    }
    ret label != 0;
}

fun plain_path(value: view.View) bool {
    if (value.len == 0 || value.data[0] != '/') { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val c: u8 = value.data[i];
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '/')) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun answer_dispatch(data: *u8, len: usize) verdict.Verdict {
    if (!prepare()) { ret verdict.violated("dispatch: the fixed plan did not compile"); }
    var items:   [32]field.Field;
    var request: message.Request;
    input.request(data, len, ?request, ?items[0], 32);
    var captures: [4]router.Capture;
    val matched:  router.Dispatch = plan.match(?compiled, ?request, ?captures[0], 4);
    val again:    router.Dispatch = plan.match(?compiled, ?request, ?captures[0], 4);
    if (again.status != matched.status || again.source_index != matched.source_index) {
        ret verdict.violated("dispatch: one request matched two ways");
    }
    var name: Name = name_of(?request.fields);
    if (matched.status != router.DISPATCH_MATCH) {
        # every refusal the router reports is the client's: the plan leaves room
        # for every capture a route names
        if (matched.status == router.DISPATCH_CAPTURE_CAPACITY) {
            ret verdict.violated("dispatch: a route's captures did not fit the room the plan gives them");
        }
        # a name a host claims, exactly or by its wildcard, with a plain path
        # always routes
        if (name.usable && under_wildcard(?name) && plain_name(?name) && !name.has_port && request.method.kind == method.GET && request.target.form == target.ORIGIN &&
            request.target.query.len == 0 && plain_path(request.target.path)) {
            ret verdict.violated("dispatch: a plain request to a configured name was refused");
        }
        ret verdict.answered(matched.status::u64);
    }
    verdict.accept();
    val entry: *plan.Entry = plan.entry(?compiled, matched.source_index);
    if (entry == nil || !name.usable) {
        ret verdict.violated("dispatch: a match names no entry or no host");
    }
    # an exact name outranks the wildcard, and nothing routes a host no host
    # declares
    var fits: bool = false;
    if (str_equals(entry.host, "*.example.test")) {
        fits = under_wildcard(?name) && !is(?name, "api.example.test") &&
            !is(?name, "other.example.test");
    }
    or {
        fits = is(?name, entry.host);
        if (str_equals(entry.host, "example.test")) {
            fits = fits && request.target.path.len == 6;
        }
    }
    if (!fits) {
        ret verdict.violated("dispatch: a request routed to a host that does not claim it");
    }
    ret verdict.answered(verdict.mix(matched.status::u64, matched.source_index::u64));
}
