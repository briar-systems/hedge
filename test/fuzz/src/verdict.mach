# what a boundary answers for one input
#
# an input is answered when the entry point parses it or refuses it with a
# typed error and every view it publishes stays inside the input. a finding is
# an answer that broke an invariant. outcome names which answer it was, so two
# inputs with the same outcome reached the same verdict, and mutation retains
# an input only for an outcome the corpus does not hold yet

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub rec Verdict {
    finding: bool;
    outcome: u64;
    detail:  str;
}

# how many parses the current input got accepted by, which the driver resets
# before each answer and reports beside it
var accepts: usize;

pub fun reset() {
    accepts = 0;
}

pub fun accept() {
    accepts = accepts + 1;
}

pub fun accepted() usize {
    ret accepts;
}

pub fun answered(outcome: u64) Verdict {
    ret Verdict{finding: false, outcome: outcome, detail: ""};
}

pub fun violated(detail: str) Verdict {
    ret Verdict{finding: true, outcome: 0, detail: detail};
}

# fold one more observation into an outcome. the offset keeps an observation
# equal to the outcome so far from cancelling it to zero
pub fun mix(outcome: u64, value: u64) u64 {
    ret ((outcome ^ value) + 0xcbf29ce484222325) * 0x100000001b3;
}

# a count as none, one, two, or several, so a longer run of the same shape is
# not a new outcome
pub fun bucket(count: usize) u64 {
    if (count > 3) { ret 3; }
    ret count::u64;
}

# a published view lies inside the input it was parsed from
pub fun inside(data: *u8, len: usize, base: *u8, base_len: usize) bool {
    if (len == 0)    { ret true; }
    if (data == nil) { ret false; }
    val start: usize = data::usize;
    val first: usize = base::usize;
    ret start >= first && start - first <= base_len && len <= base_len - (start - first);
}

pub fun view_inside(value: view.View, base: *u8, base_len: usize) bool {
    ret inside(value.data::*u8, value.len, base, base_len);
}

pub fun same(a: view.View, b: view.View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}
