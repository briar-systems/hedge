# every untrusted-input entry point the lane answers, by corpus directory name

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use fuzz.request;
use fuzz.verdict;
use fuzz.wire;

pub def AnswerFn: fun(*u8, usize) verdict.Verdict;

pub rec Boundary {
    name:   str;
    answer: AnswerFn;
}

pub val CAPACITY: usize = 64;

fun put(out: *Boundary, i: usize, name: str, answer: AnswerFn) usize {
    if (i >= CAPACITY) { ret i; }
    out[i].name   = name;
    out[i].answer = answer;
    ret i + 1;
}

pub fun all(out: *Boundary) usize {
    var i: usize = 0;
    i = put(out, i, "proxy-v1", wire.answer_proxy);
    i = put(out, i, "proxy-v2", wire.answer_proxy);
    i = put(out, i, "prologue", wire.answer_prologue);
    i = put(out, i, "cleartext", wire.answer_selection);
    i = put(out, i, "acme-response", wire.answer_acme_response);
    i = put(out, i, "h2-method", request.answer_h2_method);
    i = put(out, i, "h2-target", request.answer_h2_target);
    i = put(out, i, "forwarding", request.answer_forwarding);
    i = put(out, i, "forwarded", request.answer_forwarded);
    i = put(out, i, "trace", request.answer_trace);
    i = put(out, i, "admin", request.answer_admin);
    ret i;
}

pub fun lookup(table: *Boundary, n: usize, name: str) opt[usize] {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(table[i].name, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}
