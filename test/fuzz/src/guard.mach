# page-edge copies of an input
#
# every copy ends on the last byte before an unreadable page, so a parser that
# reads one byte past its input faults on the spot. the driver places the input
# a harness answers, and a harness places another copy when a parser writes to
# its input and the harness drives it more than once. release frees them all
# once the answer is in

use std.allocator.testing;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

val MAX_HELD: usize = 64;

var guard:      testing.Testing;
var held_data:  [MAX_HELD]*u8;
var held_size:  [MAX_HELD]usize;
var held_count: usize;

pub fun make() bool {
    val made: err[A.Error] = testing.make(?guard);
    ret sel made.ok;
}

# a copy of `len` bytes that ends where the page does, or nil when none can be
# made. an empty input is a pointer to the guard page itself
pub fun place(bytes: *u8, len: usize) *u8 {
    if (held_count >= MAX_HELD) { ret nil; }
    var size: usize = len;
    if (size == 0) { size = 1; }
    val placed: res[*u8, A.Error] = A.allocate[u8](testing.allocator_of(?guard), size);
    if (sel placed.err) { ret nil; }
    held_data[held_count] = placed.ok;
    held_size[held_count] = size;
    held_count            = held_count + 1;
    var data: *u8   = placed.ok;
    var i:    usize = 0;
    for (i < len) {
        data[i] = bytes[i];
        i       = i + 1;
    }
    if (len == 0) { data = (data::usize + 1)::*u8; }
    ret data;
}

pub fun release() {
    for (held_count > 0) {
        held_count = held_count - 1;
        A.deallocate[u8](testing.allocator_of(?guard), held_data[held_count],
            held_size[held_count]);
    }
}

# a copy of `len` bytes with a terminating NUL as its last readable byte, for
# an entry point that takes text. nil when none can be made or the bytes hold a
# NUL of their own, which would end the text early
pub fun text(bytes: *u8, len: usize) *u8 {
    var i: usize = 0;
    for (i < len) {
        if (bytes[i] == 0) { ret nil; }
        i = i + 1;
    }
    if (held_count >= MAX_HELD) { ret nil; }
    val placed: res[*u8, A.Error] = A.allocate[u8](testing.allocator_of(?guard), len + 1);
    if (sel placed.err) { ret nil; }
    held_data[held_count] = placed.ok;
    held_size[held_count] = len + 1;
    held_count            = held_count + 1;
    val data: *u8 = placed.ok;
    i = 0;
    for (i < len) {
        data[i] = bytes[i];
        i       = i + 1;
    }
    data[len] = 0;
    ret data;
}

# the guarded allocator, for a harness whose entry point allocates: its blocks
# end on a page edge too
pub fun allocator() *A.Allocator {
    ret testing.allocator_of(?guard);
}

pub fun live() usize {
    ret testing.live_count(?guard);
}
