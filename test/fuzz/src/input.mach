# shaping one input into what hedge is handed
#
# a boundary whose entry point takes more than one byte string reads its input
# as lines. a field line is `name: value`, and a field that an HTTP parser would
# refuse is dropped, because hedge is only ever handed fields a parser accepted

use http.core.field;
use http.core.message;
use http.core.method;
use http.core.target;
use std.types.bool.false;
use std.types.size.usize;
use std.types.view;

# the end of the line that starts at `from`: the index of its newline, or `len`
pub fun line_end(data: *u8, len: usize, from: usize) usize {
    var at: usize = from;
    for (at < len && data[at] != '\n') { at = at + 1; }
    ret at;
}

# past the newline that ends a line, or `len`
pub fun next_line(len: usize, end: usize) usize {
    if (end >= len) { ret len; }
    ret end + 1;
}

pub fun slice(data: *u8, from: usize, to: usize) view.View {
    if (to <= from) { ret view.view(nil, 0); }
    ret view.view(?data[from], to - from);
}

pub fun limits() field.Limits {
    ret field.limits(64, 16384, 256, 4096);
}

# the field lines from `from` up to a blank line or the end, appended to
# `fields`. returns where the next section starts
pub fun fields(data: *u8, len: usize, from: usize, fields: *field.Fields) usize {
    var at: usize = from;
    for (at < len) {
        val end: usize = line_end(data, len, at);
        if (end == at) { ret next_line(len, end); }
        var colon: usize = at;
        for (colon < end && data[colon] != ':') { colon = colon + 1; }
        if (colon < end) {
            var start: usize = colon + 1;
            for (start < end && data[start] == ' ') { start = start + 1; }
            var item: field.Field;
            item.name      = slice(data, at, colon);
            item.value     = slice(data, start, end);
            item.sensitive = false;
            if (item.value.len == 0) { item.value = view.view(?data[start], 0); }
            field.append(fields, item);
        }
        at = next_line(len, end);
    }
    ret len;
}

# the origin form a request line carries, split at its first `?`
pub fun origin(raw: view.View) target.Target {
    if (raw.len == 1 && raw.data[0] == '*') { ret target.asterisk(); }
    var cut: usize = 0;
    for (cut < raw.len && raw.data[cut] != '?') { cut = cut + 1; }
    var query: view.View = view.view(nil, 0);
    if (cut < raw.len) { query = slice(raw.data, cut + 1, raw.len); }
    ret target.origin(raw, slice(raw.data, 0, cut), query);
}

pub fun method_of(token: view.View) method.Method {
    var kind: method.Kind = method.GET;
    for (kind <= method.PATCH) {
        val known: method.Method = method.from_kind(kind);
        if (known.token.len == token.len) {
            var i: usize = 0;
            for (i < token.len && known.token.data[i] == token.data[i]) { i = i + 1; }
            if (i == token.len) { ret known; }
        }
        kind = kind + 1;
    }
    ret method.extension(token);
}

# `METHOD target` then field lines. returns where the section after the request
# fields starts
pub fun request(data: *u8, len: usize, output: *message.Request, items: *field.Field,
    capacity: usize) usize {
    val end:   usize = line_end(data, len, 0);
    var space: usize = 0;
    for (space < end && data[space] != ' ') { space = space + 1; }
    output.method = method_of(slice(data, 0, space));
    var raw: view.View = view.view(nil, 0);
    if (space < end) { raw = slice(data, space + 1, end); }
    output.target     = origin(raw);
    output.fields     = field.init(items, capacity, limits());
    output.trailers   = field.init(nil, 0, limits());
    output.body       = nil;
    output.generation = 1;
    ret fields(data, len, next_line(len, end), ?output.fields);
}
