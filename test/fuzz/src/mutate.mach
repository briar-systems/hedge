# the seeded structured mutator and the minimizer
#
# the sequence is one linear congruential generator, so a seed and a run count
# replay exactly. each run applies one of six structural mutations: flip a bit,
# set a byte, truncate, extend with random bytes, swap two bytes, or zero a run

use std.types.size.usize;

pub val FLIP_BIT: u8    = 0;
pub val SET_BYTE: u8    = 1;
pub val TRUNCATE: u8    = 2;
pub val EXTEND:   u8    = 3;
pub val SWAP:     u8    = 4;
pub val KINDS:    usize = 6;

pub fun advance(state: u64) u64 {
    ret state * 6364136223846793005 + 1442695040888963407;
}

pub fun draw(state: *u64, bound: usize) usize {
    if (bound == 0) { ret 0; }
    @state = advance(@state);
    ret ((@state >> 33)::usize) % bound;
}

# apply exactly one mutation in place and report the resulting length
pub fun mutate(state: *u64, buffer: *u8, length: usize, capacity: usize) usize {
    if (buffer == nil || capacity < length) { ret length; }
    if (length == 0) {
        if (capacity == 0) { ret 0; }
        buffer[0] = draw(state, 256)::u8;
        ret 1;
    }
    val kind:     u8    = draw(state, KINDS)::u8;
    val position: usize = draw(state, length);
    if (kind == FLIP_BIT) {
        buffer[position] = buffer[position] ^ (1::u8 << draw(state, 8)::u8);
        ret length;
    }
    if (kind == SET_BYTE) {
        buffer[position] = draw(state, 256)::u8;
        ret length;
    }
    if (kind == TRUNCATE) { ret draw(state, length); }
    if (kind == EXTEND) {
        if (length >= capacity) { ret length; }
        val added: usize = draw(state, capacity - length) % 64 + 1;
        var i:     usize = 0;
        for (i < added && length + i < capacity) {
            buffer[length + i] = draw(state, 256)::u8;
            i                  = i + 1;
        }
        ret length + i;
    }
    if (kind == SWAP) {
        val other: usize = draw(state, length);
        val held:  u8    = buffer[position];
        buffer[position] = buffer[other];
        buffer[other]    = held;
        ret length;
    }
    var run: usize = draw(state, 8) + 1;
    if (run > length - position) { run = length - position; }
    var i: usize = 0;
    for (i < run) {
        buffer[position + i] = 0;
        i                    = i + 1;
    }
    ret length;
}

# drop the bytes in [start, start + count) by shifting the tail down
pub fun cut(buffer: *u8, length: usize, start: usize, count: usize) usize {
    var i: usize = start;
    for (i + count < length) {
        buffer[i] = buffer[i + count];
        i         = i + 1;
    }
    ret length - count;
}
