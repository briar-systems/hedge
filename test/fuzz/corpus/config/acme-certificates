[server]
name = "site"

[server.features]
acme = true

[[listener]]
name = "public"
address = ":443"
protocols = ["http/1.1"]
tls = "public"

[tls.public]
identity = [{ server_name = "site.example", certificate = "site.pem", key = "site.key" }]
default = "site.example"

[host.site]
listener = "public"

[service.challenge]
kind = "native"
target = "acme-challenge"

[[route]]
name = "acme"
host = "site"
path = "/.well-known/acme-challenge/**"
service = "challenge"

[acme]
directory = "https://acme.example/dir"
trust = "/etc/ssl/certs/ca-certificates.crt"
storage = "/var/lib/hedge/acme"
terms_agreed = true

[acme.certificate.site]
listener = "public"
names = ["site.example", "www.site.example"]

[acme.certificate.shop]
listener = "public"
challenge = "tls-alpn-01"
names = ["shop.example"]
