[server]
name = "site"

[[listener]]
name = "public"
address = "[::]:443"
transport = "tcp"
protocols = ["http/1.1", "h2"]
tls = "public"
backlog = 512
accept_depth = 16

[tls.public]
certificate = "secret:cert"
key = "secret:key"

[host.site]
listener = "public"
server_name = "${ENV:HOST}"

[[route]]
name = "root"
host = "site"
path = "/**"
service = "app"

[service.app]
kind = "laurel"
application = "site"
