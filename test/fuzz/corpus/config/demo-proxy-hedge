# an edge that forwards everything to one upstream.
#
# proxying is opt-in: without [server.features] proxy = true nothing in the
# proxy subsystem is constructed, and a proxy service fails to load.

[server]
name = "proxy-demo"

[server.features]
proxy = true

[[listener]]
name = "public"
address = "127.0.0.1:8081"
protocols = ["http/1.1", "h2"]

[host.site]
listener = "public"
server_name = "localhost"

[service.origin]
kind = "proxy"
# a comma-separated list balances across origins:
# upstream = "127.0.0.1:8082, 127.0.0.1:8083"
upstream = "127.0.0.1:8082"

[[route]]
name = "everything"
host = "site"
path = "/**"
service = "origin"
