# a listener with a short drain deadline, so a shutdown with a peer still
# holding a request open reaches the deadline within the life of a test. the
# quic listener shares it, so the same deadline tears down an HTTP/3 session

[server]
name = "hedge-shutdown"

[server.timeouts]
drain_ms = 300

[[listener]]
name = "cleartext"
address = "127.0.0.1:9085"
protocols = ["http/1.1", "h2"]

[[listener]]
name = "quic"
address = "127.0.0.1:9085"
transport = "quic"
protocols = ["h3"]
tls = "public"

[tls.public]
identity = [
  { server_name = "api.example.com", certificate = "test/interop/fixtures/api.pem", key = "test/interop/fixtures/api.key" },
]

[host.plain]
listener = "cleartext"
server_name = "localhost"

[host.h3]
listener = "quic"
server_name = "api.example.com"

[service.greeting]
kind = "fixed"
body = "hello from hedge\n"
content_type = "text/plain; charset=utf-8"

[[route]]
name = "root"
host = "plain"
path = "/**"
service = "greeting"

[[route]]
name = "h3"
host = "h3"
path = "/**"
service = "greeting"
