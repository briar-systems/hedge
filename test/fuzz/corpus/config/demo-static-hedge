# the smallest configuration that serves a directory over cleartext HTTP/1.1.

[server]
name = "static-demo"

[[listener]]
name = "public"
address = "127.0.0.1:8080"
protocols = ["http/1.1", "h2"]

[host.site]
listener = "public"
server_name = "localhost"

[service.files]
kind = "static"
root = "./demo/static/public"
index = "index.html"

[[route]]
name = "everything"
host = "site"
path = "/**"
service = "files"
