# a TLS policy with no default identity: an unmatched server name is refused
# rather than served somebody else's certificate

[server]
name = "hedge-interop-no-default"

[[listener]]
name = "secure"
address = "127.0.0.1:9444"
protocols = ["http/1.1", "h2"]
tls = "strict"

[tls.strict]
identity = [
  { server_name = "api.example.com", certificate = "test/interop/fixtures/api.pem", key = "test/interop/fixtures/api.key" },
]

[host.site]
listener = "secure"
server_name = "api.example.com"

[service.greeting]
kind = "fixed"
body = "hello from hedge\n"
content_type = "text/plain; charset=utf-8"

[[route]]
name = "root"
host = "site"
path = "/**"
service = "greeting"
