[server]
name = "hedge-cache-conformance"

[server.features]
proxy = true

[[listener]]
name = "public"
address = "127.0.0.1:19090"
protocols = ["http/1.1"]

[host.site]
listener = "public"
server_name = "localhost"

[service.origin]
kind = "proxy"
upstream = "127.0.0.1:19091"
cache = true

[[route]]
name = "all"
host = "site"
path = "/**"
service = "origin"

[telemetry]
logs = false

[cache]
enabled = true
memory_bytes = 65536
max_entry_bytes = 4096
entries = 16
