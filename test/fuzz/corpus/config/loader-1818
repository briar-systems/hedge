[server]
name = "site"

[[listener]]
name = "public"
address = "[::]:443"
protocols = ["http/1.1", "h2"]
tls = "public"
proxy_protocol = "required"
trusted_peers = ["10.0.0.0/8", "::1"]

[tls.public]
identity = [ { server_name = "api.example.com", certificate = "api.pem", key = "api.key" }, { server_name = "alt.example.com", certificate = "alt.pem", key = "alt.key" } ]
default = "api.example.com"

[host.site]
listener = "public"
server_name = "api.example.com"

[[route]]
name = "root"
host = "site"
path = "/**"
service = "app"

[service.app]
kind = "fixed"
body = "ok"
