# end-to-end cache tests over real sockets, including the disabled case

use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.option;
use std.chrono.time;
use std.net.ip;
use std.net.tcp;
use std.filesystem;
use std.collections.vector;
use std.collections.vector.Vector;
use std.allocator;
use std.allocator.fixed;
use page: std.allocator.page;
use io_error: std.io.error;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.status;
use http.router.router;
use hedge.config.schema;
use hedge.listener;
use hedge.connection;
use hedge.serve;
use hedge.service;
use http_cache: hedge.cache;
use cache_store: hedge.cache.store;
use policy: hedge.cache.policy;
use call: hedge.dispatch.call;
use plan: hedge.dispatch.plan;
use middleware: hedge.dispatch.middleware;
use wire: hedgetest.wire;

val MAX_ROUTES: usize = 8;
val MAX_SEGMENTS: usize = 64;
val MAX_SERVICES: usize = 8;
val PLAN_TEXT: usize = 2048;
val POOL: usize = 4;
val RESPONSE_BYTES: usize = 8192;
val CACHE_ENTRIES: usize = 8;
val CACHE_BODY: usize = 4096;

# an origin service that counts how often it is actually reached
rec Origin {
    calls: usize;
    payload: str;
    cache_control: str;
    vary: str;
    etag: str;
    set_cookie: str;
}

fun origin_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state: *Origin = context::*Origin;
    state.calls = state.calls + 1;
    if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    if (!service.add_field(active, field.CONTENT_TYPE, "text/plain")) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.cache_control != nil
     && !service.add_field(active, field.CACHE_CONTROL, state.cache_control)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.vary != nil && !service.add_field(active, field.VARY, state.vary)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.etag != nil && !service.add_field(active, field.ETAG, state.etag)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.set_cookie != nil
     && !service.add_field(active, field.SET_COOKIE, state.set_cookie)) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_text(active, state.payload);
}

rec Harness {
    graph: schema.Graph;
    diagnostics: schema.Diagnostics;
    routes: [MAX_ROUTES]router.CompiledRoute;
    segments: [MAX_SEGMENTS]router.Segment;
    specs: [MAX_ROUTES]router.Route;
    entries: [MAX_ROUTES]plan.Entry;
    services: [MAX_SERVICES]service.Descriptor;
    middlewares: [4]middleware.Middleware;
    text: [PLAN_TEXT]u8;
    storage: plan.Storage;
    plan: plan.Plan;
    slots: [POOL]serve.Slot;
    connections: [POOL]connection.Connection;
    runtime: serve.Runtime;
    applications: service.Applications;
    application_slots: [2]service.Application;
    resolver: service.Resolver;
    endpoint: ip.Endpoint;
    origin: Origin;
    layer: http_cache.Layer;
    cache_entries: [CACHE_ENTRIES]cache_store.Entry;
    cache_body: [CACHE_BODY]u8;
    bindings: http_cache.Bindings;
    binding_storage: [MAX_SERVICES]http_cache.Binding;
    scratch: allocator.Allocator;
    disk_root: str;
    disk_bytes: usize;
}

fun native_factory(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    val state: *Origin = context::*Origin;
    if (state == nil || handler == nil) { ret false; }
    @handler = service.Handler{ctx: (state)::ptr, serve: origin_serve};
    ret true;
}

fun base_graph(harness: *Harness, cache_enabled: bool, per_service_cache: bool) {
    val graph: *schema.Graph = ?harness.graph;
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "cache-test");
    graph.limits.max_connections = POOL;
    graph.limits.max_connections_per_peer = POOL;
    graph.listener_count = 1;
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.name, "public");
    schema.set_text(?configured.address, "127.0.0.1:0");
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport = schema.TRANSPORT_TCP;
    configured.protocols = schema.PROTOCOL_HTTP1;
    configured.backlog = 16;
    configured.accept_depth = 2;
    graph.host_count = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 1;
    val configured_service: *schema.Service = ?graph.services[0];
    schema.set_text(?configured_service.name, "origin");
    configured_service.kind = schema.SERVICE_NATIVE;
    schema.set_text(?configured_service.target, "origin");
    schema.clear_text(?configured_service.budget);
    schema.clear_text(?configured_service.secret);
    schema.clear_text(?configured_service.content_type);
    schema.clear_text(?configured_service.index);
    configured_service.precompressed = false;
    configured_service.status = 200;
    configured_service.cache = per_service_cache;
    graph.route_count = 1;
    val configured_route: *schema.Route = ?graph.routes[0];
    schema.set_text(?configured_route.name, "all");
    schema.set_text(?configured_route.host, "site");
    schema.set_text(?configured_route.path, "/**");
    schema.set_text(?configured_route.service, "origin");
    schema.clear_text(?configured_route.budget);
    graph.cache.enabled = cache_enabled;
    graph.cache.memory_bytes = CACHE_BODY;
    graph.cache.max_entry_bytes = 1024;
    graph.cache.entries = CACHE_ENTRIES;
    graph.cache.disk_bytes = harness.disk_bytes;
    if (harness.disk_root != nil) {
        schema.set_text(?graph.cache.disk_root, harness.disk_root);
    } or { schema.clear_text(?graph.cache.disk_root); }
}

fun boot(harness: *Harness, generation: u64, cache_enabled: bool, per_service_cache: bool,
    payload: str, cache_control: str, vary: str) bool {
    base_graph(harness, cache_enabled, per_service_cache);
    harness.origin.calls = 0;
    harness.origin.payload = payload;
    harness.origin.cache_control = cache_control;
    harness.origin.vary = vary;
    harness.origin.etag = nil;
    harness.origin.set_cookie = nil;
    if (option.is_some[*u8](page.make(?harness.scratch))) { ret false; }
    service.make_applications(?harness.applications, ?harness.application_slots[0], 2);
    if (cache_enabled) {
        if (!http_cache.from_config(?harness.layer, ?harness.graph.cache,
            ?harness.cache_entries[0], CACHE_ENTRIES, ?harness.cache_body[0], CACHE_BODY,
            ?harness.scratch)) {
            ret false;
        }
        http_cache.make_bindings(?harness.bindings, ?harness.binding_storage[0],
            MAX_SERVICES, ?harness.layer);
    } or {
        harness.layer.live = false;
        harness.layer.backing = cache_store.disabled();
        http_cache.make_bindings(?harness.bindings, ?harness.binding_storage[0],
            MAX_SERVICES, nil);
    }
    harness.resolver = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.native = service.Factory{
        ctx: (?harness.origin)::ptr,
        build: native_factory,
    };
    harness.resolver.caching = service.Wrapper{
        ctx: (?harness.bindings)::ptr,
        wrap: http_cache.wrapper,
    };
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret false; }
    if (plan.compile(?harness.plan, generation, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK) { ret false; }
    if (!serve.make(?harness.runtime, ?harness.slots[0], ?harness.connections[0], POOL,
        ?harness.plan, ?harness.graph)) { ret false; }
    schema.reset_diagnostics(?harness.diagnostics);
    if (!serve.start(?harness.runtime, generation, ?harness.graph, ?harness.diagnostics)) {
        ret false;
    }
    val owned: *listener.OwnedListener = listener.active_listener(?harness.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) { ret false; }
    harness.endpoint = owned.bound_endpoint;
    ret true;
}

fun shutdown(harness: *Harness) {
    serve.stop(?harness.runtime);
    http_cache.close(?harness.layer);
}

# the store is written when the exchange settles, which is after the client has
# its bytes. Sampling a report before then reads a half-finished cache, so every
# exchange here returns only once the server has nothing left in flight.
fun settle(harness: *Harness) {
    var rounds: usize = 0;
    for (rounds < 64 && !serve.idle(?harness.runtime)) {
        serve.poll(?harness.runtime, 2);
        rounds = rounds + 1;
    }
}

fun exchange_once(harness: *Harness, request: str, marker: str, response: *u8,
    capacity: usize, output: *usize) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client, request)) { tcp.stream_close(?client); ret false; }
    @output = wire.collect(?harness.runtime, ?client, response, capacity, marker);
    tcp.stream_close(?client);
    settle(harness);
    ret true;
}

test "cache: a second request for a fresh entry never reaches the service" {
    var harness: Harness;
    if (!boot(?harness, 1, true, true, "cached payload", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cached payload", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 2; }
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        shutdown(?harness); ret 3;
    }
    if (harness.origin.calls != 1) { shutdown(?harness); ret 4; }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cached payload", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 5; }
    val view: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 6; }
    # the second answer came from the store, so the service ran exactly once
    if (harness.origin.calls != 1) { ret 7; }
    if (view.hits != 1 || view.stores != 1) { ret 8; }
    # a served entry reports the age it has accumulated
    if (!wire.contains(?response[0], length, "age: ")) { ret 9; }
    ret 0;
}

test "cache: a response the origin marked private is never stored" {
    var harness: Harness;
    if (!boot(?harness, 2, true, true, "secret payload", "private, max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "secret payload", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "secret payload", ?response[0], RESPONSE_BYTES, ?length);
    val view: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (harness.origin.calls != 2) { ret 2; }
    if (view.stores != 0 || view.hits != 0 || view.entries != 0) { ret 3; }
    ret 0;
}

test "cache: a differently negotiated request is not answered from a stored variant" {
    var harness: Harness;
    if (!boot(?harness, 3, true, true, "negotiated", "max-age=60", "accept-encoding")) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "negotiated", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 2; }
    if (harness.origin.calls != 1) { shutdown(?harness); ret 3; }
    # the same key, a different selecting value: this must reach the service
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: br\r\n\r\n",
        "negotiated", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 4; }
    if (harness.origin.calls != 2) { shutdown(?harness); ret 5; }
    # the original negotiation is still a hit
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "negotiated", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 6; }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2) { ret 7; }
    ret 0;
}

test "cache: an unsafe method invalidates the stored entry" {
    var harness: Harness;
    if (!boot(?harness, 4, true, true, "invalidated", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 2; }
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 3; }
    exchange_once(?harness,
        "POST /a HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    # the POST reached the service and removed what the cache held
    if (harness.origin.calls != 2) { shutdown(?harness); ret 4; }
    if (http_cache.report(?harness.layer).entries != 0) { shutdown(?harness); ret 5; }
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 3) { ret 6; }
    ret 0;
}

test "cache: a request that demands validation is not answered from the store" {
    var harness: Harness;
    if (!boot(?harness, 5, true, true, "revalidated", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "revalidated", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 2; }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nCache-Control: no-cache\r\n\r\n",
        "revalidated", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 3; }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2) { ret 4; }
    ret 0;
}

# the criterion this test exists for: with caching off nothing is created
test "cache: disabled caching creates no store, no file, and no allocation" {
    var harness: Harness;
    if (!boot(?harness, 6, false, true, "uncached", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    # no layer exists, so nothing owns entry storage, body storage, or a root
    if (http_cache.enabled(?harness.layer)) { shutdown(?harness); ret 2; }
    if (harness.layer.backing.entries != nil || harness.layer.backing.body != nil
     || harness.layer.backing.capacity != 0 || harness.layer.backing.body_capacity != 0
     || harness.layer.backing.has_root) { shutdown(?harness); ret 3; }
    # no service was wrapped, so a request does not even reach a cache branch
    if (harness.bindings.len != 0) { shutdown(?harness); ret 4; }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "uncached", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "uncached", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "uncached", ?response[0], RESPONSE_BYTES, ?length);
    val view: http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    # every request reached the service, and the cache counted nothing
    if (calls != 3) { ret 6; }
    if (view.hits != 0 || view.misses != 0 || view.stores != 0 || view.entries != 0
     || view.memory_bytes != 0 || view.disk_bytes != 0) { ret 7; }
    ret 0;
}

# a service that did not ask for caching is left alone even when a layer exists
test "cache: a service that did not ask to be cached is never wrapped" {
    var harness: Harness;
    if (!boot(?harness, 7, true, false, "unwrapped", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    if (!http_cache.enabled(?harness.layer)) { shutdown(?harness); ret 2; }
    if (harness.bindings.len != 0) { shutdown(?harness); ret 3; }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "unwrapped", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "unwrapped", ?response[0], RESPONSE_BYTES, ?length);
    val view: http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2) { ret 4; }
    if (view.hits != 0 || view.misses != 0 || view.stores != 0) { ret 5; }
    ret 0;
}

# a stored representation must not replay fields that belonged to one connection
test "cache: a hop-by-hop field is not stored and cannot reach the next client" {
    var harness: Harness;
    if (!boot(?harness, 8, true, true, "poisoned", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    harness.origin.vary = nil;
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "poisoned", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 2; }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "poisoned", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 3; }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 1) { ret 4; }
    # the served hit carries exactly one content-length, the one the cache computed,
    # and no connection field the origin's own hop used
    if (wire.contains(?response[0], length, "connection:")) { ret 5; }
    if (wire.contains(?response[0], length, "transfer-encoding:")) { ret 6; }
    ret 0;
}

test "cache: an entry larger than the budget is refused and the service still answers" {
    var harness: Harness;
    if (!boot(?harness, 9, true, true, "x", "max-age=60", nil)) { shutdown(?harness); ret 1; }
    harness.layer.backing.limits.max_entry_bytes = 0;
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\nx", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 2; }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\nx", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 3; }
    val view: http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    # both requests were answered correctly, and nothing was kept
    if (calls != 2 || view.entries != 0 || view.stores != 0) { ret 4; }
    if (view.rejections == 0) { ret 5; }
    ret 0;
}


# the defect this test exists for: a target may hold more than one representation,
# and taking the first entry filed under the key made every other one unreachable
test "cache: each stored representation answers its own negotiation" {
    var harness: Harness;
    if (!boot(?harness, 10, true, true, "varied", "max-age=60", "accept-encoding")) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: br\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 2) { shutdown(?harness); ret 2; }
    if (http_cache.report(?harness.layer).entries != 2) { shutdown(?harness); ret 3; }
    # both are now stored, and each negotiation must find its own
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: br\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    val view: http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2) { ret 4; }
    if (view.hits != 2 || view.entries != 2) { ret 5; }
    ret 0;
}

test "cache: a conditional request is answered from the store without an origin call" {
    var harness: Harness;
    if (!boot(?harness, 11, true, true, "conditional", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    harness.origin.etag = "\"v1\"";
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "conditional", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 2; }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"v1\"\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 3; }
    val calls: usize = harness.origin.calls;
    val hits: u64 = http_cache.report(?harness.layer).hits;
    shutdown(?harness);
    # the cache validated against its own stored tag, so the origin was never reached
    if (calls != 1 || hits != 1) { ret 4; }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 304 ")) { ret 5; }
    if (!wire.contains(?response[0], length, "etag:")) { ret 6; }
    # a 304 describes no body, so it must not claim one
    if (wire.contains(?response[0], length, "conditional")) { ret 7; }
    ret 0;
}

test "cache: a byte range is served out of the stored representation" {
    var harness: Harness;
    if (!boot(?harness, 12, true, true, "0123456789", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 2; }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nRange: bytes=2-5\r\n\r\n",
        "2345", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 3; }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 1) { ret 4; }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 206 ")) { ret 5; }
    if (!wire.contains(?response[0], length, "content-range: bytes 2-5/10")) { ret 6; }
    if (!wire.contains(?response[0], length, "content-length: 4")) { ret 7; }
    # exactly the requested window, not the whole representation
    val body: usize = wire.body_offset(?response[0], length);
    if (body == 0 || length - body != 4) { ret 8; }
    if (response[body] != '2' || response[body + 3] != '5') { ret 9; }
    ret 0;
}

# the poisoning case: a shared cache that kept a Set-Cookie would give the next
# client the session the first one was issued
test "cache: a response that sets a cookie is not stored and never replayed" {
    var harness: Harness;
    if (!boot(?harness, 13, true, true, "cookied", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    harness.origin.set_cookie = "session=first";
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cookied", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cookied", ?response[0], RESPONSE_BYTES, ?length);
    val view: http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    # every request reached the origin and got its own cookie
    if (calls != 2) { ret 2; }
    if (view.stores != 0 || view.entries != 0 || view.hits != 0) { ret 3; }
    ret 0;
}

test "cache: an origin that names the cookie gets the rest of its response stored" {
    var harness: Harness;
    if (!boot(?harness, 14, true, true, "named",
        "private=\"set-cookie\", max-age=60", nil)) { shutdown(?harness); ret 1; }
    harness.origin.set_cookie = "session=first";
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "named", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 2; }
    if (!wire.contains(?response[0], length, "set-cookie:")) { shutdown(?harness); ret 3; }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "named", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 4; }
    val calls: usize = harness.origin.calls;
    val view: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    # the representation was reused, and the cookie was not part of it
    if (calls != 1 || view.hits != 1 || view.stores != 1) { ret 5; }
    if (wire.contains(?response[0], length, "set-cookie:")) { ret 6; }
    ret 0;
}

test "cache: a byte budget evicts the least recently used entry over real sockets" {
    var harness: Harness;
    if (!boot(?harness, 15, true, true, "0123456789", "max-age=60", nil)) {
        shutdown(?harness); ret 1;
    }
    # exactly two ten byte representations fit
    harness.layer.backing.limits.memory_bytes = 20;
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /b HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (http_cache.report(?harness.layer).memory_bytes != 20) { shutdown(?harness); ret 2; }
    # touch the first so the second becomes least recently used
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 2) { shutdown(?harness); ret 3; }
    exchange_once(?harness, "GET /c HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    var view: http_cache.Report = http_cache.report(?harness.layer);
    if (view.memory_bytes != 20 || view.entries != 2 || view.evictions != 1) {
        shutdown(?harness); ret 4;
    }
    # the evicted target reaches the origin again, the retained one does not
    exchange_once(?harness, "GET /b HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 4) { shutdown(?harness); ret 5; }
    exchange_once(?harness, "GET /c HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    val calls: usize = harness.origin.calls;
    view = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (calls != 4) { ret 6; }
    # the budget was a bound throughout, never a target it drifted above
    if (view.memory_bytes > 20) { ret 7; }
    ret 0;
}

fun ensure_dir(path: str) bool {
    if (filesystem.is_dir(path)) { ret true; }
    ret !option.is_some[str](filesystem.create_dir(path, 493));
}

fun e_files(path: str, scratch: *allocator.Allocator) usize {
    val listed: Result[Vector[str], str] = filesystem.read_dir(scratch, path);
    if (is_err[Vector[str], str](listed)) { ret 0xffffffffffffffff; }
    var names: Vector[str] = unwrap_ok[Vector[str], str](listed);
    var found: usize = 0;
    var i: usize = 0;
    for (i < names.len) {
        val held: Result[*str, str] = vector.get[str](?names, i);
        if (!is_err[*str, str](held)) {
            val name: str = @unwrap_ok[*str, str](held);
            if (name[0] == 'e' && name[1] >= '0' && name[1] <= '9') { found = found + 1; }
        }
        i = i + 1;
    }
    vector.dnit[str](?names);
    ret found;
}

test "cache: a disk entry is served over a socket and does not survive a restart" {
    if (!ensure_dir("out") || !ensure_dir("out/cache-runtime-disk")) { ret 1; }
    var harness: Harness;
    harness.disk_root = "out/cache-runtime-disk";
    harness.disk_bytes = 4096;
    if (!boot(?harness, 16, true, true, "on disk", "max-age=60", nil)) {
        shutdown(?harness); ret 2;
    }
    # anything past a quarter of the memory budget goes to disk
    harness.layer.backing.limits.memory_bytes = 8;
    var response: [RESPONSE_BYTES]u8;
    var length: usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "on disk", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) { shutdown(?harness); ret 3; }
    var view: http_cache.Report = http_cache.report(?harness.layer);
    if (view.disk_bytes == 0 || view.memory_bytes != 0) { shutdown(?harness); ret 4; }
    if (e_files("out/cache-runtime-disk", ?harness.scratch) != 1) { shutdown(?harness); ret 5; }
    # the second answer comes off the disk, over a real socket, byte for byte
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "on disk", ?response[0], RESPONSE_BYTES, ?length)) { shutdown(?harness); ret 6; }
    if (harness.origin.calls != 1) { shutdown(?harness); ret 7; }
    if (!wire.contains(?response[0], length, "on disk")) { shutdown(?harness); ret 8; }
    shutdown(?harness);
    # shutting down took the files with it, so nothing is left to describe wrongly
    if (e_files("out/cache-runtime-disk", ?harness.scratch) != 0) { ret 9; }

    var restarted: Harness;
    restarted.disk_root = "out/cache-runtime-disk";
    restarted.disk_bytes = 4096;
    if (!boot(?restarted, 17, true, true, "on disk", "max-age=60", nil)) {
        shutdown(?restarted); ret 10;
    }
    if (http_cache.report(?restarted.layer).entries != 0) { shutdown(?restarted); ret 11; }
    exchange_once(?restarted, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "on disk", ?response[0], RESPONSE_BYTES, ?length);
    val calls: usize = restarted.origin.calls;
    shutdown(?restarted);
    # the restarted process kept nothing, so it answered from the origin
    if (calls != 1) { ret 12; }
    ret 0;
}
