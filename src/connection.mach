fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun runtime_ok(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

pub val PIPELINE_DEPTH:         usize = schema.MAX_PIPELINE_DEPTH;
pub val TRANSPORT_SLOTS:        usize = 4;
pub val READ_BYTES:             usize = 8192;
pub val RESPONSE_FIELD_SLOTS:   usize = 32;
pub val RESPONSE_TRAILER_SLOTS: usize = 8;
pub val INFORMATIONAL_SLOTS:    usize = 4;
pub val CAPTURE_SLOTS:          usize = 8;
pub val MAX_STEPS:              usize = 64;
pub val PROLOGUE_BYTES:         usize = prologue.MAX_BYTES;
pub val PROXY_SCRATCH_BYTES:    usize = proxy_protocol.MAX_TEXT_BYTES;

# where exchange construction stopped, reported through the connection snapshot
pub def Setup: u8;
pub val SETUP_OK:       Setup = 0;
pub val SETUP_PARSED:   Setup = 1;
pub val SETUP_SCOPE:    Setup = 2;
pub val SETUP_BODY:     Setup = 3;
pub val SETUP_REQUEST:  Setup = 4;
pub val SETUP_RESPONSE: Setup = 5;
pub val SETUP_EXCHANGE: Setup = 6;
pub val SETUP_BEGIN:    Setup = 7;
pub val SETUP_TRACE:    Setup = 8;
pub val SETUP_BIND:     Setup = 9;
pub val PEER_BYTES:     usize = 64;

pub def State: u8;
pub val NEW:     State = 1;
pub val ACTIVE:  State = 2;
pub val CLOSING: State = 3;
pub val CLOSED:  State = 4;
pub val FAILED:  State = 5;

pub def Step: u8;
pub val STEP_IDLE:     Step = 1;
pub val STEP_PROGRESS: Step = 2;
pub val STEP_BLOCKED:  Step = 3;
pub val STEP_DONE:     Step = 4;
pub val STEP_ERROR:    Step = 5;

# storage a connection claims only once it selects a protocol that needs it,
# owned by the runtime and shared by every connection it drives
pub rec Storage {
    h2_sessions: storage.Table[h2.Session];
    chunks:      storage.Chunks;
}

pub fun make_storage(shared: *Storage, a: *A.Allocator) bool {
    if (shared == nil) { ret false; }
    ret storage.make_table[h2.Session](?shared.h2_sessions, a)
        && storage.make_chunks(?shared.chunks, a);
}

# every connection must have released what it claimed
pub fun destroy_storage(shared: *Storage) bool {
    if (shared == nil) { ret false; }
    val sessions: bool = storage.destroy_table[h2.Session](?shared.h2_sessions);
    ret storage.destroy_chunks(?shared.chunks) && sessions;
}

pub rec Config {
    engine:             connection.Config;
    max_streams:        usize;
    request_timeout_ns: u64;
    # bounds the prologue and, on a TLS listener, the handshake behind it
    prologue_timeout_ns: u64;
    call_memory_bytes:   usize;
    memory_budgets:      memory.Budgets;
    # how long a connection may wait on memory before it is shed
    memory_wait_ns: u64;
}

pub fun config_from(graph: *schema.Graph) Config {
    var engine: connection.Config = connection.config_default();
    engine.max_pipeline = graph.limits.max_pipeline_depth;
    if (engine.max_pipeline > PIPELINE_DEPTH) {
        engine.max_pipeline = PIPELINE_DEPTH;
    }
    val split:       memory.Budgets = lanes.budgets(?graph.limits);
    var max_streams: usize          = graph.limits.max_pipeline_depth;
    if (max_streams > h2.MAX_STREAMS) { max_streams = h2.MAX_STREAMS; }
    # never advertise more HTTP/2 streams than the request lane can fund
    val h2_funded: usize = memory.request_capacity(split, h2.set_bytes());
    if (max_streams > h2_funded) { max_streams = h2_funded; }
    engine.parser             = lanes.h1_limits(?graph.limits);
    engine.read_bytes         = READ_BYTES;
    engine.write_bytes        = READ_BYTES;
    engine.slot_storage_bytes = lanes.h1_storage_bytes(engine.parser);
    engine.slot_scratch_bytes = lanes.SCRATCH_BYTES;
    engine.slot_lane          = memory.LANE_REQUEST;
    engine.connection_lane    = memory.LANE_IO;
    engine.header_timeout_ns  = graph.timeouts.header_ms * 1000000;
    engine.request_timeout_ns = graph.timeouts.request_ms * 1000000;
    engine.idle_timeout_ns    = graph.timeouts.keep_alive_ms * 1000000;
    engine.write_timeout_ns   = graph.timeouts.write_ms * 1000000;
    ret Config{engine: engine, max_streams: max_streams,
        request_timeout_ns:  graph.timeouts.request_ms * 1000000,
        prologue_timeout_ns: graph.timeouts.handshake_ms * 1000000,
        call_memory_bytes:   graph.limits.call_memory_bytes,
        memory_budgets:      split,
        memory_wait_ns:      graph.timeouts.header_ms * 1000000};
}

# the exchange limits a service sees must admit everything the parser will accept,
# so both are derived from one set of configured bounds rather than defaulted apart
pub fun message_limits(graph: *schema.Graph, configured: Config) message.Limits {
    val parsing: parser.Limits  = configured.engine.parser;
    var limits:  message.Limits = message.limits_default();
    limits.max_method_bytes   = parsing.max_method_bytes;
    limits.max_endpoint_bytes = PEER_BYTES;
    limits.target             = target.limits(parsing.max_target_bytes, 16, parsing.max_target_bytes,
        parsing.max_target_bytes, parsing.max_target_bytes);
    limits.request_fields = field.limits(parsing.max_headers, parsing.max_header_bytes,
        parsing.max_header_line, parsing.max_header_line);
    limits.request_trailers = field.limits(parsing.max_trailers, parsing.max_trailer_bytes,
        parsing.max_header_line, parsing.max_header_line);
    limits.request_body  = body.limits(parsing.max_body_bytes, READ_BYTES, 0xffffffff);
    limits.response_body = body.limits(graph.limits.max_body_bytes::u64, READ_BYTES, 0xffffffff);
    ret limits;
}

# the request body reader pulls the bytes the engine is holding and reports
# pending when the connection has not read them yet, so backpressure reaches the
# service instead of being buffered behind its back
rec RequestBody {
    owner:            *Connection;
    slot:             usize;
    reader:           body.Reader;
    pending_token:    u64;
    next_token:       u64;
    pending_output:   *u8;
    pending_capacity: usize;
}

pub rec Connection {
    state:              State;
    id:                 u64;
    generation:         u64;
    token:              listener.ConnectionToken;
    stream:             tcp.Stream;
    peer:               ip.Endpoint;
    peer_text:          [PEER_BYTES]u8;
    peer_len:           usize;
    peer_port:          u16;
    peer_kind:          message.EndpointKind;
    local_text:         [PEER_BYTES]u8;
    local_len:          usize;
    local_port:         u16;
    local_kind:         message.EndpointKind;
    secure:             bool;
    listener_name:      str;
    driver:             *net_async.Driver;
    runtime_stream:     transport.RuntimeStream;
    adapter:            transport.Adapter;
    channel:            transport.Transport;
    channel_slots:      [TRANSPORT_SLOTS]transport.Slot;
    contexts:           [TRANSPORT_SLOTS]listener.ConnectionContext;
    operations:         [TRANSPORT_SLOTS]operation.Operation;
    operation_root:     cancel.Scope;
    control_scope:      cancel.Scope;
    engine_scope:       cancel.Scope;
    request_scope:      cancel.Scope;
    request_scope_live: bool;
    engine:             connection.Engine;
    engine_slots:       [PIPELINE_DEPTH]connection.Slot;
    # every engine on this connection borrows from the worker's pool through
    # this account, which stays open until close has released them all
    borrower:            memory.Borrower;
    account:             buffers.Account;
    source:              buffers.Source;
    account_live:        bool;
    refused_memory:      bool;
    memory_deadline_ns:  u64;
    memory_expired:      bool;
    stage_chunk:         buffers.Chunk;
    stage_held:          bool;
    stage_length:        usize;
    stage_offset:        usize;
    body_done:           bool;
    body_chunks:         u64;
    request_body:        RequestBody;
    request:             message.Request;
    response:            message.Response;
    response_fields:     [RESPONSE_FIELD_SLOTS]field.Field;
    response_trailers:   [RESPONSE_TRAILER_SLOTS]field.Field;
    informationals:      [INFORMATIONAL_SLOTS]message.Informational;
    captures:            [CAPTURE_SLOTS]router.Capture;
    memory:              call.Memory;
    trace:               telemetry_trace.Context;
    exchange:            exchange.Exchange;
    active_call:         call.Call;
    active_slot:         usize;
    exchange_live:       bool;
    response_started:    bool;
    request_generation:  u64;
    configured:          Config;
    limits:              message.Limits;
    plan:                *plan.Plan;
    budgets:             *budget.Set;
    charge:              budget.Charge;
    requests:            u64;
    last_event:          connection.EventKind;
    last_step:           Step;
    setup_failure:       Setup;
    request_failure:     message.RequestStatus;
    pending_slot:        usize;
    has_pending:         bool;
    service_pending:     bool;
    initialized:         bool;
    engine_live:         bool;
    protocol:            selection.Protocol;
    refusal:             prologue.Refusal;
    prologue_policy:     prologue.Policy;
    prologue_buffer:     [PROLOGUE_BYTES]u8;
    prologue_len:        usize;
    prologue_read:       usize;
    prologue_pending:    bool;
    prologue_ended:      bool;
    prologue_operation:  operation.Operation;
    prologue_context:    listener.ConnectionContext;
    prologue_scope:      cancel.Scope;
    prologue_scope_live: bool;
    # hedge's own deadlines in monotonic nanoseconds, zero for none. the worker's
    # wheel wakes the connection for them and `expire` enforces them
    prologue_deadline_ns: u64;
    request_deadline_ns:  u64;
    # who the worker wakes when something this connection waits on settles
    waker:       hedge_wake.Waker;
    wake_failed: bool;
    tls_policy:  usize;
    session:     usize;
    # the h2 session's index in the shared table, or h2.NO_SESSION
    h2_session:             usize;
    shared:                 *Storage;
    handshaking:            bool;
    close_started:          bool;
    close_pending:          bool;
    close_failed:           bool;
    engine_close_started:   bool;
    exchange_cancelling:    bool;
    exchange_call_released: bool;
    secure_operation:       operation.Operation;
    proxy_scratch:          [PROXY_SCRATCH_BYTES]u8;
}

fun no_slot() usize {
    ret connection.NO_SLOT;
}

fun operation_for(owner: *Connection, token_context: usize) usize {
    var token: transport.Token;
    if (!transport.context_token(token_context, ?token)) { ret TRANSPORT_SLOTS; }
    val index: usize = token.index::usize;
    if (index >= TRANSPORT_SLOTS) { ret TRANSPORT_SLOTS; }
    if (!operation.bind_operation(?owner.operations[index], ?owner.contexts[index], (owner)::ptr,
        settle, token_context)) { ret TRANSPORT_SLOTS; }
    ret index;
}

# the prologue read past the PROXY header, so the bytes behind it were already
# taken off the socket. they are handed to whatever reads next before the socket
# is touched again, or the first request on every proxied connection is lost.
fun deliver_staged(owner: *Connection, scope: *cancel.Scope, buffer: *u8,
    length: usize, index: usize) res[io_runtime.Token, io_error.Error] {
    var count: usize = owner.prologue_len - owner.prologue_read;
    if (count > length) { count = length; }
    var i: usize = 0;
    for (i < count) {
        buffer[i] = owner.prologue_buffer[owner.prologue_read + i];
        i         = i + 1;
    }
    val submitted: res[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped(
        owner.driver.runtime, scope,
        io_runtime.Operation{kind: io_runtime.READ, resource: owner.stream.handle.value,
        buffer: buffer, length: length, offset: 0,
        context: (?owner.contexts[index])::usize});
    if (sel submitted.err) { ret submitted; }
    val token:     io_runtime.Token    = submitted.ok;
    val published: err[io_error.Error] = io_runtime.complete(owner.driver.runtime,
        token, count, owner.stream.handle.value, false);
    if (sel published.err) {
        # nothing was delivered, so the staged bytes stay staged
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_READ)};
    }
    owner.prologue_read = owner.prologue_read + count;
    ret submitted;
}

fun submit_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val owner: *Connection = context::*Connection;
    val index: usize       = operation_for(owner, token_context);
    if (index >= TRANSPORT_SLOTS) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_READ)};
    }
    if (owner.session == secure.NO_SESSION
        && owner.prologue_read < owner.prologue_len && length != 0) {
        ret deliver_staged(owner, scope, buffer, length, index);
    }
    ret net_async.submit_read(owner.driver, scope, ?owner.stream, buffer, length,
        (?owner.contexts[index])::usize);
}

# staged bytes are already readable, so the wait they answer settles at once
fun ready_staged(owner: *Connection, scope: *cancel.Scope,
    index: usize) res[io_runtime.Token, io_error.Error] {
    val submitted: res[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped(
        owner.driver.runtime, scope,
        io_runtime.Operation{kind: io_runtime.READABLE, resource: owner.stream.handle.value,
        buffer: nil, length: 0, offset: 0, context: (?owner.contexts[index])::usize});
    if (sel submitted.err) { ret submitted; }
    val published: err[io_error.Error] = io_runtime.complete(owner.driver.runtime,
        submitted.ok, 0, owner.stream.handle.value, false);
    if (sel published.err) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_READ)};
    }
    ret submitted;
}

fun submit_readable(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val owner: *Connection = context::*Connection;
    val index: usize       = operation_for(owner, token_context);
    if (index >= TRANSPORT_SLOTS) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_READ)};
    }
    if (owner.session == secure.NO_SESSION && owner.prologue_read < owner.prologue_len) {
        ret ready_staged(owner, scope, index);
    }
    ret net_async.submit_readable(owner.driver, scope, ?owner.stream,
        (?owner.contexts[index])::usize);
}

fun submit_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val owner: *Connection = context::*Connection;
    val index: usize       = operation_for(owner, token_context);
    if (index >= TRANSPORT_SLOTS) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_WRITE)};
    }
    ret net_async.submit_write(owner.driver, scope, ?owner.stream, buffer, length,
        (?owner.contexts[index])::usize);
}

fun submit_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val owner: *Connection = context::*Connection;
    val index: usize       = operation_for(owner, token_context);
    if (index >= TRANSPORT_SLOTS) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_OPTION)};
    }
    ret net_async.submit_shutdown_write(owner.driver, scope, ?owner.stream,
        (?owner.contexts[index])::usize);
}

fun submit_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val owner: *Connection = context::*Connection;
    val index: usize       = operation_for(owner, token_context);
    if (index >= TRANSPORT_SLOTS) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_CLOSE)};
    }
    ret net_async.submit_stream_close(owner.driver, scope, ?owner.stream,
        io_lifecycle.ABORTIVE, (?owner.contexts[index])::usize);
}

pub fun logical_kind(kind: io_runtime.Kind) transport.Kind {
    if (kind == io_runtime.READ)     { ret transport.READ; }
    if (kind == io_runtime.READABLE) { ret transport.READABLE; }
    if (kind == io_runtime.WRITE)    { ret transport.WRITE; }
    if (kind == io_runtime.SHUTDOWN) { ret transport.SHUTDOWN_WRITE; }
    if (kind == io_runtime.CLOSE)    { ret transport.CLOSE; }
    ret 0;
}

# translate a runtime completion into a transport completion without settling it
#
# the protocol engine owns transport settlement: it checks the completion against
# its own pending operation before releasing the slot. translating here and
# settling there keeps exactly one owner for each transport slot.
pub fun translate(settled: *transport.Completion, source: io_runtime.Completion,
    token_context: usize) bool {
    var token: transport.Token;
    if (!transport.context_token(token_context, ?token)) { ret false; }
    val kind: transport.Kind = logical_kind(source.kind);
    if (kind == 0) { ret false; }
    if (source.has_error) {
        @settled = transport.failed(token, kind, source.bytes, source.error);
        ret true;
    }
    if (source.end_of_stream) {
        if (kind == transport.READ || kind == transport.READABLE) {
            @settled = transport.end_of(token, kind, source.bytes);
            ret true;
        }
        @settled = transport.failed(token, kind, 0,
            io_error.make(io_error.CLOSED, io_error.OP_WRITE));
        ret true;
    }
    @settled = transport.completed(token, kind, source.bytes);
    ret true;
}

# one completion belongs to exactly one connection and settles exactly one operation
fun settle(context: ptr, token_context: usize, completion: io_runtime.Completion) {
    val owner: *Connection = context::*Connection;
    if (owner == nil || !owner.initialized || !owner.engine_live) { ret; }
    fin { notify(owner); }
    var settled: transport.Completion;
    if (!translate(?settled, completion, token_context)) { ret; }
    val now: time.Instant = clock.instant();
    if (owner.h2_session != h2.NO_SESSION) {
        val stepped: Step = from_h2(h2.complete_io(h2_of(owner), ?settled, now));
        if (stepped == STEP_DONE || stepped == STEP_ERROR) {
            owner.state = CLOSING;
            ret;
        }
        advance(owner, now);
        ret;
    }
    # complete_io settles the transport slot and advances the engine, so the event
    # it returns is the next event this connection will ever produce. dropping it
    # would silently skip a request.
    val event: connection.Event = connection.complete_io(?owner.engine, ?settled, now);
    if (!runnable(owner)) { ret; }
    apply(owner, event, now);
    if (runnable(owner)) { advance(owner, now); }
}

fun format_endpoint(endpoint: ip.Endpoint, output: *u8, capacity: usize) usize {
    ret ip.endpoint_format(endpoint, output, capacity);
}

fun endpoint_metadata(kind: message.EndpointKind, text: *u8, length: usize,
    port: u16) message.Endpoint {
    if (kind == message.ENDPOINT_UNSPECIFIED || length == 0) {
        ret message.unspecified_endpoint();
    }
    ret message.endpoint(kind, view.view(text, length), port);
}

fun write_port(value: u16, output: *u8, at: usize, capacity: usize) usize {
    var digits:    [5]u8;
    var count:     usize = 0;
    var remaining: usize = value::usize;
    if (remaining == 0) {
        digits[0] = '0'::u8;
        count     = 1;
    }
    for (remaining != 0) {
        digits[count] = '0'::u8 + (remaining % 10)::u8;
        remaining     = remaining / 10;
        count         = count + 1;
    }
    if (at + count > capacity) { ret 0; }
    var i: usize = 0;
    for (i < count) {
        output[at + i] = digits[count - 1 - i];
        i              = i + 1;
    }
    ret at + count;
}

# the decoded peer is rendered the same way an observed one is, so a service or
# a log reading `metadata.peer.address` cannot tell which path produced it and
# cannot accidentally treat the two differently
fun format_decoded(peer: proxy_protocol.Peer, output: *u8, capacity: usize) usize {
    if (peer.address.len == 0 || peer.address.data == nil) { ret 0; }
    val bracket: bool  = peer.family == proxy_protocol.FAMILY_INET6;
    var at:      usize = 0;
    if (bracket) {
        if (at >= capacity) { ret 0; }
        output[at] = '['::u8;
        at         = at + 1;
    }
    if (at + peer.address.len > capacity) { ret 0; }
    var i: usize = 0;
    for (i < peer.address.len) {
        output[at + i] = peer.address.data[i];
        i              = i + 1;
    }
    at = at + peer.address.len;
    if (bracket) {
        if (at >= capacity) { ret 0; }
        output[at] = ']'::u8;
        at         = at + 1;
    }
    if (at >= capacity) { ret 0; }
    output[at] = ':'::u8;
    at         = at + 1;
    ret write_port(peer.port, output, at, capacity);
}

fun record_observed(owner: *Connection, source: *listener.Connection) {
    owner.peer_kind = message.ENDPOINT_UNSPECIFIED;
    owner.peer_len  = 0;
    owner.peer_port = 0;
    if (source.has_peer) {
        owner.peer     = source.peer;
        owner.peer_len = format_endpoint(owner.peer, ?owner.peer_text[0], PEER_BYTES);
        if (owner.peer_len != 0) {
            owner.peer_kind = message.ENDPOINT_IP;
            owner.peer_port = owner.peer.port;
        }
    }
    owner.local_kind = message.ENDPOINT_UNSPECIFIED;
    owner.local_len  = 0;
    owner.local_port = 0;
    # the bound address of a wildcard listener is not the address this
    # connection arrived on, so the socket is asked rather than the listener
    val local: res[ip.Endpoint, io_error.Error] = tcp.stream_local_endpoint(?owner.stream);
    if (sel local.ok) {
        val endpoint: ip.Endpoint = local.ok;
        owner.local_len = format_endpoint(endpoint, ?owner.local_text[0], PEER_BYTES);
        if (owner.local_len != 0) {
            owner.local_kind = message.ENDPOINT_IP;
            owner.local_port = endpoint.port;
        }
    }
}

# a decoded header replaces the observed peer for every later reader. leaving the
# observed one in place would make logging and policy disagree about who the
# client is, which is worse than not decoding the header at all.
fun record_decoded(owner: *Connection, decided: prologue.Result) {
    owner.peer_kind = message.ENDPOINT_UNSPECIFIED;
    owner.peer_port = 0;
    owner.peer_len  = format_decoded(decided.peer, ?owner.peer_text[0], PEER_BYTES);
    if (owner.peer_len != 0) {
        owner.peer_kind = message.ENDPOINT_FORWARDED;
        owner.peer_port = decided.peer.port;
    }
    if (decided.local.family == proxy_protocol.FAMILY_UNSPEC) { ret; }
    owner.local_kind = message.ENDPOINT_UNSPECIFIED;
    owner.local_port = 0;
    owner.local_len  = format_decoded(decided.local, ?owner.local_text[0], PEER_BYTES);
    if (owner.local_len != 0) {
        owner.local_kind = message.ENDPOINT_FORWARDED;
        owner.local_port = decided.local.port;
    }
}

# the listener's policy becomes the connection's prologue policy exactly once,
# at accept time. the trust decision is taken here from the observed socket
# address, before a single header byte has been read.
fun bind_policy(owner: *Connection, owned: *listener.OwnedListener,
    source: *listener.Connection) {
    var trusted: bool = false;
    if (source.has_peer) {
        trusted = trust.trusts(?owned.policy.trusted, source.peer.addr);
    }
    owner.secure          = owned.policy.secure;
    owner.prologue_policy = prologue.policy(owned.policy.proxy_protocol, trusted,
        owned.policy.secure,
        selection.policy(owned.policy.protocols, owned.policy.secure,
        owned.policy.secure));
}

pub fun make(
    owner: *Connection,
    id: u64,
    generation: u64,
    token: listener.ConnectionToken,
    source: *listener.Connection,
    net_driver: *net_async.Driver,
    active_plan: *plan.Plan,
    budgets: *budget.Set,
    configured: Config,
    limits: message.Limits,
    owned: *listener.OwnedListener,
    policy: usize,
    shared: *Storage,
    pool: *memory.Memory,
    waker: hedge_wake.Waker,
    now: time.Instant,
) bool {
    if (owner == nil) { ret false; }
    owner.initialized    = false;
    owner.account_live   = false;
    owner.refused_memory = false;
    if (source == nil || net_driver == nil || active_plan == nil
        || owned == nil || shared == nil || pool == nil || id == 0 || generation == 0
        || !hedge_wake.valid(?waker)) { ret false; }
    owner.waker                = waker;
    owner.wake_failed          = false;
    owner.prologue_deadline_ns = 0;
    owner.request_deadline_ns  = 0;
    # a TLS listener whose policy did not resolve must not fall back to
    # cleartext, so the connection is refused before it is admitted
    if (owned.policy.secure && hedge_tls.policy_at(policy) == nil) { ret false; }
    owner.tls_policy           = policy;
    owner.session              = secure.NO_SESSION;
    owner.h2_session           = h2.NO_SESSION;
    owner.shared               = shared;
    owner.handshaking          = false;
    owner.close_started        = false;
    owner.close_pending        = false;
    owner.close_failed         = false;
    owner.engine_close_started = false;
    owner.state                = NEW;
    owner.id                   = id;
    owner.generation           = generation;
    owner.token                = token;
    owner.stream               = source.tcp_stream;
    owner.listener_name        = schema.text(?owned.name);
    owner.driver               = net_driver;
    owner.engine_live          = false;
    owner.protocol             = selection.NONE;
    owner.refusal              = prologue.REFUSED_NONE;
    owner.prologue_len         = 0;
    owner.prologue_read        = 0;
    owner.prologue_pending     = false;
    owner.prologue_ended       = false;
    bind_policy(owner, owned, source);
    record_observed(owner, source);
    owner.plan                   = active_plan;
    owner.budgets                = budgets;
    owner.charge                 = budget.no_charge();
    owner.configured             = configured;
    owner.limits                 = limits;
    owner.active_slot            = no_slot();
    owner.exchange_live          = false;
    owner.exchange_cancelling    = false;
    owner.exchange_call_released = false;
    owner.response_started       = false;
    owner.request_scope_live     = false;
    owner.request_generation     = 0;
    owner.requests               = 0;
    owner.last_event             = connection.EVENT_NONE;
    owner.last_step              = STEP_IDLE;
    owner.setup_failure          = SETUP_OK;
    owner.request_failure        = 0;
    owner.pending_slot           = 0;
    owner.has_pending            = false;
    owner.service_pending        = false;
    owner.initialized            = false;
    # every connection is a cancel root of its own. mach-http's transport requires
    # it, and it means no two connections, let alone two workers, share a lock
    if (!operation_ok(cancel.make_root(?owner.operation_root, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_root(?owner.control_scope, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_child(?owner.engine_scope, ?owner.operation_root, opt[time.Instant].none{}))) {
        ret false;
    }
    # a peer that opens a connection and then says nothing must not hold a slot
    # until something else notices. the prologue owns its own deadline because
    # no protocol engine exists yet to apply one.
    owner.prologue_scope_live = false;
    if (configured.prologue_timeout_ns != 0) {
        owner.prologue_deadline_ns = clock.after_ns(clock.to_ns(now),
            configured.prologue_timeout_ns);
    }
    if (!operation_ok(cancel.make_child(?owner.prologue_scope, ?owner.operation_root, opt[time.Instant].none{}))) { ret false; }
    owner.prologue_scope_live = true;
    owner.runtime_stream      = transport.RuntimeStream{
        runtime: net_driver.runtime,
        context: (owner)::ptr,
        submit_read:           submit_read,
        submit_readable:       submit_readable,
        submit_write:          submit_write,
        submit_shutdown_write: submit_shutdown,
        submit_close:          submit_close,
    };
    if (!transport.make_runtime_adapter(?owner.adapter, ?owner.runtime_stream, transport.PLAINTEXT)) {
        ret false;
    }
    owner.channel.initialized = false;
    owner.engine.initialized  = false;
    if (!call.make_memory(?owner.memory, ?shared.chunks, configured.call_memory_bytes)) {
        ret false;
    }
    # the account is opened last, so a connection refused for anything else
    # never holds one. a refusal here is admission turning the connection away
    owner.memory_deadline_ns = 0;
    owner.memory_expired     = false;
    memory.borrower(?owner.borrower, pool, waker.owner, 0, configured.memory_budgets);
    if (!memory.open(?owner.borrower, ?owner.account)) {
        owner.refused_memory = true;
        ret false;
    }
    owner.source       = memory.borrowed_source(?owner.borrower);
    owner.account_live = true;
    # the engine is not started here: which engine to start is what the prologue
    # decides, and starting one first would mean guessing
    owner.initialized = true;
    ret true;
}

# ask the worker for another look: this connection may have finished, or may
# now wait for a different deadline
fun notify(owner: *Connection) {
    if (!hedge_wake.wake(?owner.waker)) { owner.wake_failed = true; }
}

# whether the next step would make progress with nothing else happening: the
# worker's debug audit checks that no connection answering true is left out of
# every queue (#182). a finished connection waits only to be retired
pub fun pending_work(owner: *Connection) bool {
    if (owner == nil || !owner.initialized)          { ret false; }
    if (owner.state != NEW && owner.state != ACTIVE) { ret true; }
    # a wake that could not be queued is one the worker never sees
    if (owner.wake_failed) { ret true; }
    # the pool funded the account and nothing has routed its wake
    if (owner.account_live && owner.account.is_ready) { ret true; }
    if (owner.session != secure.NO_SESSION && secure.pending_work(owner.session)) {
        ret true;
    }
    if (owner.state == NEW) {
        if (owner.handshaking) { ret secure.handshake_settled(owner.session); }
        ret !owner.prologue_pending;
    }
    if (owner.h2_session != h2.NO_SESSION) { ret h2.pending_work(h2_of(owner)); }
    if (!owner.engine_live)                { ret false; }
    # bytes the engine holds to write and has not submitted
    if (owner.engine.write_length != 0 && !owner.engine.write_pending) { ret true; }
    # a request the engine handed over, waiting only for its exchange to start
    if (owner.has_pending && !owner.exchange_live) { ret true; }
    # a pending service that names nothing it waits on runs again only if polled
    ret owner.exchange_live && owner.service_pending && !call.parked(?owner.active_call);
}

# whether a close left waiting would progress with nothing else happening: the
# question the worker's debug audit asks of a retiring connection (#261). the
# close waits on the secure channel's operations, or on the HTTP/2 engine's
# drain and close, so a channel or engine holding work nothing started is a
# close nobody will finish
pub fun close_work(owner: *Connection) bool {
    if (!close_waiting(owner))                        { ret false; }
    if (owner.wake_failed)                            { ret true; }
    if (owner.account_live && owner.account.is_ready) { ret true; }
    if (owner.session != secure.NO_SESSION && secure.pending_work(owner.session)) {
        ret true;
    }
    ret owner.h2_session != h2.NO_SESSION && h2.pending_work(h2_of(owner));
}

# the earliest monotonic instant this connection must be stepped for a deadline
# alone. it reflects the state the last step left, so the worker asks again
# after every step
pub fun next_deadline(owner: *Connection, output: *u64) bool {
    if (owner == nil || output == nil || !owner.initialized || owner.state == CLOSED) {
        ret false;
    }
    var found: bool = false;
    if (owner.prologue_scope_live && owner.prologue_deadline_ns != 0) {
        found = earliest(found, owner.prologue_deadline_ns, output);
    }
    if (owner.request_scope_live && owner.exchange_live && owner.request_deadline_ns != 0) {
        found = earliest(found, owner.request_deadline_ns, output);
    }
    if (owner.memory_deadline_ns != 0) {
        found = earliest(found, owner.memory_deadline_ns, output);
    }
    var engine_at: u64 = 0;
    if (owner.exchange_live && owner.service_pending
        && call.wait_deadline(?owner.active_call, ?engine_at)) {
        found = earliest(found, engine_at, output);
    }
    if (owner.h2_session != h2.NO_SESSION) {
        if (h2.next_deadline(h2_of(owner), ?engine_at)) {
            found = earliest(found, engine_at, output);
        }
    }
    or (owner.engine_live) {
        val due: connection.Deadline = connection.next_deadline(?owner.engine);
        if (due.active) { found = earliest(found, clock.to_ns(due.at), output); }
    }
    ret found;
}

fun earliest(found: bool, candidate: u64, output: *u64) bool {
    if (!found || candidate < @output) { @output = candidate; }
    ret true;
}

# time out every scope whose hedge-owned deadline has passed. the io under it
# settles through its ordinary completion, and the engines see their own
# deadlines on the step that follows
pub fun expire(owner: *Connection, now_ns: u64) {
    if (owner == nil || !owner.initialized) { ret; }
    if (owner.prologue_scope_live && owner.prologue_deadline_ns != 0
        && now_ns >= owner.prologue_deadline_ns) {
        cancel.timeout(?owner.prologue_scope);
    }
    if (owner.request_scope_live && owner.exchange_live) {
        cancel.expire(?owner.request_scope, clock.from_ns(now_ns));
    }
    # shedding a connection that cannot get memory is deliberate: under
    # pressure the pool is kept for the connections that can still finish
    if (owner.memory_deadline_ns != 0 && now_ns >= owner.memory_deadline_ns
        && memory.waiting(?owner.account)
        && (owner.state == NEW || owner.state == ACTIVE)) {
        shed_for_memory(owner);
        owner.state = FAILED;
    }
}

fun shed_for_memory(owner: *Connection) {
    if (owner.memory_expired) { ret; }
    memory.timed_out(?owner.borrower);
    owner.memory_expired = true;
}

# a connection's memory wait is bounded from the first step that ends blocked
# on the pool, and the bound clears once a step ends without waiting
fun track_memory(owner: *Connection, now: time.Instant) {
    if (!owner.account_live || !memory.waiting(?owner.account)) {
        owner.memory_deadline_ns = 0;
        ret;
    }
    if (owner.memory_deadline_ns == 0 && owner.configured.memory_wait_ns != 0) {
        owner.memory_deadline_ns = clock.after_ns(clock.to_ns(now),
            owner.configured.memory_wait_ns);
    }
}

pub fun memory_expired(owner: *Connection) bool {
    ret owner != nil && owner.memory_expired;
}

pub fun refused_memory(owner: *Connection) bool {
    ret owner != nil && owner.refused_memory;
}

pub fun wake_failed(owner: *Connection) bool {
    ret owner != nil && owner.wake_failed;
}

fun release_prologue_scope(owner: *Connection) {
    if (!owner.prologue_scope_live) { ret; }
    cancel.destroy(?owner.prologue_scope);
    owner.prologue_scope_live = false;
}

fun refuse(owner: *Connection, reason: prologue.Refusal) Step {
    owner.refusal = reason;
    owner.state   = FAILED;
    ret STEP_ERROR;
}

fun start_engine(owner: *Connection, now: time.Instant) Step {
    var adapter: transport.Adapter = owner.adapter;
    if (owner.session != secure.NO_SESSION) { adapter = secure.adapter(owner.session); }
    if (!transport.adapter_valid(?adapter)) {
        ret refuse(owner, prologue.REFUSED_TRANSPORT);
    }
    owner.channel.initialized = false;
    if (!transport.init(?owner.channel, adapter, ?owner.operation_root,
        ?owner.control_scope, ?owner.channel_slots[0], TRANSPORT_SLOTS)) {
        ret refuse(owner, prologue.REFUSED_TRANSPORT);
    }
    if (owner.protocol == selection.HTTP1) {
        owner.engine.initialized = false;
        if (!connection.init(?owner.engine, connection.SERVER, ?owner.channel,
            ?owner.engine_scope, ?owner.engine_slots[0], PIPELINE_DEPTH, ?owner.source,
            ?owner.account, owner.configured.engine, now)) {
            ret refuse(owner, prologue.REFUSED_UNBOUND);
        }
        owner.engine_live = true;
        owner.state       = ACTIVE;
        release_prologue_scope(owner);
        ret STEP_PROGRESS;
    }
    if (owner.protocol == selection.HTTP2) {
        owner.h2_session = h2.acquire(?owner.shared.h2_sessions);
        if (owner.h2_session == h2.NO_SESSION) {
            ret refuse(owner, prologue.REFUSED_EXHAUSTED);
        }
        if (!h2.begin(h2_of(owner), ?owner.channel, ?owner.engine_scope,
            owner.plan, owner.budgets, owner.limits, owner.configured.max_streams,
            owner.listener_name,
            owner.secure,
            endpoint_metadata(owner.peer_kind, ?owner.peer_text[0], owner.peer_len,
            owner.peer_port),
            endpoint_metadata(owner.local_kind, ?owner.local_text[0],
            owner.local_len, owner.local_port),
            owner.configured.request_timeout_ns, owner.source, ?owner.account,
            ?owner.shared.chunks,
            owner.configured.call_memory_bytes,
            h2.Timeouts{header_ns: owner.configured.engine.header_timeout_ns,
            request_ns: owner.configured.engine.request_timeout_ns,
            idle_ns:    owner.configured.engine.idle_timeout_ns,
            write_ns:   owner.configured.engine.write_timeout_ns}, owner.waker, now)) {
            ret refuse(owner, prologue.REFUSED_UNBOUND);
        }
        owner.engine_live = true;
        owner.state       = ACTIVE;
        release_prologue_scope(owner);
        ret STEP_PROGRESS;
    }
    ret refuse(owner, prologue.REFUSED_UNBOUND);
}

fun from_h2(progress: h2.Step) Step {
    if (progress == h2.STEP_PROGRESS) { ret STEP_PROGRESS; }
    if (progress == h2.STEP_BLOCKED)  { ret STEP_BLOCKED; }
    if (progress == h2.STEP_DONE)     { ret STEP_DONE; }
    if (progress == h2.STEP_ERROR)    { ret STEP_ERROR; }
    ret STEP_IDLE;
}

# the bytes the prologue read past the PROXY header are TLS records, and the
# record layer must see them before the socket is read again
fun staged_bytes(context: ptr, buffer: *u8, length: usize) usize {
    val owner: *Connection = context::*Connection;
    if (owner == nil) { ret 0; }
    var count: usize = owner.prologue_len - owner.prologue_read;
    # a nil buffer asks how many staged bytes are left
    if (buffer == nil)             { ret count; }
    if (count == 0 || length == 0) { ret 0; }
    if (count > length)            { count = length; }
    var i: usize = 0;
    for (i < count) {
        buffer[i] = owner.prologue_buffer[owner.prologue_read + i];
        i         = i + 1;
    }
    owner.prologue_read = owner.prologue_read + count;
    ret count;
}

fun settle_secure(context: ptr, token_context: usize,
    completion: io_runtime.Completion) {
    val owner: *Connection = context::*Connection;
    if (owner == nil || !owner.initialized || owner.session == secure.NO_SESSION) {
        ret;
    }
    fin { notify(owner); }
    var settled: io_runtime.Completion = completion;
    secure.accept(owner.session, ?settled);
    advance(owner, clock.instant());
}

# TLS reads the wall clock through its policy, never `now` (#190)
fun begin_secure(owner: *Connection, now: time.Instant) Step {
    if (!hedge_tls.prepare(owner.tls_policy)) {
        ret refuse(owner, prologue.REFUSED_TLS);
    }
    owner.session = secure.acquire();
    if (owner.session == secure.NO_SESSION) {
        ret refuse(owner, prologue.REFUSED_EXHAUSTED);
    }
    val channel: *secure.Channel = secure.channel(owner.session);
    if (channel == nil
        || !secure.attach(owner.session, owner.driver, ?owner.stream, (owner)::ptr,
        staged_bytes, ?owner.borrower, ?owner.account)
        || !operation.bind_operation(?owner.secure_operation, ?channel.context, (owner)::ptr,
        settle_secure, 0)
        || !secure.begin(owner.session, hedge_tls.policy_at(owner.tls_policy),
        ?owner.operation_root, ?owner.prologue_scope)) {
        ret refuse(owner, prologue.REFUSED_TLS);
    }
    owner.handshaking = true;
    ret STEP_BLOCKED;
}

# mach-tls chose the protocol from the listener's own ALPN list, and this checks
# the answer back against listener policy rather than trusting it. a selection
# that is not one this listener serves is a refusal, never a fallback.
fun protocol_from_alpn(owner: *Connection, negotiated: contracts.Bytes) selection.Decision {
    var offered: [1]view.View;
    var count:   usize = 0;
    if (negotiated.len != 0 && negotiated.data != nil) {
        offered[0] = view.view(negotiated.data, negotiated.len);
        count      = 1;
    }
    ret selection.select_alpn(owner.prologue_policy.selection, ?offered[0], count);
}

fun refuse_handshake(owner: *Connection) Step {
    val failure: tls_error.Error = secure.handshake_error(owner.session);
    if (failure == tls_error.UNRECOGNIZED_NAME) {
        ret refuse(owner, prologue.REFUSED_UNKNOWN_NAME);
    }
    if (failure == tls_error.NO_APPLICATION_PROTOCOL) {
        ret refuse(owner, prologue.REFUSED_ALPN);
    }
    ret refuse(owner, prologue.REFUSED_TLS);
}

fun advance_handshake(owner: *Connection, now: time.Instant) Step {
    secure.drive(owner.session);
    if (!secure.handshake_settled(owner.session)) { ret STEP_BLOCKED; }
    owner.handshaking = false;
    if (!secure.open(owner.session)) { ret refuse_handshake(owner); }
    val negotiated: tls_engine.Snapshot = secure.negotiated(owner.session);
    val chosen:     selection.Decision  = protocol_from_alpn(owner, negotiated.selected_alpn);
    if (chosen.outcome != selection.SELECTED) {
        ret refuse(owner, prologue.REFUSED_ALPN);
    }
    owner.protocol = chosen.protocol;
    ret start_engine(owner, now);
}

fun submit_prologue_read(owner: *Connection) Step {
    if (owner.prologue_len >= PROLOGUE_BYTES) {
        ret refuse(owner, prologue.REFUSED_OVERFLOW);
    }
    if (!operation.bind_operation(?owner.prologue_operation, ?owner.prologue_context,
        (owner)::ptr, settle_prologue, 0)) {
        ret refuse(owner, prologue.REFUSED_TRANSPORT);
    }
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_read(
        owner.driver, ?owner.prologue_scope, ?owner.stream,
        ?owner.prologue_buffer[owner.prologue_len],
        PROLOGUE_BYTES - owner.prologue_len,
        (?owner.prologue_context)::usize);
    if (sel submitted.err) {
        ret refuse(owner, prologue.REFUSED_TRANSPORT);
    }
    owner.prologue_pending = true;
    ret STEP_BLOCKED;
}

# read the prefix until policy can decide what this connection is
fun advance_prologue(owner: *Connection, now: time.Instant) Step {
    if (owner.prologue_pending) { ret STEP_BLOCKED; }
    val decided: prologue.Result = prologue.evaluate(owner.prologue_policy,
        ?owner.prologue_buffer[0], owner.prologue_len, owner.prologue_ended,
        ?owner.proxy_scratch[0], PROXY_SCRATCH_BYTES);
    if (decided.outcome == prologue.REFUSE) {
        # a refused connection still records who was refused, when the header
        # that named them was itself trustworthy
        if (decided.has_peer) { record_decoded(owner, decided); }
        ret refuse(owner, decided.refusal);
    }
    if (decided.outcome == prologue.NEED_MORE) { ret submit_prologue_read(owner); }
    if (decided.has_peer)                      { record_decoded(owner, decided); }
    owner.prologue_read = decided.consumed;
    # a TLS listener has decided nothing yet: its handshake names the protocol
    if (owner.prologue_policy.secure) { ret begin_secure(owner, now); }
    owner.protocol = decided.protocol;
    ret start_engine(owner, now);
}

fun settle_prologue(context: ptr, token_context: usize,
    completion: io_runtime.Completion) {
    val owner: *Connection = context::*Connection;
    if (owner == nil || !owner.initialized || !owner.prologue_pending) { ret; }
    fin { notify(owner); }
    owner.prologue_pending = false;
    if (completion.has_error) {
        val reason: cancel.Reason = cancel.reason(?owner.prologue_scope);
        if (sel reason.timed_out) { refuse(owner, prologue.REFUSED_TIMEOUT); }
        or                        { refuse(owner, prologue.REFUSED_TRANSPORT); }
        ret;
    }
    if (owner.prologue_len + completion.bytes > PROLOGUE_BYTES) {
        refuse(owner, prologue.REFUSED_OVERFLOW);
        ret;
    }
    owner.prologue_len = owner.prologue_len + completion.bytes;
    if (completion.end_of_stream || completion.bytes == 0) {
        owner.prologue_ended = true;
    }
    advance(owner, clock.instant());
}

# --- request body: engine-held bytes surfaced through the exchange contract ---

fun body_read(context: ptr, output: *u8, capacity: usize, trailers: *field.Fields) body.Progress {
    val state: *RequestBody = context::*RequestBody;
    if (state == nil || state.owner == nil) { ret body.failed("request body has no owner", body.REUSE_FORBIDDEN); }
    val engine: *connection.Engine = ?state.owner.engine;
    if (engine.held_slot == state.slot && engine.held_length != 0) {
        var count: usize = engine.held_length;
        if (count > capacity) { count = capacity; }
        var i: usize = 0;
        for (i < count) {
            output[i] = engine.held_body[i];
            i         = i + 1;
        }
        if (!connection.consume_body(engine, state.slot, count)) {
            ret body.failed("request body consumption was refused", body.REUSE_FORBIDDEN);
        }
        state.pending_output   = nil;
        state.pending_capacity = 0;
        ret body.data(count);
    }
    if (state.owner.engine_slots[state.slot].inbound_complete) {
        state.pending_output   = nil;
        state.pending_capacity = 0;
        ret body.complete(body.REUSE_ALLOWED);
    }
    state.pending_output   = output;
    state.pending_capacity = capacity;
    state.next_token       = state.next_token + 1;
    state.pending_token    = state.next_token;
    ret body.pending(state.pending_token);
}

fun body_finish(context: ptr, mode: body.Mode, trailers: *field.Fields) body.Progress {
    val state: *RequestBody = context::*RequestBody;
    if (state == nil || state.owner == nil) { ret body.failed("request body has no owner", body.REUSE_FORBIDDEN); }
    state.pending_output   = nil;
    state.pending_capacity = 0;
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT) {
        connection.set_disposition(?state.owner.engine, state.slot, connection.BODY_REJECT);
        ret body.rejected(body.REUSE_FORBIDDEN);
    }
    connection.set_disposition(?state.owner.engine, state.slot, connection.BODY_DRAIN);
    if (state.owner.engine_slots[state.slot].inbound_complete) {
        ret body.complete(body.REUSE_ALLOWED);
    }
    state.next_token    = state.next_token + 1;
    state.pending_token = state.next_token;
    ret body.pending(state.pending_token);
}

fun body_complete(context: ptr, token: u64, trailers: *field.Fields) body.Progress {
    val state: *RequestBody = context::*RequestBody;
    if (state == nil || state.owner == nil || token != state.pending_token) {
        ret body.failed("unknown request body completion", body.REUSE_FORBIDDEN);
    }
    val kind:     body.Operation = state.reader.pending_kind;
    val output:   *u8            = state.pending_output;
    val capacity: usize          = state.pending_capacity;
    state.pending_token    = 0;
    state.pending_output   = nil;
    state.pending_capacity = 0;
    if (kind == body.OP_FINISH) {
        if (state.owner.engine_slots[state.slot].inbound_complete) {
            ret body.complete(body.REUSE_ALLOWED);
        }
        state.next_token    = state.next_token + 1;
        state.pending_token = state.next_token;
        ret body.pending(state.pending_token);
    }
    ret body_read(context, output, capacity, trailers);
}

fun body_release(context: ptr) {}

# --- exchange construction from one parsed request head ---

fun make_exchange(owner: *Connection, slot: usize, now: time.Instant) u8 {
    val parsed: *parser.Parsed = connection.parsed(?owner.engine, slot);
    if (parsed == nil) { ret SETUP_PARSED; }
    owner.requests            = owner.requests + 1;
    owner.request_generation  = owner.requests;
    owner.request_deadline_ns = 0;
    if (owner.configured.request_timeout_ns != 0) {
        owner.request_deadline_ns = clock.after_ns(clock.to_ns(now),
            owner.configured.request_timeout_ns);
    }
    if (owner.request_scope_live) { operation_ok(cancel.destroy(?owner.request_scope)); }
    owner.request_scope_live = false;
    # mach-http requires the exchange scope to carry the request's deadline. the
    # wheel entry is what enforces it on a service that submits no io
    if (!operation_ok(cancel.make_child(?owner.request_scope, ?owner.engine_scope,
        clock.deadline(owner.request_deadline_ns)))) {
        ret SETUP_SCOPE;
    }
    owner.request_scope_live            = true;
    owner.request_body.owner            = owner;
    owner.request_body.slot             = slot;
    owner.request_body.pending_token    = 0;
    owner.request_body.next_token       = 0;
    owner.request_body.pending_output   = nil;
    owner.request_body.pending_capacity = 0;
    # the parser already resolved framing; it stays the single authority for length
    val length_known: bool = parsed.plan.mode == framing.FRAME_NONE
        || parsed.plan.mode == framing.FRAME_LENGTH;
    var declared: u64 = 0;
    if (parsed.plan.mode == framing.FRAME_LENGTH) { declared = parsed.plan.length; }
    owner.request_body.reader = body.init_reader(
        (?owner.request_body)::ptr,
        body_read,
        body_finish,
        body_complete,
        body_release,
        body.OWNER_APPLICATION,
        owner.request_generation,
        length_known,
        declared,
        owner.limits.request_body,
        nil,
        ?owner.request_scope,
    );
    if (!owner.request_body.reader.valid) { ret SETUP_BODY; }
    val metadata: message.Metadata = message.Metadata{
        version:    parsed.version,
        secure:     owner.secure,
        early_data: false,
        peer:       endpoint_metadata(owner.peer_kind, ?owner.peer_text[0], owner.peer_len,
            owner.peer_port),
        local: endpoint_metadata(owner.local_kind, ?owner.local_text[0],
            owner.local_len, owner.local_port),
        # calendar time: telemetry and caching measure from it
        received_at:   clock.wall(),
        deadline:      clock.deadline(owner.request_deadline_ns),
        request_index: owner.request_generation,
    };
    if (!message.init_request(?owner.request, parsed.method, parsed.target, metadata,
        parsed.fields, parsed.trailers, ?owner.request_body.reader,
        owner.request_generation, owner.limits)) {
        owner.request_failure = message.validate_request_status(?owner.request, owner.limits);
        ret SETUP_REQUEST;
    }
    if (!message.init_response(?owner.response, ?owner.response_fields[0], RESPONSE_FIELD_SLOTS,
        ?owner.response_trailers[0], RESPONSE_TRAILER_SLOTS, owner.request_generation,
        owner.limits)) { ret SETUP_RESPONSE; }
    owner.exchange.valid = false;
    if (!exchange.init(?owner.exchange, ?owner.request, ?owner.response,
        ?owner.informationals[0], INFORMATIONAL_SLOTS, ?owner.request_scope,
        owner.request_generation, owner.limits)) { ret SETUP_EXCHANGE; }
    if (!exchange.begin(?owner.exchange)) { ret SETUP_BEGIN; }
    call.reset_memory(?owner.memory, owner.configured.call_memory_bytes);
    if (!telemetry_trace.make_root(?owner.trace, false)) { ret SETUP_TRACE; }
    if (!call.bind(?owner.active_call, ?owner.exchange, ?owner.memory, ?owner.trace,
        owner.plan.generation, owner.listener_name, owner.waker)) { ret SETUP_BIND; }
    owner.active_slot            = slot;
    owner.exchange_live          = true;
    owner.exchange_cancelling    = false;
    owner.exchange_call_released = false;
    owner.response_started       = false;
    owner.stage_length           = 0;
    owner.stage_offset           = 0;
    owner.body_done              = false;
    owner.body_chunks            = 0;
    owner.service_pending        = false;
    ret SETUP_OK;
}

fun engine_disposition(chosen: call.Disposition) connection.Disposition {
    if (chosen == call.BODY_DELIVER) { ret connection.BODY_DELIVER; }
    if (chosen == call.BODY_REJECT)  { ret connection.BODY_REJECT; }
    if (chosen == call.BODY_CLOSE)   { ret connection.BODY_CLOSE; }
    ret connection.BODY_DRAIN;
}

# RFC 9112 permits an empty reason phrase, which is the honest answer for a status
# this table does not name. a wrong phrase would misdescribe the response.
fun reason_for(code: status.Status) view.View {
    if (code == status.CONTINUE)                        { ret view.view("Continue", 8); }
    if (code == status.SWITCHING_PROTOCOLS)             { ret view.view("Switching Protocols", 19); }
    if (code == status.EARLY_HINTS)                     { ret view.view("Early Hints", 11); }
    if (code == status.OK)                              { ret view.view("OK", 2); }
    if (code == status.CREATED)                         { ret view.view("Created", 7); }
    if (code == status.ACCEPTED)                        { ret view.view("Accepted", 8); }
    if (code == status.NO_CONTENT)                      { ret view.view("No Content", 10); }
    if (code == status.RESET_CONTENT)                   { ret view.view("Reset Content", 13); }
    if (code == status.PARTIAL_CONTENT)                 { ret view.view("Partial Content", 15); }
    if (code == status.MOVED_PERMANENTLY)               { ret view.view("Moved Permanently", 17); }
    if (code == status.FOUND)                           { ret view.view("Found", 5); }
    if (code == status.SEE_OTHER)                       { ret view.view("See Other", 9); }
    if (code == status.NOT_MODIFIED)                    { ret view.view("Not Modified", 12); }
    if (code == status.TEMPORARY_REDIRECT)              { ret view.view("Temporary Redirect", 18); }
    if (code == status.PERMANENT_REDIRECT)              { ret view.view("Permanent Redirect", 18); }
    if (code == status.BAD_REQUEST)                     { ret view.view("Bad Request", 11); }
    if (code == status.UNAUTHORIZED)                    { ret view.view("Unauthorized", 12); }
    if (code == status.FORBIDDEN)                       { ret view.view("Forbidden", 9); }
    if (code == status.NOT_FOUND)                       { ret view.view("Not Found", 9); }
    if (code == status.METHOD_NOT_ALLOWED)              { ret view.view("Method Not Allowed", 18); }
    if (code == status.NOT_ACCEPTABLE)                  { ret view.view("Not Acceptable", 14); }
    if (code == status.REQUEST_TIMEOUT)                 { ret view.view("Request Timeout", 15); }
    if (code == status.GONE)                            { ret view.view("Gone", 4); }
    if (code == status.LENGTH_REQUIRED)                 { ret view.view("Length Required", 15); }
    if (code == status.PRECONDITION_FAILED)             { ret view.view("Precondition Failed", 19); }
    if (code == status.CONTENT_TOO_LARGE)               { ret view.view("Content Too Large", 17); }
    if (code == status.URI_TOO_LONG)                    { ret view.view("URI Too Long", 12); }
    if (code == status.UNSUPPORTED_MEDIA_TYPE)          { ret view.view("Unsupported Media Type", 22); }
    if (code == status.RANGE_NOT_SATISFIABLE)           { ret view.view("Range Not Satisfiable", 21); }
    if (code == status.EXPECTATION_FAILED)              { ret view.view("Expectation Failed", 18); }
    if (code == status.MISDIRECTED_REQUEST)             { ret view.view("Misdirected Request", 19); }
    if (code == status.UPGRADE_REQUIRED)                { ret view.view("Upgrade Required", 16); }
    if (code == status.TOO_MANY_REQUESTS)               { ret view.view("Too Many Requests", 17); }
    if (code == status.REQUEST_HEADER_FIELDS_TOO_LARGE) { ret view.view("Request Header Fields Too Large", 31); }
    if (code == status.INTERNAL_SERVER_ERROR)           { ret view.view("Internal Server Error", 21); }
    if (code == status.NOT_IMPLEMENTED)                 { ret view.view("Not Implemented", 15); }
    if (code == status.BAD_GATEWAY)                     { ret view.view("Bad Gateway", 11); }
    if (code == status.SERVICE_UNAVAILABLE)             { ret view.view("Service Unavailable", 19); }
    if (code == status.GATEWAY_TIMEOUT)                 { ret view.view("Gateway Timeout", 15); }
    if (code == status.HTTP_VERSION_NOT_SUPPORTED)      { ret view.view("HTTP Version Not Supported", 26); }
    if (code == status.INSUFFICIENT_STORAGE)            { ret view.view("Insufficient Storage", 20); }
    ret view.view(nil, 0);
}

fun begin_response(owner: *Connection, now: time.Instant) bool {
    if (owner.response_started)    { ret true; }
    if (!owner.response.committed) { ret false; }
    var trailers: *field.Fields = nil;
    if (owner.response.trailers.len != 0) { trailers = ?owner.response.trailers; }
    if (!connection.prepare_response(?owner.engine, owner.active_slot, owner.response.status,
        reason_for(owner.response.status), ?owner.response.fields, trailers, now)) { ret false; }
    owner.response_started = true;
    # a response the framing plan cannot keep alive stops this connection from
    # admitting another request, so the engine drains rather than waiting to read
    if (owner.engine_slots[owner.active_slot].close_after) {
        connection.begin_graceful(?owner.engine);
    }
    ret true;
}

# the engine marks a response complete when its terminal write settles, so that
# flag is the single authority. a bodyless response reaches it on its first offer.
fun response_complete(owner: *Connection) bool {
    if (!owner.response_started || owner.active_slot >= PIPELINE_DEPTH) { ret false; }
    ret owner.engine_slots[owner.active_slot].outbound_complete;
}

fun response_body_progress(reader: *body.Reader, output: *u8,
    capacity: usize) body.Progress {
    if (reader.pending_kind == body.OP_NONE) {
        ret body.read(reader, output, capacity);
    }
    if (reader.pending_kind == body.OP_READ) {
        ret body.complete_reader(reader, reader.pending_token);
    }
    ret body.failed("response body has a conflicting pending operation",
        body.REUSE_FORBIDDEN);
}

# the response staging buffer is borrowed from the connection's own account
# only while a response body is being serialized, so an idle connection holds
# none of it. a refusal registers the account for a wake, which the memory
# deadline already bounds
fun ensure_stage(owner: *Connection) bool {
    if (owner.stage_held) { ret true; }
    val got: buffers.Acquired = buffers.source_acquire(?owner.source, ?owner.account,
        buffers.Request{bytes: READ_BYTES, align: 0, lane: memory.LANE_IO, secret: false},
        true);
    if (!(sel got.status.ok)) { ret false; }
    owner.stage_chunk = got.chunk;
    owner.stage_held  = true;
    ret true;
}

fun release_stage(owner: *Connection) {
    if (!owner.stage_held) { ret; }
    buffers.source_release(?owner.source, ?owner.account, owner.stage_chunk);
    owner.stage_held   = false;
    owner.stage_length = 0;
    owner.stage_offset = 0;
}

# pull from the response body into the staging buffer and hand it to the
# serializer
#
# the serializer consumes only what fits in the write buffer, so the unconsumed
# remainder of a staged chunk is offered again before the body is read further.
# dropping it would silently corrupt every response larger than one buffer.
fun advance_response(owner: *Connection, now: time.Instant) Step {
    if (!owner.response_started || response_complete(owner))          { ret STEP_IDLE; }
    if (owner.engine.write_pending || owner.engine.write_length != 0) { ret STEP_BLOCKED; }
    if (owner.stage_offset >= owner.stage_length) {
        owner.stage_offset = 0;
        owner.stage_length = 0;
        if (!owner.body_done) {
            if (owner.response.body_kind == message.BODY_READER) {
                if (!ensure_stage(owner)) { ret STEP_BLOCKED; }
                val reader:   *body.Reader  = owner.response.body_reader;
                val progress: body.Progress = response_body_progress(reader,
                    owner.stage_chunk.data, READ_BYTES);
                if (progress.status == body.DATA) {
                    owner.stage_length = progress.count;
                    owner.body_chunks  = owner.body_chunks + 1;
                    call.record_body(?owner.active_call, owner.stage_chunk.data, progress.count);
                }
                or (progress.status == body.PENDING)  { ret STEP_BLOCKED; }
                or (progress.status == body.COMPLETE) { owner.body_done = true; }
                or                                    { ret STEP_ERROR; }
            }
            or {
                owner.body_done = true;
            }
        }
    }
    var payload: *u8   = nil;
    var length:  usize = 0;
    if (owner.stage_offset < owner.stage_length) {
        payload = ?owner.stage_chunk.data[owner.stage_offset];
        length  = owner.stage_length - owner.stage_offset;
    }
    val final:   bool             = owner.body_done && length == 0;
    val offered: connection.Offer = connection.offer(?owner.engine, owner.active_slot,
        payload, length, final);
    if (offered.status == connection.OFFER_ERROR)   { ret STEP_ERROR; }
    if (offered.status == connection.OFFER_BLOCKED) { ret STEP_BLOCKED; }
    owner.stage_offset = owner.stage_offset + offered.consumed;
    if (offered.consumed == 0 && offered.produced == 0 && !final) { ret STEP_BLOCKED; }
    ret STEP_PROGRESS;
}

fun settle_exchange(owner: *Connection, now: time.Instant) bool {
    if (!owner.exchange_live)                                   { ret true; }
    if (exchange.finish(?owner.exchange) != exchange.FINISH_OK) { ret false; }
    release_stage(owner);
    val finalized: bool = call.release(?owner.active_call);
    budget.release(owner.budgets, ?owner.charge);
    connection.release(?owner.engine, owner.active_slot, now);
    owner.exchange_live = false;
    owner.active_slot   = no_slot();
    ret finalized;
}

fun fail_exchange(owner: *Connection, code: status.Status, now: time.Instant) bool {
    if (owner.response.committed)                                         { ret false; }
    if (!call.reset_response_for_failure(?owner.active_call))             { ret false; }
    if (message.set_status(?owner.response, code) != message.RESPONSE_OK) { ret false; }
    if (call.disposition(?owner.active_call) == call.BODY_UNRESOLVED
        && !call.resolve_body(?owner.active_call, call.BODY_CLOSE)) { ret false; }
    if (service.commit(?owner.active_call) != message.RESPONSE_OK) { ret false; }
    ret begin_response(owner, now);
}

# response progress is the connection's own work: it owns the serializer and the
# write buffer, and the service supplies only the body reader
fun pump_response(owner: *Connection, now: time.Instant) Step {
    if (!owner.response_started) { ret STEP_IDLE; }
    if (!response_complete(owner)) {
        val advanced: Step = advance_response(owner, now);
        if (advanced == STEP_ERROR) {
            owner.state = FAILED;
            ret STEP_ERROR;
        }
        if (advanced == STEP_PROGRESS || (owner.engine.write_length != 0 && !owner.engine.write_pending)) {
            connection.submit_write(?owner.engine);
            ret STEP_PROGRESS;
        }
        if (!response_complete(owner)) { ret STEP_BLOCKED; }
    }
    if (owner.engine.write_pending) { ret STEP_BLOCKED; }
    if (owner.engine.write_length != 0) {
        connection.submit_write(?owner.engine);
        ret STEP_BLOCKED;
    }
    # an exchange settles only once the request body has reached a terminal
    # disposition, so a service that ignored the body cannot strand the slot
    if (!body.reader_terminal_state(owner.request.body)) {
        if (owner.request.body.pending_kind != body.OP_NONE) { ret STEP_BLOCKED; }
        val settled: body.Progress = body.drain(owner.request.body);
        if (settled.status == body.PENDING) { ret STEP_BLOCKED; }
        if (!body.reader_terminal_state(owner.request.body)) {
            owner.state = FAILED;
            ret STEP_ERROR;
        }
    }
    if (!settle_exchange(owner, now)) {
        owner.state = FAILED;
        ret STEP_ERROR;
    }
    ret STEP_PROGRESS;
}

# the h2 session this connection holds, or nil when it holds none
fun h2_of(owner: *Connection) *h2.Session {
    if (owner.h2_session == h2.NO_SESSION) { ret nil; }
    ret h2.session_at(?owner.shared.h2_sessions, owner.h2_session);
}

fun runnable(owner: *Connection) bool {
    if (owner == nil || !owner.initialized || !owner.engine_live
        || owner.state != ACTIVE) { ret false; }
    if (owner.h2_session != h2.NO_SESSION) { ret true; }
    ret owner.engine.state != connection.CLOSED && owner.engine.state != connection.FAILED;
}

# build one exchange and cross the dispatch boundary with it exactly once
# a service that is waiting on something of its own gets another turn without the
# boundary being crossed again
fun resume_service(owner: *Connection, now: time.Instant) Step {
    val served: dispatch.Result = dispatch.resume(owner.plan, ?owner.active_call,
        owner.budgets, ?owner.charge, now);
    if (served.outcome == dispatch.PENDING) { ret STEP_BLOCKED; }
    owner.service_pending = false;
    if (served.outcome == dispatch.FAILED) {
        if (!fail_exchange(owner, status.BAD_GATEWAY, now)) {
            owner.state = FAILED;
            ret STEP_ERROR;
        }
        ret STEP_PROGRESS;
    }
    connection.set_disposition(?owner.engine, owner.active_slot,
        engine_disposition(call.disposition(?owner.active_call)));
    if (!begin_response(owner, now)) {
        owner.state = FAILED;
        ret STEP_ERROR;
    }
    ret STEP_PROGRESS;
}

fun start_exchange(owner: *Connection, slot: usize, now: time.Instant) Step {
    owner.setup_failure = make_exchange(owner, slot, now);
    if (owner.setup_failure != SETUP_OK) {
        owner.state = FAILED;
        ret STEP_ERROR;
    }
    val served: dispatch.Result = dispatch.serve(owner.plan, ?owner.active_call,
        ?owner.captures[0], CAPTURE_SLOTS, owner.budgets, ?owner.charge, now);
    if (served.outcome == dispatch.FAILED) {
        if (!fail_exchange(owner, status.INTERNAL_SERVER_ERROR, now)) {
            owner.state = FAILED;
            ret STEP_ERROR;
        }
        ret STEP_PROGRESS;
    }
    # a service waiting on work of its own has not produced a response yet
    if (served.outcome == dispatch.PENDING) {
        owner.service_pending = true;
        ret STEP_PROGRESS;
    }
    connection.set_disposition(?owner.engine, owner.active_slot,
        engine_disposition(call.disposition(?owner.active_call)));
    if (!begin_response(owner, now)) {
        owner.state = FAILED;
        ret STEP_ERROR;
    }
    ret STEP_PROGRESS;
}

# translate one protocol event into product work
#
# this is the only place a connection event becomes a service call. a pipelined
# request that arrives while an exchange is live is held, not started, so
# responses stay wire-ordered and one exchange owns the arena at a time.
fun apply(owner: *Connection, event: connection.Event, now: time.Instant) Step {
    owner.last_event = event.kind;
    if (event.kind == connection.EVENT_NEED_READ) {
        connection.submit_read(?owner.engine);
        ret STEP_BLOCKED;
    }
    # a memory-blocked engine is woken through the account when the pool can
    # fund it again
    if (event.kind == connection.EVENT_NONE || event.kind == connection.EVENT_SATURATED
        || event.kind == connection.EVENT_MEMORY_BLOCKED) {
        ret STEP_BLOCKED;
    }
    # an engine with no request in hand closes at its header deadline, and one
    # that got there blocked on memory is a memory timeout like any other
    if (event.kind == connection.EVENT_TIMED_OUT && owner.engine.memory_blocked) {
        shed_for_memory(owner);
    }
    if (event.kind == connection.EVENT_CLOSED || event.kind == connection.EVENT_PEER_CLOSED
        || event.kind == connection.EVENT_ERROR || event.kind == connection.EVENT_TIMED_OUT
        || event.kind == connection.EVENT_CANCELLED || event.kind == connection.EVENT_TUNNEL) {
        owner.state = CLOSING;
        ret STEP_DONE;
    }
    if (event.kind == connection.EVENT_REQUEST_HEADERS) {
        if (owner.exchange_live) {
            owner.pending_slot = event.slot;
            owner.has_pending  = true;
            ret STEP_BLOCKED;
        }
        ret start_exchange(owner, event.slot, now);
    }
    # a pending service completes its own suspended operation when it is resumed,
    # so the host only completes what was left outstanding after the service returned
    if (event.kind == connection.EVENT_REQUEST_BODY
        || event.kind == connection.EVENT_REQUEST_COMPLETE) {
        if (owner.exchange_live && !owner.service_pending
            && owner.request_body.pending_token != 0) {
            body.complete_reader(owner.request.body, owner.request_body.pending_token);
        }
        ret STEP_PROGRESS;
    }
    ret STEP_PROGRESS;
}

# advancing the engine is how a request body reaches its terminal state, so the
# inbound side keeps moving even while a response is still being written
fun pump_inbound(owner: *Connection, now: time.Instant) Step {
    if (owner.has_pending) { ret STEP_BLOCKED; }
    ret apply(owner, connection.process(?owner.engine, now), now);
}

# one step: response work first, then whatever the protocol has next
pub fun step(owner: *Connection, now: time.Instant) Step {
    if (owner == nil || !owner.initialized) { ret STEP_ERROR; }
    if (owner.state == NEW) {
        var opened: Step = STEP_BLOCKED;
        if (owner.handshaking) { opened = advance_handshake(owner, now); }
        or                     { opened = advance_prologue(owner, now); }
        owner.last_step = opened;
        ret opened;
    }
    # a secure connection's transport work is driven by this loop rather than by
    # the engine, because exactly one TLS operation may run at a time
    if (owner.session != secure.NO_SESSION && owner.engine_live) {
        var settled: transport.Completion;
        if (secure.take(owner.session, ?settled)) {
            if (owner.h2_session != h2.NO_SESSION) {
                val stepped: Step = from_h2(h2.complete_io(h2_of(owner),
                    ?settled, now));
                if (stepped == STEP_DONE || stepped == STEP_ERROR) {
                    owner.state = CLOSING;
                }
            }
            or {
                val event: connection.Event = connection.complete_io(?owner.engine,
                    ?settled, now);
                if (runnable(owner)) { apply(owner, event, now); }
            }
            secure.drive(owner.session);
            owner.last_step = STEP_PROGRESS;
            ret STEP_PROGRESS;
        }
    }
    if (owner.state != ACTIVE) { ret STEP_DONE; }
    if (owner.h2_session != h2.NO_SESSION) {
        val stepped: Step = from_h2(h2.step(h2_of(owner), now));
        # whatever the engine queued in this step has to start now. leaving it
        # for the next completion strands the last frame of a response behind a
        # read the peer will never satisfy, because the peer is waiting for it.
        if (owner.session != secure.NO_SESSION) { secure.drive(owner.session); }
        owner.last_step = stepped;
        if (stepped == STEP_DONE || stepped == STEP_ERROR) { owner.state = CLOSING; }
        ret stepped;
    }
    if (owner.session != secure.NO_SESSION) { secure.drive(owner.session); }
    if (owner.engine.state == connection.CLOSED || owner.engine.state == connection.FAILED) {
        owner.state = CLOSING;
        ret STEP_DONE;
    }
    if (owner.exchange_live && owner.service_pending) {
        val resumed: Step = resume_service(owner, now);
        owner.last_step = resumed;
        if (resumed != STEP_BLOCKED) { ret resumed; }
        val inbound_while_pending: Step = pump_inbound(owner, now);
        owner.last_step = inbound_while_pending;
        ret inbound_while_pending;
    }
    if (owner.exchange_live) {
        val pumped: Step = pump_response(owner, now);
        if (pumped == STEP_PROGRESS || pumped == STEP_ERROR) {
            owner.last_step = pumped;
            ret pumped;
        }
        val inbound: Step = pump_inbound(owner, now);
        owner.last_step = inbound;
        ret inbound;
    }
    if (owner.has_pending) {
        owner.has_pending     = false;
        owner.service_pending = false;
        val started: Step = start_exchange(owner, owner.pending_slot, now);
        owner.last_step = started;
        ret started;
    }
    # a draining engine finishes its close handshake instead of reading again
    if (owner.engine.state == connection.DRAINING && connection.progress_close(?owner.engine)) {
        owner.last_step = STEP_PROGRESS;
        ret STEP_PROGRESS;
    }
    val taken: Step = pump_inbound(owner, now);
    owner.last_step = taken;
    ret taken;
}

# drive until the connection blocks on I/O or finishes
pub fun advance(owner: *Connection, now: time.Instant) Step {
    if (owner == nil || !owner.initialized) { ret STEP_ERROR; }
    fin { track_memory(owner, now); }
    # a wake may be the pool funding what TLS was blocked on
    if (owner.session != secure.NO_SESSION) { secure.resume(owner.session); }
    var steps: usize = 0;
    # a connection still moving when its step bound runs out has more to do
    var settled: Step = STEP_PROGRESS;
    for (steps < MAX_STEPS) {
        val progress: Step = step(owner, now);
        if (progress != STEP_PROGRESS) {
            settled = progress;
            brk;
        }
        steps = steps + 1;
    }
    # the engines have nothing more to send, so a read may start without a
    # response ever having to wait behind it
    if (owner.session != secure.NO_SESSION && owner.engine_live
        && owner.state == ACTIVE && secure.drive(owner.session)) {
        ret STEP_PROGRESS;
    }
    ret settled;
}

pub fun begin_graceful(owner: *Connection) bool {
    if (owner == nil || !owner.initialized) { ret false; }
    # a connection still in its prologue has no engine to signal, so it is
    # simply not admitted any further
    if (!owner.engine_live) {
        owner.state = CLOSING;
        ret true;
    }
    if (owner.h2_session != h2.NO_SESSION) { ret h2.begin_graceful(h2_of(owner)); }
    # an engine that is already draining or ending needs no signal; only an
    # open engine has something to be asked
    if (owner.engine.state != connection.OPEN) { ret true; }
    ret connection.begin_graceful(?owner.engine);
}

fun exchange_terminal(active: *exchange.Exchange) bool {
    ret active.state == exchange.COMPLETE_STATE
        || active.state == exchange.CANCELLED_STATE
        || active.state == exchange.TIMED_OUT_STATE
        || active.state == exchange.FAILED_STATE;
}

fun settle_exchange_close(owner: *Connection) exchange.FinishStatus {
    if (!owner.exchange_live) { ret exchange.FINISH_OK; }
    var settled: exchange.FinishStatus = exchange.FINISH_OK;
    if (!exchange_terminal(?owner.exchange)) {
        if (owner.exchange_cancelling) {
            settled = exchange.settle_cancellation(?owner.exchange);
        }
        or {
            owner.exchange_cancelling = true;
            settled                   = exchange.cancel_exchange(?owner.exchange);
        }
        if (settled != exchange.FINISH_OK) { ret settled; }
    }
    if (!owner.exchange_call_released) {
        if (!call.release(?owner.active_call)) { owner.close_failed = true; }
        owner.exchange_call_released = true;
    }
    if (owner.charge.live && !budget.release(owner.budgets, ?owner.charge)) {
        owner.close_failed = true;
    }
    owner.exchange_live = false;
    ret exchange.FINISH_OK;
}

fun abandon_exchange_close(owner: *Connection) {
    if (!owner.exchange_live) { ret; }
    if (!owner.exchange_call_released) {
        call.abandon(?owner.active_call);
        owner.exchange_call_released = true;
    }
    if (owner.charge.live) { budget.release(owner.budgets, ?owner.charge); }
    owner.exchange_live = false;
    owner.close_failed  = true;
}

fun close_h1_engine(owner: *Connection) bool {
    if (!owner.engine_live) { ret true; }
    if (!owner.engine_close_started) {
        owner.engine_close_started = true;
        if (!connection.cancel_connection(?owner.engine)
            && owner.engine.state != connection.CLOSED) {
            owner.close_failed = true;
        }
    }
    var i: usize = 0;
    for (i < PIPELINE_DEPTH) {
        if (owner.engine_slots[i].state != connection.SLOT_FREE
            && !owner.engine_slots[i].released) {
            val sequence: u64 = owner.engine_slots[i].sequence;
            if (sequence == 0
                || !connection.abandon(?owner.engine, i, sequence)) {
                owner.close_failed = true;
            }
        }
        i = i + 1;
    }
    if (!connection.destroy(?owner.engine)) { ret false; }
    owner.engine_live = false;
    owner.active_slot = connection.NO_SLOT;
    ret true;
}

# start what the engine queued on the secure channel and take one completion it
# published. true when one was taken, which may be what the engine waits on
fun pump_secure_close(owner: *Connection) bool {
    secure.drive(owner.session);
    var settled: transport.Completion;
    if (!secure.take(owner.session, ?settled)) { ret false; }
    connection.complete_io(?owner.engine, ?settled, clock.instant());
    ret true;
}

# a retiring slot is no longer advanced, so closing drives the secure channel
# itself. the engine's cancellation queues its transport close on the channel,
# and nothing starts it but a drive after that queueing (#257). a completion the
# channel settles without the socket is taken here at once. one that needs the
# socket wakes the connection through settle_secure for the next close to take
fun close_h1(owner: *Connection) bool {
    for (!close_h1_engine(owner)) {
        if (owner.session == secure.NO_SESSION || !pump_secure_close(owner)) {
            ret false;
        }
    }
    ret true;
}

pub fun close(owner: *Connection) bool {
    if (owner == nil || !owner.initialized || owner.state == CLOSED) { ret false; }
    owner.close_pending = false;
    if (!owner.close_started) {
        owner.close_started = true;
        owner.state         = CLOSING;
        # cancellation settles every transport operation through its normal
        # completion path while this owner remains live for those completions.
        cancel.cancel(?owner.operation_root);
    }
    # a live exchange must settle before the connection goes away, or a service
    # holding a resource in its body reader never gets its release call
    if (owner.exchange_live) {
        val settled: exchange.FinishStatus = settle_exchange_close(owner);
        if (settled == exchange.FINISH_BODY_PENDING) {
            owner.close_pending = true;
            ret false;
        }
        if (settled != exchange.FINISH_OK) {
            # no completion can turn a terminal contract failure into success.
            # record it and tear down instead of parking stop in a retry loop.
            abandon_exchange_close(owner);
        }
    }
    if (owner.h2_session != h2.NO_SESSION) {
        owner.requests = h2.requests(h2_of(owner));
        val released: h2.ReleaseStatus = h2.release_status(?owner.shared.h2_sessions,
            owner.h2_session);
        if (released == h2.RELEASE_PENDING) {
            owner.close_pending = true;
            ret false;
        }
        if (released == h2.RELEASE_FAILED) { owner.close_failed = true; }
        owner.h2_session  = h2.NO_SESSION;
        owner.engine_live = false;
    }
    or (owner.engine_live) {
        if (!close_h1(owner)) {
            owner.close_pending = true;
            ret false;
        }
    }
    if (owner.prologue_pending) {
        owner.close_pending = true;
        ret false;
    }
    if (owner.session != secure.NO_SESSION) {
        secure.release(owner.session);
        owner.session = secure.NO_SESSION;
    }
    owner.handshaking = false;
    # the account cannot close while it still holds the staging chunk, and a
    # connection torn down mid-response still holds it
    release_stage(owner);
    if (owner.account_live) {
        if (!memory.close(owner.borrower.memory, ?owner.account)) { owner.close_failed = true; }
        owner.account_live = false;
    }
    release_prologue_scope(owner);
    if (owner.request_scope_live) {
        cancel.destroy(?owner.request_scope);
        owner.request_scope_live = false;
    }
    if (!operation_ok(cancel.destroy(?owner.engine_scope))
        || !operation_ok(cancel.destroy(?owner.control_scope))
        || !operation_ok(cancel.destroy(?owner.operation_root))) { owner.close_failed = true; }
    owner.state       = CLOSED;
    owner.initialized = false;
    ret !owner.close_failed;
}

# whether the driver has taken this connection's socket to close. a socket the
# driver has seen is only ever closed through it, so when nothing here closed
# it, the listener that accepted it does (#716)
pub fun stream_released(owner: *Connection) bool {
    ret owner != nil && !io_handle.socket_is_valid(owner.stream.handle);
}

pub fun close_waiting(owner: *Connection) bool {
    ret owner != nil && owner.initialized && owner.close_pending;
}

# the operational view of one connection, for tests and telemetry alike
pub rec Snapshot {
    state:            State;
    protocol:         selection.Protocol;
    refusal:          prologue.Refusal;
    secure:           bool;
    forwarded_peer:   bool;
    engine_state:     connection.State;
    engine_error:     connection.Error;
    last_event:       connection.EventKind;
    last_step:        Step;
    setup_failure:    Setup;
    request_failure:  message.RequestStatus;
    body_chunks:      u64;
    requests:         u64;
    exchange_live:    bool;
    response_started: bool;
    service_pending:  bool;
    response_status:  status.Status;
    stage_held:       bool;
}

pub fun snapshot(owner: *Connection) Snapshot {
    if (owner == nil) {
        ret Snapshot{state: CLOSED, protocol: selection.NONE,
            refusal:         prologue.REFUSED_NONE, secure: false, forwarded_peer: false,
            engine_state:    0, engine_error: 0,
            last_event:      connection.EVENT_NONE, last_step: STEP_IDLE, setup_failure: SETUP_OK, request_failure: 0, body_chunks: 0, requests: 0,
            exchange_live:   false, response_started: false, service_pending: false,
            response_status: 0, stage_held: false};
    }
    ret Snapshot{
        state:            owner.state,
        protocol:         owner.protocol,
        refusal:          owner.refusal,
        secure:           owner.secure,
        forwarded_peer:   owner.peer_kind == message.ENDPOINT_FORWARDED,
        engine_state:     owner.engine.state,
        engine_error:     owner.engine.error,
        last_event:       owner.last_event,
        last_step:        owner.last_step,
        setup_failure:    owner.setup_failure,
        request_failure:  owner.request_failure,
        body_chunks:      owner.body_chunks,
        requests:         owner.requests,
        exchange_live:    owner.exchange_live,
        response_started: owner.response_started,
        service_pending:  owner.service_pending,
        response_status:  owner.response.status,
        stage_held:       owner.stage_held,
    };
}

rec PendingResponseTest {
    output:   *u8;
    capacity: usize;
    ready:    bool;
    reader:   body.Reader;
}

fun pending_response_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    val state: *PendingResponseTest = context::*PendingResponseTest;
    if (state.ready) { ret body.complete(body.REUSE_ALLOWED); }
    state.output   = output;
    state.capacity = capacity;
    ret body.pending(41);
}

fun pending_response_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT)  { ret body.rejected(body.REUSE_FORBIDDEN); }
    ret body.complete(body.REUSE_ALLOWED);
}

fun pending_response_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val state: *PendingResponseTest = context::*PendingResponseTest;
    if (state == nil || token != 41 || state.output == nil || state.capacity < 4) {
        ret body.failed("pending response completion lost its buffer",
            body.REUSE_FORBIDDEN);
    }
    state.output[0] = 'l';
    state.output[1] = 'a';
    state.output[2] = 't';
    state.output[3] = 'e';
    state.ready     = true;
    ret body.data(4);
}

fun pending_response_release(context: ptr) {}

test "connection: a pending response read completes into the retained stage" {
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    var state: PendingResponseTest;
    state.output   = nil;
    state.capacity = 0;
    state.ready    = false;
    state.reader   = body.init_reader((?state)::ptr, pending_response_read,
        pending_response_finish, pending_response_complete,
        pending_response_release, body.OWNER_APPLICATION, 1, true, 4,
        body.limits(4, 4, 2), nil, ?scope);
    var output:  [4]u8;
    val pending: body.Progress = response_body_progress(?state.reader,
        ?output[0], 4);
    if (pending.status != body.PENDING
        || state.reader.pending_kind != body.OP_READ) {
        operation_ok(cancel.destroy(?scope));
        ret 2;
    }
    val completed: body.Progress = response_body_progress(?state.reader,
        ?output[0], 4);
    if (completed.status != body.DATA || completed.count != 4
        || output[0] != 'l' || output[3] != 'e') {
        operation_ok(cancel.destroy(?scope));
        ret 3;
    }
    if (response_body_progress(?state.reader, ?output[0], 4).status
        != body.COMPLETE) {
        operation_ok(cancel.destroy(?scope));
        ret 4;
    }
    cancel.destroy(?scope);
    ret 0;
}

test "connection: a pending request body read completes into the retained buffer" {
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    var owner: Connection;
    owner.engine.initialized               = true;
    owner.engine.capacity                  = PIPELINE_DEPTH;
    owner.engine.role                      = connection.SERVER;
    owner.engine.slots                     = ?owner.engine_slots[0];
    owner.engine.held_slot                 = connection.NO_SLOT;
    owner.engine.held_length               = 0;
    owner.engine_slots[0].state            = connection.SLOT_LIVE;
    owner.engine_slots[0].inbound_complete = false;
    owner.request_body.owner               = ?owner;
    owner.request_body.slot                = 0;
    owner.request_body.pending_token       = 0;
    owner.request_body.next_token          = 0;
    owner.request_body.pending_output      = nil;
    owner.request_body.pending_capacity    = 0;
    var reader: body.Reader = body.init_reader(
        (?owner.request_body)::ptr,
        body_read,
        body_finish,
        body_complete,
        body_release,
        body.OWNER_APPLICATION,
        1,
        true,
        4,
        body.limits(4, 4, 2),
        nil,
        ?scope,
    );
    if (!reader.valid) {
        cancel.destroy(?scope);
        ret 2;
    }
    var buffer:  [4]u8;
    val initial: body.Progress = body.read(?reader, ?buffer[0], 4);
    if (initial.status != body.PENDING || reader.pending_kind != body.OP_READ
        || owner.request_body.pending_output != ?buffer[0]
        || owner.request_body.pending_capacity != 4) {
        cancel.destroy(?scope);
        ret 3;
    }
    var chunk: [4]u8;
    chunk[0]                 = 'h';
    chunk[1]                 = 'e';
    chunk[2]                 = 'l';
    chunk[3]                 = 'p';
    owner.engine.held_slot   = 0;
    owner.engine.held_length = 4;
    owner.engine.held_body   = ?chunk[0];
    val completed: body.Progress = body.complete_reader(?reader, initial.token);
    if (completed.status != body.DATA || completed.count != 4
        || buffer[0] != 'h' || buffer[1] != 'e' || buffer[2] != 'l' || buffer[3] != 'p'
        || owner.request_body.pending_output != nil || owner.request_body.pending_capacity != 0) {
        cancel.destroy(?scope);
        ret 4;
    }
    owner.engine_slots[0].inbound_complete = true;
    val terminal: body.Progress = body.read(?reader, ?buffer[0], 4);
    if (terminal.status != body.COMPLETE) {
        cancel.destroy(?scope);
        ret 5;
    }
    cancel.destroy(?scope);
    ret 0;
}

rec PendingCloseTest {
    finish_calls:  usize;
    release_calls: usize;
    reader:        body.Reader;
}

fun pending_close_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.pending(51);
}

fun pending_close_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *PendingCloseTest = context::*PendingCloseTest;
    state.finish_calls = state.finish_calls + 1;
    if (mode != body.CANCEL) {
        ret body.failed("unexpected close finish mode", body.REUSE_FORBIDDEN);
    }
    if (state.finish_calls == 1) { ret body.pending(52); }
    ret body.cancelled(body.REUSE_FORBIDDEN);
}

fun pending_close_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    ret body.failed("pending close is settled by cancellation retry",
        body.REUSE_FORBIDDEN);
}

fun pending_close_release(context: ptr) {
    val state: *PendingCloseTest = context::*PendingCloseTest;
    state.release_calls = state.release_calls + 1;
}

test "connection: pending H1 response cancellation retains exchange and budget" {
    val configured: message.Limits = message.limits_default();
    val generation: u64            = 81;
    var owner:      Connection;
    var heap:       A.Allocator;
    page.make(?heap);
    var chunks: storage.Chunks;
    if (!storage.make_chunks(?chunks, ?heap))                                            { ret 1; }
    if (!operation_ok(cancel.make_root(?owner.request_scope, opt[time.Instant].none{}))) { ret 1; }
    var request_body:   body.Reader  = body.empty_reader(generation);
    var request_fields: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    var request_trailers: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    val metadata: message.Metadata = message.Metadata{
        version:       message.version_h1(1, 1),
        secure:        false,
        early_data:    false,
        peer:          message.unspecified_endpoint(),
        local:         message.unspecified_endpoint(),
        received_at:   time.Time{sec: 0, nsec: 0},
        deadline:      opt[time.Instant].none{},
        request_index: generation,
    };
    if (!message.init_request(?owner.request, method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1), view.view(nil, 0)),
        metadata, request_fields, request_trailers, ?request_body,
        generation, configured)
        || !message.init_response(?owner.response, ?owner.response_fields[0],
        RESPONSE_FIELD_SLOTS, ?owner.response_trailers[0],
        RESPONSE_TRAILER_SLOTS, generation, configured)) {
        cancel.destroy(?owner.request_scope);
        ret 2;
    }
    var wake_pages: A.Allocator;
    page.make(?wake_pages);
    var wakes: hedge_wake.Queue;
    var state: PendingCloseTest;
    state.finish_calls  = 0;
    state.release_calls = 0;
    state.reader        = body.init_reader((?state)::ptr, pending_close_read,
        pending_close_finish, pending_close_complete, pending_close_release,
        body.OWNER_APPLICATION, generation, true, 0,
        configured.response_body, ?owner.response.trailers,
        ?owner.request_scope);
    if (!state.reader.valid
        || message.set_status(?owner.response, status.OK) != message.RESPONSE_OK
        || message.set_body_reader(?owner.response, ?state.reader, configured)
        != message.RESPONSE_OK
        || !exchange.init(?owner.exchange, ?owner.request, ?owner.response,
        ?owner.informationals[0], INFORMATIONAL_SLOTS, ?owner.request_scope,
        generation, configured)
        || !exchange.begin(?owner.exchange)
        || exchange.commit(?owner.exchange, configured) != message.RESPONSE_OK
        || !call.make_memory(?owner.memory, ?chunks, storage.MIN_CHUNK)
        || !telemetry_trace.make_root(?owner.trace, false)
        || !hedge_wake.make(?wakes, ?wake_pages)
        || !call.bind(?owner.active_call, ?owner.exchange, ?owner.memory,
        ?owner.trace, generation, "test", hedge_wake.waker(?wakes, 1))) {
        cancel.destroy(?owner.request_scope);
        ret 3;
    }
    var items:   [1]budget.Budget;
    var budgets: budget.Set;
    if (!budget.make(?budgets, ?items[0], 1)) {
        cancel.destroy(?owner.request_scope);
        ret 4;
    }
    val index: usize = budget.define(?budgets, "requests", 1, 0, 0, 0);
    owner.budgets = ?budgets;
    if (index == budget.NO_BUDGET
        || budget.charge(?budgets, index, 0, time.Instant{sec: 0, nsec: 0},
        ?owner.charge, hedge_wake.no_waker()) != budget.ADMITTED) {
        cancel.destroy(?owner.request_scope);
        ret 5;
    }
    owner.exchange_live          = true;
    owner.exchange_cancelling    = false;
    owner.exchange_call_released = false;
    owner.close_failed           = false;
    if (settle_exchange_close(?owner) != exchange.FINISH_BODY_PENDING
        || !owner.exchange_live || !owner.charge.live
        || owner.active_call.settled || state.finish_calls != 1
        || state.release_calls != 0
        || budget.snapshot(?budgets, index).active != 1) {
        cancel.destroy(?owner.request_scope);
        ret 6;
    }
    if (settle_exchange_close(?owner) != exchange.FINISH_OK
        || owner.exchange_live || owner.charge.live
        || !owner.active_call.settled || state.finish_calls != 2
        || state.release_calls != 1
        || budget.snapshot(?budgets, index).active != 0) {
        cancel.destroy(?owner.request_scope);
        ret 7;
    }
    if (settle_exchange_close(?owner) != exchange.FINISH_OK
        || state.finish_calls != 2 || state.release_calls != 1) {
        cancel.destroy(?owner.request_scope);
        ret 8;
    }
    owner.exchange.valid         = false;
    owner.exchange.state         = exchange.RESPONDING;
    owner.exchange_live          = true;
    owner.exchange_cancelling    = false;
    owner.exchange_call_released = false;
    owner.close_failed           = false;
    if (budget.charge(?budgets, index, 0, time.Instant{sec: 0, nsec: 0},
        ?owner.charge, hedge_wake.no_waker()) != budget.ADMITTED
        || settle_exchange_close(?owner) != exchange.FINISH_INVALID) {
        cancel.destroy(?owner.request_scope);
        ret 9;
    }
    abandon_exchange_close(?owner);
    if (owner.exchange_live || owner.charge.live || !owner.close_failed
        || budget.snapshot(?budgets, index).active != 0) {
        cancel.destroy(?owner.request_scope);
        ret 10;
    }
    if (!operation_ok(cancel.destroy(?owner.request_scope))) { ret 11; }
    ret 0;
}

test "connection: the configured pipeline bound reaches both protocol engines" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.limits.max_pipeline_depth = 1;
    var configured: Config = config_from(?graph);
    if (configured.engine.max_pipeline != 1 || configured.max_streams != 1) {
        ret 1;
    }
    graph.limits.max_pipeline_depth = 100;
    configured                      = config_from(?graph);
    if (configured.engine.max_pipeline != PIPELINE_DEPTH
        || configured.max_streams != h2.MAX_STREAMS) { ret 2; }
    ret 0;
}

pub fun finished(owner: *Connection) bool {
    ret owner == nil || !owner.initialized || owner.state == CLOSING
        || owner.state == CLOSED || owner.state == FAILED;
}

test "connection: a connection starved of pool memory past its wait is shed" {
    var pages: A.Allocator;
    page.make(?pages);
    var pool: memory.Memory;
    if (!memory.make(?pool, 16384, ?pages)) { ret 1; }
    var owner: Connection;
    owner.initialized               = true;
    owner.state                     = ACTIVE;
    owner.configured.memory_wait_ns = 1000;
    memory.borrower(?owner.borrower, ?pool, 7, 0,
        memory.connection_budgets(1048576, 0, 1048576, 0, 0, 0));
    if (!memory.open(?owner.borrower, ?owner.account)) { ret 2; }
    owner.account_live = true;
    owner.source       = memory.borrowed_source(?owner.borrower);
    val request: buffers.Request = buffers.Request{bytes: 4096, align: 0,
        lane: memory.LANE_IO, secret: false};
    var held:  [8]buffers.Chunk;
    var count: usize = 0;
    for (count < 8) {
        val got: buffers.Acquired = buffers.source_acquire(?owner.source, ?owner.account,
            request, true);
        if (!(sel got.status.ok)) { brk; }
        held[count] = got.chunk;
        count       = count + 1;
    }
    if (count == 8 || !memory.waiting(?owner.account)) { ret 3; }
    # the bound runs from the first step that ends waiting, not the latest
    track_memory(?owner, clock.from_ns(5000));
    track_memory(?owner, clock.from_ns(5500));
    if (owner.memory_deadline_ns != 6000) { ret 4; }
    var hint: u64 = 0;
    if (!next_deadline(?owner, ?hint) || hint != 6000) { ret 5; }
    # funded again, the bound clears
    count = count - 1;
    buffers.source_release(?owner.source, ?owner.account, held[count]);
    track_memory(?owner, clock.from_ns(5600));
    if (owner.memory_deadline_ns != 0) { ret 6; }
    var owners: [2]u64;
    memory.woken(?pool, ?owners[0], 2);
    val again: buffers.Acquired = buffers.source_acquire(?owner.source, ?owner.account,
        request, true);
    if (!(sel again.status.ok)) { ret 7; }
    held[count] = again.chunk;
    count       = count + 1;
    val short: buffers.Acquired = buffers.source_acquire(?owner.source, ?owner.account,
        request, true);
    if ((sel short.status.ok) || !memory.waiting(?owner.account)) { ret 8; }
    track_memory(?owner, clock.from_ns(7000));
    expire(?owner, 7999);
    if (owner.state != ACTIVE || memory_expired(?owner)) { ret 9; }
    expire(?owner, 8000);
    val seen: memory.Snapshot = memory.snapshot(?pool);
    if (owner.state != FAILED || !memory_expired(?owner)
        || seen.lanes[memory.LANE_IO::usize].timeouts != 1) { ret 10; }
    for (count != 0) {
        count = count - 1;
        buffers.source_release(?owner.source, ?owner.account, held[count]);
    }
    memory.woken(?pool, ?owners[0], 2);
    if (!memory.close(?pool, ?owner.account) || !memory.destroy(?pool)) { ret 11; }
    ret 0;
}
