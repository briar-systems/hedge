# the cleartext HTTP/1 connection plane
#
# a connection owns its transport, its protocol engine, and one exchange at a
# time. it translates connection state into the common service exchange and then
# calls into dispatch. dispatch learns nothing about the transport from here, so
# TLS, ALPN, and the other protocol engines attach in front of this module rather
# than inside it.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.unwrap_ok;
