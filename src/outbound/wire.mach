# http/1.1 codec for the outbound client
#
# the exact translation between a request the client was handed and the bytes
# on the wire, and between the bytes that came back and a response, so the
# client only moves bytes and never sees framing. the client owns framing:
# the host, content-length, transfer-encoding and connection fields are its to
# write, and a caller that supplies one is refused rather than overridden.

use http_date: hedge.http.date;
use http.core.field;
use http.core.method;
use http.core.status;
use std.chrono.time;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub val MAX_HOST_BYTES:     usize = 253;
pub val MAX_HEAD_BYTES:     usize = 16384;
pub val DEFAULT_HTTP_PORT:  u16   = 80;
pub val DEFAULT_HTTPS_PORT: u16   = 443;

pub def Parse: u8;
pub val PARSE_OK:         Parse = 1;
pub val PARSE_INCOMPLETE: Parse = 2;
pub val PARSE_INVALID:    Parse = 3;
pub val PARSE_LIMIT:      Parse = 4;

# an absolute url reduced to what a connection needs
pub rec Target {
    host:   view.View;
    path:   view.View;
    port:   u16;
    secure: bool;
}

# one parsed response. `consumed` is where the message ended in what was read,
# and `reusable` says the connection may carry another exchange after it: the
# message delimited itself, the peer speaks http/1.1 and did not ask to close.
pub rec Parsed {
    status:   status.Status;
    fields:   *field.Fields;
    body:     view.View;
    consumed: usize;
    reusable: bool;
}

fun empty_view() view.View {
    var value: view.View;
    value.data = nil;
    value.len  = 0;
    ret value;
}

fun prefix_is(url: view.View, at: usize, value: str, length: usize) bool {
    if (at + length > url.len) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (url.data[at + i] != value[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

# splits an absolute http or https url into host, port, and origin-form path.
# userinfo is refused rather than ignored, because an authority the caller did
# not expect must never be reached with credentials the caller did not intend.
pub fun split_url(url: view.View, output: *Target) bool {
    if (output == nil) { ret false; }
    output.host   = empty_view();
    output.path   = empty_view();
    output.port   = 0;
    output.secure = false;
    if (url.data == nil || url.len == 0) { ret false; }
    var at: usize = 0;
    if (prefix_is(url, 0, "https://", 8)) {
        output.secure = true;
        output.port   = DEFAULT_HTTPS_PORT;
        at            = 8;
    }
    or (prefix_is(url, 0, "http://", 7)) {
        output.secure = false;
        output.port   = DEFAULT_HTTP_PORT;
        at            = 7;
    }
    or { ret false; }
    val authority_at: usize = at;
    for (at < url.len && url.data[at] != '/' && url.data[at] != '?'
        && url.data[at] != '#') {
        if (url.data[at] == '@') { ret false; }
        at = at + 1;
    }
    var host_end: usize = at;
    var i:        usize = authority_at;
    var colon:    usize = at;
    for (i < at) {
        if (url.data[i] == ':') { colon = i; }
        i = i + 1;
    }
    if (colon != at) {
        host_end = colon;
        var port: usize = 0;
        var j:    usize = colon + 1;
        if (j >= at) { ret false; }
        for (j < at) {
            if (!digit(url.data[j])) { ret false; }
            port = port * 10 + (url.data[j] - '0')::usize;
            if (port > 65535) { ret false; }
            j = j + 1;
        }
        if (port == 0) { ret false; }
        output.port = port::u16;
    }
    if (host_end <= authority_at || host_end - authority_at > MAX_HOST_BYTES) {
        ret false;
    }
    output.host = view.view(?url.data[authority_at], host_end - authority_at);
    if (at >= url.len || url.data[at] == '#') {
        output.path = view.view("/", 1);
        ret true;
    }
    var path_end: usize = at;
    for (path_end < url.len && url.data[path_end] != '#') {
        path_end = path_end + 1;
    }
    if (url.data[at] != '/') { ret false; }
    output.path = view.view(?url.data[at], path_end - at);
    ret true;
}

rec Writer {
    data:     *u8;
    capacity: usize;
    len:      usize;
    ok:       bool;
}

fun writer(data: *u8, capacity: usize) Writer {
    var value: Writer;
    value.data     = data;
    value.capacity = capacity;
    value.len      = 0;
    value.ok       = data != nil;
    ret value;
}

fun put(target: *Writer, data: *u8, length: usize) {
    if (!target.ok) { ret; }
    if (length > target.capacity - target.len) {
        target.ok = false;
        ret;
    }
    var i: usize = 0;
    for (i < length) {
        target.data[target.len + i] = data[i];
        i                           = i + 1;
    }
    target.len = target.len + length;
}

fun put_view(target: *Writer, value: view.View) {
    if (value.len == 0) { ret; }
    put(target, value.data, value.len);
}

fun put_str(target: *Writer, value: str, length: usize) {
    put(target, value::*u8, length);
}

fun put_number(target: *Writer, value: usize) {
    var digits:    [20]u8;
    var count:     usize = 0;
    var remaining: usize = value;
    for (true) {
        digits[count] = ('0' + (remaining % 10)::u8);
        count         = count + 1;
        remaining     = remaining / 10;
        if (remaining == 0) { brk; }
    }
    var i: usize = 0;
    for (i < count) {
        put(target, ?digits[count - 1 - i], 1);
        i = i + 1;
    }
}

fun method_name(value: method.Kind, output: **u8, length: *usize) bool {
    if (value == method.GET) {
        @output = "GET"::*u8;
        @length = 3;
        ret true;
    }
    if (value == method.HEAD) {
        @output = "HEAD"::*u8;
        @length = 4;
        ret true;
    }
    if (value == method.POST) {
        @output = "POST"::*u8;
        @length = 4;
        ret true;
    }
    if (value == method.PUT) {
        @output = "PUT"::*u8;
        @length = 3;
        ret true;
    }
    if (value == method.PATCH) {
        @output = "PATCH"::*u8;
        @length = 5;
        ret true;
    }
    if (value == method.DELETE) {
        @output = "DELETE"::*u8;
        @length = 6;
        ret true;
    }
    if (value == method.OPTIONS) {
        @output = "OPTIONS"::*u8;
        @length = 7;
        ret true;
    }
    ret false;
}

# a method whose request carries content, so its length is always stated
fun carries_content(value: method.Kind) bool {
    ret value == method.POST || value == method.PUT || value == method.PATCH;
}

fun named(item: *field.Field, name: str, length: usize) bool {
    ret field.name_equal(item.name, view.view(name, length));
}

# the fields framing depends on belong to the client
fun reserved(item: *field.Field) bool {
    ret named(item, field.HOST, 4) || named(item, field.CONTENT_LENGTH, 14)
        || named(item, field.TRANSFER_ENCODING, 17)
        || named(item, field.CONNECTION, 10) || named(item, field.TE, 2)
        || named(item, field.UPGRADE, 7) || named(item, field.TRAILER, 7)
        || named(item, "keep-alive", 10) || named(item, "proxy-connection", 16);
}

# every caller field is a valid name and value and none is one the client
# writes itself, so nothing a caller supplies can split or reframe the request
pub fun valid_headers(headers: *field.Field, count: usize) bool {
    if (count != 0 && headers == nil) { ret false; }
    var i: usize = 0;
    for (i < count) {
        if (!field.valid_name(headers[i].name) || !field.valid_value(headers[i].value)
            || reserved(?headers[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun supplies(headers: *field.Field, count: usize, name: str, length: usize) bool {
    var i: usize = 0;
    for (i < count) {
        if (named(?headers[i], name, length)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# writes one complete request. a caller's user-agent replaces `user_agent`.
# the connection stays open for the next request unless the peer closes it.
pub fun encode_request(kind: method.Kind, target: Target,
    headers: *field.Field, header_count: usize, body: view.View,
    user_agent: view.View, output: *u8, capacity: usize) usize {
    var name:     *u8   = nil;
    var name_len: usize = 0;
    if (!method_name(kind, ?name, ?name_len))                         { ret 0; }
    if (target.host.len == 0 || target.path.len == 0)                 { ret 0; }
    if (!valid_headers(headers, header_count))                        { ret 0; }
    if (body.len != 0 && body.data == nil)                            { ret 0; }
    if (body.len != 0 && (kind == method.GET || kind == method.HEAD)) { ret 0; }
    var out: Writer = writer(output, capacity);
    put(?out, name, name_len);
    put_str(?out, " ", 1);
    put_view(?out, target.path);
    put_str(?out, " HTTP/1.1\r\nhost: ", 17);
    put_view(?out, target.host);
    if ((target.secure && target.port != DEFAULT_HTTPS_PORT)
        || (!target.secure && target.port != DEFAULT_HTTP_PORT)) {
        put_str(?out, ":", 1);
        put_number(?out, target.port::usize);
    }
    put_str(?out, "\r\n", 2);
    if (user_agent.len != 0 && !supplies(headers, header_count, field.USER_AGENT, 10)) {
        put_str(?out, "user-agent: ", 12);
        put_view(?out, user_agent);
        put_str(?out, "\r\n", 2);
    }
    var i: usize = 0;
    for (i < header_count) {
        put_view(?out, headers[i].name);
        put_str(?out, ": ", 2);
        put_view(?out, headers[i].value);
        put_str(?out, "\r\n", 2);
        i = i + 1;
    }
    if (carries_content(kind) || body.len != 0) {
        put_str(?out, "content-length: ", 16);
        put_number(?out, body.len);
        put_str(?out, "\r\n", 2);
    }
    put_str(?out, "\r\n", 2);
    put_view(?out, body);
    if (!out.ok) { ret 0; }
    ret out.len;
}

fun head_end(data: *u8, from: usize, len: usize) usize {
    if (len < from + 4) { ret 0; }
    var i: usize = from;
    for (i + 3 < len) {
        if (data[i] == 13 && data[i + 1] == 10 && data[i + 2] == 13
            && data[i + 3] == 10) { ret i + 4; }
        i = i + 1;
    }
    ret 0;
}

fun line_end(data: *u8, at: usize, limit: usize) usize {
    var i: usize = at;
    for (i + 1 < limit) {
        if (data[i] == 13 && data[i + 1] == 10) { ret i; }
        i = i + 1;
    }
    ret limit;
}

# the status line at `at`, its code and whether the peer speaks http/1.1
fun parse_status_line(data: *u8, at: usize, len: usize, output: *status.Status,
    modern: *bool) usize {
    val finish: usize = line_end(data, at, len);
    if (finish < at + 12 || finish >= len) { ret 0; }
    var i:        usize = 0;
    val expected: str   = "HTTP/1.";
    for (i < 7) {
        if (data[at + i] != expected[i]) { ret 0; }
        i = i + 1;
    }
    if (data[at + 7] != '0' && data[at + 7] != '1') { ret 0; }
    if (data[at + 8] != ' ')                        { ret 0; }
    if (!digit(data[at + 9]) || !digit(data[at + 10])
        || !digit(data[at + 11])) { ret 0; }
    if (finish > at + 12 && data[at + 12] != ' ') { ret 0; }
    val code: usize = (data[at + 9] - '0')::usize * 100
        + (data[at + 10] - '0')::usize * 10 + (data[at + 11] - '0')::usize;
    @output = code::status.Status;
    @modern = data[at + 7] == '1';
    ret finish + 2;
}

fun trim_value(data: *u8, start: usize, finish: usize) view.View {
    var at:  usize = start;
    var end: usize = finish;
    for (at < end && (data[at] == ' ' || data[at] == 9)) { at = at + 1; }
    for (end > at && (data[end - 1] == ' ' || data[end - 1] == 9)) {
        end = end - 1;
    }
    if (end == at) { ret empty_view(); }
    ret view.view(?data[at], end - at);
}

fun parse_fields(data: *u8, at: usize, limit: usize,
    fields: *field.Fields) Parse {
    var cursor: usize = at;
    for (cursor + 1 < limit) {
        if (data[cursor] == 13 && data[cursor + 1] == 10) { ret PARSE_OK; }
        # rfc 9112 forbids obsolete line folding; a continuation line is a
        # request smuggling primitive rather than a compatibility concern
        if (data[cursor] == ' ' || data[cursor] == 9) { ret PARSE_INVALID; }
        val finish: usize = line_end(data, cursor, limit);
        if (finish >= limit) { ret PARSE_INVALID; }
        var colon: usize = cursor;
        for (colon < finish && data[colon] != ':') { colon = colon + 1; }
        if (colon >= finish || colon == cursor) { ret PARSE_INVALID; }
        var item: field.Field;
        item.name      = view.view(?data[cursor], colon - cursor);
        item.value     = trim_value(data, colon + 1, finish);
        item.sensitive = false;
        val added: field.AddStatus = field.append(fields, item);
        if (added == field.ADD_INVALID) { ret PARSE_INVALID; }
        if (added != field.ADD_OK)      { ret PARSE_LIMIT; }
        cursor = finish + 2;
    }
    ret PARSE_INVALID;
}

pub fun find_field(fields: *field.Fields, name: str, name_len: usize,
    output: *view.View) bool {
    if (fields == nil) { ret false; }
    val wanted: view.View = view.view(name, name_len);
    var i:      usize     = 0;
    for (i < fields.len) {
        if (field.name_equal(fields.items[i].name, wanted)) {
            @output = fields.items[i].value;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# whether a comma-separated field value lists `token`, ignoring case
fun lists_token(value: view.View, token: str, length: usize) bool {
    var at: usize = 0;
    for (at < value.len) {
        for (at < value.len && (value.data[at] == ' ' || value.data[at] == 9
            || value.data[at] == ',')) { at = at + 1; }
        val start: usize = at;
        for (at < value.len && value.data[at] != ',') { at = at + 1; }
        var end: usize = at;
        for (end > start && (value.data[end - 1] == ' ' || value.data[end - 1] == 9)) {
            end = end - 1;
        }
        if (field.name_equal(view.view(?value.data[start], end - start),
            view.view(token, length))) { ret true; }
    }
    ret false;
}

fun decimal(value: view.View, output: *usize) bool {
    if (value.len == 0 || value.len > 19) { ret false; }
    var total: usize = 0;
    var i:     usize = 0;
    for (i < value.len) {
        if (!digit(value.data[i])) { ret false; }
        total = total * 10 + (value.data[i] - '0')::usize;
        i     = i + 1;
    }
    @output = total;
    ret true;
}

fun hex_value(c: u8, output: *usize) bool {
    if (c >= '0' && c <= '9') {
        @output = (c - '0')::usize;
        ret true;
    }
    if (c >= 'a' && c <= 'f') {
        @output = (c - 'a')::usize + 10;
        ret true;
    }
    if (c >= 'A' && c <= 'F') {
        @output = (c - 'A')::usize + 10;
        ret true;
    }
    ret false;
}

# scans chunked framing without writing anything. a parse over an incomplete
# message must leave the buffer exactly as it was, because the client calls it
# again on every read; compaction happens only once the message is whole.
fun scan_chunked(data: *u8, at: usize, len: usize, decoded: *usize,
    finish: *usize) Parse {
    var read:  usize = at;
    var total: usize = 0;
    for (true) {
        var size:   usize = 0;
        var digits: usize = 0;
        for (read < len && data[read] != 13 && data[read] != ';') {
            var value: usize = 0;
            if (!hex_value(data[read], ?value)) { ret PARSE_INVALID; }
            if (size > 268435455)               { ret PARSE_LIMIT; }
            size   = size * 16 + value;
            digits = digits + 1;
            read   = read + 1;
        }
        if (read >= len) { ret PARSE_INCOMPLETE; }
        if (digits == 0) { ret PARSE_INVALID; }
        for (read < len && data[read] != 13) { read = read + 1; }
        if (read + 1 >= len)      { ret PARSE_INCOMPLETE; }
        if (data[read + 1] != 10) { ret PARSE_INVALID; }
        read = read + 2;
        if (size == 0)         { brk; }
        if (size > len - read) { ret PARSE_INCOMPLETE; }
        total = total + size;
        read  = read + size;
        if (read + 1 >= len)                          { ret PARSE_INCOMPLETE; }
        if (data[read] != 13 || data[read + 1] != 10) { ret PARSE_INVALID; }
        read = read + 2;
    }
    # the trailer section ends the message; its fields are not kept
    for (read + 1 < len) {
        if (data[read] == 13 && data[read + 1] == 10) {
            @decoded = total;
            @finish  = read + 2;
            ret PARSE_OK;
        }
        val end: usize = line_end(data, read, len);
        if (end >= len) { ret PARSE_INCOMPLETE; }
        read = end + 2;
    }
    ret PARSE_INCOMPLETE;
}

# compacts a message the scan already proved complete. the decoded body is
# never longer than its encoding, so compaction cannot overrun what was read.
fun compact_chunked(data: *u8, at: usize, len: usize) usize {
    var read:  usize = at;
    var write: usize = at;
    for (true) {
        var size: usize = 0;
        for (read < len && data[read] != 13 && data[read] != ';') {
            var value: usize = 0;
            hex_value(data[read], ?value);
            size = size * 16 + value;
            read = read + 1;
        }
        for (read < len && data[read] != 13) { read = read + 1; }
        read = read + 2;
        if (size == 0) { brk; }
        var i: usize = 0;
        for (i < size) {
            data[write + i] = data[read + i];
            i               = i + 1;
        }
        write = write + size;
        read  = read + size + 2;
    }
    ret write - at;
}

# rfc 9110 section 10.2.3 admits both delta-seconds and an http-date. the date
# form is resolved against the response's own Date header, so a client clock
# that is wrong cannot turn a short wait into an unbounded one.
pub fun retry_after(fields: *field.Fields) u64 {
    var value: view.View;
    if (!find_field(fields, field.RETRY_AFTER, 11, ?value)) { ret 0; }
    var seconds: usize = 0;
    if (decimal(value, ?seconds)) { ret seconds::u64; }
    var deadline: time.Time;
    if (!http_date.parse(value, ?deadline)) { ret 0; }
    var origin: view.View;
    var sent:   time.Time;
    if (!find_field(fields, field.DATE, 4, ?origin)
        || !http_date.parse(origin, ?sent)) { ret 0; }
    if (deadline.sec <= sent.sec) { ret 0; }
    ret (deadline.sec - sent.sec)::u64;
}

# parses one complete response out of `data`. `eof` reports that the peer has
# closed, which is the only framing a response without content-length or
# chunked encoding has. interim 1xx responses are stepped over, since the
# request is answered by the final one.
pub fun parse_response(data: *u8, len: usize, eof: bool, request: method.Kind,
    fields: *field.Fields, output: *Parsed) Parse {
    if (data == nil || fields == nil || output == nil) { ret PARSE_INVALID; }
    var head_at:   usize         = 0;
    var body_at:   usize         = 0;
    var code:      status.Status = 0;
    var modern:    bool          = false;
    var fields_at: usize         = 0;
    for (true) {
        body_at = head_end(data, head_at, len);
        if (body_at == 0) {
            if (len - head_at > MAX_HEAD_BYTES) { ret PARSE_LIMIT; }
            if (eof)                            { ret PARSE_INVALID; }
            ret PARSE_INCOMPLETE;
        }
        if (body_at - head_at > MAX_HEAD_BYTES) { ret PARSE_LIMIT; }
        fields_at = parse_status_line(data, head_at, body_at, ?code, ?modern);
        if (fields_at == 0)                           { ret PARSE_INVALID; }
        if (code < 100 || code >= 200 || code == 101) { brk; }
        head_at = body_at;
    }
    if (!field.reset(fields)) { ret PARSE_INVALID; }
    val parsed: Parse = parse_fields(data, fields_at, body_at, fields);
    if (parsed != PARSE_OK) { ret parsed; }
    output.status   = code;
    output.fields   = fields;
    output.body     = empty_view();
    output.consumed = body_at;
    var connection: view.View;
    val closing:    bool = find_field(fields, field.CONNECTION, 10, ?connection)
        && lists_token(connection, "close", 5);
    output.reusable = modern && !closing;
    val bodyless: bool = request == method.HEAD || code == 204 || code == 304
        || code < 200;
    if (bodyless) { ret PARSE_OK; }
    var encoding: view.View;
    if (find_field(fields, field.TRANSFER_ENCODING, 17, ?encoding)) {
        if (!view.view_eq_str(encoding, "chunked")) { ret PARSE_INVALID; }
        var decoded: usize = 0;
        var finish:  usize = 0;
        val framed:  Parse = scan_chunked(data, body_at, len, ?decoded, ?finish);
        if (framed != PARSE_OK)                                { ret framed; }
        if (compact_chunked(data, body_at, finish) != decoded) { ret PARSE_INVALID; }
        if (decoded != 0)                                      { output.body = view.view(?data[body_at], decoded); }
        output.consumed = finish;
        ret PARSE_OK;
    }
    var declared: view.View;
    if (find_field(fields, field.CONTENT_LENGTH, 14, ?declared)) {
        var length: usize = 0;
        if (!decimal(declared, ?length)) { ret PARSE_INVALID; }
        if (len - body_at < length) {
            if (eof) { ret PARSE_INVALID; }
            ret PARSE_INCOMPLETE;
        }
        if (length != 0) { output.body = view.view(?data[body_at], length); }
        output.consumed = body_at + length;
        ret PARSE_OK;
    }
    # a body delimited by the close leaves nothing to reuse
    output.reusable = false;
    if (!eof) { ret PARSE_INCOMPLETE; }
    if (len > body_at) {
        output.body = view.view(?data[body_at], len - body_at);
    }
    output.consumed = len;
    ret PARSE_OK;
}

#[testing]
fun test_fields(items: *field.Field, capacity: usize) field.Fields {
    ret field.init(items, capacity, field.limits(64, 8192, 128, 4096));
}

#[testing]
fun load(data: *u8, value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) {
        data[i] = value[i];
        i       = i + 1;
    }
    ret i;
}

test split_url__host_port_and_path {
    var target: Target;
    if (!split_url(view.view("https://acme.example/dir", 24), ?target)) { ret 1; }
    if (!view.view_eq_str(target.host, "acme.example") || target.port != 443
        || !target.secure || !view.view_eq_str(target.path, "/dir")) { ret 2; }
    if (!split_url(view.view("http://127.0.0.1:14001/dir", 26), ?target)) { ret 3; }
    if (!view.view_eq_str(target.host, "127.0.0.1") || target.port != 14001
        || target.secure || !view.view_eq_str(target.path, "/dir")) { ret 4; }
    if (!split_url(view.view("https://acme.example", 20), ?target)) { ret 5; }
    if (!view.view_eq_str(target.path, "/"))                        { ret 6; }
    ret 0;
}

test split_url__refuses_userinfo_scheme_and_port {
    var target: Target;
    if (split_url(view.view("https://user@acme.example/dir", 29), ?target))  { ret 1; }
    if (split_url(view.view("ftp://acme.example/dir", 22), ?target))         { ret 2; }
    if (split_url(view.view("https://acme.example:0/dir", 26), ?target))     { ret 3; }
    if (split_url(view.view("https://acme.example:99999/dir", 30), ?target)) { ret 4; }
    ret 0;
}

test encode_request__headers_and_post_framing {
    var target: Target;
    if (!split_url(view.view("http://127.0.0.1:14001/order", 28), ?target)) { ret 1; }
    var headers: [2]field.Field;
    headers[0] = field.Field{name: view.view("content-type", 12),
        value: view.view("application/jose+json", 21), sensitive: false};
    headers[1] = field.Field{name: view.view("authorization", 13),
        value: view.view("Bearer t", 8), sensitive: true};
    var output:  [512]u8;
    val written: usize = encode_request(method.POST, target, ?headers[0], 2,
        view.view("{\"a\":1}", 7), view.view("hedge", 5), ?output[0], 512);
    if (written == 0) { ret 2; }
    if (!view.view_eq_str(view.view(?output[0], written),
        "POST /order HTTP/1.1\r\nhost: 127.0.0.1:14001\r\nuser-agent: hedge\r\ncontent-type: application/jose+json\r\nauthorization: Bearer t\r\ncontent-length: 7\r\n\r\n{\"a\":1}")) {
        ret 3;
    }
    # a caller's user-agent replaces the client's
    headers[0] = field.Field{name: view.view("User-Agent", 10),
        value: view.view("site/1", 6), sensitive: false};
    val plain: usize = encode_request(method.GET, target, ?headers[0], 1,
        view.view(nil, 0), view.view("hedge", 5), ?output[0], 512);
    if (!view.view_eq_str(view.view(?output[0], plain),
        "GET /order HTTP/1.1\r\nhost: 127.0.0.1:14001\r\nUser-Agent: site/1\r\n\r\n")) {
        ret 4;
    }
    ret 0;
}

test encode_request__refuses_framing_and_injected_fields {
    var target: Target;
    if (!split_url(view.view("https://api.example/x", 21), ?target)) { ret 1; }
    var output: [256]u8;
    var header: [1]field.Field;
    header[0] = field.Field{name: view.view("Content-Length", 14),
        value: view.view("1", 1), sensitive: false};
    if (encode_request(method.POST, target, ?header[0], 1, view.view("ab", 2),
        view.view(nil, 0), ?output[0], 256) != 0) { ret 2; }
    header[0] = field.Field{name: view.view("x-a", 3),
        value: view.view("1\r\nhost: evil", 13), sensitive: false};
    if (encode_request(method.GET, target, ?header[0], 1, view.view(nil, 0),
        view.view(nil, 0), ?output[0], 256) != 0) { ret 3; }
    # a get carries no content
    if (encode_request(method.GET, target, nil, 0, view.view("ab", 2),
        view.view(nil, 0), ?output[0], 256) != 0) { ret 4; }
    # and a request that does not fit is refused, never truncated
    if (encode_request(method.GET, target, nil, 0, view.view(nil, 0),
        view.view(nil, 0), ?output[0], 16) != 0) { ret 5; }
    ret 0;
}

test parse_response__content_length_incomplete {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [128]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhello");
    var response: Parsed;
    if (parse_response(?data[0], 20, false, method.GET, ?fields, ?response)
        != PARSE_INCOMPLETE) { ret 1; }
    if (parse_response(?data[0], len - 2, false, method.GET, ?fields, ?response)
        != PARSE_INCOMPLETE) { ret 2; }
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_OK) { ret 3; }
    if (response.status != 200 || !view.view_eq_str(response.body, "hello")
        || response.consumed != len || !response.reusable) { ret 4; }
    ret 0;
}

test parse_response__truncated_body_at_eof {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [128]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhel");
    var response: Parsed;
    if (parse_response(?data[0], len, true, method.GET, ?fields, ?response)
        != PARSE_INVALID) { ret 1; }
    ret 0;
}

test parse_response__head_ignores_framing {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [128]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\n");
    var response: Parsed;
    if (parse_response(?data[0], len, false, method.HEAD, ?fields, ?response)
        != PARSE_OK) { ret 1; }
    if (response.body.len != 0 || response.consumed != len) { ret 2; }
    ret 0;
}

test parse_response__chunked_in_place {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [160]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n5\r\nhello\r\n3;x=y\r\n123\r\n0\r\nx-trailer: 1\r\n\r\n");
    var response: Parsed;
    if (parse_response(?data[0], len - 8, false, method.GET, ?fields, ?response)
        != PARSE_INCOMPLETE) { ret 1; }
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_OK) { ret 2; }
    if (!view.view_eq_str(response.body, "hello123")) { ret 3; }
    # the message ends at the encoded end, not at the decoded one
    if (response.consumed != len || !response.reusable) { ret 4; }
    ret 0;
}

test parse_response__reuse_follows_framing_and_version {
    var items:    [16]field.Field;
    var fields:   field.Fields = test_fields(?items[0], 16);
    var data:     [128]u8;
    var response: Parsed;
    var len:      usize        = load(?data[0],
        "HTTP/1.1 200 OK\r\nconnection: keep-alive, Close\r\ncontent-length: 0\r\n\r\n");
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_OK || response.reusable) { ret 1; }
    len = load(?data[0], "HTTP/1.0 200 OK\r\ncontent-length: 0\r\n\r\n");
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_OK || response.reusable) { ret 2; }
    len = load(?data[0], "HTTP/1.1 200 OK\r\n\r\nall of it");
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_INCOMPLETE) { ret 3; }
    if (parse_response(?data[0], len, true, method.GET, ?fields, ?response)
        != PARSE_OK || response.reusable
        || !view.view_eq_str(response.body, "all of it")) { ret 4; }
    ret 0;
}

test parse_response__interim_response_stepped_over {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [160]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 103 Early Hints\r\nlink: </a>\r\n\r\nHTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nok");
    var response: Parsed;
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_OK) { ret 1; }
    if (response.status != 200 || !view.view_eq_str(response.body, "ok")
        || fields.len != 1) { ret 2; }
    ret 0;
}

test parse_response__obs_fold_rejected {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [128]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 200 OK\r\nx: a\r\n b\r\ncontent-length: 0\r\n\r\n");
    var response: Parsed;
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_INVALID) { ret 1; }
    ret 0;
}

test parse_response__retry_after_seconds_and_date {
    var items:  [16]field.Field;
    var fields: field.Fields = test_fields(?items[0], 16);
    var data:   [256]u8;
    val len:    usize        = load(?data[0],
        "HTTP/1.1 503 Busy\r\nretry-after: 12\r\ncontent-length: 0\r\n\r\n");
    var response: Parsed;
    if (parse_response(?data[0], len, false, method.GET, ?fields, ?response)
        != PARSE_OK || retry_after(?fields) != 12) { ret 1; }
    var dated:  [256]u8;
    val second: usize = load(?dated[0],
        "HTTP/1.1 503 Busy\r\ndate: Sun, 06 Nov 1994 08:49:37 GMT\r\nretry-after: Sun, 06 Nov 1994 08:49:47 GMT\r\ncontent-length: 0\r\n\r\n");
    if (parse_response(?dated[0], second, false, method.GET, ?fields, ?response)
        != PARSE_OK || retry_after(?fields) != 10) { ret 2; }
    ret 0;
}
