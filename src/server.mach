# serving process lifecycle and listener publication

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use hedge.config.schema;
use hedge.listener;
use hedge.telemetry;
use telemetry_health: hedge.telemetry.health;

pub val STATE_NEW: u8 = listener.OWNER_NEW;
pub val STATE_STARTING: u8 = listener.OWNER_STARTING;
pub val STATE_READY: u8 = listener.OWNER_READY;
pub val STATE_DRAINING: u8 = listener.OWNER_DRAINING;
pub val STATE_STOPPED: u8 = listener.OWNER_STOPPED;

pub rec Server {
    state: u8;
    generation: u64;
    owner: listener.Owner;
    observability: *telemetry.Runtime;
}

pub fun make(server: *Server) bool {
    if (server == nil) { ret false; }
    server.state = STATE_NEW;
    server.generation = 0;
    server.owner.state = listener.OWNER_NEW;
    server.observability = nil;
    ret true;
}

pub fun attach_telemetry(server: *Server, observability: *telemetry.Runtime) bool {
    if (server == nil || observability == nil || !observability.initialized || server.state != STATE_NEW) { ret false; }
    server.observability = observability;
    ret true;
}

pub fun start(server: *Server, generation: u64, graph: *schema.Graph, diagnostics: *schema.Diagnostics) bool {
    if (server == nil || server.state != STATE_NEW) { ret false; }
    server.state = STATE_STARTING;
    if (!listener.start(?server.owner, generation, graph, diagnostics)) {
        server.state = STATE_STOPPED;
        if (server.observability != nil) { telemetry_health.fail(?server.observability.health); }
        ret false;
    }
    server.generation = generation;
    server.state = STATE_READY;
    if (server.observability != nil && !telemetry.begin_ready(server.observability)) {
        listener.stop(?server.owner);
        telemetry_health.fail(?server.observability.health);
        server.state = STATE_STOPPED;
        ret false;
    }
    ret true;
}

pub fun reload(server: *Server, generation: u64, graph: *schema.Graph, diagnostics: *schema.Diagnostics) bool {
    if (server == nil || server.state != STATE_READY) { ret false; }
    if (!listener.reload(?server.owner, generation, graph, diagnostics)) { ret false; }
    server.generation = generation;
    ret true;
}

pub fun poll(server: *Server, timeout_ms: i32) bool {
    if (server == nil || (server.state != STATE_READY && server.state != STATE_DRAINING)) { ret false; }
    val completed: bool = listener.poll(?server.owner, timeout_ms);
    if (server.owner.state == listener.OWNER_DRAINING) {
        server.state = STATE_DRAINING;
        if (server.observability != nil) { telemetry.begin_drain(server.observability); }
    }
    ret completed;
}

pub fun stop(server: *Server) bool {
    if (server == nil || (server.state != STATE_READY && server.state != STATE_DRAINING)) { ret false; }
    server.state = STATE_DRAINING;
    if (server.observability != nil) { telemetry.begin_drain(server.observability); }
    val stopped: bool = listener.stop(?server.owner);
    var flushed: bool = true;
    if (server.observability != nil) { flushed = telemetry.shutdown(server.observability); }
    server.state = STATE_STOPPED;
    ret stopped && flushed;
}

pub fun is_ready(server: *Server) bool {
    if (server == nil || server.state != STATE_READY) { ret false; }
    ret listener.snapshot(?server.owner).state == listener.OWNER_READY;
}

pub fun snapshot(server: *Server) listener.Snapshot {
    if (server == nil) {
        ret listener.Snapshot{
            state: STATE_NEW,
            generation: 0,
            listeners: 0,
            connections: 0,
            queued_connections: 0,
            pending_accepts: 0,
            reload_requested: false,
            stop_requested: false,
        };
    }
    ret listener.snapshot(?server.owner);
}

test "server: new state is not ready" {
    var server: Server;
    if (!make(?server) || is_ready(?server)) { ret 1; }
    ret 0;
}
