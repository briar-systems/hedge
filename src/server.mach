# server lifecycle contract

pub val STATE_NEW:      u8 = 1;
pub val STATE_STARTING: u8 = 2;
pub val STATE_READY:    u8 = 3;
pub val STATE_DRAINING: u8 = 4;
pub val STATE_STOPPED:  u8 = 5;

pub rec Server {
    state:      u8;
    generation: u64;
}

pub fun is_ready(s: *Server) u8 {
    if (s.state == STATE_READY) { ret 1; }
    ret 0;
}

test "server: new state is not ready" {
    var s: Server = Server{state: STATE_NEW, generation: 0};
    if (is_ready(?s) != 0) { ret 1; }
    ret 0;
}
