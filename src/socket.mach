# an accepted byte stream, over whichever transport its listener serves
#
# a socket is the stream bound to the driver that owns it, and every operation
# on it goes through the transport's `Ops`. the connection plane, TLS below it
# and the listener's teardown all speak to a socket and never to a transport,
# so TCP and local streams take one path through hedge. a new stream transport
# is a new `Ops` and a constructor beside `from_tcp` and `from_local`, and
# nothing above this module changes.
#
# a socket is moved by value until its first operation. from then on the
# driver may write through it (a close invalidates it), so it stays put.

use io_error:     std.io.error;
use io_handle:    std.io.handle;
use io_lifecycle: std.io.lifecycle;
use io_runtime:   std.io.runtime;
use std.memory;
use net_async:   std.net.async;
use local_async: std.net.async.local;
use std.net.ip;
use std.net.tcp;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

pub def SubmitBufferFun:  fun(*Socket, *cancel.Scope, *u8, usize, usize) res[io_runtime.Token, io_error.Error];
pub def SubmitControlFun: fun(*Socket, *cancel.Scope, usize) res[io_runtime.Token, io_error.Error];
pub def CloseFun:         fun(*Socket, *cancel.Scope, io_lifecycle.Mode, usize) res[io_runtime.Token, io_error.Error];
pub def ReleasedFun:      fun(*Socket) bool;
pub def AliasesFun:       fun(*Socket, *u8, usize) bool;
pub def EndpointFun:      fun(*Socket, *ip.Endpoint) bool;

# what a transport does with a stream it owns. every submission names the
# context its completion carries back, as std.net.async's do
# ---
# read:           submit a read into a buffer
# readable:       submit a wait for readability, holding no buffer
# write:          submit a write from a buffer
# shutdown_write: submit a graceful shutdown of the write side
# close:          submit a close in the given mode
# released:       whether the stream was closed through this socket
# aliases:        whether a byte range overlaps the transport's driver
# local_endpoint: the address the stream arrived on, when the transport has one
pub rec Ops {
    read:           SubmitBufferFun;
    readable:       SubmitControlFun;
    write:          SubmitBufferFun;
    shutdown_write: SubmitControlFun;
    close:          CloseFun;
    released:       ReleasedFun;
    aliases:        AliasesFun;
    local_endpoint: EndpointFun;
}

# the transport's own stream handle. only that transport's ops read it
pub uni Stream {
    tcp:   tcp.Stream;
    local: local_async.Stream;
}

pub rec Socket {
    ops:     Ops;
    driver:  ptr;
    runtime: *io_runtime.Runtime;
    stream:  Stream;
}

# a TCP stream `driver` tracks
pub fun from_tcp(driver: *net_async.Driver, stream: tcp.Stream) Socket {
    var value: Socket;
    value.ops = Ops{read: tcp_read, readable: tcp_readable, write: tcp_write,
        shutdown_write: tcp_shutdown, close: tcp_close, released: tcp_released,
        aliases:        tcp_aliases, local_endpoint: tcp_local_endpoint};
    value.driver     = (driver)::ptr;
    value.runtime    = driver.runtime;
    value.stream.tcp = stream;
    ret value;
}

# a local stream `driver` tracks
pub fun from_local(driver: *local_async.Driver, stream: local_async.Stream) Socket {
    var value: Socket;
    value.ops = Ops{read: local_read, readable: local_readable, write: local_write,
        shutdown_write: local_shutdown, close: local_close, released: local_released,
        aliases:        local_aliases, local_endpoint: no_endpoint};
    value.driver       = (driver)::ptr;
    value.runtime      = driver.runtime;
    value.stream.local = stream;
    ret value;
}

pub fun submit_read(socket: *Socket, scope: *cancel.Scope, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret socket.ops.read(socket, scope, buffer, length, context);
}

pub fun submit_readable(socket: *Socket, scope: *cancel.Scope,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret socket.ops.readable(socket, scope, context);
}

pub fun submit_write(socket: *Socket, scope: *cancel.Scope, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret socket.ops.write(socket, scope, buffer, length, context);
}

pub fun submit_shutdown_write(socket: *Socket, scope: *cancel.Scope,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret socket.ops.shutdown_write(socket, scope, context);
}

pub fun submit_close(socket: *Socket, scope: *cancel.Scope, mode: io_lifecycle.Mode,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret socket.ops.close(socket, scope, mode, context);
}

# whether a close submitted through this socket took the stream
pub fun released(socket: *Socket) bool {
    ret socket.ops.released(socket);
}

# whether a byte range overlaps the socket or the driver that owns it
pub fun aliases(socket: *Socket, data: *u8, length: usize) bool {
    if (memory.ranges_overlap((socket)::*u8, $size_of(Socket), data, length)) { ret true; }
    ret socket.ops.aliases(socket, data, length);
}

# the address the stream arrived on, false when the transport has none
pub fun local_endpoint(socket: *Socket, output: *ip.Endpoint) bool {
    ret socket.ops.local_endpoint(socket, output);
}

fun network_of(socket: *Socket) *net_async.Driver {
    ret socket.driver::*net_async.Driver;
}

fun tcp_read(socket: *Socket, scope: *cancel.Scope, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret net_async.submit_read(network_of(socket), scope, ?socket.stream.tcp, buffer, length, context);
}

fun tcp_readable(socket: *Socket, scope: *cancel.Scope,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret net_async.submit_readable(network_of(socket), scope, ?socket.stream.tcp, context);
}

fun tcp_write(socket: *Socket, scope: *cancel.Scope, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret net_async.submit_write(network_of(socket), scope, ?socket.stream.tcp, buffer, length, context);
}

fun tcp_shutdown(socket: *Socket, scope: *cancel.Scope,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret net_async.submit_shutdown_write(network_of(socket), scope, ?socket.stream.tcp, context);
}

fun tcp_close(socket: *Socket, scope: *cancel.Scope, mode: io_lifecycle.Mode,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret net_async.submit_stream_close(network_of(socket), scope, ?socket.stream.tcp, mode, context);
}

fun tcp_released(socket: *Socket) bool {
    ret !io_handle.socket_is_valid(socket.stream.tcp.handle);
}

fun tcp_aliases(socket: *Socket, data: *u8, length: usize) bool {
    ret net_async.aliases(network_of(socket), data, length);
}

# the bound address of a wildcard listener is not the address this stream
# arrived on, so the socket is asked rather than the listener
fun tcp_local_endpoint(socket: *Socket, output: *ip.Endpoint) bool {
    val local: res[ip.Endpoint, io_error.Error] = tcp.stream_local_endpoint(?socket.stream.tcp);
    if (sel local.err) { ret false; }
    @output = local.ok;
    ret true;
}

fun local_of(socket: *Socket) *local_async.Driver {
    ret socket.driver::*local_async.Driver;
}

fun local_read(socket: *Socket, scope: *cancel.Scope, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret local_async.submit_read(local_of(socket), scope, ?socket.stream.local, buffer, length, context);
}

fun local_readable(socket: *Socket, scope: *cancel.Scope,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret local_async.submit_readable(local_of(socket), scope, ?socket.stream.local, context);
}

fun local_write(socket: *Socket, scope: *cancel.Scope, buffer: *u8, length: usize,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret local_async.submit_write(local_of(socket), scope, ?socket.stream.local, buffer, length, context);
}

fun local_shutdown(socket: *Socket, scope: *cancel.Scope,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret local_async.submit_shutdown_write(local_of(socket), scope, ?socket.stream.local, context);
}

fun local_close(socket: *Socket, scope: *cancel.Scope, mode: io_lifecycle.Mode,
    context: usize) res[io_runtime.Token, io_error.Error] {
    ret local_async.submit_stream_close(local_of(socket), scope, ?socket.stream.local, mode, context);
}

# an accepted close zeroes the stream's generation, which no open stream has
fun local_released(socket: *Socket) bool {
    ret socket.stream.local.generation == 0;
}

fun local_aliases(socket: *Socket, data: *u8, length: usize) bool {
    ret local_async.aliases(local_of(socket), data, length);
}

# a local stream has no IP address to report
fun no_endpoint(socket: *Socket, output: *ip.Endpoint) bool {
    ret false;
}
