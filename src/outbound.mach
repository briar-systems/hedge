# the outbound HTTPS client: requests hedge, and the code it hosts, send out
#
# a client belongs to one thread, the one that waits on the runtime its driver
# submits on. nothing here blocks that thread: resolving, connecting, the TLS
# handshake, writing and reading are each a submission and a completion, so a
# peer that stops answering costs a bounded wait on the exchange's deadline and
# never a stalled loop. whoever owns the runtime delivers its completions with
# `operation.deliver`, and every completion wakes the client's plane so the
# exchange is stepped on the owner's next turn rather than at its deadline.
#
# a request is https unless its url says otherwise, and https is verified
# against the anchors the owner configured, typically a system bundle loaded
# with mach-tls's `tls.cert.bundle`. without anchors an https request is
# refused, never sent unverified.
#
# connections are kept per host after a response that delimits itself, and the
# next exchange to that host reuses one rather than connecting again. a kept
# connection the peer has since closed is found out by the exchange that reuses
# it, which reconnects once when its request is safe to send twice.
#
# `Loop` bundles a runtime, a driver, name resolution and a client for code
# that has a thread of its own and nothing else to drive.

use crypto.contracts;
use hedge.clock;
use hedge.listener;
use hedge.operation;
use hedge.outbound.names;
use hedge.outbound.origination;
use hedge.outbound.wire;
use hedge.wake;
use http.core.field;
use http.core.method;
use http.core.status;
use pki.cert;
use A: std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error:  std.io.error;
use io_handle: std.io.handle;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use net_async:  std.net.async;
use std.net.dns;
use std.net.ip;
use resolve_types: std.net.resolve.types;
use std.net.tcp;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use tls_error: tls.error;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

pub val MAX_CONNECTIONS: usize = 4;
pub val MAX_ROUTES:      usize = 4;
# a kept connection older than this is closed rather than reused
pub val IDLE_NS:            u64 = 30000000000;
pub val DEFAULT_TIMEOUT_NS: u64 = 30000000000;
# an exchange gets at least this long, whatever the request asked for
pub val MIN_TIMEOUT_NS: u64 = 1000000000;
pub val USER_AGENT:     str = "hedge";

# the operations one connection has in flight, one slot each. the token context
# a completion carries is its slot.
val OP_CONNECT: usize = 0;
val OP_WRITE:   usize = 1;
val OP_READ:    usize = 2;
val OP_CLOSE:   usize = 3;
val OP_COUNT:   usize = 4;

pub def Status: u8;
pub val OK:      Status = 1;
pub val PENDING: Status = 2;
pub val FAILED:  Status = 3;
pub val INVALID: Status = 4;

pub def Stage: u8;
pub val IDLE:        Stage = 0;
pub val RESOLVING:   Stage = 1;
pub val CONNECTING:  Stage = 2;
pub val WRITING:     Stage = 3;
pub val READING:     Stage = 4;
pub val COMPLETE:    Stage = 6;
pub val BROKEN:      Stage = 7;
pub val HANDSHAKING: Stage = 8;
# a request accepted while the exchange's previous connection may still write
# into its buffers
pub val QUEUED: Stage = 9;

# why an exchange failed. each is its own answer, so a caller can tell a peer
# that was too slow from one that sent too much from one it must not trust.
pub def Cause: u8;
pub val CAUSE_NONE: Cause = 0;
# the url's host did not resolve, or the url is not http or https
pub val CAUSE_ADDRESS: Cause = 1;
pub val CAUSE_CONNECT: Cause = 2;
pub val CAUSE_WRITE:   Cause = 3;
pub val CAUSE_READ:    Cause = 4;
# the response was not http/1.1 the codec accepts
pub val CAUSE_PROTOCOL: Cause = 5;
# the response was larger than the request's limit
pub val CAUSE_TOO_LARGE: Cause = 6;
# the exchange did not complete before its deadline
pub val CAUSE_TIMEOUT: Cause = 7;
# an https request on a client with no anchors to verify it against
pub val CAUSE_TRUST: Cause = 9;
# the TLS handshake failed for a reason other than the peer's certificate
pub val CAUSE_HANDSHAKE: Cause = 10;
# the peer's certificate chain did not verify against the anchors, or did not
# name the host
pub val CAUSE_UNTRUSTED: Cause = 11;
# the request is not one the client sends: a field it owns, an invalid field,
# a body on a get, or more than the request buffer holds
pub val CAUSE_REQUEST: Cause = 12;
# every connection, or every TLS session in the process, is in use
pub val CAUSE_CAPACITY: Cause = 13;

# resolution is a step, not a call, so an asynchronous resolver reports PENDING
# until its own completion arrives without changing anything above it
pub def ResolveFun: fun(ptr, view.View, u16, *ip.Endpoint) Status;

pub rec Addresses {
    ctx:     ptr;
    resolve: ResolveFun;
}

# one request. every view, and the headers, stay alive and unchanged until the
# exchange carrying it completes. the client writes host, content-length and
# connection itself, and a user-agent unless the headers carry one.
pub rec Request {
    method:       method.Kind;
    url:          view.View;
    headers:      *field.Field;
    header_count: usize;
    body:         view.View;
    timeout_ns:   u64;
    # zero is the exchange's whole response buffer
    max_response_bytes: usize;
    # whether sending the request twice is harmless, which lets an exchange
    # retry once on a fresh connection when a kept one turns out closed
    replay_safe: bool;
}

# a request with the defaults: no headers or body, the default timeout, the
# whole response buffer, and replay safety from the method
pub fun request(kind: method.Kind, url: view.View) Request {
    var value: Request;
    value.method             = kind;
    value.url                = url;
    value.headers            = nil;
    value.header_count       = 0;
    value.body               = view.view(nil, 0);
    value.timeout_ns         = DEFAULT_TIMEOUT_NS;
    value.max_response_bytes = 0;
    value.replay_safe        = method.is_idempotent(kind);
    ret value;
}

# a header whose value is `prefix` followed by `secret`, such as a bearer
# token, written into `storage`, which holds `capacity` bytes and stays alive
# until the exchange carrying it completes. this is the one place a secret is
# declassified to reach the wire, and the field is marked sensitive. the
# caller clears `storage` once the exchange is finished
pub fun secret_header(output: *field.Field, name: view.View, prefix: view.View,
    secret: contracts.SecretBytes, storage: *u8, capacity: usize) bool {
    if (output == nil || storage == nil || (prefix.len > 0 && prefix.data == nil)
        || (secret.len > 0 && secret.data == nil) || prefix.len > capacity
        || secret.len > capacity - prefix.len) { ret false; }
    var i: usize = 0;
    for (i < prefix.len) {
        storage[i] = prefix.data[i];
        i          = i + 1;
    }
    i = 0;
    for (i < secret.len) {
        storage[prefix.len + i] = secret.data[i]:>u8;
        i                       = i + 1;
    }
    @output = field.Field{name: name, value: view.view(storage, prefix.len + secret.len),
        sensitive: true};
    ret true;
}

# a complete response. it points into the exchange's buffers and is valid until
# the exchange is finished.
pub rec Response {
    status: status.Status;
    fields: *field.Fields;
    body:   view.View;
}

# where one host is actually reached.
#
# a route sends every request for a host to a fixed endpoint. a secure route
# still verifies the certificate against the name in the url, not the endpoint,
# so pointing a name at one of its addresses weakens nothing. a cleartext route
# reaches an https url over plain http, for a front end that terminates TLS in
# front of the peer. that is always a deployment decision, never a silent
# downgrade.
pub rec Origin {
    endpoint:   ip.Endpoint;
    cleartext:  bool;
    configured: bool;
}

pub fun no_origin() Origin {
    var value: Origin;
    value.endpoint   = ip.endpoint(0, 0, 0, 0, 0);
    value.cleartext  = false;
    value.configured = false;
    ret value;
}

pub fun cleartext_origin(endpoint: ip.Endpoint) Origin {
    var value: Origin;
    value.endpoint   = endpoint;
    value.cleartext  = true;
    value.configured = true;
    ret value;
}

pub fun secure_origin(endpoint: ip.Endpoint) Origin {
    var value: Origin;
    value.endpoint   = endpoint;
    value.cleartext  = false;
    value.configured = true;
    ret value;
}

rec Route {
    host:     [wire.MAX_HOST_BYTES]u8;
    host_len: usize;
    origin:   Origin;
}

def ConnectionState: u8;
val FREE:    ConnectionState = 0;
val BUSY:    ConnectionState = 1;
val KEPT:    ConnectionState = 2;
val CLOSING: ConnectionState = 3;

rec Connection {
    client: *Client;
    state:  ConnectionState;
    # the pool key: the url's host and port and whether it is https
    host:     [wire.MAX_HOST_BYTES]u8;
    host_len: usize;
    port:     u16;
    https:    bool;
    # TLS is on the wire, which a cleartext route turns off for an https url
    secured:     bool;
    stream:      tcp.Stream;
    stream_live: bool;
    tls:         origination.Handle;
    operations:  [OP_COUNT]operation.Operation;
    contexts:    [OP_COUNT]listener.ConnectionContext;
    outstanding: [OP_COUNT]bool;
    scope:       cancel.Scope;
    scope_live:  bool;
    # the exchange using it, or the one whose buffers a closing connection may
    # still write into
    exchange: *Exchange;
    kept_at:  time.Instant;
    # exchanges completed on it
    served: usize;
}

pub rec Client {
    driver:      *net_async.Driver;
    plane:       wake.Waker;
    addresses:   Addresses;
    trust:       *cert.TrustStore;
    user_agent:  view.View;
    routes:      [MAX_ROUTES]Route;
    route_count: usize;
    connections: [MAX_CONNECTIONS]Connection;
    attached:    bool;
    live:        bool;
}

pub rec Exchange {
    client:     *Client;
    connection: *Connection;

    request:          *u8;
    request_capacity: usize;
    request_len:      usize;
    request_sent:     usize;

    response:          *u8;
    response_capacity: usize;
    response_len:      usize;

    items:         *field.Field;
    item_capacity: usize;
    fields:        field.Fields;
    field_limits:  field.Limits;

    queued:   Request;
    target:   wire.Target;
    endpoint: ip.Endpoint;
    parsed:   wire.Parsed;

    stage:    Stage;
    cause:    Cause;
    deadline: time.Instant;
    max_body: usize;
    # the exchange gave up and waits for its cancelled operation to settle
    expiring: bool;
    eof:      bool;
    # it already reconnected once after a kept connection failed it
    retried: bool;
    # a closing connection may still write into its buffers
    releasing: bool;
    live:      bool;
}

fun empty_view() view.View {
    var value: view.View;
    value.data = nil;
    value.len  = 0;
    ret value;
}

fun resolve_literal(context: ptr, host: view.View, port: u16,
    output: *ip.Endpoint) Status {
    if (output == nil || host.len == 0 || host.len > 63) { ret FAILED; }
    var text: [64]u8;
    var i:    usize = 0;
    for (i < host.len) {
        text[i] = host.data[i];
        i       = i + 1;
    }
    text[host.len] = 0;
    val parsed: res[ip.Addr, ip.ParseError] = ip.addr_parse((?text[0])::str);
    if (sel parsed.err) { ret FAILED; }
    val address: ip.Addr = parsed.ok;
    if (address.is_v6 != 0) {
        @output = ip.endpoint_v6(address.v6, port, 0);
        ret OK;
    }
    @output = ip.endpoint_v4(address.v4, port);
    ret OK;
}

# a client that reaches only address literals and routed hosts. every other
# name is refused rather than silently reaching something else.
pub fun literal_addresses() Addresses {
    ret Addresses{ctx: nil, resolve: resolve_literal};
}

fun resolve_named(context: ptr, host: view.View, port: u16,
    output: *ip.Endpoint) Status {
    val answered: names.Status = names.resolve_host(context::*names.Names, host,
        port, output);
    if (answered == names.OK)      { ret OK; }
    if (answered == names.PENDING) { ret PENDING; }
    ret FAILED;
}

# names resolved by the system through `table`, which answers on the client's
# runtime and never blocks its thread
pub fun system_addresses(table: *names.Names) Addresses {
    ret Addresses{ctx: (table)::ptr, resolve: resolve_named};
}

# resolves one name to one endpoint, blocking the calling thread.
#
# this belongs to the moment something is configured, never to a turn of a
# loop. hedge's certificate manager reaches one authority every few weeks and
# resolves it once, at startup, rather than keep a resolver thread for it. a
# name whose address moves is picked up at the next restart.
pub fun resolve_now(host: view.View, port: u16, output: *ip.Endpoint) bool {
    if (output == nil || host.data == nil || host.len == 0
        || host.len > wire.MAX_HOST_BYTES) { ret false; }
    if (resolve_literal(nil, host, port, output) == OK) { ret true; }
    var text: [256]u8;
    var i:    usize = 0;
    for (i < host.len) {
        text[i] = host.data[i];
        i       = i + 1;
    }
    text[host.len] = 0;
    var v4:       ip.IPv4;
    val resolved: res[bool, resolve_types.Error] = dns.resolve((?text[0])::str, ?v4);
    if (sel resolved.err) { ret false; }
    if (!resolved.ok)     { ret false; }
    @output = ip.endpoint_v4(v4, port);
    ret true;
}

fun renew_scope(connection: *Connection) bool {
    if (connection.scope_live) {
        cancel.destroy(?connection.scope);
        connection.scope_live = false;
    }
    if (!operation_ok(cancel.make_root(?connection.scope, opt[time.Instant].none{}))) {
        ret false;
    }
    connection.scope_live = true;
    ret true;
}

fun reset_connection(connection: *Connection) {
    connection.state       = FREE;
    connection.host_len    = 0;
    connection.port        = 0;
    connection.https       = false;
    connection.secured     = false;
    connection.stream      = tcp.Stream{handle: io_handle.invalid_socket()};
    connection.stream_live = false;
    connection.tls         = origination.no_handle();
    connection.exchange    = nil;
    connection.served      = 0;
    var i: usize = 0;
    for (i < OP_COUNT) {
        connection.outstanding[i] = false;
        i                         = i + 1;
    }
}

# the client stays where it is made: every connection's completions are bound
# to its address. `addresses` answers the names no route covers.
pub fun make(client: *Client, addresses: Addresses) bool {
    if (client == nil || addresses.resolve::usize == 0) { ret false; }
    client.live        = false;
    client.attached    = false;
    client.driver      = nil;
    client.plane       = wake.no_waker();
    client.addresses   = addresses;
    client.trust       = nil;
    client.user_agent  = view.view(USER_AGENT, 5);
    client.route_count = 0;
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        val connection: *Connection = ?client.connections[i];
        connection.client     = client;
        connection.scope_live = false;
        reset_connection(connection);
        var slot: usize = 0;
        for (slot < OP_COUNT) {
            if (!operation.bind_operation(?connection.operations[slot],
                ?connection.contexts[slot], (connection)::ptr, settle, slot)) {
                ret false;
            }
            slot = slot + 1;
        }
        i = i + 1;
    }
    client.live = true;
    ret true;
}

# the driver every operation is submitted on and the plane every completion
# wakes. a client made before its thread's driver exists is attached once it
# does, and reaches nothing in between.
pub fun attach(client: *Client, driver: *net_async.Driver, plane: wake.Waker) bool {
    if (client == nil || !client.live || driver == nil || client.attached) { ret false; }
    client.driver   = driver;
    client.plane    = plane;
    client.attached = true;
    ret true;
}

pub fun attached(client: *Client) bool {
    ret client != nil && client.live && client.attached;
}

# the anchors every https peer is verified against. they stay alive and
# unchanged while the client can reach a peer.
pub fun set_trust(client: *Client, trust: *cert.TrustStore) bool {
    if (client == nil || !client.live)  { ret false; }
    if (trust != nil && trust.len == 0) { ret false; }
    client.trust = trust;
    ret true;
}

pub fun trusts(client: *Client) usize {
    if (client == nil || client.trust == nil) { ret 0; }
    ret client.trust.len;
}

# the user-agent the client sends when a request carries none. the bytes stay
# alive while the client does.
pub fun set_user_agent(client: *Client, value: view.View) bool {
    if (client == nil || !client.live || !field.valid_value(value)) { ret false; }
    client.user_agent = value;
    ret true;
}

fun same_name(stored: *u8, stored_len: usize, host: view.View) bool {
    if (stored_len != host.len) { ret false; }
    var i: usize = 0;
    for (i < host.len) {
        var a: u8 = stored[i];
        var b: u8 = host.data[i];
        if (a >= 'A' && a <= 'Z') { a = a + 32; }
        if (b >= 'A' && b <= 'Z') { b = b + 32; }
        if (a != b)               { ret false; }
        i = i + 1;
    }
    ret true;
}

# sends every request for `host` to `origin`, replacing any earlier route
pub fun route(client: *Client, host: view.View, origin: Origin) bool {
    if (client == nil || !client.live || !origin.configured || host.data == nil
        || host.len == 0 || host.len > wire.MAX_HOST_BYTES) { ret false; }
    var index: usize = 0;
    for (index < client.route_count
        && !same_name(?client.routes[index].host[0],
        client.routes[index].host_len, host)) { index = index + 1; }
    if (index == client.route_count) {
        if (client.route_count == MAX_ROUTES) { ret false; }
        client.route_count = client.route_count + 1;
    }
    var i: usize = 0;
    for (i < host.len) {
        client.routes[index].host[i] = host.data[i];
        i                            = i + 1;
    }
    client.routes[index].host_len = host.len;
    client.routes[index].origin   = origin;
    ret true;
}

fun route_for(client: *Client, host: view.View) *Route {
    var i: usize = 0;
    for (i < client.route_count) {
        if (same_name(?client.routes[i].host[0], client.routes[i].host_len, host)) {
            ret ?client.routes[i];
        }
        i = i + 1;
    }
    ret nil;
}

# storage stays caller owned for the life of the exchange
pub fun make_exchange(exchange: *Exchange, request: *u8, request_capacity: usize,
    response: *u8, response_capacity: usize, items: *field.Field,
    item_capacity: usize, limits: field.Limits) bool {
    if (exchange == nil || request == nil || response == nil || items == nil
        || request_capacity == 0 || response_capacity == 0 || item_capacity == 0) {
        ret false;
    }
    exchange.client            = nil;
    exchange.connection        = nil;
    exchange.request           = request;
    exchange.request_capacity  = request_capacity;
    exchange.response          = response;
    exchange.response_capacity = response_capacity;
    exchange.items             = items;
    exchange.item_capacity     = item_capacity;
    exchange.field_limits      = limits;
    exchange.fields            = field.init(items, item_capacity, limits);
    exchange.stage             = IDLE;
    exchange.releasing         = false;
    exchange.deadline          = time.Instant{sec: 0, nsec: 0};
    clear_exchange(exchange);
    exchange.live = true;
    ret true;
}

fun clear_exchange(exchange: *Exchange) {
    exchange.request_len     = 0;
    exchange.request_sent    = 0;
    exchange.response_len    = 0;
    exchange.expiring        = false;
    exchange.eof             = false;
    exchange.retried         = false;
    exchange.cause           = CAUSE_NONE;
    exchange.max_body        = exchange.response_capacity;
    exchange.parsed.status   = 0;
    exchange.parsed.fields   = nil;
    exchange.parsed.body     = empty_view();
    exchange.parsed.consumed = 0;
    exchange.parsed.reusable = false;
}

fun fail(exchange: *Exchange, cause: Cause) Status {
    exchange.cause    = cause;
    exchange.stage    = BROKEN;
    exchange.expiring = false;
    ret FAILED;
}

fun deadline_from(now: time.Instant, timeout_ns: u64) time.Instant {
    if (timeout_ns < MIN_TIMEOUT_NS) { ret clock.after(now, MIN_TIMEOUT_NS); }
    ret clock.after(now, timeout_ns);
}

fun expired(exchange: *Exchange, now: time.Instant) bool {
    ret time.instant_before(exchange.deadline, now);
}

fun in_flight(exchange: *Exchange) bool {
    ret exchange.stage != IDLE && exchange.stage != COMPLETE
        && exchange.stage != BROKEN;
}

fun transferring(connection: *Connection) bool {
    ret connection.outstanding[OP_CONNECT] || connection.outstanding[OP_WRITE]
        || connection.outstanding[OP_READ];
}

fun tls_operating(connection: *Connection) bool {
    ret connection.secured && origination.operating(connection.tls);
}

# the deadline of the request in flight, when one is. an exchange that has
# already given up waits on a completion, not on the clock.
pub fun deadline(exchange: *Exchange, at: *time.Instant) bool {
    if (exchange == nil || !exchange.live || !in_flight(exchange)
        || exchange.expiring) { ret false; }
    @at = exchange.deadline;
    ret true;
}

# nothing in flight and nothing of it left to release
pub fun idle(exchange: *Exchange) bool {
    ret exchange != nil && exchange.live && exchange.stage == IDLE
        && !exchange.releasing;
}

pub fun releasing(exchange: *Exchange) bool {
    ret exchange != nil && exchange.live && exchange.releasing;
}

# begins one request on `client`. a request that arrives while the exchange's
# previous connection may still write into its buffers is held, and started
# once that has settled.
pub fun begin(exchange: *Exchange, client: *Client, request: Request,
    now: time.Instant) Status {
    if (exchange == nil || !exchange.live || !attached(client)) { ret INVALID; }
    if (exchange.stage != IDLE)                                 { ret INVALID; }
    exchange.client   = client;
    exchange.queued   = request;
    exchange.deadline = deadline_from(now, request.timeout_ns);
    if (exchange.releasing) {
        exchange.stage = QUEUED;
        ret PENDING;
    }
    val started: Status = start_exchange(exchange);
    if (started != PENDING) { ret started; }
    ret advance_resolving(exchange, now);
}

fun start_exchange(exchange: *Exchange) Status {
    val request: Request = exchange.queued;
    val client:  *Client = exchange.client;
    clear_exchange(exchange);
    if (!wire.split_url(request.url, ?exchange.target)) {
        ret fail(exchange, CAUSE_ADDRESS);
    }
    # an https peer is reached over tls, and only against anchors the owner
    # configured. without them it is refused rather than reached unverified
    val route: *Route = route_for(client, exchange.target.host);
    if (exchange.target.secure && client.trust == nil
        && (route == nil || !route.origin.cleartext)) {
        ret fail(exchange, CAUSE_TRUST);
    }
    val written: usize = wire.encode_request(request.method, exchange.target,
        request.headers, request.header_count, request.body, client.user_agent,
        exchange.request, exchange.request_capacity);
    if (written == 0) { ret fail(exchange, CAUSE_REQUEST); }
    exchange.request_len = written;
    exchange.max_body    = request.max_response_bytes;
    if (exchange.max_body == 0 || exchange.max_body > exchange.response_capacity) {
        exchange.max_body = exchange.response_capacity;
    }
    exchange.stage = RESOLVING;
    ret PENDING;
}

fun kept_for(client: *Client, target: wire.Target) *Connection {
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        val connection: *Connection = ?client.connections[i];
        if (connection.state == KEPT && connection.port == target.port
            && connection.https == target.secure
            && same_name(?connection.host[0], connection.host_len, target.host)) {
            ret connection;
        }
        i = i + 1;
    }
    ret nil;
}

fun free_connection(client: *Client) *Connection {
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        if (client.connections[i].state == FREE) { ret ?client.connections[i]; }
        i = i + 1;
    }
    ret nil;
}

# the kept connection unused longest, to make room for another host
fun oldest_kept(client: *Client) *Connection {
    var chosen: *Connection = nil;
    var i:      usize       = 0;
    for (i < MAX_CONNECTIONS) {
        val connection: *Connection = ?client.connections[i];
        if (connection.state == KEPT && (chosen == nil
            || time.instant_before(connection.kept_at, chosen.kept_at))) {
            chosen = connection;
        }
        i = i + 1;
    }
    ret chosen;
}

fun context_of(connection: *Connection, slot: usize) usize {
    ret (?connection.contexts[slot])::usize;
}

# the exchange's first submissions: a kept connection to the host is written
# to at once, and otherwise an address that resolves at once connects here, so
# the exchange is on the wire before begin returns
fun advance_resolving(exchange: *Exchange, now: time.Instant) Status {
    val client: *Client = exchange.client;
    for {
        val kept: *Connection = kept_for(client, exchange.target);
        if (kept == nil) { brk; }
        if (clock.between_ns(kept.kept_at, now) < IDLE_NS) {
            kept.state          = BUSY;
            kept.exchange       = exchange;
            exchange.connection = kept;
            if (!submit_write(exchange)) { ret fail(exchange, CAUSE_WRITE); }
            exchange.stage = WRITING;
            ret PENDING;
        }
        close_connection(kept);
    }
    var target_https: bool   = exchange.target.secure;
    var resolved:     Status = OK;
    val route:        *Route = route_for(client, exchange.target.host);
    if (route != nil) {
        exchange.endpoint = route.origin.endpoint;
        if (route.origin.cleartext) { target_https = false; }
    }
    or {
        resolved = client.addresses.resolve(client.addresses.ctx,
            exchange.target.host, exchange.target.port, ?exchange.endpoint);
    }
    if (resolved == PENDING) {
        if (expired(exchange, now)) { ret fail(exchange, CAUSE_TIMEOUT); }
        ret PENDING;
    }
    if (resolved != OK) { ret fail(exchange, CAUSE_ADDRESS); }
    var connection: *Connection = free_connection(client);
    if (connection == nil) {
        # a kept connection to another host gives way, and its slot is free
        # once its close lands
        val evicted: *Connection = oldest_kept(client);
        if (evicted == nil) { ret fail(exchange, CAUSE_CAPACITY); }
        close_connection(evicted);
        connection = free_connection(client);
        if (connection == nil) {
            if (expired(exchange, now)) { ret fail(exchange, CAUSE_TIMEOUT); }
            ret PENDING;
        }
    }
    if (!renew_scope(connection)) { ret fail(exchange, CAUSE_CONNECT); }
    var i: usize = 0;
    for (i < exchange.target.host.len) {
        connection.host[i] = exchange.target.host.data[i];
        i                  = i + 1;
    }
    connection.host_len = exchange.target.host.len;
    connection.port     = exchange.target.port;
    connection.https    = exchange.target.secure;
    connection.secured  = target_https;
    connection.served   = 0;
    connection.state    = BUSY;
    connection.exchange = exchange;
    exchange.connection = connection;
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_connect(
        client.driver, ?connection.scope, exchange.endpoint,
        context_of(connection, OP_CONNECT));
    if (sel submitted.err) { ret fail(exchange, CAUSE_CONNECT); }
    connection.outstanding[OP_CONNECT] = true;
    exchange.stage                     = CONNECTING;
    ret PENDING;
}

fun submit_read(exchange: *Exchange) bool {
    val connection: *Connection = exchange.connection;
    if (exchange.expiring || connection == nil) { ret false; }
    val room: usize = exchange.max_body - exchange.response_len;
    if (room == 0) { ret false; }
    if (connection.secured) {
        ret origination.start_read(connection.tls,
            ?exchange.response[exchange.response_len], room)
            == origination.PENDING;
    }
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_read(
        exchange.client.driver, ?connection.scope, ?connection.stream,
        ?exchange.response[exchange.response_len], room,
        context_of(connection, OP_READ));
    if (sel submitted.err) { ret false; }
    connection.outstanding[OP_READ] = true;
    ret true;
}

fun submit_write(exchange: *Exchange) bool {
    val connection: *Connection = exchange.connection;
    if (exchange.expiring || connection == nil) { ret false; }
    val remaining: usize = exchange.request_len - exchange.request_sent;
    if (connection.secured) {
        ret origination.start_write(connection.tls,
            ?exchange.request[exchange.request_sent], remaining)
            == origination.PENDING;
    }
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_write(
        exchange.client.driver, ?connection.scope, ?connection.stream,
        ?exchange.request[exchange.request_sent], remaining,
        context_of(connection, OP_WRITE));
    if (sel submitted.err) { ret false; }
    connection.outstanding[OP_WRITE] = true;
    ret true;
}

fun parse_available(exchange: *Exchange) Status {
    exchange.fields = field.init(exchange.items, exchange.item_capacity,
        exchange.field_limits);
    val parsed: wire.Parse = wire.parse_response(exchange.response,
        exchange.response_len, exchange.eof, exchange.queued.method,
        ?exchange.fields, ?exchange.parsed);
    if (parsed == wire.PARSE_OK)         { ret OK; }
    if (parsed == wire.PARSE_INCOMPLETE) { ret PENDING; }
    if (parsed == wire.PARSE_LIMIT)      { ret fail(exchange, CAUSE_TOO_LARGE); }
    ret fail(exchange, CAUSE_PROTOCOL);
}

# a peer that ended the exchange by closing, or that sent less than a whole
# response before its limit
fun short(exchange: *Exchange) Status {
    if (exchange.eof) { ret fail(exchange, CAUSE_PROTOCOL); }
    ret fail(exchange, CAUSE_TOO_LARGE);
}

fun handshake_cause(failure: tls_error.Error) Cause {
    if (failure == tls_error.BAD_CERTIFICATE || failure == tls_error.UNKNOWN_CA
        || failure == tls_error.CERTIFICATE_EXPIRED
        || failure == tls_error.HOSTNAME_MISMATCH
        || failure == tls_error.UNSUPPORTED_ALGORITHM) { ret CAUSE_UNTRUSTED; }
    if (failure == tls_error.RESOURCE_LIMIT) { ret CAUSE_CAPACITY; }
    ret CAUSE_HANDSHAKE;
}

fun handle_connect(exchange: *Exchange, completion: io_runtime.Completion) {
    val connection: *Connection = exchange.connection;
    if (completion.has_error) {
        # an expiring exchange cancelled this itself: the expiry settles it
        if (!exchange.expiring) { fail(exchange, CAUSE_CONNECT); }
        ret;
    }
    if (exchange.expiring) { ret; }
    if (connection.secured) {
        # the certificate is verified for the name the url gives, whatever
        # address a route sent us to
        val begun: origination.Status = origination.begin(?connection.tls,
            exchange.client.driver, ?connection.stream, exchange.target.host,
            exchange.client.trust, (connection)::ptr, secured);
        if (begun != origination.PENDING) {
            if (origination.live() == origination.capacity()) {
                fail(exchange, CAUSE_CAPACITY);
                ret;
            }
            fail(exchange, CAUSE_HANDSHAKE);
            ret;
        }
        exchange.stage = HANDSHAKING;
        ret;
    }
    if (!submit_write(exchange)) {
        fail(exchange, CAUSE_WRITE);
        ret;
    }
    exchange.stage = WRITING;
}

# advances a secured exchange whenever its outstanding tls operation settles.
# mach-tls keeps on a cancelled operation the bytes that settled before the
# cancel, and reports them through `transferred`, so a secured exchange
# accounts them before it weighs the terminal error, the same order the
# cleartext handlers use. a handshake carries no application bytes, so it fails
# on any error.
fun settle_secure(exchange: *Exchange) Status {
    val connection: *Connection        = exchange.connection;
    val progress:   origination.Status = origination.poll(connection.tls);
    if (progress == origination.PENDING) { ret PENDING; }
    if (exchange.stage == HANDSHAKING) {
        if (progress != origination.OK) {
            ret fail(exchange, handshake_cause(origination.failure(connection.tls)));
        }
        if (!submit_write(exchange)) { ret fail(exchange, CAUSE_WRITE); }
        exchange.stage = WRITING;
        ret PENDING;
    }
    if (exchange.stage == WRITING) {
        val written: usize = origination.transferred(connection.tls);
        exchange.request_sent = exchange.request_sent + written;
        if (exchange.request_sent < exchange.request_len) {
            # more of the request is still unsent, so an error ends the exchange
            if (progress != origination.OK || written == 0) {
                ret fail(exchange, CAUSE_WRITE);
            }
            if (!submit_write(exchange)) { ret fail(exchange, CAUSE_WRITE); }
            ret PENDING;
        }
        if (!submit_read(exchange)) { ret fail(exchange, CAUSE_READ); }
        exchange.stage = READING;
        ret PENDING;
    }
    if (exchange.stage != READING) { ret PENDING; }
    val received: usize = origination.transferred(connection.tls);
    exchange.response_len = exchange.response_len + received;
    if (received == 0 || origination.peer_closed(connection.tls)) {
        exchange.eof = true;
    }
    val parsed: Status = parse_available(exchange);
    if (parsed == OK) {
        exchange.stage = COMPLETE;
        ret OK;
    }
    if (parsed != PENDING)          { ret parsed; }
    if (progress != origination.OK) { ret fail(exchange, CAUSE_READ); }
    if (exchange.eof || exchange.response_len >= exchange.max_body) {
        ret short(exchange);
    }
    if (!submit_read(exchange)) { ret fail(exchange, CAUSE_READ); }
    ret PENDING;
}

# std reports on a cancelled completion the bytes that left before the cancel
# took effect, so what was sent is accounted before the error is weighed: a
# request fully written and then cancelled counts as sent.
fun handle_write(exchange: *Exchange, completion: io_runtime.Completion) {
    exchange.request_sent = exchange.request_sent + completion.bytes;
    if (exchange.request_sent < exchange.request_len) {
        # more of the request is still unsent, so an error ends the exchange
        if (completion.has_error || completion.bytes == 0) {
            if (!exchange.expiring) { fail(exchange, CAUSE_WRITE); }
            ret;
        }
        if (!submit_write(exchange)) { fail(exchange, CAUSE_WRITE); }
        ret;
    }
    if (!submit_read(exchange)) {
        fail(exchange, CAUSE_READ);
        ret;
    }
    exchange.stage = READING;
}

# a response that fully arrived and was then cancelled is still a response, so
# the bytes std reports on the completion are accounted and parsed before the
# error is weighed. an error completion ends the exchange only when what it
# carried is not a whole response.
fun handle_read(exchange: *Exchange, completion: io_runtime.Completion) {
    exchange.response_len = exchange.response_len + completion.bytes;
    # a cancelled read reports no bytes without the stream having ended
    if (!completion.has_error && (completion.bytes == 0 || completion.end_of_stream)) {
        exchange.eof = true;
    }
    val parsed: Status = parse_available(exchange);
    if (parsed == OK) {
        exchange.stage = COMPLETE;
        ret;
    }
    if (parsed != PENDING) { ret; }
    if (completion.has_error) {
        if (!exchange.expiring) { fail(exchange, CAUSE_READ); }
        ret;
    }
    if (exchange.eof || exchange.response_len >= exchange.max_body) {
        short(exchange);
        ret;
    }
    if (!submit_read(exchange)) { fail(exchange, CAUSE_READ); }
}

# an exchange that gave up is a timeout unless the cancelled transfer carried
# a whole response
fun settle_expiry(exchange: *Exchange) {
    if (!exchange.expiring || exchange.stage == COMPLETE) {
        exchange.expiring = false;
        ret;
    }
    val connection: *Connection = exchange.connection;
    if (connection != nil && (tls_operating(connection) || transferring(connection))) {
        ret;
    }
    fail(exchange, CAUSE_TIMEOUT);
}

fun adopt_stream(connection: *Connection, completion: io_runtime.Completion) {
    var connected: io_runtime.Completion = completion;
    connection.stream      = net_async.stream(?connected);
    connection.stream_live = true;
}

fun dispatch(exchange: *Exchange, slot: usize, completion: io_runtime.Completion) {
    val connection: *Connection = exchange.connection;
    if (slot == OP_CONNECT && !completion.has_error) {
        adopt_stream(connection, completion);
    }
    # a completion that arrives after the exchange settled releases its
    # resource and changes nothing else
    if (exchange.stage == BROKEN || exchange.stage == COMPLETE) { ret; }
    if (slot == OP_CONNECT && exchange.stage == CONNECTING) {
        handle_connect(exchange, completion);
    }
    or (slot == OP_WRITE && exchange.stage == WRITING) {
        handle_write(exchange, completion);
    }
    or (slot == OP_READ && exchange.stage == READING) {
        handle_read(exchange, completion);
    }
    settle_expiry(exchange);
}

# the exchange a closing connection held no longer shares its buffers with it
fun let_go(connection: *Connection) {
    val exchange: *Exchange = connection.exchange;
    connection.exchange = nil;
    if (exchange == nil)                   { ret; }
    if (exchange.connection == connection) { exchange.connection = nil; }
    exchange.releasing = false;
}

# the close of a connection, advanced by the completions it waits on: every
# cancelled transfer lands first, so no buffer is reused while the kernel can
# still write to it, then the tls engine is released, then the socket is closed
# under a fresh scope, and the slot is free once that lands.
fun advance_close(connection: *Connection) {
    if (connection.state != CLOSING) { ret; }
    if (transferring(connection))    { ret; }
    if (origination.active(connection.tls)) {
        if (origination.operating(connection.tls)) {
            origination.poll(connection.tls);
            if (origination.operating(connection.tls)) { ret; }
        }
        if (!origination.release(connection.tls)) { ret; }
        connection.tls = origination.no_handle();
    }
    let_go(connection);
    if (connection.outstanding[OP_CLOSE]) { ret; }
    if (connection.stream_live) {
        renew_scope(connection);
        val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_stream_close(
            connection.client.driver, ?connection.scope, ?connection.stream,
            lifecycle.ABORTIVE, context_of(connection, OP_CLOSE));
        connection.stream_live = false;
        if (sel submitted.ok) {
            connection.outstanding[OP_CLOSE] = true;
            ret;
        }
    }
    reset_connection(connection);
    wake.wake(?connection.client.plane);
}

# gives the connection up. what it has in flight is cancelled and released on
# its completions.
fun close_connection(connection: *Connection) {
    if (connection.state == FREE || connection.state == CLOSING) { ret; }
    if (tls_operating(connection))                               { origination.cancel_operation(connection.tls); }
    if (transferring(connection) && connection.scope_live) {
        transition_ok(cancel.cancel(?connection.scope));
    }
    connection.state = CLOSING;
    advance_close(connection);
}

# every completion a connection submitted lands here, routed by whoever
# delivers its runtime, and wakes the plane so the exchange is stepped on the
# next turn
fun settle(context: ptr, slot: usize, completion: io_runtime.Completion) {
    val connection: *Connection = context::*Connection;
    if (connection == nil || slot >= OP_COUNT) { ret; }
    wake.wake(?connection.client.plane);
    connection.outstanding[slot] = false;
    if (connection.state == CLOSING) {
        if (slot == OP_CONNECT && !completion.has_error) {
            adopt_stream(connection, completion);
        }
        advance_close(connection);
        ret;
    }
    if (connection.state == BUSY && connection.exchange != nil) {
        dispatch(connection.exchange, slot, completion);
    }
}

# the tls engine settled one of its operations
fun secured(context: ptr) {
    val connection: *Connection = context::*Connection;
    if (connection == nil) { ret; }
    wake.wake(?connection.client.plane);
    if (connection.state == CLOSING) {
        advance_close(connection);
        ret;
    }
    val exchange: *Exchange = connection.exchange;
    if (connection.state != BUSY || exchange == nil) { ret; }
    if (in_flight(exchange) && origination.operating(connection.tls)) {
        settle_secure(exchange);
    }
    settle_expiry(exchange);
}

# gives up on the exchange in flight. the outstanding operation is cancelled
# and the exchange settles on its completion, which may still carry a whole
# response.
fun expire(exchange: *Exchange) Status {
    val connection: *Connection = exchange.connection;
    if (connection != nil && tls_operating(connection)) {
        exchange.expiring = true;
        origination.cancel_operation(connection.tls);
        ret PENDING;
    }
    if (connection != nil && transferring(connection)) {
        exchange.expiring = true;
        transition_ok(cancel.cancel(?connection.scope));
        ret PENDING;
    }
    ret fail(exchange, CAUSE_TIMEOUT);
}

# a kept connection the peer closed while it sat unused fails the first
# exchange that reuses it before any of the response arrives. that exchange
# reconnects once, when its request is safe to send twice.
fun retry_stale(exchange: *Exchange, now: time.Instant) bool {
    val connection: *Connection = exchange.connection;
    if (connection == nil || connection.served == 0 || exchange.retried
        || !exchange.queued.replay_safe || exchange.response_len != 0
        || transferring(connection) || tls_operating(connection)) { ret false; }
    if (exchange.cause != CAUSE_WRITE && exchange.cause != CAUSE_READ
        && exchange.cause != CAUSE_PROTOCOL) { ret false; }
    if (expired(exchange, now)) { ret false; }
    close_connection(connection);
    let_go(connection);
    exchange.connection   = nil;
    exchange.request_sent = 0;
    exchange.eof          = false;
    exchange.cause        = CAUSE_NONE;
    exchange.retried      = true;
    exchange.stage        = RESOLVING;
    ret true;
}

# advances the exchange by whatever has completed. never waits.
pub fun poll(exchange: *Exchange, now: time.Instant) Status {
    if (exchange == nil || !exchange.live) { ret INVALID; }
    if (exchange.stage == IDLE)            { ret INVALID; }
    if (exchange.stage == QUEUED) {
        if (exchange.releasing) {
            if (expired(exchange, now)) { ret fail(exchange, CAUSE_TIMEOUT); }
            ret PENDING;
        }
        val started: Status = start_exchange(exchange);
        if (started != PENDING) { ret started; }
    }
    if (exchange.stage == BROKEN && retry_stale(exchange, now)) {}
    if (exchange.stage == RESOLVING) {
        val advanced: Status = advance_resolving(exchange, now);
        if (advanced != PENDING) { ret advanced; }
    }
    # a tls session parked for memory resumes on its pool's wake, which reaches
    # it through this poll rather than through a completion
    val connection: *Connection = exchange.connection;
    if (connection != nil && in_flight(exchange) && !exchange.expiring
        && tls_operating(connection)) {
        val advanced: Status = settle_secure(exchange);
        if (advanced == OK) { ret OK; }
        if (advanced == FAILED) {
            if (retry_stale(exchange, now)) { ret poll(exchange, now); }
            ret FAILED;
        }
    }
    if (exchange.stage == COMPLETE) { ret OK; }
    if (exchange.stage == BROKEN)   { ret FAILED; }
    if (exchange.expiring)          { ret PENDING; }
    if (expired(exchange, now))     { ret expire(exchange); }
    ret PENDING;
}

pub fun stage(exchange: *Exchange) Stage {
    if (exchange == nil) { ret BROKEN; }
    ret exchange.stage;
}

pub fun cause(exchange: *Exchange) Cause {
    if (exchange == nil) { ret CAUSE_PROTOCOL; }
    ret exchange.cause;
}

# the TLS alert behind a handshake or untrusted failure, while the exchange
# still holds its connection
pub fun tls_failure(exchange: *Exchange) tls_error.Error {
    if (exchange == nil || exchange.connection == nil) { ret tls_error.OK; }
    ret origination.failure(exchange.connection.tls);
}

# valid only while the exchange holds this response, until `finish`
pub fun response(exchange: *Exchange) Response {
    ret Response{status: exchange.parsed.status, fields: exchange.parsed.fields,
        body: exchange.parsed.body};
}

# ends the exchange and returns it to idle. a connection whose response
# delimited itself is kept for the next exchange to its host. any other is
# closed, and its operations are released on their completions, so an exchange
# may still be `releasing` afterwards; the next `begin` queues behind that.
pub fun finish(exchange: *Exchange) bool {
    if (exchange == nil || !exchange.live) { ret false; }
    if (exchange.stage == IDLE)            { ret true; }
    if (exchange.stage == QUEUED) {
        exchange.stage = IDLE;
        ret true;
    }
    val connection: *Connection = exchange.connection;
    val complete:   bool        = exchange.stage == COMPLETE;
    exchange.stage    = IDLE;
    exchange.expiring = false;
    if (connection == nil) { ret true; }
    val keep: bool = complete && exchange.parsed.reusable
        && exchange.parsed.consumed == exchange.response_len
        && !transferring(connection) && !tls_operating(connection)
        && connection.stream_live;
    if (keep) {
        connection.state    = KEPT;
        connection.exchange = nil;
        connection.kept_at  = clock.instant();
        connection.served   = connection.served + 1;
        exchange.connection = nil;
        ret true;
    }
    exchange.releasing = true;
    close_connection(connection);
    ret true;
}

# closes the kept connections that have gone unused past IDLE_NS, so a client
# that goes quiet gives its sockets and TLS sessions back
pub fun maintain(client: *Client, now: time.Instant) {
    if (client == nil || !client.live) { ret; }
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        val connection: *Connection = ?client.connections[i];
        if (connection.state == KEPT
            && clock.between_ns(connection.kept_at, now) >= IDLE_NS) {
            close_connection(connection);
        }
        i = i + 1;
    }
}

# closes every kept connection
pub fun close_kept(client: *Client) {
    if (client == nil || !client.live) { ret; }
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        if (client.connections[i].state == KEPT) {
            close_connection(?client.connections[i]);
        }
        i = i + 1;
    }
}

# every connection is closed and released
pub fun settled(client: *Client) bool {
    if (client == nil || !client.live) { ret true; }
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        if (client.connections[i].state != FREE) { ret false; }
        i = i + 1;
    }
    ret true;
}

# closes what is kept and releases the client once every connection has
# settled. PENDING until then: the closes land on the runtime, which the caller
# keeps delivering. an exchange still using a connection holds it open, so
# every exchange is finished first.
pub fun shutdown(client: *Client) Status {
    if (client == nil) { ret INVALID; }
    if (!client.live)  { ret OK; }
    close_kept(client);
    if (!settled(client)) { ret PENDING; }
    var i: usize = 0;
    for (i < MAX_CONNECTIONS) {
        val connection: *Connection = ?client.connections[i];
        if (connection.scope_live) {
            cancel.destroy(?connection.scope);
            connection.scope_live = false;
        }
        i = i + 1;
    }
    client.attached = false;
    client.driver   = nil;
    client.live     = false;
    ret OK;
}

# releases the exchange. a connection that may still write into its buffers
# holds it, so an exchange still releasing refuses and is destroyed once idle.
pub fun destroy_exchange(exchange: *Exchange) bool {
    if (exchange == nil || !exchange.live) { ret false; }
    if (!finish(exchange))                 { ret false; }
    if (exchange.releasing)                { ret false; }
    exchange.live = false;
    ret true;
}

# a runtime, its driver, system name resolution and one client, for a thread
# that drives nothing else. the loop stays where it is made until `close_loop`
# reports OK.
pub rec Loop {
    pages:        A.Allocator;
    runtime:      io_runtime.Runtime;
    driver:       net_async.Driver;
    wakes:        wake.Queue;
    names:        names.Names;
    client:       Client;
    runtime_live: bool;
    driver_live:  bool;
    wakes_live:   bool;
    names_live:   bool;
    live:         bool;
}

pub val LOOP_CAPACITY: usize = 64;

# opens the loop on the calling thread. `trust` verifies every https peer and
# stays alive while the loop is open.
pub fun open_loop(loop: *Loop, trust: *cert.TrustStore) bool {
    if (loop == nil) { ret false; }
    loop.live         = false;
    loop.runtime_live = false;
    loop.driver_live  = false;
    loop.wakes_live   = false;
    loop.names_live   = false;
    page.make(?loop.pages);
    val made_runtime: err[io_error.Error] = io_runtime.make(?loop.runtime,
        ?loop.pages, LOOP_CAPACITY);
    if (sel made_runtime.err) { ret false; }
    loop.runtime_live = true;
    val made_driver: err[io_error.Error] = net_async.make(?loop.driver, ?loop.runtime);
    if (sel made_driver.err) {
        release_loop(loop);
        ret false;
    }
    loop.driver_live = true;
    if (!wake.make(?loop.wakes, ?loop.pages)) {
        release_loop(loop);
        ret false;
    }
    loop.wakes_live = true;
    val plane: wake.Waker = wake.waker(?loop.wakes, wake.PLANE_OWNER);
    if (!names.make(?loop.names, ?loop.runtime, plane)) {
        release_loop(loop);
        ret false;
    }
    loop.names_live = true;
    if (!make(?loop.client, system_addresses(?loop.names))
        || !attach(?loop.client, ?loop.driver, plane)
        || !set_trust(?loop.client, trust)) {
        release_loop(loop);
        ret false;
    }
    loop.live = true;
    ret true;
}

fun release_loop(loop: *Loop) {
    if (loop.wakes_live) {
        wake.destroy(?loop.wakes);
        loop.wakes_live = false;
    }
    if (loop.driver_live) {
        net_async.destroy(?loop.driver);
        loop.driver_live = false;
    }
    if (loop.runtime_live) {
        io_runtime.destroy(?loop.runtime);
        loop.runtime_live = false;
    }
}

pub fun client(loop: *Loop) *Client {
    if (loop == nil || !loop.live) { ret nil; }
    ret ?loop.client;
}

# one turn: waits up to `timeout_ms` for completions, or -1 for the next one,
# delivers each to its owner, and closes kept connections gone stale. it
# returns whether anything woke the client, after which the caller polls its
# exchanges.
pub fun turn(loop: *Loop, timeout_ms: i32) bool {
    if (loop == nil || !loop.live) { ret false; }
    operation.pump(?loop.runtime, timeout_ms);
    var woken: bool = false;
    var wakes: [8]wake.Wake;
    for (wake.take(?loop.wakes, ?wakes[0], 8) != 0) { woken = true; }
    maintain(?loop.client, clock.instant());
    ret woken;
}

# runs one request to its end on the calling thread, which waits on the loop's
# runtime until the exchange completes or fails. for a thread of its own, never
# for a handler or a lifecycle step, which must not block.
pub fun fetch(loop: *Loop, exchange: *Exchange, value: Request) Status {
    if (loop == nil || !loop.live) { ret INVALID; }
    finish(exchange);
    var status: Status = begin(exchange, ?loop.client, value, clock.instant());
    for (status == PENDING) {
        var wait: i32 = 50;
        var at:   time.Instant;
        if (deadline(exchange, ?at)) {
            val left: u64 = clock.between_ns(clock.instant(), at) / 1000000;
            if (left < 50) { wait = left::i32 + 1; }
        }
        turn(loop, wait);
        status = poll(exchange, clock.instant());
    }
    ret status;
}

# releases the loop. PENDING while a connection or a lookup has yet to settle,
# and each call waits briefly for them, so the caller asks until OK. every
# exchange is finished first.
pub fun close_loop(loop: *Loop) Status {
    if (loop == nil) { ret INVALID; }
    if (!loop.live)  { ret OK; }
    val stopped: Status = shutdown(?loop.client);
    if (stopped == INVALID) { ret INVALID; }
    var closed: names.Status = names.OK;
    if (loop.names_live) {
        closed = names.close(?loop.names);
        if (closed == names.OK) { loop.names_live = false; }
    }
    if (stopped != OK || closed != names.OK) {
        operation.pump(?loop.runtime, 10);
        ret PENDING;
    }
    release_loop(loop);
    loop.live = false;
    ret OK;
}

#[testing]
rec Fixture {
    request:  [4096]u8;
    response: [8192]u8;
    items:    [32]field.Field;
    url:      [64]u8;
    runtime:  io_runtime.Runtime;
    driver:   net_async.Driver;
    pages:    A.Allocator;
    wakes:    wake.Queue;
    client:   Client;
    engine:   Exchange;
    turns:    usize;
    woken:    usize;
}

#[testing]
fun fixture_url(fixture: *Fixture, port: u16, path: str) view.View {
    val prefix: str   = "http://127.0.0.1:";
    var at:     usize = 0;
    for (prefix[at] != 0) {
        fixture.url[at] = prefix[at];
        at              = at + 1;
    }
    var digits: [8]u8;
    var count:  usize = 0;
    var value:  usize = port::usize;
    for (true) {
        digits[count] = ('0' + (value % 10)::u8);
        count         = count + 1;
        value         = value / 10;
        if (value == 0) { brk; }
    }
    var i: usize = 0;
    for (i < count) {
        fixture.url[at] = digits[count - 1 - i];
        at              = at + 1;
        i               = i + 1;
    }
    i = 0;
    for (path[i] != 0) {
        fixture.url[at] = path[i];
        at              = at + 1;
        i               = i + 1;
    }
    ret view.view(?fixture.url[0], at);
}

#[testing]
fun fixture_make(fixture: *Fixture) bool {
    fixture.turns = 0;
    fixture.woken = 0;
    page.make(?fixture.pages);
    val made_runtime: err[io_error.Error] = io_runtime.make(?fixture.runtime, ?fixture.pages, 8);
    if (sel made_runtime.err) { ret false; }
    val made_driver: err[io_error.Error] = net_async.make(?fixture.driver, ?fixture.runtime);
    if (sel made_driver.err) {
        io_runtime.destroy(?fixture.runtime);
        ret false;
    }
    if (!wake.make(?fixture.wakes, ?fixture.pages)) {
        net_async.destroy(?fixture.driver);
        io_runtime.destroy(?fixture.runtime);
        ret false;
    }
    if (!make(?fixture.client, literal_addresses())
        || !attach(?fixture.client, ?fixture.driver,
        wake.waker(?fixture.wakes, wake.PLANE_OWNER))) { ret false; }
    ret make_exchange(?fixture.engine, ?fixture.request[0], 4096,
        ?fixture.response[0], 8192, ?fixture.items[0], 32,
        field.limits(32, 8192, 128, 4096));
}

# one turn: wait on the runtime, dispatch each completion to its bound owner,
# and poll the exchange when it was woken
#[testing]
fun turn_fixture(fixture: *Fixture, timeout_ms: i32) Status {
    operation.pump(?fixture.runtime, timeout_ms);
    var wakes: [4]wake.Wake;
    var taken: usize = wake.take(?fixture.wakes, ?wakes[0], 4);
    for (taken != 0) {
        fixture.woken = fixture.woken + taken;
        taken         = wake.take(?fixture.wakes, ?wakes[0], 4);
    }
    fixture.turns = fixture.turns + 1;
    ret poll(?fixture.engine, clock.instant());
}

#[testing]
fun settle_client(fixture: *Fixture) bool {
    var i: usize = 0;
    for (i < 256 && (!idle(?fixture.engine) || !settled(?fixture.client))) {
        close_kept(?fixture.client);
        turn_fixture(fixture, 10);
        i = i + 1;
    }
    ret idle(?fixture.engine) && settled(?fixture.client);
}

#[testing]
fun fixture_destroy(fixture: *Fixture) bool {
    finish(?fixture.engine);
    settle_client(fixture);
    val destroyed: bool = destroy_exchange(?fixture.engine)
        && shutdown(?fixture.client) == OK;
    wake.destroy(?fixture.wakes);
    net_async.destroy(?fixture.driver);
    io_runtime.destroy(?fixture.runtime);
    ret destroyed;
}

#[testing]
fun advance(fixture: *Fixture, wanted: Stage, limit: usize) bool {
    var i: usize = 0;
    for (i < limit) {
        if (fixture.engine.stage == wanted || fixture.engine.stage == BROKEN
            || fixture.engine.stage == COMPLETE) { ret fixture.engine.stage == wanted; }
        turn_fixture(fixture, 10);
        i = i + 1;
    }
    ret false;
}

#[testing]
fun sample_request(url: view.View) Request {
    var value: Request = request(method.GET, url);
    value.timeout_ns         = 5000000000;
    value.max_response_bytes = 4096;
    ret value;
}

#[testing]
fun copy_text(target: *u8, text: str) usize {
    var length: usize = 0;
    for (text[length] != 0) {
        target[length] = text[length];
        length         = length + 1;
    }
    ret length;
}

# a local listener that answers each request it reads with `reply`
#[testing]
rec Peer {
    server:   tcp.Listener;
    endpoint: ip.Endpoint;
    stream:   tcp.Stream;
    accepted: usize;
    live:     bool;
}

#[testing]
fun peer_make(peer: *Peer) bool {
    peer.live     = false;
    peer.accepted = 0;
    val listening: res[tcp.Listener, io_error.Error] = tcp.listen(
        ip.endpoint(127, 0, 0, 1, 0), 4);
    if (sel listening.err) { ret false; }
    peer.server = listening.ok;
    val bound: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?peer.server);
    if (sel bound.err) {
        tcp.listener_close(?peer.server);
        ret false;
    }
    peer.endpoint = bound.ok;
    ret true;
}

#[testing]
fun peer_accept(peer: *Peer) bool {
    val accepted: res[tcp.Stream, io_error.Error] = tcp.accept(?peer.server);
    if (sel accepted.err) { ret false; }
    if (peer.live)        { tcp.stream_close(?peer.stream); }
    peer.stream   = accepted.ok;
    peer.live     = true;
    peer.accepted = peer.accepted + 1;
    tcp.stream_set_read_timeout(?peer.stream, 5000);
    ret true;
}

# reads one request head while turning the client, then answers it
#[testing]
fun peer_answer(peer: *Peer, fixture: *Fixture, reply: str) bool {
    var received: [1024]u8;
    var total:    usize = 0;
    var rounds:   usize = 0;
    for (rounds < 64) {
        turn_fixture(fixture, 10);
        val read: res[usize, io_error.Error] = tcp.stream_read(?peer.stream,
            ?received[total], 1024 - total);
        if (sel read.ok) { total = total + read.ok; }
        if (total >= 4 && received[total - 4] == 13 && received[total - 3] == 10
            && received[total - 2] == 13 && received[total - 1] == 10) { brk; }
        rounds = rounds + 1;
    }
    if (total < 4) { ret false; }
    var body:   [512]u8;
    val length: usize = copy_text(?body[0], reply);
    tcp.stream_write(?peer.stream, ?body[0], length);
    ret true;
}

#[testing]
fun peer_close(peer: *Peer) {
    if (peer.live) { tcp.stream_close(?peer.stream); }
    tcp.listener_close(?peer.server);
}

#[testing]
fun run_until_settled(fixture: *Fixture, limit: usize) Status {
    var status: Status = poll(?fixture.engine, clock.instant());
    var rounds: usize  = 0;
    for (status == PENDING && rounds < limit) {
        status = turn_fixture(fixture, 10);
        rounds = rounds + 1;
    }
    ret status;
}

test route__cleartext_overrides_url_authority {
    var fixture: Fixture;
    if (!fixture_make(?fixture)) { ret 1; }
    # a port nothing serves, so the exchange reaches connect and stops there
    if (!route(?fixture.client, view.view("acme.example", 12),
        cleartext_origin(ip.endpoint(127, 0, 0, 1, 1)))) { ret 2; }
    val value: Request = sample_request(
        view.view("https://acme.example:14000/dir", 30));
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING) {
        ret 3;
    }
    # the failure is at connect rather than at the address or the trust check,
    # which is what proves the route was used in place of the url's authority
    if (run_until_settled(?fixture, 512) != FAILED
        || cause(?fixture.engine) != CAUSE_CONNECT) { ret 4; }
    if (!fixture_destroy(?fixture)) { ret 5; }
    ret 0;
}

test begin__https_without_anchors_refused {
    var fixture: Fixture;
    if (!fixture_make(?fixture)) { ret 1; }
    val value: Request = sample_request(view.view("https://127.0.0.1:1/dir", 23));
    # nothing to verify against, so the exchange never leaves the process
    # rather than being reached unverified or downgraded to cleartext
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != FAILED) {
        ret 2;
    }
    if (cause(?fixture.engine) != CAUSE_TRUST)                      { ret 3; }
    if (!finish(?fixture.engine) || stage(?fixture.engine) != IDLE) { ret 4; }
    if (!settle_client(?fixture))                                   { ret 10; }

    # with anchors configured the same request is admitted and reaches the
    # address it was given
    var certificates: [1]cert.Certificate;
    certificates[0] = cert.Certificate{der: ?fixture.request[0], der_len: 1};
    var store: cert.TrustStore = cert.TrustStore{
        anchors: ?certificates[0], len: 1
    };
    if (!set_trust(?fixture.client, ?store)) { ret 5; }
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING) {
        ret 7;
    }
    if (run_until_settled(?fixture, 512) != FAILED
        || cause(?fixture.engine) != CAUSE_CONNECT) { ret 8; }
    if (!fixture_destroy(?fixture)) { ret 9; }
    ret 0;
}

test begin__refuses_names_and_requests_it_cannot_send {
    var fixture: Fixture;
    if (!fixture_make(?fixture)) { ret 1; }
    # the literal resolver refuses a name at begin, which is its own answer
    if (begin(?fixture.engine, ?fixture.client,
        sample_request(view.view("http://acme.example/dir", 23)),
        clock.instant()) != FAILED || cause(?fixture.engine) != CAUSE_ADDRESS) {
        ret 2;
    }
    finish(?fixture.engine);
    # a field the client owns is refused before anything is submitted
    var header: [1]field.Field;
    header[0] = field.Field{name: view.view("host", 4),
        value: view.view("elsewhere", 9), sensitive: false};
    var value: Request = sample_request(view.view("http://127.0.0.1:1/dir", 22));
    value.headers      = ?header[0];
    value.header_count = 1;
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != FAILED
        || cause(?fixture.engine) != CAUSE_REQUEST) { ret 3; }
    finish(?fixture.engine);
    # an exchange whose client was never attached is not begun at all
    var bare: Client;
    if (!make(?bare, literal_addresses())) { ret 4; }
    if (begin(?fixture.engine, ?bare, sample_request(view.view(
        "http://127.0.0.1:1/dir", 22)), clock.instant()) != INVALID) { ret 5; }
    if (shutdown(?bare) != OK)      { ret 6; }
    if (!fixture_destroy(?fixture)) { ret 7; }
    ret 0;
}

test exchange__completes_and_wakes_plane {
    var peer: Peer;
    if (!peer_make(?peer)) { ret 1; }
    var fixture: Fixture;
    if (!fixture_make(?fixture)) {
        peer_close(?peer);
        ret 2;
    }
    var value: Request = sample_request(fixture_url(?fixture, peer.endpoint.port, "/dir"));
    value.timeout_ns = 10000000000;
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING
        || fixture.engine.stage != CONNECTING) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 3;
    }
    # the connect is submitted by begin itself: a plane driven only by its
    # deadline and by completions would otherwise not see the exchange move
    # until the deadline
    if (!peer_accept(?peer) || !advance(?fixture, READING, 512)) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 4;
    }
    if (!peer_answer(?peer, ?fixture, "HTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nhi")) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 5;
    }
    # the response is one completion, and it is what wakes the plane and
    # completes the exchange
    val seen:   usize  = fixture.woken;
    var status: Status = poll(?fixture.engine, clock.instant());
    if (status == PENDING) { status = turn_fixture(?fixture, -1); }
    if (status != OK || fixture.woken <= seen) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 6;
    }
    val answer: Response = response(?fixture.engine);
    if (answer.status != 200 || !view.view_eq_str(answer.body, "hi")
        || answer.fields.len == 0) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 7;
    }
    peer_close(?peer);
    if (!fixture_destroy(?fixture)) { ret 8; }
    ret 0;
}

test exchange__kept_connection_reused_per_host {
    var peer: Peer;
    if (!peer_make(?peer)) { ret 1; }
    var fixture: Fixture;
    if (!fixture_make(?fixture)) {
        peer_close(?peer);
        ret 2;
    }
    val value: Request = sample_request(fixture_url(?fixture, peer.endpoint.port, "/a"));
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING
        || !peer_accept(?peer)
        || !peer_answer(?peer, ?fixture,
        "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n2\r\nhi\r\n0\r\n\r\n")
        || run_until_settled(?fixture, 256) != OK) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 3;
    }
    if (!view.view_eq_str(response(?fixture.engine).body, "hi")) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 4;
    }
    finish(?fixture.engine);
    # the chunked response delimited itself, so the connection is kept and
    # the second request to the host is written to it without a connect
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING
        || fixture.engine.stage != WRITING
        || !peer_answer(?peer, ?fixture, "HTTP/1.1 204 No Content\r\n\r\n")
        || run_until_settled(?fixture, 256) != OK
        || response(?fixture.engine).status != 204 || peer.accepted != 1) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 5;
    }
    finish(?fixture.engine);
    # the peer closes the kept connection. a get is safe to send twice, so the
    # next exchange finds that out and reconnects once
    tcp.stream_close(?peer.stream);
    peer.live = false;
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 6;
    }
    var rounds: usize = 0;
    for (rounds < 256 && fixture.engine.stage != CONNECTING) {
        turn_fixture(?fixture, 10);
        rounds = rounds + 1;
    }
    if (!peer_accept(?peer)
        || !peer_answer(?peer, ?fixture, "HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n")
        || run_until_settled(?fixture, 256) != OK || peer.accepted != 2) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 7;
    }
    peer_close(?peer);
    if (!fixture_destroy(?fixture)) { ret 8; }
    ret 0;
}

test exchange__size_limit_and_timeout_are_distinct {
    var peer: Peer;
    if (!peer_make(?peer)) { ret 1; }
    var fixture: Fixture;
    if (!fixture_make(?fixture)) {
        peer_close(?peer);
        ret 2;
    }
    var value: Request = sample_request(fixture_url(?fixture, peer.endpoint.port, "/big"));
    value.max_response_bytes = 64;
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING
        || !peer_accept(?peer)
        || !peer_answer(?peer, ?fixture,
        "HTTP/1.1 200 OK\r\ncontent-length: 100\r\n\r\n0123456789012345678901234567890123456789")
        || run_until_settled(?fixture, 256) != FAILED
        || cause(?fixture.engine) != CAUSE_TOO_LARGE) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 3;
    }
    finish(?fixture.engine);
    # a peer that accepts and never answers costs the exchange its deadline
    value            = sample_request(fixture_url(?fixture, peer.endpoint.port, "/slow"));
    value.timeout_ns = 1;
    val started: time.Instant = clock.instant();
    if (begin(?fixture.engine, ?fixture.client, value, started) != PENDING
        || !peer_accept(?peer)) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 4;
    }
    if (run_until_settled(?fixture, 1024) != FAILED
        || cause(?fixture.engine) != CAUSE_TIMEOUT
        || clock.between_ns(started, clock.instant()) < MIN_TIMEOUT_NS) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 5;
    }
    peer_close(?peer);
    if (!fixture_destroy(?fixture)) { ret 6; }
    ret 0;
}

test begin__queued_until_release_completes {
    var peer: Peer;
    if (!peer_make(?peer)) { ret 1; }
    var fixture: Fixture;
    if (!fixture_make(?fixture)) {
        peer_close(?peer);
        ret 2;
    }
    val value: Request = sample_request(fixture_url(?fixture, peer.endpoint.port, "/dir"));
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING
        || !advance(?fixture, READING, 512)) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 3;
    }
    # give up on the exchange with its read in flight and begin the next one
    # before the cancelled read and the close have landed
    if (!finish(?fixture.engine) || !releasing(?fixture.engine)) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 4;
    }
    if (begin(?fixture.engine, ?fixture.client, value, clock.instant()) != PENDING
        || stage(?fixture.engine) != QUEUED) {
        fixture_destroy(?fixture);
        peer_close(?peer);
        ret 5;
    }
    # the queued request leaves QUEUED only once the release is over, and the
    # release does not need a poll: its completions carry it
    var rounds: usize = 0;
    for (rounds < 256 && stage(?fixture.engine) == QUEUED) {
        turn_fixture(?fixture, 10);
        rounds = rounds + 1;
    }
    peer_close(?peer);
    if (stage(?fixture.engine) == QUEUED || releasing(?fixture.engine)) {
        fixture_destroy(?fixture);
        ret 6;
    }
    if (!fixture_destroy(?fixture)) { ret 7; }
    ret 0;
}

#[testing]
fun reading(fixture: *Fixture, connection: *Connection) {
    fixture.engine.stage      = READING;
    fixture.engine.client     = ?fixture.client;
    fixture.engine.connection = connection;
    fixture.engine.queued     = request(method.GET, view.view("http://x/", 9));
    connection.state          = BUSY;
    connection.exchange       = ?fixture.engine;
}

test handle_read__cancelled_with_whole_response {
    var fixture: Fixture;
    if (!fixture_make(?fixture)) { ret 1; }
    # std delivers on a cancelled completion the bytes that landed before the
    # cancel took effect. a whole response carried by an error completion must
    # still parse rather than be discarded as a failed read.
    val length: usize = copy_text(?fixture.response[0],
        "HTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nhi");
    reading(?fixture, ?fixture.client.connections[0]);
    var completion: io_runtime.Completion;
    completion.bytes     = length;
    completion.has_error = true;
    handle_read(?fixture.engine, completion);
    if (fixture.engine.stage != COMPLETE
        || !view.view_eq_str(response(?fixture.engine).body, "hi")) {
        fixture_destroy(?fixture);
        ret 2;
    }
    if (!fixture_destroy(?fixture)) { ret 3; }
    ret 0;
}

test settle__expired_short_read_is_timeout {
    var fixture: Fixture;
    if (!fixture_make(?fixture)) { ret 1; }
    # the exchange gave up with a read in flight. a cancelled completion with a
    # short transfer settles it as a timeout, the read error notwithstanding.
    val connection: *Connection = ?fixture.client.connections[0];
    reading(?fixture, connection);
    fixture.engine.expiring         = true;
    connection.outstanding[OP_READ] = true;
    var completion: io_runtime.Completion;
    completion.bytes     = 0;
    completion.has_error = true;
    settle((connection)::ptr, OP_READ, completion);
    if (fixture.engine.stage != BROKEN || fixture.engine.cause != CAUSE_TIMEOUT
        || fixture.engine.expiring || !wake.pending(?fixture.wakes)) {
        fixture_destroy(?fixture);
        ret 2;
    }
    if (!fixture_destroy(?fixture)) { ret 3; }
    ret 0;
}

test handle_write__cancelled_full_write_counts_sent {
    var fixture: Fixture;
    if (!fixture_make(?fixture)) { ret 1; }
    # a request fully written and then cancelled has been sent: the bytes are
    # accounted before the error is weighed, so it is not mistaken for a short
    # write that must be reissued.
    reading(?fixture, ?fixture.client.connections[0]);
    fixture.engine.stage        = WRITING;
    fixture.engine.request_len  = 32;
    fixture.engine.request_sent = 0;
    var completion: io_runtime.Completion;
    completion.bytes     = 32;
    completion.has_error = true;
    handle_write(?fixture.engine, completion);
    if (fixture.engine.request_sent != 32
        || (fixture.engine.stage == BROKEN && fixture.engine.cause == CAUSE_WRITE)) {
        fixture_destroy(?fixture);
        ret 2;
    }
    if (!fixture_destroy(?fixture)) { ret 3; }
    ret 0;
}
