# the hedge server executable
#
# the process reads one configuration document, seals a generation from it,
# compiles an immutable plan, and serves until the operating system asks it to
# stop. every failure before readiness exits without ever accepting a connection.

use std.runtime;
use std.print;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.option;
use std.allocator;
use std.allocator.page;
use std.allocator.fixed;
use std.filesystem;
use std.process.env;
use hedge.hedge;
use hedge.config.schema;
use hedge.config.loader;
use hedge.generation;
use hedge.service;
use static_files: hedge.service.static;
use proxy: hedge.service.proxy;
use http_cache: hedge.cache;
use cache_store: hedge.cache.store;
use upstream: hedge.proxy.upstream;
use engine_h1: http.h1.connection;
use std.chrono.time;
use std.types.view;
use acme: hedge.acme.manager;
use handler: hedge.acme.handler;
use tlsalpn: hedge.acme.tlsalpn;
use hedge_tls: hedge.protocol.tls;
use lifecycle: hedge.lifecycle;
use hedge.listener;
use hedge.serve;
use hedge.connection;
use plan: hedge.dispatch.plan;
use middleware: hedge.dispatch.middleware;
use router: http.router.router;

val EXIT_OK: i64 = 0;
val EXIT_CONFIG: i64 = 78;
val EXIT_RUNTIME: i64 = 70;
# the drain deadline passed with exchanges still running, so the process did not
# shut down cleanly even though it shut down
val EXIT_DRAIN_INCOMPLETE: i64 = 75;

val MAX_ROUTES: usize = 64;
val MAX_SEGMENTS: usize = 512;
val MAX_SERVICES: usize = 32;
val MAX_MIDDLEWARE: usize = 16;
val MAX_STATIC_ROOTS: usize = 16;
val CACHE_ENTRIES: usize = 128;
val PLAN_TEXT_BYTES: usize = 16384;
val CONFIG_ARENA_BYTES: usize = 1048576;
val DEFAULT_CONNECTIONS: usize = 64;

rec PlanStorage {
    routes: [MAX_ROUTES]router.CompiledRoute;
    segments: [MAX_SEGMENTS]router.Segment;
    specs: [MAX_ROUTES]router.Route;
    entries: [MAX_ROUTES]plan.Entry;
    services: [MAX_SERVICES]service.Descriptor;
    middleware: [MAX_MIDDLEWARE]middleware.Middleware;
    text: [PLAN_TEXT_BYTES]u8;
}

fun report_diagnostics(diagnostics: *schema.Diagnostics) {
    var i: usize = 0;
    for (i < diagnostics.count) {
        val item: *schema.Diagnostic = ?diagnostics.items[i];
        print.eprint("hedge: ");
        print.eprint(schema.text(?item.source));
        print.eprint(": ");
        print.eprint(schema.text(?item.path));
        print.eprint(": ");
        print.eprintln(schema.text(?item.message));
        i = i + 1;
    }
    if (diagnostics.truncated) { print.eprintln("hedge: diagnostics were truncated"); }
}

fun report_count(value: usize) {
    var digits: [24]u8;
    var count: usize = 0;
    var remaining: usize = value;
    if (remaining == 0) { digits[0] = '0'; count = 1; }
    for (remaining != 0) {
        digits[count] = '0' + (remaining % 10)::u8;
        remaining = remaining / 10;
        count = count + 1;
    }
    var text: [25]u8;
    var i: usize = 0;
    for (i < count) {
        text[i] = digits[count - 1 - i];
        i = i + 1;
    }
    text[count] = 0;
    print.eprintln((?text[0])::str);
}

# QUIC is refused rather than advertised: hedge composes no QUIC connection
# driver, so a datagram listener would bind and then serve nothing
fun capabilities() loader.Capabilities {
    ret loader.Capabilities{
        quic: false,
        local_transport: true,
        environment_secrets: true,
        file_secrets: true,
        os_secrets: true,
        application_secrets: false,
    };
}

fun resolve_environment(context: ptr, name: str, output: *u8, capacity: usize) i64 {
    ret env.get(name, output, capacity);
}

# the serving loop drives one plane, and hedge has two things that need
# driving. composition belongs here, where both are already owned.
rec Planes {
    proxying:     *proxy.Runtime;
    certificates: *acme.Manager;
}

fun drive_planes(context: ptr, now: time.Time) bool {
    val planes: *Planes = context::*Planes;
    if (planes == nil) { ret false; }
    var advanced: bool = true;
    if (planes.proxying != nil) {
        advanced = proxy.poll((planes.proxying)::ptr, now) && advanced;
    }
    if (planes.certificates != nil) {
        advanced = acme.poll((planes.certificates)::ptr, now) && advanced;
    }
    advanced = hedge_tls.maintain() && advanced;
    ret advanced;
}

fun announce_certificate(certificates: *acme.Manager) {
    val first: view.View = acme.name(certificates, 0);
    var rendered: [256]u8;
    var i: usize = 0;
    for (i < first.len && i < 255) {
        rendered[i] = first.data[i];
        i = i + 1;
    }
    rendered[i] = 0;
    print.printlnf("hedge: certificate ready for {} until {}",
        (?rendered[0])::str, acme.not_after(certificates)::u64);
}

fun configuration_path(argc: i64, argv: **u8) str {
    if (argc > 1 && argv[1] != nil) { ret argv[1]::str; }
    ret "hedge.toml";
}

rec Reloader {
    heap: *allocator.Allocator;
    path: str;
    resolver: *loader.Resolver;
    diagnostics: *schema.Diagnostics;
    generations: *generation.Generation;
    storages: *PlanStorage;
    allocators: *allocator.Allocator;
    states: *fixed.FixedState;
    plans: *plan.Plan;
    runtime: *serve.Runtime;
    slot: usize;
    next_id: u64;
}

fun reload(state: *Reloader) bool {
    # only one superseded generation may exist at a time: the spare slot is
    # still holding the last one until its connections finish
    if (serve.superseded(state.runtime) != 0) { ret false; }
    val target: usize = 1 - state.slot;
    val loaded: Result[str, str] = filesystem.read_string(state.heap, state.path);
    if (is_err[str, str](loaded)) {
        print.eprintln("hedge: reload cannot read the configuration");
        ret false;
    }
    val source: str = unwrap_ok[str, str](loaded);
    val active: *generation.Generation = ?state.generations[state.slot];
    val candidate: *generation.Generation = ?state.generations[target];
    fixed.reset(?state.states[target]);
    schema.reset_diagnostics(state.diagnostics);
    if (!generation.make_candidate(candidate, state.next_id)) { ret false; }
    if (!loader.build(?candidate.graph, state.diagnostics, ?state.allocators[target],
        state.path, source, state.resolver, capabilities())) {
        report_diagnostics(state.diagnostics);
        print.eprintln("hedge: reload rejected, configuration is not valid");
        ret false;
    }
    if (!plan.reload_compatible(?active.graph, ?candidate.graph)) {
        print.eprintln("hedge: reload rejected, startup-owned state changed; restart to apply it");
        ret false;
    }
    if (!generation.seal(candidate, state.diagnostics, nil,
        (0::usize)::generation.ConstructFun)) {
        report_diagnostics(state.diagnostics);
        print.eprintln("hedge: reload rejected, generation did not seal");
        ret false;
    }
    val storage: *PlanStorage = ?state.storages[target];
    var layout: plan.Storage;
    if (!plan.make_storage(?layout,
        ?storage.routes[0], MAX_ROUTES,
        ?storage.segments[0], MAX_SEGMENTS,
        ?storage.specs[0], MAX_ROUTES,
        ?storage.entries[0], MAX_ROUTES,
        ?storage.services[0], MAX_SERVICES,
        ?storage.middleware[0], MAX_MIDDLEWARE,
        ?storage.text[0], PLAN_TEXT_BYTES)) { ret false; }
    val built: plan.Report = plan.recompile(?state.plans[target], candidate.id,
        ?candidate.graph, layout, ?state.plans[state.slot], ?active.graph, nil);
    if (built.status != plan.PLAN_OK) {
        print.eprint("hedge: reload rejected, route plan failed: ");
        print.eprintln(built.detail);
        ret false;
    }
    if (!serve.reload(state.runtime, candidate.id, ?state.plans[target],
        ?candidate.graph, state.diagnostics)) {
        report_diagnostics(state.diagnostics);
        print.eprintln("hedge: reload rejected, listeners did not republish");
        ret false;
    }
    state.slot = target;
    state.next_id = state.next_id + 1;
    print.eprintln("hedge: reloaded");
    ret true;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var heap: allocator.Allocator;
    if (option.is_some[*u8](page.make(?heap))) {
        print.eprintln("hedge: page allocator initialization failed");
        ret EXIT_RUNTIME;
    }
    val path: str = configuration_path(argc, argv);
    val loaded: Result[str, str] = filesystem.read_string(?heap, path);
    if (is_err[str, str](loaded)) {
        print.eprint("hedge: cannot read configuration ");
        print.eprintln(path);
        ret EXIT_CONFIG;
    }
    val source: str = unwrap_ok[str, str](loaded);

    # two of each, alternating. a reload builds into the slot the active
    # generation is not using, so connections still holding the previous plan
    # keep a graph and a route table nothing is writing to.
    val arena: Result[*u8, *u8] = allocator.allocate[u8](?heap, CONFIG_ARENA_BYTES * 2);
    val generations: Result[*generation.Generation, *u8] = allocator.allocate[generation.Generation](?heap, 2);
    val diagnostics_storage: Result[*schema.Diagnostics, *u8] = allocator.allocate[schema.Diagnostics](?heap, 1);
    val plan_storage: Result[*PlanStorage, *u8] = allocator.allocate[PlanStorage](?heap, 2);
    if (is_err[*u8, *u8](arena) || is_err[*generation.Generation, *u8](generations)
     || is_err[*schema.Diagnostics, *u8](diagnostics_storage)
     || is_err[*PlanStorage, *u8](plan_storage)) {
        print.eprintln("hedge: startup allocation failed");
        ret EXIT_RUNTIME;
    }
    val arena_base: *u8 = unwrap_ok[*u8, *u8](arena);
    val generation_base: *generation.Generation =
        unwrap_ok[*generation.Generation, *u8](generations);
    val storage_base: *PlanStorage = unwrap_ok[*PlanStorage, *u8](plan_storage);
    var config_allocators: [2]allocator.Allocator;
    var config_states: [2]fixed.FixedState;
    fixed.make(?config_allocators[0], ?config_states[0], arena_base, CONFIG_ARENA_BYTES);
    fixed.make(?config_allocators[1], ?config_states[1], ?arena_base[CONFIG_ARENA_BYTES],
        CONFIG_ARENA_BYTES);
    var slot: usize = 0;
    var config_allocator: allocator.Allocator = config_allocators[0];
    val candidate: *generation.Generation = ?generation_base[0];
    val diagnostics: *schema.Diagnostics = unwrap_ok[*schema.Diagnostics, *u8](diagnostics_storage);
    val storage: *PlanStorage = ?storage_base[0];

    var resolver: loader.Resolver = loader.Resolver{
        context: nil,
        include: (0::usize)::loader.ResolveFun,
        environment: resolve_environment,
    };
    schema.reset_diagnostics(diagnostics);
    if (!generation.make_candidate(candidate, 1)) {
        print.eprintln("hedge: candidate generation initialization failed");
        ret EXIT_RUNTIME;
    }
    if (!loader.build(?candidate.graph, diagnostics, ?config_allocator, path, source,
        ?resolver, capabilities())) {
        report_diagnostics(diagnostics);
        print.eprintln("hedge: configuration is not valid");
        ret EXIT_CONFIG;
    }
    if (!generation.seal(candidate, diagnostics, nil, (0::usize)::generation.ConstructFun)) {
        report_diagnostics(diagnostics);
        print.eprintln("hedge: generation did not seal");
        ret EXIT_CONFIG;
    }
    report_diagnostics(diagnostics);

    # applications are registered by this executable, so hedge core links no framework
    var application_slots: [service.MAX_APPLICATIONS]service.Application;
    var applications: service.Applications;
    service.make_applications(?applications, ?application_slots[0], service.MAX_APPLICATIONS);
    var static_sites: [MAX_STATIC_ROOTS]static_files.Site;
    var static_registry: static_files.Registry;
    static_files.make_registry(?static_registry, ?static_sites[0], MAX_STATIC_ROOTS,
        static_files.default_options());
    val proxy_runtime: Result[*proxy.Runtime, *u8] = allocator.allocate[proxy.Runtime](?heap, 1);
    if (is_err[*proxy.Runtime, *u8](proxy_runtime)) {
        print.eprintln("hedge: proxy runtime allocation failed");
        ret EXIT_RUNTIME;
    }
    val proxying: *proxy.Runtime = unwrap_ok[*proxy.Runtime, *u8](proxy_runtime);
    proxy.make_runtime(proxying, nil, "hedge", engine_h1.config_default(),
        upstream.default_limits());
    var proxy_bindings_storage: [MAX_SERVICES]proxy.Binding;
    var proxy_bindings: proxy.Bindings;
    proxy.make_bindings(?proxy_bindings, ?proxy_bindings_storage[0], MAX_SERVICES,
        proxying);
    # the cache is constructed only when configuration asks for it; with caching
    # off nothing below is allocated, opened, or wrapped
    var caching: *http_cache.Layer = nil;
    var cache_bindings: http_cache.Bindings;
    var cache_binding_storage: [MAX_SERVICES]http_cache.Binding;
    if (candidate.graph.cache.enabled) {
        val layer_memory: Result[*http_cache.Layer, *u8] =
            allocator.allocate[http_cache.Layer](?heap, 1);
        val entry_memory: Result[*cache_store.Entry, *u8] =
            allocator.allocate[cache_store.Entry](?heap, CACHE_ENTRIES);
        val body_memory: Result[*u8, *u8] =
            allocator.allocate[u8](?heap, candidate.graph.cache.memory_bytes);
        if (is_err[*http_cache.Layer, *u8](layer_memory)
         || is_err[*cache_store.Entry, *u8](entry_memory)
         || is_err[*u8, *u8](body_memory)) {
            print.eprintln("hedge: cache allocation failed");
            ret EXIT_RUNTIME;
        }
        caching = unwrap_ok[*http_cache.Layer, *u8](layer_memory);
        if (!http_cache.from_config(caching, ?candidate.graph.cache,
            unwrap_ok[*cache_store.Entry, *u8](entry_memory), CACHE_ENTRIES,
            unwrap_ok[*u8, *u8](body_memory), candidate.graph.cache.memory_bytes,
            ?heap)) {
            print.eprintln("hedge: cache could not be constructed");
            ret EXIT_CONFIG;
        }
    }
    # certificate management is constructed only when configuration asks for
    # it: with acme off nothing below is allocated, no state directory is
    # opened, and the plane has no acme step to take
    var certificates: *acme.Manager = nil;
    var challenge_binding: handler.Binding;
    var alpn_challenge: tlsalpn.Alpn;
    var alpn_challenge_live: bool = false;
    if (candidate.graph.acme.enabled) {
        val manager_memory: Result[*acme.Manager, *u8] =
            allocator.allocate[acme.Manager](?heap, 1);
        if (is_err[*acme.Manager, *u8](manager_memory)) {
            print.eprintln("hedge: certificate manager allocation failed");
            ret EXIT_RUNTIME;
        }
        certificates = unwrap_ok[*acme.Manager, *u8](manager_memory);
        var opened: acme.Status = acme.INVALID;
        if (candidate.graph.acme.challenge == schema.CHALLENGE_TLS_ALPN_01) {
            if (!tlsalpn.make(?alpn_challenge)) {
                print.eprintln("hedge: TLS-ALPN challenge state could not initialize");
                ret EXIT_RUNTIME;
            }
            opened = acme.open_with_tls_alpn(certificates, ?heap,
                ?candidate.graph, tlsalpn.provider(?alpn_challenge));
            alpn_challenge_live = opened == acme.OK;
        } or {
            opened = acme.open(certificates, ?heap, ?candidate.graph);
        }
        if (opened != acme.OK) {
            if (candidate.graph.acme.challenge == schema.CHALLENGE_TLS_ALPN_01) {
                tlsalpn.destroy(?alpn_challenge);
            }
            print.eprintln("hedge: certificate manager could not open its state");
            ret EXIT_CONFIG;
        }
        if (!handler.bind(?challenge_binding, acme.challenge_table(certificates))) {
            print.eprintln("hedge: challenge route could not be bound");
            ret EXIT_RUNTIME;
        }
    }
    http_cache.make_bindings(?cache_bindings, ?cache_binding_storage[0], MAX_SERVICES, caching);
    var services: service.Resolver = service.no_resolver();
    services.applications = ?applications;
    # only a process that built a cache installs the wrapper, so with caching off
    # the plan never calls it and `cache_bindings` is never read. Installing it
    # unconditionally made the disabled path depend on an initialisation it does
    # not need, and that dependency spanned two statements with nothing in either
    # recording that the other mattered.
    if (caching != nil) {
        services.caching = service.Wrapper{
            ctx: (?cache_bindings)::ptr,
            wrap: http_cache.wrapper,
        };
    }
    services.static_files = service.Factory{
        ctx: (?static_registry)::ptr,
        build: static_files.factory,
    };
    services.proxy = service.Factory{
        ctx: (?proxy_bindings)::ptr,
        build: proxy.factory,
    };
    if (certificates != nil) {
        services.native = handler.factory(?challenge_binding);
    }

    var compiled_storage: plan.Storage;
    if (!plan.make_storage(?compiled_storage,
        ?storage.routes[0], MAX_ROUTES,
        ?storage.segments[0], MAX_SEGMENTS,
        ?storage.specs[0], MAX_ROUTES,
        ?storage.entries[0], MAX_ROUTES,
        ?storage.services[0], MAX_SERVICES,
        ?storage.middleware[0], MAX_MIDDLEWARE,
        ?storage.text[0], PLAN_TEXT_BYTES)) {
        print.eprintln("hedge: plan storage layout is invalid");
        ret EXIT_RUNTIME;
    }
    var compiled: [2]plan.Plan;
    val built: plan.Report = plan.compile(?compiled[0], candidate.id, ?candidate.graph,
        compiled_storage, ?services, nil);
    if (built.status != plan.PLAN_OK) {
        print.eprint("hedge: route plan failed: ");
        print.eprintln(built.detail);
        ret EXIT_CONFIG;
    }

    # every secure listener publishes its own credential generation before any
    # listener binds, so a certificate that cannot be loaded stops the process
    # rather than being discovered at the first handshake
    hedge_tls.reset();
    var listener_index: usize = 0;
    for (listener_index < candidate.graph.listener_count) {
        val configured: *schema.Listener = ?candidate.graph.listeners[listener_index];
        listener_index = listener_index + 1;
        if (configured.tls_policy.len == 0) { cnt; }
        val policy: *schema.TlsPolicy = schema.find_tls_policy(?candidate.graph,
            schema.text(?configured.tls_policy));
        if (policy == nil) {
            print.eprintln("hedge: listener references an unknown TLS policy");
            ret EXIT_CONFIG;
        }
        var tls_options: hedge_tls.PublishOptions = hedge_tls.publish_options();
        tls_options.tls_alpn_challenge = candidate.graph.acme.enabled &&
            candidate.graph.acme.challenge == schema.CHALLENGE_TLS_ALPN_01 &&
            schema.text_equals(?configured.name,
                schema.text(?candidate.graph.acme.listener));
        val published: hedge_tls.Status = hedge_tls.publish_with_options(
            schema.text(?configured.name), policy, configured.protocols,
            tls_options);
        if (published != hedge_tls.OK) {
            print.eprint("hedge: TLS policy could not be published for listener ");
            print.eprintln(schema.text(?configured.name));
            ret EXIT_CONFIG;
        }
    }
    var certificate_policy: usize = hedge_tls.NO_POLICY;
    if (certificates != nil) {
        certificate_policy = hedge_tls.find(schema.text(?candidate.graph.acme.listener));
        if (certificate_policy == hedge_tls.NO_POLICY) {
            print.eprintln("hedge: ACME listener has no published TLS policy");
            ret EXIT_CONFIG;
        }
        if (alpn_challenge_live && !tlsalpn.bind_listener(?alpn_challenge,
                certificate_policy)) {
            print.eprintln("hedge: TLS-ALPN challenge could not bind its listener");
            ret EXIT_CONFIG;
        }
        if (acme.certificate_ready(certificates)) {
            if (hedge_tls.install_acme(certificate_policy, certificates)
                != hedge_tls.OK) {
                print.eprintln("hedge: stored ACME certificate could not be installed");
                ret EXIT_CONFIG;
            }
            announce_certificate(certificates);
        }
    }

    var pool_size: usize = candidate.graph.limits.max_connections;
    if (pool_size > DEFAULT_CONNECTIONS) { pool_size = DEFAULT_CONNECTIONS; }
    if (pool_size == 0) { pool_size = 1; }
    val slots: Result[*serve.Slot, *u8] = allocator.allocate[serve.Slot](?heap, pool_size);
    val connections: Result[*connection.Connection, *u8] = allocator.allocate[connection.Connection](?heap, pool_size);
    if (is_err[*serve.Slot, *u8](slots) || is_err[*connection.Connection, *u8](connections)) {
        print.eprintln("hedge: connection pool allocation failed");
        ret EXIT_RUNTIME;
    }
    var runtime: serve.Runtime;
    if (!serve.make(?runtime, unwrap_ok[*serve.Slot, *u8](slots),
        unwrap_ok[*connection.Connection, *u8](connections), pool_size, ?compiled[0],
        ?candidate.graph)) {
        print.eprintln("hedge: serving runtime initialization failed");
        ret EXIT_RUNTIME;
    }
    schema.reset_diagnostics(diagnostics);
    if (!serve.start(?runtime, candidate.id, ?candidate.graph, diagnostics)) {
        report_diagnostics(diagnostics);
        print.eprintln("hedge: listeners did not become ready");
        ret EXIT_RUNTIME;
    }
    proxy.attach_driver(proxying, ?runtime.owner.network);
    var planes: Planes;
    planes.proxying = proxying;
    planes.certificates = certificates;
    serve.attach_plane(?runtime, (?planes)::ptr, drive_planes);
    if (certificates != nil) {
        acme.attach_telemetry(certificates, runtime.observability);
    }
    announce(?runtime, ?candidate.graph);
    # the shutdown sequence runs inside `poll`, deadline included, so a handler
    # that never finishes ends the process rather than holding it open. `poll`
    # stops short of releasing the resources it is polling on, so the loop ends
    # when everything but that is done and `stop` performs the close.
    var reloader: Reloader;
    reloader.heap = ?heap;
    reloader.path = path;
    reloader.resolver = ?resolver;
    reloader.diagnostics = diagnostics;
    reloader.generations = generation_base;
    reloader.storages = storage_base;
    reloader.allocators = ?config_allocators[0];
    reloader.states = ?config_states[0];
    reloader.plans = ?compiled[0];
    reloader.runtime = ?runtime;
    reloader.slot = 0;
    reloader.next_id = candidate.id + 1;
    for (true) {
        serve.poll(?runtime, serve.DEFAULT_POLL_MS);
        # a reload request is taken once the previous generation has finished
        # draining, so the spare slot is free to build into
        if (runtime.owner.reload_requested && serve.superseded(?runtime) == 0) {
            listener.clear_reload_request(?runtime.owner);
            reload(?reloader);
        }
        if (certificates != nil && acme.installation_ready(certificates)) {
            val installed: hedge_tls.Status = hedge_tls.install_acme(
                certificate_policy, certificates);
            if (installed == hedge_tls.OK) {
                announce_certificate(certificates);
                acme.installed(certificates, time.now());
            } or (installed != hedge_tls.RETIRED_IN_USE) {
                print.eprintln("hedge: renewed ACME certificate could not be installed");
            }
        }
        if (serve.drained(?runtime)) { brk; }
    }
    val stopped: bool = serve.stop(?runtime);
    val reason: lifecycle.Reason = serve.shutdown_reason(?runtime);
    val abandoned: usize = serve.shutdown_cancelled(?runtime);
    if (certificates != nil) { acme.close(certificates); }
    if (alpn_challenge_live) { tlsalpn.destroy(?alpn_challenge); }
    hedge_tls.destroy();
    proxy.close_runtime(proxying);
    if (caching != nil) { http_cache.close(caching); }
    static_files.close_registry(?static_registry);
    if (serve.teardown_failures(?runtime) != 0) {
        print.eprint("hedge: teardown calls failed during shutdown: ");
        report_count(serve.teardown_failures(?runtime)::usize);
    }
    if (reason == lifecycle.DEADLINE) {
        print.eprint("hedge: drain deadline expired with connections still active: ");
        report_count(abandoned);
        ret EXIT_DRAIN_INCOMPLETE;
    }
    if (!stopped || reason == lifecycle.FAILED) {
        print.eprintln("hedge: shutdown did not complete cleanly");
        ret EXIT_RUNTIME;
    }
    ret EXIT_OK;
}

# report every bound endpoint so an operator and a test can both find the port
fun announce(runtime: *serve.Runtime, graph: *schema.Graph) {
    var text: [64]u8;
    var i: usize = 0;
    for (i < graph.listener_count) {
        val length: usize = serve.bound_endpoint_text(runtime, i, ?text[0], 64);
        if (length != 0) {
            print.print("hedge: listening ");
            print.print(schema.text(?graph.listeners[i].name));
            print.print(" ");
            print.println((?text[0])::str);
        }
        i = i + 1;
    }
    print.println("hedge: ready");
}
