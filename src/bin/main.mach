# the hedge server executable
#
# the process reads one configuration document, seals a generation from it,
# compiles an immutable plan, and serves until the operating system asks it to
# stop. every failure before readiness exits without ever accepting a connection.

use acme: hedge.acme.manager;
use hedge.cache.store_worker;
use hedge.clock;
use hedge.composition;
use hedge.config.loader;
use hedge.config.schema;
use hedge.generation;
use hedge.hedge;
use hedge.lifecycle;
use hedge.listener;
use hedge.serve;
use hedge.spread;
use hedge.supervisor;
use std.allocator;
use std.allocator.fixed;
use std.allocator.page;
use std.chrono.time;
use std.filesystem;
use io_error: std.io.error;
use std.print;
use std.process.env;
use std.process.limits;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

val EXIT_OK:      i64 = 0;
val EXIT_CONFIG:  i64 = 78;
val EXIT_RUNTIME: i64 = 70;
# the drain deadline passed with exchanges still running, so the process did not
# shut down cleanly even though it shut down
val EXIT_DRAIN_INCOMPLETE: i64 = 75;

val CONFIG_ARENA_BYTES: usize = 1048576;

fun report_diagnostics(diagnostics: *schema.Diagnostics) {
    var i: usize = 0;
    for (i < diagnostics.count) {
        val item: *schema.Diagnostic = ?diagnostics.items[i];
        print.eprint("hedge: ");
        print.eprint(schema.text(?item.source));
        print.eprint(": ");
        print.eprint(schema.text(?item.path));
        print.eprint(": ");
        print.eprintln(schema.text(?item.message));
        i = i + 1;
    }
    if (diagnostics.truncated) { print.eprintln("hedge: diagnostics were truncated"); }
}

# the stalled connections a failed stop names one by one
val STALLED_SHOWN: usize = 32;

fun report_count(value: usize) {
    var digits:    [24]u8;
    var count:     usize = 0;
    var remaining: usize = value;
    if (remaining == 0) {
        digits[0] = '0';
        count     = 1;
    }
    for (remaining != 0) {
        digits[count] = '0' + (remaining % 10)::u8;
        remaining     = remaining / 10;
        count         = count + 1;
    }
    var text: [25]u8;
    var i:    usize = 0;
    for (i < count) {
        text[i] = digits[count - 1 - i];
        i       = i + 1;
    }
    text[count] = 0;
    print.eprintln((?text[0])::str);
}

fun capabilities() loader.Capabilities {
    ret loader.Capabilities{
        quic:                true,
        local_transport:     true,
        environment_secrets: true,
        file_secrets:        true,
        os_secrets:          false,
        application_secrets: false,
    };
}

# the value's length, or -1 when the variable is unset or cannot be read
fun resolve_environment(context: ptr, name: str, output: *u8, capacity: usize) i64 {
    val got: res[opt[usize], env.EnvError] = env.get(name, output, capacity);
    if (sel got.err)     { ret -1; }
    if (sel got.ok.none) { ret -1; }
    ret got.ok.some::i64;
}

# descriptors each io runtime keeps beyond its connections and listeners: its
# own queue and wake, and what the planes open (files, upstreams, ACME) at once
val RUNTIME_DESCRIPTORS: u64 = 32;

# raise the open-file limit as far as this process may and log what took
# effect. a configured connection cap that cannot fit beside every worker's
# listeners and the runtimes' reserve refuses the start rather than failing
# accepts later
fun open_files(graph: *schema.Graph, workers: usize) bool {
    var limit:  limits.FileLimit;
    val raised: res[limits.FileLimit, io_error.Error] = limits.raise_open_files();
    if (sel raised.ok) { limit = raised.ok; }
    or {
        val current: res[limits.FileLimit, io_error.Error] = limits.open_files();
        if (sel current.err) {
            # a platform without the limit bounds descriptors some other way
            print.println("hedge: open files are not limited per process here");
            ret true;
        }
        limit = current.ok;
        print.eprintln("hedge: the open-file limit could not be raised");
    }
    val reserve: u64 = graph.listener_count::u64 * workers::u64
        + RUNTIME_DESCRIPTORS * (workers::u64 + 1);
    print.printlnf("hedge: open files {} (hard {}), {} reserved beside connections",
        limit.soft, limit.hard, reserve);
    if (limit.soft == limits.LIMIT_UNLIMITED) { ret true; }
    if (sel graph.limits.max_connections.some) {
        val wanted: u64 = graph.limits.max_connections.some::u64;
        if (wanted > limit.soft || limit.soft - wanted < reserve) {
            print.eprintlnf("hedge: max_connections {} and {} reserved descriptors exceed the open-file limit {}",
                wanted, reserve, limit.soft);
            ret false;
        }
        ret true;
    }
    if (limit.soft > reserve) {
        print.printlnf("hedge: with no max_connections, at most {} connections fit the open-file limit",
            limit.soft - reserve);
    }
    ret true;
}

fun configuration_path(argc: i64, argv: **u8) str {
    if (argc > 1 && argv[1] != nil) { ret argv[1]::str; }
    ret "hedge.toml";
}

# where a reload's candidate comes from: the configuration file, sealed into
# whichever of the two generation slots the active generation is not using
rec Source {
    heap:        *allocator.Allocator;
    path:        str;
    resolver:    *loader.Resolver;
    diagnostics: *schema.Diagnostics;
    generations: *generation.Generation;
    allocators:  *allocator.Allocator;
    states:      *fixed.FixedState;
}

fun load(context: ptr, id: u64, active: *generation.Generation) *generation.Generation {
    val source: *Source = context::*Source;
    var target: usize   = 0;
    if (active == ?source.generations[0]) { target = 1; }
    val loaded: res[str, filesystem.FsError] = filesystem.read_string(source.heap, source.path);
    if (sel loaded.err) {
        print.eprintln("hedge: reload cannot read the configuration");
        ret nil;
    }
    val text:      str                    = loaded.ok;
    val candidate: *generation.Generation = ?source.generations[target];
    fixed.reset(?source.states[target]);
    schema.reset_diagnostics(source.diagnostics);
    if (!generation.make_candidate(candidate, id)) { ret nil; }
    if (!loader.build(?candidate.graph, source.diagnostics, ?source.allocators[target],
        source.path, text, source.resolver, capabilities())) {
        report_diagnostics(source.diagnostics);
        print.eprintln("hedge: reload rejected, configuration is not valid");
        ret nil;
    }
    if (!generation.seal(candidate, source.diagnostics, nil,
        (0::usize)::generation.ConstructFun)) {
        report_diagnostics(source.diagnostics);
        print.eprintln("hedge: reload rejected, generation did not seal");
        ret nil;
    }
    ret candidate;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var heap: allocator.Allocator;
    val made: err[allocator.Error] = page.make(?heap);
    if (sel made.err) {
        print.eprintln("hedge: page allocator initialization failed");
        ret EXIT_RUNTIME;
    }
    val path:   str                          = configuration_path(argc, argv);
    val loaded: res[str, filesystem.FsError] = filesystem.read_string(?heap, path);
    if (sel loaded.err) {
        print.eprint("hedge: cannot read configuration ");
        print.eprintln(path);
        ret EXIT_CONFIG;
    }
    val source: str = loaded.ok;

    # two of each, alternating. a reload builds its graph, plan and services in
    # the slot the active generation is not using.
    val arena:               res[*u8, allocator.Error]                    = allocator.allocate[u8](?heap, CONFIG_ARENA_BYTES * 2);
    val generations:         res[*generation.Generation, allocator.Error] = allocator.allocate[generation.Generation](?heap, 2);
    val diagnostics_storage: res[*schema.Diagnostics, allocator.Error]    = allocator.allocate[schema.Diagnostics](?heap, 1);
    val composition_storage: res[*composition.Runtime, allocator.Error]   =
        allocator.allocate[composition.Runtime](?heap, 1);
    if (sel arena.err) {
        print.eprintln("hedge: startup allocation failed");
        ret EXIT_RUNTIME;
    }
    if (sel generations.err) {
        print.eprintln("hedge: startup allocation failed");
        ret EXIT_RUNTIME;
    }
    if (sel diagnostics_storage.err) {
        print.eprintln("hedge: startup allocation failed");
        ret EXIT_RUNTIME;
    }
    if (sel composition_storage.err) {
        print.eprintln("hedge: startup allocation failed");
        ret EXIT_RUNTIME;
    }
    val arena_base:      *u8                    = arena.ok;
    val generation_base: *generation.Generation =
        generations.ok;
    var config_allocators: [2]allocator.Allocator;
    var config_states:     [2]fixed.FixedState;
    fixed.make(?config_allocators[0], ?config_states[0], arena_base, CONFIG_ARENA_BYTES);
    fixed.make(?config_allocators[1], ?config_states[1], ?arena_base[CONFIG_ARENA_BYTES],
        CONFIG_ARENA_BYTES);
    var config_allocator: allocator.Allocator    = config_allocators[0];
    val candidate:        *generation.Generation = ?generation_base[0];
    val diagnostics:      *schema.Diagnostics    = diagnostics_storage.ok;

    var resolver: loader.Resolver = loader.Resolver{
        context: nil,
        include: (0::usize)::loader.ResolveFun,
        environment: resolve_environment,
    };
    schema.reset_diagnostics(diagnostics);
    if (!generation.make_candidate(candidate, 1)) {
        print.eprintln("hedge: candidate generation initialization failed");
        ret EXIT_RUNTIME;
    }
    if (!loader.build(?candidate.graph, diagnostics, ?config_allocator, path, source,
        ?resolver, capabilities())) {
        report_diagnostics(diagnostics);
        print.eprintln("hedge: configuration is not valid");
        ret EXIT_CONFIG;
    }
    if (!generation.seal(candidate, diagnostics, nil, (0::usize)::generation.ConstructFun)) {
        report_diagnostics(diagnostics);
        print.eprintln("hedge: generation did not seal");
        ret EXIT_CONFIG;
    }
    report_diagnostics(diagnostics);

    val composed: *composition.Runtime =
        composition_storage.ok;
    val counted: spread.Count = spread.count(?candidate.graph);
    val workers: usize        = counted.workers;
    if (counted.reason != nil) {
        print.printlnf("hedge: one worker serves where {} were asked, because {}",
            counted.wanted, counted.reason);
    }
    if (!open_files(?candidate.graph, workers)) { ret EXIT_CONFIG; }
    val started: composition.StartReport = composition.start_process(composed,
        ?heap, ?candidate.graph, candidate.id, diagnostics,
        composition.default_options(), workers);
    if (started.status != composition.START_OK) {
        report_diagnostics(diagnostics);
        print.eprint("hedge: startup composition failed: ");
        print.eprintln(started.detail);
        if (started.status == composition.START_CONFIG) { ret EXIT_CONFIG; }
        ret EXIT_RUNTIME;
    }
    var reloads: Source;
    reloads.heap        = ?heap;
    reloads.path        = path;
    reloads.resolver    = ?resolver;
    reloads.diagnostics = diagnostics;
    reloads.generations = generation_base;
    reloads.allocators  = ?config_allocators[0];
    reloads.states      = ?config_states[0];
    var supervising: supervisor.Supervisor;
    if (!supervisor.make(?supervising, composed, ?heap, true)
        || !supervisor.attach_reloads(?supervising, candidate,
        supervisor.Loader{context: (?reloads)::ptr, load: load})) {
        print.eprintln("hedge: the supervisor could not take the process events");
        var unwound: composition.StopReport;
        composition.close(composed, ?unwound);
        ret EXIT_RUNTIME;
    }
    # every worker serves, or none does: a worker that failed has been named
    # and the others stopped
    val status:  composition.StartStatus = supervisor.start(?supervising);
    val serving: bool                    = status == composition.START_OK;
    if (serving) {
        announce(composed, ?candidate.graph);
        if (composed.acme_live && acme.certificate_ready(composed.certificates)) {
            supervisor.announce_certificate(composed.certificates);
        }
        supervisor.run(?supervising);
    }
    val stopped: composition.StopReport = supervisor.stop(?supervising);
    if (!stopped.stopped) { report_stalled(composed); }
    report_store_stalled(composed);
    if (stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        print.eprint("hedge: teardown calls failed during shutdown: ");
        report_count((stopped.serve_failures + stopped.cleanup_failures)::usize);
    }
    if (status == composition.START_CONFIG) { ret EXIT_CONFIG; }
    if (!serving)                           { ret EXIT_RUNTIME; }
    if (stopped.reason == lifecycle.DEADLINE) {
        print.eprint("hedge: drain deadline expired with connections still active: ");
        report_count(stopped.abandoned);
        ret EXIT_DRAIN_INCOMPLETE;
    }
    if (!stopped.stopped || stopped.reason == lifecycle.FAILED
        || stopped.cleanup_failures != 0) {
        print.eprintln("hedge: shutdown did not complete cleanly");
        ret EXIT_RUNTIME;
    }
    ret EXIT_OK;
}

# name the connections a stop gave up on, worker by worker
fun report_stalled(composed: *composition.Runtime) {
    var i: usize = 0;
    for (i < composed.worker_count) {
        report_worker_stalled(?composition.worker_at(composed, i).serving);
        i = i + 1;
    }
}

# name one worker's connections a stop gave up on and what each one's close waits on
fun report_worker_stalled(runtime: *serve.Runtime) {
    var stalled: [STALLED_SHOWN]serve.Stalled;
    val count:   usize = serve.stalled(runtime, ?stalled[0], STALLED_SHOWN);
    val quic:    usize = serve.stalled_quic(runtime);
    if (count == 0 && quic == 0) { ret; }
    print.eprintlnf("hedge: stop gave up with {} TCP and {} QUIC connections still open",
        count, quic);
    var i: usize = 0;
    for (i < count && i < STALLED_SHOWN) {
        print.eprintlnf("hedge: connection {} waits on {}", stalled[i].id,
            stalled[i].waits_on);
        i = i + 1;
    }
    if (count > STALLED_SHOWN) {
        print.eprintlnf("hedge: and {} more", count - STALLED_SHOWN);
    }
}

# name the disk requests the cache's store worker still held when its stop
# timeout passed (#286)
fun report_store_stalled(composed: *composition.Runtime) {
    var stalled: [STALLED_SHOWN]store_worker.Outstanding;
    val count:   usize = composition.cache_stalled(composed, ?stalled[0], STALLED_SHOWN);
    if (count == 0) { ret; }
    print.eprintlnf("hedge: stop gave up with {} cache disk requests outstanding", count);
    var i: usize = 0;
    for (i < count && i < STALLED_SHOWN) {
        var state: str = "queued";
        if (stalled[i].running) { state = "running"; }
        print.eprintlnf("hedge: cache disk {} of {} {}", store_worker.op_text(stalled[i].op),
            (?stalled[i].name[0])::str, state);
        i = i + 1;
    }
    if (count > STALLED_SHOWN) {
        print.eprintlnf("hedge: and {} more", count - STALLED_SHOWN);
    }
}

# report every bound endpoint so an operator and a test can both find the port,
# and the workers that serve them
fun announce(composed: *composition.Runtime, graph: *schema.Graph) {
    val runtime: *serve.Runtime = ?composition.worker_at(composed, 0).serving;
    var text:    [64]u8;
    var i:       usize          = 0;
    for (i < graph.listener_count) {
        val length: usize = serve.bound_endpoint_text(runtime, i, ?text[0], 64);
        if (length != 0) {
            print.print("hedge: listening ");
            print.print(schema.text(?graph.listeners[i].name));
            print.print(" ");
            print.println((?text[0])::str);
        }
        val buffers: listener.SocketBuffers = serve.socket_buffers(runtime, i);
        if (buffers.receive_requested != 0 && buffers.receive_effective != 0) {
            print.printlnf("hedge: socket buffers {} receive {} (asked {}) send {} (asked {})",
                schema.text(?graph.listeners[i].name), buffers.receive_effective,
                buffers.receive_requested, buffers.send_effective, buffers.send_requested);
        }
        i = i + 1;
    }
    if (sel graph.limits.max_handshakes_per_peer.some) {
        print.printlnf("hedge: handshakes in flight at most {} ({} per peer)",
            graph.limits.max_handshakes, graph.limits.max_handshakes_per_peer.some);
    }
    or {
        print.printlnf("hedge: handshakes in flight at most {}",
            graph.limits.max_handshakes);
    }
    print.printlnf("hedge: workers {}", composed.worker_count);
    print.println("hedge: ready");
}
