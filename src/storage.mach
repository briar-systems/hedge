# per-connection storage claimed on demand
#
# a record claimed here never moves while it is held: io completion contexts,
# cancellation scopes and body readers keep pointers into it. released records
# are kept for the next claim, so steady-state serving does not map and unmap
# storage per connection.

use crypto.contracts;
use crypto.secret;
use A: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.math;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# count is how many T make one claim, so a byte buffer and a record share one pool
pub rec Recycler[T] {
    allocator: *A.Allocator;
    count:     usize;
    free:      vector.Vector[*T];
    held:      usize;
    live:      bool;
}

pub fun make[T](recycler: *Recycler[T], a: *A.Allocator, count: usize) bool {
    if (recycler == nil || a == nil || count == 0) { ret false; }
    recycler.allocator = a;
    recycler.count     = count;
    recycler.free      = vector.init[*T](a);
    recycler.held      = 0;
    recycler.live      = true;
    ret true;
}

# nil when the allocator refuses, which is the only way a claim fails
pub fun claim[T](recycler: *Recycler[T]) *T {
    if (recycler == nil || !recycler.live) { ret nil; }
    val reused: opt[*T] = vector.pop[*T](?recycler.free);
    if (sel reused.some) {
        recycler.held = recycler.held + 1;
        ret reused.some;
    }
    val allocated: res[*T, A.Error] = A.allocate[T](recycler.allocator, recycler.count);
    if (sel allocated.err) { ret nil; }
    recycler.held = recycler.held + 1;
    ret allocated.ok;
}

# a record the free list cannot take is returned to the allocator instead
pub fun release[T](recycler: *Recycler[T], value: *T) bool {
    if (recycler == nil || !recycler.live || value == nil || recycler.held == 0) {
        ret false;
    }
    recycler.held = recycler.held - 1;
    val kept: res[usize, A.Error] = vector.push[*T](?recycler.free, value);
    if (sel kept.ok) { ret true; }
    val returned: err[A.Error] = A.deallocate[T](recycler.allocator, value, recycler.count);
    ret sel returned.ok;
}

pub fun held[T](recycler: *Recycler[T]) usize {
    if (recycler == nil) { ret 0; }
    ret recycler.held;
}

# every claim must have been released first
pub fun destroy[T](recycler: *Recycler[T]) bool {
    if (recycler == nil || !recycler.live || recycler.held != 0) { ret false; }
    var ok: bool = true;
    for {
        val kept: opt[*T] = vector.pop[*T](?recycler.free);
        if (!(sel kept.some)) { brk; }
        val returned: err[A.Error] = A.deallocate[T](recycler.allocator, kept.some,
            recycler.count);
        if (sel returned.err) { ok = false; }
    }
    val freed: err[A.Error] = vector.dnit[*T](?recycler.free);
    if (sel freed.err) { ok = false; }
    recycler.live = false;
    ret ok;
}

# byte chunks in power-of-two classes from MIN_CHUNK up, each class recycled on
# its own, so memory claimed per request is reused rather than remapped
pub val MIN_CHUNK:     usize = 16384;
pub val CHUNK_CLASSES: usize = 16;

pub rec Chunks {
    classes: [CHUNK_CLASSES]Recycler[u8];
}

pub fun make_chunks(chunks: *Chunks, a: *A.Allocator) bool {
    if (chunks == nil || a == nil) { ret false; }
    var i: usize = 0;
    for (i < CHUNK_CLASSES) {
        if (!make[u8](?chunks.classes[i], a, MIN_CHUNK << i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the size a claim of at least bytes actually receives, or zero past the largest class
pub fun chunk_class_size(bytes: usize) usize {
    var i: usize = 0;
    for (i < CHUNK_CLASSES) {
        if (bytes <= MIN_CHUNK << i) { ret MIN_CHUNK << i; }
        i = i + 1;
    }
    ret 0;
}

fun class_index(size: usize) usize {
    var i: usize = 0;
    for (i < CHUNK_CLASSES && MIN_CHUNK << i != size) { i = i + 1; }
    ret i;
}

# size must be a class size from chunk_class_size
pub fun claim_chunk(chunks: *Chunks, size: usize) *u8 {
    if (chunks == nil) { ret nil; }
    val index: usize = class_index(size);
    if (index == CHUNK_CLASSES) { ret nil; }
    ret claim[u8](?chunks.classes[index]);
}

pub fun release_chunk(chunks: *Chunks, chunk: *u8, size: usize) bool {
    if (chunks == nil) { ret false; }
    val index: usize = class_index(size);
    if (index == CHUNK_CLASSES) { ret false; }
    ret release[u8](?chunks.classes[index], chunk);
}

# every chunk must have been released first, and nothing is destroyed otherwise
pub fun destroy_chunks(chunks: *Chunks) bool {
    if (chunks == nil) { ret false; }
    var i: usize = 0;
    for (i < CHUNK_CLASSES) {
        if (held[u8](?chunks.classes[i]) != 0) { ret false; }
        i = i + 1;
    }
    var ok: bool = true;
    i = 0;
    for (i < CHUNK_CLASSES) {
        if (!destroy[u8](?chunks.classes[i])) { ok = false; }
        i = i + 1;
    }
    ret ok;
}

# index-addressed tables for records paired by index or reachable only by index.
# a record never moves once its chunk exists, and a chunk's record storage is
# bounded by CHUNK_BYTES: chunks double from FIRST_CHUNK records until the next
# doubling would pass the bound, and every chunk after that holds the bound. a
# chunk is committed whole (zeroed or welded and wiped), so the resident set at N
# live records is within one bounded chunk of N slots rather than within a doubling
# of them, and one grow is one commit of at most CHUNK_BYTES.
pub val FIRST_CHUNK: usize = 16;
# log2(FIRST_CHUNK)
val     FIRST_SHIFT:     usize = 4;
pub val CHUNK_BYTES:     usize = 2 * 1024 * 1024;
pub val DIRECTORY_FIRST: usize = 32;
# no free slot / no cached chunk
pub val NO_INDEX: usize = (-1)::usize;

# the chunk shape of one index space, derived once from its record size. chunk k
# holds FIRST_CHUNK << k records for k <= bound_chunk and 1 << bound_shift records
# after it, so bound_chunk is the last chunk of the doubling series and the first
# of the bound
pub rec Geometry {
    bound_chunk: usize;
    bound_shift: usize;
}

# the largest power-of-two record count whose storage fits CHUNK_BYTES, never
# below FIRST_CHUNK: a record wider than CHUNK_BYTES / FIRST_CHUNK has no doubling
# series at all
pub fun geometry(record_bytes: usize) Geometry {
    var bytes: usize = record_bytes;
    if (bytes == 0) { bytes = 1; }
    var k: usize = 0;
    for ((FIRST_CHUNK << (k + 1)) * bytes <= CHUNK_BYTES) { k = k + 1; }
    ret Geometry{bound_chunk: k, bound_shift: FIRST_SHIFT + k};
}

# the record count of a table's chunk k
pub fun chunk_records(g: Geometry, k: usize) usize {
    if (k < g.bound_chunk) { ret FIRST_CHUNK << k; }
    ret 1::usize << g.bound_shift;
}

# the first index of chunk k as if the series doubled forever
fun series_start(k: usize) usize {
    ret FIRST_CHUNK * ((1::usize << k) - 1);
}

fun chunk_start(g: Geometry, k: usize) usize {
    if (k <= g.bound_chunk) { ret series_start(k); }
    ret series_start(g.bound_chunk + 1) + ((k - g.bound_chunk - 1) << g.bound_shift);
}

# the chunk holding an index, in O(1): a shift past the doubling series, the bit
# length of the index's FIRST_CHUNK multiple inside it
fun chunk_of(g: Geometry, index: usize) usize {
    val uniform: usize = series_start(g.bound_chunk + 1);
    if (index >= uniform) { ret g.bound_chunk + 1 + ((index - uniform) >> g.bound_shift); }
    ret math.log2(((index >> FIRST_SHIFT) + 1)::u64)::usize;
}

# the record-table index allocator, generic over its one or two typed storages.
#
# one index space [0, capacity) is drawn on by the storages, which grow and compact
# in lockstep (the paired channel/session tables are two storages on one slab).
# the slab owns the geometry, a per-chunk free stack in its own `links` storage, a
# per-chunk live count, and the lowest non-full chunk, so a claim pops the lowest
# free index in O(1) amortized and O(chunks) worst, never an O(capacity) scan. the
# per-chunk state is a directory that starts at DIRECTORY_FIRST entries on the
# first grow and doubles, so boot allocates nothing and no count is set aside.
#
# releasing the last live record of the trailing chunk releases that chunk and
# cascades, so chunks [0, count) stay a dense prefix and a record never moves --
# the invariant the raw record pointers held across a connection depend on. the
# footprint is therefore proportional to the highest live index, which lowest-index
# allocation drives down as high slots churn out, converging to proportional to the
# live count; a record pinned at a high index holds its chunk until it releases,
# the correct cost of never moving a record.
#
# each storage is a TYPED context and typed grow/release hooks, never erased to a
# `ptr`: a slab over a secret table is itself welded, so it never aliases secret
# storage to a public pointer (which the language forbids). a hook receives the
# chunk and its record count, so a storage never derives geometry. a
# single-storage table uses Unit as its second storage with no-op hooks; the arity
# is the type, so a consumer that needs a third storage declares a wider slab
# rather than widening this one.
rec Unit {}

rec ChunkState {
    links:     *usize;
    live:      usize;
    free_head: usize;
}

pub rec Slab[S1, S2] {
    allocator:         *A.Allocator;
    geometry:          Geometry;
    s1:                *S1;
    grow1:             fun(*S1, usize, usize) bool;
    release1:          fun(*S1, usize, usize) bool;
    s2:                *S2;
    grow2:             fun(*S2, usize, usize) bool;
    release2:          fun(*S2, usize, usize) bool;
    chunks:            *ChunkState;
    directory:         usize;
    links_cache:       *usize;
    links_cache_class: usize;
    count:             usize;
    capacity:          usize;
    live:              usize;
    lowest_free:       usize;
}

fun unit_grow(unit: *Unit, k: usize, records: usize) bool {
    ret true;
}

fun unit_release(unit: *Unit, k: usize, records: usize) bool {
    ret true;
}

var absent_storage: Unit;

# wire two storages onto a slab; both grow and compact in lockstep
pub fun slab_make_paired[S1, S2](slab: *Slab[S1, S2], a: *A.Allocator, g: Geometry,
    s1: *S1, grow1: fun(*S1, usize, usize) bool, release1: fun(*S1, usize, usize) bool,
    s2: *S2, grow2: fun(*S2, usize, usize) bool, release2: fun(*S2, usize, usize) bool) bool {
    if (slab == nil || a == nil || s1 == nil || s2 == nil || grow1 == nil
        || release1 == nil || grow2 == nil || release2 == nil) { ret false; }
    slab.allocator         = a;
    slab.geometry          = g;
    slab.s1                = s1;
    slab.grow1             = grow1;
    slab.release1          = release1;
    slab.s2                = s2;
    slab.grow2             = grow2;
    slab.release2          = release2;
    slab.chunks            = nil;
    slab.directory         = 0;
    slab.links_cache       = nil;
    slab.links_cache_class = NO_INDEX;
    slab.count             = 0;
    slab.capacity          = 0;
    slab.live              = 0;
    slab.lowest_free       = 0;
    ret true;
}

# wire a single storage onto a slab; the second storage is the shared no-op Unit
pub fun slab_make[S1](slab: *Slab[S1, Unit], a: *A.Allocator, g: Geometry, s1: *S1,
    grow1: fun(*S1, usize, usize) bool, release1: fun(*S1, usize, usize) bool) bool {
    ret slab_make_paired[S1, Unit](slab, a, g, s1, grow1, release1,
        ?absent_storage, unit_grow, unit_release);
}

# the next directory size: DIRECTORY_FIRST, then doubling
fun next_directory(current: usize) usize {
    if (current == 0) { ret DIRECTORY_FIRST; }
    ret current * 2;
}

# widen the slab's per-chunk state so chunk `count` has an entry
fun slab_grow_directory[S1, S2](slab: *Slab[S1, S2]) bool {
    val wider: usize                     = next_directory(slab.directory);
    val got:   res[*ChunkState, A.Error] = A.allocate[ChunkState](slab.allocator, wider);
    if (sel got.err) { ret false; }
    if (slab.chunks != nil) {
        mem.copy[ChunkState](got.ok, slab.chunks, slab.directory);
        A.deallocate[ChunkState](slab.allocator, slab.chunks, slab.directory);
    }
    var i: usize = slab.directory;
    for (i < wider) {
        got.ok[i] = ChunkState{links: nil, live: 0, free_head: NO_INDEX};
        i         = i + 1;
    }
    slab.chunks    = got.ok;
    slab.directory = wider;
    ret true;
}

# keep exactly one cached link chunk, the one closest to the regrow boundary
fun cache_links[S1, S2](slab: *Slab[S1, S2], chunk: *usize, class: usize) {
    if (slab.links_cache == nil) {
        slab.links_cache       = chunk;
        slab.links_cache_class = class;
        ret;
    }
    if (class < slab.links_cache_class) {
        A.deallocate[usize](slab.allocator, slab.links_cache,
            chunk_records(slab.geometry, slab.links_cache_class));
        slab.links_cache       = chunk;
        slab.links_cache_class = class;
        ret;
    }
    A.deallocate[usize](slab.allocator, chunk, chunk_records(slab.geometry, class));
}

# a cached link chunk serves chunk k when it holds k's record count
fun cache_serves(g: Geometry, cached: usize, k: usize) bool {
    ret cached != NO_INDEX && chunk_records(g, cached) == chunk_records(g, k);
}

# add the next chunk to both storages and the slab's own link stack, in lockstep
fun slab_grow[S1, S2](slab: *Slab[S1, S2]) bool {
    if (slab.count == slab.directory && !slab_grow_directory[S1, S2](slab)) { ret false; }
    val k:    usize  = slab.count;
    val size: usize  = chunk_records(slab.geometry, k);
    var link: *usize = nil;
    if (slab.links_cache != nil && cache_serves(slab.geometry, slab.links_cache_class, k)) {
        link                   = slab.links_cache;
        slab.links_cache       = nil;
        slab.links_cache_class = NO_INDEX;
    }
    or {
        val got: res[*usize, A.Error] = A.allocate[usize](slab.allocator, size);
        if (sel got.err) { ret false; }
        link = got.ok;
    }
    if (!slab.grow1(slab.s1, k, size)) {
        cache_links[S1, S2](slab, link, k);
        ret false;
    }
    if (!slab.grow2(slab.s2, k, size)) {
        slab.release1(slab.s1, k, size);
        cache_links[S1, S2](slab, link, k);
        ret false;
    }
    val base: usize = chunk_start(slab.geometry, k);
    var s:    usize = 0;
    for (s < size) {
        if (s + 1 < size) { link[s] = base + s + 1; }
        or                { link[s] = NO_INDEX; }
        s = s + 1;
    }
    slab.chunks[k] = ChunkState{links: link, live: 0, free_head: base};
    slab.capacity  = slab.capacity + size;
    slab.count     = slab.count + 1;
    ret true;
}

# claim the lowest free index, growing both storages when the space is full.
# NO_INDEX only when a storage or a link allocation refuses.
pub fun slab_claim[S1, S2](slab: *Slab[S1, S2]) usize {
    if (slab == nil) { ret NO_INDEX; }
    for (slab.lowest_free < slab.count && slab.chunks[slab.lowest_free].free_head == NO_INDEX) {
        slab.lowest_free = slab.lowest_free + 1;
    }
    if (slab.lowest_free == slab.count) {
        if (!slab_grow[S1, S2](slab)) { ret NO_INDEX; }
        slab.lowest_free = slab.count - 1;
    }
    val k:     usize       = slab.lowest_free;
    val state: *ChunkState = ?slab.chunks[k];
    val index: usize       = state.free_head;
    state.free_head = state.links[index - chunk_start(slab.geometry, k)];
    state.live      = state.live + 1;
    slab.live       = slab.live + 1;
    ret index;
}

fun release_trailing[S1, S2](slab: *Slab[S1, S2]) {
    val k:    usize = slab.count - 1;
    val size: usize = chunk_records(slab.geometry, k);
    slab.release1(slab.s1, k, size);
    slab.release2(slab.s2, k, size);
    cache_links[S1, S2](slab, slab.chunks[k].links, k);
    slab.chunks[k] = ChunkState{links: nil, live: 0, free_head: NO_INDEX};
    slab.capacity  = slab.capacity - size;
    slab.count     = k;
}

# return an index to its chunk's free stack, releasing trailing all-free chunks
pub fun slab_release[S1, S2](slab: *Slab[S1, S2], index: usize) bool {
    if (slab == nil || index >= slab.capacity) { ret false; }
    val k:     usize       = chunk_of(slab.geometry, index);
    val state: *ChunkState = ?slab.chunks[k];
    if (state.live == 0) { ret false; }
    state.links[index - chunk_start(slab.geometry, k)] = state.free_head;
    state.free_head                                    = index;
    state.live                                         = state.live - 1;
    slab.live                                          = slab.live - 1;
    if (k < slab.lowest_free) { slab.lowest_free = k; }
    if (state.live == 0 && k == slab.count - 1) {
        for (slab.count > 0 && slab.chunks[slab.count - 1].live == 0) {
            release_trailing[S1, S2](slab);
        }
        if (slab.lowest_free > slab.count) { slab.lowest_free = slab.count; }
    }
    ret true;
}

# free the slab's own link storage, cache and directory; storages free their own
# chunks
pub fun slab_destroy[S1, S2](slab: *Slab[S1, S2]) bool {
    if (slab == nil) { ret false; }
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < slab.count) {
        if (slab.chunks[i].links != nil) {
            val freed: err[A.Error] = A.deallocate[usize](slab.allocator, slab.chunks[i].links,
                chunk_records(slab.geometry, i));
            if (sel freed.err) { ok = false; }
            slab.chunks[i].links = nil;
        }
        i = i + 1;
    }
    if (slab.links_cache != nil) {
        val freed: err[A.Error] = A.deallocate[usize](slab.allocator, slab.links_cache,
            chunk_records(slab.geometry, slab.links_cache_class));
        if (sel freed.err) { ok = false; }
        slab.links_cache       = nil;
        slab.links_cache_class = NO_INDEX;
    }
    if (slab.chunks != nil) {
        val freed: err[A.Error] = A.deallocate[ChunkState](slab.allocator, slab.chunks,
            slab.directory);
        if (sel freed.err) { ok = false; }
        slab.chunks    = nil;
        slab.directory = 0;
    }
    slab.count       = 0;
    slab.capacity    = 0;
    slab.live        = 0;
    slab.lowest_free = 0;
    ret ok;
}

# an index-addressed table of records, one storage on a Slab. records never move;
# the table commits a record chunk when the slab grows the index space and releases
# it (to a one-deep cache, then the allocator) when the slab compacts a trailing
# all-free chunk, so it holds chunks proportional to the highest live index. its
# chunk directory grows with the slab's. it carries its own allocator and geometry
# so its hooks and record addressing are correct whether it drives its embedded
# slab (standalone) or a shared slab another owner drives (the paired secure
# channel table).
pub rec Table[T] {
    slab:        Slab[Table[T], Unit];
    allocator:   *A.Allocator;
    geometry:    Geometry;
    chunks:      **T;
    directory:   usize;
    cache:       *T;
    cache_class: usize;
}

fun table_grow_directory[T](table: *Table[T]) bool {
    val wider: usize             = next_directory(table.directory);
    val got:   res[**T, A.Error] = A.zallocate[*T](table.allocator, wider);
    if (sel got.err) { ret false; }
    if (table.chunks != nil) {
        mem.copy[*T](got.ok, table.chunks, table.directory);
        A.deallocate[*T](table.allocator, table.chunks, table.directory);
    }
    table.chunks    = got.ok;
    table.directory = wider;
    ret true;
}

# the slab's grow hook: commit record chunk k, reusing the cache when it fits.
# zeroed, because a fresh record must read as unused
fun table_grow_hook[T](table: *Table[T], k: usize, records: usize) bool {
    if (k == table.directory && !table_grow_directory[T](table)) { ret false; }
    var chunk: *T = nil;
    if (table.cache != nil && cache_serves(table.geometry, table.cache_class, k)) {
        chunk             = table.cache;
        table.cache       = nil;
        table.cache_class = NO_INDEX;
    }
    or {
        val allocated: res[*T, A.Error] = A.zallocate[T](table.allocator, records);
        if (sel allocated.err) { ret false; }
        chunk = allocated.ok;
    }
    table.chunks[k] = chunk;
    ret true;
}

# the slab's release hook: keep the lowest released chunk cached, free the rest
fun table_release_hook[T](table: *Table[T], k: usize, records: usize) bool {
    if (table.cache == nil) {
        table.cache       = table.chunks[k];
        table.cache_class = k;
    }
    or (k < table.cache_class) {
        A.deallocate[T](table.allocator, table.cache,
            chunk_records(table.geometry, table.cache_class));
        table.cache       = table.chunks[k];
        table.cache_class = k;
    }
    or {
        A.deallocate[T](table.allocator, table.chunks[k], records);
    }
    table.chunks[k] = nil;
    ret true;
}

# init the record chunks, allocator and geometry without wiring a slab, for a
# table that will be a storage on a shared slab another owner drives
pub fun init_table[T](table: *Table[T], a: *A.Allocator, g: Geometry) bool {
    if (table == nil || a == nil) { ret false; }
    table.allocator   = a;
    table.geometry    = g;
    table.chunks      = nil;
    table.directory   = 0;
    table.cache       = nil;
    table.cache_class = NO_INDEX;
    ret true;
}

pub fun make_table[T](table: *Table[T], a: *A.Allocator) bool {
    val g: Geometry = geometry($size_of(T));
    if (!init_table[T](table, a, g)) { ret false; }
    ret slab_make[Table[T]](?table.slab, a, g, table, table_grow_hook[T],
        table_release_hook[T]);
}

pub fun table_capacity[T](table: *Table[T]) usize {
    if (table == nil) { ret 0; }
    ret table.slab.capacity;
}

pub fun table_chunks[T](table: *Table[T]) usize {
    if (table == nil) { ret 0; }
    ret table.slab.count;
}

pub fun table_live[T](table: *Table[T]) usize {
    if (table == nil) { ret 0; }
    ret table.slab.live;
}

# claim the lowest free index, growing the table if the space is full;
# NO_INDEX only when the allocator refuses
pub fun table_claim[T](table: *Table[T]) usize {
    if (table == nil) { ret NO_INDEX; }
    ret slab_claim[Table[T], Unit](?table.slab);
}

# release a claimed index, compacting trailing all-free chunks
pub fun table_release[T](table: *Table[T], index: usize) bool {
    if (table == nil) { ret false; }
    ret slab_release[Table[T], Unit](?table.slab, index);
}

# adds the next chunk without claiming an index (the pre-slab claim path still
# used by consumers not yet migrated to table_claim)
pub fun grow_table[T](table: *Table[T]) bool {
    if (table == nil) { ret false; }
    ret slab_grow[Table[T], Unit](?table.slab);
}

# a record by index, bounded by an explicit capacity so a table sharing a slab it
# does not own reads the owner's capacity rather than its unused embedded slab
pub fun table_record[T](table: *Table[T], index: usize, capacity: usize) *T {
    if (table == nil || index >= capacity) { ret nil; }
    val chunk: usize = chunk_of(table.geometry, index);
    if (chunk >= table.directory || table.chunks[chunk] == nil) { ret nil; }
    ret ?table.chunks[chunk][index - chunk_start(table.geometry, chunk)];
}

pub fun table_at[T](table: *Table[T], index: usize) *T {
    if (table == nil) { ret nil; }
    ret table_record[T](table, index, table.slab.capacity);
}

# free every record chunk, the cache and the directory; leaves the slab alone, so
# a shared-slab owner can free the records without touching a slab it does not own
pub fun free_table_chunks[T](table: *Table[T]) bool {
    if (table == nil) { ret false; }
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < table.directory) {
        if (table.chunks[i] != nil) {
            val returned: err[A.Error] = A.deallocate[T](table.allocator,
                table.chunks[i], chunk_records(table.geometry, i));
            if (sel returned.err) { ok = false; }
            table.chunks[i] = nil;
        }
        i = i + 1;
    }
    if (table.cache != nil) {
        val returned: err[A.Error] = A.deallocate[T](table.allocator, table.cache,
            chunk_records(table.geometry, table.cache_class));
        if (sel returned.err) { ok = false; }
        table.cache       = nil;
        table.cache_class = NO_INDEX;
    }
    if (table.chunks != nil) {
        val returned: err[A.Error] = A.deallocate[*T](table.allocator, table.chunks,
            table.directory);
        if (sel returned.err) { ok = false; }
        table.chunks    = nil;
        table.directory = 0;
    }
    ret ok;
}

pub fun destroy_table[T](table: *Table[T]) bool {
    if (table == nil) { ret false; }
    var ok: bool = free_table_chunks[T](table);
    if (!slab_destroy[Table[T], Unit](?table.slab)) { ok = false; }
    ret ok;
}

# the same shape for secret-welded records, which only crypto.secret may allocate,
# one storage on a Slab. records never move; a chunk is welded on grow and zeroized
# and unwelded on release, so a secret table holds welded memory proportional to
# its highest live index and converges under churn. a standalone table drives its
# embedded slab; the paired secure session table is a second storage on the channel
# table's slab (see make_paired). the storage context is the TYPED *SecretTable[T],
# never erased to a `ptr`, so the slab over it is itself welded -- no public alias
# to secret storage is ever formed. T is a plain record: its secrecy is the welded,
# wiped-on-release memory, not type-level `^` fields.
#
# the chunk directory is itself welded: a SecretArray[T] carries its allocator's
# secret context, so the language refuses it a home in plain heap memory, and the
# path to secret memory is held like the memory. the directory grows by welding
# the next size, moving the entries and destroying the old one, which wipes the
# moved-from records and leaves the chunks they named alone. a directory whose
# destroy failed is kept as `spent` and retried, as a chunk is.
pub rec SecretTable[T] {
    slab:                Slab[SecretTable[T], Unit];
    geometry:            Geometry;
    allocator:           secret.ArrayAllocator[T];
    directory_allocator: secret.ArrayAllocator[secret.SecretArray[T]];
    directory:           secret.SecretArray[secret.SecretArray[T]];
    spent:               secret.SecretArray[secret.SecretArray[T]];
    entries:             usize;
}

fun secret_chunk[T](table: *SecretTable[T], k: usize) *secret.SecretArray[T] {
    if (k >= table.entries) { ret nil; }
    val entries: *secret.SecretArray[T] =
        secret.array_data[secret.SecretArray[T]](?table.directory);
    if (entries == nil) { ret nil; }
    ret ?entries[k];
}

# destroy a directory a prior grow could not, before another takes its place
fun secret_retire_spent[T](table: *SecretTable[T]) bool {
    if (!secret.array_cleanup_pending[secret.SecretArray[T]](?table.spent)) { ret true; }
    ret secret.destroy_array[secret.SecretArray[T]](?table.spent) == contracts.OK;
}

fun secret_grow_directory[T](table: *SecretTable[T]) bool {
    if (!secret_retire_spent[T](table)) { ret false; }
    val wider: usize                                     = next_directory(table.entries);
    var next:  secret.SecretArray[secret.SecretArray[T]] =
        secret.empty_array[secret.SecretArray[T]]();
    if (secret.init_array[secret.SecretArray[T]](?next, ?table.directory_allocator, wider)
        != contracts.OK) { ret false; }
    val into: *secret.SecretArray[T] = secret.array_data[secret.SecretArray[T]](?next);
    val from: *secret.SecretArray[T] =
        secret.array_data[secret.SecretArray[T]](?table.directory);
    var i: usize = 0;
    for (i < table.entries) {
        into[i] = from[i];
        i       = i + 1;
    }
    for (i < wider) {
        into[i] = secret.empty_array[T]();
        i       = i + 1;
    }
    if (table.entries != 0
        && secret.destroy_array[secret.SecretArray[T]](?table.directory) != contracts.OK) {
        table.spent = table.directory;
    }
    table.directory = next;
    table.entries   = wider;
    ret true;
}

# the slab's grow hook for secret storage: weld record chunk k. a chunk a prior
# release wiped but could not free is wiped and freed again before re-welding
fun secret_grow_hook[T](table: *SecretTable[T], k: usize, records: usize) bool {
    if (k == table.entries && !secret_grow_directory[T](table)) { ret false; }
    val chunk: *secret.SecretArray[T] = secret_chunk[T](table, k);
    if (chunk == nil) { ret false; }
    if (secret.array_cleanup_pending[T](chunk)
        && secret.destroy_array[T](chunk) != contracts.OK) { ret false; }
    ret secret.init_array[T](chunk, ?table.allocator, records) == contracts.OK;
}

# the slab's release hook for secret storage: zeroize and unweld chunk k per
# crypto.secret, never a plain dealloc. a chunk that cannot be freed is left wiped
# (its bytes are gone) for a later grow or destroy to reclaim
fun secret_release_hook[T](table: *SecretTable[T], k: usize, records: usize) bool {
    val chunk: *secret.SecretArray[T] = secret_chunk[T](table, k);
    if (chunk == nil) { ret false; }
    ret secret.destroy_array[T](chunk) == contracts.OK;
}

# init the allocators, geometry and an empty directory without wiring a slab, for
# a secret table that will be a storage on a shared slab another owner drives
pub fun init_secret_table[T](table: *SecretTable[T], g: Geometry) bool {
    if (table == nil) { ret false; }
    table.geometry            = g;
    table.allocator           = secret.system_array_allocator[T]();
    table.directory_allocator = secret.system_array_allocator[secret.SecretArray[T]]();
    table.directory           = secret.empty_array[secret.SecretArray[T]]();
    table.spent               = secret.empty_array[secret.SecretArray[T]]();
    table.entries             = 0;
    ret true;
}

# a standalone secret table drives its own index space. it takes a plain allocator
# for the slab's link storage; the welded records use crypto.secret's own allocator
pub fun make_secret_table[T](table: *SecretTable[T], a: *A.Allocator) bool {
    if (table == nil || a == nil) { ret false; }
    val g: Geometry = geometry($size_of(T));
    init_secret_table[T](table, g);
    ret slab_make[SecretTable[T]](?table.slab, a, g, table, secret_grow_hook[T],
        secret_release_hook[T]);
}

pub fun secret_table_capacity[T](table: *SecretTable[T]) usize {
    if (table == nil) { ret 0; }
    ret table.slab.capacity;
}

# claim the lowest free index, growing the index space; NO_INDEX only when a
# storage or a link allocation refuses
pub fun secret_table_claim[T](table: *SecretTable[T]) usize {
    if (table == nil) { ret NO_INDEX; }
    ret slab_claim[SecretTable[T], Unit](?table.slab);
}

pub fun secret_table_release[T](table: *SecretTable[T], index: usize) bool {
    if (table == nil) { ret false; }
    ret slab_release[SecretTable[T], Unit](?table.slab, index);
}

# a record by index, bounded by an explicit capacity so a session table sharing the
# channel table's slab reads that slab's capacity, not its unused embedded slab
pub fun secret_record[T](table: *SecretTable[T], index: usize, capacity: usize) *T {
    if (table == nil || index >= capacity) { ret nil; }
    val chunk: usize                  = chunk_of(table.geometry, index);
    val array: *secret.SecretArray[T] = secret_chunk[T](table, chunk);
    if (array == nil) { ret nil; }
    val data: *T = secret.array_data[T](array);
    if (data == nil) { ret nil; }
    ret ?data[index - chunk_start(table.geometry, chunk)];
}

pub fun secret_table_at[T](table: *SecretTable[T], index: usize) *T {
    if (table == nil) { ret nil; }
    ret secret_record[T](table, index, table.slab.capacity);
}

# unweld every chunk this storage holds, then the directory. a chunk that fails to
# destroy stays owned so a later call retries it rather than abandoning wiped secret
# memory, and the directory that names it stays with it. leaves the slab alone, so
# a shared-slab owner frees the records without touching a slab it does not own
pub fun free_secret_chunks[T](table: *SecretTable[T]) bool {
    if (table == nil) { ret false; }
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < table.entries) {
        val chunk: *secret.SecretArray[T] = secret_chunk[T](table, i);
        if (chunk != nil && secret.destroy_array[T](chunk) != contracts.OK) { ok = false; }
        i = i + 1;
    }
    if (!secret_retire_spent[T](table)) { ok = false; }
    if (ok && table.entries != 0) {
        if (secret.destroy_array[secret.SecretArray[T]](?table.directory) == contracts.OK) {
            table.directory = secret.empty_array[secret.SecretArray[T]]();
            table.entries   = 0;
        }
        or { ok = false; }
    }
    ret ok;
}

pub fun destroy_secret_table[T](table: *SecretTable[T]) bool {
    if (table == nil) { ret false; }
    var ok: bool = free_secret_chunks[T](table);
    if (!slab_destroy[SecretTable[T], Unit](?table.slab)) { ok = false; }
    ret ok;
}

pub fun secret_table_cleanup_pending[T](table: *SecretTable[T]) bool {
    if (table == nil)                                                      { ret false; }
    if (secret.array_cleanup_pending[secret.SecretArray[T]](?table.spent)) { ret true; }
    var i: usize = 0;
    for (i < table.entries) {
        if (secret.array_cleanup_pending[T](secret_chunk[T](table, i))) { ret true; }
        i = i + 1;
    }
    ret false;
}

# --- paired storages: a plain table and a secret table on one shared slab ---
#
# the channel/session pair in secure. both draw on one index space and grow and
# compact in lockstep, so channel index i and session index i are always both live
# or both free, and one geometry, derived from the wider record, shapes both. the
# slab lives with the caller (a module in secure); the two tables are its storages
# and hold only their record chunks.
pub fun make_paired[T1, T2](slab: *Slab[Table[T1], SecretTable[T2]],
    channels: *Table[T1], sessions: *SecretTable[T2], a: *A.Allocator) bool {
    if (slab == nil || channels == nil || sessions == nil || a == nil) { ret false; }
    var widest: usize = $size_of(T1);
    if ($size_of(T2) > widest) { widest = $size_of(T2); }
    val g: Geometry = geometry(widest);
    if (!init_table[T1](channels, a, g) || !init_secret_table[T2](sessions, g)) { ret false; }
    ret slab_make_paired[Table[T1], SecretTable[T2]](slab, a, g,
        channels, table_grow_hook[T1], table_release_hook[T1],
        sessions, secret_grow_hook[T2], secret_release_hook[T2]);
}

# free both tables' record chunks and the shared slab
pub fun destroy_paired[T1, T2](slab: *Slab[Table[T1], SecretTable[T2]],
    channels: *Table[T1], sessions: *SecretTable[T2]) bool {
    var ok: bool = true;
    if (!free_table_chunks[T1](channels))                { ok = false; }
    if (!free_secret_chunks[T2](sessions))               { ok = false; }
    if (!slab_destroy[Table[T1], SecretTable[T2]](slab)) { ok = false; }
    ret ok;
}

# claim one shared index across both storages
pub fun paired_claim[T1, T2](slab: *Slab[Table[T1], SecretTable[T2]]) usize {
    if (slab == nil) { ret NO_INDEX; }
    ret slab_claim[Table[T1], SecretTable[T2]](slab);
}

pub fun paired_release[T1, T2](slab: *Slab[Table[T1], SecretTable[T2]],
    index: usize) bool {
    if (slab == nil) { ret false; }
    ret slab_release[Table[T1], SecretTable[T2]](slab, index);
}

rec Probe {
    value: u64;
    bytes: [64]u8;
}

test "storage: a released claim is reused and never moves while held" {
    var a: A.Allocator;
    page.make(?a);
    var recycler: Recycler[Probe];
    if (!make[Probe](?recycler, ?a, 1)) { ret 1; }
    val first:  *Probe = claim[Probe](?recycler);
    val second: *Probe = claim[Probe](?recycler);
    if (first == nil || second == nil || first == second) { ret 2; }
    first.value = 7;
    if (held[Probe](?recycler) != 2)        { ret 3; }
    if (!release[Probe](?recycler, second)) { ret 4; }
    val third: *Probe = claim[Probe](?recycler);
    if (third != second || first.value != 7)                                    { ret 5; }
    if (destroy[Probe](?recycler))                                              { ret 6; }
    if (!release[Probe](?recycler, first) || !release[Probe](?recycler, third)) { ret 7; }
    if (release[Probe](?recycler, first))                                       { ret 8; }
    if (!destroy[Probe](?recycler))                                             { ret 9; }
    ret 0;
}

test "storage: a claim spans count records" {
    var a: A.Allocator;
    page.make(?a);
    var recycler: Recycler[u8];
    if (!make[u8](?recycler, ?a, 32768)) { ret 1; }
    val buffer: *u8 = claim[u8](?recycler);
    if (buffer == nil) { ret 2; }
    buffer[32767] = 1;
    if (!release[u8](?recycler, buffer) || !destroy[u8](?recycler)) { ret 3; }
    ret 0;
}

test "storage: a table grows by chunks and never moves a record" {
    var a: A.Allocator;
    page.make(?a);
    var table: Table[Probe];
    if (!make_table[Probe](?table, ?a) || table_at[Probe](?table, 0) != nil)        { ret 1; }
    if (!grow_table[Probe](?table) || table_capacity[Probe](?table) != FIRST_CHUNK) { ret 2; }
    val first: *Probe = table_at[Probe](?table, 0);
    val last:  *Probe = table_at[Probe](?table, FIRST_CHUNK - 1);
    if (first == nil || last == nil || first.value != 0 || table_at[Probe](?table, FIRST_CHUNK) != nil) { ret 3; }
    first.value = 11;
    last.value  = 12;
    if (!grow_table[Probe](?table) || !grow_table[Probe](?table))                     { ret 4; }
    if (table_capacity[Probe](?table) != FIRST_CHUNK * 7)                             { ret 5; }
    if (table_at[Probe](?table, 0) != first || first.value != 11 || last.value != 12) { ret 6; }
    # the first record of the third chunk sits at the start of its chunk
    if (table_at[Probe](?table, FIRST_CHUNK * 3) != ?table.chunks[2][0]
        || table_at[Probe](?table, FIRST_CHUNK * 7 - 1) != ?table.chunks[2][FIRST_CHUNK * 4 - 1]) { ret 7; }
    if (!destroy_table[Probe](?table) || table_capacity[Probe](?table) != 0) { ret 8; }
    ret 0;
}

# a secret record is plain data: the welded, wiped-on-release memory is what
# is secret, so its fields are not `^`-typed, like every secret record in hedge
rec SecretProbe {
    key:   [8]u8;
    index: usize;
}

test "storage: a secret table claims, holds live records still, and compacts" {
    var a: A.Allocator;
    page.make(?a);
    var table: SecretTable[SecretProbe];
    if (!make_secret_table[SecretProbe](?table, ?a)
        || secret_table_capacity[SecretProbe](?table) != 0
        || secret_table_at[SecretProbe](?table, 0) != nil) { ret 1; }
    # every claim welds on demand and hands back the lowest free index
    var i: usize = 0;
    for (i < 60) {
        if (secret_table_claim[SecretProbe](?table) != i) { ret 2; }
        i = i + 1;
    }
    if (secret_table_capacity[SecretProbe](?table) < 60) { ret 3; }
    val anchor: *SecretProbe = secret_table_at[SecretProbe](?table, 0);
    if (anchor == nil || anchor.index != 0) { ret 4; }
    anchor.index  = 7;
    anchor.key[0] = 9;
    # releasing every trailing index recedes whole welded chunks; index 0 stays
    # live and pins its own chunk, so its record never moves
    i = 60;
    for (i > 1) {
        i = i - 1;
        if (!secret_table_release[SecretProbe](?table, i)) { ret 5; }
    }
    if (secret_table_at[SecretProbe](?table, 0) != anchor || anchor.index != 7
        || secret_table_capacity[SecretProbe](?table) != FIRST_CHUNK) { ret 6; }
    if (!secret_table_release[SecretProbe](?table, 0)
        || secret_table_capacity[SecretProbe](?table) != 0
        || secret_table_at[SecretProbe](?table, 0) != nil) { ret 7; }
    if (!destroy_secret_table[SecretProbe](?table)) { ret 8; }
    ret 0;
}

test "storage: chunks round up to a class and are reused within it" {
    var a: A.Allocator;
    page.make(?a);
    var chunks: Chunks;
    if (!make_chunks(?chunks, ?a)) { ret 1; }
    if (chunk_class_size(1) != MIN_CHUNK || chunk_class_size(MIN_CHUNK + 1) != MIN_CHUNK * 2
        || chunk_class_size(MIN_CHUNK << CHUNK_CLASSES) != 0) { ret 2; }
    val small: *u8 = claim_chunk(?chunks, MIN_CHUNK);
    val large: *u8 = claim_chunk(?chunks, MIN_CHUNK * 4);
    if (small == nil || large == nil || claim_chunk(?chunks, MIN_CHUNK + 1) != nil) { ret 3; }
    large[MIN_CHUNK * 4 - 1] = 1;
    if (!release_chunk(?chunks, small, MIN_CHUNK)) { ret 4; }
    if (claim_chunk(?chunks, MIN_CHUNK) != small)  { ret 5; }
    if (destroy_chunks(?chunks))                   { ret 6; }
    if (!release_chunk(?chunks, small, MIN_CHUNK) || !release_chunk(?chunks, large, MIN_CHUNK * 4)
        || !destroy_chunks(?chunks)) { ret 7; }
    ret 0;
}

# a pseudo-random sequence for the churn test
fun lcg(state: *u64) usize {
    @state = @state * 6364136223846793005 + 1442695040888963407;
    ret (@state >> 33)::usize;
}

test "storage: a table releases trailing chunks as records recede" {
    var a: A.Allocator;
    page.make(?a);
    var table: Table[Probe];
    if (!make_table[Probe](?table, ?a)) { ret 1; }
    var claimed: [2000]usize;
    var i:       usize = 0;
    for (i < 2000) {
        val idx: usize = table_claim[Probe](?table);
        if (idx == NO_INDEX) { ret 2; }
        claimed[i] = idx;
        i          = i + 1;
    }
    if (table_live[Probe](?table) != 2000) { ret 3; }
    val full_count: usize = table_chunks[Probe](?table);
    if (full_count < 7) { ret 4; }
    # a low, still-live record and its content must survive the recede
    val kept: *Probe = table_at[Probe](?table, claimed[100]);
    if (kept == nil) { ret 5; }
    kept.value = 43981;
    # release the high 1800, keep the low 200
    i = 200;
    for (i < 2000) {
        if (!table_release[Probe](?table, claimed[i])) { ret 6; }
        i = i + 1;
    }
    if (table_live[Probe](?table) != 200) { ret 7; }
    # the table now holds chunks proportional to 200 live, not 2000
    if (table_chunks[Probe](?table) >= full_count) { ret 8; }
    if (table_chunks[Probe](?table) != 4)          { ret 9; }
    # the surviving low record never moved and kept its content
    if (table_at[Probe](?table, claimed[100]) != kept || kept.value != 43981) { ret 10; }
    # claim back to 2000: no still-live pointer was invalidated by the recede
    i = 0;
    for (i < 1800) {
        if (table_claim[Probe](?table) == NO_INDEX) { ret 11; }
        i = i + 1;
    }
    if (table_at[Probe](?table, claimed[100]) != kept || kept.value != 43981) { ret 12; }
    if (!destroy_table[Probe](?table))                                        { ret 13; }
    ret 0;
}

test "storage: a released index in a compacted-away chunk is never handed out" {
    var a: A.Allocator;
    page.make(?a);
    var table: Table[Probe];
    if (!make_table[Probe](?table, ?a)) { ret 1; }
    # fill two chunks: chunk 0 is 0..15, chunk 1 is 16..47
    var i: usize = 0;
    for (i < 48) {
        if (table_claim[Probe](?table) == NO_INDEX) { ret 2; }
        i = i + 1;
    }
    if (table_chunks[Probe](?table) != 2 || table_capacity[Probe](?table) != 48) { ret 3; }
    # release all of chunk 1, which compacts it away
    i = 16;
    for (i < 48) {
        if (!table_release[Probe](?table, i)) { ret 4; }
        i = i + 1;
    }
    if (table_chunks[Probe](?table) != 1 || table_capacity[Probe](?table) != 16) { ret 5; }
    # an index in the gone chunk is out of range, not a live record
    if (table_at[Probe](?table, 20) != nil) { ret 6; }
    # claim a batch: every claim is valid and unique, never a dead index popped
    # from the discarded free stack of the gone chunk
    if (!table_release[Probe](?table, 3) || !table_release[Probe](?table, 7)) { ret 7; }
    var seen: [64]bool;
    i = 0;
    for (i < 40) {
        val idx: usize = table_claim[Probe](?table);
        if (idx == NO_INDEX)                     { ret 8; }
        if (table_at[Probe](?table, idx) == nil) { ret 9; }
        if (idx < 64 && seen[idx])               { ret 10; }
        if (idx < 64)                            { seen[idx] = true; }
        i = i + 1;
    }
    if (!destroy_table[Probe](?table)) { ret 11; }
    ret 0;
}

test "storage: churn packs live records low and the table converges to live size" {
    var a: A.Allocator;
    page.make(?a);
    var table: Table[Probe];
    if (!make_table[Probe](?table, ?a)) { ret 1; }
    var live_idx: [2000]usize;
    var live_n:   usize = 0;
    var i:        usize = 0;
    for (i < 2000) {
        val idx: usize = table_claim[Probe](?table);
        if (idx == NO_INDEX) { ret 2; }
        live_idx[live_n] = idx;
        live_n           = live_n + 1;
        i                = i + 1;
    }
    val full_count: usize = table_chunks[Probe](?table);
    # release 1800 chosen pseudo-randomly, keeping 200 live
    var state: u64 = 19088743;
    for (live_n > 200) {
        val pick: usize = lcg(?state) % live_n;
        if (!table_release[Probe](?table, live_idx[pick])) { ret 3; }
        live_idx[pick] = live_idx[live_n - 1];
        live_n         = live_n - 1;
    }
    if (table_live[Probe](?table) != 200) { ret 4; }
    # churn one-in one-out uniformly; the table converges to chunks proportional
    # to 200 live (4 chunks, plus at most one boundary chunk) within bounded cycles
    var cycles: usize = 0;
    for (cycles < 100000) {
        val pick: usize = lcg(?state) % live_n;
        if (!table_release[Probe](?table, live_idx[pick])) { ret 5; }
        val idx: usize = table_claim[Probe](?table);
        if (idx == NO_INDEX) { ret 6; }
        live_idx[pick] = idx;
        if (table_chunks[Probe](?table) <= 5) { brk; }
        cycles = cycles + 1;
    }
    if (table_chunks[Probe](?table) > 5)           { ret 7; }
    if (table_chunks[Probe](?table) >= full_count) { ret 8; }
    i = 0;
    for (i < live_n) {
        table_release[Probe](?table, live_idx[i]);
        i = i + 1;
    }
    if (!destroy_table[Probe](?table)) { ret 9; }
    ret 0;
}

# a record wide enough that the doubling series is short (bound 32, K = 1), so
# the uniform region and directory growth are reached in a few MiB
rec WideProbe {
    value: u64;
    bytes: [65528]u8;
}

# a record wider than CHUNK_BYTES / FIRST_CHUNK has no doubling series at all
rec HugeProbe {
    bytes: [131080]u8;
}

test "storage: geometry bounds a chunk by CHUNK_BYTES and never below FIRST_CHUNK" {
    val probe: Geometry = geometry($size_of(Probe));
    if (probe.bound_chunk != 10 || chunk_records(probe, 10) != 16384
        || chunk_records(probe, 11) != 16384 || chunk_records(probe, 9) != 8192) { ret 1; }
    val wide: Geometry = geometry($size_of(WideProbe));
    if (wide.bound_chunk != 1 || chunk_records(wide, 0) != 16 || chunk_records(wide, 1) != 32
        || chunk_records(wide, 40) != 32) { ret 2; }
    val huge: Geometry = geometry($size_of(HugeProbe));
    if (huge.bound_chunk != 0 || chunk_records(huge, 0) != 16 || chunk_records(huge, 7) != 16
        || chunk_start(huge, 3) != 48 || chunk_of(huge, 47) != 2) { ret 3; }
    # every chunk's first and last index map back to it, in and past the series
    var k: usize = 0;
    for (k < 40) {
        val start: usize = chunk_start(wide, k);
        val last:  usize = start + chunk_records(wide, k) - 1;
        if (chunk_of(wide, start) != k || chunk_of(wide, last) != k) { ret 4; }
        if (k > 0 && chunk_of(wide, start - 1) != k - 1)             { ret 5; }
        if (chunk_of(probe, chunk_start(probe, k)) != k)             { ret 6; }
        k = k + 1;
    }
    if (chunk_start(wide, 2) != 48 || chunk_start(wide, 3) != 80) { ret 7; }
    ret 0;
}

test "storage: records past the bound sit in uniform chunks and never move" {
    var a: A.Allocator;
    page.make(?a);
    var table: Table[WideProbe];
    if (!make_table[WideProbe](?table, ?a)) { ret 1; }
    var i: usize = 0;
    for (i < 48 + 32 * 5 + 4) {
        if (table_claim[WideProbe](?table) != i) { ret 2; }
        i = i + 1;
    }
    if (table_chunks[WideProbe](?table) != 8 || table_capacity[WideProbe](?table) != 48 + 32 * 6) { ret 3; }
    # the last index of the bound chunk, the first past it, and one deep in the region
    if (table_at[WideProbe](?table, 47) != ?table.chunks[1][31]
        || table_at[WideProbe](?table, 48) != ?table.chunks[2][0]
        || table_at[WideProbe](?table, 48 + 32 * 5 + 3) != ?table.chunks[7][3]) { ret 4; }
    val kept: *WideProbe = table_at[WideProbe](?table, 48 + 32 * 5 + 3);
    kept.value = 77;
    # releasing the record above the kept one recedes nothing; releasing the kept
    # one recedes the trailing chunk and the pointer below still holds
    val below: *WideProbe = table_at[WideProbe](?table, 48 + 32 * 4 + 31);
    if (!table_release[WideProbe](?table, 48 + 32 * 5 + 3)) { ret 5; }
    if (table_chunks[WideProbe](?table) != 8)               { ret 6; }
    i = 48 + 32 * 5;
    for (i < 48 + 32 * 5 + 3) {
        if (!table_release[WideProbe](?table, i)) { ret 7; }
        i = i + 1;
    }
    if (table_chunks[WideProbe](?table) != 7 || table_at[WideProbe](?table, 48 + 32 * 4 + 31) != below) { ret 8; }
    if (!destroy_table[WideProbe](?table))                                                              { ret 9; }
    ret 0;
}

test "storage: a table's directory grows past DIRECTORY_FIRST and recedes back through it" {
    var a: A.Allocator;
    page.make(?a);
    var table: Table[WideProbe];
    if (!make_table[WideProbe](?table, ?a)) { ret 1; }
    val total: usize = 48 + 32 * (DIRECTORY_FIRST - 2);
    var i:     usize = 0;
    for (i < total) {
        if (table_claim[WideProbe](?table) != i) { ret 2; }
        i = i + 1;
    }
    if (table_chunks[WideProbe](?table) != DIRECTORY_FIRST || table.directory != DIRECTORY_FIRST) { ret 3; }
    val anchor: *WideProbe = table_at[WideProbe](?table, 100);
    anchor.value = 5;
    # the next claim opens chunk DIRECTORY_FIRST, which widens the directory
    if (table_claim[WideProbe](?table) != total || table.directory != DIRECTORY_FIRST * 2
        || table_chunks[WideProbe](?table) != DIRECTORY_FIRST + 1) { ret 4; }
    if (table_at[WideProbe](?table, total) != ?table.chunks[DIRECTORY_FIRST][0]
        || table_at[WideProbe](?table, 100) != anchor || anchor.value != 5) { ret 5; }
    # release everything from the top: chunks recede across the old directory edge
    i = total + 1;
    for (i > 0) {
        i = i - 1;
        if (!table_release[WideProbe](?table, i)) { ret 6; }
    }
    if (table_chunks[WideProbe](?table) != 0 || table_capacity[WideProbe](?table) != 0) { ret 7; }
    # and the widened directory serves a second climb
    i = 0;
    for (i <= total) {
        if (table_claim[WideProbe](?table) != i) { ret 8; }
        i = i + 1;
    }
    if (table_chunks[WideProbe](?table) != DIRECTORY_FIRST + 1) { ret 9; }
    if (!destroy_table[WideProbe](?table))                      { ret 10; }
    ret 0;
}

test "storage: a secret table's welded directory grows past DIRECTORY_FIRST" {
    var a: A.Allocator;
    page.make(?a);
    var table: SecretTable[HugeProbe];
    if (!make_secret_table[HugeProbe](?table, ?a)) { ret 1; }
    val total: usize = FIRST_CHUNK * DIRECTORY_FIRST;
    var i:     usize = 0;
    for (i < total) {
        if (secret_table_claim[HugeProbe](?table) != i) { ret 2; }
        i = i + 1;
    }
    if (table.entries != DIRECTORY_FIRST || table.slab.count != DIRECTORY_FIRST) { ret 3; }
    val anchor: *HugeProbe = secret_table_at[HugeProbe](?table, 17);
    if (anchor == nil || anchor.bytes[0] != 0) { ret 4; }
    anchor.bytes[0] = 9;
    if (secret_table_claim[HugeProbe](?table) != total || table.entries != DIRECTORY_FIRST * 2
        || table.slab.count != DIRECTORY_FIRST + 1) { ret 5; }
    val top: *HugeProbe = secret_table_at[HugeProbe](?table, total);
    if (top == nil || top.bytes[0] != 0 || secret_table_at[HugeProbe](?table, 17) != anchor
        || anchor.bytes[0] != 9 || secret_table_cleanup_pending[HugeProbe](?table)) { ret 6; }
    i = total + 1;
    for (i > 0) {
        i = i - 1;
        if (!secret_table_release[HugeProbe](?table, i)) { ret 7; }
    }
    if (secret_table_capacity[HugeProbe](?table) != 0 || secret_table_at[HugeProbe](?table, 0) != nil) { ret 8; }
    if (!destroy_secret_table[HugeProbe](?table) || table.entries != 0)                                { ret 9; }
    ret 0;
}

test "storage: a paired slab takes one geometry from its wider record" {
    var a: A.Allocator;
    page.make(?a);
    var slab:     Slab[Table[Probe], SecretTable[WideProbe]];
    var channels: Table[Probe];
    var sessions: SecretTable[WideProbe];
    if (!make_paired[Probe, WideProbe](?slab, ?channels, ?sessions, ?a)) { ret 1; }
    if (slab.geometry.bound_chunk != 1 || channels.geometry.bound_chunk != 1
        || sessions.geometry.bound_chunk != 1) { ret 2; }
    val total: usize = 48 + 32 * DIRECTORY_FIRST;
    var i:     usize = 0;
    for (i < total) {
        if (paired_claim[Probe, WideProbe](?slab) != i) { ret 3; }
        i = i + 1;
    }
    # both storages address the same index through the same chunk shape
    val channel: *Probe     = table_record[Probe](?channels, total - 1, slab.capacity);
    val session: *WideProbe = secret_record[WideProbe](?sessions, total - 1, slab.capacity);
    if (channel == nil || session == nil || channel != ?channels.chunks[DIRECTORY_FIRST + 1][31]) { ret 4; }
    if (channels.directory != DIRECTORY_FIRST * 2 || sessions.entries != DIRECTORY_FIRST * 2)     { ret 5; }
    session.value = 3;
    channel.value = 4;
    i             = total;
    for (i > 48) {
        i = i - 1;
        if (!paired_release[Probe, WideProbe](?slab, i)) { ret 6; }
    }
    if (slab.count != 2 || slab.capacity != 48)                         { ret 7; }
    if (!destroy_paired[Probe, WideProbe](?slab, ?channels, ?sessions)) { ret 8; }
    ret 0;
}

# the chunk of an index is computed, not scanned: in the doubling series, at the
# bound and through the uniform region, every chunk boundary maps to its own chunk
# and the index before it to the one below (#182)
test "storage: chunk_of is exact at every boundary" {
    val shapes: [3]Geometry = [3]Geometry{
        geometry($size_of(Probe)),
        geometry($size_of(WideProbe)),
        geometry($size_of(HugeProbe)),
    };
    var s: usize = 0;
    for (s < 3) {
        val g: Geometry = shapes[s];
        var k: usize = 0;
        for (k < g.bound_chunk + 40) {
            val start: usize = chunk_start(g, k);
            val end:   usize = chunk_start(g, k + 1);
            if (end - start != chunk_records(g, k)) { ret 1; }
            if (chunk_of(g, start) != k)            { ret 2; }
            if (chunk_of(g, start + 1) != k)        { ret 3; }
            if (chunk_of(g, end - 1) != k)          { ret 4; }
            if (chunk_of(g, end) != k + 1)          { ret 5; }
            k = k + 1;
        }
        if (chunk_of(g, 0) != 0 || chunk_of(g, FIRST_CHUNK - 1) != 0
            || chunk_of(g, FIRST_CHUNK) != 1) { ret 6; }
        s = s + 1;
    }
    ret 0;
}
