# the request-lane budget must fund the concurrency hedge advertises
#
# the derivation in config.lanes sizes a connection's request lane at
# max_pipeline_depth times the largest per-stream footprint. this drives real
# accounts through the real pool to prove the claim end to end: under the derived
# budget every concurrent HTTP/3 request borrows its full footprint, and under
# the old HTTP/1-sized budget the last one is refused. borrowing the whole
# footprint (this session's RequestStorage plus the engine's per-request chunks)
# is what the free_request unit test cannot show, since that draws only the
# RequestStorage chunk and would fit the old lane.

use hedge.config.lanes;
use hedge.config.schema;
use hedge_memory: hedge.memory;
use h3:           hedge.protocol.h3.session;
use A:            std.allocator;
use std.allocator.page;
use std.memory.buffers;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

# borrow one full HTTP/3 request footprint from the account. on a partial failure
# it releases what it took, so the lane is left as it was found.
fun borrow_request_set(source: *buffers.Source, account: *buffers.Account,
    out: *buffers.Chunk) bool {
    var reqs: [h3.REQUEST_FOOTPRINT_CHUNKS]buffers.Request;
    h3.request_footprint(?reqs[0]);
    var i: usize = 0;
    for (i < h3.REQUEST_FOOTPRINT_CHUNKS) {
        val got: buffers.Acquired = buffers.source_acquire(source, account, reqs[i], false);
        if (!(sel got.status.ok)) {
            var j: usize = 0;
            for (j < i) {
                buffers.source_release(source, account, out[j]);
                j = j + 1;
            }
            ret false;
        }
        out[i] = got.chunk;
        i      = i + 1;
    }
    ret true;
}

fun release_request_set(source: *buffers.Source, account: *buffers.Account,
    chunks: *buffers.Chunk) {
    var i: usize = 0;
    for (i < h3.REQUEST_FOOTPRINT_CHUNKS) {
        buffers.source_release(source, account, chunks[i]);
        i = i + 1;
    }
}

# open an account whose request lane holds exactly `request_budget` bytes, borrow
# `sets` full HTTP/3 request footprints, and report whether they all fit and
# whether the last one fit. the account and pool are torn down before returning.
fun run_concurrency(request_budget: usize, sets: usize,
    out_all_ok: *bool, out_last_ok: *bool) bool {
    var pages: A.Allocator;
    page.make(?pages);
    var pool: hedge_memory.Memory;
    if (!hedge_memory.make(?pool, 4194304, ?pages)) { ret false; }
    var lender:  hedge_memory.Borrower;
    var account: buffers.Account;
    hedge_memory.borrower(?lender, ?pool, 1, 0,
        hedge_memory.connection_budgets(request_budget, 0, 0, 0, 0, 0));
    if (!hedge_memory.open(?lender, ?account)) {
        hedge_memory.destroy(?pool);
        ret false;
    }
    var source: buffers.Source = hedge_memory.borrowed_source(?lender);

    var chunks:  [h3.MAX_STREAMS][h3.REQUEST_FOOTPRINT_CHUNKS]buffers.Chunk;
    var taken:   [h3.MAX_STREAMS]bool;
    var all_ok:  bool  = true;
    var last_ok: bool  = false;
    var k:       usize = 0;
    for (k < sets) {
        val ok: bool = borrow_request_set(?source, ?account, ?chunks[k][0]);
        taken[k] = ok;
        last_ok  = ok;
        if (!ok) { all_ok = false; }
        k = k + 1;
    }
    @out_all_ok  = all_ok;
    @out_last_ok = last_ok;

    k = 0;
    for (k < sets) {
        if (taken[k]) { release_request_set(?source, ?account, ?chunks[k][0]); }
        k = k + 1;
    }
    if (!hedge_memory.close(?pool, ?account)) {
        hedge_memory.destroy(?pool);
        ret false;
    }
    if (!hedge_memory.destroy(?pool)) { ret false; }
    ret true;
}

test "budget: the derived request lane funds every concurrent HTTP/3 request; the old lane does not" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    val depth: usize = graph.limits.max_pipeline_depth;
    val per:   usize = h3.set_bytes();
    val h1:    usize = lanes.h1_set_bytes(?graph.limits);
    if (depth == 0) { ret 1; }
    # the precondition of the bug: one HTTP/3 request outweighs the old
    # HTTP/1-sized per-stream budget, so a lane sized for depth HTTP/1 sets
    # cannot hold depth HTTP/3 sets
    if (per <= h1) { ret 2; }

    var all_ok:  bool = false;
    var last_ok: bool = false;
    # the derived request lane funds every concurrent request
    if (!run_concurrency(depth * per, depth, ?all_ok, ?last_ok)) { ret 3; }
    if (!all_ok)                                                 { ret 4; }
    # the old HTTP/1-sized request lane refuses the last one, exactly the
    # advertise-then-reject the derivation removes
    if (!run_concurrency(depth * h1, depth, ?all_ok, ?last_ok)) { ret 5; }
    if (all_ok)                                                 { ret 6; }
    if (last_ok)                                                { ret 7; }
    ret 0;
}
