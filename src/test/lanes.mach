# the configurations the shell lanes start hedge with
#
# those lanes do not run on every pull request, so a configuration the loader
# has stopped accepting would only show as a lane that ends early. every one is
# built and validated here instead, with the capabilities the executable has.

use hedge.config.loader;
use hedge.config.schema;
use std.allocator;
use std.allocator.fixed;
use std.filesystem;
use io_error: std.io.error;
use std.io.file;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

val LANE_CONFIGS: [8]str = [8]str{
    "test/interop/hedge.toml",
    "test/interop/no-default.toml",
    "test/interop/cache-disabled.toml",
    "test/interop/cache-enabled.toml",
    "test/interop/reload.toml",
    "test/interop/shutdown.toml",
    "test/interop/telemetry.toml",
    "test/cache/hedge.toml",
};

# every variable a lane sets is present, with a placeholder value
fun lane_environment(context: ptr, name: str, output: *u8, capacity: usize) i64 {
    val value: str   = "lane";
    val n:     usize = str_len(value);
    if (capacity > n) {
        var i: usize = 0;
        for (i < n) {
            output[i] = value[i];
            i         = i + 1;
        }
        output[n] = 0;
    }
    ret n::i64;
}

# the whole file, or zero when it is missing, empty or too large
fun read_config(path: str, output: *u8, capacity: usize) usize {
    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { ret 0; }
    var handle: filesystem.File            = opened.ok;
    val read:   res[usize, io_error.Error] = file.read_at(handle, output, capacity, 0);
    filesystem.close(?handle);
    if (sel read.err)        { ret 0; }
    if (read.ok >= capacity) { ret 0; }
    output[read.ok] = 0;
    ret read.ok;
}

# the same capabilities the executable builds with
fun executable_capabilities() loader.Capabilities {
    ret loader.Capabilities{
        quic:                true,
        local_transport:     true,
        environment_secrets: true,
        file_secrets:        true,
        os_secrets:          false,
        application_secrets: false,
    };
}

var lane_memory: [4194304]u8;
var lane_source: [loader.MAX_SOURCE_BYTES]u8;
var lane_graph:  schema.Graph;
var lane_report: schema.Diagnostics;

test "lanes: every checked-in lane configuration is accepted" {
    var i: usize = 0;
    for (i < 8) {
        val length: usize = read_config(LANE_CONFIGS[i], ?lane_source[0], loader.MAX_SOURCE_BYTES);
        if (length == 0) { ret (10 + i)::i32; }
        var state: fixed.FixedState;
        var a:     allocator.Allocator;
        fixed.make(?a, ?state, ?lane_memory[0], 4194304);
        var resolver: loader.Resolver = loader.Resolver{
            context:     nil,
            include:     (0::usize)::loader.ResolveFun,
            environment: lane_environment,
        };
        if (!loader.build(?lane_graph, ?lane_report, ?a, LANE_CONFIGS[i],
            (?lane_source[0])::str, ?resolver, executable_capabilities())) {
            ret (20 + i)::i32;
        }
        i = i + 1;
    }
    ret 0;
}
