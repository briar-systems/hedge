# a routed laurel application fixture, and the adapter's boundary tests

use hedge.config.schema;
use hedge.dispatch.call;
use hedge.service;
use hosting: hedge.service.laurel;
use hedge.storage;
use hedge.telemetry.trace;
use hedge_wake: hedge.wake;
use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use http_router: http.router.router;
use laurel.app;
use laurel.context;
use laurel.error;
use laurel.form;
use laurel.handler;
use laurel.lifecycle;
use laurel.middleware;
use laurel.observability;
use laurel.provider;
use laurel.render;
use laurel.router;
use laurel.security;
use heap_allocator: std.allocator;
use std.allocator.page;
use std.chrono.duration;
use std.chrono.time;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

pub rec Probe {
    calls:      usize;
    layers:     usize;
    exits:      usize;
    starts:     usize;
    finishes:   usize;
    errors:     usize;
    mapped:     u16;
    order:      u64;
    file:       [8]u8;
    file_len:   usize;
    route:      [8]u8;
    route_len:  usize;
    status:     u16;
    bytes_in:   u64;
    bytes_out:  u64;
    entries:    usize;
    resumes:    usize;
    work:       usize;
    abandons:   usize;
    settlement: handler.Settlement;
    outcome:    observability.Outcome;
    field_len:  usize;
    value:      [16]u8;
    value_len:  usize;
}

fun probe_start(owner: ptr) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun probe_ready(owner: ptr) lifecycle.Readiness {
    ret lifecycle.READY_NOW;
}

fun probe_drain(owner: ptr, deadline_ns: i64)
    res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun probe_stop(owner: ptr) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun copy_text(source: view.View, output: *u8, capacity: usize) usize {
    var i: usize = 0;
    for (i < source.len && i < capacity) {
        output[i] = source.data[i];
        i         = i + 1;
    }
    ret i;
}

pub fun same_text(value: *u8, length: usize, expected: str) bool {
    var i: usize = 0;
    for (i < length) {
        if (expected[i] == 0 || value[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret expected[length] == 0;
}

# laurel's own request events, so the framework's observability runs alongside
# hedge's rather than either replacing the other
fun probe_event_start(owner: ptr, event: *observability.RequestEvent) {
    val state: *Probe = owner::*Probe;
    state.starts    = state.starts + 1;
    state.route_len = copy_text(observability.event_route_name(event),
        ?state.route[0], 8);
}

fun probe_event_finish(owner: ptr, event: *observability.RequestEvent) {
    val state: *Probe = owner::*Probe;
    state.finishes  = state.finishes + 1;
    state.outcome   = event.outcome;
    state.status    = event.status;
    state.bytes_in  = event.bytes_in;
    state.bytes_out = event.bytes_out;
}

fun probe_event_error(owner: ptr, event: *observability.RequestEvent,
    failure: error.AppError) {
    val state: *Probe = owner::*Probe;
    state.errors  = state.errors + 1;
    state.outcome = event.outcome;
}

fun probe_failure(detail: str) handler.Result {
    ret handler.fail(error.make(error.INTERNAL, 500,
        "internal server error", detail, false));
}

fun probe_respond(request_context: *context.Context,
    code: status.Status) handler.Result {
    if (message.set_status(context.response(request_context), code)
        != message.RESPONSE_OK) {
        ret probe_failure("probe could not set a status");
    }
    ret handler.respond();
}

# the fallback: sets a status through laurel's own context so the response the
# caller reads was produced by the framework, not by this adapter
fun probe_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe = owner::*Probe;
    @state      = nil;
    probe.calls = probe.calls + 1;
    ret probe_respond(request_context, status.ACCEPTED);
}

fun order_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe         = owner::*Probe;
    val id:    *context.Param = context.find_param(request_context, text("id"));
    @state = nil;
    if (id == nil || id.kind != context.PARAM_U64) {
        ret probe_failure("order id was not decoded");
    }
    probe.order = id.unsigned_value;
    ret probe_respond(request_context, status.OK);
}

fun file_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe         = owner::*Probe;
    val rest:  *context.Param = context.find_param(request_context, text("path"));
    @state = nil;
    if (rest == nil || rest.kind != context.PARAM_TEXT) {
        ret probe_failure("wildcard path was not captured");
    }
    probe.file_len = copy_text(rest.value, ?probe.file[0], 8);
    ret probe_respond(request_context, status.OK);
}

# the form handler's per-request state, allocated from the request arena so it
# survives however many suspensions the body takes to arrive
rec FormState {
    decoder: form.UrlEncoded;
    parser:  form.BodyParser;
    fixed:   render.Fixed;
    fields:  [8]form.Field;
    bytes:   [256]u8;
    buffer:  [64]u8;
}

# the decoded value is echoed back, so a caller on a socket reads the proof that
# the fragmented body was assembled by one handler rather than guessed at
fun respond_with_value(request_context: *context.Context, work: *FormState,
    value: view.View) handler.Result {
    val response: *message.Response  = context.response(request_context);
    val bound:    *exchange.Exchange = context.exchange_ref(request_context);
    if (response == nil || bound == nil) {
        ret probe_failure("the request context has no exchange");
    }
    if (message.set_status(response, status.OK) != message.RESPONSE_OK) {
        ret probe_failure("probe could not set a status");
    }
    if (!render.init_fixed(?work.fixed, value, bound.generation, bound.limits,
        ?response.trailers, request_context.scope)) {
        ret probe_failure("fixed response body would not initialize");
    }
    if (message.set_body_reader(response, render.fixed_body(?work.fixed),
        bound.limits) != message.RESPONSE_OK) {
        ret probe_failure("response body was refused");
    }
    ret handler.respond();
}

fun form_limits() form.Limits {
    ret form.Limits{max_bytes: 256, max_fields: 8, max_name_bytes: 32,
        max_value_bytes: 64, max_temporary_bytes: 256};
}

# one pass over whatever the body has so far: a pending read suspends the whole
# chain rather than spinning, and the work below it runs once, when it completes
fun drive_form(probe: *Probe, request_context: *context.Context,
    work: *FormState, first: form.Operation) handler.Result {
    var current: form.Operation = first;
    for {
        if (current.status == form.PENDING)  { ret handler.suspend(current.token); }
        if (current.status == form.COMPLETE) { brk; }
        if (current.status != form.MORE)     { ret handler.fail(current.app_error); }
        current = form.poll_body(?work.parser);
    }
    probe.work      = probe.work + 1;
    probe.field_len = current.form.len;
    if (current.form.len == 0) { ret probe_respond(request_context, status.OK); }
    probe.value_len = copy_text(current.form.fields[0].value, ?probe.value[0], 16);
    ret respond_with_value(request_context, work, current.form.fields[0].value);
}

fun form_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe = owner::*Probe;
    probe.entries = probe.entries + 1;
    val allocated: res[*FormState, heap_allocator.Error] =
        heap_allocator.zallocate[FormState](request_context.alloc, 1);
    if (sel allocated.err) { ret probe_failure("form state allocation failed"); }
    val work: *FormState = allocated.ok;
    @state = work::ptr;
    if (!form.init_urlencoded(?work.decoder, form.Storage{
        fields:        ?work.fields[0], field_capacity: 8, bytes: ?work.bytes[0],
        byte_capacity: 256
    }, form_limits())) {
        ret probe_failure("form decoder would not initialize");
    }
    if (!form.init_body(?work.parser, ?work.decoder,
        context.request(request_context).body, ?work.buffer[0], 64)) {
        ret probe_failure("form body parser would not initialize");
    }
    ret drive_form(probe, request_context, work,
        form.poll_body(?work.parser));
}

fun form_resume(owner: ptr, request_context: *context.Context, state: ptr,
    settlement: handler.Settlement, token: u64) handler.Result {
    val probe: *Probe     = owner::*Probe;
    val work:  *FormState = state::*FormState;
    probe.resumes    = probe.resumes + 1;
    probe.settlement = settlement;
    if (work == nil) { ret probe_failure("form state did not survive"); }
    if (settlement == handler.SETTLE_ABANDONED) {
        probe.abandons = probe.abandons + 1;
        ret handler.respond();
    }
    ret drive_form(probe, request_context, work,
        form.complete_body(?work.parser, token));
}

fun probe_before(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe = owner::*Probe;
    @state       = nil;
    probe.layers = probe.layers + 1;
    ret handler.proceed();
}

fun probe_after(owner: ptr, request_context: *context.Context, state: ptr,
    carried: handler.Result) handler.Result {
    val probe: *Probe = owner::*Probe;
    probe.exits = probe.exits + 1;
    ret carried;
}

fun probe_error(owner: ptr, failure: error.AppError,
    request_context: *context.Context) res[u8, error.RenderFailure] {
    val state: *Probe = owner::*Probe;
    state.mapped = failure.status;
    if (message.set_status(context.response(request_context), failure.status)
        != message.RESPONSE_OK) {
        ret res[u8, error.RenderFailure].err{
            error.render_failure("probe could not render an error")
        };
    }
    ret res[u8, error.RenderFailure].ok{1};
}

# a laurel application with typed and wildcard routes, a fallback, middleware
# and an error mapper, every part of it borrowed from this one record
pub rec Site {
    probe:          Probe;
    parameters:     [2]router.Parameter;
    routes:         [3]router.Route;
    specifications: [3]http_router.Route;
    compiled:       [3]http_router.CompiledRoute;
    segments:       [12]http_router.Segment;
    router:         router.Router;
    layers:         [1]middleware.Middleware;
    middlewares:    middleware.Stack;
    providers:      provider.Set;
    component:      lifecycle.Lifecycle;
    controller:     lifecycle.Controller;
    headers:        security.HeadersPolicy;
    observer:       observability.Observer;
    vocabulary:     observability.Vocabulary;
    application:    app.App;
}

pub fun make_site(site: *Site) bool {
    ret make_site_with_deadline(site, opt[duration.Duration].none{});
}

# the same site with laurel's handler deadline, which the host must enforce
pub fun make_site_with_deadline(site: *Site, handler_timeout: opt[duration.Duration]) bool {
    if (!provider.init(?site.providers, nil, 0, 0, 32)) { ret false; }
    site.component = lifecycle.Lifecycle{ctx: nil, start: probe_start,
        ready: probe_ready, drain: probe_drain, stop: probe_stop};
    if (!lifecycle.init(?site.controller, ?site.component, 1, 1)) { ret false; }
    site.parameters[0] = router.Parameter{name: text("id"), wildcard: false,
        decoder: router.u64_decoder()};
    site.parameters[1] = router.Parameter{name: text("path"), wildcard: true,
        decoder: router.text_decoder()};
    site.routes[0] = router.Route{
        method:  router.exact_method(method.from_kind(method.GET)),
        host:    router.any_host(), path: router.path(text("/orders/:id")),
        name:    "order", parameters: ?site.parameters[0], parameter_len: 1,
        handler: handler.Handler{ctx: ?site.probe, call: order_handler,
            resume: nil}
    };
    site.routes[1] = router.Route{
        method:     router.any_method(), host: router.any_host(),
        path:       router.path(text("/files/*path")), name: "file",
        parameters: ?site.parameters[1], parameter_len: 1,
        handler:    handler.Handler{ctx: ?site.probe, call: file_handler,
            resume: nil}
    };
    # the one route that suspends: its body arrives in pieces, and it is entered
    # once however many pieces that takes
    site.routes[2] = router.Route{
        method:     router.any_method(), host: router.any_host(),
        path:       router.path(text("/submit")), name: "form",
        parameters: nil, parameter_len: 0,
        handler:    handler.Handler{ctx: ?site.probe, call: form_handler,
            resume: form_resume}
    };
    val storage: router.Storage = router.Storage{
        specifications:  ?site.specifications[0], specification_cap: 3,
        compiled_routes: ?site.compiled[0], compiled_route_cap: 3,
        segments:        ?site.segments[0], segment_cap: 12
    };
    if (router.compile(?site.router, ?site.routes[0], 3, storage,
        router.limits_default()).status != router.COMPILE_OK) { ret false; }
    site.layers[0] = middleware.Middleware{ctx: ?site.probe, before: probe_before,
        resume: nil, after: probe_after};
    site.middlewares = middleware.Stack{items: ?site.layers[0], len: 1};
    if (!security.secure_headers(?site.headers)) { ret false; }
    site.observer = observability.Observer{ctx: ?site.probe,
        start: probe_event_start, finish: probe_event_finish,
        error: probe_event_error};
    if (!observability.init_vocabulary(?site.vocabulary, nil, 0)) { ret false; }
    val assembly: app.Assembly = app.Assembly{
        config: app.Config{limits: app.Limits{max_body_bytes: 1024,
            max_form_fields:         8, max_upload_bytes: 1024, max_route_params: 4,
            max_request_id_bytes:    64, max_active_requests: 2,
            max_middleware_depth:    8, handler_timeout: handler_timeout,
            max_providers:           0, max_provider_key_bytes: 32,
            max_background_services: 1}, trust_proxy: false,
            panic_policy:            middleware.PANIC_ABORT},
        router:   ?site.router, middleware: ?site.middlewares,
        fallback: handler.Handler{ctx: ?site.probe, call: probe_handler,
            resume: nil},
        errors:       error.Mapper{ctx: ?site.probe, render: probe_error},
        providers:    ?site.providers, lifecycle: ?site.controller, sessions: nil,
        security:     ?site.headers, csrf: nil, origins: nil, authenticator: nil,
        renderer:     nil, observer: ?site.observer, vocabulary: ?site.vocabulary,
        event_policy: observability.policy_default(), app_state: nil
    };
    ret app.assemble(?site.application, assembly)
        && app.start(?site.application).status == lifecycle.TRANSITION_OK
        && app.poll_ready(?site.application).status == lifecycle.TRANSITION_OK;
}

# a request body that arrives in pieces, each one preceded by a suspension
#
# the reader hands out no bytes until the host completes the token it returned,
# which is exactly what a socket does when the next segment has not landed yet.
pub rec Fragments {
    source:    view.View;
    offset:    usize;
    piece:     usize;
    output:    *u8;
    capacity:  usize;
    token:     u64;
    delivered: usize;
}

fun fragment_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    val state: *Fragments = context::*Fragments;
    if (state.offset >= state.source.len) { ret body.complete(body.REUSE_ALLOWED); }
    state.output   = output;
    state.capacity = capacity;
    state.token    = state.token + 1;
    ret body.pending(state.token);
}

fun fragment_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT)  { ret body.rejected(body.REUSE_FORBIDDEN); }
    ret body.complete(body.REUSE_ALLOWED);
}

fun fragment_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val state: *Fragments = context::*Fragments;
    if (state == nil || token != state.token || state.output == nil) {
        ret body.failed("fragment completion lost its buffer",
            body.REUSE_FORBIDDEN);
    }
    var count: usize = state.piece;
    val left:  usize = state.source.len - state.offset;
    if (count > left)           { count = left; }
    if (count > state.capacity) { count = state.capacity; }
    var i: usize = 0;
    for (i < count) {
        state.output[i] = state.source.data[state.offset + i]::u8;
        i               = i + 1;
    }
    state.offset    = state.offset + count;
    state.output    = nil;
    state.capacity  = 0;
    state.delivered = state.delivered + 1;
    ret body.data(count);
}

fun fragment_release(context: ptr) {}

rec Harness {
    scope:             cancel.Scope;
    reader:            body.Reader;
    request:           message.Request;
    response:          message.Response;
    request_fields:    [4]field.Field;
    request_trailers:  [2]field.Field;
    response_fields:   [8]field.Field;
    response_trailers: [2]field.Field;
    informationals:    [2]message.Informational;
    exchange:          exchange.Exchange;
    heap:              heap_allocator.Allocator;
    chunks:            storage.Chunks;
    memory:            call.Memory;
    telemetry:         trace.Context;
    call:              call.Call;
    wakes:             hedge_wake.Queue;
}

fun text(value: str) view.View {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    ret view.view(value::*char, length);
}

fun make_harness(harness: *Harness, generation: u64, path: str) bool {
    val configured: message.Limits = message.limits_default();
    if (!operation_ok(cancel.make_root(?harness.scope, opt[time.Instant].none{}))) {
        ret false;
    }
    harness.reader = body.empty_reader(generation);
    var fields: field.Fields = field.init(?harness.request_fields[0], 4,
        configured.request_fields);
    if (field.append(?fields, field.Field{name: text("host"),
        value: text("example.test"), sensitive: false}) != field.ADD_OK) {
        ret false;
    }
    val trailers: field.Fields = field.init(?harness.request_trailers[0], 2,
        configured.request_trailers);
    val metadata: message.Metadata = message.Metadata{
        version:     message.version_h1(1, 1), secure: false, early_data: false,
        peer:        message.unspecified_endpoint(),
        local:       message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0}, has_deadline: false,
        deadline:    time.Time{sec: 0, nsec: 0}, request_index: 1
    };
    if (!message.init_request(?harness.request, method.from_kind(method.GET),
        target.origin(text(path), text(path), view.view(nil, 0)),
        metadata, fields, trailers, ?harness.reader, generation,
        configured)) { ret false; }
    if (!message.init_response(?harness.response, ?harness.response_fields[0], 8,
        ?harness.response_trailers[0], 2, generation, configured)) {
        ret false;
    }
    if (!exchange.init(?harness.exchange, ?harness.request, ?harness.response,
        ?harness.informationals[0], 2, ?harness.scope, generation,
        configured)) { ret false; }
    if (!exchange.begin(?harness.exchange)) { ret false; }
    page.make(?harness.heap);
    if (!storage.make_chunks(?harness.chunks, ?harness.heap)
        || !call.make_memory(?harness.memory, ?harness.chunks,
        schema.DEFAULT_CALL_MEMORY_BYTES)) {
        ret false;
    }
    if (!trace.make_root(?harness.telemetry, false)) { ret false; }
    if (!hedge_wake.make(?harness.wakes, ?harness.heap)
        || !call.bind(?harness.call, ?harness.exchange, ?harness.memory,
        ?harness.telemetry, generation, "test", hedge_wake.waker(?harness.wakes, 1))) {
        ret false;
    }
    ret call.enter(?harness.call, call.Route{index: 0, name: "root",
        host: "example.test", service: "site"});
}

# a POST to the suspending route, whose body arrives `piece` bytes at a time
fun make_form_harness(harness: *Harness, fragments: *Fragments, generation: u64,
    text_body: str, piece: usize) bool {
    val configured: message.Limits = message.limits_default();
    if (!operation_ok(cancel.make_root(?harness.scope, opt[time.Instant].none{}))) { ret false; }
    fragments.source    = text(text_body);
    fragments.offset    = 0;
    fragments.piece     = piece;
    fragments.output    = nil;
    fragments.capacity  = 0;
    fragments.token     = 0;
    fragments.delivered = 0;
    harness.reader      = body.init_reader(fragments::ptr, fragment_read,
        fragment_finish, fragment_complete, fragment_release,
        body.OWNER_APPLICATION, generation, true,
        fragments.source.len::u64, configured.request_body, nil,
        ?harness.scope);
    if (!harness.reader.valid) { ret false; }
    var fields: field.Fields = field.init(?harness.request_fields[0], 4,
        configured.request_fields);
    if (field.append(?fields, field.Field{name: text("host"),
        value: text("example.test"), sensitive: false}) != field.ADD_OK
        || field.append(?fields, field.Field{name: text("content-type"),
        value:     text("application/x-www-form-urlencoded"),
        sensitive: false}) != field.ADD_OK) { ret false; }
    val trailers: field.Fields = field.init(?harness.request_trailers[0], 2,
        configured.request_trailers);
    val metadata: message.Metadata = message.Metadata{
        version:     message.version_h1(1, 1), secure: false, early_data: false,
        peer:        message.unspecified_endpoint(),
        local:       message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0}, has_deadline: false,
        deadline:    time.Time{sec: 0, nsec: 0}, request_index: 1
    };
    if (!message.init_request(?harness.request, method.from_kind(method.POST),
        target.origin(text("/submit"), text("/submit"), view.view(nil, 0)),
        metadata, fields, trailers, ?harness.reader, generation,
        configured)) { ret false; }
    if (!message.init_response(?harness.response, ?harness.response_fields[0], 8,
        ?harness.response_trailers[0], 2, generation, configured)) { ret false; }
    if (!exchange.init(?harness.exchange, ?harness.request, ?harness.response,
        ?harness.informationals[0], 2, ?harness.scope, generation,
        configured) || !exchange.begin(?harness.exchange)) { ret false; }
    page.make(?harness.heap);
    if (!storage.make_chunks(?harness.chunks, ?harness.heap)
        || !call.make_memory(?harness.memory, ?harness.chunks,
        schema.DEFAULT_CALL_MEMORY_BYTES)
        || !trace.make_root(?harness.telemetry, false)
        || !hedge_wake.make(?harness.wakes, ?harness.heap)
        || !call.bind(?harness.call, ?harness.exchange, ?harness.memory,
        ?harness.telemetry, generation, "test", hedge_wake.waker(?harness.wakes, 1))) {
        ret false;
    }
    ret call.enter(?harness.call, call.Route{index: 0, name: "root",
        host: "example.test", service: "site"});
}

# the registered adapter, reached exactly as the dispatch table reaches it
fun mount(site: *Site, adapter: *hosting.Adapter,
    registry: *service.Applications, slots: *service.Application)
    *service.Application {
    if (!hosting.make(adapter, ?site.application)
        || !service.make_applications(registry, slots, 1)
        || !service.register_application(registry, "site",
        hosting.bound_handler(adapter), 0)) { ret nil; }
    ret service.find_application(registry, "site");
}

# serves one request through the registered handler and settles the exchange
fun serve_path(found: *service.Application, harness: *Harness, generation: u64,
    path: str) bool {
    ret make_harness(harness, generation, path)
        && found.handler.serve(found.handler.ctx, ?harness.call)
        == exchange.SERVICE_COMPLETE
        && harness.response.committed
        && exchange.finish(?harness.exchange) == exchange.FINISH_OK
        && call.release(?harness.call);
}

test "laurel: a real application serves a request through the hedge boundary" {
    var site: Site;
    if (!make_site(?site)) { ret 1; }
    val probe: *Probe = ?site.probe;

    var adapter: hosting.Adapter;
    if (!hosting.make(?adapter, ?site.application)) { ret 9; }
    val bound: service.Handler = hosting.bound_handler(?adapter);
    if (!service.has_handler(bound)) { ret 10; }

    # registered exactly like any other service kind, through the public table
    var slots:    [1]service.Application;
    var registry: service.Applications;
    if (!service.make_applications(?registry, ?slots[0], 1))        { ret 11; }
    if (!service.register_application(?registry, "site", bound, 0)) { ret 12; }
    val found: *service.Application = service.find_application(?registry, "site");
    if (found == nil) { ret 13; }

    var harness: Harness;
    if (!make_harness(?harness, 21, "/greet")) { ret 14; }
    val served: exchange.ServiceStatus = found.handler.serve(
        found.handler.ctx, ?harness.call);
    if (served != exchange.SERVICE_COMPLETE || !harness.response.committed
        || call.disposition(?harness.call) != call.BODY_DRAIN) { ret 15; }
    if (probe.calls != 1 || probe.layers != 1 || probe.exits != 1
        || probe.starts != 1 || probe.finishes != 0 || probe.errors != 0
        || probe.route_len != 0) {
        ret 16;
    }
    if (harness.response.status != status.ACCEPTED
        || app.active_request_count(?site.application) != 1) { ret 17; }
    if (exchange.finish(?harness.exchange) != exchange.FINISH_OK
        || !call.release(?harness.call)) { ret 18; }
    if (app.active_request_count(?site.application) != 0)         { ret 19; }
    if (probe.finishes != 1 || probe.errors != 0)                 { ret 20; }
    if (probe.status != status.ACCEPTED)                          { ret 21; }
    if (probe.bytes_in != harness.exchange.completion.bytes_in)   { ret 22; }
    if (probe.bytes_out != harness.exchange.completion.bytes_out) { ret 23; }
    if (call.release(?harness.call) || probe.finishes != 1)       { ret 24; }

    # a cancelled call is refused before the application is entered, and leaks
    # no reservation
    var cancelled_harness: Harness;
    if (!make_harness(?cancelled_harness, 22, "/greet"))         { ret 25; }
    if (!transition_ok(cancel.cancel(?cancelled_harness.scope))) { ret 26; }
    if (found.handler.serve(found.handler.ctx, ?cancelled_harness.call) !=
        exchange.SERVICE_FAILED) { ret 27; }
    if (probe.calls != 1 || app.active_request_count(?site.application) != 0) {
        ret 28;
    }

    # cancellation after application execution still runs the deferred release
    var interrupted: Harness;
    if (!make_harness(?interrupted, 23, "/greet")
        || found.handler.serve(found.handler.ctx, ?interrupted.call)
        != exchange.SERVICE_COMPLETE
        || !transition_ok(cancel.cancel(?interrupted.scope))
        || exchange.cancel_exchange(?interrupted.exchange) != exchange.FINISH_OK
        || !call.release(?interrupted.call)) { ret 29; }
    if (probe.calls != 2 || probe.starts != 2 || probe.finishes != 2
        || probe.errors != 0
        || app.active_request_count(?site.application) != 0) {
        ret 30;
    }
    ret 0;
}

test "laurel: the application's router decides every request the adapter serves" {
    var site: Site;
    if (!make_site(?site)) { ret 1; }
    val probe:   *Probe = ?site.probe;
    var adapter: hosting.Adapter;
    if (!hosting.make(?adapter, ?site.application)) { ret 2; }
    var slots:    [1]service.Application;
    var registry: service.Applications;
    if (!service.make_applications(?registry, ?slots[0], 1)
        || !service.register_application(?registry, "site",
        hosting.bound_handler(?adapter), 0)) { ret 3; }
    val found: *service.Application = service.find_application(?registry, "site");
    if (found == nil) { ret 4; }

    # a typed parameter reaches the handler decoded, under laurel's route name
    var order: Harness;
    if (!serve_path(found, ?order, 31, "/orders/42")) { ret 5; }
    if (order.response.status != status.OK || probe.order != 42
        || probe.calls != 0 || probe.layers != 1 || probe.mapped != 0) { ret 6; }
    if (!same_text(?probe.route[0], probe.route_len, "order")) { ret 7; }

    # a wildcard captures the rest of the path
    var file: Harness;
    if (!serve_path(found, ?file, 32, "/files/a/b")) { ret 8; }
    if (file.response.status != status.OK || probe.layers != 2
        || !same_text(?probe.file[0], probe.file_len, "a/b")
        || !same_text(?probe.route[0], probe.route_len, "file")) { ret 9; }

    # an unrouted path reaches the fallback, still inside the middleware chain
    var missing: Harness;
    if (!serve_path(found, ?missing, 33, "/missing")) { ret 10; }
    if (missing.response.status != status.ACCEPTED || probe.calls != 1
        || probe.layers != 3 || probe.route_len != 0) { ret 11; }

    # a parameter its decoder rejects is the application's error, not a handler call
    var rejected: Harness;
    if (!serve_path(found, ?rejected, 34, "/orders/nope")) { ret 12; }
    if (rejected.response.status != status.BAD_REQUEST
        || probe.mapped != 400 || probe.order != 42 || probe.calls != 1
        || probe.layers != 4) { ret 13; }

    # every entered half of the chain left again, four times over
    if (probe.starts != 4 || probe.finishes != 3 || probe.errors != 1
        || probe.exits != probe.layers
        || app.active_request_count(?site.application) != 0) { ret 14; }
    ret 0;
}

test "laurel: a suspended handler is resumed, never re-run" {
    var site: Site;
    if (!make_site(?site)) { ret 1; }
    val probe:    *Probe               = ?site.probe;
    var adapter:  hosting.Adapter;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    val found:    *service.Application = mount(?site, ?adapter, ?registry,
        ?slots[0]);
    if (found == nil) { ret 2; }

    var fragments: Fragments;
    var harness:   Harness;
    if (!make_form_harness(?harness, ?fragments, 41, "name=alice", 4)) { ret 3; }

    # the first entry reaches the handler, which suspends on a body that has not
    # arrived. the exchange is pending, not complete and not failed.
    if (found.handler.serve(found.handler.ctx, ?harness.call)
        != exchange.SERVICE_PENDING) { ret 4; }
    if (probe.entries != 1 || probe.resumes != 0 || probe.work != 0
        || probe.layers != 1 || probe.exits != 0 || harness.response.committed
        || call.disposition(?harness.call) != call.BODY_UNRESOLVED) { ret 5; }

    # two more pieces arrive, and each one resumes the same execution
    var rounds: usize = 0;
    for (rounds < 2) {
        val again: exchange.ServiceStatus = found.handler.serve(
            found.handler.ctx, ?harness.call);
        # the claim, checked before anything else: the handler was entered once
        if (probe.entries != 1)                { ret 6; }
        if (again != exchange.SERVICE_PENDING) { ret 7; }
        rounds = rounds + 1;
    }
    if (probe.resumes != 2 || probe.work != 0 || probe.exits != 0
        || fragments.delivered != 2) { ret 8; }

    # the last piece completes the body, and only now does the handler do its work
    val finished: exchange.ServiceStatus = found.handler.serve(
        found.handler.ctx, ?harness.call);
    if (probe.entries != 1 || probe.work != 1) { ret 9; }
    if (finished != exchange.SERVICE_COMPLETE) { ret 10; }
    if (probe.resumes != 3 || probe.layers != 1 || probe.exits != 1
        || fragments.delivered != 3
        || probe.settlement != handler.SETTLE_READY || probe.abandons != 0) {
        ret 11;
    }
    if (harness.response.status != status.OK || !harness.response.committed
        || probe.field_len != 1
        || !same_text(?probe.value[0], probe.value_len, "alice")) { ret 12; }

    # the connection's part: drain the response the handler produced
    var sink:    [16]u8;
    var drained: usize = 0;
    for {
        val chunk: body.Progress = body.read(harness.response.body_reader,
            ?sink[0], 16);
        if (chunk.status == body.COMPLETE) { brk; }
        if (chunk.status != body.DATA)     { ret 13; }
        drained = drained + chunk.count;
    }
    if (drained != 5 || !same_text(?sink[0], drained, "alice")) { ret 14; }
    if (exchange.finish(?harness.exchange) != exchange.FINISH_OK
        || !call.release(?harness.call)) { ret 15; }
    if (app.active_request_count(?site.application) != 0 || probe.finishes != 1
        || probe.errors != 0 || probe.status != status.OK) { ret 16; }
    ret 0;
}

test "laurel: a suspension nobody resumes is abandoned, not leaked" {
    var site: Site;
    if (!make_site(?site)) { ret 1; }
    val probe:    *Probe               = ?site.probe;
    var adapter:  hosting.Adapter;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    val found:    *service.Application = mount(?site, ?adapter, ?registry,
        ?slots[0]);
    if (found == nil) { ret 2; }

    var fragments: Fragments;
    var harness:   Harness;
    if (!make_form_harness(?harness, ?fragments, 42, "name=alice", 4)
        || found.handler.serve(found.handler.ctx, ?harness.call)
        != exchange.SERVICE_PENDING) { ret 3; }
    if (probe.entries != 1 || probe.layers != 1 || probe.exits != 0
        || app.active_request_count(?site.application) != 1) { ret 4; }

    # the connection dies while the handler holds the request. the finalizer is
    # the only thing that runs, and it has to get laurel back to a termination.
    if (!call.abandon(?harness.call)) { ret 5; }
    if (probe.resumes != 1 || probe.abandons != 1
        || probe.settlement != handler.SETTLE_ABANDONED
        || probe.work != 0 || probe.exits != 1) { ret 6; }
    if (app.active_request_count(?site.application) != 0) { ret 7; }
    # one terminal event, describing a cancelled request. a context released
    # while it still owned an execution reports OUTCOME_UNREPORTED instead
    if (probe.outcome != observability.OUTCOME_CANCELLED) { ret 8; }
    ret 0;
}

test "laurel: a request cancelled while suspended unwinds on its next entry" {
    var site: Site;
    if (!make_site(?site)) { ret 1; }
    val probe:    *Probe               = ?site.probe;
    var adapter:  hosting.Adapter;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    val found:    *service.Application = mount(?site, ?adapter, ?registry,
        ?slots[0]);
    if (found == nil) { ret 2; }

    var fragments: Fragments;
    var harness:   Harness;
    if (!make_form_harness(?harness, ?fragments, 43, "name=alice", 4)
        || found.handler.serve(found.handler.ctx, ?harness.call)
        != exchange.SERVICE_PENDING) { ret 3; }
    if (!transition_ok(cancel.cancel(?harness.scope))) { ret 4; }

    # resume is always safe: a scope that died abandons instead of continuing
    if (found.handler.serve(found.handler.ctx, ?harness.call)
        != exchange.SERVICE_FAILED) { ret 5; }
    if (probe.entries != 1 || probe.resumes != 1 || probe.abandons != 1
        || probe.settlement != handler.SETTLE_ABANDONED || probe.work != 0
        || probe.exits != 1) { ret 6; }
    if (exchange.cancel_exchange(?harness.exchange) != exchange.FINISH_OK
        || !call.release(?harness.call)
        || app.active_request_count(?site.application) != 0) { ret 7; }
    ret 0;
}

test "laurel: a handler that never suspends costs nothing extra" {
    var site: Site;
    if (!make_site(?site)) { ret 1; }
    val probe:    *Probe               = ?site.probe;
    var adapter:  hosting.Adapter;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    val found:    *service.Application = mount(?site, ?adapter, ?registry,
        ?slots[0]);
    if (found == nil) { ret 2; }
    var order: Harness;
    if (!serve_path(found, ?order, 44, "/orders/42")) { ret 3; }
    if (order.response.status != status.OK || probe.order != 42
        || probe.entries != 0 || probe.resumes != 0 || probe.abandons != 0
        || probe.layers != 1 || probe.exits != 1) { ret 4; }
    if (app.active_request_count(?site.application) != 0) { ret 5; }
    ret 0;
}
