test "cache: weak refresh selects storage recency instead of later LRU access" {
    var harness: Harness;
    if (!boot(?harness, 42, true, true, "language", "max-age=0",
        "accept-language")) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "W/\"shared\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "language", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.payload = "encoding";
    harness.origin.vary    = "accept-encoding";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: fr\r\nAccept-Encoding: gzip\r\n\r\n",
        "encoding", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    # only the older language variant matches this request. serving it stale
    # touches the LRU clock without changing when that response was stored.
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: br\r\nCache-Control: max-stale=600\r\n\r\n",
        "language", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "W/\"shared\"";
    harness.origin.validation_cache_control = "max-age=60";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "encoding", ?response[0], RESPONSE_BYTES, ?length)
        || !exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "encoding", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 3 || !wire.contains(?response[0], length, "encoding")
        || wire.contains(?response[0], length, "language")) { ret 6; }
    ret 0;
}

test "cache: a strong 304 refreshes every selectable strongly matching response" {
    var harness: Harness;
    if (!boot(?harness, 43, true, true, "language strong", "max-age=0",
        "accept-language")) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"shared-strong\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "language strong", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.payload = "encoding strong";
    harness.origin.vary    = "accept-encoding";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: fr\r\nAccept-Encoding: gzip\r\n\r\n",
        "encoding strong", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"shared-strong\"";
    harness.origin.validation_cache_control = "max-age=60";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "encoding strong", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    # only the older language response matches, and it must have received the
    # same strong-validator metadata update as the selected encoding response.
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: br\r\n\r\n",
        "language strong", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 3 || !wire.contains(?response[0], length,
        "language strong")) { ret 6; }
    ret 0;
}

test "cache: multi-target 304 refresh preflights every response before mutation" {
    var harness: Harness;
    if (!boot(?harness, 44, true, true, "simple", "max-age=0",
        "accept-language")) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"atomic\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "simple", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.payload = "padded";
    harness.origin.vary    = "accept-encoding";
    harness.origin.padding = 26;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: fr\r\nAccept-Encoding: gzip\r\n\r\n",
        "padded", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    var stored_fields:  usize = 0;
    var stored_entries: usize = 0;
    var simple_index:   usize = cache_store.NO_ENTRY;
    var stored_index:   usize = 0;
    for (stored_index < CACHE_ENTRIES) {
        if (harness.cache_entries[stored_index].state == cache_store.READY) {
            stored_entries = stored_entries + 1;
            if (harness.cache_entries[stored_index].field_count > stored_fields) {
                stored_fields = harness.cache_entries[stored_index].field_count;
            }
            if (harness.cache_entries[stored_index].field_count
                < cache_store.MAX_STORED_FIELDS) { simple_index = stored_index; }
        }
        stored_index = stored_index + 1;
    }
    if (stored_entries != 2) {
        shutdown(?harness);
        ret (150 + stored_entries)::i32;
    }
    if (stored_fields + 1 != cache_store.MAX_STORED_FIELDS) {
        shutdown(?harness);
        ret (100 + stored_fields)::i32;
    }
    if (simple_index == cache_store.NO_ENTRY) {
        shutdown(?harness);
        ret 149;
    }
    val simple_lifetime: u64 = harness.cache_entries[simple_index].metadata.lifetime_ns;
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"atomic\"";
    harness.origin.validation_cache_control = "max-age=60";
    harness.origin.validation_extra         = true;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n",
        "HTTP/1.1 5", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    if (harness.cache_entries[simple_index].metadata.lifetime_ns
        != simple_lifetime) {
        shutdown(?harness);
        ret 140;
    }
    if (harness.cache_entries[simple_index].revalidating) {
        shutdown(?harness);
        ret 141;
    }
    harness.origin.not_modified     = false;
    harness.origin.validation_extra = false;
    harness.origin.padding          = 0;
    harness.origin.payload          = "new simple";
    harness.origin.cache_control    = "max-age=60";
    harness.origin.vary             = "accept-language";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Language: en\r\nAccept-Encoding: br\r\n\r\n",
        "new simple", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 4 || !wire.starts_with(?response[0], length,
        "HTTP/1.1 200 OK") || !wire.contains(?response[0], length,
        "new simple")) { ret 6; }
    ret 0;
}

fun invalidating_refresh(generation: u64, cache_control: str,
    vary: str, set_cookie: str) i32 {
    var harness: Harness;
    if (!boot(?harness, generation, true, true, "discarded", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"discard\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "discarded", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"discard\"";
    harness.origin.validation_cache_control = cache_control;
    harness.origin.validation_vary          = vary;
    harness.origin.validation_set_cookie    = set_cookie;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "HTTP/1.1 5", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val report: http_cache.Report = http_cache.report(?harness.layer);
    val calls:  usize             = harness.origin.calls;
    shutdown(?harness);
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 5")
        || wire.starts_with(?response[0], length, "HTTP/1.1 304 ")) { ret 4; }
    if (calls != 2 || report.entries != 0) { ret 5; }
    ret 0;
}

test "cache: a matched no-store 304 discards exactly its stored response" {
    ret invalidating_refresh(32, "no-store", nil, nil);
}

test "cache: a matched private 304 discards exactly its stored response" {
    ret invalidating_refresh(33, "private", nil, nil);
}

test "cache: a matched Vary any 304 discards exactly its stored response" {
    ret invalidating_refresh(34, "max-age=60", "*", nil);
}

test "cache: an unsafe Set-Cookie 304 discards exactly its stored response" {
    ret invalidating_refresh(35, "max-age=60", nil, "session=new");
}

test "cache: an unsolicited origin 304 cannot reach an unconditional client" {
    var harness: Harness;
    if (!boot(?harness, 23, true, true, "unconditional", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "unconditional", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.unsolicited_not_modified = true;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "HTTP/1.1 5", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls:             usize = harness.origin.calls;
    val conditional_calls: usize = harness.origin.conditional_calls;
    shutdown(?harness);
    if (wire.starts_with(?response[0], length, "HTTP/1.1 304 ")
        || !wire.starts_with(?response[0], length, "HTTP/1.1 5")) {
        ret 4;
    }
    if (calls != 2 || conditional_calls != 0) { ret 5; }
    ret 0;
}

test "cache: an origin 304 reaches the client that supplied its condition" {
    var harness: Harness;
    if (!boot(?harness, 24, true, true, "conditional", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"client-v1\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "conditional", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"client-v1\"";
    harness.origin.validation_cache_control = "max-age=60";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"client-v1\"\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 304 ")) { ret 4; }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "conditional", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls:             usize             = harness.origin.calls;
    val conditional_calls: usize             = harness.origin.conditional_calls;
    val report:            http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK")) { ret 6; }
    if (calls != 2 || conditional_calls != 1 || report.hits != 1)   { ret 7; }
    ret 0;
}

test "cache: a cold conditional 304 is never stored as a representation" {
    var harness: Harness;
    if (!boot(?harness, 39, true, true, "cold", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"cold\"";
    harness.origin.validation_cache_control = "max-age=60";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"cold\"\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 304 ")
        || http_cache.report(?harness.layer).entries != 0) {
        shutdown(?harness);
        ret 3;
    }
    harness.origin.not_modified = false;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cold", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2 || !wire.starts_with(?response[0], length,
        "HTTP/1.1 200 OK")) { ret 5; }
    ret 0;
}

test "cache: a client 304 remains visible when its metadata discards the entry" {
    var harness: Harness;
    if (!boot(?harness, 36, true, true, "client discard", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"client-discard\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "client discard", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"client-discard\"";
    harness.origin.validation_cache_control = "no-store";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"client-discard\"\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 304 ")
        || http_cache.report(?harness.layer).entries != 0) {
        shutdown(?harness);
        ret 4;
    }
    harness.origin.not_modified             = false;
    harness.origin.validation_cache_control = nil;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "client discard", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 3 || !wire.starts_with(?response[0], length,
        "HTTP/1.1 200 OK")) { ret 6; }
    ret 0;
}

test "cache: service failure revalidation serves stale within its policy" {
    var harness: Harness;
    if (!boot(?harness, 27, true, true, "service stale",
        "max-age=0, stale-if-error=600", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"service-stale\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "service stale", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.service_failure = true;
    harness.origin.mutate_request  = true;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "service stale", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls:             usize = harness.origin.calls;
    val conditional_calls: usize = harness.origin.conditional_calls;
    shutdown(?harness);
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK")) { ret 4; }
    if (calls != 2 || conditional_calls != 1
        || !harness.origin.rollback_preserved) { ret 5; }
    ret 0;
}

test "cache: cancelled revalidation removes only its synthetic condition" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    if (!boot(?harness, 45, true, true, "cancelled stale", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"cancelled\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cancelled stale", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.mutate_request = true;
    harness.origin.hold_pending   = true;
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.send(?client, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 4;
    }
    var rounds: usize = 0;
    for (rounds < wire.MAX_ROUNDS && !harness.origin.pending_started) {
        if (!serve.poll(?quic_controls, ?harness.runtime, -1)) { brk; }
        rounds = rounds + 1;
    }
    if (!harness.origin.pending_started) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 5;
    }
    tcp.stream_close(?client);
    settle(?harness);
    if (!harness.origin.rollback_preserved || !serve.idle(?harness.runtime)) {
        shutdown(?harness);
        ret 6;
    }
    harness.origin.hold_pending   = false;
    harness.origin.mutate_request = false;
    harness.origin.payload        = "after cancellation";
    harness.origin.cache_control  = "max-age=60";
    harness.origin.etag           = "\"after-cancellation\"";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "after cancellation", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 7;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls < 3 || !wire.contains(?response[0], length,
        "after cancellation")) { ret 8; }
    ret 0;
}

test "cache: stale-if-error covers an origin failure and nothing else" {
    var covered: Harness;
    if (!boot(?covered, 20, true, true, "stale",
        "max-age=0, stale-if-error=600", nil)) {
        shutdown(?covered);
        ret 1;
    }
    covered.origin.etag = "\"stale\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?covered, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "stale", ?response[0], RESPONSE_BYTES, ?length);
    covered.origin.failure = status.BAD_GATEWAY;
    if (!exchange_once(?covered, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "stale", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?covered);
        ret 2;
    }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        || covered.origin.calls != 2 || covered.origin.conditional_calls != 1) {
        shutdown(?covered);
        ret 3;
    }
    shutdown(?covered);

    var refused: Harness;
    if (!boot(?refused, 21, true, true, "expired", "max-age=0", nil)) {
        shutdown(?refused);
        ret 4;
    }
    refused.origin.etag = "\"expired\"";
    exchange_once(?refused, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "expired", ?response[0], RESPONSE_BYTES, ?length);
    refused.origin.failure = status.BAD_GATEWAY;
    if (!exchange_once(?refused, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "502 Bad Gateway", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?refused);
        ret 5;
    }
    val calls: usize = refused.origin.calls;
    shutdown(?refused);
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 502 Bad Gateway\r\n")
        || calls != 2) { ret 6; }
    ret 0;
}

test "cache: a multi-range request deliberately receives the full representation" {
    var harness: Harness;
    if (!boot(?harness, 22, true, true, "0123456789", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nRange: bytes=0-1,8-9\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        || calls != 1 || !wire.contains(?response[0], length, "content-length: 10")) {
        ret 3;
    }
    ret 0;
}

# two completions for one connection in a single wait, formed on purpose rather
# than waited for. a connection that is not advanced between the two applies
# loses the response it had just finished: the write leaves apply blocked, and
# the end-of-stream that follows moves the engine to closing, so nothing ever
# records the response and the store stays empty.
#
# HTTP/1 only, which is the shape of the defect rather than an omission. the
# HTTP/2 branch of connection.settle advances unconditionally, except on a
# terminal step where it sets closing and returns, and that is correct.
test "cache: a response is stored when its client stops writing before the answer" {
    var harness: Harness;
    if (!boot(?harness, 40, true, true, "paired payload", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_half_closed(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "paired payload", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    val view:     http_cache.Report = http_cache.report(?harness.layer);
    val failures: u64               = serve.teardown_failures(?harness.runtime);
    val calls:    usize             = harness.origin.calls;
    shutdown(?harness);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK")) { ret 3; }
    if (calls != 1)                                                                { ret 4; }
    if (view.stores != 1)                                                          { ret 5; }
    if (failures != 0)                                                             { ret 6; }
    ret 0;
}
