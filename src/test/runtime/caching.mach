        ret 2;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_last_modified =
        "Sun, 06 Nov 1994 08:49:37 GMT";
    harness.origin.validation_cache_control = "max-age=60";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "modified", ?response[0], RESPONSE_BYTES, ?length)
        || !exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "modified", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls:             usize             = harness.origin.calls;
