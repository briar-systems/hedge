# end-to-end cache tests over real sockets, including the disabled case

use http_cache: hedge.cache;
use hedge.cache.policy;
use cache_store: hedge.cache.store;
use hedge.config.schema;
use hedge.connection;
use hedge.dispatch.call;
use hedge.dispatch.middleware;
use hedge.dispatch.plan;
use hedge.listener;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.serve;
use hedge.service;
use hedge.test.runtime.wire;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.status;
use http.router.router;
use std.allocator;
use heap_allocator: std.allocator;
use std.allocator.fixed;
use std.allocator.page;
use std.chrono.time;
use std.collections.vector;
use std.collections.vector.Vector;
use std.filesystem;
use io_error: std.io.error;
use std.net.ip;
use std.net.tcp;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

val SHUT_WR: i32 = 1;

fun page_ok(outcome: err[allocator.Error]) bool {
    ret sel outcome.ok;
}

fun present(outcome: res[bool, io_error.Error]) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun fs_ok(outcome: err[filesystem.FsError]) bool {
    ret sel outcome.ok;
}

val MAX_ROUTES:     usize = 8;
val MAX_SEGMENTS:   usize = 64;
val MAX_SERVICES:   usize = 8;
val PLAN_TEXT:      usize = 2048;
val POOL:           usize = 4;
val RESPONSE_BYTES: usize = 8192;
val CACHE_ENTRIES:  usize = 8;
val CACHE_BODY:     usize = 4096;

# an origin service that counts how often it is actually reached
rec Origin {
    calls:                         usize;
    conditional_calls:             usize;
    resume_calls:                  usize;
    payload:                       str;
    cache_control:                 str;
    validation_cache_control:      str;
    vary:                          str;
    etag:                          str;
    validation_etag:               str;
    last_modified:                 str;
    validation_last_modified:      str;
    validation_vary:               str;
    validation_set_cookie:         str;
    set_cookie:                    str;
    age:                           str;
    failure:                       status.Status;
    service_failure:               bool;
    hold_pending:                  bool;
    pending_started:               bool;
    pause_once:                    bool;
    pause_started:                 bool;
    not_modified:                  bool;
    unsolicited_not_modified:      bool;
    refresh_fields:                bool;
    validation_content_length:     bool;
    validation_extra:              bool;
    padding:                       usize;
    disposition_preserved:         bool;
    repeated_disposition_rejected: bool;
    mutate_request:                bool;
    rollback_preserved:            bool;
}

fun verify_request_rollback(context: ptr, active: *call.Call) bool {
    val state:   *Origin          = context::*Origin;
    val request: *message.Request = call.request(active);
    if (state == nil || request == nil) { ret false; }
    val synthetic: *field.Field = field.find_first(?request.fields,
        service.text_view(field.IF_NONE_MATCH));
    val later: *field.Field = field.find_first(?request.fields,
        service.text_view("x-after-condition"));
    state.rollback_preserved = synthetic == nil && later != nil;
    ret state.rollback_preserved;
}

fun origin_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state: *Origin = context::*Origin;
    state.calls = state.calls + 1;
    val conditional_etag: *field.Field = field.find_first(?call.request(active).fields,
        service.text_view(field.IF_NONE_MATCH));
    val conditional_modified: *field.Field = field.find_first(?call.request(active).fields,
        service.text_view(field.IF_MODIFIED_SINCE));
    val conditional: bool = conditional_etag != nil || conditional_modified != nil;
    if (conditional) {
        state.conditional_calls = state.conditional_calls + 1;
        if (field.find_first(?call.request(active).fields,
            service.text_view("x-resume")) != nil) {
            state.resume_calls = state.resume_calls + 1;
        }
    }
    if (conditional && state.mutate_request && !state.pending_started) {
        if (field.append(?call.request(active).fields, field.Field{
            name:      service.text_view("x-after-condition"),
            value:     service.text_view("preserved"),
            sensitive: false,
        }) != field.ADD_OK
            || !call.attach_finalizer(active, call.Finalizer{
            ctx: (state)::ptr,
            finish: verify_request_rollback,
        })) { ret exchange.SERVICE_FAILED; }
        state.pending_started = true;
    }
    if (conditional && state.pause_once && !state.pause_started) {
        state.pause_started = true;
        ret exchange.SERVICE_PENDING;
    }
    if (conditional && state.hold_pending) { ret exchange.SERVICE_PENDING; }
    if (state.service_failure)             { ret exchange.SERVICE_FAILED; }
    if (state.failure != 0)                { ret service.respond(active, state.failure); }
    if ((state.not_modified && conditional)
        || state.unsolicited_not_modified) {
        if (message.set_status(call.response(active), status.NOT_MODIFIED)
            != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
        if (state.validation_cache_control != nil
            && !service.add_field(active, field.CACHE_CONTROL,
            state.validation_cache_control)) { ret exchange.SERVICE_FAILED; }
        if (state.validation_etag != nil
            && !service.add_field(active, field.ETAG, state.validation_etag)) {
            ret exchange.SERVICE_FAILED;
        }
        if (state.validation_last_modified != nil
            && !service.add_field(active, field.LAST_MODIFIED,
            state.validation_last_modified)) { ret exchange.SERVICE_FAILED; }
        if (state.validation_vary != nil
            && !service.add_field(active, field.VARY, state.validation_vary)) {
            ret exchange.SERVICE_FAILED;
        }
        if (state.validation_set_cookie != nil
            && !service.add_field(active, field.SET_COOKIE,
            state.validation_set_cookie)) { ret exchange.SERVICE_FAILED; }
        if (state.validation_content_length
            && !service.add_field(active, field.CONTENT_LENGTH, "999")) {
            ret exchange.SERVICE_FAILED;
        }
        if (state.refresh_fields
            && !service.add_field(active, "x-refresh", "new")) {
            ret exchange.SERVICE_FAILED;
        }
        if (state.validation_extra
            && (!service.add_field(active, "x-new", "new")
            || !service.add_field(active, "x-another", "new"))) {
            ret exchange.SERVICE_FAILED;
        }
        val result: exchange.ServiceStatus = service.commit_bodyless(active,
            call.BODY_DRAIN);
        state.disposition_preserved         = call.disposition(active) == call.BODY_DRAIN;
        state.repeated_disposition_rejected = !call.resolve_body(active,
            call.BODY_DRAIN);
        ret result;
    }
    if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    if (!service.add_field(active, field.CONTENT_TYPE, "text/plain")) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.cache_control != nil
        && !service.add_field(active, field.CACHE_CONTROL, state.cache_control)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.vary != nil && !service.add_field(active, field.VARY, state.vary)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.etag != nil && !service.add_field(active, field.ETAG, state.etag)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.last_modified != nil
        && !service.add_field(active, field.LAST_MODIFIED, state.last_modified)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.set_cookie != nil
        && !service.add_field(active, field.SET_COOKIE, state.set_cookie)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.age != nil && !service.add_field(active, "age", state.age)) {
        ret exchange.SERVICE_FAILED;
    }
    if (state.refresh_fields
        && (!service.add_field(active, "x-refresh", "old")
        || !service.add_field(active, "x-preserve", "preserved")
        || !service.add_field(active, "x-remove", "old"))) {
        ret exchange.SERVICE_FAILED;
    }
    var padded: usize = 0;
    for (padded < state.padding) {
        if (!service.add_field(active, "x-pad", "pad")) {
            ret exchange.SERVICE_FAILED;
        }
        padded = padded + 1;
    }
    ret service.respond_with_text(active, state.payload);
}

rec Harness {
    graph:             schema.Graph;
    diagnostics:       schema.Diagnostics;
    routes:            [MAX_ROUTES]router.CompiledRoute;
    segments:          [MAX_SEGMENTS]router.Segment;
    specs:             [MAX_ROUTES]router.Route;
    entries:           [MAX_ROUTES]plan.Entry;
    services:          [MAX_SERVICES]service.Descriptor;
    middlewares:       [4]middleware.Middleware;
    text:              [PLAN_TEXT]u8;
    storage:           plan.Storage;
    plan:              plan.Plan;
    heap:              heap_allocator.Allocator;
    runtime:           serve.Runtime;
    applications:      service.Applications;
    application_slots: [2]service.Application;
    resolver:          service.Resolver;
    endpoint:          ip.Endpoint;
    origin:            Origin;
    layer:             http_cache.Layer;
    cache_entries:     [CACHE_ENTRIES]cache_store.Entry;
    cache_body:        [CACHE_BODY]u8;
    bindings:          http_cache.Bindings;
    binding_storage:   [MAX_SERVICES]http_cache.Binding;
    scratch:           allocator.Allocator;
}

fun native_factory(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    val state: *Origin = context::*Origin;
    if (state == nil || handler == nil) { ret false; }
    @handler = service.Handler{ctx: (state)::ptr, serve: origin_serve};
    ret true;
}

fun base_graph(harness: *Harness, cache_enabled: bool, per_service_cache: bool,
    disk_root: str, disk_bytes: usize) {
    val graph: *schema.Graph = ?harness.graph;
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "cache-test");
    graph.limits.max_connections          = opt[usize].some{POOL};
    graph.limits.max_connections_per_peer = opt[usize].some{POOL};
    graph.listener_count                  = 1;
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.name, "public");
    schema.set_text(?configured.address, "127.0.0.1:0");
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport    = schema.TRANSPORT_TCP;
    configured.protocols    = schema.PROTOCOL_HTTP1;
    configured.backlog      = 16;
    configured.accept_depth = 2;
    graph.host_count        = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 1;
    val configured_service: *schema.Service = ?graph.services[0];
    schema.set_text(?configured_service.name, "origin");
    configured_service.kind = schema.SERVICE_NATIVE;
    schema.set_text(?configured_service.target, "origin");
    schema.clear_text(?configured_service.budget);
    schema.clear_text(?configured_service.content_type);
    schema.clear_text(?configured_service.index);
    configured_service.precompressed = false;
    configured_service.status        = 200;
    configured_service.cache         = per_service_cache;
    graph.route_count                = 1;
    val configured_route: *schema.Route = ?graph.routes[0];
    schema.set_text(?configured_route.name, "all");
    schema.set_text(?configured_route.host, "site");
    schema.set_text(?configured_route.path, "/**");
    schema.set_text(?configured_route.service, "origin");
    schema.clear_text(?configured_route.budget);
    graph.cache.enabled         = cache_enabled;
    graph.cache.memory_bytes    = CACHE_BODY;
    graph.cache.max_entry_bytes = 1024;
    graph.cache.entries         = CACHE_ENTRIES;
    graph.cache.disk_bytes      = disk_bytes;
    if (disk_root != nil) {
        schema.set_text(?graph.cache.disk_root, disk_root);
    }
    or { schema.clear_text(?graph.cache.disk_root); }
}

fun boot_with_disk(harness: *Harness, generation: u64, cache_enabled: bool,
    per_service_cache: bool, payload: str, cache_control: str, vary: str,
    disk_root: str, disk_bytes: usize, protocols: u8) bool {
    var quic_controls: quic_runtime.ControlView;
    base_graph(harness, cache_enabled, per_service_cache, disk_root, disk_bytes);
    harness.graph.listeners[0].protocols         = protocols;
    harness.origin.calls                         = 0;
    harness.origin.conditional_calls             = 0;
    harness.origin.resume_calls                  = 0;
    harness.origin.payload                       = payload;
    harness.origin.cache_control                 = cache_control;
    harness.origin.validation_cache_control      = nil;
    harness.origin.vary                          = vary;
    harness.origin.etag                          = nil;
    harness.origin.validation_etag               = nil;
    harness.origin.last_modified                 = nil;
    harness.origin.validation_last_modified      = nil;
    harness.origin.validation_vary               = nil;
    harness.origin.validation_set_cookie         = nil;
    harness.origin.set_cookie                    = nil;
    harness.origin.age                           = nil;
    harness.origin.failure                       = 0;
    harness.origin.service_failure               = false;
    harness.origin.hold_pending                  = false;
    harness.origin.pending_started               = false;
    harness.origin.pause_once                    = false;
    harness.origin.pause_started                 = false;
    harness.origin.not_modified                  = false;
    harness.origin.unsolicited_not_modified      = false;
    harness.origin.refresh_fields                = false;
    harness.origin.validation_content_length     = false;
    harness.origin.validation_extra              = false;
    harness.origin.padding                       = 0;
    harness.origin.disposition_preserved         = false;
    harness.origin.repeated_disposition_rejected = false;
    harness.origin.mutate_request                = false;
    harness.origin.rollback_preserved            = false;
    if (!page_ok(page.make(?harness.scratch))) { ret false; }
    service.make_applications(?harness.applications, ?harness.application_slots[0], 2);
    if (cache_enabled) {
        if (!http_cache.from_config(?harness.layer, ?harness.graph.cache,
            ?harness.cache_entries[0], CACHE_ENTRIES, ?harness.cache_body[0], CACHE_BODY,
            ?harness.scratch)) {
            ret false;
        }
        http_cache.make_bindings(?harness.bindings, ?harness.binding_storage[0],
            MAX_SERVICES, ?harness.layer, generation);
    }
    or {
        harness.layer.live    = false;
        harness.layer.backing = cache_store.disabled();
        http_cache.make_bindings(?harness.bindings, ?harness.binding_storage[0],
            MAX_SERVICES, nil, generation);
    }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.native       = service.Factory{
        ctx: (?harness.origin)::ptr,
        build: native_factory,
    };
    # the harness composes the way the binary does, including this: a run with no
    # cache installs no wrapper at all
    if (cache_enabled) {
        harness.resolver.caching = service.Wrapper{
            ctx: (?harness.bindings)::ptr,
            wrap: http_cache.wrapper,
        };
    }
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret false; }
    if (plan.compile(?harness.plan, generation, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK) { ret false; }
    page.make(?harness.heap);
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret false; }
    schema.reset_diagnostics(?harness.diagnostics);
    if (!serve.start(?quic_controls, ?harness.runtime, generation, ?harness.graph, ?harness.diagnostics)) {
        ret false;
    }
    val owned: *listener.OwnedListener = listener.active_listener(?harness.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) { ret false; }
    harness.endpoint = owned.bound_endpoint;
    ret true;
}

fun boot(harness: *Harness, generation: u64, cache_enabled: bool, per_service_cache: bool,
    payload: str, cache_control: str, vary: str) bool {
    ret boot_with_disk(harness, generation, cache_enabled, per_service_cache, payload,
        cache_control, vary, nil, 0, schema.PROTOCOL_HTTP1);
}

fun boot_h2(harness: *Harness, generation: u64, payload: str,
    cache_control: str) bool {
    ret boot_with_disk(harness, generation, true, true, payload,
        cache_control, nil, nil, 0,
        schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2);
}

fun shutdown(harness: *Harness) {
    var quic_controls: quic_runtime.ControlView;
    serve.stop(?quic_controls, ?harness.runtime);
    http_cache.close(?harness.layer);
}

# the store is written when the exchange settles, which is after the client has
# its bytes. Sampling a report before then reads a half-finished cache, so every
# exchange here returns only once the server has nothing left in flight.
fun settle(harness: *Harness) {
    var quic_controls: quic_runtime.ControlView;
    var rounds:        usize = 0;
    for (rounds < wire.MAX_ROUNDS && !serve.idle(?harness.runtime)) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        rounds = rounds + 1;
    }
}

fun exchange_once(harness: *Harness, request: str, marker: str, response: *u8,
    capacity: usize, output: *usize) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    @output = wire.collect(?harness.runtime, ?client, response, capacity, marker);
    tcp.stream_close(?client);
    settle(harness);
    ret true;
}

# like exchange_once, except the client stops writing before the server answers.
# the server's post-response read then finds end-of-stream already waiting and
# completes inside its own submission, so its completion is queued beside the
# response write's and one wait carries both. that pairing is what the runtime
# produces by luck; here it is constructed, so it holds at any std pin.
fun exchange_half_closed(harness: *Harness, request: str, marker: str, response: *u8,
    capacity: usize, output: *usize) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    val half_closed: err[io_error.Error] = tcp.stream_shutdown(?client, SHUT_WR);
    if (sel half_closed.err) {
        tcp.stream_close(?client);
        ret false;
    }
    @output = wire.collect(?harness.runtime, ?client, response, capacity, marker);
    tcp.stream_close(?client);
    settle(harness);
    ret true;
}

fun exchange_h2(harness: *Harness, marker: str, response: *u8,
    capacity: usize, output: *usize) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    val written: res[usize, io_error.Error] = tcp.stream_write(?client,
        ?request[0], length);
    if (sel written.err) {
        tcp.stream_close(?client);
        ret false;
    }
    if (written.ok != length) {
        tcp.stream_close(?client);
        ret false;
    }
    @output = wire.collect(?harness.runtime, ?client, response, capacity, marker);
    tcp.stream_close(?client);
    settle(harness);
    ret true;
}

fun occurrences(buffer: *u8, length: usize, needle: str) usize {
    val needle_length: usize = str_len(needle);
    if (needle_length == 0) { ret 0; }
    var count: usize = 0;
    var at:    usize = 0;
    for (at + needle_length <= length) {
        var i: usize = 0;
        for (i < needle_length && buffer[at + i] == needle[i]) { i = i + 1; }
        if (i == needle_length) {
            count = count + 1;
            at    = at + needle_length;
        }
        or { at = at + 1; }
    }
    ret count;
}

test "cache: a second request for a fresh entry never reaches the service" {
    var harness: Harness;
    if (!boot(?harness, 1, true, true, "cached payload", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.age = "5";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cached payload", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        shutdown(?harness);
        ret 3;
    }
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 4;
    }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cached payload", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val view: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 6; }
    # the second answer came from the store, so the service ran exactly once
    if (harness.origin.calls != 1)          { ret 7; }
    if (view.hits != 1 || view.stores != 1) { ret 8; }
    # a served entry reports the age it has accumulated
    if (!wire.contains(?response[0], length, "age: ")
        || occurrences(?response[0], length, "age: ") != 1) { ret 9; }
    ret 0;
}

test "cache: HTTP/2 records a response and serves the next request from cache" {
    var harness: Harness;
    if (!boot_h2(?harness, 26, "h2 cached", "max-age=60")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_h2(?harness, "h2 cached", ?response[0], RESPONSE_BYTES,
        ?length) || length == 0 || harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (!exchange_h2(?harness, "h2 cached", ?response[0], RESPONSE_BYTES,
        ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls:  usize             = harness.origin.calls;
    val report: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (length == 0 || calls != 1)                                     { ret 4; }
    if (report.stores != 1 || report.hits != 1 || report.entries != 1) { ret 5; }
    ret 0;
}

test "cache: a response the origin marked private is never stored" {
    var harness: Harness;
    if (!boot(?harness, 2, true, true, "secret payload", "private, max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "secret payload", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "secret payload", ?response[0], RESPONSE_BYTES, ?length);
    val view: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (harness.origin.calls != 2)                               { ret 2; }
    if (view.stores != 0 || view.hits != 0 || view.entries != 0) { ret 3; }
    ret 0;
}

test "cache: a differently negotiated request is not answered from a stored variant" {
    var harness: Harness;
    if (!boot(?harness, 3, true, true, "negotiated", "max-age=60", "accept-encoding")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "negotiated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 3;
    }
    # the same key, a different selecting value: this must reach the service
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: br\r\n\r\n",
        "negotiated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    if (harness.origin.calls != 2) {
        shutdown(?harness);
        ret 5;
    }
    # the original negotiation is still a hit
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "negotiated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 6;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2) { ret 7; }
    ret 0;
}

test "cache: an unsafe method invalidates the stored entry" {
    var harness: Harness;
    if (!boot(?harness, 4, true, true, "invalidated", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 3;
    }
    exchange_once(?harness,
        "POST /a HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    # the POST reached the service and removed what the cache held
    if (harness.origin.calls != 2) {
        shutdown(?harness);
        ret 4;
    }
    if (http_cache.report(?harness.layer).entries != 0) {
        shutdown(?harness);
        ret 5;
    }
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "invalidated", ?response[0], RESPONSE_BYTES, ?length);
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 3) { ret 6; }
    ret 0;
}

test "cache: a request that demands validation is not answered from the store" {
    var harness: Harness;
    if (!boot(?harness, 5, true, true, "revalidated", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "revalidated", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nCache-Control: no-cache\r\n\r\n",
        "revalidated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2) { ret 4; }
    ret 0;
}

# the criterion this test exists for: with caching off nothing is created
test "cache: disabled caching creates no store, no file, and no allocation" {
    var harness: Harness;
    if (!boot(?harness, 6, false, true, "uncached", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    # no layer exists, so nothing owns entry storage, body storage, or a root
    if (http_cache.enabled(?harness.layer)) {
        shutdown(?harness);
        ret 2;
    }
    if (harness.layer.backing.entries != nil || harness.layer.backing.body != nil
        || harness.layer.backing.capacity != 0 || harness.layer.backing.body_capacity != 0
        || harness.layer.backing.has_root) {
        shutdown(?harness);
        ret 3;
    }
    # no service was wrapped, so a request does not even reach a cache branch
    if (harness.bindings.len != 0) {
        shutdown(?harness);
        ret 4;
    }
    # and no wrapper was installed to do the wrapping, so nothing in the plan
    # reads the binding storage. that is what keeps the disabled path from
    # depending on a record another statement had to remember to initialise.
    if (service.has_wrapper(harness.resolver.caching)) {
        shutdown(?harness);
        ret 8;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "uncached", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "uncached", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "uncached", ?response[0], RESPONSE_BYTES, ?length);
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize             = harness.origin.calls;
    shutdown(?harness);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    # every request reached the service, and the cache counted nothing
    if (calls != 3) { ret 6; }
    if (view.hits != 0 || view.misses != 0 || view.stores != 0 || view.entries != 0
        || view.memory_bytes != 0 || view.disk_bytes != 0) { ret 7; }
    ret 0;
}

# a service that did not ask for caching is left alone even when a layer exists
test "cache: a service that did not ask to be cached is never wrapped" {
    var harness: Harness;
    if (!boot(?harness, 7, true, false, "unwrapped", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    if (!http_cache.enabled(?harness.layer)) {
        shutdown(?harness);
        ret 2;
    }
    if (harness.bindings.len != 0) {
        shutdown(?harness);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "unwrapped", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "unwrapped", ?response[0], RESPONSE_BYTES, ?length);
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize             = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2)                                             { ret 4; }
    if (view.hits != 0 || view.misses != 0 || view.stores != 0) { ret 5; }
    ret 0;
}

# a stored representation must not replay fields that belonged to one connection
test "cache: a hop-by-hop field is not stored and cannot reach the next client" {
    var harness: Harness;
    if (!boot(?harness, 8, true, true, "poisoned", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.vary = nil;
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "poisoned", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "poisoned", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 1) { ret 4; }
    # the served hit carries exactly one content-length, the one the cache computed,
    # and no connection field the origin's own hop used
    if (wire.contains(?response[0], length, "connection:"))        { ret 5; }
    if (wire.contains(?response[0], length, "transfer-encoding:")) { ret 6; }
    ret 0;
}

test "cache: an entry larger than the budget is refused and the service still answers" {
    var harness: Harness;
    if (!boot(?harness, 9, true, true, "x", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.layer.backing.limits.max_entry_bytes = 0;
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\nx", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\nx", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize             = harness.origin.calls;
    shutdown(?harness);
    # both requests were answered correctly, and nothing was kept
    if (calls != 2 || view.entries != 0 || view.stores != 0) { ret 4; }
    if (view.rejections == 0)                                { ret 5; }
    ret 0;
}

# the defect this test exists for: a target may hold more than one representation,
# and taking the first entry filed under the key made every other one unreachable
test "cache: each stored representation answers its own negotiation" {
    var harness: Harness;
    if (!boot(?harness, 10, true, true, "varied", "max-age=60", "accept-encoding")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: br\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 2) {
        shutdown(?harness);
        ret 2;
    }
    if (http_cache.report(?harness.layer).entries != 2) {
        shutdown(?harness);
        ret 3;
    }
    # both are now stored, and each negotiation must find its own
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: br\r\n\r\n",
        "varied", ?response[0], RESPONSE_BYTES, ?length);
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize             = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2)                          { ret 4; }
    if (view.hits != 2 || view.entries != 2) { ret 5; }
    ret 0;
}

test "cache: a conditional request is answered from the store without an origin call" {
    var harness: Harness;
    if (!boot(?harness, 11, true, true, "conditional", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"v1\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "conditional", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"v1\"\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls: usize = harness.origin.calls;
    val hits:  u64   = http_cache.report(?harness.layer).hits;
    shutdown(?harness);
    # the cache validated against its own stored tag, so the origin was never reached
    if (calls != 1 || hits != 1)                                  { ret 4; }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 304 ")) { ret 5; }
    if (!wire.contains(?response[0], length, "etag:"))            { ret 6; }
    # a 304 describes no body, so it must not claim one
    if (wire.contains(?response[0], length, "conditional")) { ret 7; }
    ret 0;
}

fun origin_only_precondition(generation: u64, condition: str) i32 {
    var harness: Harness;
    if (!boot(?harness, generation, true, true, "cached", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag          = "\"current\"";
    harness.origin.last_modified = "Sun, 06 Nov 1994 08:49:37 GMT";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cached", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.payload = "origin";
    if (!exchange_once(?harness, condition,
        "origin", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 2 || !wire.starts_with(?response[0], length,
        "HTTP/1.1 200 OK") || !wire.contains(?response[0], length, "origin")) {
        ret 4;
    }
    ret 0;
}

test "cache: If-Match is forwarded to the origin instead of evaluated on a hit" {
    ret origin_only_precondition(37,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-Match: \"other\"\r\n\r\n");
}

test "cache: If-Unmodified-Since is forwarded to the origin on a fresh hit" {
    ret origin_only_precondition(38,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nIf-Unmodified-Since: Sun, 06 Nov 1994 07:49:37 GMT\r\n\r\n");
}

test "cache: a byte range is served out of the stored representation" {
    var harness: Harness;
    if (!boot(?harness, 12, true, true, "0123456789", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nRange: bytes=2-5\r\n\r\n",
        "2345", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val calls: usize = harness.origin.calls;
    shutdown(?harness);
    if (calls != 1)                                                          { ret 4; }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 206 "))            { ret 5; }
    if (!wire.contains(?response[0], length, "content-range: bytes 2-5/10")) { ret 6; }
    if (!wire.contains(?response[0], length, "content-length: 4"))           { ret 7; }
    # exactly the requested window, not the whole representation
    val body: usize = wire.body_offset(?response[0], length);
    if (body == 0 || length - body != 4)                    { ret 8; }
    if (response[body] != '2' || response[body + 3] != '5') { ret 9; }
    ret 0;
}

# the poisoning case: a shared cache that kept a Set-Cookie would give the next
# client the session the first one was issued
test "cache: a response that sets a cookie is not stored and never replayed" {
    var harness: Harness;
    if (!boot(?harness, 13, true, true, "cookied", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.set_cookie = "session=first";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cookied", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "cookied", ?response[0], RESPONSE_BYTES, ?length);
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    val calls: usize             = harness.origin.calls;
    shutdown(?harness);
    # every request reached the origin and got its own cookie
    if (calls != 2)                                              { ret 2; }
    if (view.stores != 0 || view.entries != 0 || view.hits != 0) { ret 3; }
    ret 0;
}

test "cache: an origin that names the cookie gets the rest of its response stored" {
    var harness: Harness;
    if (!boot(?harness, 14, true, true, "named",
        "private=\"set-cookie\", max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.set_cookie = "session=first";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "named", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (!wire.contains(?response[0], length, "set-cookie:")) {
        shutdown(?harness);
        ret 3;
    }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "named", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    val calls: usize             = harness.origin.calls;
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    # the representation was reused, and the cookie was not part of it
    if (calls != 1 || view.hits != 1 || view.stores != 1)   { ret 5; }
    if (wire.contains(?response[0], length, "set-cookie:")) { ret 6; }
    ret 0;
}

test "cache: a byte budget evicts the least recently used entry over real sockets" {
    var harness: Harness;
    if (!boot(?harness, 15, true, true, "0123456789", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    # exactly two ten byte representations fit
    harness.layer.backing.limits.memory_bytes = 20;
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    exchange_once(?harness, "GET /b HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (http_cache.report(?harness.layer).memory_bytes != 20) {
        shutdown(?harness);
        ret 2;
    }
    # touch the first so the second becomes least recently used
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 2) {
        shutdown(?harness);
        ret 3;
    }
    exchange_once(?harness, "GET /c HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    var view: http_cache.Report = http_cache.report(?harness.layer);
    if (view.memory_bytes != 20 || view.entries != 2 || view.evictions != 1) {
        shutdown(?harness);
        ret 4;
    }
    # the evicted target reaches the origin again, the retained one does not
    exchange_once(?harness, "GET /b HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 4) {
        shutdown(?harness);
        ret 5;
    }
    exchange_once(?harness, "GET /c HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "0123456789", ?response[0], RESPONSE_BYTES, ?length);
    val calls: usize = harness.origin.calls;
    view = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (calls != 4) { ret 6; }
    # the budget was a bound throughout, never a target it drifted above
    if (view.memory_bytes > 20) { ret 7; }
    ret 0;
}

fun ensure_dir(path: str) bool {
    if (present(filesystem.is_dir(path))) { ret true; }
    val created: err[io_error.Error] = filesystem.create_dir(path, 493);
    ret sel created.ok;
}

fun e_files(path: str, scratch: *allocator.Allocator) usize {
    val listed: res[Vector[str], filesystem.FsError] = filesystem.read_dir(scratch, path);
    if (sel listed.err) { ret 0xffffffffffffffff; }
    var names: Vector[str] = listed.ok;
    var found: usize       = 0;
    var i:     usize       = 0;
    for (i < names.len) {
        val held: opt[*str] = vector.get[str](?names, i);
        if (sel held.some) {
            val name: str = @held.some;
            if (name[0] == 'e' && name[1] >= '0' && name[1] <= '9') { found = found + 1; }
        }
        i = i + 1;
    }
    vector.dnit[str](?names);
    ret found;
}

test "cache: a disk entry is served over a socket and does not survive a restart" {
    if (!ensure_dir("out") || !ensure_dir("out/cache-runtime-disk")) { ret 1; }
    var harness: Harness;
    if (!boot_with_disk(?harness, 16, true, true, "on disk", "max-age=60", nil,
        "out/cache-runtime-disk", 4096, schema.PROTOCOL_HTTP1)) {
        shutdown(?harness);
        ret 2;
    }
    # anything past a quarter of the memory budget goes to disk
    harness.layer.backing.limits.memory_bytes = 8;
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "on disk", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 3;
    }
    var view: http_cache.Report = http_cache.report(?harness.layer);
    if (view.disk_bytes == 0 || view.memory_bytes != 0) {
        shutdown(?harness);
        ret 4;
    }
    if (e_files("out/cache-runtime-disk", ?harness.scratch) != 1) {
        shutdown(?harness);
        ret 5;
    }
    # the second answer comes off the disk, over a real socket, byte for byte
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "on disk", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 6;
    }
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 7;
    }
    if (!wire.contains(?response[0], length, "on disk")) {
        shutdown(?harness);
        ret 8;
    }
    shutdown(?harness);
    # shutting down took the files with it, so nothing is left to describe wrongly
    if (e_files("out/cache-runtime-disk", ?harness.scratch) != 0) { ret 9; }

    var restarted: Harness;
    if (!boot_with_disk(?restarted, 17, true, true, "on disk", "max-age=60", nil,
        "out/cache-runtime-disk", 4096, schema.PROTOCOL_HTTP1)) {
        shutdown(?restarted);
        ret 10;
    }
    if (http_cache.report(?restarted.layer).entries != 0) {
        shutdown(?restarted);
        ret 11;
    }
    exchange_once(?restarted, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "on disk", ?response[0], RESPONSE_BYTES, ?length);
    val calls: usize = restarted.origin.calls;
    shutdown(?restarted);
    # the restarted process kept nothing, so it answered from the origin
    if (calls != 1) { ret 12; }
    ret 0;
}

# a collapsed request can use the same stale-if-error window while one caller
# refreshes the representation
test "cache: stale-if-error serves stale during an in-flight revalidation" {
    var harness: Harness;
    if (!boot(?harness, 18, true, true, "collapsed",
        "max-age=0, stale-if-error=600", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "collapsed", ?response[0], RESPONSE_BYTES, ?length);
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 2;
    }
    if (http_cache.report(?harness.layer).entries != 1) {
        shutdown(?harness);
        ret 3;
    }
    # the entry is stale, so mark the representation as already being revalidated
    val entry: *cache_store.Entry = cache_store.entry_at(?harness.layer.backing, 0);
    if (entry == nil) {
        shutdown(?harness);
        ret 4;
    }
    entry.revalidating = true;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "collapsed", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    if (harness.origin.calls != 1) {
        shutdown(?harness);
        ret 6;
    }
    if (!wire.contains(?response[0], length, "collapsed")) {
        shutdown(?harness);
        ret 7;
    }
    val calls: usize             = harness.origin.calls;
    val view:  http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (calls != 1)                          { ret 8; }
    if (view.entries != 1 || view.hits != 1) { ret 9; }
    ret 0;
}

test "cache: an origin 304 refreshes one stored response and remains internal" {
    var harness: Harness;
    if (!boot(?harness, 19, true, true, "validated", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag           = "\"v1\"";
    harness.origin.refresh_fields = true;
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "validated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.not_modified              = true;
    harness.origin.validation_cache_control  = "private=\"x-remove\", max-age=60";
    harness.origin.validation_etag           = "\"v1\"";
    harness.origin.validation_content_length = true;
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "validated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        || harness.origin.calls != 2 || harness.origin.conditional_calls != 1) {
        shutdown(?harness);
        ret 4;
    }
    if (!wire.contains(?response[0], length, "etag: \"v1\"")
        || !wire.contains(?response[0], length, "x-refresh: new")
        || !wire.contains(?response[0], length, "x-preserve: preserved")
        || !wire.contains(?response[0], length, "content-length: 9")
        || wire.contains(?response[0], length, "content-length: 999")
        || wire.contains(?response[0], length, "x-remove:")) {
        shutdown(?harness);
        ret 5;
    }
    if (!harness.origin.disposition_preserved
        || !harness.origin.repeated_disposition_rejected) {
        shutdown(?harness);
        ret 6;
    }
    if (!exchange_once(?harness, "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "validated", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 7;
    }
    val calls:  usize             = harness.origin.calls;
    val report: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (calls != 2 || report.entries != 1 || report.stores != 1) { ret 8; }
    ret 0;
}

test "cache: a pending revalidation resumes its existing recording" {
    var harness: Harness;
    if (!boot(?harness, 48, true, true, "resumed",
        "max-age=0, stale-if-error=600", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"resume\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "resumed", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = "\"resume\"";
    harness.origin.validation_cache_control = "max-age=60";
    harness.origin.pause_once               = true;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\nX-Resume: yes\r\n\r\n",
        "resumed", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        || !harness.origin.pause_started) {
        shutdown(?harness);
        ret 4;
    }
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "resumed", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls:             usize             = harness.origin.calls;
    val conditional_calls: usize             = harness.origin.conditional_calls;
    val resume_calls:      usize             = harness.origin.resume_calls;
    val report:            http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (calls != 3 || conditional_calls != 2 || resume_calls != 2) {
        ret 6;
    }
    if (report.entries != 1 || report.stores != 1
        || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret 7;
    }
    ret 0;
}

test "cache: a stale 200 atomically replaces a higher-index stored response" {
    var harness: Harness;
    if (!boot(?harness, 40, true, true, "filler", "max-age=60", nil)) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /filler HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "filler", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.payload       = "old";
    harness.origin.cache_control = "max-age=0";
    harness.origin.etag          = "\"old\"";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "old", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    if (!exchange_once(?harness,
        "POST /filler HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n",
        "old", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    harness.origin.payload       = "new";
    harness.origin.cache_control = "max-age=60";
    harness.origin.etag          = "\"new\"";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "new", ?response[0], RESPONSE_BYTES, ?length)
        || !exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "new", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    val calls:  usize             = harness.origin.calls;
    val report: http_cache.Report = http_cache.report(?harness.layer);
    shutdown(?harness);
    if (calls != 4 || report.entries != 1
        || !wire.contains(?response[0], length, "new")
        || wire.contains(?response[0], length, "old")) { ret 6; }
    ret 0;
}

fun rejected_validator_refresh(generation: u64, response_etag: str) i32 {
    var harness: Harness;
    if (!boot(?harness, generation, true, true, "unchanged", "max-age=0", nil)) {
        shutdown(?harness);
        ret 1;
    }
    harness.origin.etag = "\"stored\"";
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "unchanged", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    harness.origin.not_modified             = true;
    harness.origin.validation_etag          = response_etag;
    harness.origin.validation_cache_control = "max-age=60";
    if (!exchange_once(?harness,
        "GET /a HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "HTTP/1.1 5", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 3;
    }
    val report:            http_cache.Report = http_cache.report(?harness.layer);
    val calls:             usize             = harness.origin.calls;
    val conditional_calls: usize             = harness.origin.conditional_calls;
    shutdown(?harness);
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 5")
        || wire.starts_with(?response[0], length, "HTTP/1.1 304 ")) { ret 4; }
    if (calls != 2 || conditional_calls != 1 || report.entries != 1) { ret 5; }
    ret 0;
}

test "cache: a mismatched strong validator cannot refresh a stored response" {
    ret rejected_validator_refresh(28, "\"other\"");
}

test "cache: a missing response validator cannot refresh a validated response" {
    ret rejected_validator_refresh(29, nil);
}

