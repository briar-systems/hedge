# end-to-end reverse proxy tests: a real origin server, a real edge, real sockets

use hedge.clock;
use hedge.config.schema;
use hedge.connection;
use hedge.dispatch.middleware;
use hedge.dispatch.plan;
use hedge.listener;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge_tls:    hedge.protocol.tls;
use hedge.proxy.upstream;
use hedge.serve;
use hedge.service;
use hedge.service.proxy;
use observability:    hedge.telemetry;
use telemetry_admin:  hedge.telemetry.admin;
use telemetry_health: hedge.telemetry.health;
use hedge.test.runtime.tlswire;
use hedge.test.runtime.wire;
use http.router.router;
use heap_allocator: std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.net.ip;
use std.net.socket;
use std.net.tcp;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

val MAX_ROUTES:     usize = 8;
val MAX_SEGMENTS:   usize = 64;
val MAX_SERVICES:   usize = 8;
val PLAN_TEXT:      usize = 2048;
val POOL:           usize = 4;
val RESPONSE_BYTES: usize = 8192;

rec Site {
    graph:             schema.Graph;
    diagnostics:       schema.Diagnostics;
    routes:            [MAX_ROUTES]router.CompiledRoute;
    segments:          [MAX_SEGMENTS]router.Segment;
    specs:             [MAX_ROUTES]router.Route;
    entries:           [MAX_ROUTES]plan.Entry;
    services:          [MAX_SERVICES]service.Descriptor;
    middlewares:       [4]middleware.Middleware;
    text:              [PLAN_TEXT]u8;
    storage:           plan.Storage;
    plan:              plan.Plan;
    heap:              heap_allocator.Allocator;
    runtime:           serve.Runtime;
    applications:      service.Applications;
    application_slots: [2]service.Application;
    resolver:          service.Resolver;
    endpoint:          ip.Endpoint;
    address:           [64]u8;
}

fun listener_graph(graph: *schema.Graph, name: str, address: str) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, name);
    graph.limits.max_connections          = opt[usize].some{POOL};
    graph.limits.max_connections_per_peer = opt[usize].some{POOL};
    graph.features.proxy                  = true;
    graph.listener_count                  = 1;
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.name, "public");
    schema.set_text(?configured.address, address);
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport          = schema.TRANSPORT_TCP;
    configured.protocols          = schema.PROTOCOL_HTTP1;
    configured.backlog            = 16;
    configured.accept_depth       = 2;
    configured.proxy_protocol     = schema.PROXY_OFF;
    configured.trusted_peer_count = 0;
    graph.host_count              = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 0;
    graph.route_count   = 0;
}

fun add_service(graph: *schema.Graph, name: str, kind: u8, target: str) {
    val index:      usize           = graph.service_count;
    val configured: *schema.Service = ?graph.services[index];
    schema.set_text(?configured.name, name);
    configured.kind = kind;
    schema.set_text(?configured.target, target);
    schema.clear_text(?configured.budget);
    schema.clear_text(?configured.content_type);
    schema.clear_text(?configured.index);
    configured.precompressed = false;
    configured.status        = 200;
    configured.cache         = false;
    graph.service_count      = index + 1;
}

fun add_route(graph: *schema.Graph, name: str, path: str, service_name: str) {
    val index:      usize         = graph.route_count;
    val configured: *schema.Route = ?graph.routes[index];
    schema.set_text(?configured.name, name);
    schema.set_text(?configured.host, "site");
    schema.set_text(?configured.path, path);
    schema.set_text(?configured.service, service_name);
    schema.clear_text(?configured.budget);
    graph.route_count = index + 1;
}

fun compile_site(site: *Site, generation: u64, resolver: *service.Resolver) bool {
    if (!plan.make_storage(?site.storage,
        ?site.routes[0], MAX_ROUTES,
        ?site.segments[0], MAX_SEGMENTS,
        ?site.specs[0], MAX_ROUTES,
        ?site.entries[0], MAX_ROUTES,
        ?site.services[0], MAX_SERVICES,
        ?site.middlewares[0], 4,
        ?site.text[0], PLAN_TEXT)) { ret false; }
    ret plan.compile(?site.plan, generation, ?site.graph, site.storage, resolver, nil).status
        == plan.PLAN_OK;
}

fun start_site(site: *Site, generation: u64,
    telemetry: *observability.Recorder) bool {
    var quic_controls: quic_runtime.ControlView;
    page.make(?site.heap);
    if (!serve.make(?site.runtime, 0, ?site.plan, ?site.graph, ?site.heap)) { ret false; }
    if (telemetry != nil && !serve.attach_telemetry(?site.runtime, telemetry)) {
        ret false;
    }
    schema.reset_diagnostics(?site.diagnostics);
    if (!serve.start(?quic_controls, ?site.runtime, generation, ?site.graph, ?site.diagnostics)) { ret false; }
    val owned: *listener.OwnedListener = listener.active_listener(?site.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) { ret false; }
    site.endpoint = owned.bound_endpoint;
    ip.endpoint_format(site.endpoint, ?site.address[0], 64);
    ret true;
}

# a plain-socket origin
#
# two listener owners cannot share one process, because the process plane is
# process-wide and singular. the origin here is therefore a bare socket that
# speaks HTTP/1 directly, which is still a real server on a real port.
rec Origin {
    listener:        tcp.Listener;
    endpoint:        ip.Endpoint;
    address:         [64]u8;
    body:            str;
    declared_length: usize;
    sent_length:     usize;
    not_modified:    bool;
    open:            bool;
    served:          usize;
    accepted:        usize;
    peer:            tcp.Stream;
    has_peer:        bool;
    seen:            [2048]u8;
    seen_length:     usize;
}

fun start_origin(origin: *Origin, body: str) bool {
    val bound: res[tcp.Listener, io_error.Error] = tcp.listen_with_flags(
        ip.endpoint(127, 0, 0, 1, 0), 16, socket.async_flags());
    if (sel bound.err) { ret false; }
    origin.listener = bound.ok;
    val local: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?origin.listener);
    if (sel local.err) { ret false; }
    origin.endpoint = local.ok;
    ip.endpoint_format(origin.endpoint, ?origin.address[0], 64);
    origin.body            = body;
    origin.declared_length = 0;
    origin.sent_length     = 0;
    origin.not_modified    = false;
    origin.open            = true;
    origin.served          = 0;
    origin.accepted        = 0;
    origin.has_peer        = false;
    origin.seen_length     = 0;
    ret true;
}

fun stop_origin(origin: *Origin) {
    if (origin == nil) { ret; }
    if (origin.has_peer) {
        tcp.stream_close(?origin.peer);
        origin.has_peer = false;
    }
    if (origin.open) {
        tcp.listener_close(?origin.listener);
        origin.open = false;
    }
}

fun write_all(stream: *tcp.Stream, data: *u8, length: usize) bool {
    var sent: usize = 0;
    for (sent < length) {
        val written: res[usize, io_error.Error] = tcp.stream_write(stream,
            ?data[sent], length - sent);
        if (sel written.err) { ret false; }
        val count: usize = written.ok;
        if (count == 0) { ret false; }
        sent = sent + count;
    }
    ret true;
}

fun decimal(value: usize, output: *u8) usize {
    var digits: usize = 1;
    var scale:  usize = value;
    for (scale >= 10) {
        scale  = scale / 10;
        digits = digits + 1;
    }
    var i:         usize = digits;
    var remaining: usize = value;
    for (i > 0) {
        i         = i - 1;
        output[i] = ('0' + (remaining % 10)::u8);
        remaining = remaining / 10;
    }
    ret digits;
}

# a keep-alive origin: one accepted connection answers request after request, so
# an upstream connection this proxy keeps idle is actually reusable
fun pump_origin(origin: *Origin) bool {
    if (origin == nil || !origin.open) { ret false; }
    if (!origin.has_peer) {
        val accepted: res[tcp.Stream, io_error.Error] = tcp.accept_with_flags(
            ?origin.listener, socket.blocking_flags());
        if (sel accepted.err) { ret false; }
        origin.peer     = accepted.ok;
        origin.has_peer = true;
        origin.accepted = origin.accepted + 1;
        tcp.stream_set_read_timeout(?origin.peer, 2);
    }
    val peer:     *tcp.Stream = ?origin.peer;
    var request:  [2048]u8;
    var total:    usize       = 0;
    var rounds:   usize       = 0;
    var complete: bool        = false;
    for (rounds < 40 && total + 1 < 2048) {
        val read: res[usize, io_error.Error] = tcp.stream_read(peer, ?request[total],
            2048 - total - 1);
        if (sel read.ok) {
            val count: usize = read.ok;
            if (count == 0 && total == 0) {
                tcp.stream_close(peer);
                origin.has_peer = false;
                ret false;
            }
            total          = total + count;
            request[total] = 0;
            if (wire.contains(?request[0], total, "\r\n\r\n")) {
                complete = true;
                brk;
            }
        }
        rounds = rounds + 1;
    }
    if (!complete) { ret false; }
    var i: usize = 0;
    for (i < total && i < 2048) {
        origin.seen[i] = request[i];
        i              = i + 1;
    }
    origin.seen_length = total;
    var response: [4096]u8;
    if (origin.not_modified) {
        val head: str  = "HTTP/1.1 304 Not Modified\r\n\r\n";
        val ok:   bool = write_all(peer, head::*u8, str_len(head));
        if (ok) { origin.served = origin.served + 1; }
        ret ok;
    }
    val head: str   = "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\ncontent-length: ";
    var at:   usize = 0;
    var h:    usize = 0;
    for (head[h] != 0) {
        response[at] = head[h];
        at           = at + 1;
        h            = h + 1;
    }
    val body_length: usize = str_len(origin.body);
    var declared:    usize = origin.declared_length;
    if (declared == 0) { declared = body_length; }
    var sent_length: usize = origin.sent_length;
    if (sent_length == 0 || sent_length > body_length) { sent_length = body_length; }
    at               = at + decimal(declared, ?response[at]);
    response[at]     = '\r';
    response[at + 1] = '\n';
    response[at + 2] = '\r';
    response[at + 3] = '\n';
    at               = at + 4;
    var b: usize = 0;
    for (b < sent_length) {
        response[at + b] = origin.body[b];
        b                = b + 1;
    }
    at = at + sent_length;
    val ok: bool = write_all(peer, ?response[0], at);
    if (ok) { origin.served = origin.served + 1; }
    or {
        tcp.stream_close(peer);
        origin.has_peer = false;
    }
    ret ok;
}

rec Edge {
    site:            Site;
    proxy_runtime:   proxy.Runtime;
    proxy_registry:  proxy.Registry;
    bindings:        proxy.Bindings;
    binding_storage: [MAX_SERVICES]proxy.Binding;
    telemetry:       observability.Runtime;
    checks:          [1]telemetry_health.Check;
    # the listener speaks TLS with the interop fixture identity
    secure: bool;
}

fun quiesce_proxy(context: ptr, now: time.Instant) serve.PlaneQuiesceStatus {
    val runtime: *proxy.Runtime      = context::*proxy.Runtime;
    val status:  proxy.QuiesceStatus = proxy.quiesce(runtime, now);
    if (status == proxy.QUIESCED)        { ret serve.PLANE_QUIESCED; }
    if (status == proxy.QUIESCE_PENDING) { ret serve.PLANE_PENDING; }
    ret serve.PLANE_FAILED;
}

fun proxy_deadline(context: ptr, at_ns: *u64) bool {
    ret proxy.deadline(context::*proxy.Runtime, at_ns);
}

fun secure_listener(graph: *schema.Graph) {
    schema.set_text(?graph.listeners[0].tls_policy, "public");
    schema.set_text(?graph.hosts[0].server_names[0], "api.example.com");
    graph.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?graph.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate, "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key, "test/interop/fixtures/api.key");
    schema.set_text(?policy.default_name, "api.example.com");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
}

fun start_edge(edge: *Edge, generation: u64, upstream_address: str,
    traces: bool) bool {
    ret start_edge_with(edge, generation, upstream_address, traces, schema.PROTOCOL_HTTP1);
}

fun start_edge_protocols(edge: *Edge, generation: u64, upstream_address: str,
    protocols: u8) bool {
    ret start_edge_with(edge, generation, upstream_address, false, protocols);
}

fun start_edge_with(edge: *Edge, generation: u64, upstream_address: str,
    traces: bool, protocols: u8) bool {
    listener_graph(?edge.site.graph, "edge", "127.0.0.1:0");
    edge.site.graph.listeners[0].protocols = protocols;
    edge.site.graph.telemetry.logs         = false;
    edge.site.graph.telemetry.traces       = traces;
    add_service(?edge.site.graph, "backend", schema.SERVICE_PROXY, upstream_address);
    add_route(?edge.site.graph, "all", "/**", "backend");
    if (edge.secure) { secure_listener(?edge.site.graph); }
    service.make_applications(?edge.site.applications, ?edge.site.application_slots[0], 2);
    if (!proxy.make_runtime(?edge.proxy_runtime, nil, "hedge-test", upstream.default_limits())) { ret false; }
    if (!proxy.make_registry(?edge.proxy_registry, generation))                                 { ret false; }
    if (!proxy.make_bindings(?edge.bindings, ?edge.binding_storage[0], MAX_SERVICES,
        ?edge.proxy_runtime, ?edge.proxy_registry)) { ret false; }
    edge.site.resolver              = service.no_resolver();
    edge.site.resolver.applications = ?edge.site.applications;
    edge.site.resolver.proxy        = service.Factory{
        ctx:   (?edge.bindings)::ptr,
        build: proxy.factory,
    };
    var telemetry: *observability.Recorder = nil;
    if (traces) {
        if (!observability.make(?edge.telemetry, ?edge.site.graph, nil, nil, 0,
            ?edge.checks[0], 1, nil,
            (0::usize)::telemetry_admin.AuthenticateFun, nil,
            (0::usize)::telemetry_admin.RenderFun,
            (0::usize)::telemetry_admin.RenderFun, nil,
            (0::usize)::observability.FlushFun)) { ret false; }
        telemetry                   = ?edge.telemetry.own;
        edge.site.resolver.observer = observability.observer(telemetry);
    }
    if (!compile_site(?edge.site, generation, ?edge.site.resolver)) { ret false; }
    if (edge.secure) {
        hedge_tls.reset();
        if (hedge_tls.publish("public", ?edge.site.graph.tls_policies[0],
            schema.PROTOCOL_HTTP1) != hedge_tls.OK) { ret false; }
    }
    if (!start_site(?edge.site, generation, telemetry)) { ret false; }
    proxy.attach_driver(?edge.proxy_runtime, ?edge.site.runtime.owner.network,
        ?edge.site.runtime.memory, edge.site.runtime.configured.memory_budgets,
        serve.plane_waker(?edge.site.runtime), edge.site.runtime.configured.engine);
    serve.attach_plane_lifecycle(?edge.site.runtime,
        (?edge.proxy_runtime)::ptr, proxy.poll, quiesce_proxy, proxy_deadline);
    ret true;
}

fun shutdown_edge(edge: *Edge, origin: *Origin) {
    var quic_controls: quic_runtime.ControlView;
    serve.stop(?quic_controls, ?edge.site.runtime);
    if (edge.secure) { hedge_tls.destroy(); }
    proxy.close_runtime(?edge.proxy_runtime);
    proxy.close_registry(?edge.proxy_runtime, ?edge.proxy_registry);
    stop_origin(origin);
}

# poll both servers while reading, because the proxied request needs the origin
fun collect_both(edge: *Edge, origin: *Origin, client: *tcp.Stream, output: *u8,
    capacity: usize, marker: str) usize {
    var quic_controls: quic_runtime.ControlView;
    # a long client read timeout would spend real time inside this loop, and the
    # proxy's attempt deadline is measured against that same clock
    tcp.stream_set_read_timeout(client, 2);
    var total:  usize = 0;
    var rounds: usize = 0;
    for (rounds < 600) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        if (origin != nil) { pump_origin(origin); }
        val read: res[usize, io_error.Error] = tcp.stream_read(client, ?output[total],
            capacity - total - 1);
        if (sel read.ok) {
            val count: usize = read.ok;
            total         = total + count;
            output[total] = 0;
            if (count != 0 && wire.contains(output, total, marker)) { ret total; }
        }
        rounds = rounds + 1;
    }
    output[total] = 0;
    ret total;
}

fun drive_origin_request(edge: *Edge, origin: *Origin) bool {
    var quic_controls: quic_runtime.ControlView;
    var rounds:        usize = 0;
    for (rounds < wire.MAX_ROUNDS) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        if (pump_origin(origin)) { ret true; }
        rounds = rounds + 1;
    }
    ret false;
}

test "proxy: a request is forwarded to a real origin and its response returned" {
    var origin: Origin;
    if (!start_origin(?origin, "answer from the origin")) { ret 1; }
    var edge: Edge;
    if (!start_edge(?edge, 1, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    if (!wire.send(?client, "GET /thing HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_both(?edge, ?origin, ?client, ?response[0], RESPONSE_BYTES,
        "answer from the origin");
    val view: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    if (length == 0)                                                    { ret 5; }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 6; }
    if (!wire.contains(?response[0], length, "answer from the origin")) { ret 7; }
    if (view.total_attempts != 1 || view.total_served != 1)             { ret 8; }
    ret 0;
}

test "proxy: an idle upstream link quiesces before the shared driver closes" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "idle before stop")) { ret 1; }
    var edge: Edge;
    if (!start_edge(?edge, 46, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    if (!wire.send(?client,
        "GET /idle HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_both(?edge, ?origin, ?client,
        ?response[0], RESPONSE_BYTES, "idle before stop");
    tcp.stream_close(?client);
    var before: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    var rounds: usize = 0;
    for (rounds < 64 && (before.live_attempts != 0 || before.idle_links != 1)) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        before = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
        rounds = rounds + 1;
    }
    val stopped: bool           = serve.stop(?quic_controls, ?edge.site.runtime);
    val after:   proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    val registry_closed: bool = proxy.close_registry(?edge.proxy_runtime,
        ?edge.proxy_registry);
    val runtime_closed: bool = proxy.close_runtime(?edge.proxy_runtime);
    stop_origin(?origin);
    if (length == 0 || before.idle_links != 1 || before.live_attempts != 0) {
        ret 5;
    }
    if (!stopped || after.live_links != 0 || after.live_attempts != 0
        || !registry_closed || !runtime_closed) { ret 6; }
    ret 0;
}

test "proxy: stopping a pending upstream connect retains its completion owner" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "unused")) { ret 1; }
    var edge: Edge;
    if (!start_edge(?edge, 47, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    if (!wire.send(?client,
        "GET /connecting HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var before: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    var rounds: usize = 0;
    for (rounds < 16 && !before.connect_pending) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        before = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
        rounds = rounds + 1;
    }
    if (!before.connect_pending) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 5;
    }
    val stopped: bool           = serve.stop(?quic_controls, ?edge.site.runtime);
    val after:   proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    tcp.stream_close(?client);
    val registry_closed: bool = proxy.close_registry(?edge.proxy_runtime,
        ?edge.proxy_registry);
    val runtime_closed: bool = proxy.close_runtime(?edge.proxy_runtime);
    stop_origin(?origin);
    if (!stopped || after.live_attempts != 0 || after.live_links != 0
        || after.connect_pending || !registry_closed || !runtime_closed) { ret 6; }
    ret 0;
}

test "proxy: stopping a pending response releases its attempt before driver teardown" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "partial")) { ret 1; }
    origin.declared_length = 64;
    origin.sent_length     = 7;
    var edge: Edge;
    if (!start_edge(?edge, 41, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)
        || !wire.send(?client,
        "GET /pending HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    if (!drive_origin_request(?edge, ?origin)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var before: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    var rounds: usize = 0;
    for (rounds < 100 && before.phase != proxy.PHASE_STREAM) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        before = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
        rounds = rounds + 1;
    }
    val stopped: bool           = serve.stop(?quic_controls, ?edge.site.runtime);
    val after:   proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    tcp.stream_close(?client);
    val registry_closed: bool = proxy.close_registry(?edge.proxy_runtime,
        ?edge.proxy_registry);
    proxy.close_runtime(?edge.proxy_runtime);
    stop_origin(?origin);
    if (before.phase != proxy.PHASE_STREAM || before.live_attempts != 1
        || before.live_links != 1) { ret 5; }
    if (!stopped || after.live_attempts != 0 || after.live_links != 0
        || after.route_inflight != 0 || !registry_closed) { ret 6; }
    ret 0;
}

test "proxy: a delayed upstream read completes into the retained body buffer" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "delayed-response")) { ret 1; }
    origin.declared_length = str_len(origin.body);
    origin.sent_length     = 4;
    var edge: Edge;
    if (!start_edge(?edge, 48, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    if (!wire.send(?client,
        "GET /delayed HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    if (!drive_origin_request(?edge, ?origin)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 5;
    }
    var pending: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    var rounds: usize = 0;
    for (rounds < 64 && !pending.body_read_pending) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        pending = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
        rounds  = rounds + 1;
    }
    if (!pending.body_read_pending || !pending.body_buffer_retained
        || !write_all(?origin.peer, ?origin.body[origin.sent_length],
        origin.declared_length - origin.sent_length)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 6;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?edge.site.runtime, ?client,
        ?response[0], RESPONSE_BYTES, "delayed-response");
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    if (length == 0 || !wire.contains(?response[0], length,
        "delayed-response")) { ret 7; }
    ret 0;
}

fun tls_send(client: *tlswire.Client, text: str) bool {
    ret tlswire.send(client, text::*u8, str_len(text));
}

fun secure_finish(edge: *Edge, origin: *Origin, client: *tlswire.Client, result: i32) i32 {
    if (client != nil) { tlswire.release(client); }
    shutdown_edge(edge, origin);
    ret result;
}

# #196: over TLS the connection's next read is already in flight when a late
# response is queued. the response must still go out, in every piece the
# upstream sends, and the read must survive it to carry the next request
test "proxy: a late response over TLS is written while the client's next read waits" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "late-response-over-tls")) { ret 1; }
    origin.declared_length = str_len(origin.body);
    origin.sent_length     = 4;
    var edge: Edge;
    edge.secure = true;
    if (!start_edge(?edge, 49, (?origin.address[0])::str, false)) {
        ret secure_finish(?edge, ?origin, nil, 2);
    }
    val client: *tlswire.Client = tlswire.allocate(?edge.site.heap);
    if (client == nil) { ret secure_finish(?edge, ?origin, nil, 3); }
    if (!tlswire.make(client, ?edge.site.runtime, "api.example.com", "http/1.1")
        || !tlswire.handshake(client, edge.site.endpoint)) {
        ret secure_finish(?edge, ?origin, client, 4);
    }
    if (!tls_send(client, "GET /late HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret secure_finish(?edge, ?origin, client, 5);
    }
    if (!drive_origin_request(?edge, ?origin)) { ret secure_finish(?edge, ?origin, client, 6); }
    var pending: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
    var rounds:  usize          = 0;
    for (rounds < 64 && !pending.body_read_pending) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        pending = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
        rounds  = rounds + 1;
    }
    if (!pending.body_read_pending) { ret secure_finish(?edge, ?origin, client, 7); }
    # the rest arrives in two pieces, each its own write while the client is silent
    val rest:  usize = origin.declared_length - origin.sent_length;
    val first: usize = rest / 2;
    if (!write_all(?origin.peer, ?origin.body[origin.sent_length], first)) {
        ret secure_finish(?edge, ?origin, client, 8);
    }
    rounds = 0;
    for (rounds < 16) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        rounds = rounds + 1;
    }
    if (!write_all(?origin.peer, ?origin.body[origin.sent_length + first], rest - first)) {
        ret secure_finish(?edge, ?origin, client, 9);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(client, ?response[0], RESPONSE_BYTES,
        "late-response-over-tls");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        || !wire.contains(?response[0], length, "late-response-over-tls")) {
        ret secure_finish(?edge, ?origin, client, 10);
    }
    # the read that waited out the response carries the next request
    origin.declared_length = 0;
    origin.sent_length     = 0;
    if (!tls_send(client, "GET /next HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret secure_finish(?edge, ?origin, client, 11);
    }
    if (!drive_origin_request(?edge, ?origin)) { ret secure_finish(?edge, ?origin, client, 12); }
    val second: usize = tlswire.receive(client, ?response[0], RESPONSE_BYTES,
        "late-response-over-tls");
    if (second == 0 || !wire.starts_with(?response[0], second, "HTTP/1.1 200 OK\r\n")) {
        ret secure_finish(?edge, ?origin, client, 13);
    }
    val requests: u64 = connection.snapshot(serve.slot_connection(?edge.site.runtime, 0)).requests;
    if (requests != 2) { ret secure_finish(?edge, ?origin, client, 14); }
    ret secure_finish(?edge, ?origin, client, 0);
}

test "proxy: repeated bodyless upstream responses release more than one attempt pool" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "unused")) { ret 1; }
    origin.not_modified = true;
    var edge: Edge;
    if (!start_edge(?edge, 44, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var request: usize = 0;
    for (request < proxy.MAX_LINKS + 2) {
        var client: tcp.Stream;
        if (!wire.connect(edge.site.endpoint, ?client)
            || !wire.send(?client,
            "GET /bodyless HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"x\"\r\nConnection: close\r\n\r\n")) {
            tcp.stream_close(?client);
            shutdown_edge(?edge, ?origin);
            ret 3;
        }
        var response: [RESPONSE_BYTES]u8;
        val length:   usize = collect_both(?edge, ?origin, ?client,
            ?response[0], RESPONSE_BYTES, "\r\n\r\n");
        tcp.stream_close(?client);
        if (length == 0 || !wire.starts_with(?response[0], length,
            "HTTP/1.1 304 ")) {
            shutdown_edge(?edge, ?origin);
            ret 4;
        }
        var rounds: usize = 0;
        for (rounds < 32 && !serve.idle(?edge.site.runtime)) {
            serve.poll(?quic_controls, ?edge.site.runtime, 1);
            rounds = rounds + 1;
        }
        request = request + 1;
    }
    val view: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    shutdown_edge(?edge, ?origin);
    if (origin.served != proxy.MAX_LINKS + 2 || view.total_served != origin.served
        || view.live_attempts != 0 || view.live_links != 0) { ret 5; }
    ret 0;
}

test "proxy: an unreachable upstream answers 502 without hanging" {
    var edge: Edge;
    # nothing listens on this port, so every attempt fails at connect
    if (!start_edge(?edge, 2, "127.0.0.1:9", false)) {
        shutdown_edge(?edge, nil);
        ret 1;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, nil);
        ret 2;
    }
    if (!wire.send(?client, "GET /thing HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, nil);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize          = collect_both(?edge, nil, ?client, ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    val view:     proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
    tcp.stream_close(?client);
    shutdown_edge(?edge, nil);
    if (length == 0)                                                             { ret 4; }
    if (!wire.starts_with(?response[0], length, "HTTP/1.1 502 Bad Gateway\r\n")) { ret 5; }
    # a GET with no body is replayable, so the failure was retried before giving up
    if (view.total_attempts < 2) { ret 6; }
    ret 0;
}

test "proxy: forwarded metadata and via reach the origin" {
    var origin: Origin;
    if (!start_origin(?origin, "seen")) { ret 1; }
    var edge: Edge;
    if (!start_edge(?edge, 3, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    if (!wire.send(?client, "GET /thing HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_both(?edge, ?origin, ?client, ?response[0], RESPONSE_BYTES, "seen");
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    ret 0;
}

fun occurrence_count(data: *u8, length: usize, needle: str) usize {
    val needle_length: usize = str_len(needle);
    if (data == nil || needle_length == 0 || needle_length > length) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i + needle_length <= length) {
        var j: usize = 0;
        for (j < needle_length && data[i + j] == needle[j]) { j = j + 1; }
        if (j == needle_length) {
            count = count + 1;
            i     = i + needle_length;
        }
        or { i = i + 1; }
    }
    ret count;
}

test "proxy: a remote trace reaches the origin as one canonical child context" {
    var origin: Origin;
    if (!start_origin(?origin, "traced")) { ret 1; }
    var edge: Edge;
    if (!start_edge(?edge, 31, (?origin.address[0])::str, true)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)
        || !wire.send(?client,
        "GET /trace HTTP/1.1\r\nHost: localhost\r\ntraceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\ntracestate: vendor=value\r\nConnection: close\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_both(?edge, ?origin, ?client, ?response[0],
        RESPONSE_BYTES, "traced");
    tcp.stream_close(?client);
    if (length == 0
        || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var parent:        [64]u8;
    var state:         [64]u8;
    val parent_length: usize = wire.field_value(?origin.seen[0],
        origin.seen_length, "traceparent: ", ?parent[0], 64);
    val state_length: usize = wire.field_value(?origin.seen[0],
        origin.seen_length, "tracestate: ", ?state[0], 64);
    shutdown_edge(?edge, ?origin);
    if (occurrence_count(?origin.seen[0], origin.seen_length,
        "traceparent: ") != 1
        || parent_length != 55
        || !wire.starts_with(?parent[0], parent_length,
        "00-4bf92f3577b34da6a3ce929d0e0e4736-")
        || str_equals((?parent[0])::str,
        "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
        || parent[52] != '-' || parent[53] != '0' || parent[54] != '1') { ret 5; }
    if (state_length != 12
        || !str_equals((?state[0])::str, "vendor=value")) { ret 6; }
    ret 0;
}

test "proxy: successive proxied requests reuse the client connection" {
    var origin: Origin;
    if (!start_origin(?origin, "relayed")) { ret 1; }
    var edge: Edge;
    if (!start_edge(?edge, 4, (?origin.address[0])::str, false)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    if (!wire.send(?client, "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    val first: usize = collect_both(?edge, ?origin, ?client, ?response[0], RESPONSE_BYTES, "relayed");
    if (first == 0 || !wire.starts_with(?response[0], first, "HTTP/1.1 200 OK\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 5;
    }
    if (!wire.send(?client, "GET /two HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 6;
    }
    val second:   usize          = collect_both(?edge, ?origin, ?client, ?response[0], RESPONSE_BYTES, "relayed");
    val requests: u64            = connection.snapshot(serve.slot_connection(?edge.site.runtime, 0)).requests;
    val view:     proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    if (second == 0 || !wire.starts_with(?response[0], second, "HTTP/1.1 200 OK\r\n")) { ret 7; }
    # one client connection carried both, and each was a separate upstream exchange
    if (requests != 2)                                { ret 8; }
    if (view.total_served != 2 || origin.served != 2) { ret 9; }
    # the upstream connection was kept and used again, so the origin accepted once
    if (view.total_reused != 1 || origin.accepted != 1) { ret 10; }
    ret 0;
}

test "proxy: repeated upstream failure opens the breaker and refuses without dialling" {
    var edge: Edge;
    if (!start_edge(?edge, 5, "127.0.0.1:9", false)) {
        shutdown_edge(?edge, nil);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var request:  usize = 0;
    for (request < 3) {
        var client: tcp.Stream;
        if (!wire.connect(edge.site.endpoint, ?client)) {
            shutdown_edge(?edge, nil);
            ret 2;
        }
        if (!wire.send(?client, "GET /thing HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
            tcp.stream_close(?client);
            shutdown_edge(?edge, nil);
            ret 3;
        }
        collect_both(?edge, nil, ?client, ?response[0], RESPONSE_BYTES, "\r\n\r\n");
        tcp.stream_close(?client);
        request = request + 1;
    }
    val opened: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, nil);
        ret 4;
    }
    if (!wire.send(?client, "GET /thing HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, nil);
        ret 5;
    }
    val length: usize          = collect_both(?edge, nil, ?client, ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    val after:  proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
    tcp.stream_close(?client);
    shutdown_edge(?edge, nil);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 502 Bad Gateway\r\n")) { ret 6; }
    # the breaker is open, so the refusal cost no further connection attempt
    if (after.total_attempts != opened.total_attempts) { ret 7; }
    if (after.unhealthy_refusals == 0)                 { ret 8; }
    ret 0;
}

# true once the response on stream 1 has ended
fun h2_stream_ended(bytes: *u8, length: usize) bool {
    var at: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (bytes[at]::usize << 16) | (bytes[at + 1]::usize << 8)
            | bytes[at + 2]::usize;
        val kind:  u8 = bytes[at + 3];
        val flags: u8 = bytes[at + 4];
        if (bytes[at + 8] == 1 && (kind == 0x00 || kind == 0x01) && (flags & 0x01) != 0) {
            ret true;
        }
        at = at + 9 + size;
    }
    ret false;
}

# the payload of every DATA frame on stream 1, in order
fun h2_body(bytes: *u8, length: usize, output: *u8, capacity: usize) usize {
    var at:    usize = 0;
    var total: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (bytes[at]::usize << 16) | (bytes[at + 1]::usize << 8)
            | bytes[at + 2]::usize;
        if (bytes[at + 3] == 0x00 && bytes[at + 8] == 1) {
            var i: usize = 0;
            for (i < size && at + 9 + i < length && total + 1 < capacity) {
                output[total] = bytes[at + 9 + i];
                total         = total + 1;
                i             = i + 1;
            }
        }
        at = at + 9 + size;
    }
    output[total] = 0;
    ret total;
}

test "proxy: an HTTP/2 request receives the proxied body and its end" {
    var origin: Origin;
    if (!start_origin(?origin, "answer from the origin over h2")) { ret 1; }
    var edge: Edge;
    if (!start_edge_protocols(?edge, 1, (?origin.address[0])::str, schema.PROTOCOL_HTTP2)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    val ended:  usize = wire.put_request(?frames[0], start, 1);
    if (!write_all(?client, ?frames[0], ended)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_both(?edge, ?origin, ?client, ?response[0], RESPONSE_BYTES,
        "answer from the origin over h2");
    var total: usize = length;
    if (!h2_stream_ended(?response[0], total)) {
        total = total + collect_both(?edge, nil, ?client, ?response[total],
            RESPONSE_BYTES - total, "never sent");
    }
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    if (length == 0)                                                            { ret 7; }
    if (!wire.contains(?response[0], length, "answer from the origin over h2")) { ret 5; }
    if (!h2_stream_ended(?response[0], total))                                  { ret 6; }
    ret 0;
}

test "proxy: an HTTP/2 response whose body arrives later completes" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "delayed-h2-response")) { ret 1; }
    origin.declared_length = str_len(origin.body);
    origin.sent_length     = 4;
    var edge: Edge;
    if (!start_edge_protocols(?edge, 49, (?origin.address[0])::str, schema.PROTOCOL_HTTP2)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    val ended:  usize = wire.put_request(?frames[0], start, 1);
    if (!write_all(?client, ?frames[0], ended)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    if (!drive_origin_request(?edge, ?origin)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 5;
    }
    var pending: proxy.Snapshot = proxy.snapshot(?edge.proxy_runtime,
        ?edge.proxy_registry);
    var rounds: usize = 0;
    for (rounds < 64 && !pending.body_read_pending) {
        serve.poll(?quic_controls, ?edge.site.runtime, 1);
        pending = proxy.snapshot(?edge.proxy_runtime, ?edge.proxy_registry);
        rounds  = rounds + 1;
    }
    if (!pending.body_read_pending || !pending.body_buffer_retained) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 6;
    }
    # a stream whose body is pending waits on the body's wake, so the engine
    # must not be left naming it writable, which the audit reads as work (#261)
    if (serve.audit(?quic_controls, ?edge.site.runtime, clock.instant()) != 0) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 9;
    }
    if (!write_all(?origin.peer, ?origin.body[origin.sent_length],
        origin.declared_length - origin.sent_length)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 6;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_both(?edge, nil, ?client, ?response[0], RESPONSE_BYTES,
        "response");
    var total: usize = length;
    if (!h2_stream_ended(?response[0], total)) {
        total = total + collect_both(?edge, nil, ?client, ?response[total],
            RESPONSE_BYTES - total, "never sent");
    }
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    var body:        [RESPONSE_BYTES]u8;
    val body_length: usize = h2_body(?response[0], total, ?body[0], RESPONSE_BYTES);
    if (body_length != 19 || !str_equals((?body[0])::str, "delayed-h2-response")) { ret 7; }
    if (!h2_stream_ended(?response[0], total))                                    { ret 8; }
    ret 0;
}

# a client that grants no flow-control window leaves the proxied body held by the
# upstream link. that is backpressure, and it must not wake the connection on
# every turn
test "proxy: an upstream body held behind a closed window does not spin its connection" {
    var quic_controls: quic_runtime.ControlView;
    var origin:        Origin;
    if (!start_origin(?origin, "held behind the window")) { ret 1; }
    var edge: Edge;
    if (!start_edge_protocols(?edge, 50, (?origin.address[0])::str, schema.PROTOCOL_HTTP2)) {
        shutdown_edge(?edge, ?origin);
        ret 2;
    }
    var client: tcp.Stream;
    if (!wire.connect(edge.site.endpoint, ?client)) {
        shutdown_edge(?edge, ?origin);
        ret 3;
    }
    var frames: [256]u8;
    var length: usize = wire.put_text(?frames[0], 0, wire.PREFACE);
    # SETTINGS_INITIAL_WINDOW_SIZE = 0
    val payload: usize = wire.put_frame(?frames[0], length, 6, 0x04, 0, 0);
    frames[payload]     = 0;
    frames[payload + 1] = 4;
    frames[payload + 2] = 0;
    frames[payload + 3] = 0;
    frames[payload + 4] = 0;
    frames[payload + 5] = 0;
    length              = wire.put_request(?frames[0], payload + 6, 1);
    if (!write_all(?client, ?frames[0], length)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 4;
    }
    if (!drive_origin_request(?edge, ?origin)) {
        tcp.stream_close(?client);
        shutdown_edge(?edge, ?origin);
        ret 5;
    }
    wire.pump(?edge.site.runtime, 16);
    val settled: u64 = serve.drives(?edge.site.runtime);
    wire.pump(?edge.site.runtime, 64);
    val held: u64 = serve.drives(?edge.site.runtime) - settled;
    # the window opens and the held body goes out
    val update: usize = wire.put_frame(?frames[0], 0, 4, 0x08, 0, 1);
    frames[update]     = 0;
    frames[update + 1] = 0;
    frames[update + 2] = 0x10;
    frames[update + 3] = 0;
    var sent:     bool  = write_all(?client, ?frames[0], update + 4);
    var response: [RESPONSE_BYTES]u8;
    var total:    usize = 0;
    if (sent) {
        total = collect_both(?edge, nil, ?client, ?response[0], RESPONSE_BYTES, "window");
    }
    tcp.stream_close(?client);
    shutdown_edge(?edge, ?origin);
    if (!sent)    { ret 6; }
    if (held > 4) { ret 7; }
    var body:        [RESPONSE_BYTES]u8;
    val body_length: usize = h2_body(?response[0], total, ?body[0], RESPONSE_BYTES);
    if (body_length != 22 || !str_equals((?body[0])::str, "held behind the window")) { ret 8; }
    ret 0;
}
