# a TLS 1.3 client that runs in the test's own thread against an in-process server
#
# the client drives its socket synchronously. every time it would wait for the
# server it polls the serving runtime instead, so one thread plays both peers.
# it trusts the interop root, which signed the fixture certificates, and can
# stop after writing its ClientHello to model a client that never finishes.
# it can also present a client certificate for mutual TLS.

use crypto.contracts;
use crypto.encoding.keys;
use crypto.secret;
use hedge.clock;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.serve;
use hedge.storage;
use A: std.allocator;
use std.chrono.time;
use std.crypto.ct;
use std.filesystem;
use io_error: std.io.error;
use std.io.file;
use io_runtime: std.io.runtime;
use std.memory;
use std.net.ip;
use std.net.tcp;
use std.sync.cancel;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls_client: tls.client;
use tls.config;
use tls_error: tls.error;
use tls.memory_range;
use tls.record;
use tls.stream;
use tls.tls13;
use tls.transport;

val ROOT_PATH:       str   = "test/interop/fixtures/root.pem";
val PEM_BYTES:       usize = 8192;
val HANDSHAKE_BYTES: usize = 16384;
val WIRE_BYTES:      usize = record.HEADER_SIZE + record.MAX_CIPHERTEXT;
val CAPTURE_BYTES:   usize = 4096;
# how long one wait for the server may take before the client gives up
val WAIT_NS: i64 = 5000000000;

rec Lower {
    runtime:   *io_runtime.Runtime;
    socket:    *tcp.Stream;
    serving:   *serve.Runtime;
    capturing: bool;
    captured:  *u8;
    length:    *usize;
}

# the TLS state is secret-welded, so it lives apart from anything a callback sees
rec Session {
    configuration: config.ClientConfig;
    anchor:        cert.Certificate;
    trust:         cert.TrustStore;
    root_der:      [PEM_BYTES]u8;
    protocols:     [1]config.ProtocolName;
    versions:      [1]u16;
    suites:        [1]tls13.CipherSuite;
    groups:        [1]tls13.NamedGroup;
    signatures:    [1]tls13.SignatureScheme;
    entropy:       secret.Entropy;
    core:          tls_client.Client;
    secure:        stream.Stream;
    input:         [HANDSHAKE_BYTES]u8;
    output:        [HANDSHAKE_BYTES]u8;
    hello:         [HANDSHAKE_BYTES]u8;
    certificates:  [4]cert.Certificate;
    owner:         secret.Allocator;
    identity:      credentials.Identity;
    client_key:    keys.PrivateKey;
    client_der:    [PEM_BYTES]u8;
    client_cert:   [1]cert.Certificate;
    key_pem:       [PEM_BYTES]^u8;
    wire_input:    [WIRE_BYTES]u8;
    wire_output:   [WIRE_BYTES]u8;
}

pub rec Client {
    runtime:        io_runtime.Runtime;
    runtime_live:   bool;
    socket:         tcp.Stream;
    socket_live:    bool;
    lower_state:    Lower;
    lower:          transport.Transport;
    index:          usize;
    core_live:      bool;
    secure_live:    bool;
    scope:          cancel.Scope;
    scope_live:     bool;
    key_live:       bool;
    captured:       [CAPTURE_BYTES]u8;
    captured_bytes: usize;
    token:          u32;
}

# a table holding secret-welded records welds whatever holds it, so the table is
# module state and a client names its session by index
var sessions:       storage.SecretTable[Session];
var sessions_ready: bool;
var sessions_taken: usize;

fun session(client: *Client) *Session {
    ret storage.secret_table_at[Session](?sessions, client.index);
}

fun claim_session() usize {
    if (!sessions_ready) {
        if (!storage.make_secret_table[Session](?sessions)) { ret (-1)::usize; }
        sessions_ready = true;
    }
    if (sessions_taken == sessions.capacity
        && !storage.grow_secret_table[Session](?sessions)) { ret (-1)::usize; }
    sessions_taken = sessions_taken + 1;
    ret sessions_taken - 1;
}

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun runtime_ok(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

fun pump(serving: *serve.Runtime) {
    var controls: quic_runtime.ControlView;
    serve.poll(?controls, serving, 0);
}

fun lower_aliases(context: ptr, data: *u8, len: usize) bool {
    if (!memory_range.valid(data, len)) { ret true; }
    if (len == 0)                       { ret false; }
    val state: *Lower = context::*Lower;
    ret memory_range.overlap(state::*u8, $size_of(Lower), data, len)
        || memory_range.overlap(state.socket::*u8, $size_of(tcp.Stream), data, len)
        || io_runtime.aliases(state.runtime, data, len);
}

fun submit(state: *Lower, scope: *cancel.Scope, kind: io_runtime.Kind, buffer: *u8,
    length: usize, context: usize) res[io_runtime.Token, io_error.Error] {
    ret io_runtime.submit_scoped(state.runtime, scope, io_runtime.Operation{kind: kind,
        resource: state.socket.handle.value, buffer: buffer, length: length,
        offset:   0, context: context});
}

# the socket times reads out after a millisecond, so waiting for the server is
# a loop that lets the server run between attempts
fun lower_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *Lower                                = context::*Lower;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.READ, buffer, length, token_context);
    if (sel submitted.err) { ret submitted; }
    val started: time.Time = clock.monotonic();
    for {
        pump(state.serving);
        val received: res[usize, io_error.Error] = tcp.stream_read(state.socket,
            buffer, length);
        if (sel received.ok) {
            io_runtime.complete(state.runtime, submitted.ok, received.ok,
                state.socket.handle.value, received.ok == 0);
            ret submitted;
        }
        if (!io_error.retryable(received.err)
            || time.time_sub(clock.monotonic(), started) > WAIT_NS) {
            io_runtime.fail(state.runtime, submitted.ok, received.err);
            ret submitted;
        }
    }
    ret submitted;
}

fun lower_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *Lower                                = context::*Lower;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.WRITE, buffer, length, token_context);
    if (sel submitted.err) { ret submitted; }
    if (state.capturing) {
        # the flight is kept rather than sent, and the write is left pending so
        # the handshake stops exactly where a stalled client would
        var take: usize = length;
        if (take > CAPTURE_BYTES - @state.length) { take = CAPTURE_BYTES - @state.length; }
        memory.raw_copy(?state.captured[@state.length], buffer, take);
        @state.length = @state.length + take;
        ret submitted;
    }
    val written: res[usize, io_error.Error] = tcp.stream_write(state.socket, buffer, length);
    if (sel written.err) {
        io_runtime.fail(state.runtime, submitted.ok, written.err);
        ret submitted;
    }
    io_runtime.complete(state.runtime, submitted.ok, written.ok,
        state.socket.handle.value, false);
    ret submitted;
}

fun lower_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *Lower                                = context::*Lower;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.SHUTDOWN, nil, 0, token_context);
    if (sel submitted.err) { ret submitted; }
    io_runtime.complete(state.runtime, submitted.ok, 0, state.socket.handle.value, false);
    ret submitted;
}

# the socket itself is closed by `release`, so a close here only settles
fun lower_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val state:     *Lower                                = context::*Lower;
    val submitted: res[io_runtime.Token, io_error.Error] = submit(state, scope,
        io_runtime.CLOSE, nil, 0, token_context);
    if (sel submitted.err) { ret submitted; }
    io_runtime.complete(state.runtime, submitted.ok, 0, state.socket.handle.value, false);
    ret submitted;
}

# the whole of a small file, or zero when it is missing, empty or too large
fun read_small(path: str, output: *u8) usize {
    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { ret 0; }
    var handle: filesystem.File            = opened.ok;
    val read:   res[usize, io_error.Error] = file.read_at(handle, output, PEM_BYTES, 0);
    filesystem.close(?handle);
    if (sel read.err)         { ret 0; }
    if (read.ok >= PEM_BYTES) { ret 0; }
    ret read.ok;
}

fun read_root(value: *Session) bool {
    var pem:    [PEM_BYTES]u8;
    val length: usize = read_small(ROOT_PATH, ?pem[0]);
    if (length == 0) { ret false; }
    val decoded: contracts.Operation = load.certificate_pem(
        contracts.Bytes{data: ?pem[0], len: length},
        contracts.Buffer{data: ?value.root_der[0], capacity: PEM_BYTES}, ?value.anchor);
    ret decoded.error == contracts.OK;
}

# present `certificate` and `key` when the server asks for a client certificate.
# call it after make and before the handshake starts
pub fun present(client: *Client, certificate: str, key: str) bool {
    val value:  *Session = session(client);
    var pem:    [PEM_BYTES]u8;
    val length: usize    = read_small(certificate, ?pem[0]);
    if (length == 0) { ret false; }
    val decoded: contracts.Operation = load.certificate_pem(
        contracts.Bytes{data: ?pem[0], len: length},
        contracts.Buffer{data: ?value.client_der[0], capacity: PEM_BYTES},
        ?value.client_cert[0]);
    if (decoded.error != contracts.OK) { ret false; }
    val key_length: usize = read_small(key, ?pem[0]);
    if (key_length == 0) { ret false; }
    var i: usize = 0;
    for (i < key_length) {
        value.key_pem[i] = pem[i];
        i                = i + 1;
    }
    memory.raw_zero((?pem[0])::ptr, PEM_BYTES);
    value.owner      = secret.system_allocator();
    value.client_key = keys.empty_private();
    val parsed: contracts.Error = load.private_pem(
        contracts.SecretBytes{data: ?value.key_pem[0], len: key_length}, ?value.owner,
        ?value.client_key);
    ct.zeroize(?value.key_pem[0], PEM_BYTES);
    if (parsed != contracts.OK) { ret false; }
    client.key_live                     = true;
    value.identity.server_name          = contracts.Bytes{data: nil, len: 0};
    value.identity.chain                = cert.Chain{certificates: ?value.client_cert[0], len: 1};
    value.identity.private_key          = ?value.client_key;
    value.configuration.client_identity = ?value.identity;
    ret true;
}

# ready a client that offers `alpn` and names `server_name`. nothing is sent yet
pub fun make(client: *Client, serving: *serve.Runtime, server_name: str, alpn: str) bool {
    memory.raw_zero((client)::ptr, $size_of(Client));
    if (serving == nil) { ret false; }
    client.index = claim_session();
    if (client.index == (-1)::usize) { ret false; }
    val value: *Session = session(client);
    if (!read_root(value)) { ret false; }
    value.trust                     = cert.TrustStore{anchors: ?value.anchor, len: 1};
    value.protocols[0]              = config.ProtocolName{data: alpn::*u8, len: str_len(alpn)};
    value.versions[0]               = tls13.VERSION;
    value.suites[0]                 = tls13.AES_128_GCM_SHA256;
    value.groups[0]                 = tls13.X25519;
    value.signatures[0]             = tls13.ED25519;
    value.entropy                   = secret.system_entropy();
    value.configuration             = config.no_client_config();
    value.configuration.server_name = contracts.Bytes{data: server_name::*u8,
        len: str_len(server_name)};
    value.configuration.alpn                            = ?value.protocols[0];
    value.configuration.alpn_len                        = 1;
    value.configuration.trust                           = ?value.trust;
    value.configuration.versions                        = ?value.versions[0];
    value.configuration.version_len                     = 1;
    value.configuration.suites                          = ?value.suites[0];
    value.configuration.suite_len                       = 1;
    value.configuration.groups                          = ?value.groups[0];
    value.configuration.group_len                       = 1;
    value.configuration.signatures                      = ?value.signatures[0];
    value.configuration.signature_len                   = 1;
    value.configuration.client_identity                 = nil;
    value.configuration.entropy                         = ?value.entropy;
    value.configuration.sessions                        = nil;
    value.configuration.limits                          = config.production_limits();
    value.configuration.limits.max_peer_handshake_bytes = HANDSHAKE_BYTES;
    value.configuration.limits.max_client_hello_bytes   = 4096;
    value.configuration.limits.max_client_flight_bytes  = 4096;
    value.configuration.limits.max_server_flight_bytes  = HANDSHAKE_BYTES;
    value.configuration.limits.max_chain_bytes          = 8192;
    value.configuration.limits.max_ticket_bytes         = 4096;
    client.lower_state.serving                          = serving;
    ret true;
}

# open the socket and start the handshake. with `capture` the ClientHello is
# kept instead of sent, and the handshake goes no further
fun start(client: *Client, endpoint: ip.Endpoint, capture: bool) bool {
    val connected: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint);
    if (sel connected.err) { ret false; }
    client.socket      = connected.ok;
    client.socket_live = true;
    if (!runtime_ok(tcp.stream_set_read_timeout(?client.socket, 1))
        || !runtime_ok(io_runtime.make(?client.runtime, 16))) { ret false; }
    client.runtime_live          = true;
    client.lower_state.runtime   = ?client.runtime;
    client.lower_state.socket    = ?client.socket;
    client.lower_state.capturing = capture;
    client.lower_state.captured  = ?client.captured[0];
    client.lower_state.length    = ?client.captured_bytes;
    client.lower                 = transport.Transport{runtime: ?client.runtime,
        context: (?client.lower_state)::ptr, context_size: $size_of(Lower),
        aliases_state:                                     lower_aliases, submit_read: lower_read, submit_write: lower_write,
        submit_shutdown:                                   lower_shutdown, submit_close: lower_close,
        submit_abort:                                      lower_close};
    val storage: tls_client.Storage = tls_client.Storage{
        input:           ?session(client).input[0], input_capacity: HANDSHAKE_BYTES,
        output:          ?session(client).output[0], output_capacity: HANDSHAKE_BYTES,
        hello:           ?session(client).hello[0], hello_capacity: HANDSHAKE_BYTES,
        certificates:    ?session(client).certificates[0], certificate_capacity: 4,
        peer_parameters: nil, peer_parameters_capacity: 0
    };
    var wire: stream.Storage;
    wire.wire_input           = ?session(client).wire_input[0];
    wire.wire_input_capacity  = WIRE_BYTES;
    wire.wire_output          = ?session(client).wire_output[0];
    wire.wire_output_capacity = WIRE_BYTES;
    var extra: tls_client.ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    if (!tls_client.init(?session(client).core, ?session(client).configuration, storage, extra, 0)) { ret false; }
    client.core_live = true;
    if (!operation_ok(cancel.make_root(?client.scope, false, time.Time{sec: 0, nsec: 0}))) {
        ret false;
    }
    client.scope_live = true;
    client.token      = 1;
    if (!stream.connect(?session(client).secure, ?session(client).core, wire, ?client.lower, ?client.scope,
        transport.Token{index: 1, generation: 1}, time.time_unix_sec(clock.wall()), 1)) { ret false; }
    client.secure_live = true;
    ret true;
}

fun settle(client: *Client) bool {
    for (transport.snapshot(?session(client).secure.operation).state
        != transport.OPERATION_TERMINAL) {
        var completion: io_runtime.Completion;
        val polled:     res[usize, io_error.Error] = io_runtime.poll(?client.runtime,
            ?completion, 1);
        if (sel polled.err)                                                         { ret false; }
        if (polled.ok != 1 || !stream.accept(?session(client).secure, ?completion)) { ret false; }
    }
    ret true;
}

fun finish_operation(client: *Client) bool {
    val finished: transport.Snapshot = transport.snapshot(?session(client).secure.operation);
    ret stream.destroy_operation(?session(client).secure) && finished.terminal_error == tls_error.OK;
}

# complete a handshake with the server at `endpoint`
pub fun handshake(client: *Client, endpoint: ip.Endpoint) bool {
    ret start(client, endpoint, false) && settle(client) && finish_operation(client);
}

# the ClientHello this client would send, without sending any of it
pub fun hello(client: *Client, endpoint: ip.Endpoint) bool {
    ret start(client, endpoint, true) && client.captured_bytes != 0;
}

pub fun hello_bytes(client: *Client) *u8 {
    ret ?client.captured[0];
}

pub fun hello_length(client: *Client) usize {
    ret client.captured_bytes;
}

# write raw bytes on the socket, under TLS or not
pub fun send_raw(client: *Client, data: *u8, length: usize) bool {
    val written: res[usize, io_error.Error] = tcp.stream_write(?client.socket, data, length);
    ret (sel written.ok) && written.ok == length;
}

fun next_token(client: *Client) transport.Token {
    client.token = client.token + 1;
    ret transport.Token{index: 2, generation: client.token};
}

# send application bytes through the session
pub fun send(client: *Client, data: *u8, length: usize) bool {
    ret stream.write(?session(client).secure, ?client.scope, next_token(client), data, length, 2)
        && settle(client) && finish_operation(client);
}

# read application bytes until `needle` has arrived, pumping the server
pub fun receive(client: *Client, output: *u8, capacity: usize, needle: str) usize {
    var total: usize = 0;
    for (total < capacity) {
        if (!stream.read(?session(client).secure, ?client.scope, next_token(client),
            ?output[total], capacity - total, 3) || !settle(client)) { ret total; }
        val got: transport.Snapshot = transport.snapshot(?session(client).secure.operation);
        stream.destroy_operation(?session(client).secure);
        if (got.terminal_error != tls_error.OK || got.application_bytes == 0) { ret total; }
        total = total + got.application_bytes;
        if (needle == nil || contains(output, total, needle)) { ret total; }
    }
    ret total;
}

fun contains(buffer: *u8, length: usize, needle: str) bool {
    val size: usize = str_len(needle);
    if (size > length) { ret false; }
    var i: usize = 0;
    for (i + size <= length) {
        if (memory.raw_equal(?buffer[i], needle::*u8, size)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun release(client: *Client) {
    if (client.secure_live) {
        stream.destroy_operation(?session(client).secure);
        stream.destroy(?session(client).secure);
        client.secure_live = false;
    }
    if (client.core_live) {
        tls_client.destroy(?session(client).core);
        client.core_live = false;
    }
    if (client.scope_live) {
        cancel.destroy(?client.scope);
        client.scope_live = false;
    }
    if (client.key_live) {
        keys.destroy_private(?session(client).client_key);
        client.key_live = false;
    }
    if (client.socket_live) {
        tcp.stream_close(?client.socket);
        client.socket_live = false;
    }
    if (client.runtime_live) {
        io_runtime.close(?client.runtime);
        io_runtime.destroy(?client.runtime);
        client.runtime_live = false;
    }
}

# a client record is too large for a test's stack
pub fun allocate(heap: *A.Allocator) *Client {
    val taken: res[*Client, A.Error] = A.allocate[Client](heap, 1);
    if (sel taken.err) { ret nil; }
    ret taken.ok;
}
