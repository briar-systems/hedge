# client-side helpers shared by the runtime suites: real sockets, real bytes

use hedge.dispatch.call;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.serve;
use hedge.service;
use hedge_wake: hedge.wake;
use http.core.body;
use http.core.exchange;
use http.core.message;
use http.core.status;
use io_error: std.io.error;
use std.net.ip;
use std.net.socket;
use std.net.tcp;
use std.runtime;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

fun is_ok_err_io_error_error(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

fun is_ok_bool_io_error_error(outcome: res[bool, io_error.Error]) bool {
    ret sel outcome.ok;
}

pub val READ_TIMEOUT_MS: u64   = 50;
pub val MAX_ROUNDS:      usize = 400;

pub fun connect(endpoint: ip.Endpoint, output: *tcp.Stream) bool {
    val connected: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint);
    if (sel connected.err) { ret false; }
    @output = connected.ok;
    tcp.stream_set_read_timeout(output, READ_TIMEOUT_MS);
    ret true;
}

# a small receive buffer makes the peer slow without any sleeping
pub fun shrink_receive_buffer(client: *tcp.Stream, bytes: u32) bool {
    ret is_ok_err_io_error_error(socket.set_value(client.handle,
        socket.RECEIVE_BUFFER_BYTES, bytes));
}

pub fun send(client: *tcp.Stream, request: str) bool {
    val length:  usize                      = str_len(request);
    val written: res[usize, io_error.Error] = tcp.stream_write(client, request::*u8, length);
    if (sel written.err) { ret false; }
    ret written.ok == length;
}

pub fun contains(buffer: *u8, length: usize, needle: str) bool {
    ret index_of(buffer, length, needle) != length;
}

pub fun index_of(buffer: *u8, length: usize, needle: str) usize {
    val needle_length: usize = str_len(needle);
    if (needle_length == 0 || needle_length > length) { ret length; }
    var i: usize = 0;
    for (i + needle_length <= length) {
        var j: usize = 0;
        for (j < needle_length && buffer[i + j] == needle[j]) { j = j + 1; }
        if (j == needle_length) { ret i; }
        i = i + 1;
    }
    ret length;
}

pub fun starts_with(buffer: *u8, length: usize, prefix: str) bool {
    val prefix_length: usize = str_len(prefix);
    if (prefix_length > length) { ret false; }
    var i: usize = 0;
    for (i < prefix_length) {
        if (buffer[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# offset of the first body byte, or zero when the head is not complete
pub fun body_offset(buffer: *u8, length: usize) usize {
    val at: usize = index_of(buffer, length, "\r\n\r\n");
    if (at == length) { ret 0; }
    ret at + 4;
}

# copy one header value, without its name or trailing CRLF
pub fun field_value(buffer: *u8, length: usize, name: str, output: *u8, capacity: usize) usize {
    val at: usize = index_of(buffer, length, name);
    if (at == length) { ret 0; }
    var start: usize = at + str_len(name);
    var end:   usize = start;
    for (end < length && buffer[end] != '\r' && buffer[end] != '\n') { end = end + 1; }
    if (end - start >= capacity) { ret 0; }
    var i: usize = 0;
    for (start + i < end) {
        output[i] = buffer[start + i];
        i         = i + 1;
    }
    output[i] = 0;
    ret i;
}

pub fun build_request(output: *u8, capacity: usize, head: str, middle: *u8,
    middle_length: usize, tail: str) usize {
    val head_length: usize = str_len(head);
    val tail_length: usize = str_len(tail);
    if (head_length + middle_length + tail_length + 1 > capacity) { ret 0; }
    var at: usize = 0;
    var i:  usize = 0;
    for (i < head_length) {
        output[at + i] = head[i];
        i              = i + 1;
    }
    at = at + head_length;
    i  = 0;
    for (i < middle_length) {
        output[at + i] = middle[i];
        i              = i + 1;
    }
    at = at + middle_length;
    i  = 0;
    for (i < tail_length) {
        output[at + i] = tail[i];
        i              = i + 1;
    }
    at         = at + tail_length;
    output[at] = 0;
    ret at;
}

# give the server turns without reading, so the peer can send in pieces
pub fun pump(runtime: *serve.Runtime, rounds: usize) {
    var quic_controls: quic_runtime.ControlView;
    var i:             usize = 0;
    for (i < rounds) {
        serve.poll(?quic_controls, runtime, 1);
        i = i + 1;
    }
}

# poll the server and read until the marker appears or the budget is spent
pub fun collect(runtime: *serve.Runtime, client: *tcp.Stream, output: *u8, capacity: usize,
    marker: str) usize {
    var quic_controls: quic_runtime.ControlView;
    var total:         usize = 0;
    var rounds:        usize = 0;
    for (rounds < MAX_ROUNDS) {
        serve.poll(?quic_controls, runtime, 2);
        val read: res[usize, io_error.Error] = tcp.stream_read(client, ?output[total],
            capacity - total - 1);
        if (sel read.ok) {
            val count: usize = read.ok;
            total         = total + count;
            output[total] = 0;
            if (count != 0 && contains(output, total, marker)) { ret total; }
        }
        rounds = rounds + 1;
    }
    output[total] = 0;
    ret total;
}

# read until the peer stops producing, so a whole large response is captured
pub fun drain(runtime: *serve.Runtime, client: *tcp.Stream, output: *u8, capacity: usize) usize {
    var quic_controls: quic_runtime.ControlView;
    var total:         usize = 0;
    var idle:          usize = 0;
    var rounds:        usize = 0;
    for (rounds < MAX_ROUNDS && total + 1 < capacity) {
        serve.poll(?quic_controls, runtime, 2);
        val read: res[usize, io_error.Error] = tcp.stream_read(client, ?output[total],
            capacity - total - 1);
        if (sel read.err) {
            idle = idle + 1;
        }
        if (sel read.ok) {
            val count: usize = read.ok;
            if (count == 0) { idle = idle + 1; }
            or              { idle = 0; }
            total = total + count;
        }
        if (idle >= 8) { brk; }
        rounds = rounds + 1;
    }
    output[total] = 0;
    ret total;
}

# --- a minimal HTTP/2 client, written in frames ---
#
# a packaged client cannot be linked into this suite, and the point of the test
# is the wire, so the frames are built here. the header block uses static table
# indices for the pseudo-headers and one literal for the authority.

pub fun put_frame(output: *u8, at: usize, length: usize, kind: u8, flags: u8,
    stream: u32) usize {
    output[at]     = (length >> 16)::u8;
    output[at + 1] = (length >> 8)::u8;
    output[at + 2] = length::u8;
    output[at + 3] = kind;
    output[at + 4] = flags;
    output[at + 5] = (stream >> 24)::u8;
    output[at + 6] = (stream >> 16)::u8;
    output[at + 7] = (stream >> 8)::u8;
    output[at + 8] = stream::u8;
    ret at + 9;
}

pub fun put_text(output: *u8, at: usize, value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) {
        output[at + i] = value[i];
        i              = i + 1;
    }
    ret at + i;
}

# :method GET, :scheme http, :path /id, :authority localhost
pub fun put_header_block(output: *u8, at: usize) usize {
    ret put_path_header_block(output, at, "/id");
}

# :method GET, :scheme http, :path `path` (under 127 bytes), :authority localhost
pub fun put_path_header_block(output: *u8, at: usize, path: str) usize {
    var cursor: usize = at;
    output[cursor] = 0x82;
    cursor         = cursor + 1;
    output[cursor] = 0x86;
    cursor         = cursor + 1;
    # literal with incremental indexing, name index 4 (:path)
    output[cursor] = 0x44;
    cursor         = cursor + 1;
    output[cursor] = str_len(path)::u8;
    cursor         = cursor + 1;
    cursor         = put_text(output, cursor, path);
    # literal with incremental indexing, name index 1 (:authority)
    output[cursor] = 0x41;
    cursor         = cursor + 1;
    output[cursor] = 9;
    cursor         = cursor + 1;
    cursor         = put_text(output, cursor, "localhost");
    ret cursor;
}

# :method POST, :scheme http, :path /submit, :authority localhost
pub fun put_form_header_block(output: *u8, at: usize) usize {
    var cursor: usize = at;
    output[cursor] = 0x83;
    cursor         = cursor + 1;
    output[cursor] = 0x86;
    cursor         = cursor + 1;
    output[cursor] = 0x44;
    cursor         = cursor + 1;
    output[cursor] = 7;
    cursor         = cursor + 1;
    cursor         = put_text(output, cursor, "/submit");
    output[cursor] = 0x41;
    cursor         = cursor + 1;
    output[cursor] = 9;
    cursor         = cursor + 1;
    cursor         = put_text(output, cursor, "localhost");
    ret cursor;
}

pub val PREFACE: str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

pub fun put_connection_start(output: *u8) usize {
    var at: usize = put_text(output, 0, PREFACE);
    ret put_frame(output, at, 0, 0x04, 0, 0);
}

pub fun put_request(output: *u8, at: usize, stream: u32) usize {
    val block_start: usize = at + 9;
    val block_end:   usize = put_header_block(output, block_start);
    put_frame(output, at, block_end - block_start, 0x01, 0x05, stream);
    ret block_end;
}

pub fun put_path_request(output: *u8, at: usize, stream: u32, path: str) usize {
    val block_start: usize = at + 9;
    val block_end:   usize = put_path_header_block(output, block_start, path);
    put_frame(output, at, block_end - block_start, 0x01, 0x05, stream);
    ret block_end;
}

# the first header block byte of the HEADERS frame the server sent on `stream`,
# or 0 when none arrived. the first field is `:status`, so a static-table status
# reads as one byte: 0x88 for 200, 0x8c for 400
pub fun status_byte(buffer: *u8, length: usize, stream: u32) u8 {
    var at: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (buffer[at]::usize << 16) | (buffer[at + 1]::usize << 8)
            | buffer[at + 2]::usize;
        val kind:  u8  = buffer[at + 3];
        val owner: u32 = ((buffer[at + 5] & 0x7f)::u32 << 24) | (buffer[at + 6]::u32 << 16)
            | (buffer[at + 7]::u32 << 8) | buffer[at + 8]::u32;
        if (at + 9 + size > length)                       { ret 0; }
        if (kind == 0x01 && owner == stream && size != 0) { ret buffer[at + 9]; }
        at = at + 9 + size;
    }
    ret 0;
}

pub fun put_open_request(output: *u8, at: usize, stream: u32) usize {
    val block_start: usize = at + 9;
    val block_end:   usize = put_header_block(output, block_start);
    put_frame(output, at, block_end - block_start, 0x01, 0x04, stream);
    ret block_end;
}

# headers only, so the stream stays open for the body frames that follow
pub fun put_form_request(output: *u8, at: usize, stream: u32) usize {
    val block_start: usize = at + 9;
    val block_end:   usize = put_form_header_block(output, block_start);
    put_frame(output, at, block_end - block_start, 0x01, 0x04, stream);
    ret block_end;
}

pub fun put_reset(output: *u8, at: usize, stream: u32, code: u32) usize {
    val payload: usize = put_frame(output, at, 4, 0x03, 0, stream);
    output[payload]     = (code >> 24)::u8;
    output[payload + 1] = (code >> 16)::u8;
    output[payload + 2] = (code >> 8)::u8;
    output[payload + 3] = code::u8;
    ret payload + 4;
}

# reads the request body the way a framework does: a suspended read keeps its
# token, and the service completes it itself when it is entered again
pub rec BodyReader {
    suspensions: usize;
    token:       u64;
    received:    [32]u8;
    length:      usize;
}

pub fun body_reading_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state:  *BodyReader  = context::*BodyReader;
    val reader: *body.Reader = call.request(active).body;
    for {
        var progress: body.Progress;
        if (state.token != 0) {
            progress = body.complete_reader(reader, state.token);
        }
        or {
            progress = body.read(reader, ?state.received[state.length],
                31 - state.length);
        }
        if (progress.status == body.PENDING) {
            state.token       = progress.token;
            state.suspensions = state.suspensions + 1;
            ret call.park(active, call.WAIT_BODY, 0);
        }
        state.token = 0;
        if (progress.status == body.COMPLETE) { brk; }
        if (progress.status != body.DATA)     { ret exchange.SERVICE_FAILED; }
        state.length = state.length + progress.count;
    }
    if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_bytes(active, ?state.received[0], state.length);
}

# waits on a wake it hands out, the way a proxy waits on its upstream link. it
# counts each entry per call, and answers a call once that call is released
pub val HELD_CALLS: usize = 4;

pub rec WakeHolder {
    calls:    [HELD_CALLS]*call.Call;
    entries:  [HELD_CALLS]usize;
    wakers:   [HELD_CALLS]hedge_wake.Waker;
    released: [HELD_CALLS]bool;
    held:     usize;
}

pub fun make_wake_holder(holder: *WakeHolder) {
    var i: usize = 0;
    for (i < HELD_CALLS) {
        holder.calls[i]    = nil;
        holder.entries[i]  = 0;
        holder.wakers[i]   = hedge_wake.no_waker();
        holder.released[i] = false;
        i                  = i + 1;
    }
    holder.held = 0;
}

pub fun wake_holding_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val holder: *WakeHolder = context::*WakeHolder;
    var index:  usize       = 0;
    for (index < holder.held && holder.calls[index] != active) { index = index + 1; }
    if (index == holder.held) {
        if (holder.held == HELD_CALLS) { ret exchange.SERVICE_FAILED; }
        holder.calls[index] = active;
        holder.held         = holder.held + 1;
    }
    holder.entries[index] = holder.entries[index] + 1;
    if (!holder.released[index]) {
        holder.wakers[index] = call.waker(active);
        ret call.park(active, call.WAIT_WAKE, 0);
    }
    if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_text(active, "released");
}

# release the `index`th call the holder saw and wake it through its own waker
pub fun release_held(holder: *WakeHolder, index: usize) bool {
    if (index >= holder.held) { ret false; }
    holder.released[index] = true;
    ret hedge_wake.wake(?holder.wakers[index]);
}

# wake the `index`th call the holder saw without releasing it
pub fun nudge_held(holder: *WakeHolder, index: usize) bool {
    if (index >= holder.held) { ret false; }
    ret hedge_wake.wake(?holder.wakers[index]);
}
