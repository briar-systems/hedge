# end-to-end serving tests: real sockets, real wire bytes, real dispatch

use hedge.clock;
use hedge.config.schema;
use hedge.connection;
use hedge.dispatch;
use hedge.dispatch.call;
use hedge.dispatch.middleware;
use hedge.dispatch.plan;
use hedge.listener;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.serve;
use hedge.service;
use hedge.test.runtime.wire;
use http.core.exchange;
use http.core.message;
use http.core.status;
use http.router.router;
use heap_allocator: std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.net.ip;
use std.net.tcp;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

val MAX_ROUTES:     usize = 8;
val MAX_SEGMENTS:   usize = 64;
val MAX_SERVICES:   usize = 8;
val PLAN_TEXT:      usize = 2048;
val POOL:           usize = 4;
val RESPONSE_BYTES: usize = 4096;

rec Harness {
    graph:             schema.Graph;
    diagnostics:       schema.Diagnostics;
    routes:            [MAX_ROUTES]router.CompiledRoute;
    segments:          [MAX_SEGMENTS]router.Segment;
    specs:             [MAX_ROUTES]router.Route;
    entries:           [MAX_ROUTES]plan.Entry;
    services:          [MAX_SERVICES]service.Descriptor;
    middlewares:       [4]middleware.Middleware;
    text:              [PLAN_TEXT]u8;
    storage:           plan.Storage;
    plan:              plan.Plan;
    heap:              heap_allocator.Allocator;
    runtime:           serve.Runtime;
    applications:      service.Applications;
    application_slots: [4]service.Application;
    resolver:          service.Resolver;
    endpoint:          ip.Endpoint;
}

fun base_graph(graph: *schema.Graph) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "serving-test");
    graph.limits.max_connections          = opt[usize].some{POOL};
    graph.limits.max_connections_per_peer = opt[usize].some{POOL};
    graph.listener_count                  = 1;
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.name, "public");
    schema.set_text(?configured.address, "127.0.0.1:0");
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport    = schema.TRANSPORT_TCP;
    configured.protocols    = schema.PROTOCOL_HTTP1;
    configured.backlog      = 16;
    configured.accept_depth = 2;
    graph.host_count        = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 0;
    graph.route_count   = 0;
}

fun add_service(graph: *schema.Graph, name: str, kind: u8, target: str, code: u16, media: str) {
    val index:      usize           = graph.service_count;
    val configured: *schema.Service = ?graph.services[index];
    schema.set_text(?configured.name, name);
    configured.kind = kind;
    schema.set_text(?configured.target, target);
    schema.clear_text(?configured.budget);
    configured.status = code;
    schema.set_text(?configured.content_type, media);
    graph.service_count = index + 1;
}

fun add_route(graph: *schema.Graph, name: str, path: str, service_name: str) {
    val index:      usize         = graph.route_count;
    val configured: *schema.Route = ?graph.routes[index];
    schema.set_text(?configured.name, name);
    schema.set_text(?configured.host, "site");
    schema.set_text(?configured.path, path);
    schema.set_text(?configured.service, service_name);
    schema.clear_text(?configured.budget);
    graph.route_count = index + 1;
}

fun compile(harness: *Harness, generation: u64) bool {
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret false; }
    ret plan.compile(?harness.plan, generation, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status == plan.PLAN_OK;
}

fun boot(harness: *Harness, generation: u64) bool {
    var quic_controls: quic_runtime.ControlView;
    page.make(?harness.heap);
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret false; }
    schema.reset_diagnostics(?harness.diagnostics);
    if (!serve.start(?quic_controls, ?harness.runtime, generation, ?harness.graph, ?harness.diagnostics)) { ret false; }
    val owned: *listener.OwnedListener = listener.active_listener(?harness.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) { ret false; }
    harness.endpoint = owned.bound_endpoint;
    ret true;
}

fun connect_client(harness: *Harness, client: *tcp.Stream) bool {
    val connected: res[tcp.Stream, io_error.Error] = tcp.connect(harness.endpoint);
    if (sel connected.err) { ret false; }
    @client = connected.ok;
    tcp.stream_set_read_timeout(client, 200);
    ret true;
}

fun send_request(client: *tcp.Stream, request: str) bool {
    val length:  usize                      = str_len(request);
    val written: res[usize, io_error.Error] = tcp.stream_write(client, request::*u8, length);
    if (sel written.err) { ret false; }
    ret written.ok == length;
}

# poll the server until the client has a complete response or the budget runs out
fun collect_response(harness: *Harness, client: *tcp.Stream, output: *u8, capacity: usize,
    expected_terminator: str) usize {
    var quic_controls: quic_runtime.ControlView;
    var total:         usize = 0;
    var rounds:        usize = 0;
    for (rounds < 200) {
        serve.poll(?quic_controls, ?harness.runtime, 5);
        val read: res[usize, io_error.Error] = tcp.stream_read(client,
            ?output[total], capacity - total);
        if (sel read.ok) {
            val count: usize = read.ok;
            total         = total + count;
            output[total] = 0;
            if (count != 0 && contains(output, total, expected_terminator)) { ret total; }
        }
        rounds = rounds + 1;
    }
    output[total] = 0;
    ret total;
}

fun contains(buffer: *u8, length: usize, needle: str) bool {
    val needle_length: usize = str_len(needle);
    if (needle_length == 0 || needle_length > length) { ret false; }
    var i: usize = 0;
    for (i + needle_length <= length) {
        var j: usize = 0;
        for (j < needle_length && buffer[i + j] == needle[j]) { j = j + 1; }
        if (j == needle_length) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun index_of(buffer: *u8, length: usize, needle: str) usize {
    val needle_length: usize = str_len(needle);
    if (needle_length == 0 || needle_length > length) { ret RESPONSE_BYTES; }
    var i: usize = 0;
    for (i + needle_length <= length) {
        var j: usize = 0;
        for (j < needle_length && buffer[i + j] == needle[j]) { j = j + 1; }
        if (j == needle_length) { ret i; }
        i = i + 1;
    }
    ret RESPONSE_BYTES;
}

fun starts_with(buffer: *u8, length: usize, prefix: str) bool {
    val prefix_length: usize = str_len(prefix);
    if (prefix_length > length) { ret false; }
    var i: usize = 0;
    for (i < prefix_length) {
        if (buffer[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "serving: a fixed route answers a real request over a real socket" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "hello from hedge", 200, "text/plain");
    add_route(?harness.graph, "root", "/hello", "greeting");
    if (!compile(?harness, 1)) { ret 1; }
    if (!boot(?harness, 1))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (!send_request(?client, "GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "hello from hedge");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0)                                               { ret 5; }
    if (!starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 6; }
    if (!contains(?response[0], length, "content-type: text/plain")
        && !contains(?response[0], length, "Content-Type: text/plain")) { ret 7; }
    if (!contains(?response[0], length, "16"))                       { ret 8; }
    if (!contains(?response[0], length, "\r\n\r\nhello from hedge")) { ret 9; }
    ret 0;
}

test "serving: an unmatched path answers 404 over a real socket" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "hello", 200, "text/plain");
    add_route(?harness.graph, "root", "/hello", "greeting");
    if (!compile(?harness, 2)) { ret 1; }
    if (!boot(?harness, 2))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (!send_request(?client, "GET /absent HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !starts_with(?response[0], length, "HTTP/1.1 404 Not Found\r\n")) { ret 5; }
    ret 0;
}

test "serving: a redirect route emits its configured status and location" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "docs", schema.SERVICE_REDIRECT, "https://example.test/docs/", 308, nil);
    add_route(?harness.graph, "docs", "/docs", "docs");
    if (!compile(?harness, 3)) { ret 1; }
    if (!boot(?harness, 3))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (!send_request(?client, "GET /docs HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0)                                                   { ret 5; }
    if (!starts_with(?response[0], length, "HTTP/1.1 308 "))           { ret 6; }
    if (!contains(?response[0], length, "https://example.test/docs/")) { ret 7; }
    ret 0;
}

# an application handler sees only the common exchange and the values hedge owns
rec Application {
    calls:              usize;
    route_name_matched: bool;
}

fun application_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state: *Application = context::*Application;
    state.calls              = state.calls + 1;
    state.route_name_matched = str_equals(active.route.name, "app");
    if (message.set_status(call.response(active), status.ACCEPTED) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    if (!service.add_field(active, "x-hedge-route", active.route.name)) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_text(active, "served by an application");
}

rec FinalizingApplication {
    calls:      usize;
    finalizers: usize;
}

fun refuse_finalizer(context: ptr, active: *call.Call) bool {
    val state: *FinalizingApplication = context::*FinalizingApplication;
    state.finalizers = state.finalizers + 1;
    ret false;
}

fun finalizing_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state: *FinalizingApplication = context::*FinalizingApplication;
    state.calls = state.calls + 1;
    if (!call.attach_finalizer(active, call.Finalizer{
        ctx: context, finish: refuse_finalizer
    })) {
        ret exchange.SERVICE_FAILED;
    }
    if (message.set_status(call.response(active), status.OK)
        != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
    ret service.respond_with_text(active, "finalized");
}

test "serving: one connection serves successive requests without reconnecting" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "first", 200, "text/plain");
    add_service(?harness.graph, "other", schema.SERVICE_FIXED, "second", 200, "text/plain");
    add_route(?harness.graph, "root", "/one", "greeting");
    add_route(?harness.graph, "next", "/two", "other");
    if (!compile(?harness, 4)) { ret 1; }
    if (!boot(?harness, 4))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    if (!send_request(?client, "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    val first: usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "first");
    if (first == 0 || !starts_with(?response[0], first, "HTTP/1.1 200 OK\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    if (!send_request(?client, "GET /two HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 6;
    }
    val second:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "second");
    val requests: u64   = connection.snapshot(serve.slot_connection(?harness.runtime, 0)).requests;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (second == 0 || !starts_with(?response[0], second, "HTTP/1.1 200 OK\r\n")) { ret 7; }
    if (!contains(?response[0], second, "second"))                                { ret 8; }
    # both requests were served by the same connection, so the socket was reused
    if (requests != 2) { ret 9; }
    ret 0;
}

test "serving: an idle keep-alive connection is not driven between events" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "first", 200, "text/plain");
    add_route(?harness.graph, "root", "/one", "greeting");
    if (!compile(?harness, 4)) { ret 1; }
    if (!boot(?harness, 4))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    if (!send_request(?client, "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    val first: usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "first");
    # the response's own completions settle before the connection goes quiet
    wire.pump(?harness.runtime, 8);
    val settled: u64 = serve.drives(?harness.runtime);
    wire.pump(?harness.runtime, 50);
    val idle: u64   = serve.drives(?harness.runtime) - settled;
    val live: usize = harness.runtime.live;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (first == 0 || !starts_with(?response[0], first, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    if (settled == 0 || live != 1)                                              { ret 6; }
    if (idle != 0)                                                              { ret 7; }
    ret 0;
}

# serves one request on one keep-alive connection and leaves it idle, the
# state the audit tests start from
fun serve_idle(harness: *Harness, client: *tcp.Stream) i32 {
    base_graph(?harness.graph);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "first", 200, "text/plain");
    add_route(?harness.graph, "root", "/one", "greeting");
    if (!compile(harness, 4))             { ret 1; }
    if (!boot(harness, 4))                { ret 2; }
    if (!connect_client(harness, client)) { ret 3; }
    var response: [RESPONSE_BYTES]u8;
    if (!send_request(client, "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n")) { ret 4; }
    val first: usize = collect_response(harness, client, ?response[0], RESPONSE_BYTES, "first");
    if (first == 0 || !starts_with(?response[0], first, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    wire.pump(?harness.runtime, 8);
    if (harness.runtime.live != 1 || !serve.slot_live(?harness.runtime, 0)) { ret 6; }
    ret 0;
}

# the sweep survives only as an assertion (#182): a connection left holding work
# its next step would do, and on no queue, is what the audit reports
test "serving: the debug audit finds a connection holding work nothing queues" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    var client:        tcp.Stream;
    val served:        i32 = serve_idle(?harness, ?client);
    if (served != 0) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret served;
    }
    val owner: *connection.Connection = ?serve.slot_at(?harness.runtime, 0).connection;
    var code:  i32                    = 0;
    if (serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0) { code = 10; }
    # a request handed over whose exchange never started
    owner.has_pending = true;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1) { code = 11; }
    owner.has_pending = false;
    # a pool wake nobody routed
    owner.account.is_ready = true;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1) { code = 12; }
    owner.account.is_ready = false;
    # bytes the engine holds to write and never submitted
    val held: usize = owner.engine.write_length;
    owner.engine.write_length = 1;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1) { code = 13; }
    owner.engine.write_length = held;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0) { code = 14; }
    # a retiring slot is asked about its waiting close instead (#261): a close
    # that would progress, here a wake the worker never saw, fails the audit,
    # and one waiting on nothing it could do now passes it
    val slot: *serve.Slot = serve.slot_at(?harness.runtime, 0);
    slot.retiring       = true;
    owner.close_pending = true;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0) { code = 15; }
    owner.wake_failed = true;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1) { code = 16; }
    # a slot whose close is not waiting is retired on its own turn, not parked
    owner.close_pending = false;
    if (code == 0 && serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0) { code = 17; }
    owner.wake_failed = false;
    slot.retiring     = false;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    ret code;
}

# the audit runs from the poll loop in a debug build and a served connection
# never trips it, so every serving test is also a run of the assertion
test "serving: the debug audit runs in the poll loop and a served connection passes it" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    var client:        tcp.Stream;
    val served:        i32 = serve_idle(?harness, ?client);
    if (served != 0) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret served;
    }
    var turns: usize = 0;
    for (turns < 256) {
        serve.poll(?quic_controls, ?harness.runtime, 0);
        turns = turns + 1;
    }
    val audits: u64 = serve.audits(?harness.runtime);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    $if ($mach.build.mode == $mach.mode.debug) {
        if (audits < 4) { ret 10; }
    }
    ret 0;
}

test "serving: a registered application answers over a real socket" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "site", schema.SERVICE_LAUREL, "site", 200, nil);
    add_route(?harness.graph, "app", "/app/**", "site");
    var state: Application = Application{calls: 0, route_name_matched: false};
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    if (!service.register_application(?harness.applications, "site", service.Handler{
        ctx: (?state)::ptr,
        serve: application_serve,
    }, 0)) { ret 1; }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret 2; }
    if (plan.compile(?harness.plan, 5, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK) { ret 3; }
    if (!boot(?harness, 5)) { ret 4; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    if (!send_request(?client, "GET /app/page HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 6;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES,
        "served by an application");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !starts_with(?response[0], length, "HTTP/1.1 202 Accepted\r\n")) { ret 7; }
    if (state.calls != 1 || !state.route_name_matched)                                  { ret 8; }
    if (!contains(?response[0], length, "x-hedge-route: app"))                          { ret 9; }
    ret 0;
}

test "serving: a request finalizer failure closes the owning connection" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "site", schema.SERVICE_LAUREL, "site", 200, nil);
    add_route(?harness.graph, "app", "/app", "site");
    var state: FinalizingApplication = FinalizingApplication{
        calls: 0, finalizers: 0
    };
    service.make_applications(?harness.applications,
        ?harness.application_slots[0], 4);
    if (!service.register_application(?harness.applications, "site",
        service.Handler{ctx: (?state)::ptr, serve: finalizing_serve}, 0)) { ret 1; }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)
        || plan.compile(?harness.plan, 51, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 51)) { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)
        || !send_request(?client,
        "GET /app HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0],
        RESPONSE_BYTES, "finalized");
    var polls: usize = 0;
    for (polls < 40 && !connection.finished(serve.slot_connection(?harness.runtime, 0))) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    val closed: bool = connection.finished(serve.slot_connection(?harness.runtime, 0));
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !contains(?response[0], length, "finalized")) { ret 4; }
    if (state.calls != 1 || state.finalizers != 1 || !closed)        { ret 5; }
    ret 0;
}

test "serving: a request body the service never reads is drained without stalling" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "ok", 200, "text/plain");
    add_route(?harness.graph, "root", "/submit", "greeting");
    if (!compile(?harness, 6)) { ret 1; }
    if (!boot(?harness, 6))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (!send_request(?client,
        "POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Length: 11\r\n\r\nhello world")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "\r\n\r\nok");
    val requests: u64   = connection.snapshot(serve.slot_connection(?harness.runtime, 0)).requests;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    if (requests != 1)                                                            { ret 6; }
    ret 0;
}

test "serving: a service that suspends on the request body receives it" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "site", schema.SERVICE_LAUREL, "site", 200, nil);
    add_route(?harness.graph, "upload", "/upload", "site");
    var state: wire.BodyReader = wire.BodyReader{suspensions: 0, token: 0, length: 0};
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    if (!service.register_application(?harness.applications, "site",
        service.Handler{ctx: (?state)::ptr, serve: wire.body_reading_serve}, 0)) { ret 1; }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)
        || plan.compile(?harness.plan, 61, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 61)) { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (!send_request(?client,
        "POST /upload HTTP/1.1\r\nHost: localhost\r\nContent-Length: 11\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    # the body is held back until the service has entered and suspended on it
    var polls: usize = 0;
    for (polls < 40 && state.suspensions == 0) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    if (state.suspensions == 0 || !send_request(?client, "hello world")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES,
        "\r\n\r\nhello world");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 6; }
    if (state.length != 11)                                                       { ret 7; }
    ret 0;
}

# asks the call for one block larger than the server's default request memory
rec LargeAllocation {
    calls:   usize;
    refused: bool;
}

val LARGE_ALLOCATION: usize = 49152;

fun large_allocation_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state: *LargeAllocation = context::*LargeAllocation;
    state.calls = state.calls + 1;
    val block: res[*u8, heap_allocator.Error] =
        heap_allocator.allocate[u8](call.allocator_of(active), LARGE_ALLOCATION);
    if (sel block.err) {
        state.refused = call.memory_refused(active);
        ret exchange.SERVICE_FAILED;
    }
    block.ok[LARGE_ALLOCATION - 1] = 1;
    if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_text(active, "allocated");
}

# serves one request to an application that allocates LARGE_ALLOCATION, with the
# given declared and configured request memory, and returns the response
fun serve_large(harness: *Harness, state: *LargeAllocation, declared: usize,
    configured: usize, generation: u64, response: *u8) usize {
    var quic_controls: quic_runtime.ControlView;
    base_graph(?harness.graph);
    add_service(?harness.graph, "site", schema.SERVICE_LAUREL, "site", 200, nil);
    harness.graph.services[0].memory_bytes = configured;
    add_route(?harness.graph, "large", "/large", "site");
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    if (!service.register_application(?harness.applications, "site",
        service.Handler{ctx: state::ptr, serve: large_allocation_serve}, declared)) { ret 0; }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)
        || plan.compile(?harness.plan, generation, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(harness, generation)) { ret 0; }
    var client: tcp.Stream;
    if (!connect_client(harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 0;
    }
    if (!send_request(?client, "GET /large HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 0;
    }
    val length: usize = collect_response(harness, ?client, response, RESPONSE_BYTES, "\r\n\r\n");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    ret length;
}

test "serving: request memory past the server default is refused and reported" {
    var harness:  Harness;
    var state:    LargeAllocation = LargeAllocation{calls: 0, refused: false};
    var response: [RESPONSE_BYTES]u8;
    val length:   usize           = serve_large(?harness, ?state, 0, 0, 71, ?response[0]);
    if (length == 0 || state.calls != 1)                   { ret 1; }
    if (starts_with(?response[0], length, "HTTP/1.1 200")) { ret 2; }
    if (!state.refused)                                    { ret 3; }
    ret 0;
}

test "serving: an application's declared request memory is what its calls receive" {
    var harness:  Harness;
    var state:    LargeAllocation = LargeAllocation{calls: 0, refused: false};
    var response: [RESPONSE_BYTES]u8;
    val length:   usize           = serve_large(?harness, ?state, 65536, 0, 72, ?response[0]);
    if (length == 0 || state.calls != 1 || state.refused)          { ret 1; }
    if (!starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 2; }
    ret 0;
}

test "serving: a service's configured request memory overrides its application" {
    var harness:  Harness;
    var state:    LargeAllocation = LargeAllocation{calls: 0, refused: false};
    var response: [RESPONSE_BYTES]u8;
    # the application declares too little, and configuration raises it
    val length: usize = serve_large(?harness, ?state, 16384, 65536, 73, ?response[0]);
    if (length == 0 || state.calls != 1 || state.refused)          { ret 1; }
    if (!starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 2; }
    ret 0;
}

test "serving: pipelined requests are answered in order on one connection" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "alpha", schema.SERVICE_FIXED, "AAA", 200, "text/plain");
    add_service(?harness.graph, "beta", schema.SERVICE_FIXED, "BBB", 200, "text/plain");
    add_route(?harness.graph, "one", "/one", "alpha");
    add_route(?harness.graph, "two", "/two", "beta");
    if (!compile(?harness, 7)) { ret 1; }
    if (!boot(?harness, 7))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    # both requests are written before either response is read
    if (!send_request(?client,
        "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\nGET /two HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "BBB");
    val requests: u64   = connection.snapshot(serve.slot_connection(?harness.runtime, 0)).requests;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || requests != 2) { ret 5; }
    val first_at:  usize = index_of(?response[0], length, "AAA");
    val second_at: usize = index_of(?response[0], length, "BBB");
    if (first_at == RESPONSE_BYTES || second_at == RESPONSE_BYTES) { ret 6; }
    # the pipelined response order follows the request order
    if (first_at >= second_at) { ret 7; }
    ret 0;
}

test "serving: a bodyless redirect leaves the connection reusable" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    add_service(?harness.graph, "docs", schema.SERVICE_REDIRECT, "https://example.test/docs/", 308, nil);
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "AFTER", 200, "text/plain");
    add_route(?harness.graph, "docs", "/docs", "docs");
    add_route(?harness.graph, "root", "/after", "greeting");
    if (!compile(?harness, 8)) { ret 1; }
    if (!boot(?harness, 8))    { ret 2; }
    var client: tcp.Stream;
    if (!connect_client(?harness, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    if (!send_request(?client, "GET /docs HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    val first: usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES,
        "https://example.test/docs/");
    if (first == 0 || !starts_with(?response[0], first, "HTTP/1.1 308 Permanent Redirect\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    if (!contains(?response[0], first, "content-length: 0")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 6;
    }
    if (!send_request(?client, "GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 7;
    }
    val second:   usize = collect_response(?harness, ?client, ?response[0], RESPONSE_BYTES, "AFTER");
    val requests: u64   = connection.snapshot(serve.slot_connection(?harness.runtime, 0)).requests;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (second == 0 || !starts_with(?response[0], second, "HTTP/1.1 200 OK\r\n")) { ret 8; }
    if (requests != 2)                                                            { ret 9; }
    ret 0;
}

# a request addressed to a host's second name reached the socket, matched no host
# in dispatch, and was answered 404 while the same name would have negotiated TLS
test "serving: every name a host declares is served over a real socket" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph);
    harness.graph.hosts[0].server_name_count = 2;
    schema.set_text(?harness.graph.hosts[0].server_names[1], "alias.example.test");
    add_service(?harness.graph, "greeting", schema.SERVICE_FIXED, "served by name", 200, "text/plain");
    add_route(?harness.graph, "root", "/hello", "greeting");
    if (!compile(?harness, 40)) { ret 1; }
    if (!boot(?harness, 40))    { ret 2; }
    var response: [RESPONSE_BYTES]u8;

    var first: tcp.Stream;
    if (!connect_client(?harness, ?first)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (!send_request(?first, "GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?first);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    val one: usize = collect_response(?harness, ?first, ?response[0], RESPONSE_BYTES, "served by name");
    tcp.stream_close(?first);
    if (one == 0 || !starts_with(?response[0], one, "HTTP/1.1 200 OK\r\n")) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }

    var second: tcp.Stream;
    if (!connect_client(?harness, ?second)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 6;
    }
    if (!send_request(?second, "GET /hello HTTP/1.1\r\nHost: alias.example.test\r\n\r\n")) {
        tcp.stream_close(?second);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 7;
    }
    val two: usize = collect_response(?harness, ?second, ?response[0], RESPONSE_BYTES, "served by name");
    tcp.stream_close(?second);
    if (two == 0 || !starts_with(?response[0], two, "HTTP/1.1 200 OK\r\n")) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 8;
    }
    if (!contains(?response[0], two, "\r\n\r\nserved by name")) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 9;
    }

    # a name no host declares is still refused, which is what makes the two
    # answers above evidence of two patterns rather than a catch-all
    var stranger: tcp.Stream;
    if (!connect_client(?harness, ?stranger)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 10;
    }
    if (!send_request(?stranger, "GET /hello HTTP/1.1\r\nHost: nothost.example.test\r\n\r\n")) {
        tcp.stream_close(?stranger);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 11;
    }
    val three: usize = collect_response(?harness, ?stranger, ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    tcp.stream_close(?stranger);
    serve.stop(?quic_controls, ?harness.runtime);
    if (three == 0 || !starts_with(?response[0], three, "HTTP/1.1 404 Not Found\r\n")) { ret 12; }
    ret 0;
}
