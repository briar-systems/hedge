fun page_ok(outcome: err[allocator.Error]) bool {
    ret sel outcome.ok;
}

val RESPONSE_BYTES: usize = 4096;

rec Counted {
    inner: *allocator.Allocator;
    calls: usize;
    bytes: usize;
}

fun counted_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
    val counted: *Counted = context::*Counted;
    counted.calls = counted.calls + 1;
    counted.bytes = counted.bytes + size;
    ret counted.inner.fn_allocate(counted.inner.ctx, size, align);
}

fun counted_reallocate(context: ptr, value: ptr, old_size: usize,
    new_size: usize, align: usize) opt[ptr] {
    val counted: *Counted = context::*Counted;
    ret counted.inner.fn_reallocate(counted.inner.ctx, value, old_size, new_size, align);
}

fun counted_deallocate(context: ptr, value: ptr, size: usize, align: usize) i64 {
    val counted: *Counted = context::*Counted;
    ret counted.inner.fn_deallocate(counted.inner.ctx, value, size, align);
}

fun make_counted(output: *allocator.Allocator, state: *Counted,
    inner: *allocator.Allocator) {
    state.inner          = inner;
    state.calls          = 0;
    state.bytes          = 0;
    output.ctx           = state::ptr;
    output.fn_allocate   = counted_allocate;
    output.fn_reallocate = counted_reallocate;
    output.fn_deallocate = counted_deallocate;
}

rec Harness {
    heap:        allocator.Allocator;
    counted:     allocator.Allocator;
    count:       Counted;
    graph:       schema.Graph;
    replacement: schema.Graph;
    diagnostics: schema.Diagnostics;
    runtime:     *composition.Runtime;
    endpoint:    ip.Endpoint;
}

fun graph(harness: *Harness, cache_enabled: bool) {
    val configured: *schema.Graph = ?harness.graph;
    schema.reset_graph(configured);
    schema.set_text(?configured.server_name, "composition-test");
    configured.limits.max_connections          = opt[usize].some{4};
    configured.limits.max_connections_per_peer = opt[usize].some{4};
    configured.listener_count                  = 1;
    val public: *schema.Listener = ?configured.listeners[0];
    schema.set_text(?public.name, "public");
    schema.set_text(?public.address, "127.0.0.1:0");
    schema.clear_text(?public.tls_policy);
    schema.clear_text(?public.budget);
    public.transport          = schema.TRANSPORT_TCP;
    public.protocols          = schema.PROTOCOL_HTTP1;
    public.backlog            = 16;
    public.accept_depth       = 2;
    public.proxy_protocol     = schema.PROXY_OFF;
    public.trusted_peer_count = 0;
    configured.host_count     = 1;
    schema.set_text(?configured.hosts[0].name, "site");
    schema.set_text(?configured.hosts[0].listener, "public");
    configured.hosts[0].server_name_count = 1;
    schema.set_text(?configured.hosts[0].server_names[0], "localhost");
    configured.service_count = 1;
    val fixed: *schema.Service = ?configured.services[0];
    schema.set_text(?fixed.name, "hello");
    fixed.kind = schema.SERVICE_FIXED;
    schema.set_text(?fixed.target, "hello from composition\n");
    schema.clear_text(?fixed.budget);
    schema.set_text(?fixed.content_type, "text/plain");
    schema.clear_text(?fixed.index);
    fixed.precompressed    = false;
    fixed.status           = 200;
    fixed.cache            = cache_enabled;
    configured.route_count = 1;
    schema.set_text(?configured.routes[0].name, "all");
    schema.set_text(?configured.routes[0].host, "site");
    schema.set_text(?configured.routes[0].path, "/**");
    schema.set_text(?configured.routes[0].service, "hello");
    schema.clear_text(?configured.routes[0].budget);
    configured.cache.enabled         = cache_enabled;
    configured.cache.memory_bytes    = 4096;
    configured.cache.max_entry_bytes = 1024;
    configured.cache.entries         = 8;
    configured.cache.disk_bytes      = 0;
    schema.clear_text(?configured.cache.disk_root);
    if (!cache_enabled) {
        configured.cache.disk_bytes = 4096;
        schema.set_text(?configured.cache.disk_root, "out/composition-disabled-cache");
    }
}

fun quic_graph(harness: *Harness) {
    graph(harness, false);
    val configured: *schema.Graph    = ?harness.graph;
    val public:     *schema.Listener = ?configured.listeners[0];
    schema.set_text(?public.name, "quic");
    public.transport = schema.TRANSPORT_QUIC;
    public.protocols = schema.PROTOCOL_HTTP3;
    schema.set_text(?public.tls_policy, "public");
    schema.set_text(?configured.hosts[0].listener, "quic");
    schema.set_text(?configured.hosts[0].server_names[0], "api.example.com");
    configured.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?configured.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate,
        "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key,
        wire.owner_only("test/interop/fixtures/api.key", "out/fixtures/composition/api.key"));
    schema.set_text(?policy.default_name, "api.example.com");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
}

fun prepare(harness: *Harness, cache_enabled: bool) bool {
    if (!page_ok(page.make(?harness.heap))) { ret false; }
    val runtime_memory: res[*composition.Runtime, allocator.Error] =
        allocator.allocate[composition.Runtime](?harness.heap, 1);
    if (sel runtime_memory.err) { ret false; }
    harness.runtime = runtime_memory.ok;
    make_counted(?harness.counted, ?harness.count, ?harness.heap);
    graph(harness, cache_enabled);
    ret true;
}

fun boot(harness: *Harness, controls: *composition.Controls,
    cache_enabled: bool) composition.StartReport {
    ret start_with(harness, controls, composition.default_options());
}

fun start_with(harness: *Harness, controls: *composition.Controls,
    options: composition.Options) composition.StartReport {
    if (composition.quic_required(?harness.graph)
        && !composition.make_controls(controls, ?harness.heap)) {
        ret composition.StartReport{status: composition.START_RUNTIME,
            detail: "quic control storage allocation failed"};
    }
    val started: composition.StartReport = composition.start(harness.runtime, controls,
        ?harness.counted, ?harness.graph, 1, ?harness.diagnostics, options);
    # the address every test connects to is the one the process reports, so a
    # report that loses the listener or its resolved port fails them all
    val bound: *composition.Bound = composition.bound(harness.runtime, 0);
    if (started.status == composition.START_OK && bound != nil
        && composition.bound_count(harness.runtime) == harness.graph.listener_count
        && schema.text_equals(?bound.name, schema.text(?harness.graph.listeners[0].name))
        && bound.transport == harness.graph.listeners[0].transport
        && bound.protocols == harness.graph.listeners[0].protocols
        && bound.address.port != 0) {
        harness.endpoint = bound.address;
    }
    ret started;
}

fun exchange(harness: *Harness) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client,
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.workers[0].serving, ?client,
        ?response[0], RESPONSE_BYTES, "hello from composition");
    tcp.stream_close(?client);
    ret length != 0 && wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        && wire.contains(?response[0], length, "hello from composition\n");
}

fun exchange_request_text(harness: *Harness, request: str, expected: str) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)
        || !wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.workers[0].serving, ?client,
        ?response[0], RESPONSE_BYTES, expected);
    tcp.stream_close(?client);
    ret length != 0 && wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        && wire.contains(?response[0], length, expected);
}

fun exchange_text(harness: *Harness, expected: str) bool {
    ret exchange_request_text(harness,
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n", expected);
}

fun settle_connections(harness: *Harness) bool {
    var quic_controls: quic_runtime.ControlView;
    var rounds:        usize = 0;
    for (rounds < 200 && !serve.idle(?harness.runtime.workers[0].serving)) {
        serve.poll(?quic_controls, ?harness.runtime.workers[0].serving, 1);
        rounds = rounds + 1;
    }
    ret serve.idle(?harness.runtime.workers[0].serving);
}

fun reload_fixed(harness: *Harness, generation: u64, expected: str) bool {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    val target:        usize         = 1 - composition.active_service_generation(harness.runtime);
    var candidate:     *schema.Graph = ?harness.graph;
    if (target == 1) { candidate = ?harness.replacement; }
    @candidate = @harness.runtime.graph;
    schema.set_text(?candidate.services[0].target, expected);
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
        candidate, generation, ?harness.diagnostics);
    if (reloaded.status != composition.START_OK || !exchange_text(harness, expected)
        || serve.superseded(?quic_controls, ?harness.runtime.workers[0].serving) != 0
        || !composition.reclaim_superseded(harness.runtime, ?controls)) { ret false; }
    val active: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, target);
    val retired: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 1 - target);
    ret active.live && active.generation == generation && !retired.live
        && retired.generation == 0;
}

fun event_index(runtime: *composition.Runtime, target: composition.Event) usize {
    var i: usize = 0;
    for (i < runtime.event_count) {
        if (composition.event_at(runtime, i) == target) { ret i; }
        i = i + 1;
    }
    ret runtime.event_count;
}

fun disturb_stack(seed: usize) usize {
    var bytes: [65536]u8;
    var i:     usize = 0;
    for (i < 65536) {
        bytes[i] = (i + seed)::u8;
        i        = i + 1;
    }
    ret bytes[seed % 65536]::usize;
}

test wiring__serves_after_construction_frame {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, true)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_OK) { ret 2; }
    # the connection pool is no longer among them: serve claims its slots and
    # connection records as peers arrive. the worker's buffer pool is one, and
    # the worker record itself another
    if (harness.count.calls != 6) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val services: *composition.ServiceGeneration =
        ?harness.runtime.workers[0].service_generations[0];
    if (services.cache_bindings.items != ?services.cache_binding_storage[0]
        || services.services.caching.ctx != (?services.cache_bindings)::ptr
        || harness.runtime.workers[0].plans[0].storage.services[0].handler.ctx
        != (?services.cache_binding_storage[0])::ptr) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    disturb_stack(17);
    if (!exchange(?harness) || !exchange(?harness)) {
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }
    val caching: *http_cache.Layer = composition.cache(harness.runtime);
    if (caching == nil || http_cache.report(caching).misses == 0) {
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 7;
    }
    val bindings:        usize = event_index(harness.runtime, composition.CACHE_BINDINGS_READY);
    val wrapper:         usize = event_index(harness.runtime, composition.CACHE_WRAPPER_READY);
    val compiled:        usize = event_index(harness.runtime, composition.PLAN_READY);
    val serve_stop:      usize = event_index(harness.runtime, composition.SERVE_STOPPED);
    val telemetry_close: usize = event_index(harness.runtime,
        composition.TELEMETRY_CLOSED);
    val tls:         usize = event_index(harness.runtime, composition.TLS_DESTROYED);
    val cache_close: usize = event_index(harness.runtime, composition.CACHE_CLOSED);
    if (!(bindings < wrapper && wrapper < compiled)) { ret 8; }
    if (!(serve_stop < telemetry_close && telemetry_close < tls
        && tls < cache_close)) { ret 9; }
    ret 0;
}

test cache__disabled_acquires_nothing {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    # the worker record, the telemetry queue and the worker's buffer pool are
    # allocated
    if (harness.count.calls != 3 || composition.cache(harness.runtime) != nil) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    if (!exchange(?harness)) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.cleanup_failures != 0) { ret 5; }
    if (event_index(harness.runtime, composition.CACHE_BINDINGS_READY)
        != harness.runtime.event_count) { ret 6; }
    if (event_index(harness.runtime, composition.CACHE_WRAPPER_READY)
        != harness.runtime.event_count) { ret 7; }
    if (event_index(harness.runtime, composition.CACHE_CLOSED)
        != harness.runtime.event_count) { ret 8; }
    ret 0;
}

test quic__pumps_publish_reload_and_release {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    if (!prepare(?harness, false)) { ret 1; }
    quic_graph(?harness);
    harness.graph.limits.max_connections = opt[usize].none{};
    # below any kernel cap, so the socket must report at least this much
    harness.graph.listeners[0].receive_buffer_bytes = opt[usize].some{65536};
    harness.graph.listeners[0].send_buffer_bytes    = opt[usize].some{65536};
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK)                { ret 2; }
    if (!composition.controls_view(?controls, ?quic_controls)) { ret 2; }
    val owned: *listener.OwnedListener = listener.active_listener(
        ?harness.runtime.workers[0].serving.owner, 0);
    val initial: quic_runtime.Snapshot = quic_runtime.snapshot(?quic_controls,
        ?harness.runtime.workers[0].quic);
    if (owned == nil || !owned.has_udp_socket || !owned.has_bound_endpoint
        || owned.bound_endpoint.port == 0 || !initial.initialized
        || initial.pumps != 1 || initial.live != 0
        # a listening QUIC pump with no configured limit holds no per-connection
        # storage until a connection arrives
        || storage.pair_capacity[quic_runtime.ConnectionStorage, quic_runtime.Connection](
        ?controls.connections) != 0
        || storage.secret_table_capacity[tls_server.Handshake](?controls.handshakes) != 0
        || storage.pair_capacity[h3_session.SessionStorage, h3_session.Session](
        ?controls.sessions) != 0
        || harness.runtime.workers[0].quic.pending_initials.slab.capacity != 0
        || harness.runtime.workers[0].quic.routes.capacity != 0
        || harness.runtime.workers[0].serving.timers.entries.slab.capacity != 0
        || serve.socket_buffers(?harness.runtime.workers[0].serving, 0).receive_requested != 65536
        || serve.socket_buffers(?harness.runtime.workers[0].serving, 0).receive_effective < 65536
        || serve.socket_buffers(?harness.runtime.workers[0].serving, 0).send_requested != 65536
        || serve.socket_buffers(?harness.runtime.workers[0].serving, 0).send_effective < 65536
        || harness.runtime.workers[0].serving.state != serve.READY
        || !serve.poll(?quic_controls, ?harness.runtime.workers[0].serving, 0)) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    harness.replacement = harness.graph;
    schema.set_text(?harness.replacement.services[0].target,
        "quic generation two\n");
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.diagnostics);
    val updated: quic_runtime.Snapshot = quic_runtime.snapshot(?quic_controls,
        ?harness.runtime.workers[0].quic);
    if (reloaded.status != composition.START_OK
        || harness.runtime.workers[0].serving.generation != 2 || updated.pumps != 1
        || updated.superseded != 0
        || !composition.reclaim_superseded(harness.runtime, ?controls)) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped:  composition.StopReport = composition.stop(harness.runtime, ?controls);
    val released: quic_runtime.Snapshot  = quic_runtime.snapshot(?quic_controls,
        ?harness.runtime.workers[0].quic);
    if (!stopped.stopped || stopped.serve_failures != 0
        || stopped.cleanup_failures != 0 || released.initialized
        || harness.runtime.workers[0].serving.state != serve.STOPPED
        || owned.has_udp_socket) { ret 5; }
    if (!composition.release_controls(?controls)) { ret 6; }
    ret 0;
}

test start__failure_unwinds_resources {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, true)) { ret 1; }
    schema.set_text(?harness.graph.listeners[0].tls_policy, "broken");
    harness.graph.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?harness.graph.tls_policies[0];
    schema.set_text(?policy.name, "broken");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "localhost");
    schema.set_text(?policy.identities[0].certificate, "missing-certificate.pem");
    schema.set_text(?policy.identities[0].key, "missing-key.pem");
    schema.set_text(?policy.default_name, "localhost");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_CONFIG) { ret 2; }
    if (hedge_tls.count() != 0 || harness.runtime.workers[0].proxying.live
        || composition.cache(harness.runtime) != nil
        || harness.runtime.workers[0].service_generations[0].static_registry.len != 0) { ret 3; }
    val tls:          usize = event_index(harness.runtime, composition.TLS_DESTROYED);
    val proxy:        usize = event_index(harness.runtime, composition.PROXY_CLOSED);
    val cache_close:  usize = event_index(harness.runtime, composition.CACHE_CLOSED);
    val static_close: usize = event_index(harness.runtime, composition.STATIC_CLOSED);
    if (!(tls < proxy && proxy < cache_close && cache_close < static_close)) { ret 4; }
    if (event_index(harness.runtime, composition.SERVE_STOPPED)
        != harness.runtime.event_count) { ret 5; }
    ret 0;
}

#[testing]
fun no_entropy() opt[siphash.Key] {
    ret opt[siphash.Key].none{};
}

# without entropy the peer-keyed tables cannot be keyed, so the process refuses
# to start and builds nothing, rather than keying them with a guessable value
test start__refused_without_entropy {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, true)) { ret 1; }
    var options: composition.Options = composition.default_options();
    options.entropy = no_entropy;
    val started: composition.StartReport = start_with(?harness, ?controls, options);
    if (started.status != composition.START_RUNTIME
        || !str_equals(started.detail, composition.ENTROPY_UNAVAILABLE)) { ret 2; }
    if (harness.runtime.workers != nil || composition.cache(harness.runtime) != nil) { ret 3; }
    ret 0;
}

test reload__pins_old_registry_and_reclaims {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    if (!prepare(?harness, true)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_OK) { ret 2; }

    var old: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?old)
        || !wire.send(?old, "GET / HTTP/1.1\r\nHost: localhost\r\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    var rounds: usize = 0;
    for (rounds < 16) {
        serve.poll(?quic_controls, ?harness.runtime.workers[0].serving, 1);
        rounds = rounds + 1;
    }
    harness.replacement = harness.graph;
    schema.set_text(?harness.replacement.services[0].target, "generation two\n");
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.diagnostics);
    if (reloaded.status != composition.START_OK
        || serve.superseded(?quic_controls, ?harness.runtime.workers[0].serving) != 1) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val first:  composition.ServiceSnapshot = composition.service_snapshot(harness.runtime, 0);
    val second: composition.ServiceSnapshot = composition.service_snapshot(harness.runtime, 1);
    if (!first.live || first.generation != 1 || !second.live || second.generation != 2) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }
    if (composition.reload(harness.runtime, ?controls, ?harness.graph, 3, ?harness.diagnostics).status == composition.START_OK) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }
    if (!wire.send(?old, "\r\n")) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 7;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.workers[0].serving, ?old,
        ?response[0], RESPONSE_BYTES, "hello from composition\n");
    tcp.stream_close(?old);
    if (length == 0 || !wire.contains(?response[0], length, "hello from composition\n")
        || !exchange_text(?harness, "generation two\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 8;
    }
    rounds = 0;
    for (rounds < 200 && serve.superseded(?quic_controls, ?harness.runtime.workers[0].serving) != 0) {
        serve.poll(?quic_controls, ?harness.runtime.workers[0].serving, 1);
        rounds = rounds + 1;
    }
    if (serve.superseded(?quic_controls, ?harness.runtime.workers[0].serving) != 0
        || !composition.service_snapshot(harness.runtime, 0).live
        || !composition.reclaim_superseded(harness.runtime, ?controls)
        || composition.service_snapshot(harness.runtime, 0).live) {
        composition.stop(harness.runtime, ?controls);
        ret 9;
    }

    var generation: u64 = 3;
    for (generation < 19) {
        if (!reload_fixed(?harness, generation, "reloaded generation\n")) {
            composition.stop(harness.runtime, ?controls);
            ret 10;
        }
        generation = generation + 1;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 11;
    }
    ret 0;
}

test reload__static_closes_retired_roots {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    harness.graph.services[0].kind = schema.SERVICE_STATIC;
    schema.set_text(?harness.graph.services[0].target, "test/interop/public");
    schema.set_text(?harness.graph.services[0].index, "index.html");
    harness.graph.services[0].precompressed = false;
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK
        || !exchange_request_text(?harness,
        "GET /files/large.txt HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "line 000001") || !settle_connections(?harness)) {
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    var generation: u64 = 2;
    for (generation < 18) {
        val target:    usize         = 1 - composition.active_service_generation(harness.runtime);
        var candidate: *schema.Graph = ?harness.graph;
        if (target == 1) { candidate = ?harness.replacement; }
        @candidate                          = @harness.runtime.graph;
        candidate.services[0].precompressed = !candidate.services[0].precompressed;
        schema.reset_diagnostics(?harness.diagnostics);
        val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
            candidate, generation, ?harness.diagnostics);
        val active: composition.ServiceSnapshot =
            composition.service_snapshot(harness.runtime, target);
        val retired: composition.ServiceSnapshot =
            composition.service_snapshot(harness.runtime, 1 - target);
        if (reloaded.status != composition.START_OK || !active.live
            || active.static_roots != 1 || !retired.live || retired.static_roots != 1
            || !composition.reclaim_superseded(harness.runtime, ?controls)
            || composition.service_snapshot(harness.runtime, 1 - target).static_roots != 0
            || !exchange_request_text(?harness,
            "GET /files/large.txt HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
            "line 000001") || !settle_connections(?harness)) {
            composition.stop(harness.runtime, ?controls);
            ret 3;
        }
        generation = generation + 1;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

test reload__failed_generation_leaves_active {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, false);
