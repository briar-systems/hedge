        composition.service_snapshot(harness.runtime, 1);
    if (rejected.status != composition.START_CONFIG || candidate.live
        || candidate.static_roots != 0
        || composition.active_service_generation(harness.runtime) != 0
        || !exchange_text(?harness, "hello from composition\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

test reload__process_owned_change_rejected {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    if (!prepare(?harness, true)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_OK) { ret 2; }
    val active_before: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 0);
    harness.replacement                    = harness.graph;
    harness.replacement.cache.memory_bytes = harness.graph.cache.memory_bytes + 1;
    schema.reset_diagnostics(?harness.diagnostics);
    val rejected: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.diagnostics);
    val active_after: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 0);
    val candidate: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 1);
    if (rejected.status != composition.START_CONFIG
        || composition.active_service_generation(harness.runtime) != 0
        || harness.runtime.graph != ?harness.graph
        || active_after.generation != active_before.generation
        || active_after.live != active_before.live
        || active_after.cache_bindings != active_before.cache_bindings
        || candidate.live || candidate.generation != 0
        || serve.superseded(?quic_controls, ?harness.runtime.workers[0].serving) != 0
        || !exchange_text(?harness, "hello from composition\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

fun exchange_status(harness: *Harness, request: str, status_line: str) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)
        || !wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.workers[0].serving, ?client,
        ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    tcp.stream_close(?client);
    ret length != 0 && wire.starts_with(?response[0], length, status_line);
}

fun application_graph(harness: *Harness) {
    graph(harness, false);
    val site: *schema.Service = ?harness.graph.services[0];
    schema.set_text(?site.name, "application");
    site.kind = schema.SERVICE_APPLICATION;
    schema.set_text(?site.target, "site");
    schema.clear_text(?site.content_type);
    schema.set_text(?harness.graph.routes[0].service, "application");
}

# a registered application that answers 202 and counts the requests it served
fun serve_registered(context: ptr, active: *call.Call) http_exchange.ServiceStatus {
    atomic.fetch_add(context::*i64, 1);
    ret service.respond(active, status.ACCEPTED);
}

test application__resolves_at_start_and_reload {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    application_graph(?harness);
    var served:   i64 = 0;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    if (!service.make_applications(?registry, ?slots[0], 1)
        || !service.register_application(?registry, "site",
        service.Handler{ctx: (?served)::ptr, serve: serve_registered}, 0)) { ret 3; }
    var options: composition.Options = composition.default_options();
    options.applications = ?registry;
    val started: composition.StartReport = start_with(?harness, ?controls,
        options);
    if (started.status != composition.START_OK) { ret 4; }
    if (!exchange_status(?harness,
        "GET /orders/42 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "HTTP/1.1 202 Accepted\r\n") || atomic.load(?served) != 1) {
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }

    # the reloaded plan resolves the same registration
    harness.replacement = harness.graph;
    schema.set_text(?harness.replacement.routes[0].path, "/orders/**");
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime,
        ?controls, ?harness.replacement, 2, ?harness.diagnostics);
    if (reloaded.status != composition.START_OK
        || !settle_connections(?harness)
        || !composition.reclaim_superseded(harness.runtime, ?controls)
        || !exchange_status(?harness,
        "GET /orders/7 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "HTTP/1.1 202 Accepted\r\n") || atomic.load(?served) != 2) {
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 7;
    }
    ret 0;
}

test application__unregistered_is_config_error {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    application_graph(?harness);
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_CONFIG
        || !str_equals(started.detail, "no application is registered under this name")) {
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    ret 0;
}

# an upgraded connection's owner: it echoes what the client sends. on a drain
# it says bye and waits for the client to close, unless it stays, and then the
# drain deadline cuts it
rec Echo {
    app:         *Upgrades;
    stays:       bool;
    buffer:      [64]u8;
    length:      usize;
    offset:      usize;
    reading:     bool;
    writing:     bool;
    read_token:  transport.Token;
    write_token: transport.Token;
    peer_closed: bool;
    said_bye:    bool;
    started:     bool;
}

rec Upgrades {
    done:      usize;
    failed:    usize;
    abandoned: usize;
}

fun echo_submit(echo: *Echo, tunnel: *call.Tunnel) bool {
    if (!echo.writing && echo.offset < echo.length) {
        val written: res[transport.Token, io_error.Error] = transport.write(tunnel.transport,
            tunnel.scope, ?echo.buffer[echo.offset], echo.length - echo.offset, 0);
        if (sel written.err) { ret false; }
        echo.write_token = written.ok;
        echo.writing     = true;
    }
    if (!echo.reading && !echo.writing && echo.offset == echo.length && !echo.peer_closed) {
        val read: res[transport.Token, io_error.Error] = transport.read(tunnel.transport,
            tunnel.scope, ?echo.buffer[0], 64, 0);
        if (sel read.err) { ret false; }
        echo.read_token = read.ok;
        echo.reading    = true;
    }
    ret true;
}

fun echo_drive(context: ptr, tunnel: *call.Tunnel,
    completion: *transport.Completion) call.TunnelStatus {
    val echo: *Echo = context::*Echo;
    if (!echo.started) {
        echo.started = true;
        var i: usize = 0;
        for (i < tunnel.input_length && i < 64) {
            echo.buffer[i] = tunnel.input[i];
            i              = i + 1;
        }
        echo.length = i;
        echo.offset = 0;
    }
    if (completion != nil) {
        if (!transport.complete(tunnel.transport, completion)) {
            echo.app.failed = echo.app.failed + 1;
            ret call.TUNNEL_FAILED;
        }
        if (completion.kind == transport.READ) {
            echo.reading = false;
            if (completion.status != transport.IO_COMPLETE || completion.count == 0) {
                echo.peer_closed = true;
            }
            or {
                echo.length = completion.count;
                echo.offset = 0;
            }
        }
        or (completion.kind == transport.WRITE) {
            echo.writing = false;
            if (completion.status != transport.IO_COMPLETE) {
                echo.app.failed = echo.app.failed + 1;
                ret call.TUNNEL_FAILED;
            }
            echo.offset = echo.offset + completion.count;
        }
    }
    if (tunnel.draining && !echo.stays && !echo.said_bye && echo.offset == echo.length
        && !echo.writing) {
        echo.said_bye  = true;
        echo.buffer[0] = 'b'::u8;
        echo.buffer[1] = 'y'::u8;
        echo.buffer[2] = 'e'::u8;
        echo.length    = 3;
        echo.offset    = 0;
    }
    if (echo.peer_closed && !echo.reading && !echo.writing) {
        echo.app.done = echo.app.done + 1;
        ret call.TUNNEL_DONE;
    }
    if (!echo.peer_closed && !echo_submit(echo, tunnel)) {
        echo.app.failed = echo.app.failed + 1;
        ret call.TUNNEL_FAILED;
    }
    ret call.TUNNEL_PENDING;
}

fun echo_abandon(context: ptr, tunnel: *call.Tunnel) {
    val echo: *Echo = context::*Echo;
    echo.app.abandoned = echo.app.abandoned + 1;
}

# an application that answers an upgrade to `echo` with a 101, or a CONNECT
# with a 200, and runs the connection afterwards from the request arena.
# `/stay` ignores a drain
fun serve_upgrade(context: ptr, active: *call.Call) http_exchange.ServiceStatus {
    val arena: *allocator.Allocator        = call.allocator_of(active);
    val made:  res[*Echo, allocator.Error] = allocator.zallocate[Echo](arena, 1);
    if (sel made.err) { ret http_exchange.SERVICE_FAILED; }
    val echo: *Echo = made.ok;
    echo.app = context::*Upgrades;
    val path: view.View = call.request(active).target.path;
    echo.stays = path.len > 1 && path.data[1] == 's'::u8;
    if (!call.tunnel(active, call.TunnelOwner{ctx: echo::ptr, drive: echo_drive,
        abandon: echo_abandon})) {
        ret http_exchange.SERVICE_FAILED;
    }
    if (call.request(active).method.kind == method.CONNECT) {
        if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK) {
            ret http_exchange.SERVICE_FAILED;
        }
        ret service.commit_bodyless(active, call.BODY_DRAIN);
    }
    if (message.set_status(call.response(active), status.SWITCHING_PROTOCOLS)
        != message.RESPONSE_OK
        || !service.add_field(active, "upgrade", "echo")
        || !service.add_field(active, "connection", "upgrade")) {
        ret http_exchange.SERVICE_FAILED;
    }
    ret service.commit_bodyless(active, call.BODY_DRAIN);
}

fun start_upgrades(harness: *Harness, controls: *composition.Controls,
    registry: *service.Applications, slots: *service.Application,
    upgrades: *Upgrades, drain_ms: u64, secure: bool) bool {
    if (!prepare(harness, false)) { ret false; }
    application_graph(harness);
    harness.graph.route_count = 2;
    val tunnel: *schema.Route = ?harness.graph.routes[1];
    schema.set_text(?tunnel.name, "tunnel");
    schema.set_text(?tunnel.host, "site");
    schema.set_text(?tunnel.authority, "db.internal:5432");
    schema.set_text(?tunnel.service, "application");
    if (secure)        { secure_graph(harness, schema.PROTOCOL_HTTP1); }
    if (drain_ms != 0) { harness.graph.timeouts.drain_ms = drain_ms; }
    if (!service.make_applications(registry, slots, 1)
        || !service.register_application(registry, "site",
        service.Handler{ctx: upgrades::ptr, serve: serve_upgrade}, 0)) { ret false; }
    var options: composition.Options = composition.default_options();
    options.applications = registry;
    ret start_with(harness, controls, options).status == composition.START_OK;
}

# send `request` and `input` behind it, and see `status_line`, `field` when
# given, and then `input` echoed through the tunnel it opened
fun open_tunnel(harness: *Harness, client: *tcp.Stream, request: str, input: str,
    status_line: str, field: str) bool {
    if (!wire.connect(harness.endpoint, client))                  { ret false; }
    if (!wire.send(client, request) || !wire.send(client, input)) { ret false; }
    var response: [RESPONSE_BYTES]u8;
    val read:     usize = wire.collect(?harness.runtime.workers[0].serving, client,
        ?response[0], RESPONSE_BYTES, input);
    ret read != 0 && wire.starts_with(?response[0], read, status_line)
        && (field == nil || wire.contains(?response[0], read, field))
        && wire.body_offset(?response[0], read) < read;
}

# upgrade on `path` and see `input` echoed past the 101
fun open_echo(harness: *Harness, client: *tcp.Stream, path: str, input: str) bool {
    var request: [256]u8;
    val length:  usize = wire.build_request(?request[0], 256, "GET ", path::*u8,
        str_len(path), " HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: echo\r\n\r\n");
    ret length != 0 && open_tunnel(harness, client, (?request[0])::str, input,
        "HTTP/1.1 101 Switching Protocols\r\n", "upgrade: echo");
}

fun echoes(harness: *Harness, client: *tcp.Stream, text: str) bool {
    if (!wire.send(client, text)) { ret false; }
    var response: [RESPONSE_BYTES]u8;
    val read:     usize = wire.collect(?harness.runtime.workers[0].serving, client,
        ?response[0], RESPONSE_BYTES, text);
    ret read != 0 && wire.contains(?response[0], read, text);
}

# a hosted application answers an upgrade with a 101 and owns the connection
# afterwards: the bytes sent past the request reach it, it echoes through the
# connection, and it ends when the client closes
test tunnel__hosted_upgrade_owns_the_connection {
    var controls: composition.Controls;
    var harness:  Harness;
    var registry: service.Applications;
    var slots:    [1]service.Application;
    var upgrades: Upgrades;
    upgrades.done      = 0;
    upgrades.failed    = 0;
    upgrades.abandoned = 0;
    if (!start_upgrades(?harness, ?controls, ?registry, ?slots[0], ?upgrades, 0, false)) { ret 1; }
    var client: tcp.Stream;
    if (!open_echo(?harness, ?client, "/echo", "hello") || !echoes(?harness, ?client, "again")) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    tcp.stream_close(?client);
    val storage: *connection.Storage = ?harness.runtime.workers[0].serving.storage;
    if (!settle_connections(?harness) || upgrades.done != 1 || upgrades.failed != 0
        || upgrades.abandoned != 0 || storage.tunnels_opened != 1
        || storage.tunnels_ended != 1 || storage.tunnels_abandoned != 0) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

# a CONNECT reaches a hosted handler through the route matching its authority,
# and the 200 it answers leaves the connection to it as a tunnel. a CONNECT to
# an authority no route matches is refused and reaches no handler
test tunnel__routed_connect_reaches_a_hosted_handler {
    var controls: composition.Controls;
    var harness:  Harness;
    var registry: service.Applications;
    var slots:    [1]service.Application;
    var upgrades: Upgrades;
    upgrades.done      = 0;
    upgrades.failed    = 0;
    upgrades.abandoned = 0;
    if (!start_upgrades(?harness, ?controls, ?registry, ?slots[0], ?upgrades, 0, false)) { ret 1; }
    var client: tcp.Stream;
    if (!open_tunnel(?harness, ?client,
        "CONNECT db.internal:5432 HTTP/1.1\r\nHost: db.internal:5432\r\n\r\n", "hello",
        "HTTP/1.1 200 OK\r\n", nil) || !echoes(?harness, ?client, "again")) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    tcp.stream_close(?client);
    if (!exchange_status(?harness,
        "CONNECT other.internal:5432 HTTP/1.1\r\nHost: other.internal:5432\r\n\r\n",
        "HTTP/1.1 404 Not Found\r\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val storage: *connection.Storage = ?harness.runtime.workers[0].serving.storage;
    if (!settle_connections(?harness) || upgrades.done != 1 || upgrades.failed != 0
        || upgrades.abandoned != 0 || storage.tunnels_opened != 1
        || storage.tunnels_ended != 1) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 5;
    }
    ret 0;
}

# a drain reaches a tunnel as its owner's to wind down: one says bye and ends
# once the client closes, and one that stays is cut at the drain deadline
test tunnel__drain_winds_down_or_cuts_at_the_deadline {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    var registry:      service.Applications;
    var slots:         [1]service.Application;
    var upgrades:      Upgrades;
    upgrades.done      = 0;
    upgrades.failed    = 0;
    upgrades.abandoned = 0;
    clock.freeze();
    if (!start_upgrades(?harness, ?controls, ?registry, ?slots[0], ?upgrades, 300, false)) { ret 1; }
    val serving: *serve.Runtime = ?harness.runtime.workers[0].serving;
    var leaving: tcp.Stream;
    var staying: tcp.Stream;
    if (!open_echo(?harness, ?leaving, "/echo", "one")
        || !open_echo(?harness, ?staying, "/stay", "two")
        || !serve.begin_shutdown(?quic_controls, serving, clock.instant())) {
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    var response: [RESPONSE_BYTES]u8;
    val read:     usize = wire.collect(serving, ?leaving, ?response[0], RESPONSE_BYTES, "bye");
    tcp.stream_close(?leaving);
    if (read == 0 || !wire.contains(?response[0], read, "bye")) {
        tcp.stream_close(?staying);
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    clock.skip_waits(true);
    var rounds: usize = 0;
    for (rounds < 400 && serving.live != 0) {
        serve.poll(?quic_controls, serving, 5);
        rounds = rounds + 1;
    }
    clock.skip_waits(false);
    tcp.stream_close(?staying);
    val storage: *connection.Storage = ?serving.storage;
    if (serving.live != 0 || upgrades.done != 1 || upgrades.abandoned != 1
        || upgrades.failed != 0 || storage.tunnels_opened != 2
        || storage.tunnels_ended != 2 || storage.tunnels_abandoned != 1) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 5;
    }
    ret 0;
}

# over TLS the tunnel's stream is the secure channel, whose completions reach
# the owner through the connection's own step
test tunnel__hosted_upgrade_over_tls {
    var controls: composition.Controls;
    var harness:  Harness;
    var registry: service.Applications;
    var slots:    [1]service.Application;
    var upgrades: Upgrades;
    upgrades.done      = 0;
    upgrades.failed    = 0;
    upgrades.abandoned = 0;
    if (!start_upgrades(?harness, ?controls, ?registry, ?slots[0], ?upgrades, 0, true)) {
        ret 1;
    }
    val client:   *tlswire.Client = tlswire.allocate(?harness.heap);
    var response: [RESPONSE_BYTES]u8;
    if (client == nil
        || !tlswire.make(client, ?harness.runtime.workers[0].serving, "api.example.com",
        "http/1.1")
        || !tlswire.handshake(client, harness.endpoint)
        || !send_text(client, "GET /echo HTTP/1.1\r\nHost: api.example.com\r\nConnection: Upgrade\r\nUpgrade: echo\r\n\r\nhello")) {
        if (client != nil) { tlswire.release(client); }
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    val head: usize = tlswire.receive(client, ?response[0], RESPONSE_BYTES, "hello");
    if (head == 0
        || !wire.starts_with(?response[0], head, "HTTP/1.1 101 Switching Protocols\r\n")
        || !send_text(client, "again")
        || tlswire.receive(client, ?response[0], RESPONSE_BYTES, "again") == 0
        || !tlswire.close_notify(client)) {
        tlswire.release(client);
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val settled: bool = settle_connections(?harness);
    tlswire.release(client);
    val storage: *connection.Storage = ?harness.runtime.workers[0].serving.storage;
    if (!settled || upgrades.done != 1 || upgrades.failed != 0 || upgrades.abandoned != 0
        || storage.tunnels_opened != 1 || storage.tunnels_ended != 1) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 5;
    }
    ret 0;
}

val SILENT_TIMEOUT_MS: u64 = 300;

# a peer that connects and never sends is closed once the handshake timeout
# passes. the deadline was once built from the wall clock while io enforces the
# monotonic one, so it never arrived and the slot was held for good (#168)
#[testing]
fun silent_peer_is_closed(harness: *Harness) i32 {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret 10; }
    val closed: i32 = closed_within(harness, SILENT_TIMEOUT_MS);
    tcp.stream_close(?client);
    ret closed;
}

test handshake_timeout__closes_silent_cleartext_peer {
    var controls: composition.Controls;
    var harness:  Harness;
    clock.freeze();
    if (!prepare(?harness, false)) { ret 1; }
    harness.graph.timeouts.handshake_ms = SILENT_TIMEOUT_MS;
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    val result: i32 = silent_peer_is_closed(?harness);
    composition.stop(harness.runtime, ?controls);
    ret result;
}

# the fixture listener speaks TLS with the interop certificate for api.example.com
fun secure_graph(harness: *Harness, protocols: u8) {
    val configured: *schema.Graph    = ?harness.graph;
    val public:     *schema.Listener = ?configured.listeners[0];
    schema.set_text(?public.tls_policy, "public");
    public.protocols = protocols;
    schema.set_text(?configured.hosts[0].server_names[0], "api.example.com");
    configured.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?configured.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate,
        "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key,
        wire.owner_only("test/interop/fixtures/api.key", "out/fixtures/composition/api.key"));
    schema.set_text(?policy.default_name, "api.example.com");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
}

test handshake_timeout__closes_silent_tls_peer {
    var controls: composition.Controls;
    var harness:  Harness;
    clock.freeze();
    if (!prepare(?harness, false)) { ret 1; }
    secure_graph(?harness, schema.PROTOCOL_HTTP1);
    harness.graph.timeouts.handshake_ms = SILENT_TIMEOUT_MS;
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    val result: i32 = silent_peer_is_closed(?harness);
    composition.stop(harness.runtime, ?controls);
    ret result;
}

# a TLS client that stalls after its first byte (#189). each case holds a
# connection the way a slow client would, on a frozen clock. the connection has
# to be held while the clock stands still, and gone once waits have passed the
# timeout that governs that stall, so a close for some other reason does not pass.

val STALL_TIMEOUT_MS: u64 = 300;
val LONG_TIMEOUT_MS:  u64 = 20000;

fun stall_graph(harness: *Harness, protocols: u8, handshake_ms: u64) {
    secure_graph(harness, protocols);
    harness.graph.timeouts.handshake_ms  = handshake_ms;
    harness.graph.timeouts.header_ms     = STALL_TIMEOUT_MS;
    harness.graph.timeouts.keep_alive_ms = STALL_TIMEOUT_MS;
}

# the connection is held while the frozen clock stands still, and closed once
# waits have passed `timeout_ms` on it. returns 0, or the step that failed
#[testing]
fun closed_within(harness: *Harness, timeout_ms: u64) i32 {
    var quic_controls: quic_runtime.ControlView;
    val serving:       *serve.Runtime = ?harness.runtime.workers[0].serving;
    val held:          time.Instant   = clock.instant();
    var rounds:        usize          = 0;
    for (rounds < 400 && serving.live == 0) {
        serve.poll(?quic_controls, serving, 1);
        rounds = rounds + 1;
    }
    rounds = 0;
    for (rounds < 8) {
        serve.poll(?quic_controls, serving, 5);
        rounds = rounds + 1;
    }
    if (serving.live == 0) { ret 20; }
    clock.skip_waits(true);
    rounds = 0;
    for (rounds < 400 && serving.live != 0) {
        serve.poll(?quic_controls, serving, 5);
        rounds = rounds + 1;
    }
    clock.skip_waits(false);
    if (serving.live != 0)                                                     { ret 21; }
    if (time.instant_sub(clock.instant(), held) < (timeout_ms * 1000000)::i64) { ret 22; }
    ret 0;
}

rec Stall {
    controls: composition.Controls;
    harness:  Harness;
    client:   *tlswire.Client;
}

#[testing]
fun stall_start(stall: *Stall, protocols: u8, handshake_ms: u64, alpn: str) i32 {
    clock.freeze();
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, protocols, handshake_ms);
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.workers[0].serving,
        "api.example.com", alpn)) {
        composition.stop(stall.harness.runtime, ?stall.controls);
        ret 3;
    }
    ret 0;
}

# a stop that gave up on what the case left open fails the case, which is how a
# close nothing finishes shows up here rather than as a hang (#273). so does a
# teardown failure, such as an account a connection left buffers in (#280)
fun stall_finish(stall: *Stall, result: i32) i32 {
    if (stall.client != nil) { tlswire.release(stall.client); }
    val stopped: composition.StopReport = composition.stop(stall.harness.runtime,
        ?stall.controls);
    if (result != 0)                                                                    { ret result; }
    if (!stopped.stopped || !serve.finished(?stall.harness.runtime.workers[0].serving)) { ret 90; }
    if (stopped.serve_failures != 0 || stopped.cleanup_failures != 0)                   { ret 91; }
    ret 0;
}

#[testing]
fun hello_stall(half: bool) i32 {
    var stall:  Stall;
    val opened: i32 = stall_start(?stall, schema.PROTOCOL_HTTP1, STALL_TIMEOUT_MS,
        "http/1.1");
    if (opened != 0)                                          { ret opened; }
    if (!tlswire.hello(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 4); }
    var length: usize = tlswire.hello_length(stall.client);
    if (half) { length = length / 2; }
    if (!tlswire.send_raw(stall.client, tlswire.hello_bytes(stall.client), length)) {
        ret stall_finish(?stall, 5);
    }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

test handshake_timeout__closes_partial_client_hello {
    ret hello_stall(true);
}

test handshake_timeout__closes_unfinished_handshake {
    ret hello_stall(false);
}

# the handshake completes under a long deadline, so only the HTTP timeout can close it
#[testing]
fun open_stall(stall: *Stall, protocols: u8, alpn: str) i32 {
    val opened: i32 = stall_start(stall, protocols, LONG_TIMEOUT_MS, alpn);
    if (opened != 0)                                              { ret opened; }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret 6; }
    ret 0;
}

fun send_text(client: *tlswire.Client, text: str) bool {
    var length: usize = 0;
    for (text[length] != 0) { length = length + 1; }
    ret tlswire.send(client, text::*u8, length);
}

# the HTTP/1.1 engine starts its header timer at a request's first byte, so a
# connection that has sent none is idle and the keep-alive timeout governs it
test keep_alive_timeout__closes_silent_tls_client {
    var stall: Stall;
    clock.freeze();
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS);
    stall.harness.graph.timeouts.header_ms = LONG_TIMEOUT_MS;
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret stall_finish(?stall, 2); }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.workers[0].serving,
        "api.example.com", "http/1.1")
        || !tlswire.handshake(stall.client, stall.harness.endpoint)) {
        ret stall_finish(?stall, 3);
    }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

test header_timeout__closes_partial_tls_request {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0)                                                 { ret stall_finish(?stall, opened); }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.exa")) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

test keep_alive_timeout__closes_idle_tls_connection {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 7);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 8);
    }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

# a peer closing an idle TLS keep-alive connection is seen by the readiness
# wait, and the connection has to be retired then rather than at the keep-alive
# timeout (#257). the clock is frozen, so no timeout can retire it instead.
# `notify` sends close_notify first, as a well-behaved client does. without it
# the socket just closes, as most clients do
#[testing]
fun peer_closes_idle(notify: bool) i32 {
    var stall: Stall;
    clock.freeze();
    if (!prepare(?stall.harness, false)) { ret 1; }
    # no timeout the connection could be retired by falls inside the bound
    stall_graph(?stall.harness, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS);
    stall.harness.graph.timeouts.header_ms     = LONG_TIMEOUT_MS;
    stall.harness.graph.timeouts.keep_alive_ms = LONG_TIMEOUT_MS;
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret stall_finish(?stall, 2); }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.workers[0].serving,
        "api.example.com", "http/1.1")
        || !tlswire.handshake(stall.client, stall.harness.endpoint)) {
        ret stall_finish(?stall, 3);
    }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 4);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 5);
    }
    # the server settles its response and goes back to its idle wait
    var controls: quic_runtime.ControlView;
    var i:        usize = 0;
    for (i < 8) {
        serve.poll(?controls, ?stall.harness.runtime.workers[0].serving, 0);
        i = i + 1;
    }
    if (stall.harness.runtime.workers[0].serving.live != 1) { ret stall_finish(?stall, 6); }
    if (notify && !tlswire.close_notify(stall.client))      { ret stall_finish(?stall, 7); }
    tlswire.release(stall.client);
    stall.client = nil;
    # a retired connection has closed its socket and left the live count
    i = 0;
    for (i < 400 && stall.harness.runtime.workers[0].serving.live != 0) {
        serve.poll(?controls, ?stall.harness.runtime.workers[0].serving, 5);
        i = i + 1;
    }
    if (stall.harness.runtime.workers[0].serving.live != 0) { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, 0);
}

test peer_close__retires_idle_tls_connection {
    ret peer_closes_idle(false);
}

test peer_close__close_notify_retires_idle_tls_connection {
    ret peer_closes_idle(true);
}

fun send_frames(client: *tlswire.Client, bytes: *u8, length: usize) bool {
    ret tlswire.send(client, bytes, length);
}

# the peak the TLS lane must reach for the handshake to have borrowed its input,
# output and hello buffers at all: mach-tls sizes the peer handshake buffer at
# HANDSHAKE_INPUT_BYTES (16384), so a run that never crossed it never staged a
# handshake and the guard below would be vacuous
val TLS_HANDSHAKE_FOOTPRINT: usize = 16384;

# an established connection that has finished its handshake and returned to idle
# holds no TLS-lane buffer: hedge destroys the handshake write operation when it
# settles, which finishes mach-tls's handshake engine into the stream core and
# releases its input, output, hello and peer-parameter buffers back to the pool.
# the guard pins that release so a dependency bump or a settle-path refactor
# cannot silently strand ~18KB per idle connection.
test tls__idle_holds_no_handshake_buffer {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    # the client considers the handshake done; drive the server so it settles the
    # handshake write and releases the engine before the connection is measured
    var controls: quic_runtime.ControlView;
    var i:        usize = 0;
    for (i < 8) {
        serve.poll(?controls, ?stall.harness.runtime.workers[0].serving, 0);
        i = i + 1;
    }
    val idle: hedge_memory.Snapshot =
        hedge_memory.snapshot(?stall.harness.runtime.workers[0].serving.memory);
    val lane: hedge_memory.LaneCounters = idle.lanes[hedge_memory.LANE_TLS::usize];
    if (lane.peak < TLS_HANDSHAKE_FOOTPRINT) { ret stall_finish(?stall, 7); }
    if (lane.held != 0)                      { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, 0);
}

val HOG_PARKED_TURNS: usize = 16;

# while the server's handshake waits on the pool the hog counts the turns it
# stays parked, then lets go
fun hog_pump(context: ptr) {
    val hog: *wire.Hog = context::*wire.Hog;
    if (hog.freed)                                    { ret; }
    if (hedge_memory.snapshot(hog.pool).waiters == 0) { ret; }
    hog.parked = hog.parked + 1;
    if (hog.parked >= HOG_PARKED_TURNS) { wire.hog_free(hog); }
}

# a handshake whose TLS lane the pool refuses parks inside mach-tls, and only
# the account's wake retries it: the worker routes the pool's wake to
# `stream.resume` and the retry comes back as a completion (#195). the server
# makes no progress while the pool is held, and the handshake completes once
# the memory comes back
test tls__handshake_parked_for_memory_resumes {
    var stall:  Stall;
    val opened: i32 = stall_start(?stall, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS,
        "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var hog: wire.Hog;
    if (!wire.hog_take(?hog, ?stall.harness.runtime.workers[0].serving.memory, lanes.RESERVE)) {
        ret stall_finish(?stall, 4);
    }
    tlswire.on_pump(stall.client, hog_pump, (?hog)::ptr);
    val shaken: bool                  = tlswire.handshake(stall.client, stall.harness.endpoint);
    val freed:  bool                  = wire.hog_free(?hog);
    val seen:   hedge_memory.Snapshot = hedge_memory.snapshot(?stall.harness.runtime.workers[0].serving.memory);
    if (hog.parked < HOG_PARKED_TURNS || !freed)                 { ret stall_finish(?stall, 5); }
    if (seen.lanes[hedge_memory.LANE_TLS::usize].exhausted == 0) { ret stall_finish(?stall, 6); }
    if (!shaken)                                                 { ret stall_finish(?stall, 7); }
    # the resumed connection serves as any other
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 8);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 9);
    }
    ret stall_finish(?stall, 0);
}

# an idle TLS keep-alive connection waits on its readiness wait alone, so turns
# that bring it nothing do not drive it (#195)
test tls__idle_keep_alive_not_driven {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 7);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 8);
    }
    # the response's own completions settle before the connection goes quiet
    var controls: quic_runtime.ControlView;
    var i:        usize = 0;
    for (i < 8) {
        serve.poll(?controls, ?stall.harness.runtime.workers[0].serving, 0);
        i = i + 1;
    }
    val settled: u64 = serve.drives(?stall.harness.runtime.workers[0].serving);
    i = 0;
    for (i < 50) {
        serve.poll(?controls, ?stall.harness.runtime.workers[0].serving, 0);
        i = i + 1;
    }
    val idle: u64 = serve.drives(?stall.harness.runtime.workers[0].serving) - settled;
    if (stall.harness.runtime.workers[0].serving.live != 1) { ret stall_finish(?stall, 9); }
    if (idle != 0)                                          { ret stall_finish(?stall, 10); }
    ret stall_finish(?stall, 0);
}

test header_timeout__closes_silent_h2_client {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

test header_timeout__closes_h2_preface_only {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var frames: [256]u8;
    val length: usize = wire.put_connection_start(?frames[0]);
    if (!send_frames(stall.client, ?frames[0], length)) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

test header_timeout__closes_partial_h2_headers_frame {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    wire.put_request(?frames[0], start, 1);
    # the frame header and the first bytes of its block, and nothing after
    if (!send_frames(stall.client, ?frames[0], start + 12)) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

test header_timeout__closes_unended_h2_header_block {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    # END_STREAM without END_HEADERS: the block waits for a CONTINUATION
    val ended: usize = wire.put_request(?frames[0], start, 1);
    frames[start + 4] = 0x01;
    if (!send_frames(stall.client, ?frames[0], ended)) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

# true once the response on stream 1 has ended
fun h2_response_ended(bytes: *u8, length: usize) bool {
    var at: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (bytes[at]::usize << 16) | (bytes[at + 1]::usize << 8)
            | bytes[at + 2]::usize;
        val kind:   u8  = bytes[at + 3];
        val flags:  u8  = bytes[at + 4];
        val stream: u32 = (bytes[at + 5]::u32 << 24) | (bytes[at + 6]::u32 << 16)
            | (bytes[at + 7]::u32 << 8) | bytes[at + 8]::u32;
        if (stream == 1 && (kind == 0x00 || kind == 0x01) && (flags & 0x01) != 0) {
            ret true;
        }
        at = at + 9 + size;
    }
    ret false;
}

fun served_h2(client: *tlswire.Client) bool {
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    val ended:  usize = wire.put_request(?frames[0], start, 1);
    if (!send_frames(client, ?frames[0], ended)) { ret false; }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    var reads:    usize = 0;
    for (reads < 16 && !h2_response_ended(?response[0], length)) {
        val got: usize = tlswire.receive(client, ?response[length],
            RESPONSE_BYTES - length, nil);
        if (got == 0) { brk; }
        length = length + got;
        reads  = reads + 1;
    }
    ret h2_response_ended(?response[0], length);
}

fun h2_has_frame(bytes: *u8, length: usize, wanted: u8) bool {
    var at: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (bytes[at]::usize << 16) | (bytes[at + 1]::usize << 8)
            | bytes[at + 2]::usize;
        if (bytes[at + 3] == wanted) { ret true; }
        at = at + 9 + size;
    }
    ret false;
}

fun put_data(frames: *u8, at: usize, count: usize, size: usize, last: bool) usize {
    var length: usize = at;
    var sent:   usize = 0;
    for (sent < count) {
        var flags: u8 = 0;
        if (last && sent + 1 == count) { flags = 0x01; }
        val payload: usize = wire.put_frame(frames, length, size, 0x00, flags, 1);
        var i:       usize = 0;
        for (i < size) {
            frames[payload + i] = 'x';
            i                   = i + 1;
        }
        length = payload + size;
        sent   = sent + 1;
    }
    ret length;
}

# read frames until one of kind `wanted` has arrived, or the response has ended
# when `wanted` is 0xff
fun h2_await(client: *tlswire.Client, response: *u8, received: *usize, wanted: u8) bool {
    var reads: usize = 0;
    for (reads < 16) {
        if (wanted == 0xff && h2_response_ended(response, @received))    { ret true; }
        if (wanted != 0xff && h2_has_frame(response, @received, wanted)) { ret true; }
        val got: usize = tlswire.receive(client, ?response[@received],
            RESPONSE_BYTES - @received, nil);
        if (got == 0) { ret false; }
        @received = @received + got;
        reads     = reads + 1;
    }
    ret false;
}

# a body larger than the initial window can only finish once the server has read
# what it holds and credited the window back, with nothing new on the socket to
# tell it to
test h2__body_past_window_completes {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    val claimed: res[*u8, allocator.Error] = allocator.zallocate[u8](?stall.harness.heap, 65536);
    if (sel claimed.err) { ret stall_finish(?stall, 7); }
    val frames: *u8   = claimed.ok;
    var length: usize = wire.put_connection_start(frames);
    length = wire.put_open_request(frames, length, 1);
    length = put_data(frames, length, 8, 8000, false);
    if (!send_frames(stall.client, frames, length)) { ret stall_finish(?stall, 8); }
    var response: [RESPONSE_BYTES]u8;
    var received: usize = 0;
    if (!h2_await(stall.client, ?response[0], ?received, 0x08)) { ret stall_finish(?stall, 9); }
    length = put_data(frames, 0, 5, 8000, true);
    if (!send_frames(stall.client, frames, length))             { ret stall_finish(?stall, 10); }
    if (!h2_await(stall.client, ?response[0], ?received, 0xff)) { ret stall_finish(?stall, 11); }
    ret stall_finish(?stall, 0);
}

test keep_alive_timeout__closes_idle_h2_connection {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0)              { ret stall_finish(?stall, opened); }
    if (!served_h2(stall.client)) { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, closed_within(?stall.harness, STALL_TIMEOUT_MS));
}

# a connection that has answered a request and is waiting for the next one, with
# no timeout close enough to end it before the stop does
fun between_requests(stall: *Stall, protocols: u8, alpn: str) i32 {
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, protocols, LONG_TIMEOUT_MS);
    stall.harness.graph.timeouts.keep_alive_ms = LONG_TIMEOUT_MS;
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.workers[0].serving,
        "api.example.com", alpn)) { ret 3; }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret 4; }
    ret 0;
}

test stop__closes_idle_tls_connection {
    var stall:  Stall;
    val opened: i32 = between_requests(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0)                 { ret stall_finish(?stall, opened); }
    if (!served_hello(stall.client)) { ret stall_finish(?stall, 5); }
    ret stall_finish(?stall, 0);
}

test stop__closes_idle_h2_connection {
    var stall:  Stall;
    val opened: i32 = between_requests(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0)              { ret stall_finish(?stall, opened); }
    if (!served_h2(stall.client)) { ret stall_finish(?stall, 5); }
    ret stall_finish(?stall, 0);
}

# boot a TLS listener, optionally asking for client certificates or rotating
# ticket keys every second, then ready a client for it
fun tls_time_start(stall: *Stall, client_auth: bool, rotating: bool) i32 {
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS);
    val policy: *schema.TlsPolicy = ?stall.harness.graph.tls_policies[0];
    if (client_auth) {
        policy.client_auth = true;
        schema.set_text(?policy.client_trust, "test/interop/fixtures/root.pem");
    }
    if (rotating) {
        policy.resumption.enabled                    = true;
        policy.resumption.key_lifetime_seconds       = 1;
        policy.resumption.retirement_overlap_seconds = 1;
        policy.resumption.ticket_lifetime_seconds    = 60;
        policy.resumption.replay_policy              = schema.TLS_REPLAY_PERMISSIVE;
        policy.resumption.tickets_per_connection     = 1;
    }
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.workers[0].serving,
        "api.example.com", "http/1.1")) { ret 3; }
    ret 0;
}

fun served_hello(client: *tlswire.Client) bool {
    if (!send_text(client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) { ret false; }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    ret length != 0 && wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n");
}

test mtls__valid_client_certificate_accepted {
    var stall:  Stall;
    val opened: i32 = tls_time_start(?stall, true, false);
    if (opened != 0) { ret stall_finish(?stall, opened); }
    if (!tlswire.present(stall.client, "test/interop/fixtures/client.pem",
        "test/interop/fixtures/client.key")) { ret stall_finish(?stall, 4); }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 5); }
    if (!served_hello(stall.client))                              { ret stall_finish(?stall, 6); }
    ret stall_finish(?stall, 0);
}

fun ticket_generation() u64 {
    val policy: *hedge_tls.Policy = hedge_tls.policy_at(hedge_tls.find("public"));
    if (policy == nil) { ret 0; }
    ret session.keyring_generation(?policy.ticket_ring);
}

test ticket_key__rotates_past_lifetime {
    var stall:  Stall;
    val opened: i32 = tls_time_start(?stall, false, true);
    if (opened != 0)                                              { ret stall_finish(?stall, opened); }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 4); }
    val first: u64 = ticket_generation();
    if (first == 0) { ret stall_finish(?stall, 5); }
    tlswire.release(stall.client);
    # the policy reads a clock the test holds, standing where the key falls due
    val policy: *hedge_tls.Policy = hedge_tls.policy_at(hedge_tls.find("public"));
    var moment: tls_clock.Moment;
    if (!tls_clock.now(?moment)) { ret stall_finish(?stall, 9); }
    moment.monotonic = clock.from_ns(atomic.load(?policy.ticket_rotate_ns)::u64);
    policy.clock     = tls_clock.frozen(?moment);
    if (!tlswire.make(stall.client, ?stall.harness.runtime.workers[0].serving, "api.example.com",
        "http/1.1")) { ret stall_finish(?stall, 6); }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 7); }
    if (ticket_generation() != first + 1)                         { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, 0);
}
