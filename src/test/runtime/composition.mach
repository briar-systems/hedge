# production composition over real sockets

use http_cache: hedge.cache;
use hedge.clock;
use hedge.composition;
use hedge.config.lanes;
use hedge.config.schema;
use hedge.listener;
use hedge_memory: hedge.memory;
use h3_session:   hedge.protocol.h3.session;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge_tls:    hedge.protocol.tls;
use hedge.serve;
use hedge.service;
use hosting: hedge.service.laurel;
use hedge.storage;
use site_fixture: hedge.test.laurel;
use hedge.test.runtime.tlswire;
use hedge.test.runtime.wire;
use laurel.app;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.memory.buffers;
use std.net.ip;
use std.net.tcp;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use tls_server: tls.server;
use tls.session;

fun page_ok(outcome: err[allocator.Error]) bool {
    ret sel outcome.ok;
}

val RESPONSE_BYTES: usize = 4096;

val FORM_HEAD: str = "POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 10\r\nConnection: close\r\n\r\n";

rec Counted {
    inner: *allocator.Allocator;
    calls: usize;
    bytes: usize;
}

fun counted_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
    val counted: *Counted = context::*Counted;
    counted.calls = counted.calls + 1;
    counted.bytes = counted.bytes + size;
    ret counted.inner.fn_allocate(counted.inner.ctx, size, align);
}

fun counted_reallocate(context: ptr, value: ptr, old_size: usize,
    new_size: usize, align: usize) opt[ptr] {
    val counted: *Counted = context::*Counted;
    ret counted.inner.fn_reallocate(counted.inner.ctx, value, old_size, new_size, align);
}

fun counted_deallocate(context: ptr, value: ptr, size: usize, align: usize) i64 {
    val counted: *Counted = context::*Counted;
    ret counted.inner.fn_deallocate(counted.inner.ctx, value, size, align);
}

fun make_counted(output: *allocator.Allocator, state: *Counted,
    inner: *allocator.Allocator) {
    state.inner          = inner;
    state.calls          = 0;
    state.bytes          = 0;
    output.ctx           = state::ptr;
    output.fn_allocate   = counted_allocate;
    output.fn_reallocate = counted_reallocate;
    output.fn_deallocate = counted_deallocate;
}

rec Harness {
    heap:        allocator.Allocator;
    counted:     allocator.Allocator;
    count:       Counted;
    graph:       schema.Graph;
    replacement: schema.Graph;
    diagnostics: schema.Diagnostics;
    runtime:     *composition.Runtime;
    storages:    *composition.PlanStorage;
    endpoint:    ip.Endpoint;
}

fun graph(harness: *Harness, cache_enabled: bool) {
    val configured: *schema.Graph = ?harness.graph;
    schema.reset_graph(configured);
    schema.set_text(?configured.server_name, "composition-test");
    configured.limits.max_connections          = opt[usize].some{4};
    configured.limits.max_connections_per_peer = opt[usize].some{4};
    configured.listener_count                  = 1;
    val public: *schema.Listener = ?configured.listeners[0];
    schema.set_text(?public.name, "public");
    schema.set_text(?public.address, "127.0.0.1:0");
    schema.clear_text(?public.tls_policy);
    schema.clear_text(?public.budget);
    public.transport          = schema.TRANSPORT_TCP;
    public.protocols          = schema.PROTOCOL_HTTP1;
    public.backlog            = 16;
    public.accept_depth       = 2;
    public.proxy_protocol     = schema.PROXY_OFF;
    public.trusted_peer_count = 0;
    configured.host_count     = 1;
    schema.set_text(?configured.hosts[0].name, "site");
    schema.set_text(?configured.hosts[0].listener, "public");
    configured.hosts[0].server_name_count = 1;
    schema.set_text(?configured.hosts[0].server_names[0], "localhost");
    configured.service_count = 1;
    val fixed: *schema.Service = ?configured.services[0];
    schema.set_text(?fixed.name, "hello");
    fixed.kind = schema.SERVICE_FIXED;
    schema.set_text(?fixed.target, "hello from composition\n");
    schema.clear_text(?fixed.budget);
    schema.set_text(?fixed.content_type, "text/plain");
    schema.clear_text(?fixed.index);
    fixed.precompressed    = false;
    fixed.status           = 200;
    fixed.cache            = cache_enabled;
    configured.route_count = 1;
    schema.set_text(?configured.routes[0].name, "all");
    schema.set_text(?configured.routes[0].host, "site");
    schema.set_text(?configured.routes[0].path, "/**");
    schema.set_text(?configured.routes[0].service, "hello");
    schema.clear_text(?configured.routes[0].budget);
    configured.cache.enabled         = cache_enabled;
    configured.cache.memory_bytes    = 4096;
    configured.cache.max_entry_bytes = 1024;
    configured.cache.entries         = 8;
    configured.cache.disk_bytes      = 0;
    schema.clear_text(?configured.cache.disk_root);
    if (!cache_enabled) {
        configured.cache.disk_bytes = 4096;
        schema.set_text(?configured.cache.disk_root, "out/composition-disabled-cache");
    }
}

fun quic_graph(harness: *Harness) {
    graph(harness, false);
    val configured: *schema.Graph    = ?harness.graph;
    val public:     *schema.Listener = ?configured.listeners[0];
    schema.set_text(?public.name, "quic");
    public.transport = schema.TRANSPORT_QUIC;
    public.protocols = schema.PROTOCOL_HTTP3;
    schema.set_text(?public.tls_policy, "public");
    schema.set_text(?configured.hosts[0].listener, "quic");
    schema.set_text(?configured.hosts[0].server_names[0], "api.example.com");
    configured.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?configured.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate,
        "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key,
        "test/interop/fixtures/api.key");
    schema.set_text(?policy.default_name, "api.example.com");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
}

fun prepare(harness: *Harness, cache_enabled: bool) bool {
    if (!page_ok(page.make(?harness.heap))) { ret false; }
    val runtime_memory: res[*composition.Runtime, allocator.Error] =
        allocator.allocate[composition.Runtime](?harness.heap, 1);
    val storage_memory: res[*composition.PlanStorage, allocator.Error] =
        allocator.allocate[composition.PlanStorage](?harness.heap, 2);
    if (sel runtime_memory.err) { ret false; }
    if (sel storage_memory.err) { ret false; }
    harness.runtime  = runtime_memory.ok;
    harness.storages = storage_memory.ok;
    make_counted(?harness.counted, ?harness.count, ?harness.heap);
    graph(harness, cache_enabled);
    ret true;
}

fun boot(harness: *Harness, controls: *composition.Controls,
    cache_enabled: bool) composition.StartReport {
    ret start_with(harness, controls, composition.default_options());
}

fun start_with(harness: *Harness, controls: *composition.Controls,
    options: composition.Options) composition.StartReport {
    if (composition.quic_required(?harness.graph)
        && !composition.make_controls(controls, ?harness.heap)) {
        ret composition.StartReport{status: composition.START_RUNTIME,
            detail: "quic control storage allocation failed"};
    }
    val started: composition.StartReport = composition.start(harness.runtime, controls,
        ?harness.counted, ?harness.graph, 1, ?harness.storages[0],
        ?harness.diagnostics, options);
    if (started.status == composition.START_OK) {
        val owned: *listener.OwnedListener =
            listener.active_listener(?harness.runtime.serving.owner, 0);
        if (owned != nil && owned.has_bound_endpoint) {
            harness.endpoint = owned.bound_endpoint;
        }
    }
    ret started;
}

fun exchange(harness: *Harness) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client,
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.serving, ?client,
        ?response[0], RESPONSE_BYTES, "hello from composition");
    tcp.stream_close(?client);
    ret length != 0 && wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        && wire.contains(?response[0], length, "hello from composition\n");
}

fun exchange_request_text(harness: *Harness, request: str, expected: str) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)
        || !wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.serving, ?client,
        ?response[0], RESPONSE_BYTES, expected);
    tcp.stream_close(?client);
    ret length != 0 && wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        && wire.contains(?response[0], length, expected);
}

fun exchange_text(harness: *Harness, expected: str) bool {
    ret exchange_request_text(harness,
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n", expected);
}

fun settle_connections(harness: *Harness) bool {
    var quic_controls: quic_runtime.ControlView;
    var rounds:        usize = 0;
    for (rounds < 200 && !serve.idle(?harness.runtime.serving)) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 1);
        rounds = rounds + 1;
    }
    ret serve.idle(?harness.runtime.serving);
}

fun reload_fixed(harness: *Harness, generation: u64, expected: str) bool {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    val target:        usize         = 1 - composition.active_service_generation(harness.runtime);
    var candidate:     *schema.Graph = ?harness.graph;
    if (target == 1) { candidate = ?harness.replacement; }
    @candidate = @harness.runtime.graph;
    schema.set_text(?candidate.services[0].target, expected);
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
        candidate, generation, ?harness.storages[target], ?harness.diagnostics);
    if (reloaded.status != composition.START_OK || !exchange_text(harness, expected)
        || serve.superseded(?quic_controls, ?harness.runtime.serving) != 0
        || !composition.reclaim_superseded(harness.runtime, ?controls)) { ret false; }
    val active: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, target);
    val retired: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 1 - target);
    ret active.live && active.generation == generation && !retired.live
        && retired.generation == 0;
}

fun event_index(runtime: *composition.Runtime, target: composition.Event) usize {
    var i: usize = 0;
    for (i < runtime.event_count) {
        if (composition.event_at(runtime, i) == target) { ret i; }
        i = i + 1;
    }
    ret runtime.event_count;
}

fun disturb_stack(seed: usize) usize {
    var bytes: [65536]u8;
    var i:     usize = 0;
    for (i < 65536) {
        bytes[i] = (i + seed)::u8;
        i        = i + 1;
    }
    ret bytes[seed % 65536]::usize;
}

test "composition: production wiring serves after its construction frame is gone" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, true)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_OK) { ret 2; }
    # the connection pool is no longer among them: serve claims its slots and
    # connection records as peers arrive. the worker's buffer pool is one
    if (harness.count.calls != 5) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val services: *composition.ServiceGeneration =
        ?harness.runtime.service_generations[0];
    if (services.cache_bindings.items != ?services.cache_binding_storage[0]
        || services.services.caching.ctx != (?services.cache_bindings)::ptr
        || harness.runtime.plans[0].storage.services[0].handler.ctx
        != (?services.cache_binding_storage[0])::ptr) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    disturb_stack(17);
    if (!exchange(?harness) || !exchange(?harness)) {
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }
    val caching: *http_cache.Layer = composition.cache(harness.runtime);
    if (caching == nil || http_cache.report(caching).misses == 0) {
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 7;
    }
    val bindings:        usize = event_index(harness.runtime, composition.CACHE_BINDINGS_READY);
    val wrapper:         usize = event_index(harness.runtime, composition.CACHE_WRAPPER_READY);
    val compiled:        usize = event_index(harness.runtime, composition.PLAN_READY);
    val serve_stop:      usize = event_index(harness.runtime, composition.SERVE_STOPPED);
    val telemetry_close: usize = event_index(harness.runtime,
        composition.TELEMETRY_CLOSED);
    val tls:         usize = event_index(harness.runtime, composition.TLS_DESTROYED);
    val cache_close: usize = event_index(harness.runtime, composition.CACHE_CLOSED);
    if (!(bindings < wrapper && wrapper < compiled)) { ret 8; }
    if (!(serve_stop < telemetry_close && telemetry_close < tls
        && tls < cache_close)) { ret 9; }
    ret 0;
}

test "composition: disabled caching acquires no cache resource" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    # the telemetry queue and the worker's buffer pool are allocated
    if (harness.count.calls != 2 || composition.cache(harness.runtime) != nil) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    if (!exchange(?harness)) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.cleanup_failures != 0) { ret 5; }
    if (event_index(harness.runtime, composition.CACHE_BINDINGS_READY)
        != harness.runtime.event_count) { ret 6; }
    if (event_index(harness.runtime, composition.CACHE_WRAPPER_READY)
        != harness.runtime.event_count) { ret 7; }
    if (event_index(harness.runtime, composition.CACHE_CLOSED)
        != harness.runtime.event_count) { ret 8; }
    ret 0;
}

test "composition: quic pumps publish reload and release with their socket" {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    if (!prepare(?harness, false)) { ret 1; }
    quic_graph(?harness);
    harness.graph.limits.max_connections = opt[usize].none{};
    # below any kernel cap, so the socket must report at least this much
    harness.graph.listeners[0].receive_buffer_bytes = opt[usize].some{65536};
    harness.graph.listeners[0].send_buffer_bytes    = opt[usize].some{65536};
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK)                { ret 2; }
    if (!composition.controls_view(?controls, ?quic_controls)) { ret 2; }
    val owned: *listener.OwnedListener = listener.active_listener(
        ?harness.runtime.serving.owner, 0);
    val initial: quic_runtime.Snapshot = quic_runtime.snapshot(?quic_controls,
        ?harness.runtime.quic);
    if (owned == nil || !owned.has_udp_socket || !owned.has_bound_endpoint
        || owned.bound_endpoint.port == 0 || !initial.initialized
        || initial.pumps != 1 || initial.live != 0
        # a listening QUIC pump with no configured limit holds no per-connection
        # storage until a connection arrives
        || storage.pair_capacity[quic_runtime.ConnectionStorage, quic_runtime.Connection](
        ?controls.connections) != 0
        || storage.secret_table_capacity[tls_server.Handshake](?controls.handshakes) != 0
        || storage.pair_capacity[h3_session.SessionStorage, h3_session.Session](
        ?controls.sessions) != 0
        || harness.runtime.quic.pending_initials.slab.capacity != 0
        || harness.runtime.quic.routes.capacity != 0
        || harness.runtime.serving.timers.entries.slab.capacity != 0
        || serve.socket_buffers(?harness.runtime.serving, 0).receive_requested != 65536
        || serve.socket_buffers(?harness.runtime.serving, 0).receive_effective < 65536
        || serve.socket_buffers(?harness.runtime.serving, 0).send_requested != 65536
        || serve.socket_buffers(?harness.runtime.serving, 0).send_effective < 65536
        || harness.runtime.serving.state != serve.READY
        || !serve.poll(?quic_controls, ?harness.runtime.serving, 0)) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    harness.replacement = harness.graph;
    schema.set_text(?harness.replacement.services[0].target,
        "quic generation two\n");
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.storages[1], ?harness.diagnostics);
    val updated: quic_runtime.Snapshot = quic_runtime.snapshot(?quic_controls,
        ?harness.runtime.quic);
    if (reloaded.status != composition.START_OK
        || harness.runtime.serving.generation != 2 || updated.pumps != 1
        || updated.superseded != 0
        || !composition.reclaim_superseded(harness.runtime, ?controls)) {
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val stopped:  composition.StopReport = composition.stop(harness.runtime, ?controls);
    val released: quic_runtime.Snapshot  = quic_runtime.snapshot(?quic_controls,
        ?harness.runtime.quic);
    if (!stopped.stopped || stopped.serve_failures != 0
        || stopped.cleanup_failures != 0 || released.initialized
        || harness.runtime.serving.state != serve.STOPPED
        || owned.has_udp_socket) { ret 5; }
    if (!composition.release_controls(?controls)) { ret 6; }
    ret 0;
}

test "composition: startup failure unwinds every acquired resource" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, true)) { ret 1; }
    schema.set_text(?harness.graph.listeners[0].tls_policy, "broken");
    harness.graph.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?harness.graph.tls_policies[0];
    schema.set_text(?policy.name, "broken");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "localhost");
    schema.set_text(?policy.identities[0].certificate, "missing-certificate.pem");
    schema.set_text(?policy.identities[0].key, "missing-key.pem");
    schema.set_text(?policy.default_name, "localhost");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_CONFIG) { ret 2; }
    if (hedge_tls.count() != 0 || harness.runtime.proxying.live
        || composition.cache(harness.runtime) != nil
        || harness.runtime.service_generations[0].static_registry.len != 0) { ret 3; }
    val tls:          usize = event_index(harness.runtime, composition.TLS_DESTROYED);
    val proxy:        usize = event_index(harness.runtime, composition.PROXY_CLOSED);
    val cache_close:  usize = event_index(harness.runtime, composition.CACHE_CLOSED);
    val static_close: usize = event_index(harness.runtime, composition.STATIC_CLOSED);
    if (!(tls < proxy && proxy < cache_close && cache_close < static_close)) { ret 4; }
    if (event_index(harness.runtime, composition.SERVE_STOPPED)
        != harness.runtime.event_count) { ret 5; }
    ret 0;
}

test "composition: service reload pins the old registry and reclaims repeated generations" {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    if (!prepare(?harness, true)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_OK) { ret 2; }

    var old: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?old)
        || !wire.send(?old, "GET / HTTP/1.1\r\nHost: localhost\r\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    var rounds: usize = 0;
    for (rounds < 16) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 1);
        rounds = rounds + 1;
    }
    harness.replacement = harness.graph;
    schema.set_text(?harness.replacement.services[0].target, "generation two\n");
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.storages[1], ?harness.diagnostics);
    if (reloaded.status != composition.START_OK
        || serve.superseded(?quic_controls, ?harness.runtime.serving) != 1) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 4;
    }
    val first:  composition.ServiceSnapshot = composition.service_snapshot(harness.runtime, 0);
    val second: composition.ServiceSnapshot = composition.service_snapshot(harness.runtime, 1);
    if (!first.live || first.generation != 1 || !second.live || second.generation != 2) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }
    if (composition.reload(harness.runtime, ?controls, ?harness.graph, 3, ?harness.storages[0],
        ?harness.diagnostics).status == composition.START_OK) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }
    if (!wire.send(?old, "\r\n")) {
        tcp.stream_close(?old);
        composition.stop(harness.runtime, ?controls);
        ret 7;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.serving, ?old,
        ?response[0], RESPONSE_BYTES, "hello from composition\n");
    tcp.stream_close(?old);
    if (length == 0 || !wire.contains(?response[0], length, "hello from composition\n")
        || !exchange_text(?harness, "generation two\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 8;
    }
    rounds = 0;
    for (rounds < 200 && serve.superseded(?quic_controls, ?harness.runtime.serving) != 0) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 1);
        rounds = rounds + 1;
    }
    if (serve.superseded(?quic_controls, ?harness.runtime.serving) != 0
        || !composition.service_snapshot(harness.runtime, 0).live
        || !composition.reclaim_superseded(harness.runtime, ?controls)
        || composition.service_snapshot(harness.runtime, 0).live) {
        composition.stop(harness.runtime, ?controls);
        ret 9;
    }

    var generation: u64 = 3;
    for (generation < 19) {
        if (!reload_fixed(?harness, generation, "reloaded generation\n")) {
            composition.stop(harness.runtime, ?controls);
            ret 10;
        }
        generation = generation + 1;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 11;
    }
    ret 0;
}

test "composition: repeated static reloads close every retired root" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    harness.graph.services[0].kind = schema.SERVICE_STATIC;
    schema.set_text(?harness.graph.services[0].target, "test/interop/public");
    schema.set_text(?harness.graph.services[0].index, "index.html");
    harness.graph.services[0].precompressed = false;
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK
        || !exchange_request_text(?harness,
        "GET /files/large.txt HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "line 000001") || !settle_connections(?harness)) {
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    var generation: u64 = 2;
    for (generation < 18) {
        val target:    usize         = 1 - composition.active_service_generation(harness.runtime);
        var candidate: *schema.Graph = ?harness.graph;
        if (target == 1) { candidate = ?harness.replacement; }
        @candidate                          = @harness.runtime.graph;
        candidate.services[0].precompressed = !candidate.services[0].precompressed;
        schema.reset_diagnostics(?harness.diagnostics);
        val reloaded: composition.StartReport = composition.reload(harness.runtime, ?controls,
            candidate, generation, ?harness.storages[target], ?harness.diagnostics);
        val active: composition.ServiceSnapshot =
            composition.service_snapshot(harness.runtime, target);
        val retired: composition.ServiceSnapshot =
            composition.service_snapshot(harness.runtime, 1 - target);
        if (reloaded.status != composition.START_OK || !active.live
            || active.static_roots != 1 || !retired.live || retired.static_roots != 1
            || !composition.reclaim_superseded(harness.runtime, ?controls)
            || composition.service_snapshot(harness.runtime, 1 - target).static_roots != 0
            || !exchange_request_text(?harness,
            "GET /files/large.txt HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
            "line 000001") || !settle_connections(?harness)) {
            composition.stop(harness.runtime, ?controls);
            ret 3;
        }
        generation = generation + 1;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

test "composition: a failed service generation leaves the active plan untouched" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    harness.replacement                  = harness.graph;
    harness.replacement.services[0].kind = schema.SERVICE_STATIC;
    schema.set_text(?harness.replacement.services[0].target,
        "out/missing-service-generation-root");
    schema.reset_diagnostics(?harness.diagnostics);
    val rejected: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.storages[1], ?harness.diagnostics);
    val candidate: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 1);
    if (rejected.status != composition.START_CONFIG || candidate.live
        || candidate.static_roots != 0
        || composition.active_service_generation(harness.runtime) != 0
        || !exchange_text(?harness, "hello from composition\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

test "composition: a process-owned reload change is rejected atomically" {
    var quic_controls: quic_runtime.ControlView;
    var controls:      composition.Controls;
    var harness:       Harness;
    if (!prepare(?harness, true)) { ret 1; }
    val started: composition.StartReport = boot(?harness, ?controls, true);
    if (started.status != composition.START_OK) { ret 2; }
    val active_before: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 0);
    harness.replacement                    = harness.graph;
    harness.replacement.cache.memory_bytes = harness.graph.cache.memory_bytes + 1;
    schema.reset_diagnostics(?harness.diagnostics);
    val rejected: composition.StartReport = composition.reload(harness.runtime, ?controls,
        ?harness.replacement, 2, ?harness.storages[1], ?harness.diagnostics);
    val active_after: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 0);
    val candidate: composition.ServiceSnapshot =
        composition.service_snapshot(harness.runtime, 1);
    if (rejected.status != composition.START_CONFIG
        || composition.active_service_generation(harness.runtime) != 0
        || harness.runtime.graph != ?harness.graph
        || active_after.generation != active_before.generation
        || active_after.live != active_before.live
        || active_after.cache_bindings != active_before.cache_bindings
        || candidate.live || candidate.generation != 0
        || serve.superseded(?quic_controls, ?harness.runtime.serving) != 0
        || !exchange_text(?harness, "hello from composition\n")) {
        composition.stop(harness.runtime, ?controls);
        ret 3;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0) {
        ret 4;
    }
    ret 0;
}

fun exchange_status(harness: *Harness, request: str, status_line: str) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)
        || !wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.serving, ?client,
        ?response[0], RESPONSE_BYTES, "\r\n\r\n");
    tcp.stream_close(?client);
    ret length != 0 && wire.starts_with(?response[0], length, status_line);
}

fun laurel_graph(harness: *Harness) {
    graph(harness, false);
    val site: *schema.Service = ?harness.graph.services[0];
    schema.set_text(?site.name, "application");
    site.kind = schema.SERVICE_LAUREL;
    schema.set_text(?site.target, "site");
    schema.clear_text(?site.content_type);
    schema.set_text(?harness.graph.routes[0].service, "application");
}

test "composition: a laurel service resolves at start and after reload" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    laurel_graph(?harness);
    var site: site_fixture.Site;
    if (!site_fixture.make_site(?site)) { ret 2; }
    var adapter:  hosting.Adapter;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    if (!hosting.make(?adapter, ?site.application)
        || !service.make_applications(?registry, ?slots[0], 1)
        || !service.register_application(?registry, "site",
        hosting.bound_handler(?adapter), 0)) { ret 3; }
    var options: composition.Options = composition.default_options();
    options.applications = ?registry;
    val started: composition.StartReport = start_with(?harness, ?controls,
        options);
    if (started.status != composition.START_OK) { ret 4; }
    if (!exchange_status(?harness,
        "GET /orders/42 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "HTTP/1.1 200 OK\r\n") || site.probe.order != 42) {
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }
    if (!exchange_status(?harness,
        "GET /missing HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "HTTP/1.1 202 Accepted\r\n") || site.probe.calls != 1) {
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }

    # the reloaded plan resolves the same registration
    harness.replacement = harness.graph;
    schema.set_text(?harness.replacement.routes[0].path, "/orders/**");
    schema.reset_diagnostics(?harness.diagnostics);
    val reloaded: composition.StartReport = composition.reload(harness.runtime,
        ?controls, ?harness.replacement, 2, ?harness.storages[1],
        ?harness.diagnostics);
    if (reloaded.status != composition.START_OK
        || !settle_connections(?harness)
        || !composition.reclaim_superseded(harness.runtime, ?controls)
        || !exchange_status(?harness,
        "GET /orders/7 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "HTTP/1.1 200 OK\r\n") || site.probe.order != 7) {
        composition.stop(harness.runtime, ?controls);
        ret 7;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime, ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0 || stopped.cleanup_failures != 0
        || app.active_request_count(?site.application) != 0) {
        ret 8;
    }
    ret 0;
}

test "composition: a laurel handler suspended on a fragmented body is entered once" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    laurel_graph(?harness);
    var site: site_fixture.Site;
    if (!site_fixture.make_site(?site)) { ret 2; }
    var adapter:  hosting.Adapter;
    var slots:    [1]service.Application;
    var registry: service.Applications;
    if (!hosting.make(?adapter, ?site.application)
        || !service.make_applications(?registry, ?slots[0], 1)
        || !service.register_application(?registry, "site",
        hosting.bound_handler(?adapter), 0)) { ret 3; }
    var options: composition.Options = composition.default_options();
    options.applications = ?registry;
    if (start_with(?harness, ?controls, options).status != composition.START_OK) {
        ret 4;
    }

    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        composition.stop(harness.runtime, ?controls);
        ret 5;
    }
    # the head alone: the handler is entered, finds no body, and suspends
    if (!wire.send(?client, FORM_HEAD)) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 6;
    }
    wire.pump(?harness.runtime.serving, 16);
    if (site.probe.entries != 1 || site.probe.work != 0) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 7;
    }
    # the body arrives in two writes, and neither one starts the handler again
    if (!wire.send(?client, "name=")) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 8;
    }
    wire.pump(?harness.runtime.serving, 16);
    if (site.probe.entries != 1 || site.probe.work != 0) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 9;
    }
    if (!wire.send(?client, "alice")) {
        tcp.stream_close(?client);
        composition.stop(harness.runtime, ?controls);
        ret 10;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime.serving, ?client,
        ?response[0], RESPONSE_BYTES, "alice");
    tcp.stream_close(?client);
    if (length == 0
        || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")
        || !wire.contains(?response[0], length, "alice")) {
        composition.stop(harness.runtime, ?controls);
        ret 11;
    }
    # entered once, resumed for what arrived after, and the work done exactly once
    if (site.probe.entries != 1 || site.probe.work != 1
        || site.probe.resumes == 0 || site.probe.exits != site.probe.layers
        || site.probe.abandons != 0) {
        composition.stop(harness.runtime, ?controls);
        ret 12;
    }
    val stopped: composition.StopReport = composition.stop(harness.runtime,
        ?controls);
    if (!stopped.stopped || stopped.serve_failures != 0
        || stopped.cleanup_failures != 0
        || app.active_request_count(?site.application) != 0) { ret 13; }
    ret 0;
}

test "composition: a laurel service without a registration is a configuration error" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    laurel_graph(?harness);
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_CONFIG
        || !str_equals(started.detail, "no application is registered under this name")) {
        composition.stop(harness.runtime, ?controls);
        ret 2;
    }
    ret 0;
}

val SILENT_TIMEOUT_MS: u64 = 300;

# a peer that connects and never sends is closed once the handshake timeout
# passes. the deadline was once built from the wall clock while io enforces the
# monotonic one, so it never arrived and the slot was held for good (#168)
fun silent_peer_is_closed(harness: *Harness) i32 {
    var quic_controls: quic_runtime.ControlView;
    var client:        tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret 10; }
    val started: time.Instant = clock.instant();
    var rounds:  usize        = 0;
    for (rounds < 400 && harness.runtime.serving.live == 0) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 1);
        rounds = rounds + 1;
    }
    if (harness.runtime.serving.live == 0) {
        tcp.stream_close(?client);
        ret 11;
    }
    # ten times the timeout is the most a working deadline can take
    val limit_ns: i64 = (SILENT_TIMEOUT_MS * 10 * 1000000)::i64;
    for (harness.runtime.serving.live != 0
        && time.instant_sub(clock.instant(), started) < limit_ns) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 5);
    }
    val elapsed_ms: i64  = time.instant_sub(clock.instant(), started) / 1000000;
    val closed:     bool = harness.runtime.serving.live == 0;
    tcp.stream_close(?client);
    if (!closed) { ret 12; }
    # closed by the timeout, not by something that fired at once
    if (elapsed_ms < (SILENT_TIMEOUT_MS / 2)::i64) { ret 13; }
    ret 0;
}

test "composition: a silent cleartext peer is closed at the handshake timeout" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    harness.graph.timeouts.handshake_ms = SILENT_TIMEOUT_MS;
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    val result: i32 = silent_peer_is_closed(?harness);
    composition.stop(harness.runtime, ?controls);
    ret result;
}

# the fixture listener speaks TLS with the interop certificate for api.example.com
fun secure_graph(harness: *Harness, protocols: u8) {
    val configured: *schema.Graph    = ?harness.graph;
    val public:     *schema.Listener = ?configured.listeners[0];
    schema.set_text(?public.tls_policy, "public");
    public.protocols = protocols;
    schema.set_text(?configured.hosts[0].server_names[0], "api.example.com");
    configured.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?configured.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate,
        "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key,
        "test/interop/fixtures/api.key");
    schema.set_text(?policy.default_name, "api.example.com");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
}

test "composition: a silent TLS peer is closed at the handshake timeout" {
    var controls: composition.Controls;
    var harness:  Harness;
    if (!prepare(?harness, false)) { ret 1; }
    secure_graph(?harness, schema.PROTOCOL_HTTP1);
    harness.graph.timeouts.handshake_ms = SILENT_TIMEOUT_MS;
    val started: composition.StartReport = boot(?harness, ?controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    val result: i32 = silent_peer_is_closed(?harness);
    composition.stop(harness.runtime, ?controls);
    ret result;
}

# a TLS client that stalls after its first byte (#189). each case holds a
# connection the way a slow client would. the connection has to be gone within
# ten times the timeout that governs that stall, and not sooner than half of it,
# so a close for some other reason does not pass.

val STALL_TIMEOUT_MS: u64 = 300;
val LONG_TIMEOUT_MS:  u64 = 20000;

fun stall_graph(harness: *Harness, protocols: u8, handshake_ms: u64) {
    secure_graph(harness, protocols);
    harness.graph.timeouts.handshake_ms  = handshake_ms;
    harness.graph.timeouts.header_ms     = STALL_TIMEOUT_MS;
    harness.graph.timeouts.keep_alive_ms = STALL_TIMEOUT_MS;
}

fun closed_within(harness: *Harness, since: time.Instant, timeout_ms: u64) i32 {
    var quic_controls: quic_runtime.ControlView;
    var rounds:        usize = 0;
    for (rounds < 400 && harness.runtime.serving.live == 0) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 1);
        rounds = rounds + 1;
    }
    if (harness.runtime.serving.live == 0) { ret 20; }
    val limit_ns: i64 = (timeout_ms * 10 * 1000000)::i64;
    for (harness.runtime.serving.live != 0
        && time.instant_sub(clock.instant(), since) < limit_ns) {
        serve.poll(?quic_controls, ?harness.runtime.serving, 5);
    }
    if (harness.runtime.serving.live != 0) { ret 21; }
    val elapsed_ms: i64 = time.instant_sub(clock.instant(), since) / 1000000;
    if (elapsed_ms < (timeout_ms / 2)::i64) { ret 22; }
    ret 0;
}

rec Stall {
    controls: composition.Controls;
    harness:  Harness;
    client:   *tlswire.Client;
}

fun stall_start(stall: *Stall, protocols: u8, handshake_ms: u64, alpn: str) i32 {
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, protocols, handshake_ms);
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.serving,
        "api.example.com", alpn)) {
        composition.stop(stall.harness.runtime, ?stall.controls);
        ret 3;
    }
    ret 0;
}

# a stop that gave up on what the case left open fails the case, which is how a
# close nothing finishes shows up here rather than as a hang (#273)
fun stall_finish(stall: *Stall, result: i32) i32 {
    if (stall.client != nil) { tlswire.release(stall.client); }
    composition.stop(stall.harness.runtime, ?stall.controls);
    if (result == 0 && !serve.finished(?stall.harness.runtime.serving)) { ret 90; }
    ret result;
}

fun hello_stall(half: bool) i32 {
    var stall:  Stall;
    val opened: i32 = stall_start(?stall, schema.PROTOCOL_HTTP1, STALL_TIMEOUT_MS,
        "http/1.1");
    if (opened != 0)                                          { ret opened; }
    if (!tlswire.hello(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 4); }
    var length: usize = tlswire.hello_length(stall.client);
    if (half) { length = length / 2; }
    val since: time.Instant = clock.instant();
    if (!tlswire.send_raw(stall.client, tlswire.hello_bytes(stall.client), length)) {
        ret stall_finish(?stall, 5);
    }
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

test "composition: a TLS client that stalls inside its ClientHello is closed" {
    ret hello_stall(true);
}

test "composition: a TLS client that never finishes its handshake is closed" {
    ret hello_stall(false);
}

# the handshake completes under a long deadline, so only the HTTP timeout can close it
fun open_stall(stall: *Stall, protocols: u8, alpn: str) i32 {
    val opened: i32 = stall_start(stall, protocols, LONG_TIMEOUT_MS, alpn);
    if (opened != 0)                                              { ret opened; }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret 6; }
    ret 0;
}

fun send_text(client: *tlswire.Client, text: str) bool {
    var length: usize = 0;
    for (text[length] != 0) { length = length + 1; }
    ret tlswire.send(client, text::*u8, length);
}

# the HTTP/1.1 engine starts its header timer at a request's first byte, so a
# connection that has sent none is idle and the keep-alive timeout governs it
test "composition: a TLS client silent after its handshake is closed at the keep-alive timeout" {
    var stall: Stall;
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS);
    stall.harness.graph.timeouts.header_ms = LONG_TIMEOUT_MS;
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret stall_finish(?stall, 2); }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.serving,
        "api.example.com", "http/1.1")
        || !tlswire.handshake(stall.client, stall.harness.endpoint)) {
        ret stall_finish(?stall, 3);
    }
    ret stall_finish(?stall, closed_within(?stall.harness, clock.instant(), STALL_TIMEOUT_MS));
}

test "composition: a partial request header over TLS is closed at the header timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    val since: time.Instant = clock.instant();
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.exa")) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

test "composition: an idle TLS keep-alive connection is closed at the keep-alive timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 7);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 8);
    }
    val since: time.Instant = clock.instant();
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

# a peer closing an idle TLS keep-alive connection is seen by the readiness
# wait, and the connection has to be retired then rather than at the keep-alive
# timeout (#257). `notify` sends close_notify first, as a well-behaved client
# does. without it the socket just closes, as most clients do
fun peer_closes_idle(notify: bool) i32 {
    var stall: Stall;
    if (!prepare(?stall.harness, false)) { ret 1; }
    # no timeout the connection could be retired by falls inside the bound
    stall_graph(?stall.harness, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS);
    stall.harness.graph.timeouts.header_ms     = LONG_TIMEOUT_MS;
    stall.harness.graph.timeouts.keep_alive_ms = LONG_TIMEOUT_MS;
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret stall_finish(?stall, 2); }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.serving,
        "api.example.com", "http/1.1")
        || !tlswire.handshake(stall.client, stall.harness.endpoint)) {
        ret stall_finish(?stall, 3);
    }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 4);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 5);
    }
    # the server settles its response and goes back to its idle wait
    var controls: quic_runtime.ControlView;
    var i:        usize = 0;
    for (i < 8) {
        serve.poll(?controls, ?stall.harness.runtime.serving, 0);
        i = i + 1;
    }
    if (stall.harness.runtime.serving.live != 1)       { ret stall_finish(?stall, 6); }
    if (notify && !tlswire.close_notify(stall.client)) { ret stall_finish(?stall, 7); }
    tlswire.release(stall.client);
    stall.client = nil;
    # a retired connection has closed its socket and left the live count. the
    # bound is far inside every timeout that could retire it instead
    val since: time.Instant = clock.instant();
    for (stall.harness.runtime.serving.live != 0
        && time.instant_sub(clock.instant(), since) < PEER_CLOSE_NS) {
        serve.poll(?controls, ?stall.harness.runtime.serving, 5);
    }
    if (stall.harness.runtime.serving.live != 0) { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, 0);
}

val PEER_CLOSE_NS: i64 = 2000000000;

test "composition: an idle TLS keep-alive connection is retired when the peer closes it" {
    ret peer_closes_idle(false);
}

test "composition: an idle TLS keep-alive connection is retired on the peer's close_notify" {
    ret peer_closes_idle(true);
}

fun send_frames(client: *tlswire.Client, bytes: *u8, length: usize) bool {
    ret tlswire.send(client, bytes, length);
}

# the peak the TLS lane must reach for the handshake to have borrowed its input,
# output and hello buffers at all: mach-tls sizes the peer handshake buffer at
# HANDSHAKE_INPUT_BYTES (16384), so a run that never crossed it never staged a
# handshake and the guard below would be vacuous
val TLS_HANDSHAKE_FOOTPRINT: usize = 16384;

# an established connection that has finished its handshake and returned to idle
# holds no TLS-lane buffer: hedge destroys the handshake write operation when it
# settles, which finishes mach-tls's handshake engine into the stream core and
# releases its input, output, hello and peer-parameter buffers back to the pool.
# the guard pins that release so a dependency bump or a settle-path refactor
# cannot silently strand ~18KB per idle connection.
test "composition: an idle TLS connection holds no handshake buffer" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    # the client considers the handshake done; drive the server so it settles the
    # handshake write and releases the engine before the connection is measured
    var controls: quic_runtime.ControlView;
    var i:        usize = 0;
    for (i < 8) {
        serve.poll(?controls, ?stall.harness.runtime.serving, 0);
        i = i + 1;
    }
    val idle: hedge_memory.Snapshot =
        hedge_memory.snapshot(?stall.harness.runtime.serving.memory);
    val lane: hedge_memory.LaneCounters = idle.lanes[hedge_memory.LANE_TLS::usize];
    if (lane.peak < TLS_HANDSHAKE_FOOTPRINT) { ret stall_finish(?stall, 7); }
    if (lane.held != 0)                      { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, 0);
}

# every chunk of the serving pool but what one connection reserves, held by an
# account of the test's own that never waits, so the next connection is admitted
# and then refused anything past its reservation
rec Hog {
    borrower: hedge_memory.Borrower;
    account:  buffers.Account;
    source:   buffers.Source;
    held:     [1024]buffers.Chunk;
    count:    usize;
    pool:     *hedge_memory.Memory;
    # pump turns the server spent waiting on the pool before the hog let go
    parked: usize;
    freed:  bool;
}

fun hog_room(pool: *hedge_memory.Memory) usize {
    val used: usize = pool.pool.reserved_total + pool.pool.overflow_used;
    if (used >= pool.pool.global_budget) { ret 0; }
    ret pool.pool.global_budget - used;
}

fun hog_take(hog: *Hog, pool: *hedge_memory.Memory, keep: usize) bool {
    hog.pool   = pool;
    hog.count  = 0;
    hog.parked = 0;
    hog.freed  = false;
    var budgets: hedge_memory.Budgets = hedge_memory.no_budgets();
    budgets.lanes[hedge_memory.LANE_REQUEST::usize] = pool.budget;
    hedge_memory.borrower(?hog.borrower, pool, 0x484f470000000000, 0, budgets);
    if (!hedge_memory.open(?hog.borrower, ?hog.account)) { ret false; }
    hog.source = hedge_memory.borrowed_source(?hog.borrower);
    var size: usize = 1048576;
    for (size >= 256) {
        for (hog.count < 1024 && hog_room(pool) >= size + keep) {
            val got: buffers.Acquired = buffers.source_acquire(?hog.source, ?hog.account,
                buffers.Request{bytes: size, align: 0, lane: hedge_memory.LANE_REQUEST,
                secret: false}, false);
            if (!(sel got.status.ok)) { ret false; }
            hog.held[hog.count] = got.chunk;
            hog.count           = hog.count + 1;
        }
        size = size / 2;
    }
    ret hog.count != 0 && hog.count < 1024;
}

fun hog_free(hog: *Hog) bool {
    if (hog.freed) { ret true; }
    hog.freed = true;
    for (hog.count != 0) {
        hog.count = hog.count - 1;
        buffers.source_release(?hog.source, ?hog.account, hog.held[hog.count]);
    }
    ret hedge_memory.close(hog.pool, ?hog.account);
}

val HOG_PARKED_TURNS: usize = 16;

# while the server's handshake waits on the pool the hog counts the turns it
# stays parked, then lets go
fun hog_pump(context: ptr) {
    val hog: *Hog = context::*Hog;
    if (hog.freed)                                    { ret; }
    if (hedge_memory.snapshot(hog.pool).waiters == 0) { ret; }
    hog.parked = hog.parked + 1;
    if (hog.parked >= HOG_PARKED_TURNS) { hog_free(hog); }
}

# a handshake whose TLS lane the pool refuses parks inside mach-tls, and only
# the account's wake retries it: the worker routes the pool's wake to
# `stream.resume` and the retry comes back as a completion (#195). the server
# makes no progress while the pool is held, and the handshake completes once
# the memory comes back
test "composition: a TLS handshake parked for memory resumes on its account's wake" {
    var stall:  Stall;
    val opened: i32 = stall_start(?stall, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS,
        "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var hog: Hog;
    if (!hog_take(?hog, ?stall.harness.runtime.serving.memory, lanes.RESERVE)) {
        ret stall_finish(?stall, 4);
    }
    tlswire.on_pump(stall.client, hog_pump, (?hog)::ptr);
    val shaken: bool                  = tlswire.handshake(stall.client, stall.harness.endpoint);
    val freed:  bool                  = hog_free(?hog);
    val seen:   hedge_memory.Snapshot = hedge_memory.snapshot(?stall.harness.runtime.serving.memory);
    if (hog.parked < HOG_PARKED_TURNS || !freed)                 { ret stall_finish(?stall, 5); }
    if (seen.lanes[hedge_memory.LANE_TLS::usize].exhausted == 0) { ret stall_finish(?stall, 6); }
    if (!shaken)                                                 { ret stall_finish(?stall, 7); }
    # the resumed connection serves as any other
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 8);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 9);
    }
    ret stall_finish(?stall, 0);
}

# an idle TLS keep-alive connection waits on its readiness wait alone, so turns
# that bring it nothing do not drive it (#195)
test "composition: an idle TLS keep-alive connection is not driven between events" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    if (!send_text(stall.client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) {
        ret stall_finish(?stall, 7);
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(stall.client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret stall_finish(?stall, 8);
    }
    # the response's own completions settle before the connection goes quiet
    var controls: quic_runtime.ControlView;
    var i:        usize = 0;
    for (i < 8) {
        serve.poll(?controls, ?stall.harness.runtime.serving, 0);
        i = i + 1;
    }
    val settled: u64 = serve.drives(?stall.harness.runtime.serving);
    i = 0;
    for (i < 50) {
        serve.poll(?controls, ?stall.harness.runtime.serving, 0);
        i = i + 1;
    }
    val idle: u64 = serve.drives(?stall.harness.runtime.serving) - settled;
    if (stall.harness.runtime.serving.live != 1) { ret stall_finish(?stall, 9); }
    if (idle != 0)                               { ret stall_finish(?stall, 10); }
    ret stall_finish(?stall, 0);
}

test "composition: an HTTP/2 client silent after its handshake is closed at the header timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    ret stall_finish(?stall, closed_within(?stall.harness, clock.instant(), STALL_TIMEOUT_MS));
}

test "composition: an HTTP/2 client that sends only its preface is closed at the header timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var frames: [256]u8;
    val length: usize        = wire.put_connection_start(?frames[0]);
    val since:  time.Instant = clock.instant();
    if (!send_frames(stall.client, ?frames[0], length)) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

test "composition: an HTTP/2 client that stalls inside a HEADERS frame is closed at the header timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    wire.put_request(?frames[0], start, 1);
    # the frame header and the first bytes of its block, and nothing after
    val since: time.Instant = clock.instant();
    if (!send_frames(stall.client, ?frames[0], start + 12)) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

test "composition: an HTTP/2 header block that never ends is closed at the header timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    # END_STREAM without END_HEADERS: the block waits for a CONTINUATION
    val ended: usize = wire.put_request(?frames[0], start, 1);
    frames[start + 4] = 0x01;
    val since: time.Instant = clock.instant();
    if (!send_frames(stall.client, ?frames[0], ended)) { ret stall_finish(?stall, 7); }
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

# true once the response on stream 1 has ended
fun h2_response_ended(bytes: *u8, length: usize) bool {
    var at: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (bytes[at]::usize << 16) | (bytes[at + 1]::usize << 8)
            | bytes[at + 2]::usize;
        val kind:   u8  = bytes[at + 3];
        val flags:  u8  = bytes[at + 4];
        val stream: u32 = (bytes[at + 5]::u32 << 24) | (bytes[at + 6]::u32 << 16)
            | (bytes[at + 7]::u32 << 8) | bytes[at + 8]::u32;
        if (stream == 1 && (kind == 0x00 || kind == 0x01) && (flags & 0x01) != 0) {
            ret true;
        }
        at = at + 9 + size;
    }
    ret false;
}

fun served_h2(client: *tlswire.Client) bool {
    var frames: [256]u8;
    val start:  usize = wire.put_connection_start(?frames[0]);
    val ended:  usize = wire.put_request(?frames[0], start, 1);
    if (!send_frames(client, ?frames[0], ended)) { ret false; }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    var reads:    usize = 0;
    for (reads < 16 && !h2_response_ended(?response[0], length)) {
        val got: usize = tlswire.receive(client, ?response[length],
            RESPONSE_BYTES - length, nil);
        if (got == 0) { brk; }
        length = length + got;
        reads  = reads + 1;
    }
    ret h2_response_ended(?response[0], length);
}

fun h2_has_frame(bytes: *u8, length: usize, wanted: u8) bool {
    var at: usize = 0;
    for (at + 9 <= length) {
        val size: usize = (bytes[at]::usize << 16) | (bytes[at + 1]::usize << 8)
            | bytes[at + 2]::usize;
        if (bytes[at + 3] == wanted) { ret true; }
        at = at + 9 + size;
    }
    ret false;
}

fun put_data(frames: *u8, at: usize, count: usize, size: usize, last: bool) usize {
    var length: usize = at;
    var sent:   usize = 0;
    for (sent < count) {
        var flags: u8 = 0;
        if (last && sent + 1 == count) { flags = 0x01; }
        val payload: usize = wire.put_frame(frames, length, size, 0x00, flags, 1);
        var i:       usize = 0;
        for (i < size) {
            frames[payload + i] = 'x';
            i                   = i + 1;
        }
        length = payload + size;
        sent   = sent + 1;
    }
    ret length;
}

# read frames until one of kind `wanted` has arrived, or the response has ended
# when `wanted` is 0xff
fun h2_await(client: *tlswire.Client, response: *u8, received: *usize, wanted: u8) bool {
    var reads: usize = 0;
    for (reads < 16) {
        if (wanted == 0xff && h2_response_ended(response, @received))    { ret true; }
        if (wanted != 0xff && h2_has_frame(response, @received, wanted)) { ret true; }
        val got: usize = tlswire.receive(client, ?response[@received],
            RESPONSE_BYTES - @received, nil);
        if (got == 0) { ret false; }
        @received = @received + got;
        reads     = reads + 1;
    }
    ret false;
}

# a body larger than the initial window can only finish once the server has read
# what it holds and credited the window back, with nothing new on the socket to
# tell it to
test "composition: an HTTP/2 request body over TLS larger than its window completes" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0) { ret stall_finish(?stall, opened); }
    val claimed: res[*u8, allocator.Error] = allocator.zallocate[u8](?stall.harness.heap, 65536);
    if (sel claimed.err) { ret stall_finish(?stall, 7); }
    val frames: *u8   = claimed.ok;
    var length: usize = wire.put_connection_start(frames);
    length = wire.put_open_request(frames, length, 1);
    length = put_data(frames, length, 8, 8000, false);
    if (!send_frames(stall.client, frames, length)) { ret stall_finish(?stall, 8); }
    var response: [RESPONSE_BYTES]u8;
    var received: usize = 0;
    if (!h2_await(stall.client, ?response[0], ?received, 0x08)) { ret stall_finish(?stall, 9); }
    length = put_data(frames, 0, 5, 8000, true);
    if (!send_frames(stall.client, frames, length))             { ret stall_finish(?stall, 10); }
    if (!h2_await(stall.client, ?response[0], ?received, 0xff)) { ret stall_finish(?stall, 11); }
    ret stall_finish(?stall, 0);
}

test "composition: an idle HTTP/2 connection is closed at the keep-alive timeout" {
    var stall:  Stall;
    val opened: i32 = open_stall(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0)              { ret stall_finish(?stall, opened); }
    if (!served_h2(stall.client)) { ret stall_finish(?stall, 8); }
    val since: time.Instant = clock.instant();
    ret stall_finish(?stall, closed_within(?stall.harness, since, STALL_TIMEOUT_MS));
}

# a connection that has answered a request and is waiting for the next one, with
# no timeout close enough to end it before the stop does
fun between_requests(stall: *Stall, protocols: u8, alpn: str) i32 {
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, protocols, LONG_TIMEOUT_MS);
    stall.harness.graph.timeouts.keep_alive_ms = LONG_TIMEOUT_MS;
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.serving,
        "api.example.com", alpn)) { ret 3; }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret 4; }
    ret 0;
}

test "composition: stop closes a TLS connection between requests" {
    var stall:  Stall;
    val opened: i32 = between_requests(?stall, schema.PROTOCOL_HTTP1, "http/1.1");
    if (opened != 0)                 { ret stall_finish(?stall, opened); }
    if (!served_hello(stall.client)) { ret stall_finish(?stall, 5); }
    ret stall_finish(?stall, 0);
}

test "composition: stop closes an HTTP/2 connection between requests" {
    var stall:  Stall;
    val opened: i32 = between_requests(?stall, schema.PROTOCOL_HTTP2, "h2");
    if (opened != 0)              { ret stall_finish(?stall, opened); }
    if (!served_h2(stall.client)) { ret stall_finish(?stall, 5); }
    ret stall_finish(?stall, 0);
}

# boot a TLS listener, optionally asking for client certificates or rotating
# ticket keys every second, then ready a client for it
fun tls_time_start(stall: *Stall, client_auth: bool, rotating: bool) i32 {
    if (!prepare(?stall.harness, false)) { ret 1; }
    stall_graph(?stall.harness, schema.PROTOCOL_HTTP1, LONG_TIMEOUT_MS);
    val policy: *schema.TlsPolicy = ?stall.harness.graph.tls_policies[0];
    if (client_auth) {
        policy.client_auth = true;
        schema.set_text(?policy.client_trust, "test/interop/fixtures/root.pem");
    }
    if (rotating) {
        policy.resumption.enabled                    = true;
        policy.resumption.key_lifetime_seconds       = 1;
        policy.resumption.retirement_overlap_seconds = 1;
        policy.resumption.ticket_lifetime_seconds    = 60;
        policy.resumption.replay_policy              = schema.TLS_REPLAY_PERMISSIVE;
        policy.resumption.tickets_per_connection     = 1;
    }
    val started: composition.StartReport = boot(?stall.harness, ?stall.controls, false);
    if (started.status != composition.START_OK) { ret 2; }
    stall.client = tlswire.allocate(?stall.harness.heap);
    if (stall.client == nil
        || !tlswire.make(stall.client, ?stall.harness.runtime.serving,
        "api.example.com", "http/1.1")) { ret 3; }
    ret 0;
}

fun served_hello(client: *tlswire.Client) bool {
    if (!send_text(client, "GET / HTTP/1.1\r\nHost: api.example.com\r\n\r\n")) { ret false; }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = tlswire.receive(client, ?response[0], RESPONSE_BYTES,
        "hello from composition\n");
    ret length != 0 && wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n");
}

test "composition: a valid client certificate is accepted over mutual TLS" {
    var stall:  Stall;
    val opened: i32 = tls_time_start(?stall, true, false);
    if (opened != 0) { ret stall_finish(?stall, opened); }
    if (!tlswire.present(stall.client, "test/interop/fixtures/client.pem",
        "test/interop/fixtures/client.key")) { ret stall_finish(?stall, 4); }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 5); }
    if (!served_hello(stall.client))                              { ret stall_finish(?stall, 6); }
    ret stall_finish(?stall, 0);
}

fun ticket_generation() u64 {
    val policy: *hedge_tls.Policy = hedge_tls.policy_at(hedge_tls.find("public"));
    if (policy == nil) { ret 0; }
    ret session.keyring_generation(?policy.ticket_ring);
}

test "composition: a ticket key past its lifetime rotates before the next handshake" {
    var stall:  Stall;
    val opened: i32 = tls_time_start(?stall, false, true);
    if (opened != 0)                                              { ret stall_finish(?stall, opened); }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 4); }
    val first: u64 = ticket_generation();
    if (first == 0) { ret stall_finish(?stall, 5); }
    tlswire.release(stall.client);
    # the key lifetime is one wall-clock second, so wait out two
    val until:         i64 = time.time_unix_sec(clock.wall()) + 2;
    var quic_controls: quic_runtime.ControlView;
    for (time.time_unix_sec(clock.wall()) <= until) {
        serve.poll(?quic_controls, ?stall.harness.runtime.serving, 10);
    }
    if (!tlswire.make(stall.client, ?stall.harness.runtime.serving, "api.example.com",
        "http/1.1")) { ret stall_finish(?stall, 6); }
    if (!tlswire.handshake(stall.client, stall.harness.endpoint)) { ret stall_finish(?stall, 7); }
    if (ticket_generation() != first + 1)                         { ret stall_finish(?stall, 8); }
    ret stall_finish(?stall, 0);
}
