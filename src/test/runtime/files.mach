# end-to-end static file tests against a real directory tree and real sockets

use hedge.config.schema;
use hedge.connection;
use hedge.dispatch.middleware;
use hedge.dispatch.plan;
use hedge.listener;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.serve;
use hedge.service;
use static_files: hedge.service.static;
use hedge.test.runtime.wire;
use http.core.status;
use http.router.router;
use heap_allocator: std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.filesystem;
use io_error: std.io.error;
use std.io.file;
use std.net.ip;
use std.net.tcp;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

fun present(outcome: res[bool, io_error.Error]) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun fs_ok(outcome: err[filesystem.FsError]) bool {
    ret sel outcome.ok;
}

val MAX_ROUTES:   usize = 8;
val MAX_SEGMENTS: usize = 64;
val MAX_SERVICES: usize = 8;
val PLAN_TEXT:    usize = 2048;
val POOL:         usize = 4;

rec Harness {
    graph:             schema.Graph;
    diagnostics:       schema.Diagnostics;
    routes:            [MAX_ROUTES]router.CompiledRoute;
    segments:          [MAX_SEGMENTS]router.Segment;
    specs:             [MAX_ROUTES]router.Route;
    entries:           [MAX_ROUTES]plan.Entry;
    services:          [MAX_SERVICES]service.Descriptor;
    middlewares:       [4]middleware.Middleware;
    text:              [PLAN_TEXT]u8;
    storage:           plan.Storage;
    plan:              plan.Plan;
    heap:              heap_allocator.Allocator;
    runtime:           serve.Runtime;
    applications:      service.Applications;
    application_slots: [2]service.Application;
    sites:             [2]static_files.Site;
    registry:          static_files.Registry;
    resolver:          service.Resolver;
    endpoint:          ip.Endpoint;
    root:              str;
    paths:             [8][256]u8;
}

fun write_file(path: str, data: *u8, length: usize) bool {
    ret fs_ok(filesystem.write_bytes(path, data, length, 420));
}

fun write_text(path: str, text: str) bool {
    ret write_file(path, text::*u8, str_len(text));
}

# truncating in place keeps the inode, so a descriptor already open for a
# response sees the representation shrink underneath it
fun truncate_in_place(path: str) bool {
    val created: res[filesystem.File, io_error.Error] = filesystem.create(path, 420);
    if (sel created.err) { ret false; }
    var handle: filesystem.File = created.ok;
    filesystem.close(?handle);
    ret true;
}

fun fill(buffer: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        buffer[i] = ('a' + (i % 26)::u8);
        i         = i + 1;
    }
}

val LARGE_BYTES:    usize = 131072;
val VOLATILE_BYTES: usize = 65536;

# tests run as parallel processes, so every one owns a private tree
val PATH_ROOT:     usize = 0;
val PATH_ASSETS:   usize = 1;
val PATH_INDEX:    usize = 2;
val PATH_HELLO:    usize = 3;
val PATH_LARGE:    usize = 4;
val PATH_VOLATILE: usize = 5;
val PATH_DATA:     usize = 6;
val PATH_OUTSIDE:  usize = 7;

fun compose(output: *u8, capacity: usize, head: str, tail: str) str {
    var at: usize = 0;
    for (head[at] != 0) {
        if (at + 1 >= capacity) { ret nil; }
        output[at] = head[at];
        at         = at + 1;
    }
    var i: usize = 0;
    for (tail[i] != 0) {
        if (at + i + 1 >= capacity) { ret nil; }
        output[at + i] = tail[i];
        i              = i + 1;
    }
    output[at + i] = 0;
    ret output::str;
}

fun path_of(harness: *Harness, slot: usize) str {
    ret (?harness.paths[slot][0])::str;
}

fun compose_paths(harness: *Harness, root: str) bool {
    harness.root = root;
    if (compose(?harness.paths[PATH_ROOT][0], 256, root, "") == nil)                         { ret false; }
    if (compose(?harness.paths[PATH_ASSETS][0], 256, root, "/assets") == nil)                { ret false; }
    if (compose(?harness.paths[PATH_INDEX][0], 256, root, "/index.html") == nil)             { ret false; }
    if (compose(?harness.paths[PATH_HELLO][0], 256, root, "/assets/hello.txt") == nil)       { ret false; }
    if (compose(?harness.paths[PATH_LARGE][0], 256, root, "/assets/large.bin") == nil)       { ret false; }
    if (compose(?harness.paths[PATH_VOLATILE][0], 256, root, "/assets/volatile.bin") == nil) { ret false; }
    if (compose(?harness.paths[PATH_DATA][0], 256, root, "/assets/data.txt") == nil)         { ret false; }
    if (compose(?harness.paths[PATH_OUTSIDE][0], 256, root, "-outside.txt") == nil)          { ret false; }
    ret true;
}

# a fixture that did not land is a broken test, not a failing assertion
fun sized(path: str, expected: usize) bool {
    val stat: res[filesystem.Metadata, io_error.Error] = filesystem.metadata(path);
    if (sel stat.err) { ret false; }
    ret stat.ok.size == expected;
}

fun ensure_dir(path: str) bool {
    if (present(filesystem.is_dir(path))) { ret true; }
    val created: err[io_error.Error] = filesystem.create_dir(path, 493);
    ret sel created.ok;
}

fun build_tree(harness: *Harness) bool {
    # fixtures live under the ignored build directory, never in the source tree
    if (!ensure_dir("out") || !ensure_dir(path_of(harness, PATH_ROOT))
        || !ensure_dir(path_of(harness, PATH_ASSETS))) { ret false; }
    if (!write_text(path_of(harness, PATH_INDEX), "<h1>index</h1>"))            { ret false; }
    if (!write_text(path_of(harness, PATH_HELLO), "hello static world"))        { ret false; }
    if (!write_text(path_of(harness, PATH_DATA), "plain representation"))       { ret false; }
    if (!write_text(path_of(harness, PATH_OUTSIDE), "secret outside the root")) { ret false; }
    var gz: [256]u8;
    if (compose(?gz[0], 256, path_of(harness, PATH_DATA), ".gz") == nil) { ret false; }
    if (!write_text((?gz[0])::str, "GZIPPED"))                           { ret false; }
    var large: [LARGE_BYTES]u8;
    fill(?large[0], LARGE_BYTES);
    if (!write_file(path_of(harness, PATH_LARGE), ?large[0], LARGE_BYTES)) { ret false; }
    if (!sized(path_of(harness, PATH_LARGE), LARGE_BYTES))                 { ret false; }
    # the shrink test damages its own copy, so the shared one stays trustworthy
    if (!write_file(path_of(harness, PATH_VOLATILE), ?large[0], VOLATILE_BYTES)) { ret false; }
    if (!sized(path_of(harness, PATH_VOLATILE), VOLATILE_BYTES))                 { ret false; }
    # a relative symlink that climbs out of the root, and one that leaves by absolute path
    var escape:   [256]u8;
    var absolute: [256]u8;
    var target:   [256]u8;
    if (compose(?escape[0], 256, path_of(harness, PATH_ASSETS), "/escape.txt") == nil) { ret false; }
    if (compose(?absolute[0], 256, path_of(harness, PATH_ASSETS), "/abs.txt") == nil)  { ret false; }
    if (compose(?target[0], 256, "../../", path_of(harness, PATH_OUTSIDE)) == nil)     { ret false; }
    filesystem.remove_file((?escape[0])::str);
    filesystem.remove_file((?absolute[0])::str);
    filesystem.symlink((?target[0])::str, (?escape[0])::str);
    filesystem.symlink("/etc/passwd", (?absolute[0])::str);
    ret true;
}

fun base_graph(harness: *Harness, graph: *schema.Graph, precompressed: bool) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "static-test");
    graph.limits.max_connections          = opt[usize].some{POOL};
    graph.limits.max_connections_per_peer = opt[usize].some{POOL};
    graph.listener_count                  = 1;
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.name, "public");
    schema.set_text(?configured.address, "127.0.0.1:0");
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport    = schema.TRANSPORT_TCP;
    configured.protocols    = schema.PROTOCOL_HTTP1;
    configured.backlog      = 16;
    configured.accept_depth = 2;
    graph.host_count        = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 1;
    val configured_service: *schema.Service = ?graph.services[0];
    schema.set_text(?configured_service.name, "files");
    configured_service.kind = schema.SERVICE_STATIC;
    schema.set_text(?configured_service.target, path_of(harness, PATH_ROOT));
    schema.set_text(?configured_service.index, "index.html");
    schema.clear_text(?configured_service.budget);
    schema.clear_text(?configured_service.content_type);
    configured_service.status        = 200;
    configured_service.precompressed = precompressed;
    graph.route_count                = 1;
    val configured_route: *schema.Route = ?graph.routes[0];
    schema.set_text(?configured_route.name, "files");
    schema.set_text(?configured_route.host, "site");
    schema.set_text(?configured_route.path, "/**");
    schema.set_text(?configured_route.service, "files");
    schema.clear_text(?configured_route.budget);
}

fun boot(harness: *Harness, generation: u64, precompressed: bool, root: str) bool {
    var quic_controls: quic_runtime.ControlView;
    if (!compose_paths(harness, root) || !build_tree(harness)) { ret false; }
    base_graph(harness, ?harness.graph, precompressed);
    service.make_applications(?harness.applications, ?harness.application_slots[0], 2);
    static_files.make_registry(?harness.registry, ?harness.sites[0], 2,
        generation, static_files.default_options());
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.static_files = service.Factory{
        ctx: (?harness.registry)::ptr,
        build: static_files.factory,
    };
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret false; }
    if (plan.compile(?harness.plan, generation, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK) { ret false; }
    page.make(?harness.heap);
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret false; }
    schema.reset_diagnostics(?harness.diagnostics);
    if (!serve.start(?quic_controls, ?harness.runtime, generation, ?harness.graph, ?harness.diagnostics)) { ret false; }
    val owned: *listener.OwnedListener = listener.active_listener(?harness.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) { ret false; }
    harness.endpoint = owned.bound_endpoint;
    ret true;
}

fun shutdown(harness: *Harness) {
    var quic_controls: quic_runtime.ControlView;
    serve.stop(?quic_controls, ?harness.runtime);
    static_files.close_registry(?harness.registry);
}

fun exchange_once(harness: *Harness, request: str, marker: str, response: *u8,
    capacity: usize, output: *usize) bool {
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    @output = wire.collect(?harness.runtime, ?client, response, capacity, marker);
    tcp.stream_close(?client);
    ret true;
}

fun status_is(response: *u8, length: usize, line: str) bool {
    ret wire.starts_with(response, length, line);
}

val RESPONSE_BYTES: usize = 8192;

test "static: a real file is served byte for byte with its validators" {
    var harness: Harness;
    if (!boot(?harness, 1, false, "out/fixture-basic")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "hello static world", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    shutdown(?harness);
    if (length == 0 || !status_is(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 3; }
    if (!wire.contains(?response[0], length, "content-length: 18"))             { ret 4; }
    if (!wire.contains(?response[0], length, "content-type: text/plain"))       { ret 5; }
    if (!wire.contains(?response[0], length, "accept-ranges: bytes"))           { ret 6; }
    if (!wire.contains(?response[0], length, "etag: \""))                       { ret 7; }
    if (!wire.contains(?response[0], length, "last-modified: "))                { ret 8; }
    if (!wire.contains(?response[0], length, "\r\n\r\nhello static world"))     { ret 9; }
    ret 0;
}

test "static: traversal never leaves the root, in any encoding" {
    var harness: Harness;
    if (!boot(?harness, 2, false, "out/fixture-traversal")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    # the escaped forms reach path resolution; a literal `..` is refused earlier still
    if (!exchange_once(?harness, "GET /%2e%2e/fixture-traversal-outside.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (length == 0 || wire.contains(?response[0], length, "secret outside the root")) {
        shutdown(?harness);
        ret 3;
    }
    if (!exchange_once(?harness, "GET /assets%2f%2e%2e%2f%2e%2e/fixture-traversal-outside.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 4;
    }
    if (length == 0 || wire.contains(?response[0], length, "secret outside the root")) {
        shutdown(?harness);
        ret 5;
    }
    if (!exchange_once(?harness, "GET /assets/%00 HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 6;
    }
    if (length == 0 || status_is(?response[0], length, "HTTP/1.1 200 ")) {
        shutdown(?harness);
        ret 7;
    }
    shutdown(?harness);
    ret 0;
}

test "static: a symlink out of the root is refused rather than followed" {
    var harness: Harness;
    if (!boot(?harness, 3, false, "out/fixture-symlink")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET /assets/escape.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 404 Not Found\r\n")) {
        shutdown(?harness);
        ret 3;
    }
    if (wire.contains(?response[0], length, "secret outside the root")) {
        shutdown(?harness);
        ret 4;
    }
    if (!exchange_once(?harness, "GET /assets/abs.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 404 Not Found\r\n")) {
        shutdown(?harness);
        ret 6;
    }
    if (wire.contains(?response[0], length, "root:")) {
        shutdown(?harness);
        ret 7;
    }
    shutdown(?harness);
    ret 0;
}

test "static: a directory serves its index and redirects a missing separator" {
    var harness: Harness;
    if (!boot(?harness, 4, false, "out/fixture-index")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "<h1>index</h1>", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.contains(?response[0], length, "content-type: text/html")) {
        shutdown(?harness);
        ret 4;
    }
    if (!exchange_once(?harness, "GET /assets HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    shutdown(?harness);
    if (!status_is(?response[0], length, "HTTP/1.1 301 Moved Permanently\r\n")) { ret 6; }
    if (!wire.contains(?response[0], length, "location: /assets/"))             { ret 7; }
    ret 0;
}

test "static: a cache validator answers 304 and a stale one answers 200" {
    var harness: Harness;
    if (!boot(?harness, 5, false, "out/fixture-validator")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "hello static world", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    var etag:        [128]u8;
    val etag_length: usize = wire.field_value(?response[0], length, "etag: ", ?etag[0], 128);
    if (etag_length == 0) {
        shutdown(?harness);
        ret 3;
    }
    var conditional: [512]u8;
    val built:       usize = wire.build_request(?conditional[0], 512,
        "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: ",
        ?etag[0], etag_length, "\r\n\r\n");
    if (built == 0) {
        shutdown(?harness);
        ret 4;
    }
    if (!exchange_once(?harness, (?conditional[0])::str, "\r\n\r\n",
        ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 5;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 304 Not Modified\r\n")) {
        shutdown(?harness);
        ret 6;
    }
    if (wire.contains(?response[0], length, "hello static world")) {
        shutdown(?harness);
        ret 7;
    }
    if (!exchange_once(?harness,
        "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nIf-None-Match: \"stale\"\r\n\r\n",
        "hello static world", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 8;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        shutdown(?harness);
        ret 9;
    }
    if (!exchange_once(?harness,
        "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nIf-Match: \"stale\"\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 10;
    }
    shutdown(?harness);
    if (!status_is(?response[0], length, "HTTP/1.1 412 Precondition Failed\r\n")) { ret 11; }
    ret 0;
}

test "static: a range is served as 206 and an impossible one as 416" {
    var harness: Harness;
    if (!boot(?harness, 6, false, "out/fixture-range")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=6-11\r\n\r\n",
        "static", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 206 Partial Content\r\n")) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.contains(?response[0], length, "content-range: bytes 6-11/18")) {
        shutdown(?harness);
        ret 4;
    }
    if (!wire.contains(?response[0], length, "content-length: 6")) {
        shutdown(?harness);
        ret 5;
    }
    if (!wire.contains(?response[0], length, "\r\n\r\nstatic")) {
        shutdown(?harness);
        ret 6;
    }
    if (!exchange_once(?harness,
        "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=500-600\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 7;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 416 Range Not Satisfiable\r\n")) {
        shutdown(?harness);
        ret 8;
    }
    if (!wire.contains(?response[0], length, "content-range: bytes */18")) {
        shutdown(?harness);
        ret 9;
    }
    # a multi-range request is not honoured, and the whole representation is a legal answer
    if (!exchange_once(?harness,
        "GET /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\nRange: bytes=0-1,5-6\r\n\r\n",
        "hello static world", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 10;
    }
    shutdown(?harness);
    if (!status_is(?response[0], length, "HTTP/1.1 200 OK\r\n")) { ret 11; }
    ret 0;
}

test "static: HEAD carries the length the matching GET would send, with no body" {
    var harness: Harness;
    if (!boot(?harness, 7, false, "out/fixture-head")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness, "HEAD /assets/hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "\r\n\r\n", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    shutdown(?harness);
    if (!status_is(?response[0], length, "HTTP/1.1 200 OK\r\n"))    { ret 3; }
    if (!wire.contains(?response[0], length, "content-length: 18")) { ret 4; }
    if (wire.contains(?response[0], length, "hello static world"))  { ret 5; }
    ret 0;
}

test "static: a precompressed variant is served with its own validators" {
    var harness: Harness;
    if (!boot(?harness, 8, true, "out/fixture-variant")) {
        shutdown(?harness);
        ret 1;
    }
    var response: [RESPONSE_BYTES]u8;
    var length:   usize = 0;
    if (!exchange_once(?harness,
        "GET /assets/data.txt HTTP/1.1\r\nHost: localhost\r\nAccept-Encoding: gzip\r\n\r\n",
        "GZIPPED", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 2;
    }
    if (!status_is(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        shutdown(?harness);
        ret 3;
    }
    if (!wire.contains(?response[0], length, "content-encoding: gzip")) {
        shutdown(?harness);
        ret 4;
    }
    if (!wire.contains(?response[0], length, "vary: accept-encoding")) {
        shutdown(?harness);
        ret 5;
    }
    # the media type follows the underlying representation, not the variant suffix
    if (!wire.contains(?response[0], length, "content-type: text/plain")) {
        shutdown(?harness);
        ret 6;
    }
    if (!wire.contains(?response[0], length, "content-length: 7")) {
        shutdown(?harness);
        ret 7;
    }
    # a client that does not accept the encoding gets the plain representation
    if (!exchange_once(?harness, "GET /assets/data.txt HTTP/1.1\r\nHost: localhost\r\n\r\n",
        "plain representation", ?response[0], RESPONSE_BYTES, ?length)) {
        shutdown(?harness);
        ret 8;
    }
    shutdown(?harness);
    if (wire.contains(?response[0], length, "content-encoding")) { ret 9; }
    ret 0;
}

test "static: a large file crosses many buffers without losing a byte" {
    var harness: Harness;
    if (!boot(?harness, 9, false, "out/fixture-large")) {
        shutdown(?harness);
        ret 1;
    }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        shutdown(?harness);
        ret 2;
    }
    if (!wire.send(?client, "GET /assets/large.bin HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 3;
    }
    var received: [LARGE_BYTES + 4096]u8;
    val total:    usize = wire.drain(?harness.runtime, ?client, ?received[0], LARGE_BYTES + 4096);
    tcp.stream_close(?client);
    shutdown(?harness);
    if (total == 0 || !status_is(?received[0], total, "HTTP/1.1 200 OK\r\n")) { ret 4; }
    if (!wire.contains(?received[0], total, "content-length: 131072"))        { ret 5; }
    val head: usize = wire.body_offset(?received[0], total);
    if (head == 0 || total - head != LARGE_BYTES) { ret 6; }
    var expected: [LARGE_BYTES]u8;
    fill(?expected[0], LARGE_BYTES);
    var i: usize = 0;
    for (i < LARGE_BYTES) {
        if (received[head + i] != expected[i]) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "static: a representation that shrinks mid-response fails rather than truncating" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    if (!boot(?harness, 10, false, "out/fixture-shrink")) {
        shutdown(?harness);
        ret 1;
    }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        shutdown(?harness);
        ret 2;
    }
    if (!wire.send(?client, "GET /assets/volatile.bin HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 3;
    }
    # let the head and the first buffers go out, then shrink the same inode
    var rounds: usize = 0;
    for (rounds < 3) {
        serve.poll(?quic_controls, ?harness.runtime, 5);
        rounds = rounds + 1;
    }
    if (!truncate_in_place(path_of(?harness, PATH_VOLATILE))) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 4;
    }
    var received:   [LARGE_BYTES + 4096]u8;
    val total:      usize               = wire.drain(?harness.runtime, ?client, ?received[0], LARGE_BYTES + 4096);
    val view_state: connection.Snapshot = connection.snapshot(serve.slot_connection(?harness.runtime, 0));
    tcp.stream_close(?client);
    shutdown(?harness);
    if (total == 0 || !status_is(?received[0], total, "HTTP/1.1 200 OK\r\n")) { ret 5; }
    val head: usize = wire.body_offset(?received[0], total);
    if (head == 0) { ret 6; }
    # the client must never see a complete, silently short representation
    if (total - head == LARGE_BYTES)           { ret 7; }
    if (view_state.state == connection.ACTIVE) { ret 8; }
    ret 0;
}

test "static: a large body streams through a bounded buffer, never buffered whole" {
    var harness: Harness;
    if (!boot(?harness, 11, false, "out/fixture-stream")) {
        shutdown(?harness);
        ret 1;
    }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        shutdown(?harness);
        ret 2;
    }
    # a small receive window keeps the peer behind the server for most of the transfer
    if (!wire.shrink_receive_buffer(?client, 2048)) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 3;
    }
    if (!wire.send(?client, "GET /assets/large.bin HTTP/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        shutdown(?harness);
        ret 4;
    }
    var received:   [LARGE_BYTES + 4096]u8;
    val total:      usize               = wire.drain(?harness.runtime, ?client, ?received[0], LARGE_BYTES + 4096);
    val view_state: connection.Snapshot = connection.snapshot(serve.slot_connection(?harness.runtime, 0));
    tcp.stream_close(?client);
    shutdown(?harness);
    val head: usize = wire.body_offset(?received[0], total);
    if (head == 0 || total - head != LARGE_BYTES) { ret 5; }
    # the body reached the wire in many bounded reads rather than one whole-file
    # read, so the memory a response costs does not scale with the file
    val minimum: u64 = (LARGE_BYTES / connection.READ_BYTES)::u64;
    if (view_state.body_chunks < minimum) { ret 6; }
    ret 0;
}
