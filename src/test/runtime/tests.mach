# native listener and process ownership tests

use std.runtime;

fun status_persisted(status: sink.WriteStatus) bool {
    ret sel status.persisted;
}

fwd hedge.test.runtime.wire;
fwd hedge.test.runtime.serving;
fwd hedge.test.runtime.protocol;
fwd hedge.test.runtime.lifecycle;
fwd hedge.test.runtime.files;
fwd hedge.test.runtime.proxying;
fwd hedge.test.runtime.caching;
fwd hedge.test.runtime.composition;
fwd hedge.test.runtime.telemetry;
use hedge.config.schema;
use hedge.listener;
use hedge.server;
use hedge_socket:      hedge.socket;
use observability:     hedge.telemetry;
use telemetry_admin:   hedge.telemetry.admin;
use telemetry_health:  hedge.telemetry.health;
use telemetry_metrics: hedge.telemetry.metrics;
use io_error:          std.io.error;
use io_runtime:        std.io.runtime;
use std.log.record;
use std.log.sink;
use net_async: std.net.async;
use std.net.ip;
use std.net.tcp;
use process_events: std.process.events;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

$if ($mach.build.os == $mach.os.linux) {
    use linux_os: std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use std.system.os.darwin.libsystem;
}

val NO_INDEX: usize = 0xffffffffffffffff;

rec TelemetryTarget {
    writes:  usize;
    flushes: usize;
}

fun telemetry_publish(context: ptr, data: *u8, length: usize) sink.WriteReport {
    val target: *TelemetryTarget = context::*TelemetryTarget;
    target.writes = target.writes + 1;
    ret sink.persisted(length);
}

fun telemetry_flush(context: ptr) bool {
    val target: *TelemetryTarget = context::*TelemetryTarget;
    target.flushes = target.flushes + 1;
    ret true;
}

fun base_graph(graph: *schema.Graph, max_connections: usize) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "runtime-test");
    graph.limits.max_connections          = opt[usize].some{max_connections};
    graph.limits.max_connections_per_peer = opt[usize].some{max_connections};
    graph.listener_count                  = 0;
}

fun add_listener(graph: *schema.Graph, name: str, address: str, transport: u8, protocols: u8, backlog: usize, accept_depth: usize) {
    val index:      usize            = graph.listener_count;
    val configured: *schema.Listener = ?graph.listeners[index];
    schema.set_text(?configured.name, name);
    schema.set_text(?configured.address, address);
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport    = transport;
    configured.protocols    = protocols;
    configured.backlog      = backlog;
    configured.accept_depth = accept_depth;
    graph.listener_count    = index + 1;
}

fun connect_one(endpoint: ip.Endpoint, output: *tcp.Stream) bool {
    val connected: res[tcp.Stream, io_error.Error] = tcp.connect(endpoint);
    if (sel connected.err) { ret false; }
    @output = connected.ok;
    ret true;
}

fun wait_connection(owner: *listener.Owner, output: *listener.ConnectionToken) bool {
    var attempts: usize = 0;
    for (attempts < 8) {
        if (listener.take_connection(owner, output)) { ret true; }
        if (!listener.poll(owner, 1000))             { ret false; }
        attempts = attempts + 1;
    }
    ret listener.take_connection(owner, output);
}

fun raise_reload(owner: *listener.Owner) bool {
    $if ($mach.build.os == $mach.os.linux) {
        var number: usize = 129;
        $if ($mach.build.arch == $mach.arch.x86_64) { number = 62; }
        ret linux_os.syscall2(number, os.getpid()::usize, 1) >= 0;
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret libsystem.raise(1) == 0;
    }
    $or {
        ret listener.handle_process_event(owner, process_events.Event{kind: process_events.RELOAD});
    }
}

fun raise_interrupt(owner: *listener.Owner) bool {
    $if ($mach.build.os == $mach.os.linux) {
        var number: usize = 129;
        $if ($mach.build.arch == $mach.arch.x86_64) { number = 62; }
        ret linux_os.syscall2(number, os.getpid()::usize, 2) >= 0;
    }
    $or ($mach.build.os == $mach.os.darwin) {
        ret libsystem.raise(2) == 0;
    }
    $or {
        val notified: err[io_error.Error] = process_events.notify_service_stop(?owner.process);
        ret sel notified.ok;
    }
}

fun native_handle_count() usize {
    $if ($mach.build.os == $mach.os.linux) {
        var dir:    usize = os.INVALID_HANDLE;
        val opened: i64   = os.open(os.working_dir(), "/proc/self/fd",
            os.O_RDONLY | os.O_DIRECTORY, 0, ?dir);
        if (opened < 0) { ret NO_INDEX; }
        var cursor: os.DirectoryCursor;
        cursor.address = 0;
        val started: os.DirectoryInitResult = os.directory_init(?cursor, dir);
        if (started.code < 0) {
            os.close(dir);
            ret NO_INDEX;
        }
        var count: usize = 0;
        for (true) {
            var entry:    os.DirectoryEntry;
            val advanced: i64 = os.directory_next(?cursor, ?entry);
            if (advanced < 0) {
                os.directory_close(?cursor);
                os.close(dir);
                ret NO_INDEX;
            }
            if (advanced == 0) { brk; }
            count = count + 1;
        }
        os.directory_close(?cursor);
        os.close(dir);
        ret count;
    }
    $or {
        ret 0;
    }
}

test "runtime: TCP IPv4 IPv6 and local listeners are ready before publication" {
    var graph: schema.Graph;
    base_graph(?graph, 16);
    add_listener(?graph, "tcp4", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 64, 2);
    add_listener(?graph, "tcp6", "[::1]:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 64, 2);
    $if ($mach.build.os == $mach.os.linux) {
        add_listener(?graph, "local", "@hedge-runtime-owner", schema.TRANSPORT_LOCAL, schema.PROTOCOL_HTTP1, 64, 2);
    }
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?graph, ?diagnostics)) { ret 1; }
    val state:            listener.Snapshot = listener.snapshot(?runtime);
    var expected_accepts: usize             = 4;
    $if ($mach.build.os == $mach.os.linux) { expected_accepts = expected_accepts + 2; }
    if (state.state != listener.OWNER_READY || state.generation != 1 || state.listeners != graph.listener_count || state.pending_accepts != expected_accepts || !runtime.sigpipe_configured || !runtime.process_initialized) {
        listener.stop(?runtime);
        ret 2;
    }
    var i: usize = 0;
    for (i < 2) {
        val owned: *listener.OwnedListener = listener.active_listener(?runtime, i);
        if (owned == nil || !owned.has_bound_endpoint || owned.bound_endpoint.port == 0) {
            listener.stop(?runtime);
            ret 3;
        }
        i = i + 1;
    }
    if (!listener.stop(?runtime) || listener.snapshot(?runtime).state != listener.OWNER_STOPPED) { ret 4; }
    ret 0;
}

test "runtime: a datagram listener owns its bound UDP socket" {
    var graph: schema.Graph;
    base_graph(?graph, 16);
    add_listener(?graph, "tcp4", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 64, 2);
    add_listener(?graph, "udp4", "127.0.0.1:0", schema.TRANSPORT_QUIC, schema.PROTOCOL_HTTP3, 64, 1);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?graph, ?diagnostics)) { ret 1; }
    val owned: *listener.OwnedListener =
        listener.active_listener(?runtime, 1);
    if (owned == nil || !owned.has_udp_socket || !owned.has_bound_endpoint ||
        owned.bound_endpoint.port == 0 || diagnostics.error_count != 0) {
        listener.stop(?runtime);
        ret 2;
    }
    if (!listener.stop(?runtime) || owned.has_udp_socket) { ret 3; }
    ret 0;
}

test "runtime: failed reload preserves generation and accepted connection" {
    var graph: schema.Graph;
    base_graph(?graph, 4);
    add_listener(?graph, "public", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 32, 2);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 10, ?graph, ?diagnostics)) { ret 1; }
    val owned:  *listener.OwnedListener = listener.active_listener(?runtime, 0);
    var client: tcp.Stream;
    if (owned == nil || !connect_one(owned.bound_endpoint, ?client)) {
        listener.stop(?runtime);
        ret 2;
    }
    var token: listener.ConnectionToken;
    if (!wait_connection(?runtime, ?token)) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 3;
    }

    var address: [64]u8;
    ip.endpoint_format(owned.bound_endpoint, ?address[0], 64);
    var replacement: schema.Graph;
    base_graph(?replacement, 4);
    add_listener(?replacement, "replacement", (?address[0])::str, schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 32, 2);
    schema.reset_diagnostics(?diagnostics);
    if (listener.reload(?runtime, 11, ?replacement, ?diagnostics)) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 4;
    }
    val state: listener.Snapshot = listener.snapshot(?runtime);
    if (state.generation != 10 || state.connections != 1 || listener.inspect_connection(?runtime, token) == nil || diagnostics.error_count == 0) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 5;
    }
    schema.set_text(?replacement.listeners[0].address, "127.0.0.1:0");
    schema.reset_diagnostics(?diagnostics);
    if (!listener.reload(?runtime, 11, ?replacement, ?diagnostics)) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 6;
    }
    val reloaded: listener.Snapshot = listener.snapshot(?runtime);
    if (reloaded.generation != 11 || reloaded.connections != 1 || listener.inspect_connection(?runtime, token) == nil) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 7;
    }
    tcp.stream_close(?client);
    if (!listener.close_connection(?runtime, token) || !listener.stop(?runtime)) { ret 8; }
    ret 0;
}

test "runtime: admission exhaustion pauses and replenishes accept depth" {
    var graph: schema.Graph;
    base_graph(?graph, 1);
    add_listener(?graph, "limited", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 8, 2);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?graph, ?diagnostics)) { ret 1; }
    val owned:    *listener.OwnedListener = listener.active_listener(?runtime, 0);
    var first:    tcp.Stream;
    var overflow: tcp.Stream;
    if (owned == nil || !connect_one(owned.bound_endpoint, ?first) || !connect_one(owned.bound_endpoint, ?overflow)) {
        listener.stop(?runtime);
        ret 2;
    }
    var token: listener.ConnectionToken;
    if (!wait_connection(?runtime, ?token)) {
        tcp.stream_close(?first);
        tcp.stream_close(?overflow);
        listener.stop(?runtime);
        ret 3;
    }
    listener.poll(?runtime, 20);
    if (listener.snapshot(?runtime).connections != 1) {
        tcp.stream_close(?first);
        tcp.stream_close(?overflow);
        listener.stop(?runtime);
        ret 4;
    }
    tcp.stream_close(?first);
    tcp.stream_close(?overflow);
    if (!listener.close_connection(?runtime, token)) {
        listener.stop(?runtime);
        ret 5;
    }
    var replacement: tcp.Stream;
    if (!connect_one(owned.bound_endpoint, ?replacement) || !wait_connection(?runtime, ?token)) {
        listener.stop(?runtime);
        ret 6;
    }
    tcp.stream_close(?replacement);
    if (!listener.close_connection(?runtime, token) || !listener.stop(?runtime)) { ret 7; }
    ret 0;
}

# a socket the driver still holds operations for has to be closed through the
# driver: a direct close left the operation on a backend resource keyed by the
# old descriptor, where the next socket to reuse it would pick it up (#157)
test "runtime: closing a connection settles what the driver still holds for it" {
    var graph: schema.Graph;
    base_graph(?graph, 4);
    add_listener(?graph, "public", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 32, 2);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?graph, ?diagnostics)) { ret 1; }
    val owned:  *listener.OwnedListener = listener.active_listener(?runtime, 0);
    var client: tcp.Stream;
    if (owned == nil || !connect_one(owned.bound_endpoint, ?client)) {
        listener.stop(?runtime);
        ret 2;
    }
    var token: listener.ConnectionToken;
    if (!wait_connection(?runtime, ?token)) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 3;
    }
    val connection: *listener.Connection = listener.inspect_connection(?runtime, token);
    val before:     usize                = io_runtime.pending(?runtime.runtime);
    var buffer:     [16]u8;
    # the client never writes, so this read stays pending until something settles it
    val read: res[io_runtime.Token, io_error.Error] = hedge_socket.submit_read(?connection.socket,
        ?runtime.root_scope, ?buffer[0], 16, 0);
    if ((sel read.err) || io_runtime.pending(?runtime.runtime) != before + 1) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 4;
    }
    if (!listener.close_connection(?runtime, token)) {
        tcp.stream_close(?client);
        listener.stop(?runtime);
        ret 5;
    }
    listener.poll(?runtime, 20);
    val after: usize = io_runtime.pending(?runtime.runtime);
    tcp.stream_close(?client);
    if (!listener.stop(?runtime)) { ret 6; }
    if (after != before)          { ret 7; }
    ret 0;
}

# a retired TCP listener closes through the driver too, so an accept it still
# holds settles instead of staying on the old descriptor (#157)
test "runtime: retiring a listener settles an accept the driver still holds" {
    var graph: schema.Graph;
    base_graph(?graph, 4);
    add_listener(?graph, "public", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 32, 2);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?graph, ?diagnostics)) { ret 1; }
    val owned: *listener.OwnedListener = listener.active_listener(?runtime, 0);
    if (owned == nil) {
        listener.stop(?runtime);
        ret 2;
    }
    val before: usize = io_runtime.pending(?runtime.runtime);
    var peer:   ip.Endpoint;
    # on the root scope, so retiring the set does not cancel it: only the close can
    val accept: res[io_runtime.Token, io_error.Error] = net_async.submit_accept(?runtime.network,
        ?runtime.root_scope, ?owned.tcp_listener, ?peer, 0);
    if ((sel accept.err) || io_runtime.pending(?runtime.runtime) != before + 1) {
        listener.stop(?runtime);
        ret 3;
    }
    var replacement: schema.Graph;
    base_graph(?replacement, 4);
    add_listener(?replacement, "replacement", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 32, 2);
    schema.reset_diagnostics(?diagnostics);
    if (!listener.reload(?runtime, 2, ?replacement, ?diagnostics)) {
        listener.stop(?runtime);
        ret 4;
    }
    listener.poll(?runtime, 20);
    val after: usize = io_runtime.pending(?runtime.runtime);
    if (!listener.stop(?runtime)) { ret 5; }
    if (after != before)          { ret 6; }
    ret 0;
}

test "runtime: native reload and interruption events retain explicit ownership" {
    var graph: schema.Graph;
    base_graph(?graph, 2);
    add_listener(?graph, "control", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 8, 1);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?graph, ?diagnostics)) { ret 1; }
    if (!raise_reload(?runtime) || !listener.poll(?runtime, 1000)) {
        listener.stop(?runtime);
        ret 2;
    }
    if (!listener.snapshot(?runtime).reload_requested || !listener.clear_reload_request(?runtime)) {
        listener.stop(?runtime);
        ret 3;
    }
    if (!raise_interrupt(?runtime) || !listener.poll(?runtime, 1000)) {
        listener.stop(?runtime);
        ret 4;
    }
    val state: listener.Snapshot = listener.snapshot(?runtime);
    if (!state.stop_requested || state.state != listener.OWNER_DRAINING) {
        listener.stop(?runtime);
        ret 5;
    }
    if (!listener.stop(?runtime)) { ret 6; }
    ret 0;
}

test "runtime: repeated ownership cycles release the bound handle" {
    var initial: schema.Graph;
    base_graph(?initial, 2);
    add_listener(?initial, "leak", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 8, 1);
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var runtime: listener.Owner;
    if (!listener.start(?runtime, 1, ?initial, ?diagnostics)) { ret 1; }
    if (!listener.stop(?runtime))                             { ret 2; }
    val handles_before: usize = native_handle_count();
    var cycle:          usize = 0;
    for (cycle < 16) {
        var graph: schema.Graph;
        base_graph(?graph, 2);
        # each cycle takes an ephemeral port of its own: reusing one fixed port
        # would race the other test processes and fail for a reason this test is
        # not about
        add_listener(?graph, "leak", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 8, 1);
        schema.reset_diagnostics(?diagnostics);
        if (!listener.start(?runtime, cycle::u64 + 2, ?graph, ?diagnostics)) { ret 3; }
        if (!listener.stop(?runtime))                                        { ret 4; }
        cycle = cycle + 1;
    }
    val handles_after: usize = native_handle_count();
    $if ($mach.build.os == $mach.os.linux) {
        if (handles_before == NO_INDEX || handles_after != handles_before) { ret 5; }
    }
    ret 0;
}

test "runtime: server readiness and telemetry flush follow listener ownership" {
    var graph: schema.Graph;
    base_graph(?graph, 2);
    add_listener(?graph, "observed", "127.0.0.1:0", schema.TRANSPORT_TCP, schema.PROTOCOL_HTTP1, 8, 1);
    graph.telemetry.logs             = true;
    graph.telemetry.log_record_bytes = 512;
    var target: TelemetryTarget;
    target.writes  = 0;
    target.flushes = 0;
    val contract:  sink.Contract = sink.Contract{delivery: sink.DELIVERY_DIRECT, max_record: 512, oversize: record.OVERSIZE_REJECT, adapter: sink.ADAPTER_CUSTOM, target_atomic_limit: 0, queue_capacity: 0, overload: sink.OVERLOAD_REJECT_NEW};
    var output:    sink.Sink     = sink.Sink{ctx: (?target)::ptr, f_publish: telemetry_publish, contract: contract};
    var checks:    [1]telemetry_health.Check;
    var telemetry: observability.Runtime;
    if (!observability.make(
        ?telemetry,
        ?graph,
        ?output,
        (0::usize)::*telemetry_metrics.Series,
        0,
        ?checks[0],
        1,
        nil,
        (0::usize)::telemetry_admin.AuthenticateFun,
        nil,
        (0::usize)::telemetry_admin.RenderFun,
        (0::usize)::telemetry_admin.RenderFun,
        (?target)::ptr,
        telemetry_flush,
    )) { ret 1; }
    var instance: server.Server;
    if (!server.make(?instance) || !server.attach_telemetry(?instance, ?telemetry)) { ret 2; }
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    if (!server.start(?instance, 1, ?graph, ?diagnostics)) { ret 3; }
    if (!server.is_ready(?instance) || !telemetry_health.snapshot(?telemetry.health).ready) {
        server.stop(?instance);
        ret 4;
    }
    if (!status_persisted(observability.access(?telemetry, observability.Access{listener: "observed", method: "GET", target: "/health", protocol: "HTTP/1.1", status: 200, duration_us: 1, request_bytes: 0, response_bytes: 2, trace_id: nil}).status)) {
        server.stop(?instance);
        ret 5;
    }
    if (!server.stop(?instance) || target.writes != 1 || target.flushes != 1) { ret 6; }
    val health_state: telemetry_health.Snapshot = telemetry_health.snapshot(?telemetry.health);
    if (health_state.ready || !health_state.draining) { ret 7; }
    ret 0;
}
