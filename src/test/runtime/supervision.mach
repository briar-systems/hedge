# the supervisor and its worker threads over real sockets
#
# these run the process the way the executable does: workers serve on threads
# of their own, the supervisor on another, and this thread is only a client.
# nothing here polls a serving runtime.

use crypto.contracts;
use hedge.allowance;
use http_cache: hedge.cache;
use hedge.clock;
use hedge.composition;
use hedge.config.schema;
use hedge.dispatch.call;
use hedge.generation;
use hedge.lifecycle;
use hedge.listener;
use hedge.outbound;
use hedge.service;
use hedge.settings;
use hedge.supervisor;
use hedge.task;
use telemetry_health: hedge.telemetry.health;
use hedge.test.runtime.wire;
use hedge.worker;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.filesystem;
use io_error:     std.io.error;
use io_lifecycle: std.io.lifecycle;
use std.net.ip;
use local_socket: std.net.local;
use local_types:  std.net.local.types;
use std.net.tcp;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.thread;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;
use tls.cert;
use tls.cert.bundle;

val RESPONSE_BYTES: usize = 4096;
# a read waits wire.READ_TIMEOUT_MS, so this bounds one exchange at ten seconds
val READ_ROUNDS: usize = 200;

fun page_ok(outcome: err[allocator.Error]) bool {
    ret sel outcome.ok;
}

rec Harness {
    heap:        allocator.Allocator;
    diagnostics: schema.Diagnostics;
    generations: *generation.Generation;
    composed:    *composition.Runtime;
    supervising: supervisor.Supervisor;
    thread:      thread.Thread;
    endpoint:    ip.Endpoint;
    # a local listener's abstract name, served in place of the TCP one when set
    local:        bool;
    local_name:   [64]u8;
    local_target: local_socket.Endpoint;
    # what the next reload's candidate answers with, and whether it moves the
    # listener, which a reload must refuse
    next_body:     str;
    move_listener: bool;
    # the loader runs on the supervisor's thread
    loads: i64;
    # whether the one service is a native origin behind the shared cache, how
    # often a worker reached it, and how many client exchanges went wrong
    cached:   bool;
    origin:   i64;
    failures: i64;
    # whether the one service is a registered application whose lifecycle the
    # supervisor drives
    hosted: bool;
    phases: Phases;
    # whether the listener's port is `holder`'s, bound without SO_REUSEPORT, so
    # no worker can bind it
    taken:      bool;
    taken_name: [64]u8;
    holder:     tcp.Listener;
    slots:      [1]service.Application;
    registry:   service.Applications;
    # whether the process runs a background task facility, whose job fetches
    # from the process's own TLS listener, verified against the fixture root
    tasked: bool;
    # whether the facility's anchors are an empty store, which its loop refuses
    untrusted: bool;
    empty:     cert.TrustStore;
    started:   composition.StartStatus;
    tasks:     task.Tasks;
    secrets:   task.Secrets;
    anchors:   bundle.Loaded;
    job:       Job;
}

val CACHED_BODY: str = "a response every worker reads back from the one disk cache\n";
val CACHE_ROOT:  str = "out/cache-supervision";

# the origin a background task fetches from: it answers with the credential
# the request carried
fun echo_authorization(active: *call.Call) exchange.ServiceStatus {
    val carried: *field.Field = field.find_first(?call.request(active).fields,
        service.text_view("authorization"));
    if (carried == nil || message.set_status(call.response(active), status.OK)
        != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
    val copied: *u8 = service.arena_bytes(active, carried.value.len);
    if (copied == nil) { ret exchange.SERVICE_FAILED; }
    var i: usize = 0;
    for (i < carried.value.len) {
        copied[i] = carried.value.data[i];
        i         = i + 1;
    }
    ret service.respond_with_bytes(active, copied, carried.value.len);
}

# the origin behind the cache, reached from every worker's thread
fun origin_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val harness: *Harness = context::*Harness;
    if (harness.tasked) { ret echo_authorization(active); }
    atomic.fetch_add(?harness.origin, 1);
    if (message.set_status(call.response(active), status.OK) != message.RESPONSE_OK
        || !service.add_field(active, field.CONTENT_TYPE, "text/plain")
        || !service.add_field(active, field.CACHE_CONTROL, "max-age=60")) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_text(active, CACHED_BODY);
}

fun origin_factory(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    if (context == nil || handler == nil) { ret false; }
    @handler = service.Handler{ctx: context, serve: origin_serve};
    ret true;
}

fun configure(graph: *schema.Graph, body: str, cached: bool, local_address: str,
    address: str) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "supervision-test");
    graph.listener_count = 1;
    val public: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?public.name, "public");
    schema.set_text(?public.address, "127.0.0.1:0");
    schema.clear_text(?public.tls_policy);
    schema.clear_text(?public.budget);
    public.transport          = schema.TRANSPORT_TCP;
    public.protocols          = schema.PROTOCOL_HTTP1;
    public.backlog            = 16;
    public.accept_depth       = 2;
    public.proxy_protocol     = schema.PROXY_OFF;
    public.trusted_peer_count = 0;
    graph.host_count          = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 1;
    val fixed: *schema.Service = ?graph.services[0];
    schema.set_text(?fixed.name, "hello");
    fixed.kind = schema.SERVICE_FIXED;
    schema.set_text(?fixed.target, body);
    schema.clear_text(?fixed.budget);
    schema.set_text(?fixed.content_type, "text/plain");
    schema.clear_text(?fixed.index);
    fixed.status      = 200;
    graph.route_count = 1;
    schema.set_text(?graph.routes[0].name, "all");
    schema.set_text(?graph.routes[0].host, "site");
    schema.set_text(?graph.routes[0].path, "/**");
    schema.set_text(?graph.routes[0].service, "hello");
    # every request is charged to a budget whose caps the workers share
    graph.budget_count = 1;
    schema.set_text(?graph.budgets[0].name, "route");
    graph.budgets[0].concurrency  = 4;
    graph.budgets[0].queue        = 0;
    graph.budgets[0].timeout_ms   = 0;
    graph.budgets[0].memory_bytes = 0;
    schema.set_text(?graph.routes[0].budget, "route");
    graph.timeouts.drain_ms = 1000;
    # hedge's own outbound client keeps an idle connection without reading it,
    # so a linger would wait out its timeout past this drain deadline
    graph.timeouts.linger_ms = 0;
    if (address != nil) { schema.set_text(?public.address, address); }
    if (local_address != nil) {
        schema.set_text(?public.address, local_address);
        public.transport = schema.TRANSPORT_LOCAL;
    }
    if (!cached) { ret; }
    # four clients against a concurrency of four can meet the allowance one
    # worker holds unused, which refuses by design, so the cache runs uncapped
    graph.budget_count = 0;
    schema.clear_text(?graph.routes[0].budget);
    fixed.kind = schema.SERVICE_NATIVE;
    schema.set_text(?fixed.target, "origin");
    fixed.cache = true;
    # every stored body is past a quarter of the memory budget, so each one is
    # written to and read back from disk through the store worker
    graph.cache.enabled         = true;
    graph.cache.memory_bytes    = 64;
    graph.cache.max_entry_bytes = 1024;
    graph.cache.entries         = 8;
    graph.cache.disk_bytes      = 4096;
    schema.set_text(?graph.cache.disk_root, CACHE_ROOT);
}

# the one listener over TLS as api.example.com, whose one service is the
# native origin
fun secure_origin(graph: *schema.Graph) {
    graph.budget_count = 0;
    schema.clear_text(?graph.routes[0].budget);
    graph.services[0].kind = schema.SERVICE_NATIVE;
    schema.set_text(?graph.services[0].target, "origin");
    schema.set_text(?graph.listeners[0].tls_policy, "public");
    schema.set_text(?graph.hosts[0].server_names[0], "api.example.com");
    graph.tls_policy_count = 1;
    val policy: *schema.TlsPolicy = ?graph.tls_policies[0];
    schema.set_text(?policy.name, "public");
    policy.identity_count = 1;
    schema.set_text(?policy.identities[0].server_name, "api.example.com");
    schema.set_text(?policy.identities[0].certificate, "test/interop/fixtures/api.pem");
    schema.set_text(?policy.identities[0].key, wire.owner_only("test/interop/fixtures/api.key", "out/fixtures/supervision/api.key"));
    schema.set_text(?policy.default_name, "api.example.com");
    policy.has_default = true;
    policy.client_auth = false;
    schema.clear_text(?policy.client_trust);
}

fun seal(candidate: *generation.Generation, id: u64, body: str, cached: bool,
    local_address: str, address: str, hosted: bool, tasked: bool,
    diagnostics: *schema.Diagnostics) bool {
    if (!generation.make_candidate(candidate, id)) { ret false; }
    configure(?candidate.graph, body, cached, local_address, address);
    if (tasked) { secure_origin(?candidate.graph); }
    if (hosted) {
        val site: *schema.Service = ?candidate.graph.services[0];
        site.kind = schema.SERVICE_APPLICATION;
        schema.set_text(?site.target, "site");
        schema.clear_text(?site.content_type);
        # the application's own section hands it the body as a setting
        val graph:   *schema.Graph   = ?candidate.graph;
        val setting: *schema.Setting = ?graph.settings.items[0];
        graph.application_count = 1;
        schema.set_text(?graph.applications[0].name, "site");
        graph.applications[0].setting_first = 0;
        graph.applications[0].setting_count = 1;
        setting.kind                        = schema.SETTING_STRING;
        setting.key_at                      = 0;
        setting.key_len                     = 8;
        val length: usize = str_len(body);
        var i:      usize = 0;
        for (i < 8) {
            graph.settings.bytes[i] = "greeting"[i];
            i                       = i + 1;
        }
        i = 0;
        for (i < length) {
            graph.settings.bytes[8 + i] = body[i];
            i                           = i + 1;
        }
        setting.value_at     = 8;
        setting.value_len    = length;
        graph.settings.count = 1;
        graph.settings.used  = 8 + length;
    }
    schema.reset_diagnostics(diagnostics);
    ret generation.seal(candidate, diagnostics, nil, (0::usize)::generation.ConstructFun);
}

fun load(context: ptr, id: u64, active: *generation.Generation) *generation.Generation {
    val harness: *Harness = context::*Harness;
    var target:  usize    = 0;
    if (active == ?harness.generations[0]) { target = 1; }
    val candidate: *generation.Generation = ?harness.generations[target];
    atomic.fetch_add(?harness.loads, 1);
    if (!seal(candidate, id, harness.next_body, harness.cached, local_address(harness),
        taken_address(harness), harness.hosted, harness.tasked, ?harness.diagnostics)) {
        ret nil;
    }
    if (harness.move_listener) {
        schema.set_text(?candidate.graph.listeners[0].address, "127.0.0.1:1");
    }
    ret candidate;
}

fun supervise(arg: *u8) {
    val harness: *Harness = arg::*Harness;
    supervisor.run(?harness.supervising);
}

fun local_address(harness: *Harness) str {
    if (!harness.local) { ret nil; }
    ret ?harness.local_name[0];
}

fun taken_address(harness: *Harness) str {
    if (!harness.hosted || !harness.taken) { ret nil; }
    ret ?harness.taken_name[0];
}

# a loopback port held without SO_REUSEPORT, which every worker's bind refuses
fun take_port(harness: *Harness) bool {
    val held: res[tcp.Listener, io_error.Error] = tcp.listen(ip.endpoint(127, 0, 0, 1, 0), 1);
    if (sel held.err) { ret false; }
    harness.holder = held.ok;
    val bound: res[ip.Endpoint, io_error.Error] = tcp.listener_local_endpoint(?harness.holder);
    if (sel bound.err) {
        tcp.listener_close(?harness.holder);
        ret false;
    }
    ip.endpoint_format(bound.ok, ?harness.taken_name[0], 64);
    harness.taken = true;
    ret true;
}

# an abstract socket name this process alone uses, so parallel runs never meet
fun name_local(harness: *Harness) bool {
    val prefix: str   = "@hedge-supervision-";
    var length: usize = 0;
    for (prefix[length] != 0) {
        harness.local_name[length] = prefix[length];
        length                     = length + 1;
    }
    var digits: [20]u8;
    var count:  usize = 0;
    var pid:    u64   = os.getpid()::u64;
    for (count == 0 || pid != 0) {
        digits[count] = ('0'::u64 + pid % 10)::u8;
        pid           = pid / 10;
        count         = count + 1;
    }
    for (count > 0 && length + 1 < 64) {
        count                      = count - 1;
        harness.local_name[length] = digits[count];
        length                     = length + 1;
    }
    harness.local_name[length] = 0;
    val target: res[local_socket.Endpoint, io_error.Error] = local_socket.abstract(
        ?harness.local_name[1], length - 1);
    if (sel target.err) { ret false; }
    harness.local_target = target.ok;
    harness.local        = true;
    ret true;
}

# the process up, its two workers serving on threads and the supervisor on another
fun boot(harness: *Harness, cached: bool) bool {
    if (!page_ok(page.make(?harness.heap))) { ret false; }
    val generations: res[*generation.Generation, allocator.Error] =
        allocator.allocate[generation.Generation](?harness.heap, 2);
    val composed: res[*composition.Runtime, allocator.Error] =
        allocator.allocate[composition.Runtime](?harness.heap, 1);
    if (sel generations.err) { ret false; }
    if (sel composed.err)    { ret false; }
    harness.generations = generations.ok;
    harness.composed    = composed.ok;
    atomic.store(?harness.loads, 0);
    atomic.store(?harness.origin, 0);
    atomic.store(?harness.failures, 0);
    harness.move_listener = false;
    harness.next_body     = "hello from two\n";
    harness.cached        = cached;
    if (cached && (!ensure_dir("out") || !ensure_dir(CACHE_ROOT))) { ret false; }
    val initial: *generation.Generation = ?harness.generations[0];
    if (!seal(initial, 1, "hello from one\n", cached, local_address(harness),
        taken_address(harness), harness.hosted, harness.tasked, ?harness.diagnostics)) { ret false; }
    var options: composition.Options = composition.default_options();
    options.native = service.Factory{ctx: (harness)::ptr, build: origin_factory};
    if (harness.hosted) {
        # registered not started: the supervisor starts it
        if (!service.make_applications(?harness.registry, ?harness.slots[0], 1)
            || !service.register_hosted(?harness.registry, "site",
            service.Handler{ctx: (?harness.phases)::ptr, serve: serve_hosted},
            service.Lifecycle{ctx: (?harness.phases)::ptr, start: phase_start,
            ready: phase_ready, drain: phase_drain, stop: phase_stop, reload: phase_reload}, 0)
            || !settings.source(?harness.registry, "site", ?harness.phases.settings)) { ret false; }
        options.applications = ?harness.registry;
    }
    if (harness.tasked) {
        # the facility runs its thread from the supervisor's start on
        if (bundle.load(?harness.heap, "test/interop/fixtures/root.pem", ?harness.anchors)
            != bundle.OK
            || !task.register_secrets(?job_resolver, ?harness.secrets)) { ret false; }
        var trust: *cert.TrustStore = ?harness.anchors.bundle.store;
        if (harness.untrusted) {
            harness.empty = cert.TrustStore{anchors: nil, len: 0};
            trust         = ?harness.empty;
        }
        if (!task.make(?harness.tasks, task.Options{trust: trust, secrets: harness.secrets})) {
            ret false;
        }
        options.tasks = ?harness.tasks;
    }
    # two workers, which on a platform whose reuseport balances share the port
    val started: composition.StartReport = composition.start_process(harness.composed,
        ?harness.heap, ?initial.graph, initial.id, ?harness.diagnostics, options, 2);
    if (started.status != composition.START_OK) { ret false; }
    harness.phases.health = ?harness.composed.observability.runtime.health;
    if (!supervisor.make(?harness.supervising, harness.composed, ?harness.heap, true)
        || !supervisor.attach_reloads(?harness.supervising, initial,
        supervisor.Loader{context: (harness)::ptr, load: load})) { ret false; }
    harness.started = supervisor.start(?harness.supervising);
    if (harness.started != composition.START_OK) { ret false; }
    val owned: *listener.OwnedListener = listener.active_listener(
        ?composition.worker_at(harness.composed, 0).serving.owner, 0);
    if (owned == nil || (!harness.local && !owned.has_bound_endpoint)) { ret false; }
    harness.endpoint = owned.bound_endpoint;
    val spawned: thread.Operation = thread.spawn_with(supervise, (harness)::*u8,
        ?harness.thread);
    ret sel spawned.ok;
}

fun finish(harness: *Harness) composition.StopReport {
    supervisor.request_stop(?harness.supervising);
    thread.join(?harness.thread);
    ret supervisor.stop(?harness.supervising);
}

fun ensure_dir(path: str) bool {
    val found: res[bool, io_error.Error] = filesystem.is_dir(path);
    if ((sel found.ok) && found.ok) { ret true; }
    val created: err[io_error.Error] = filesystem.create_dir(path, 493);
    ret sel created.ok;
}

fun fetch(harness: *Harness, expected: str) bool {
    ret fetch_request(harness,
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n", expected);
}

# one request, read without driving anything: the worker's thread serves it
fun fetch_request(harness: *Harness, request: str, expected: str) bool {
    if (harness.local) { ret fetch_local(harness, request, expected); }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) { ret false; }
    if (!wire.send(?client, request)) {
        tcp.stream_close(?client);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    var total:    usize = 0;
    var rounds:   usize = 0;
    for (rounds < READ_ROUNDS && total + 1 < RESPONSE_BYTES) {
        val read: res[usize, io_error.Error] = tcp.stream_read(?client,
            ?response[total], RESPONSE_BYTES - total - 1);
        if (sel read.ok) {
            if (read.ok == 0) { brk; }
            total = total + read.ok;
        }
        rounds = rounds + 1;
    }
    tcp.stream_close(?client);
    response[total] = 0;
    ret wire.starts_with(?response[0], total, "HTTP/1.1 200 OK\r\n")
        && wire.contains(?response[0], total, expected);
}

# `fetch_request` over the local listener
fun fetch_local(harness: *Harness, request: str, expected: str) bool {
    val connected: res[local_types.Stream, io_error.Error] = local_socket.connect(
        harness.local_target);
    if (sel connected.err) { ret false; }
    var client: local_types.Stream = connected.ok;
    os.sock_set_rcvtimeo(client.handle, wire.READ_TIMEOUT_MS);
    val length:  usize                      = str_len(request);
    val written: res[usize, io_error.Error] = local_socket.stream_write(?client,
        request::*u8, length);
    var sent: usize = 0;
    if (sel written.ok) { sent = written.ok; }
    if (sent != length) {
        local_socket.stream_close(?client, io_lifecycle.ABORTIVE);
        ret false;
    }
    var response: [RESPONSE_BYTES]u8;
    var total:    usize = 0;
    var rounds:   usize = 0;
    for (rounds < READ_ROUNDS && total + 1 < RESPONSE_BYTES) {
        val read: res[usize, io_error.Error] = local_socket.stream_read(?client,
            ?response[total], RESPONSE_BYTES - total - 1);
        if (sel read.ok) {
            if (read.ok == 0) { brk; }
            total = total + read.ok;
        }
        rounds = rounds + 1;
    }
    local_socket.stream_close(?client, io_lifecycle.ABORTIVE);
    response[total] = 0;
    ret wire.starts_with(?response[0], total, "HTTP/1.1 200 OK\r\n")
        && wire.contains(?response[0], total, expected);
}

# a reload lands on the worker asynchronously, so the client asks until it
# answers from the new generation or the budget is spent
fun fetch_eventually(harness: *Harness, expected: str) bool {
    var attempts: usize = 0;
    for (attempts < 100) {
        if (fetch(harness, expected)) { ret true; }
        attempts = attempts + 1;
    }
    ret false;
}

# the executable's shape, reload and shutdown included: two workers serve on
# threads of their own, and the supervisor refuses, prepares, commits and
# stops them from another
# a worker serves a reload as soon as it commits, which can be before the last
# worker has, so the client asks until the supervisor has published it
fun published(harness: *Harness, id: u64) bool {
    var attempts: usize = 0;
    for (attempts < 100) {
        if (generation.snapshot(?harness.supervising.store).active_id == id) { ret true; }
        fetch(harness, "hello");
        attempts = attempts + 1;
    }
    ret false;
}

test workers__serve_reload_and_stop {
    var harness: Harness;
    harness.local  = false;
    harness.hosted = false;
    harness.tasked = false;
    if (!boot(?harness, false)) { ret 1; }
    if (!fetch(?harness, "hello from one")) {
        finish(?harness);
        ret 2;
    }
    # a reload that moves a listener is refused and serving goes on
    harness.move_listener = true;
    harness.next_body     = "hello from a moved listener\n";
    supervisor.request_reload(?harness.supervising);
    var attempts: usize = 0;
    for (attempts < 100 && atomic.load(?harness.loads) == 0) {
        fetch(?harness, "hello from one");
        attempts = attempts + 1;
    }
    if (atomic.load(?harness.loads) != 1 || !fetch(?harness, "hello from one")) {
        finish(?harness);
        ret 3;
    }
    harness.move_listener = false;
    harness.next_body     = "hello from two\n";
    supervisor.request_reload(?harness.supervising);
    if (!fetch_eventually(?harness, "hello from two") || !published(?harness, 3)) {
        finish(?harness);
        ret 4;
    }
    # a second reload waits for the first generation to drain from the worker,
    # then seals into the slot it held
    harness.next_body = "hello from three\n";
    supervisor.request_reload(?harness.supervising);
    if (!fetch_eventually(?harness, "hello from three") || !published(?harness, 4)) {
        finish(?harness);
        ret 5;
    }
    val stopped: composition.StopReport = finish(?harness);
    if (!stopped.stopped || stopped.serve_failures != 0
        || stopped.cleanup_failures != 0 || stopped.reason == lifecycle.FAILED) { ret 6; }
    # the worker pins the generation it now serves, and the process builds
    # every later worker from it. both were written on other threads, which
    # the joins have finished
    val first:  *worker.Worker = composition.worker_at(harness.composed, 0);
    val second: *worker.Worker = composition.worker_at(harness.composed, 1);
    if (first.control.state != worker.STATE_STOPPED
        || second.control.state != worker.STATE_STOPPED
        || first.current != ?harness.generations[0]
        || second.current != ?harness.generations[0] || atomic.load(?harness.loads) != 3
        || harness.composed.generation_id != 4) { ret 7; }
    # the budget caps were rebuilt for each reload, and what the workers
    # gave back of the caps a reload replaced never lifts a bank past its cap
    var bank: usize = 0;
    for (bank < 2) {
        val pool: *allowance.Pool = ?harness.composed.budget_pools[bank].items[0].concurrency;
        if (atomic.load(?pool.free) > atomic.load(?pool.capacity)) { ret 8; }
        bank = bank + 1;
    }
    ret 0;
}

val CLIENTS:        usize = 4;
val CLIENT_FETCHES: usize = 25;
val PATHS:          usize = 4;
# a fill is published once the store worker has written it, which the client's
# answer does not wait for. this bounds the wait for one at ten seconds
val PUBLISH_ROUNDS: usize = 10000;
val PUBLISH_PAUSE:  i64   = 1000000;

fun cached_request(path: usize) str {
    var requests: [4]str = [4]str{
        "GET /0 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "GET /1 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "GET /2 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "GET /3 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    };
    ret requests[path % PATHS];
}

# a client on a thread of its own, asking for the four paths in turn
fun cached_client(arg: *u8) {
    val harness: *Harness = arg::*Harness;
    var i:       usize    = 0;
    for (i < CLIENT_FETCHES) {
        if (!fetch_request(harness, cached_request(i), CACHED_BODY)) {
            atomic.fetch_add(?harness.failures, 1);
        }
        i = i + 1;
    }
}

# wait until `count` fills have been published to the store
fun published_fills(harness: *Harness, count: u64) bool {
    val layer:  *http_cache.Layer = composition.cache(harness.composed);
    var rounds: usize             = 0;
    for (rounds < PUBLISH_ROUNDS) {
        if (http_cache.report(layer).stores >= count) { ret true; }
        os.sleep(PUBLISH_PAUSE);
        rounds = rounds + 1;
    }
    ret false;
}

# the store worker owns the disk, so workers on threads of their own share one
# cache: what one worker stored another reads back through the store worker,
# while clients on several threads keep both busy (#286)
#
# the cache does not coalesce concurrent misses: each one reaches the origin
# until the first fill is published, which waits on the store worker's write.
# how many requests miss that way is the scheduler's, so the paths are filled
# one at a time first, and every request after that is a hit (#329)
test disk_cache__shared_across_workers {
    var harness: Harness;
    harness.local  = false;
    harness.hosted = false;
    harness.tasked = false;
    if (!boot(?harness, true)) { ret 1; }
    var path: usize = 0;
    for (path < PATHS) {
        if (!fetch_request(?harness, cached_request(path), CACHED_BODY)
            || !published_fills(?harness, (path + 1)::u64)) { brk; }
        path = path + 1;
    }
    val filled:  http_cache.Report = http_cache.report(composition.cache(harness.composed));
    val fills:   i64               = atomic.load(?harness.origin);
    var clients: [4]thread.Thread;
    var spawned: usize             = 0;
    if (path == PATHS) {
        for (spawned < CLIENTS) {
            val started: thread.Operation = thread.spawn_with(cached_client,
                (?harness)::*u8, ?clients[spawned]);
            if (!(sel started.ok)) { brk; }
            spawned = spawned + 1;
        }
    }
    var joined: usize = 0;
    for (joined < spawned) {
        thread.join(?clients[joined]);
        joined = joined + 1;
    }
    val view:    http_cache.Report      = http_cache.report(composition.cache(harness.composed));
    val stopped: composition.StopReport = finish(?harness);
    if (path != PATHS || spawned != CLIENTS) { ret 2; }
    if (atomic.load(?harness.failures) != 0) { ret 3; }
    if (!stopped.stopped || stopped.serve_failures != 0
        || stopped.cleanup_failures != 0 || stopped.reason == lifecycle.FAILED) { ret 4; }
    # each path missed once, reached the origin once and was stored once, on disk
    val paths: u64 = PATHS::u64;
    if (fills != PATHS::i64 || filled.misses != paths || filled.hits != 0
        || filled.stores != paths || filled.entries != PATHS) { ret 5; }
    if (view.disk_bytes == 0 || view.memory_bytes != 0) { ret 6; }
    # then every request was a hit read back off the disk, and none reached the
    # origin or changed what the store holds
    val total: u64 = (CLIENTS * CLIENT_FETCHES)::u64;
    if (atomic.load(?harness.origin) != fills || view.hits != total
        || view.misses != paths || view.stores != paths || view.entries != PATHS
        || view.evictions != 0 || view.rejections != 0) { ret 7; }
    # both workers answered, so both read hits back from the one store
    if (composition.worker_at(harness.composed, 0).serving.served == 0
        || composition.worker_at(harness.composed, 1).serving.served == 0) { ret 8; }
    ret 0;
}

val LOCAL_FETCHES: usize = 16;

# a local listener is accepted by the first worker alone, which hands each
# connection to the least loaded worker, and every one of them is served (#298)
test local_listener__handed_off_and_served {
    $if ($mach.build.os != $mach.os.linux) {
        ret 0;
    }
    var harness: Harness;
    harness.hosted = false;
    harness.tasked = false;
    if (!name_local(?harness))  { ret 1; }
    if (!boot(?harness, false)) { ret 2; }
    var answered: usize = 0;
    var i:        usize = 0;
    for (i < LOCAL_FETCHES) {
        if (fetch(?harness, "hello from one")) { answered = answered + 1; }
        i = i + 1;
    }
    # a reload reaches a handed-off connection's worker like any other
    harness.next_body = "hello from two\n";
    supervisor.request_reload(?harness.supervising);
    val reloaded: bool                   = fetch_eventually(?harness, "hello from two");
    val stopped:  composition.StopReport = finish(?harness);
    if (answered != LOCAL_FETCHES) { ret 3; }
    if (!reloaded)                 { ret 4; }
    if (!stopped.stopped || stopped.serve_failures != 0
        || stopped.cleanup_failures != 0 || stopped.reason == lifecycle.FAILED) { ret 5; }
    # the second worker never accepts on a local listener, so what it served
    # it was handed
    val first:  *worker.Worker = composition.worker_at(harness.composed, 0);
    val second: *worker.Worker = composition.worker_at(harness.composed, 1);
    if (first.serving.served == 0 || second.serving.served == 0)     { ret 6; }
    if (first.serving.accepted == 0 || second.serving.accepted == 0) { ret 7; }
    if (first.serving.rejected != 0 || second.serving.rejected != 0) { ret 8; }
    if (listener.snapshot(?first.serving.owner).leaked_descriptors != 0
        || listener.snapshot(?second.serving.owner).leaked_descriptors != 0) { ret 9; }
    ret 0;
}

# a registered application's lifecycle, and what it saw of the supervisor
# driving it. the steps run on the supervisor's thread, the handler on workers'
rec Phases {
    # the process's readiness, read at start and at drain once set
    health: *telemetry_health.Health;
    # readiness answers pending this many times before it answers done
    not_ready: usize;
    # drain never finishes
    stuck:              bool;
    starts:             usize;
    readies:            usize;
    drains:             usize;
    stops:              usize;
    drained:            bool;
    accepting_at_start: bool;
    ready_at_drain:     bool;
    drained_at_stop:    bool;
    served:             i64;
    # what the reload step read from the application's settings
    settings:     settings.Source;
    reloads:      i64;
    greeting:     [32]u8;
    greeting_len: usize;
    # when set, start registers `lingering`, a periodic task whose runs never
    # end, and finishes once a run is in flight. the task thread counts the
    # steps it takes after `stop`
    tasks:      *task.Tasks;
    lingering:  task.Spec;
    in_flight:  i64;
    stopped:    i64;
    after_stop: i64;
}

fun step(state: service.StepStatus) service.Step {
    ret service.Step{status: state, detail: view.view(nil, 0)};
}

fun phase_start(context: ptr) service.Step {
    val phases: *Phases = context::*Phases;
    phases.starts             = phases.starts + 1;
    phases.accepting_at_start = phases.health != nil
        && telemetry_health.snapshot(phases.health).accepting;
    if (phases.tasks == nil) { ret step(service.STEP_DONE); }
    if (phases.starts == 1) {
        var handle: task.Handle;
        if (task.register(phases.tasks, ?phases.lingering, ?handle) != task.STATUS_OK) {
            ret step(service.STEP_FAILED);
        }
    }
    if (atomic.load(?phases.in_flight) == 0) { ret step(service.STEP_PENDING); }
    ret step(service.STEP_DONE);
}

# the lingering task's period, short so its first run begins soon after start
val LINGER_PERIOD_NS: u64 = 1000000;

# a run that never ends, stepped on the task thread
fun linger_step(context: ptr, run: *task.Run) service.Step {
    val phases: *Phases = context::*Phases;
    atomic.store(?phases.in_flight, 1);
    if (atomic.load(?phases.stopped) != 0) { atomic.fetch_add(?phases.after_stop, 1); }
    ret step(service.STEP_PENDING);
}

fun phase_ready(context: ptr) service.Step {
    val phases: *Phases = context::*Phases;
    phases.readies = phases.readies + 1;
    if (phases.not_ready != 0) {
        phases.not_ready = phases.not_ready - 1;
        ret step(service.STEP_PENDING);
    }
    ret step(service.STEP_DONE);
}

fun phase_drain(context: ptr, deadline: time.Instant) service.Step {
    val phases: *Phases = context::*Phases;
    if (phases.drains == 0) {
        phases.ready_at_drain = phases.health != nil
            && telemetry_health.snapshot(phases.health).ready;
    }
    phases.drains = phases.drains + 1;
    if (phases.stuck) { ret step(service.STEP_PENDING); }
    phases.drained = true;
    ret step(service.STEP_DONE);
}

fun phase_stop(context: ptr) service.Step {
    val phases: *Phases = context::*Phases;
    phases.stops           = phases.stops + 1;
    phases.drained_at_stop = phases.drained;
    atomic.store(?phases.stopped, 1);
    ret step(service.STEP_DONE);
}

fun phase_reload(context: ptr) service.Step {
    val phases: *Phases       = context::*Phases;
    val read:   settings.Read = settings.read(settings.current(phases.settings),
        view.view("greeting", 8), ?phases.greeting[0], 32);
    if (read.status != settings.READ_FOUND) { ret step(service.STEP_FAILED); }
    phases.greeting_len = read.len;
    atomic.fetch_add(?phases.reloads, 1);
    ret step(service.STEP_DONE);
}

fun serve_hosted(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val phases: *Phases = context::*Phases;
    atomic.fetch_add(?phases.served, 1);
    ret service.respond(active, status.OK);
}

# a registered application, not yet started, whose readiness first answers
# pending and whose drain finishes unless `stuck`. a `lingering` one runs the
# task facility, starts a task that never ends, and listens on a port already
# taken, so no worker starts
fun boot_hosted(harness: *Harness, stuck: bool, lingering: bool) bool {
    harness.taken = false;
    if (lingering && !take_port(harness)) { ret false; }
    harness.local     = false;
    harness.hosted    = true;
    harness.tasked    = lingering;
    harness.untrusted = false;
    harness.phases    = Phases{health: nil, not_ready: 1, stuck: stuck, starts: 0,
        readies:        0, drains: 0, stops: 0, drained: false, accepting_at_start: false,
        ready_at_drain: false, drained_at_stop: false, served: 0, tasks: nil,
        lingering:      task.Spec{name: view.view("lingering", 9),
        state:          (?harness.phases)::ptr, step: linger_step, period_ns: LINGER_PERIOD_NS,
        timeout_ns:     0, slots: nil, slot_bytes: 0, slot_count: 0},
        in_flight:      0, stopped: 0, after_stop: 0};
    if (lingering) { harness.phases.tasks = ?harness.tasks; }
    ret boot(harness, false);
}

# the supervisor polls the application's readiness into the process's
fun ready_eventually(harness: *Harness) bool {
    var rounds: usize = 0;
    for (rounds < PUBLISH_ROUNDS) {
        if (telemetry_health.snapshot(?harness.composed.observability.runtime.health).ready) {
            ret true;
        }
        os.sleep(PUBLISH_PAUSE);
        rounds = rounds + 1;
    }
    ret false;
}

# the supervisor starts a hosted application before the process accepts,
# polls it ready, and on shutdown drains it to completion before it stops it
# and before the process's stop returns (#393)
test hosted_application__started_ready_drained_stopped {
    var harness: Harness;
    if (!boot_hosted(?harness, false, false)) { ret 1; }
    val phases: *Phases = ?harness.phases;
    val ready:  bool    = ready_eventually(?harness);
    val served: bool    = fetch_request(?harness,
        "GET /orders/42 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        "HTTP/1.1");
    # a published reload is handed to the application, whose settings now read
    # the new generation's
    val before: settings.View = settings.current(phases.settings);
    supervisor.request_reload(?harness.supervising);
    var rounds: usize = 0;
    for (rounds < PUBLISH_ROUNDS && atomic.load(?phases.reloads) == 0) {
        os.sleep(PUBLISH_PAUSE);
        rounds = rounds + 1;
    }
    var old:     [32]u8;
    val kept:    settings.Read          = settings.read(before, view.view("greeting", 8), ?old[0], 32);
    val stopped: composition.StopReport = finish(?harness);
    if (atomic.load(?phases.reloads) != 1 || phases.greeting_len != 15
        || phases.greeting[11] != 't' || kept.status != settings.READ_FOUND
        || kept.len != 15 || old[11] != 'o') { ret 7; }
    if (phases.starts != 1 || phases.accepting_at_start) { ret 2; }
    if (!ready || phases.readies < 2)                    { ret 3; }
    if (!served || atomic.load(?phases.served) != 1)     { ret 4; }
    if (!stopped.stopped || stopped.reason == lifecycle.FAILED
        || stopped.reason == lifecycle.DEADLINE || stopped.cleanup_failures != 0
        || stopped.applications_abandoned != 0) { ret 5; }
    # readiness had gone before the drain, which finished before the stop
    if (phases.drains != 1 || !phases.drained || phases.ready_at_drain
        || phases.stops != 1 || !phases.drained_at_stop) { ret 6; }
    ret 0;
}

# a drain still pending at the drain deadline is abandoned, reported in the stop
# report, and the application is stopped all the same
test hosted_application__drain_overrun_abandoned {
    var harness: Harness;
    if (!boot_hosted(?harness, true, false)) { ret 1; }
    val phases:  *Phases                = ?harness.phases;
    val ready:   bool                   = ready_eventually(?harness);
    val stopped: composition.StopReport = finish(?harness);
    if (!ready) { ret 2; }
    if (stopped.applications_abandoned != 1 || stopped.reason != lifecycle.DEADLINE
        || stopped.cleanup_failures != 0) { ret 3; }
    if (phases.drains < 2 || phases.drained || phases.stops != 1) { ret 4; }
    ret 0;
}

val JOB_TOKEN: str = "s3cr3t-token";

# the job's resolver is secret welded, so it lives here and the harness holds
# only the public handle it was registered under
var job_resolver: task.Resolver = task.Resolver{ctx: nil, resolve: resolve_secret};
# the job's own period, and the bound on each of its runs
val JOB_PERIOD_NS:  u64 = 200000000;
val JOB_TIMEOUT_NS: u64 = 10000000000;

# the resolver the task facility borrows from: one secret, by name, which it
# writes into secret storage
fun resolve_secret(context: ptr, name: view.View, output: *^u8, capacity: usize) i64 {
    if (!view.view_eq_str(name, "catalog-token")) { ret -1; }
    val length: usize = str_len(JOB_TOKEN);
    if (length >= capacity) { ret length::i64; }
    var i: usize = 0;
    for (i < length) {
        output[i] = JOB_TOKEN[i];
        i         = i + 1;
    }
    ret length::i64;
}

# a job's public state: the secret's name, never the secret, and an exchange
# and snapshot slots it owns. the credential it sends lives in `header` only
# while its exchange is in flight
rec Job {
    endpoint:   ip.Endpoint;
    routed:     bool;
    sequence:   u64;
    waiting:    bool;
    header:     [64]u8;
    header_len: usize;
    fields:     [1]field.Field;
    request:    [2048]u8;
    response:   [2048]u8;
    items:      [16]field.Field;
    exchange:   outbound.Exchange;
    slots:      [2][64]u8;
    published:  task.Status;
}

fun prepare_job(job: *Job) bool {
    job.routed     = false;
    job.sequence   = 0;
    job.waiting    = false;
    job.header_len = 0;
    job.published  = 0;
    ret outbound.make_exchange(?job.exchange, ?job.request[0], 2048, ?job.response[0], 2048,
        ?job.items[0], 16, field.limits(16, 2048, 128, 1024));
}

# the token reaches public memory only as the request's header, declassified
# by the outbound client
fun take_token(context: ptr, secret: contracts.SecretBytes) bool {
    val job: *Job = context::*Job;
    if (!outbound.secret_header(?job.fields[0], view.view("authorization", 13),
        view.view("Bearer ", 7), secret, ?job.header[0], 64)) { ret false; }
    job.header_len = job.fields[0].value.len;
    ret true;
}

fun forget_token(job: *Job) {
    var i: usize = 0;
    for (i < 64) {
        job.header[i] = 0;
        i             = i + 1;
    }
    job.header_len = 0;
}

fun job_failed(job: *Job, detail: str) service.Step {
    forget_token(job);
    job.waiting = false;
    ret service.Step{status: service.STEP_FAILED, detail: view.view(detail::*u8, str_len(detail))};
}

# fetch the catalog with the borrowed token and publish what came back. every
# step returns at once: the first begins the exchange, and the rest poll it
fun job_step(context: ptr, run: *task.Run) service.Step {
    val job:     *Job         = context::*Job;
    val pending: service.Step = service.Step{status: service.STEP_PENDING,
        detail: view.view(nil, 0)};
    if (job.sequence != run.sequence) {
        job.sequence = run.sequence;
        job.waiting  = false;
    }
    val reason: cancel.Reason = cancel.reason(run.scope);
    if (!(sel reason.active)) { ret job_failed(job, "cancelled"); }
    if (!job.waiting) {
        if (!job.routed) {
            if (!outbound.route(outbound.client(run.loop), view.view("api.example.com", 15),
                outbound.secure_origin(job.endpoint))) { ret job_failed(job, "unroutable"); }
            job.routed = true;
        }
        if (task.borrow(run, view.view("catalog-token", 13), take_token, context)
            != task.BORROW_OK) { ret job_failed(job, "token unavailable"); }
        var request: outbound.Request = outbound.request(method.GET,
            view.view("https://api.example.com/catalog", 31));
        request.headers      = ?job.fields[0];
        request.header_count = 1;
        request.timeout_ns   = JOB_TIMEOUT_NS;
        val begun: outbound.Status = task.begin(run, ?job.exchange, request);
        if (begun == outbound.FAILED || begun == outbound.INVALID) {
            ret job_failed(job, "refused");
        }
        job.waiting = true;
    }
    val progress: outbound.Status = outbound.poll(?job.exchange, clock.instant());
    if (progress == outbound.PENDING) { ret pending; }
    if (progress != outbound.OK)      { ret job_failed(job, "fetch failed"); }
    forget_token(job);
    job.waiting = false;
    val answer: outbound.Response = outbound.response(?job.exchange);
    if (answer.status != 200) { ret job_failed(job, "unexpected status"); }
    job.published = task.publish(run, answer.body);
    outbound.finish(?job.exchange);
    ret service.Step{status: service.STEP_DONE, detail: view.view(nil, 0)};
}

# the #305 hardest case over real sockets: a periodic job borrowing a token
# fetches over HTTPS from the process's own listener on the task thread,
# publishes what it read to readers that never wait on it, holds no secret
# between runs, and drains when the process stops
test tasks__periodic_https_job_publishes_and_drains {
    var harness: Harness;
    harness.local     = false;
    harness.hosted    = false;
    harness.tasked    = true;
    harness.untrusted = false;
    if (!prepare_job(?harness.job) || !boot(?harness, false)) { ret 1; }
    harness.job.endpoint = harness.endpoint;
    var spec: task.Spec = task.Spec{name: view.view("catalog", 7),
        state:      (?harness.job)::ptr, step: job_step, period_ns: JOB_PERIOD_NS,
        timeout_ns: JOB_TIMEOUT_NS, slots: ?harness.job.slots[0][0], slot_bytes: 64,
        slot_count: 2};
    var handle: task.Handle;
    if (task.register(?harness.tasks, ?spec, ?handle) != task.STATUS_OK
        || task.trigger(?harness.tasks, handle) != task.STATUS_OK) {
        finish(?harness);
        ret 2;
    }
    # the triggered run, then one its period started. a run publishes inside
    # its step and is counted complete only once the step returns, so the wait
    # is for the second completion, not the second publish
    var report: task.Report;
    var rounds: usize = 0;
    for (rounds < PUBLISH_ROUNDS) {
        if (task.report(?harness.tasks, handle, ?report) != task.STATUS_OK
            || report.completed >= 2 || report.failed != 0) { brk; }
        os.sleep(PUBLISH_PAUSE);
        rounds = rounds + 1;
    }
    var lease:   task.Lease;
    val read:    task.Status = task.read(?harness.tasks, handle, ?lease);
    val carried: bool        = read == task.STATUS_OK
        && view.view_eq_str(task.lease_view(?lease), "Bearer s3cr3t-token");
    val released: bool                   = task.release(?harness.tasks, ?lease) == task.STATUS_OK;
    val stopped:  composition.StopReport = finish(?harness);
    outbound.destroy_exchange(?harness.job.exchange);
    bundle.release(?harness.heap, ?harness.anchors);
    if (!task.unregister_secrets(harness.secrets)) { ret 6; }
    if (report.published < 2 || report.completed < 2 || report.failed != 0
        || harness.job.published != task.STATUS_OK) { ret 3; }
    if (!carried || !released || harness.job.header_len != 0) { ret 4; }
    if (!stopped.stopped || stopped.reason == lifecycle.FAILED
        || stopped.reason == lifecycle.DEADLINE || stopped.cleanup_failures != 0
        || stopped.tasks_abandoned != 0) { ret 5; }
    ret 0;
}

# a task thread whose loop cannot open refuses the process's start, and since
# it opened nothing its stop counts no cleanup failure
test tasks__unopened_thread_refuses_start_and_closes_clean {
    var harness: Harness;
    harness.local     = false;
    harness.hosted    = false;
    harness.tasked    = true;
    harness.untrusted = true;
    harness.started   = composition.START_OK;
    if (!prepare_job(?harness.job) || boot(?harness, false)) { ret 1; }
    if (harness.started != composition.START_RUNTIME
        || task.thread_state(?harness.tasks) != task.THREAD_UNOPENED) { ret 2; }
    val stopped: composition.StopReport = supervisor.stop(?harness.supervising);
    outbound.destroy_exchange(?harness.job.exchange);
    bundle.release(?harness.heap, ?harness.anchors);
    if (!task.unregister_secrets(harness.secrets))                     { ret 3; }
    if (stopped.cleanup_failures != 0 || stopped.tasks_abandoned != 0) { ret 4; }
    ret 0;
}

# a worker that fails to start leaves no drain window: the periodic task's run
# in flight is abandoned at once, and the started application drains, then
# stops, after it, so the task thread never steps a run once `stop` has run
# (#439)
test tasks__failed_start_drains_before_hosted_stop {
    var harness: Harness;
    harness.started = composition.START_OK;
    if (boot_hosted(?harness, false, true)) { ret 1; }
    val phases:  *Phases                = ?harness.phases;
    val stopped: composition.StopReport = supervisor.stop(?harness.supervising);
    tcp.listener_close(?harness.holder);
    bundle.release(?harness.heap, ?harness.anchors);
    if (!task.unregister_secrets(harness.secrets)) { ret 2; }
    if (!harness.taken || harness.started == composition.START_OK
        || phases.starts == 0 || atomic.load(?phases.in_flight) == 0) { ret 3; }
    if (phases.stops != 1 || atomic.load(?phases.after_stop) != 0) { ret 4; }
    # the application drained, and before it stopped
    if (phases.drains != 1 || !phases.drained_at_stop)                       { ret 5; }
    if (stopped.tasks_abandoned != 1 || stopped.applications_abandoned != 0) { ret 6; }
    ret 0;
}
