# protocol selection over real sockets: PROXY decoding, peer propagation, and
# the refusals policy is supposed to produce
#
# the peer identity is asserted from the response body a service produced, not
# from a connection snapshot. that is the only way to prove the decoded peer
# actually reached request metadata rather than stopping at the decoder.

use hedge.clock;
use hedge.config.schema;
use hedge.connection;
use hedge.dispatch.call;
use hedge.dispatch.middleware;
use hedge.dispatch.plan;
use hedge.listener;
use hedge_memory: hedge.memory;
use hedge.protocol.h2;
use hedge.protocol.prologue;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.serve;
use hedge.service;
use hosting:      hedge.service.laurel;
use site_fixture: hedge.test.laurel;
use hedge.test.runtime.wire;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.status;
use engine_h2: http.h2.connection;
use http.router.router;
use laurel.app;
use std.allocator;
use heap_allocator: std.allocator;
use std.allocator.page;
use std.chrono.duration;
use std.chrono.time;
use io_error: std.io.error;
use std.net.ip;
use std.net.tcp;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

val MAX_ROUTES:     usize = 8;
val MAX_SEGMENTS:   usize = 64;
val MAX_SERVICES:   usize = 8;
val PLAN_TEXT:      usize = 2048;
val POOL:           usize = 4;
val RESPONSE_BYTES: usize = 4096;
val IDENTITY_BYTES: usize = 256;

# --- a native service that reports the identity the connection plane gave it ---

fun write_text(output: *u8, at: usize, capacity: usize, value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) {
        if (at + i >= capacity) { ret capacity; }
        output[at + i] = value[i];
        i              = i + 1;
    }
    ret at + i;
}

fun write_endpoint(output: *u8, at: usize, capacity: usize,
    endpoint: message.Endpoint) usize {
    var cursor: usize = at;
    var i:      usize = 0;
    for (i < endpoint.address.len) {
        if (cursor >= capacity) { ret capacity; }
        output[cursor] = endpoint.address.data[i];
        cursor         = cursor + 1;
        i              = i + 1;
    }
    ret cursor;
}

fun write_number(output: *u8, at: usize, capacity: usize, value: usize) usize {
    var digits:    [24]u8;
    var count:     usize = 0;
    var remaining: usize = value;
    if (remaining == 0) {
        digits[0] = '0';
        count     = 1;
    }
    for (remaining != 0) {
        digits[count] = '0' + (remaining % 10)::u8;
        remaining     = remaining / 10;
        count         = count + 1;
    }
    if (at + count > capacity) { ret capacity; }
    var i: usize = 0;
    for (i < count) {
        output[at + i] = digits[count - 1 - i];
        i              = i + 1;
    }
    ret at + count;
}

fun serve_identity(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val request:  *message.Request  = call.request(active);
    val response: *message.Response = call.response(active);
    if (request == nil || response == nil) { ret exchange.SERVICE_FAILED; }
    if (message.set_status(response, status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    if (!service.add_field(active, field.CONTENT_TYPE, "text/plain")) {
        ret exchange.SERVICE_FAILED;
    }
    val a: *allocator.Allocator = call.allocator_of(active);
    if (a == nil) { ret exchange.SERVICE_FAILED; }
    val allocated: res[*u8, allocator.Error] = allocator.allocate[u8](a, IDENTITY_BYTES);
    if (sel allocated.err) { ret exchange.SERVICE_FAILED; }
    val output: *u8   = allocated.ok;
    var at:     usize = 0;
    at = write_text(output, at, IDENTITY_BYTES, "peer=");
    at = write_endpoint(output, at, IDENTITY_BYTES, request.metadata.peer);
    at = write_text(output, at, IDENTITY_BYTES, " kind=");
    at = write_number(output, at, IDENTITY_BYTES, request.metadata.peer.kind::usize);
    at = write_text(output, at, IDENTITY_BYTES, " port=");
    at = write_number(output, at, IDENTITY_BYTES, request.metadata.peer.port::usize);
    at = write_text(output, at, IDENTITY_BYTES, " local=");
    at = write_endpoint(output, at, IDENTITY_BYTES, request.metadata.local);
    at = write_text(output, at, IDENTITY_BYTES, " wire=");
    at = write_number(output, at, IDENTITY_BYTES, request.metadata.version.wire::usize);
    at = write_text(output, at, IDENTITY_BYTES, " secure=");
    if (request.metadata.secure) {
        at = write_text(output, at, IDENTITY_BYTES, "1");
    }
    or {
        at = write_text(output, at, IDENTITY_BYTES, "0");
    }
    at = write_text(output, at, IDENTITY_BYTES, ";");
    at = write_text(output, at, IDENTITY_BYTES, " stream=");
    at = write_number(output, at, IDENTITY_BYTES,
        request.metadata.request_index::usize);
    at = write_text(output, at, IDENTITY_BYTES, ";");
    if (at >= IDENTITY_BYTES) { ret exchange.SERVICE_FAILED; }
    ret service.respond_with_bytes(active, output, at);
}

fun build_identity(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    @handler = service.Handler{ctx: nil, serve: serve_identity};
    ret true;
}

rec FinalizerProbe {
    calls: usize;
}

fun refuse_finalizer(context: ptr, active: *call.Call) bool {
    val state: *FinalizerProbe = context::*FinalizerProbe;
    state.calls = state.calls + 1;
    ret false;
}

fun serve_finalizing_identity(context: ptr,
    active: *call.Call) exchange.ServiceStatus {
    if (!call.attach_finalizer(active, call.Finalizer{
        ctx: context, finish: refuse_finalizer
    })) {
        ret exchange.SERVICE_FAILED;
    }
    ret serve_identity(nil, active);
}

fun build_finalizing_identity(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    @handler = service.Handler{ctx: context, serve: serve_finalizing_identity};
    ret true;
}

# --- harness ---

rec Harness {
    graph:             schema.Graph;
    diagnostics:       schema.Diagnostics;
    routes:            [MAX_ROUTES]router.CompiledRoute;
    segments:          [MAX_SEGMENTS]router.Segment;
    specs:             [MAX_ROUTES]router.Route;
    entries:           [MAX_ROUTES]plan.Entry;
    services:          [MAX_SERVICES]service.Descriptor;
    middlewares:       [4]middleware.Middleware;
    text:              [PLAN_TEXT]u8;
    storage:           plan.Storage;
    plan:              plan.Plan;
    heap:              heap_allocator.Allocator;
    runtime:           serve.Runtime;
    applications:      service.Applications;
    application_slots: [4]service.Application;
    resolver:          service.Resolver;
    endpoint:          ip.Endpoint;
}

fun base_graph(graph: *schema.Graph, protocols: u8, proxy: u8) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "protocol-test");
    graph.limits.max_connections          = opt[usize].some{POOL};
    graph.limits.max_connections_per_peer = opt[usize].some{POOL};
    graph.listener_count                  = 1;
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.name, "public");
    schema.set_text(?configured.address, "127.0.0.1:0");
    schema.clear_text(?configured.tls_policy);
    schema.clear_text(?configured.budget);
    configured.transport          = schema.TRANSPORT_TCP;
    configured.protocols          = protocols;
    configured.backlog            = 16;
    configured.accept_depth       = 2;
    configured.proxy_protocol     = proxy;
    configured.trusted_peer_count = 0;
    graph.host_count              = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "localhost");
    graph.service_count = 1;
    val identity: *schema.Service = ?graph.services[0];
    schema.set_text(?identity.name, "identity");
    identity.kind = schema.SERVICE_NATIVE;
    schema.set_text(?identity.target, "identity");
    schema.clear_text(?identity.budget);
    identity.status = 200;
    schema.clear_text(?identity.content_type);
    graph.route_count = 1;
    val route: *schema.Route = ?graph.routes[0];
    schema.set_text(?route.name, "root");
    schema.set_text(?route.host, "site");
    schema.set_text(?route.path, "/**");
    schema.set_text(?route.service, "identity");
    schema.clear_text(?route.budget);
}

fun trust_peer(graph: *schema.Graph, value: str) {
    val configured: *schema.Listener = ?graph.listeners[0];
    schema.set_text(?configured.trusted_peers[configured.trusted_peer_count], value);
    configured.trusted_peer_count = configured.trusted_peer_count + 1;
}

fun compile(harness: *Harness, generation: u64) bool {
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.native       = service.Factory{ctx: nil, build: build_identity};
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret false; }
    ret plan.compile(?harness.plan, generation, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status == plan.PLAN_OK;
}

fun boot(harness: *Harness, generation: u64) bool {
    var quic_controls: quic_runtime.ControlView;
    page.make(?harness.heap);
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret false; }
    schema.reset_diagnostics(?harness.diagnostics);
    if (!serve.start(?quic_controls, ?harness.runtime, generation, ?harness.graph, ?harness.diagnostics)) {
        ret false;
    }
    val owned: *listener.OwnedListener = listener.active_listener(?harness.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) { ret false; }
    harness.endpoint = owned.bound_endpoint;
    ret true;
}

fun start(harness: *Harness, generation: u64, protocols: u8, proxy: u8) bool {
    ret compile(harness, generation) && boot(harness, generation);
}

fun send_bytes(client: *tcp.Stream, data: *u8, length: usize) bool {
    val written: res[usize, io_error.Error] = tcp.stream_write(client, data, length);
    if (sel written.err) { ret false; }
    ret written.ok == length;
}

# the v2 binary form of `203.0.113.9:5000 -> 198.51.100.2:443`
fun v2_header(output: *u8) usize {
    val signature: [12]u8 = [12]u8{0x0d, 0x0a, 0x0d, 0x0a, 0x00, 0x0d,
        0x0a, 0x51, 0x55, 0x49, 0x54, 0x0a};
    var i: usize = 0;
    for (i < 12) {
        output[i] = signature[i];
        i         = i + 1;
    }
    output[12] = 0x21;
    output[13] = 0x11;
    output[14] = 0x00;
    output[15] = 12;
    output[16] = 203;
    output[17] = 0;
    output[18] = 113;
    output[19] = 9;
    output[20] = 198;
    output[21] = 51;
    output[22] = 100;
    output[23] = 2;
    output[24] = 0x13;
    output[25] = 0x88;
    output[26] = 0x01;
    output[27] = 0xbb;
    ret 28;
}

val REQUEST: str = "GET /id HTTP/1.1\r\nHost: localhost\r\n\r\n";

test "protocol: a cleartext listener reports the observed peer" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, ";");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret 4;
    }
    # kind 1 is ENDPOINT_IP: the address was observed, not asserted
    if (!wire.contains(?response[0], length, "peer=127.0.0.1:"))   { ret 5; }
    if (!wire.contains(?response[0], length, " kind=1 "))          { ret 6; }
    if (!wire.contains(?response[0], length, " local=127.0.0.1:")) { ret 7; }
    if (!wire.contains(?response[0], length, " secure=0;"))        { ret 8; }
    ret 0;
}

test "protocol: a trusted v1 header replaces the peer every reader sees" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED);
    trust_peer(?harness.graph, "127.0.0.1");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, "PROXY TCP4 203.0.113.9 198.51.100.2 5000 443\r\n")
        || !wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, ";");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret 4;
    }
    # the decoded peer, not the socket peer, is what the service was handed
    if (!wire.contains(?response[0], length, "peer=203.0.113.9:5000")) { ret 5; }
    if (wire.contains(?response[0], length, "peer=127.0.0.1"))         { ret 6; }
    # kind 3 is ENDPOINT_FORWARDED, so a reader can tell the two apart
    if (!wire.contains(?response[0], length, " kind=3 "))                 { ret 7; }
    if (!wire.contains(?response[0], length, " port=5000 "))              { ret 8; }
    if (!wire.contains(?response[0], length, " local=198.51.100.2:443 ")) { ret 9; }
    ret 0;
}

test "protocol: a trusted v2 header is decoded the same as the text form" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED);
    trust_peer(?harness.graph, "127.0.0.0/8");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var header:        [64]u8;
    val header_length: usize = v2_header(?header[0]);
    if (!send_bytes(?client, ?header[0], header_length) || !wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, ";");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret 4;
    }
    if (!wire.contains(?response[0], length, "peer=203.0.113.9:5000"))    { ret 5; }
    if (!wire.contains(?response[0], length, " kind=3 "))                 { ret 6; }
    if (!wire.contains(?response[0], length, " local=198.51.100.2:443 ")) { ret 7; }
    ret 0;
}

test "protocol: an untrusted peer's header is refused, not believed" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OPTIONAL);
    # the loopback client is deliberately outside the trusted set
    trust_peer(?harness.graph, "10.0.0.0/8");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_OPTIONAL)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, "PROXY TCP4 203.0.113.9 198.51.100.2 5000 443\r\n")
        || !wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize            = wire.drain(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES);
    val refusal:  prologue.Refusal = serve.last_refusal(?harness.runtime);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    # nothing is served, and in particular the asserted address is never used
    if (length != 0)                                        { ret 4; }
    if (wire.contains(?response[0], length, "203.0.113.9")) { ret 5; }
    if (refusal != prologue.REFUSED_PROXY_UNTRUSTED)        { ret (100 + refusal::usize)::i32; }
    ret 0;
}

test "protocol: a required header that never arrives closes the connection" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED);
    trust_peer(?harness.graph, "127.0.0.1");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize            = wire.drain(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES);
    val refusal:  prologue.Refusal = serve.last_refusal(?harness.runtime);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length != 0)                               { ret 4; }
    if (refusal != prologue.REFUSED_PROXY_MISSING) { ret (100 + refusal::usize)::i32; }
    ret 0;
}

test "protocol: a malformed header is refused rather than read as a request" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OPTIONAL);
    trust_peer(?harness.graph, "127.0.0.1");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_OPTIONAL)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, "PROXY TCP4 203.0.113.999 198.51.100.2 5000 443\r\n")
        || !wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize            = wire.drain(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES);
    val refusal:  prologue.Refusal = serve.last_refusal(?harness.runtime);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length != 0)                                 { ret 4; }
    if (refusal != prologue.REFUSED_PROXY_MALFORMED) { ret (100 + refusal::usize)::i32; }
    ret 0;
}

# no engine ever owned this socket, so the connection plane leaves it to the
# listener, which closes it through the driver that has seen it (#716)
test "protocol: a refused connection's socket is closed and its slot returned" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OPTIONAL);
    trust_peer(?harness.graph, "127.0.0.1");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_OPTIONAL)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, "PROXY TCP4 203.0.113.999 198.51.100.2 5000 443\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    wire.drain(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES);
    # the peer reads end of stream, not a timeout: the socket really closed
    val tail:   res[usize, io_error.Error] = tcp.stream_read(?client, ?response[0], 16);
    var closed: bool                       = false;
    if (sel tail.ok) { closed = tail.ok == 0; }
    val state:    listener.Snapshot = listener.snapshot(?harness.runtime.owner);
    val failures: u64               = harness.runtime.teardown_failures;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (!closed)                   { ret 4; }
    if (state.connections != 0)    { ret 5; }
    if (failures != 0)             { ret 6; }
    if (harness.runtime.live != 0) { ret 7; }
    ret 0;
}

test "protocol: prior knowledge on an HTTP/1 listener is refused" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize            = wire.drain(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES);
    val refusal:  prologue.Refusal = serve.last_refusal(?harness.runtime);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    # a listener that does not serve HTTP/2 must not answer the preface as if it
    # were an HTTP/1 request line
    if (length != 0)                          { ret 4; }
    if (refusal != prologue.REFUSED_PROTOCOL) { ret (100 + refusal::usize)::i32; }
    ret 0;
}

test "protocol: a header split across writes is still decoded" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED);
    trust_peer(?harness.graph, "127.0.0.1");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    # the prologue has to accumulate across reads rather than decide on the first
    if (!wire.send(?client, "PROXY TCP4 203.0")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    serve.poll(?quic_controls, ?harness.runtime, 2);
    serve.poll(?quic_controls, ?harness.runtime, 2);
    if (!wire.send(?client, ".113.9 198.51.100.2 5000 443\r\nGET /id HTT")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    serve.poll(?quic_controls, ?harness.runtime, 2);
    if (!wire.send(?client, "P/1.1\r\nHost: localhost\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    var response: [RESPONSE_BYTES]u8;
    val length:   usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, ";");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (length == 0 || !wire.starts_with(?response[0], length, "HTTP/1.1 200 OK\r\n")) {
        ret 6;
    }
    if (!wire.contains(?response[0], length, "peer=203.0.113.9:5000")) { ret 7; }
    ret 0;
}

test "protocol: a decoded peer survives keep-alive onto the next request" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED);
    trust_peer(?harness.graph, "127.0.0.1");
    if (!start(?harness, 1, schema.PROTOCOL_HTTP1, schema.PROXY_REQUIRED)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    if (!wire.send(?client, "PROXY TCP4 203.0.113.9 198.51.100.2 5000 443\r\n")
        || !wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var first:        [RESPONSE_BYTES]u8;
    val first_length: usize = wire.collect(?harness.runtime, ?client, ?first[0],
        RESPONSE_BYTES, ";");
    if (first_length == 0 || !wire.contains(?first[0], first_length, "peer=203.0.113.9:5000")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    # the header is sent once per connection, so the second request must still
    # be attributed to the same client
    if (!wire.send(?client, REQUEST)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    var second:        [RESPONSE_BYTES]u8;
    val second_length: usize = wire.collect(?harness.runtime, ?client, ?second[0],
        RESPONSE_BYTES, ";");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (second_length == 0)                                                 { ret 6; }
    if (!wire.contains(?second[0], second_length, "peer=203.0.113.9:5000")) { ret 7; }
    if (wire.contains(?second[0], second_length, "peer=127.0.0.1"))         { ret 8; }
    ret 0;
}

test "protocol: prior knowledge serves a real HTTP/2 request" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    # the identity body's last field, not its first `;`: an HTTP/2 response
    # reaches the client behind a compressed header block, and a `;` byte in
    # that block ends the collection before the body has arrived at all
    val received: usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, "stream=1;");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (received == 0) { ret 4; }
    # this is HTTP/2 on the wire, not an HTTP/1 response to a mis-read preface
    if (wire.starts_with(?response[0], received, "HTTP/1.1")) { ret 5; }
    # the service saw an HTTP/2 request and the observed peer
    if (!wire.contains(?response[0], received, " wire=2 "))        { ret 6; }
    if (!wire.contains(?response[0], received, "peer=127.0.0.1:")) { ret 7; }
    if (!wire.contains(?response[0], received, " kind=1 "))        { ret 8; }
    ret 0;
}

fun build_body_reader(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    @handler = service.Handler{ctx: context, serve: wire.body_reading_serve};
    ret true;
}

test "protocol: an HTTP/2 service that suspends on the request body receives it" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    var state: wire.BodyReader = wire.BodyReader{suspensions: 0, token: 0, length: 0};
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.native       = service.Factory{ctx: (?state)::ptr, build: build_body_reader};
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret 1; }
    if (plan.compile(?harness.plan, 1, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 1)) { ret 2; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_open_request(?request[0], length, 1);
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 4;
    }
    # the body is held back until the service has entered and suspended on it
    var polls: usize = 0;
    for (polls < 40 && state.suspensions == 0) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    length = wire.put_frame(?request[0], 0, 11, 0x00, 0x01, 1);
    length = wire.put_text(?request[0], length, "hello world");
    if (state.suspensions == 0 || !send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    var response: [RESPONSE_BYTES]u8;
    val received: usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, "hello world");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (received == 0 || !wire.contains(?response[0], received, "hello world")) { ret 6; }
    if (state.length != 11)                                                     { ret 7; }
    ret 0;
}

test "protocol: an HTTP/2 laurel handler suspended on a body is entered once" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    val hosted: *schema.Service = ?harness.graph.services[0];
    hosted.kind = schema.SERVICE_LAUREL;
    schema.set_text(?hosted.target, "site");
    schema.clear_text(?hosted.content_type);
    var site: site_fixture.Site;
    if (!site_fixture.make_site(?site)) { ret 1; }
    var adapter: hosting.Adapter;
    service.make_applications(?harness.applications,
        ?harness.application_slots[0], 4);
    if (!hosting.make(?adapter, ?site.application)
        || !service.register_application(?harness.applications, "site",
        hosting.bound_handler(?adapter), 0)) { ret 2; }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret 3; }
    if (plan.compile(?harness.plan, 1, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 1)) { ret 4; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_form_request(?request[0], length, 1);
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 6;
    }
    # the body is held back until the laurel handler has entered and suspended
    var polls: usize = 0;
    for (polls < 40 && site.probe.entries == 0) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    if (site.probe.entries != 1 || site.probe.work != 0) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 7;
    }
    # the first data frame leaves the stream open, so the handler suspends again
    length = wire.put_frame(?request[0], 0, 5, 0x00, 0x00, 1);
    length = wire.put_text(?request[0], length, "name=");
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 8;
    }
    polls = 0;
    for (polls < 20) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    if (site.probe.entries != 1 || site.probe.work != 0) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 9;
    }
    length = wire.put_frame(?request[0], 0, 5, 0x00, 0x01, 1);
    length = wire.put_text(?request[0], length, "alice");
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 10;
    }
    var response: [RESPONSE_BYTES]u8;
    val received: usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, "alice");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (received == 0 || !wire.contains(?response[0], received, "alice")) {
        ret 11;
    }
    # entered once across both data frames, and the work done exactly once
    if (site.probe.entries != 1 || site.probe.work != 1
        || site.probe.resumes == 0 || site.probe.abandons != 0
        || site.probe.exits != site.probe.layers) { ret 12; }
    if (app.active_request_count(?site.application) != 0) { ret 13; }
    ret 0;
}

test "protocol: an HTTP/2 finalizer failure closes the owning session" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    var finalizer: FinalizerProbe = FinalizerProbe{calls: 0};
    service.make_applications(?harness.applications,
        ?harness.application_slots[0], 4);
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.native       = service.Factory{ctx: ?finalizer,
        build: build_finalizing_identity};
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)
        || plan.compile(?harness.plan, 52, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 52)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val received: usize = wire.collect(?harness.runtime, ?client,
        ?response[0], RESPONSE_BYTES, "stream=1;");
    var polls: usize = 0;
    for (polls < wire.MAX_ROUNDS && harness.runtime.live != 0) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    val closed: bool = harness.runtime.live == 0;
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (received == 0)        { ret 41; }
    if (finalizer.calls != 1) { ret 42; }
    if (!closed)              { ret 43; }
    ret 0;
}

val CONCURRENT: usize = 20;

test "protocol: more concurrent HTTP/2 connections than sessions ever preallocated" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    harness.graph.limits.max_connections          = opt[usize].some{CONCURRENT};
    harness.graph.limits.max_connections_per_peer = opt[usize].some{CONCURRENT};
    harness.graph.listeners[0].backlog            = CONCURRENT;
    if (!compile(?harness, 1)) { ret 1; }
    page.make(?harness.heap);
    val slots: res[*serve.Slot, heap_allocator.Error] =
        heap_allocator.allocate[serve.Slot](?harness.heap, CONCURRENT);
    val connections: res[*connection.Connection, heap_allocator.Error] =
        heap_allocator.allocate[connection.Connection](?harness.heap, CONCURRENT);
    if (sel slots.err)                                                               { ret 2; }
    if (sel connections.err)                                                         { ret 2; }
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret 3; }
    schema.reset_diagnostics(?harness.diagnostics);
    if (!serve.start(?quic_controls, ?harness.runtime, 1, ?harness.graph,
        ?harness.diagnostics)) { ret 4; }
    val owned: *listener.OwnedListener = listener.active_listener(?harness.runtime.owner, 0);
    if (owned == nil || !owned.has_bound_endpoint) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    var clients: [CONCURRENT]tcp.Stream;
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    var opened: usize = 0;
    for (opened < CONCURRENT) {
        if (!wire.connect(owned.bound_endpoint, ?clients[opened])) { brk; }
        opened = opened + 1;
        if (!send_bytes(?clients[opened - 1], ?request[0], length)) { brk; }
        serve.poll(?quic_controls, ?harness.runtime, 2);
    }
    var answered: usize = 0;
    var i:        usize = 0;
    for (i < opened) {
        var response: [RESPONSE_BYTES]u8;
        val received: usize = wire.collect(?harness.runtime, ?clients[i], ?response[0],
            RESPONSE_BYTES, "stream=1;");
        if (received != 0 && wire.contains(?response[0], received, " wire=2 ")) {
            answered = answered + 1;
        }
        i = i + 1;
    }
    # every connection is still open, so every session is held at once
    val live: usize = harness.runtime.live;
    i = 0;
    for (i < opened) {
        tcp.stream_close(?clients[i]);
        i = i + 1;
    }
    val stopped: bool = serve.stop(?quic_controls, ?harness.runtime);
    if (opened != CONCURRENT)   { ret 6; }
    if (answered != CONCURRENT) { ret 7; }
    if (live != CONCURRENT)     { ret 8; }
    if (!stopped)               { ret 9; }
    ret 0;
}

test "protocol: one HTTP/2 connection carries two request streams" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var request: [512]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    length = wire.put_request(?request[0], length, 3);
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val received: usize = wire.drain(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    # the counter is published when the connection is retired
    val streams: u64 = harness.runtime.served;
    if (received == 0) { ret 4; }
    # each concurrent stream receives the body built from its own request
    if (!wire.contains(?response[0], received, "stream=1;")) { ret 5; }
    if (!wire.contains(?response[0], received, "stream=3;")) { ret 6; }
    if (streams != 2)                                        { ret (100 + streams)::i32; }
    ret 0;
}

fun build_wake_holder(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    @handler = service.Handler{ctx: context, serve: wire.wake_holding_serve};
    ret true;
}

test "protocol: one HTTP/2 stream's wake enters its own service and not its neighbour's" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    var holder: wire.WakeHolder;
    wire.make_wake_holder(?holder);
    service.make_applications(?harness.applications, ?harness.application_slots[0], 4);
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    harness.resolver.native       = service.Factory{ctx: (?holder)::ptr, build: build_wake_holder};
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret 1; }
    if (plan.compile(?harness.plan, 1, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 1)) { ret 2; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var request: [512]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    length = wire.put_request(?request[0], length, 3);
    var code: i32 = 0;
    if (!send_bytes(?client, ?request[0], length)) { code = 4; }
    var polls: usize = 0;
    for (code == 0 && polls < 40 && holder.held < 2) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        polls = polls + 1;
    }
    var session: *h2.Session = nil;
    if (code == 0 && holder.held != 2) { code = 5; }
    if (code == 0) {
        val owner: *connection.Connection = ?serve.slot_at(?harness.runtime, 0).connection;
        if (owner.h2_session != h2.NO_SESSION) {
            session = h2.session_at(?owner.shared.h2_sessions, owner.h2_session);
        }
        if (session == nil) { code = 6; }
    }
    # both parked and nothing moved: no work, and the audit agrees
    if (code == 0 && (h2.pending_work(session)
        || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0)) { code = 7; }
    # its own wake enters the first stream's service again, and not the second's
    if (code == 0 && !wire.nudge_held(?holder, 0)) { code = 9; }
    var r: usize = 0;
    for (code == 0 && r < 10) {
        serve.poll(?quic_controls, ?harness.runtime, 2);
        r = r + 1;
    }
    if (code == 0 && (holder.entries[0] != 2 || holder.entries[1] != 1)) {
        code = (100 + holder.entries[0] * 10 + holder.entries[1])::i32;
    }
    # a stirred stream is work, and one no queue holds is what the audit finds
    if (code == 0) {
        h2.stir(session, holder.wakers[1].call);
        if (!h2.pending_work(session)
            || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1) { code = 8; }
    }
    if (code == 0 && (!wire.release_held(?holder, 0) || !wire.release_held(?holder, 1))) {
        code = 10;
    }
    var response: [RESPONSE_BYTES]u8;
    var received: usize = 0;
    if (code == 0) {
        received = wire.drain(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES);
    }
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (code != 0)                                                           { ret code; }
    if (received == 0 || !wire.contains(?response[0], received, "released")) { ret 11; }
    if (harness.runtime.served != 2)                                         { ret 12; }
    ret 0;
}

test "protocol: one HTTP/2 connection carries six sequential request streams" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var markers: [6]str = [6]str{"stream=1;", "stream=3;", "stream=5;",
        "stream=7;", "stream=9;", "stream=11;"};
    var request:  [256]u8;
    var response: [RESPONSE_BYTES]u8;
    var i:        usize = 0;
    for (i < 6) {
        var length: usize = 0;
        if (i == 0) { length = wire.put_connection_start(?request[0]); }
        length = wire.put_request(?request[0], length, (i * 2 + 1)::u32);
        if (!send_bytes(?client, ?request[0], length)) {
            tcp.stream_close(?client);
            serve.stop(?quic_controls, ?harness.runtime);
            ret 3;
        }
        val received: usize = wire.collect(?harness.runtime, ?client,
            ?response[0], RESPONSE_BYTES, markers[i]);
        if (received == 0 || !wire.contains(?response[0], received, markers[i])) {
            tcp.stream_close(?client);
            serve.stop(?quic_controls, ?harness.runtime);
            ret (10 + i)::i32;
        }
        i = i + 1;
    }
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (harness.runtime.accepted != 1) { ret 20; }
    if (harness.runtime.served != 6)   { ret 21; }
    ret 0;
}

# the audit asks the HTTP/2 engine whether it holds work (#261): output it has
# framed and not submitted, with no write in flight to wake the connection, is
# work nothing will run. before, a connection carrying HTTP/2 answered no
test "protocol: the debug audit asks an idle HTTP/2 engine for held work" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    var response: [RESPONSE_BYTES]u8;
    var code:     i32 = 0;
    if (!send_bytes(?client, ?request[0], length)
        || wire.collect(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES,
        "stream=1;") == 0) { code = 3; }
    var r: usize = 0;
    for (code == 0 && r < 8) {
        serve.poll(?quic_controls, ?harness.runtime, 0);
        r = r + 1;
    }
    var session: *h2.Session = nil;
    if (code == 0) {
        val owner: *connection.Connection = ?serve.slot_at(?harness.runtime, 0).connection;
        if (harness.runtime.live == 1 && owner.h2_session != h2.NO_SESSION) {
            session = h2.session_at(?owner.shared.h2_sessions, owner.h2_session);
        }
        if (session == nil) { code = 4; }
    }
    # settled and reading, the engine holds nothing
    if (code == 0 && (h2.pending_work(session)
        || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0)) { code = 5; }
    if (code == 0) {
        val held:    usize = session.engine.write_length;
        val pending: bool  = session.engine.write_pending;
        # framed output, never submitted, and nothing in flight to wake the slot
        session.engine.write_length  = 1;
        session.engine.write_pending = false;
        if (!h2.pending_work(session)
            || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1) { code = 6; }
        # the same output with its write in flight waits on the completion
        session.engine.write_pending = true;
        if (code == 0 && (h2.pending_work(session)
            || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0)) { code = 7; }
        session.engine.write_length  = held;
        session.engine.write_pending = pending;
    }
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    ret code;
}

# a retiring connection is asked what its HTTP/2 release would do now (#270), not
# what the engine would ask of a host stepping it. a failed engine with no stream
# reads a close ready, but the release destroys it once its read settles, so that
# is no missed wake. one still holding a stream is nudged to close, and is
test "protocol: the debug audit asks a retiring HTTP/2 connection only for work its release does" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var request: [256]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    length = wire.put_request(?request[0], length, 1);
    var response: [RESPONSE_BYTES]u8;
    var code:     i32 = 0;
    if (!send_bytes(?client, ?request[0], length)
        || wire.collect(?harness.runtime, ?client, ?response[0], RESPONSE_BYTES,
        "stream=1;") == 0) { code = 3; }
    var r: usize = 0;
    for (code == 0 && r < 8) {
        serve.poll(?quic_controls, ?harness.runtime, 0);
        r = r + 1;
    }
    var owner:   *connection.Connection = nil;
    var session: *h2.Session            = nil;
    if (code == 0) {
        owner = ?serve.slot_at(?harness.runtime, 0).connection;
        if (harness.runtime.live != 1 || owner.h2_session == h2.NO_SESSION) { code = 4; }
        or                                                                  { session = h2.session_at(?owner.shared.h2_sessions, owner.h2_session); }
    }
    # settled and reading: the engine's read is in flight and its output idle
    if (code == 0 && (!session.engine.read_pending || session.engine.write_pending
        || session.engine.close_pending || session.engine.write_length != 0)) { code = 5; }
    if (code == 0) {
        val slot:    *serve.Slot     = serve.slot_at(?harness.runtime, 0);
        val state:   engine_h2.State = session.engine.state;
        val streams: usize           = session.engine.active_streams;
        slot.retiring                 = true;
        owner.close_wait              = connection.CLOSE_HTTP2;
        session.engine.state          = engine_h2.FAILED;
        session.engine.active_streams = 0;
        # the engine answers a close ready, and the release waits only on the read
        if (!h2.pending_work(session) || h2.close_work(session)
            || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 0) { code = 6; }
        # a stream still open is the one the release nudges to close
        session.engine.active_streams = 1;
        if (code == 0 && (!h2.close_work(session)
            || serve.audit(?quic_controls, ?harness.runtime, clock.instant()) != 1)) { code = 7; }
        session.engine.state          = state;
        session.engine.active_streams = streams;
        owner.close_wait              = connection.CLOSE_READY;
        slot.retiring                 = false;
    }
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    ret code;
}

test "protocol: an idle HTTP/2 connection holds no per-stream slot memory" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    # six sequential streams borrow and release their slot storage in turn
    var markers: [6]str = [6]str{"stream=1;", "stream=3;", "stream=5;",
        "stream=7;", "stream=9;", "stream=11;"};
    var request:  [256]u8;
    var response: [RESPONSE_BYTES]u8;
    var i:        usize = 0;
    for (i < 6) {
        var length: usize = 0;
        if (i == 0) { length = wire.put_connection_start(?request[0]); }
        length = wire.put_request(?request[0], length, (i * 2 + 1)::u32);
        if (!send_bytes(?client, ?request[0], length)) {
            tcp.stream_close(?client);
            serve.stop(?quic_controls, ?harness.runtime);
            ret 3;
        }
        val received: usize = wire.collect(?harness.runtime, ?client, ?response[0],
            RESPONSE_BYTES, markers[i]);
        if (received == 0 || !wire.contains(?response[0], received, markers[i])) {
            tcp.stream_close(?client);
            serve.stop(?quic_controls, ?harness.runtime);
            ret (10 + i)::i32;
        }
        i = i + 1;
    }
    # drive the server so the last stream fully retires and returns its slot
    var r: usize = 0;
    for (r < 8) {
        serve.poll(?quic_controls, ?harness.runtime, 0);
        r = r + 1;
    }
    val idle: hedge_memory.Snapshot = hedge_memory.snapshot(?harness.runtime.memory);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    val lane: hedge_memory.LaneCounters = idle.lanes[hedge_memory.LANE_REQUEST::usize];
    # the streams did borrow per-stream slot storage from the request lane
    if (lane.peak < 16384) { ret 7; }
    # and the idle connection, its six streams long gone, holds none of it
    if (lane.held != 0) { ret 8; }
    ret 0;
}

test "protocol: reset HTTP/2 streams release their bounded engine slots" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        schema.PROXY_OFF);
    if (!start(?harness, 1, schema.PROTOCOL_HTTP2, schema.PROXY_OFF)) { ret 1; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 2;
    }
    var request: [1024]u8;
    var length:  usize = wire.put_connection_start(?request[0]);
    var stream:  u32   = 1;
    for (stream < 12) {
        length = wire.put_open_request(?request[0], length, stream);
        length = wire.put_reset(?request[0], length, stream, 8);
        stream = stream + 2;
    }
    length = wire.put_request(?request[0], length, 13);
    if (!send_bytes(?client, ?request[0], length)) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    var response: [RESPONSE_BYTES]u8;
    val received: usize = wire.collect(?harness.runtime, ?client, ?response[0],
        RESPONSE_BYTES, "stream=13;");
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (received == 0 || !wire.contains(?response[0], received, "stream=13;")) {
        ret 4;
    }
    if (harness.runtime.accepted != 1) { ret 5; }
    if (harness.runtime.served != 7)   { ret 6; }
    ret 0;
}

test "protocol: a datagram listener requires an attached quic runtime" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP3, schema.PROXY_OFF);
    val configured: *schema.Listener = ?harness.graph.listeners[0];
    configured.transport = schema.TRANSPORT_QUIC;
    schema.set_text(?configured.tls_policy, "public");
    if (!compile(?harness, 1)) { ret 1; }
    page.make(?harness.heap);
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret 2; }
    schema.reset_diagnostics(?harness.diagnostics);
    # a caller that omits the quic plane cannot publish only its udp socket
    if (serve.start(?quic_controls, ?harness.runtime, 1, ?harness.graph, ?harness.diagnostics)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (harness.diagnostics.error_count == 0) { ret 4; }
    ret 0;
}

test "protocol: a TLS listener whose policy never loaded does not become ready" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OFF);
    val configured: *schema.Listener = ?harness.graph.listeners[0];
    schema.set_text(?configured.tls_policy, "public");
    if (!compile(?harness, 1)) { ret 1; }
    page.make(?harness.heap);
    if (!serve.make(?harness.runtime, ?harness.plan, ?harness.graph, ?harness.heap)) { ret 2; }
    schema.reset_diagnostics(?harness.diagnostics);
    # the credential generation was never published, so the listener must not
    # accept connections it would then refuse one handshake at a time
    if (serve.start(?quic_controls, ?harness.runtime, 1, ?harness.graph, ?harness.diagnostics)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 3;
    }
    if (harness.diagnostics.error_count == 0) { ret 4; }
    ret 0;
}

val HANDLER_DEADLINE_NS: i64 = 300000000;

# laurel narrows the request deadline to its handler deadline and the host
# enforces it: a handler still waiting on a body when it passes is timed out
test "protocol: a laurel handler past its handler deadline is timed out" {
    var quic_controls: quic_runtime.ControlView;
    var harness:       Harness;
    base_graph(?harness.graph, schema.PROTOCOL_HTTP1, schema.PROXY_OFF);
    val hosted: *schema.Service = ?harness.graph.services[0];
    hosted.kind = schema.SERVICE_LAUREL;
    schema.set_text(?hosted.target, "site");
    schema.clear_text(?hosted.content_type);
    var site: site_fixture.Site;
    if (!site_fixture.make_site_with_deadline(?site,
        opt[duration.Duration].some{HANDLER_DEADLINE_NS * duration.NANOSECOND})) { ret 1; }
    var adapter: hosting.Adapter;
    service.make_applications(?harness.applications,
        ?harness.application_slots[0], 4);
    if (!hosting.make(?adapter, ?site.application)
        || !service.register_application(?harness.applications, "site",
        hosting.bound_handler(?adapter), 0)) { ret 2; }
    harness.resolver              = service.no_resolver();
    harness.resolver.applications = ?harness.applications;
    if (!plan.make_storage(?harness.storage,
        ?harness.routes[0], MAX_ROUTES,
        ?harness.segments[0], MAX_SEGMENTS,
        ?harness.specs[0], MAX_ROUTES,
        ?harness.entries[0], MAX_ROUTES,
        ?harness.services[0], MAX_SERVICES,
        ?harness.middlewares[0], 4,
        ?harness.text[0], PLAN_TEXT)) { ret 3; }
    if (plan.compile(?harness.plan, 1, ?harness.graph, harness.storage,
        ?harness.resolver, nil).status != plan.PLAN_OK
        || !boot(?harness, 1)) { ret 4; }
    var client: tcp.Stream;
    if (!wire.connect(harness.endpoint, ?client)) {
        serve.stop(?quic_controls, ?harness.runtime);
        ret 5;
    }
    # the body never arrives, so the handler waits on it until the deadline
    if (!wire.send(?client, "POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 10\r\n\r\n")) {
        tcp.stream_close(?client);
        serve.stop(?quic_controls, ?harness.runtime);
        ret 6;
    }
    val started:  time.Instant = clock.instant();
    val limit_ns: i64          = HANDLER_DEADLINE_NS * 10;
    var response: [RESPONSE_BYTES]u8;
    var received: usize        = 0;
    var ended:    bool         = false;
    for (!ended && time.instant_sub(clock.instant(), started) < limit_ns) {
        serve.poll(?quic_controls, ?harness.runtime, 5);
        val read: res[usize, io_error.Error] = tcp.stream_read(?client,
            ?response[received], RESPONSE_BYTES - received - 1);
        if (sel read.ok) {
            received = received + read.ok;
            ended    = read.ok == 0 || received != 0;
        }
    }
    val elapsed_ns: i64 = time.instant_sub(clock.instant(), started);
    tcp.stream_close(?client);
    serve.stop(?quic_controls, ?harness.runtime);
    if (site.probe.entries != 1)              { ret 7; }
    if (!ended)                               { ret 8; }
    if (elapsed_ns < HANDLER_DEADLINE_NS / 2) { ret 9; }
    ret 0;
}
