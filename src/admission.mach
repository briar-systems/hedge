# connection admission against caps every worker shares
#
# a worker admits through its own `Manager`, which holds its leases. the caps
# are the process's, in a `Shared` every worker's manager joins: the global cap
# is an `allowance.Pool` each worker draws a share from, and the per-peer cap a
# table of per-address counts split over SHARDS shards, each behind its own
# lock, so one admission touches one shard and holds its lock only across the
# count. a manager made on its own owns a private `Shared`, which is what one
# worker, a QUIC runtime's handshakes and the tests use.
#
# lease and count storage grows with what is connected rather than being sized
# from a configured ceiling. `max_connections` is a policy cap: absent means the
# only ceiling is what the allocator will give, present means admission refuses
# past that count across every worker.

use hedge.allowance;
use hedge.storage;
use A: std.allocator;
use std.allocator.page;
use std.collections.map;
use std.crypto.rand;
use io_error: std.io.error;
use std.net.ip;
use std.sync.atomic;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

pub val NO_SLOT: usize = (-1)::usize;
pub val SHARDS:  usize = 256;
# a per-peer cap of none, as the atomic cap word holds it
val NO_CAP: i64 = -1;

val SLOT_FREE:      u8 = 0;
val SLOT_RESERVED:  u8 = 1;
val SLOT_COMMITTED: u8 = 2;

# the peer key is what a remote chooses, so each table hashes it under a seed
# of its own and a flood of crafted addresses cannot be made to collide. the
# map's hash sees only the key, so the key carries its table's seed
pub rec PeerKey {
    address: ip.Addr;
    seed:    u64;
}

rec Shard {
    lock:   mutex.Mutex;
    counts: map.MapBy[PeerKey, usize];
}

# how many admissions each address holds, across every worker
pub rec Peers {
    cap:    i64;
    seed:   u64;
    shards: [SHARDS]Shard;
    live:   bool;
}

# the caps one kind of admission shares across workers
pub rec Shared {
    pool:  allowance.Pool;
    peers: Peers;
    # a manager made on its own frees the Shared it made
    owned: bool;
}

pub rec LeaseSlot {
    address:    ip.Addr;
    has_peer:   bool;
    generation: u64;
    state:      u8;
}

pub rec Lease {
    index:      usize;
    generation: u64;
}

pub rec Manager {
    allocator: *A.Allocator;
    leases:    storage.Table[LeaseSlot];
    shared:    *Shared;
    share:     allowance.Share;
    # a monotonic lease generation. a compaction zeroes a reused slot, so a
    # per-slot counter could repeat a value a stale lease still holds; a
    # counter that never resets and never wraps (u64) keeps every lease distinct
    lease_generation: u64;
    live:             usize;
    initialized:      bool;
}

pub fun no_lease() Lease {
    ret Lease{index: NO_SLOT, generation: 0};
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun normalize(value: ip.Addr) ip.Addr {
    if (value.is_v6 == 0) { ret value; }
    var mapped: bool  = true;
    var i:      usize = 0;
    for (i < 10) {
        if (value.v6.octets[i] != 0) { mapped = false; }
        i = i + 1;
    }
    if (value.v6.octets[10] != 0xff || value.v6.octets[11] != 0xff) {
        mapped = false;
    }
    if (!mapped) { ret value; }
    var result: ip.Addr;
    result.is_v6 = 0;
    i            = 0;
    for (i < 4) {
        result.v4.octets[i] = value.v6.octets[i + 12];
        i                   = i + 1;
    }
    ret result;
}

fun address_equal(left: ip.Addr, right: ip.Addr) bool {
    if (left.is_v6 != right.is_v6) { ret false; }
    var count: usize = 4;
    var a:     *u8   = ?left.v4.octets[0];
    var b:     *u8   = ?right.v4.octets[0];
    if (left.is_v6 != 0) {
        count = 16;
        a     = ?left.v6.octets[0];
        b     = ?right.v6.octets[0];
    }
    var i: usize = 0;
    for (i < count) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun draw_seed() u64 {
    var value:  u64                 = 0;
    val filled: err[io_error.Error] = rand.fill((?value)::*u8, 8);
    if (sel filled.err) { ret 0x9e3779b97f4a7c15; }
    ret value;
}

fun peer_key(peers: *Peers, address: ip.Addr) PeerKey {
    ret PeerKey{address: address, seed: peers.seed};
}

fun hash_key(key: *PeerKey) u64 {
    val address: *ip.Addr = ?key.address;
    var value:   u64      = key.seed ^ 0xcbf29ce484222325;
    var count:   usize    = 4;
    var octets:  *u8      = ?address.v4.octets[0];
    if (address.is_v6 != 0) {
        count  = 16;
        octets = ?address.v6.octets[0];
    }
    value = (value ^ (address.is_v6::u64)) * 0x100000001b3;
    var i: usize = 0;
    for (i < count) {
        value = (value ^ (octets[i]::u64)) * 0x100000001b3;
        i     = i + 1;
    }
    ret value;
}

fun equal_key(left: *PeerKey, right: *PeerKey) bool {
    ret address_equal(left.address, right.address);
}

fun limit_valid(limit: opt[usize]) bool {
    if (sel limit.some) { ret limit.some != 0; }
    ret true;
}

fun limits_ordered(max_connections: opt[usize],
    max_connections_per_peer: opt[usize]) bool {
    if (sel max_connections.some) {
        if (sel max_connections_per_peer.some) {
            ret max_connections_per_peer.some <= max_connections.some;
        }
    }
    ret true;
}

fun cap_word(limit: opt[usize]) i64 {
    if (sel limit.some) { ret limit.some::i64; }
    ret NO_CAP;
}

fun make_peers(peers: *Peers, a: *A.Allocator, cap: opt[usize]) {
    peers.seed = draw_seed();
    atomic.store(?peers.cap, cap_word(cap));
    var i: usize = 0;
    for (i < SHARDS) {
        peers.shards[i].lock   = mutex.make();
        peers.shards[i].counts = map.init_by[PeerKey, usize](a, hash_key, equal_key);
        i                      = i + 1;
    }
    peers.live = true;
}

fun destroy_peers(peers: *Peers) bool {
    if (!peers.live) { ret true; }
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < SHARDS) {
        val dropped: err[A.Error] = map.dnit_by[PeerKey, usize](?peers.shards[i].counts);
        if (sel dropped.err) { ok = false; }
        i = i + 1;
    }
    peers.live = false;
    ret ok;
}

fun shard_of(peers: *Peers, key: *PeerKey) *Shard {
    ret ?peers.shards[(hash_key(key) % SHARDS::u64)::usize];
}

# one more admission for `address`, or false at its cap or when the count
# cannot be stored
fun count_peer(peers: *Peers, address: ip.Addr) bool {
    var key:   PeerKey = peer_key(peers, address);
    val shard: *Shard  = shard_of(peers, ?key);
    val cap:   i64     = atomic.load(?peers.cap);
    mutex.lock(?shard.lock);
    val found:    opt[*usize] = map.get_by[PeerKey, usize](?shard.counts, ?key);
    var admitted: bool        = true;
    if (sel found.some) {
        if (cap != NO_CAP && (@found.some)::i64 >= cap) { admitted = false; }
        or                                              { @found.some = @found.some + 1; }
    }
    or (cap != NO_CAP && cap < 1) { admitted = false; }
    or {
        val inserted: res[bool, A.Error] = map.insert_by[PeerKey, usize](?shard.counts, key, 1);
        if (sel inserted.err) { admitted = false; }
    }
    mutex.unlock(?shard.lock);
    ret admitted;
}

fun uncount_peer(peers: *Peers, address: ip.Addr) bool {
    var key:   PeerKey = peer_key(peers, address);
    val shard: *Shard  = shard_of(peers, ?key);
    mutex.lock(?shard.lock);
    val found:    opt[*usize] = map.get_by[PeerKey, usize](?shard.counts, ?key);
    var released: bool        = false;
    if (sel found.some) {
        if (@found.some > 1) { @found.some = @found.some - 1; }
        or                   { map.remove_by[PeerKey, usize](?shard.counts, ?key); }
        released = true;
    }
    mutex.unlock(?shard.lock);
    ret released;
}

# addresses holding at least one admission, across every shard
pub fun peers_tracked(shared: *Shared) usize {
    if (shared == nil || !shared.peers.live) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < SHARDS) {
        val shard: *Shard = ?shared.peers.shards[i];
        mutex.lock(?shard.lock);
        count = count + map.length_by[PeerKey, usize](shard.counts);
        mutex.unlock(?shard.lock);
        i = i + 1;
    }
    ret count;
}

# the caps `workers` workers share. `wakers` wakes a worker that waits for the
# global cap, or is nil when one worker admits alone
pub fun make_shared(shared: *Shared, a: *A.Allocator, max_connections: opt[usize],
    max_connections_per_peer: opt[usize], workers: usize, wakers: *allowance.Wakers) bool {
    if (shared == nil || a == nil || !limit_valid(max_connections)
        || !limit_valid(max_connections_per_peer)
        || !limits_ordered(max_connections, max_connections_per_peer)) { ret false; }
    var batch: usize = 1;
    if (sel max_connections.some) {
        batch = allowance.batch_for(max_connections.some, workers, allowance.MAX_BATCH);
    }
    if (!allowance.make_pool(?shared.pool, max_connections, batch, wakers)) { ret false; }
    make_peers(?shared.peers, a, max_connections_per_peer);
    shared.owned = false;
    ret true;
}

# move a shared cap and its per-peer cap, as a reload does once for every
# worker. a cap cannot be added to or removed from a pool made without one
pub fun retune_shared(shared: *Shared, max_connections: opt[usize],
    max_connections_per_peer: opt[usize]) bool {
    if (shared == nil || !limit_valid(max_connections)
        || !limit_valid(max_connections_per_peer)
        || !limits_ordered(max_connections, max_connections_per_peer)) { ret false; }
    if (sel max_connections.some) {
        if (!shared.pool.bounded || !allowance.retune(?shared.pool, max_connections.some)) {
            ret false;
        }
    }
    or (shared.pool.bounded) { ret false; }
    atomic.store(?shared.peers.cap, cap_word(max_connections_per_peer));
    ret true;
}

pub fun destroy_shared(shared: *Shared) bool {
    if (shared == nil) { ret false; }
    ret destroy_peers(?shared.peers);
}

# a manager admitting against caps it alone holds
pub fun make(manager: *Manager, a: *A.Allocator, max_connections: opt[usize],
    max_connections_per_peer: opt[usize]) bool {
    if (manager == nil || manager.initialized || a == nil) { ret false; }
    val made: res[*Shared, A.Error] = A.allocate[Shared](a, 1);
    if (sel made.err) { ret false; }
    if (!make_shared(made.ok, a, max_connections, max_connections_per_peer, 1, nil)) {
        A.deallocate[Shared](a, made.ok, 1);
        ret false;
    }
    made.ok.owned = true;
    if (!join(manager, a, made.ok, 0)) {
        destroy_shared(made.ok);
        A.deallocate[Shared](a, made.ok, 1);
        ret false;
    }
    ret true;
}

# worker `worker`'s manager, admitting against caps every worker shares
pub fun join(manager: *Manager, a: *A.Allocator, shared: *Shared, worker: usize) bool {
    if (manager == nil || manager.initialized || a == nil || shared == nil) { ret false; }
    if (!storage.make_table[LeaseSlot](?manager.leases, a))                 { ret false; }
    manager.allocator        = a;
    manager.shared           = shared;
    manager.lease_generation = 0;
    manager.live             = 0;
    allowance.join(?manager.share, ?shared.pool, worker);
    manager.initialized = true;
    ret true;
}

# a reload may move the policy caps. storage is not sized from them, so the
# only rule is that a lowered cap stops new admissions rather than evicting
# leases already held above it
pub fun retune(manager: *Manager, max_connections: opt[usize],
    max_connections_per_peer: opt[usize]) bool {
    if (manager == nil || !manager.initialized) { ret false; }
    ret retune_shared(manager.shared, max_connections, max_connections_per_peer);
}

pub fun destroy(manager: *Manager) bool {
    if (manager == nil || !manager.initialized || manager.live != 0) { ret false; }
    allowance.leave(?manager.share);
    var ok:     bool    = storage.destroy_table[LeaseSlot](?manager.leases);
    val shared: *Shared = manager.shared;
    if (shared.owned) {
        if (!destroy_shared(shared)) { ok = false; }
        A.deallocate[Shared](manager.allocator, shared, 1);
    }
    manager.initialized = false;
    ret ok;
}

fun lease_at(manager: *Manager, index: usize) *LeaseSlot {
    ret storage.table_at[LeaseSlot](?manager.leases, index);
}

# whether the global cap still allows a connection on this worker. growth or
# the peer's cap may still refuse one, which is only known at the claim
pub fun available(manager: *Manager) bool {
    if (manager == nil || !manager.initialized) { ret false; }
    ret allowance.room(?manager.share);
}

fun allocate_lease(manager: *Manager, peer: *ip.Endpoint,
    state: u8, output: *Lease) bool {
    if (output == nil) { ret false; }
    @output = no_lease();
    if (manager == nil || !manager.initialized
        || (state != SLOT_RESERVED && state != SLOT_COMMITTED)) { ret false; }
    var address: ip.Addr;
    if (peer != nil) {
        address = normalize(peer.addr);
        if (!count_peer(?manager.shared.peers, address)) { ret false; }
    }
    if (!allowance.take(?manager.share, 1)) {
        if (peer != nil) { uncount_peer(?manager.shared.peers, address); }
        ret false;
    }
    val index: usize = storage.table_claim[LeaseSlot](?manager.leases);
    if (index == NO_SLOT) {
        allowance.give(?manager.share, 1);
        if (peer != nil) { uncount_peer(?manager.shared.peers, address); }
        ret false;
    }
    val slot: *LeaseSlot = lease_at(manager, index);
    manager.lease_generation = next_generation(manager.lease_generation);
    slot.generation          = manager.lease_generation;
    slot.has_peer            = peer != nil;
    slot.address             = address;
    slot.state               = state;
    manager.live             = manager.live + 1;
    @output                  = Lease{index: index, generation: slot.generation};
    ret true;
}

pub fun reserve(manager: *Manager, peer: *ip.Endpoint,
    output: *Lease) bool {
    ret allocate_lease(manager, peer, SLOT_RESERVED, output);
}

pub fun acquire(manager: *Manager, peer: *ip.Endpoint,
    output: *Lease) bool {
    ret allocate_lease(manager, peer, SLOT_COMMITTED, output);
}

fun lease_slot(manager: *Manager, lease: Lease) *LeaseSlot {
    if (manager == nil || !manager.initialized || lease.generation == 0
        || lease.index >= storage.table_capacity[LeaseSlot](?manager.leases)) { ret nil; }
    val slot: *LeaseSlot = lease_at(manager, lease.index);
    if (slot == nil || slot.state == SLOT_FREE
        || slot.generation != lease.generation) { ret nil; }
    ret slot;
}

pub fun commit(manager: *Manager, lease: Lease) bool {
    val slot: *LeaseSlot = lease_slot(manager, lease);
    if (slot == nil || slot.state != SLOT_RESERVED) { ret false; }
    slot.state = SLOT_COMMITTED;
    ret true;
}

pub fun release(manager: *Manager, lease: Lease) bool {
    val slot: *LeaseSlot = lease_slot(manager, lease);
    if (slot == nil || manager.live == 0)                                    { ret false; }
    if (slot.has_peer && !uncount_peer(?manager.shared.peers, slot.address)) { ret false; }
    allowance.give(?manager.share, 1);
    manager.live  = manager.live - 1;
    slot.state    = SLOT_FREE;
    slot.has_peer = false;
    ret storage.table_release[LeaseSlot](?manager.leases, lease.index);
}

pub fun in_use(manager: *Manager) usize {
    if (manager == nil || !manager.initialized) { ret 0; }
    ret manager.live;
}

fun capped(value: usize) opt[usize] {
    ret opt[usize].some{value};
}

fun uncapped() opt[usize] {
    ret opt[usize].none{};
}

test "hedge.admission: tcp then quic share the exact global cap" {
    var a: A.Allocator;
    page.make(?a);
    var manager: Manager;
    if (!make(?manager, ?a, capped(2), capped(2))) { ret 1; }
    val endpoint: ip.Endpoint = ip.endpoint(192, 0, 2, 1, 1000);
    var tcp:      Lease;
    var quic:     Lease;
    var refused:  Lease;
    if (!acquire(?manager, ?endpoint, ?tcp)
        || !acquire(?manager, ?endpoint, ?quic)
        || acquire(?manager, ?endpoint, ?refused) || in_use(?manager) != 2) {
        ret 2;
    }
    if (!release(?manager, tcp) || !release(?manager, quic)
        || in_use(?manager) != 0) { ret 3; }
    if (!destroy(?manager)) { ret 4; }
    ret 0;
}

test "hedge.admission: quic then tcp share normalized peer limits" {
    var a: A.Allocator;
    page.make(?a);
    var manager: Manager;
    if (!make(?manager, ?a, capped(2), capped(1))) { ret 1; }
    var mapped: ip.Endpoint;
    mapped.addr.is_v6 = 1;
    var i: usize = 0;
    for (i < 16) {
        mapped.addr.v6.octets[i] = 0;
        i                        = i + 1;
    }
    mapped.addr.v6.octets[10] = 0xff;
    mapped.addr.v6.octets[11] = 0xff;
    mapped.addr.v6.octets[12] = 192;
    mapped.addr.v6.octets[13] = 0;
    mapped.addr.v6.octets[14] = 2;
    mapped.addr.v6.octets[15] = 1;
    val native: ip.Endpoint = ip.endpoint(192, 0, 2, 1, 2000);
    var quic:   Lease;
    var tcp:    Lease;
    if (!acquire(?manager, ?mapped, ?quic)
        || acquire(?manager, ?native, ?tcp) || in_use(?manager) != 1) {
        ret 2;
    }
    if (!release(?manager, quic) || !acquire(?manager, ?native, ?tcp)
        || !release(?manager, tcp)) { ret 3; }
    if (!destroy(?manager)) { ret 4; }
    ret 0;
}

test "hedge.admission: an absent cap admits past any preallocated ceiling" {
    var a: A.Allocator;
    page.make(?a);
    var manager: Manager;
    if (!make(?manager, ?a, uncapped(), uncapped())) { ret 1; }
    # past the first chunk of both tables, which is where a fixed pool stopped
    val count:  usize = storage.FIRST_CHUNK * 4 + 1;
    var leases: [storage.FIRST_CHUNK * 4 + 1]Lease;
    var i:      usize = 0;
    for (i < count) {
        val endpoint: ip.Endpoint = ip.endpoint(10, 0,
            (i / 256)::u8, (i % 256)::u8, 1000);
        if (!available(?manager)
            || !acquire(?manager, ?endpoint, ?leases[i])) { ret 2; }
        i = i + 1;
    }
    if (in_use(?manager) != count) { ret 3; }
    i = 0;
    for (i < count) {
        if (!release(?manager, leases[i])) { ret 4; }
        i = i + 1;
    }
    if (in_use(?manager) != 0 || !destroy(?manager)) { ret 5; }
    ret 0;
}

test "hedge.admission: a configured cap is still refused at its exact number" {
    var a: A.Allocator;
    page.make(?a);
    var manager: Manager;
    # a cap above the first chunk proves the refusal is the policy, not the table
    val cap:            usize = storage.FIRST_CHUNK + 3;
    var manager_leases: [storage.FIRST_CHUNK + 3]Lease;
    if (!make(?manager, ?a, capped(cap), uncapped())) { ret 1; }
    var i: usize = 0;
    for (i < cap) {
        val endpoint: ip.Endpoint = ip.endpoint(10, 0,
            (i / 256)::u8, (i % 256)::u8, 1000);
        if (!acquire(?manager, ?endpoint, ?manager_leases[i])) { ret 2; }
        i = i + 1;
    }
    val over:    ip.Endpoint = ip.endpoint(10, 1, 1, 1, 1000);
    var refused: Lease;
    if (available(?manager) || acquire(?manager, ?over, ?refused)
        || in_use(?manager) != cap) { ret 3; }
    if (!release(?manager, manager_leases[0]))                       { ret 4; }
    if (!available(?manager) || !acquire(?manager, ?over, ?refused)) { ret 5; }
    ret 0;
}

test "hedge.admission: a peer is forgotten once its last lease is released" {
    var a: A.Allocator;
    page.make(?a);
    var manager: Manager;
    if (!make(?manager, ?a, uncapped(), capped(2))) { ret 1; }
    val endpoint: ip.Endpoint = ip.endpoint(198, 51, 100, 7, 443);
    var first:    Lease;
    var second:   Lease;
    var refused:  Lease;
    if (!acquire(?manager, ?endpoint, ?first)
        || !acquire(?manager, ?endpoint, ?second)
        || acquire(?manager, ?endpoint, ?refused)) { ret 2; }
    if (peers_tracked(manager.shared) != 1)                      { ret 3; }
    if (!release(?manager, first) || !release(?manager, second)) { ret 4; }
    # the peer is forgotten, and counted afresh on its next claim
    if (peers_tracked(manager.shared) != 0) { ret 5; }
    if (!acquire(?manager, ?endpoint, ?first)
        || peers_tracked(manager.shared) != 1) {
        ret 6;
    }
    if (!release(?manager, first) || !destroy(?manager)) { ret 7; }
    ret 0;
}

test "hedge.admission: a lease into a compacted-away chunk is refused after regrow" {
    var a: A.Allocator;
    page.make(?a);
    var manager: Manager;
    if (!make(?manager, ?a, uncapped(), uncapped())) { ret 1; }
    # fill lease chunk 0 and open chunk 1 so a release can drop a trailing chunk
    var leases: [storage.FIRST_CHUNK + 1]Lease;
    var i:      usize = 0;
    for (i <= storage.FIRST_CHUNK) {
        val endpoint: ip.Endpoint = ip.endpoint(10, 0,
            (i / 256)::u8, (i % 256)::u8, 443);
        if (!acquire(?manager, ?endpoint, ?leases[i])) { ret 2; }
        i = i + 1;
    }
    val high: usize = storage.FIRST_CHUNK;
    if (leases[high].index != high) { ret 3; }
    val stale:      Lease = leases[high];
    val cap_before: usize = storage.table_capacity[LeaseSlot](?manager.leases);
    if (!release(?manager, stale))                                        { ret 4; }
    if (storage.table_capacity[LeaseSlot](?manager.leases) >= cap_before) { ret 5; }
    # the same index returns as a zeroed slot in a regrown chunk with a fresh, and
    # strictly greater, generation from the process-global counter
    var fresh:     Lease;
    val endpoint2: ip.Endpoint = ip.endpoint(10, 9, 9, 9, 443);
    if (!acquire(?manager, ?endpoint2, ?fresh)) { ret 6; }
    if (fresh.index != high)                    { ret 7; }
    if (fresh.generation <= stale.generation)   { ret 8; }
    # the stale lease resolves to nothing, so neither commit nor release accepts it
    if (commit(?manager, stale))  { ret 9; }
    if (release(?manager, stale)) { ret 10; }
    # release everything still held so the manager can be destroyed
    if (!release(?manager, fresh)) { ret 11; }
    i = 0;
    for (i < storage.FIRST_CHUNK) {
        if (!release(?manager, leases[i])) { ret 12; }
        i = i + 1;
    }
    if (!destroy(?manager)) { ret 13; }
    ret 0;
}

# the caps are the process's: two workers' managers joined to one Shared
# admit against one global cap and one per-peer count, and each table draws a
# seed of its own
test "hedge.admission: workers joined to one Shared share its caps" {
    var a: A.Allocator;
    page.make(?a);
    var wakers: allowance.Wakers;
    var shared: Shared;
    if (!allowance.make_wakers(?wakers, 2)
        || !make_shared(?shared, ?a, capped(3), capped(2), 2, ?wakers)) { ret 1; }
    var first:  Manager;
    var second: Manager;
    if (!join(?first, ?a, ?shared, 0) || !join(?second, ?a, ?shared, 1)) { ret 2; }
    val peer:    ip.Endpoint = ip.endpoint(192, 0, 2, 7, 443);
    val other:   ip.Endpoint = ip.endpoint(192, 0, 2, 8, 443);
    var leases:  [3]Lease;
    var refused: Lease;
    # the peer's cap binds across both workers
    if (!acquire(?first, ?peer, ?leases[0]) || !acquire(?second, ?peer, ?leases[1])
        || acquire(?first, ?peer, ?refused) || acquire(?second, ?peer, ?refused)) { ret 3; }
    # and so does the global cap
    if (!acquire(?second, ?other, ?leases[2]) || acquire(?first, ?other, ?refused)
        || in_use(?first) + in_use(?second) != 3) { ret 4; }
    # a release leaves the unit in the releasing worker's share: another
    # worker is refused, and the refusal counted, until the share gives it back
    if (!release(?second, leases[1]) || acquire(?first, ?peer, ?refused)
        || allowance.refusals(?shared.pool) == 0) { ret 5; }
    allowance.leave(?second.share);
    if (!acquire(?first, ?peer, ?refused)) { ret 6; }
    if (!release(?first, leases[0]) || !release(?first, refused)
        || !release(?second, leases[2]) || peers_tracked(?shared) != 0) { ret 10; }
    var mine: Shared;
    if (!make_shared(?mine, ?a, uncapped(), capped(1), 1, nil)) { ret 7; }
    var left:  PeerKey = peer_key(?shared.peers, peer.addr);
    var right: PeerKey = peer_key(?mine.peers, peer.addr);
    if (shared.peers.seed == mine.peers.seed || hash_key(?left) == hash_key(?right)
        || !equal_key(?left, ?right)) { ret 8; }
    if (!destroy(?first) || !destroy(?second) || !destroy_shared(?shared)
        || !destroy_shared(?mine)) { ret 9; }
    ret 0;
}
