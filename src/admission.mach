# process-wide connection admission

use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val NO_SLOT: usize = (-1)::usize;

val SLOT_FREE:      u8 = 0;
val SLOT_RESERVED:  u8 = 1;
val SLOT_COMMITTED: u8 = 2;

pub rec PeerSlot {
    address: ip.Addr;
    count:   usize;
    live:    bool;
}

pub rec LeaseSlot {
    peer:       usize;
    next_free:  usize;
    generation: u64;
    state:      u8;
}

pub rec Storage {
    peers:          *PeerSlot;
    peer_capacity:  usize;
    leases:         *LeaseSlot;
    lease_capacity: usize;
}

pub rec Lease {
    index:      usize;
    generation: u64;
}

pub rec Manager {
    storage:                  Storage;
    max_connections:          usize;
    max_connections_per_peer: usize;
    free_head:                usize;
    live:                     usize;
    initialized:              bool;
}

pub fun no_lease() Lease {
    ret Lease{index: NO_SLOT, generation: 0};
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun normalize(value: ip.Addr) ip.Addr {
    if (value.is_v6 == 0) { ret value; }
    var mapped: bool  = true;
    var i:      usize = 0;
    for (i < 10) {
        if (value.v6.octets[i] != 0) { mapped = false; }
        i = i + 1;
    }
    if (value.v6.octets[10] != 0xff || value.v6.octets[11] != 0xff) {
        mapped = false;
    }
    if (!mapped) { ret value; }
    var result: ip.Addr;
    result.is_v6 = 0;
    i            = 0;
    for (i < 4) {
        result.v4.octets[i] = value.v6.octets[i + 12];
        i                   = i + 1;
    }
    ret result;
}

fun address_equal(left: ip.Addr, right: ip.Addr) bool {
    if (left.is_v6 != right.is_v6) { ret false; }
    var count: usize = 4;
    var a:     *u8   = ?left.v4.octets[0];
    var b:     *u8   = ?right.v4.octets[0];
    if (left.is_v6 != 0) {
        count = 16;
        a     = ?left.v6.octets[0];
        b     = ?right.v6.octets[0];
    }
    var i: usize = 0;
    for (i < count) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun find_peer(manager: *Manager, address: ip.Addr) usize {
    var i: usize = 0;
    for (i < manager.storage.peer_capacity) {
        val slot: *PeerSlot = ?manager.storage.peers[i];
        if (slot.live && address_equal(slot.address, address)) { ret i; }
        i = i + 1;
    }
    ret NO_SLOT;
}

fun free_peer(manager: *Manager) usize {
    var i: usize = 0;
    for (i < manager.storage.peer_capacity) {
        if (!manager.storage.peers[i].live) { ret i; }
        i = i + 1;
    }
    ret NO_SLOT;
}

pub fun make(manager: *Manager, storage: Storage, max_connections: usize,
    max_connections_per_peer: usize) bool {
    if (manager == nil || manager.initialized || max_connections == 0
        || max_connections_per_peer == 0
        || max_connections_per_peer > max_connections || storage.peers == nil
        || storage.peer_capacity < max_connections || storage.leases == nil
        || storage.lease_capacity < max_connections) { ret false; }
    manager.storage                  = storage;
    manager.max_connections          = max_connections;
    manager.max_connections_per_peer = max_connections_per_peer;
    manager.free_head                = 0;
    manager.live                     = 0;
    var i: usize = 0;
    for (i < storage.peer_capacity) {
        storage.peers[i].live  = false;
        storage.peers[i].count = 0;
        i                      = i + 1;
    }
    i = 0;
    for (i < storage.lease_capacity) {
        storage.leases[i].state      = SLOT_FREE;
        storage.leases[i].generation = 0;
        storage.leases[i].peer       = NO_SLOT;
        storage.leases[i].next_free  = i + 1;
        if (i + 1 == storage.lease_capacity) {
            storage.leases[i].next_free = NO_SLOT;
        }
        i = i + 1;
    }
    manager.initialized = true;
    ret true;
}

pub fun available(manager: *Manager) bool {
    ret manager != nil && manager.initialized
        && manager.live < manager.max_connections
        && manager.free_head != NO_SLOT;
}

fun allocate_lease(manager: *Manager, peer: *ip.Endpoint,
    state: u8, output: *Lease) bool {
    if (output == nil) { ret false; }
    @output = no_lease();
    if (!available(manager)
        || (state != SLOT_RESERVED && state != SLOT_COMMITTED)) { ret false; }
    var peer_index: usize = NO_SLOT;
    if (peer != nil) {
        val address: ip.Addr = normalize(peer.addr);
        peer_index = find_peer(manager, address);
        if (peer_index == NO_SLOT) {
            peer_index = free_peer(manager);
            if (peer_index == NO_SLOT) { ret false; }
            manager.storage.peers[peer_index].address = address;
            manager.storage.peers[peer_index].count   = 0;
            manager.storage.peers[peer_index].live    = true;
        }
        if (manager.storage.peers[peer_index].count
            >= manager.max_connections_per_peer) { ret false; }
    }
    val index: usize      = manager.free_head;
    val slot:  *LeaseSlot = ?manager.storage.leases[index];
    manager.free_head = slot.next_free;
    slot.next_free    = NO_SLOT;
    slot.generation   = next_generation(slot.generation);
    slot.peer         = peer_index;
    slot.state        = state;
    manager.live      = manager.live + 1;
    if (peer_index != NO_SLOT) {
        manager.storage.peers[peer_index].count =
            manager.storage.peers[peer_index].count + 1;
    }
    @output = Lease{index: index, generation: slot.generation};
    ret true;
}

pub fun reserve(manager: *Manager, peer: *ip.Endpoint,
    output: *Lease) bool {
    ret allocate_lease(manager, peer, SLOT_RESERVED, output);
}

pub fun acquire(manager: *Manager, peer: *ip.Endpoint,
    output: *Lease) bool {
    ret allocate_lease(manager, peer, SLOT_COMMITTED, output);
}

fun lease_slot(manager: *Manager, lease: Lease) *LeaseSlot {
    if (manager == nil || !manager.initialized || lease.generation == 0
        || lease.index >= manager.storage.lease_capacity) { ret nil; }
    val slot: *LeaseSlot = ?manager.storage.leases[lease.index];
    if (slot.state == SLOT_FREE || slot.generation != lease.generation) {
        ret nil;
    }
    ret slot;
}

pub fun commit(manager: *Manager, lease: Lease) bool {
    val slot: *LeaseSlot = lease_slot(manager, lease);
    if (slot == nil || slot.state != SLOT_RESERVED) { ret false; }
    slot.state = SLOT_COMMITTED;
    ret true;
}

pub fun release(manager: *Manager, lease: Lease) bool {
    val slot: *LeaseSlot = lease_slot(manager, lease);
    if (slot == nil || manager.live == 0) { ret false; }
    var peer: *PeerSlot = nil;
    if (slot.peer != NO_SLOT) {
        if (slot.peer >= manager.storage.peer_capacity) { ret false; }
        peer = ?manager.storage.peers[slot.peer];
        if (!peer.live || peer.count == 0) { ret false; }
    }
    if (peer != nil) {
        peer.count = peer.count - 1;
        if (peer.count == 0) { peer.live = false; }
    }
    manager.live      = manager.live - 1;
    slot.state        = SLOT_FREE;
    slot.peer         = NO_SLOT;
    slot.next_free    = manager.free_head;
    manager.free_head = lease.index;
    ret true;
}

pub fun in_use(manager: *Manager) usize {
    if (manager == nil || !manager.initialized) { ret 0; }
    ret manager.live;
}

test "hedge.admission: tcp then quic share the exact global cap" {
    var peers:   [2]PeerSlot;
    var slots:   [2]LeaseSlot;
    var manager: Manager;
    if (!make(?manager, Storage{peers: ?peers[0], peer_capacity: 2,
        leases: ?slots[0], lease_capacity: 2}, 2, 2)) { ret 1; }
    val endpoint: ip.Endpoint = ip.endpoint(192, 0, 2, 1, 1000);
    var tcp:      Lease;
    var quic:     Lease;
    var refused:  Lease;
    if (!acquire(?manager, ?endpoint, ?tcp)
        || !acquire(?manager, ?endpoint, ?quic)
        || acquire(?manager, ?endpoint, ?refused) || in_use(?manager) != 2) {
        ret 2;
    }
    if (!release(?manager, tcp) || !release(?manager, quic)
        || in_use(?manager) != 0) { ret 3; }
    ret 0;
}

test "hedge.admission: quic then tcp share normalized peer limits" {
    var peers:   [2]PeerSlot;
    var slots:   [2]LeaseSlot;
    var manager: Manager;
    if (!make(?manager, Storage{peers: ?peers[0], peer_capacity: 2,
        leases: ?slots[0], lease_capacity: 2}, 2, 1)) { ret 1; }
    var mapped: ip.Endpoint;
    mapped.addr.is_v6 = 1;
    var i: usize = 0;
    for (i < 16) {
        mapped.addr.v6.octets[i] = 0;
        i                        = i + 1;
    }
    mapped.addr.v6.octets[10] = 0xff;
    mapped.addr.v6.octets[11] = 0xff;
    mapped.addr.v6.octets[12] = 192;
    mapped.addr.v6.octets[13] = 0;
    mapped.addr.v6.octets[14] = 2;
    mapped.addr.v6.octets[15] = 1;
    val native: ip.Endpoint = ip.endpoint(192, 0, 2, 1, 2000);
    var quic:   Lease;
    var tcp:    Lease;
    if (!acquire(?manager, ?mapped, ?quic)
        || acquire(?manager, ?native, ?tcp) || in_use(?manager) != 1) {
        ret 2;
    }
    if (!release(?manager, quic) || !acquire(?manager, ?native, ?tcp)
        || !release(?manager, tcp)) { ret 3; }
    ret 0;
}
