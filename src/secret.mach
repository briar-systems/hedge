# bounded runtime secret resolution: the secrets hosted code borrows, and the
# ones hedge holds for itself
#
# the configuration declares secrets once, in `[secret]` tables, and grants
# each hosted application the ones it may borrow, under names of its own, in
# `[application.<name>.secrets]`. every generation resolves its grants into
# secret-welded storage this module owns, and a reload resolves them again, so
# a secret rotated at its source reaches hosted code with the next reload. a
# borrow reads the generation the process has published, for one application
# only, and hands the value to the borrower's callback for the length of the
# call. a secret hedge holds for itself, such as the administration credential,
# resolves through the same providers into its own welded allocation and is
# only ever compared, in constant time, against a public candidate.

use crypto.contracts;
use hedge.config.schema;
use hedge.dispatch.call;
use hedge.service;
use http.core.exchange;
use std.crypto.ct;
use std.filesystem;
use io_error:      std.io.error;
use secret_memory: std.memory.secret;
use std.process.env;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view;

fun clear(output: *u8, capacity: usize) {
    if (output == nil) { ret; }
    var i: usize = 0;
    for (i < capacity) {
        output[i] = 0;
        i         = i + 1;
    }
}

# the value's length, or -1 when the variable is unset or cannot be read
fun read_env(key: str, output: *u8, capacity: usize) i64 {
    val got: res[opt[usize], env.EnvError] = env.get(key, output, capacity);
    if (sel got.err)     { ret -1; }
    if (sel got.ok.none) { ret -1; }
    ret got.ok.some::i64;
}

# the longest secret hosted code may borrow
pub val MAX_SECRET_BYTES: usize = 4096;
# the longest name hosted code borrows a secret by
pub val MAX_NAME_BYTES: usize = schema.MAX_GRANT_NAME_BYTES;
# the providers registered at once, process-wide
pub val MAX_PROVIDERS: usize = 8;

pub def Borrow: u8;
pub val BORROW_OK:      Borrow = 1;
pub val BORROW_MISSING: Borrow = 2;
pub val BORROW_REFUSED: Borrow = 3;
pub val BORROW_INVALID: Borrow = 4;

# the secret is valid only for the call and is cleared after it
pub def UseFun: fun(ptr, contracts.SecretBytes) bool;

# writes the secret a configured `os` or `application` provider names by `key`
# into secret `output`, and returns its length, or -1 when it has none. a length
# of `capacity` or more is refused as too large
pub def ProvideFun: fun(ptr, str, str, *^u8, usize) i64;

# a provider is secret welded through its callback type, so it never erases to
# ptr: only this module's table holds it, and the embedding program hands hedge
# the public `Providers` handle `register_provider` returns for it
pub rec Provider {
    ctx:     ptr;
    provide: ProvideFun;
}

# an opaque public name for one registered provider. it holds no pointer
pub rec Providers {
    slot:       u32;
    generation: u32;
}

pub fun no_providers() Providers {
    ret Providers{slot: 0, generation: 0};
}

# the application a borrow reads the grants of
pub rec Source {
    application: *service.Application;
}

# the grants of one generation: each value in its own welded allocation, at
# the index of its application and grant in `graph`
rec Bank {
    graph:      *schema.Graph;
    generation: u64;
    data:       [schema.MAX_APPLICATIONS][schema.MAX_GRANTS]*^u8;
    size:       [schema.MAX_APPLICATIONS][schema.MAX_GRANTS]usize;
}

var providers:        [MAX_PROVIDERS]*Provider;
var provider_gens:    [MAX_PROVIDERS]u32;
var provider_used:    [MAX_PROVIDERS]bool;
var provider_resolve: [MAX_PROVIDERS]usize;
var provider_lock:    mutex.Mutex = 0;

# the published generation's bank, and the one a reload stages
var banks:        [2]Bank;
var current_bank: usize       = 0;
var staged:       bool        = false;
var store_open:   bool        = false;
var store_source: Providers;
var store_lock:   mutex.Mutex = 0;

# registers a provider the embedding program keeps live and unchanged until it
# unregisters it, and names it in `output`
pub fun register_provider(provider: *Provider, output: *Providers) bool {
    if (provider == nil || provider.provide == nil || output == nil) { ret false; }
    mutex.lock(?provider_lock);
    var i: usize = 0;
    for (i < MAX_PROVIDERS) {
        if (!provider_used[i] && provider_gens[i] != 4294967295) {
            provider_gens[i]    = provider_gens[i] + 1;
            providers[i]        = provider;
            provider_used[i]    = true;
            provider_resolve[i] = 0;
            @output             = Providers{slot: i::u32, generation: provider_gens[i]};
            mutex.unlock(?provider_lock);
            ret true;
        }
        i = i + 1;
    }
    mutex.unlock(?provider_lock);
    ret false;
}

fun provider_live(source: Providers) bool {
    if (source.generation == 0 || source.slot::usize >= MAX_PROVIDERS) { ret false; }
    ret provider_used[source.slot::usize]
        && provider_gens[source.slot::usize] == source.generation;
}

# refused while a resolution through it is in flight
pub fun unregister_provider(source: Providers) bool {
    mutex.lock(?provider_lock);
    if (!provider_live(source) || provider_resolve[source.slot::usize] != 0) {
        mutex.unlock(?provider_lock);
        ret false;
    }
    providers[source.slot::usize]     = nil;
    provider_used[source.slot::usize] = false;
    mutex.unlock(?provider_lock);
    ret true;
}

fun provide(source: Providers, provider: str, key: str, output: *^u8, capacity: usize) i64 {
    mutex.lock(?provider_lock);
    if (!provider_live(source)) {
        mutex.unlock(?provider_lock);
        ret -1;
    }
    val slot:  usize     = source.slot::usize;
    val entry: *Provider = providers[slot];
    provider_resolve[slot] = provider_resolve[slot] + 1;
    mutex.unlock(?provider_lock);
    val length: i64 = entry.provide(entry.ctx, provider, key, output, capacity);
    mutex.lock(?provider_lock);
    provider_resolve[slot] = provider_resolve[slot] - 1;
    mutex.unlock(?provider_lock);
    ret length;
}

# names the registered application `name` for `borrow`
pub fun source(registry: *service.Applications, name: str, output: *Source) bool {
    if (registry == nil || name == nil || output == nil) { ret false; }
    val found: *service.Application = service.find_application(registry, name);
    if (found == nil) { ret false; }
    @output = Source{application: found};
    ret true;
}

# printable, without spaces, and at most `MAX_NAME_BYTES`
pub fun name_valid(name: view.View) bool {
    if (name.data == nil || name.len == 0 || name.len > MAX_NAME_BYTES) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] < 0x21 || name.data[i] > 0x7e) { ret false; }
        i = i + 1;
    }
    ret true;
}

# where `name`'s section sits in `graph`, or `MAX_APPLICATIONS` when it has none
fun application_index(graph: *schema.Graph, name: str) usize {
    if (graph == nil || name == nil) { ret schema.MAX_APPLICATIONS; }
    var i: usize = 0;
    for (i < graph.application_count) {
        if (schema.text_equals(?graph.applications[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret schema.MAX_APPLICATIONS;
}

fun text_is(text: *schema.Text, name: view.View) bool {
    if (text.len != name.len) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (text.data[i] != name.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the secret `name` granted to `source`'s application, for the length of one
# call to `use`. it is copied from the published generation into secret scratch
# storage, which is cleared once `use` returns, so a reload never pulls a value
# out from under a borrower. any thread may borrow
pub fun borrow(source: Source, name: view.View, use: UseFun, use_ctx: ptr) Borrow {
    if (source.application == nil || !name_valid(name) || use == nil) {
        ret BORROW_INVALID;
    }
    var scratch: [MAX_SECRET_BYTES]^u8;
    var length:  usize = 0;
    var found:   bool  = false;
    mutex.lock(?store_lock);
    if (!store_open) {
        mutex.unlock(?store_lock);
        ret BORROW_INVALID;
    }
    val bank:  *Bank = ?banks[current_bank];
    val index: usize = application_index(bank.graph, source.application.name);
    if (index < schema.MAX_APPLICATIONS) {
        val application: *schema.Application = ?bank.graph.applications[index];
        var g:           usize               = 0;
        for (g < application.grant_count && !found) {
            if (text_is(?application.grants[g].name, name)) {
                length = bank.size[index][g];
                val data: *^u8  = bank.data[index][g];
                var i:    usize = 0;
                for (i < length) {
                    scratch[i] = data[i];
                    i          = i + 1;
                }
                found = true;
            }
            g = g + 1;
        }
    }
    mutex.unlock(?store_lock);
    if (!found) { ret BORROW_MISSING; }
    var status: Borrow = BORROW_OK;
    if (!use(use_ctx, contracts.SecretBytes{data: ?scratch[0], len: length})) {
        status = BORROW_REFUSED;
    }
    ct.zeroize(?scratch[0], MAX_SECRET_BYTES);
    ret status;
}

fun weld(output: *^u8, length: usize, data: **^u8, size: *usize) bool {
    val stored: *^u8 = secret_memory.allocate(length);
    if (stored == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        stored[i] = output[i];
        i         = i + 1;
    }
    @data = stored;
    @size = length;
    ret true;
}

# resolves one declared secret into its own welded allocation, never through
# public memory except an environment variable, which the process holds in
# public memory already
fun resolve_welded(configured: *schema.Secret, source: Providers, data: **^u8,
    size: *usize) bool {
    val provider: str = schema.text(?configured.provider);
    val key:      str = schema.text(?configured.key);
    if (str_equals(provider, "file")) {
        val read: res[filesystem.SecretBytes, filesystem.FsError] = filesystem.read_secret(key);
        if (sel read.err) { ret false; }
        val bytes: filesystem.SecretBytes = read.ok;
        if (bytes.size == 0 || bytes.size > MAX_SECRET_BYTES) {
            if (bytes.data != nil) { secret_memory.deallocate(bytes.data, bytes.size); }
            ret false;
        }
        @data = bytes.data;
        @size = bytes.size;
        ret true;
    }
    var scratch: [MAX_SECRET_BYTES + 1]^u8;
    var length:  i64 = -1;
    if (str_equals(provider, "env")) {
        var public: [MAX_SECRET_BYTES + 1]u8;
        length = read_env(key, ?public[0], MAX_SECRET_BYTES + 1);
        if (length > 0 && length::usize <= MAX_SECRET_BYTES) {
            var i: usize = 0;
            for (i < length::usize) {
                scratch[i] = public[i];
                i          = i + 1;
            }
        }
        clear(?public[0], MAX_SECRET_BYTES + 1);
    }
    or {
        length = provide(source, provider, key, ?scratch[0], MAX_SECRET_BYTES + 1);
    }
    val ok: bool = length > 0 && length::usize <= MAX_SECRET_BYTES
        && weld(?scratch[0], length::usize, data, size);
    ct.zeroize(?scratch[0], MAX_SECRET_BYTES + 1);
    ret ok;
}

fun release_bank(bank: *Bank) {
    var a: usize = 0;
    for (a < schema.MAX_APPLICATIONS) {
        var g: usize = 0;
        for (g < schema.MAX_GRANTS) {
            if (bank.data[a][g] != nil) {
                secret_memory.deallocate(bank.data[a][g], bank.size[a][g]);
            }
            bank.data[a][g] = nil;
            bank.size[a][g] = 0;
            g               = g + 1;
        }
        a = a + 1;
    }
    bank.graph      = nil;
    bank.generation = 0;
}

# resolves every grant of `configured` into `bank`, or says why it could not.
# a section for an application `registry` does not hold is refused, since
# nothing could borrow through it
fun fill_bank(bank: *Bank, configured: *schema.Graph,
    registry: *service.Applications, generation: u64, source: Providers) str {
    release_bank(bank);
    var a: usize = 0;
    for (a < configured.application_count) {
        val application: *schema.Application = ?configured.applications[a];
        if (registry == nil
            || service.find_application(registry, schema.text(?application.name)) == nil) {
            release_bank(bank);
            ret "an application section names no registered application";
        }
        var g: usize = 0;
        for (g < application.grant_count) {
            val declared: *schema.Secret = schema.find_secret(configured,
                schema.text(?application.grants[g].secret));
            if (declared == nil || !resolve_welded(declared, source,
                ?bank.data[a][g], ?bank.size[a][g])) {
                release_bank(bank);
                ret "an application's secret could not be resolved";
            }
            g = g + 1;
        }
        a = a + 1;
    }
    bank.graph      = configured;
    bank.generation = generation;
    ret nil;
}

# resolves the first generation's grants and opens borrowing. `source` names
# the provider for `os` and `application` secrets, and serves every later
# generation too. nil, or why it could not
pub fun open_store(configured: *schema.Graph, registry: *service.Applications,
    generation: u64, source: Providers) str {
    if (configured == nil || generation == 0) { ret "secret store input is invalid"; }
    mutex.lock(?store_lock);
    val was_open: bool = store_open;
    mutex.unlock(?store_lock);
    if (was_open) { ret "secret store is already open"; }
    var bank: Bank;
    store_source = source;
    val failed: str = fill_bank(?bank, configured, registry, generation, source);
    if (failed != nil) { ret failed; }
    mutex.lock(?store_lock);
    banks[0]     = bank;
    current_bank = 0;
    staged       = false;
    store_open   = true;
    mutex.unlock(?store_lock);
    ret nil;
}

# resolves a reload's grants beside the published ones, which borrows keep
# reading until `publish_store`. nil, or why it could not
pub fun stage_store(configured: *schema.Graph, registry: *service.Applications,
    generation: u64) str {
    if (configured == nil || generation == 0) { ret "secret store input is invalid"; }
    discard_store();
    mutex.lock(?store_lock);
    val was_open: bool      = store_open;
    val source:   Providers = store_source;
    mutex.unlock(?store_lock);
    if (!was_open) { ret "secret store is not open"; }
    var bank:   Bank;
    val failed: str = fill_bank(?bank, configured, registry, generation, source);
    if (failed != nil) { ret failed; }
    mutex.lock(?store_lock);
    banks[1 - current_bank] = bank;
    staged                  = true;
    mutex.unlock(?store_lock);
    ret nil;
}

# borrows read the staged generation from here on, and the one they replace is
# cleared
pub fun publish_store(generation: u64) bool {
    mutex.lock(?store_lock);
    if (!store_open || !staged || banks[1 - current_bank].generation != generation) {
        mutex.unlock(?store_lock);
        ret false;
    }
    val previous: usize = current_bank;
    current_bank = 1 - current_bank;
    staged       = false;
    release_bank(?banks[previous]);
    mutex.unlock(?store_lock);
    ret true;
}

# clears a staged generation a reload did not publish
pub fun discard_store() {
    mutex.lock(?store_lock);
    if (store_open && staged) {
        release_bank(?banks[1 - current_bank]);
        staged = false;
    }
    mutex.unlock(?store_lock);
}

# clears every generation and refuses borrows from here on
pub fun close_store() {
    mutex.lock(?store_lock);
    if (store_open) {
        release_bank(?banks[0]);
        release_bank(?banks[1]);
    }
    staged       = false;
    store_open   = false;
    store_source = no_providers();
    mutex.unlock(?store_lock);
}

# the secrets hedge holds for itself at once, process-wide
pub val MAX_HELD: usize = 4;

# an opaque public name for one secret hedge holds for itself. it holds no
# pointer, and a stale one reaches nothing
pub rec Held {
    slot:       u32;
    generation: u32;
}

pub fun no_held() Held {
    ret Held{slot: 0, generation: 0};
}

var held_data: [MAX_HELD]*^u8;
var held_size: [MAX_HELD]usize;
var held_gens: [MAX_HELD]u32;
var held_used: [MAX_HELD]bool;
var held_lock: mutex.Mutex = 0;

fun held_live(held: Held) bool {
    if (held.generation == 0 || held.slot::usize >= MAX_HELD) { ret false; }
    ret held_used[held.slot::usize] && held_gens[held.slot::usize] == held.generation;
}

# whether `held` names a secret this module still holds
pub fun holds(held: Held) bool {
    mutex.lock(?held_lock);
    val live: bool = held_live(held);
    mutex.unlock(?held_lock);
    ret live;
}

fun take_slot(data: *^u8, size: usize, output: *Held) bool {
    mutex.lock(?held_lock);
    var i: usize = 0;
    for (i < MAX_HELD) {
        if (!held_used[i] && held_gens[i] != 4294967295) {
            held_gens[i] = held_gens[i] + 1;
            held_data[i] = data;
            held_size[i] = size;
            held_used[i] = true;
            @output      = Held{slot: i::u32, generation: held_gens[i]};
            mutex.unlock(?held_lock);
            ret true;
        }
        i = i + 1;
    }
    mutex.unlock(?held_lock);
    ret false;
}

# resolves the declared secret `name` through its provider, `source` for `os`
# and `application`, into welded storage this module owns, and names it in
# `output`. it never passes through public memory except an environment
# variable, which the process holds in public memory already
pub fun hold(configured: *schema.Graph, name: str, source: Providers, output: *Held) bool {
    if (configured == nil || name == nil || output == nil) { ret false; }
    @output = no_held();
    val declared: *schema.Secret = schema.find_secret(configured, name);
    if (declared == nil) { ret false; }
    var data: *^u8  = nil;
    var size: usize = 0;
    if (!resolve_welded(declared, source, ?data, ?size)) { ret false; }
    if (!take_slot(data, size, output)) {
        secret_memory.deallocate(data, size);
        ret false;
    }
    ret true;
}

# wipes and frees a held secret. its handle, and every copy of it, reaches
# nothing from here on
pub fun release(held: Held) bool {
    mutex.lock(?held_lock);
    if (!held_live(held)) {
        mutex.unlock(?held_lock);
        ret false;
    }
    val slot:  usize               = held.slot::usize;
    val freed: err[io_error.Error] = secret_memory.deallocate(held_data[slot], held_size[slot]);
    held_data[slot] = nil;
    held_size[slot] = 0;
    held_used[slot] = false;
    mutex.unlock(?held_lock);
    ret sel freed.ok;
}

# a secret flag, 1 when the `size` secret bytes at `data` are exactly
# `candidate`. the scan covers every secret byte whatever the candidate holds
#[oblivious]
fun equal_to(data: *^u8, size: usize, candidate: view.View) ^u8 {
    var difference: ^u8   = (candidate.len != size)::u8;
    var i:          usize = 0;
    for (i < size) {
        var offered: u8 = 0;
        if (i < candidate.len) { offered = candidate.data[i]; }
        difference = difference | (data[i] ^ offered);
        i          = i + 1;
    }
    ret ct.is_zero[u8](difference);
}

# whether `candidate` is exactly the secret `held` names. every byte of the
# secret is compared whatever the candidate holds, and the verdict is the one
# thing declassified
pub fun matches(held: Held, candidate: view.View) bool {
    if (candidate.len != 0 && candidate.data == nil) { ret false; }
    mutex.lock(?held_lock);
    if (!held_live(held)) {
        mutex.unlock(?held_lock);
        ret false;
    }
    val same: ^u8 = equal_to(held_data[held.slot::usize],
        held_size[held.slot::usize], candidate);
    mutex.unlock(?held_lock);
    ret (same:>u8) == 1;
}

#[testing]
pub fun test_hold(value: str, output: *Held) bool {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    val data: *^u8 = secret_memory.allocate(length);
    if (data == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        data[i] = value[i]::u8;
        i       = i + 1;
    }
    if (!take_slot(data, length, output)) {
        secret_memory.deallocate(data, length);
        ret false;
    }
    ret true;
}

#[testing]
var test_version: u8 = 'a';

#[testing]
fun test_provide(context: ptr, provider: str, key: str, output: *^u8,
    capacity: usize) i64 {
    if (!str_equals(provider, "application") || capacity < 3) { ret -1; }
    if (str_equals(key, "db")) {
        output[0] = 'd';
        output[1] = 'b';
        output[2] = test_version;
        ret 3;
    }
    if (str_equals(key, "api")) {
        output[0] = 'k';
        ret 1;
    }
    ret -1;
}

#[testing]
fun test_serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    ret exchange.SERVICE_FAILED;
}

#[testing]
rec TestSeen {
    len:   usize;
    first: u8;
    last:  u8;
}

#[testing]
fun test_use(context: ptr, value: contracts.SecretBytes) bool {
    val seen: *TestSeen = context::*TestSeen;
    seen.len   = value.len;
    seen.first = value.data[0]:>u8;
    seen.last  = value.data[value.len - 1]:>u8;
    ret true;
}

#[testing]
fun test_grant(graph: *schema.Graph, application: str, name: str, key: str) {
    val index: usize = graph.application_count;
    graph.application_count = index + 1;
    schema.set_text(?graph.applications[index].name, application);
    graph.applications[index].grant_count = 1;
    schema.set_text(?graph.applications[index].grants[0].name, name);
    schema.set_text(?graph.applications[index].grants[0].secret, key);
    val secret: usize = graph.secret_count;
    graph.secret_count = secret + 1;
    schema.set_text(?graph.secrets[secret].name, key);
    schema.set_text(?graph.secrets[secret].provider, "application");
    schema.set_text(?graph.secrets[secret].key, key);
}

test store__scoped_to_application_and_generation {
    var slots:    [2]service.Application;
    var registry: service.Applications;
    val handler:  service.Handler = service.Handler{ctx: nil, serve: test_serve};
    if (!service.make_applications(?registry, ?slots[0], 2)
        || !service.register_application(?registry, "site", handler, 0)
        || !service.register_application(?registry, "other", handler, 0)) { ret 1; }
    var site:  Source;
    var other: Source;
    if (!source(?registry, "site", ?site) || !source(?registry, "other", ?other)
        || source(?registry, "absent", ?other)) { ret 2; }

    var provider: Provider = Provider{ctx: nil, provide: test_provide};
    var named:    Providers;
    if (!register_provider(?provider, ?named)) { ret 3; }
    var first: schema.Graph;
    schema.reset_graph(?first);
    test_grant(?first, "site", "database", "db");
    test_grant(?first, "other", "token", "api");
    if (open_store(?first, ?registry, 1, named) != nil) { ret 4; }

    var seen: TestSeen;
    if (borrow(site, view.view("database", 8), test_use, (?seen)::ptr) != BORROW_OK
        || seen.len != 3 || seen.first != 'd' || seen.last != 'a') { ret 5; }
    # one application never reaches another's grants
    if (borrow(site, view.view("token", 5), test_use, (?seen)::ptr) != BORROW_MISSING
        || borrow(other, view.view("database", 8), test_use, (?seen)::ptr) != BORROW_MISSING) { ret 6; }

    # a reload resolves again, and borrows read the old value until it publishes
    var second: schema.Graph;
    schema.reset_graph(?second);
    test_grant(?second, "site", "database", "db");
    test_version = 'b';
    if (stage_store(?second, ?registry, 2) != nil) { ret 7; }
    if (borrow(site, view.view("database", 8), test_use, (?seen)::ptr) != BORROW_OK
        || seen.last != 'a') { ret 8; }
    if (!publish_store(2)
        || borrow(site, view.view("database", 8), test_use, (?seen)::ptr) != BORROW_OK
        || seen.last != 'b'
        || borrow(other, view.view("token", 5), test_use, (?seen)::ptr) != BORROW_MISSING) { ret 9; }

    # a section for an unregistered application refuses the generation
    var third: schema.Graph;
    schema.reset_graph(?third);
    test_grant(?third, "absent", "database", "db");
    if (stage_store(?third, ?registry, 3) == nil) { ret 10; }

    close_store();
    if (borrow(site, view.view("database", 8), test_use, (?seen)::ptr) != BORROW_INVALID) { ret 11; }
    if (!unregister_provider(named))                                                      { ret 12; }
    ret 0;
}

test held__compared_exactly_and_released {
    var provider: Provider = Provider{ctx: nil, provide: test_provide};
    var named:    Providers;
    if (!register_provider(?provider, ?named)) { ret 1; }
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    test_grant(?graph, "site", "database", "db");
    test_version = 'c';
    var held: Held;
    if (hold(?graph, "absent", named, ?held) || holds(held)) { ret 2; }
    if (!hold(?graph, "db", named, ?held) || !holds(held))   { ret 3; }
    if (!matches(held, view.view("dbc", 3))
        || matches(held, view.view("dbd", 3))
        || matches(held, view.view("db", 2))
        || matches(held, view.view("dbcc", 4))
        || matches(held, view.view(nil, 0))) { ret 4; }
    if (!release(held) || holds(held) || release(held)
        || matches(held, view.view("dbc", 3))) { ret 5; }
    if (!unregister_provider(named)) { ret 6; }
    ret 0;
}
