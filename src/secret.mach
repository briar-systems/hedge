# bounded runtime secret resolution

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.option.Option;
use std.types.option.is_some;
use std.filesystem;
use std.process.env;
use hedge.config.schema;
use io_error: std.io.error;

pub val MAX_VALUE_BYTES: usize = 512;

# custom providers receive the typed provider and key and return the full byte
# length. a result at least capacity is an explicit overflow.
pub def ResolveFun: fun(ptr, str, str, *u8, usize) i64;

pub rec Resolver {
    context: ptr;
    resolve: ResolveFun;
}

pub fun no_resolver() Resolver {
    ret Resolver{context: nil, resolve: (0::usize)::ResolveFun};
}

pub fun clear(output: *u8, capacity: usize) {
    if (output == nil) { ret; }
    var i: usize = 0;
    for (i < capacity) { output[i] = 0; i = i + 1; }
}

fun read_file(path: str, output: *u8, capacity: usize) i64 {
    if (path == nil || output == nil || capacity < 2) { ret -1; }
    val opened: Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (is_err[filesystem.File, io_error.Error](opened)) { ret -1; }
    var file: filesystem.File = unwrap_ok[filesystem.File, io_error.Error](opened);
    var length: usize = 0;
    var failed: bool = false;
    for (length < capacity - 1) {
        val read: Result[usize, io_error.Error] = filesystem.read(file,
            ?output[length], capacity - 1 - length);
        if (is_err[usize, io_error.Error](read)) { failed = true; brk; }
        val count: usize = unwrap_ok[usize, io_error.Error](read);
        if (count == 0) { brk; }
        length = length + count;
    }
    if (!failed && length == capacity - 1) {
        var extra: u8 = 0;
        val probe: Result[usize, io_error.Error] = filesystem.read(file, ?extra, 1);
        if (is_err[usize, io_error.Error](probe)
         || unwrap_ok[usize, io_error.Error](probe) != 0) { failed = true; }
    }
    val closed: Option[io_error.Error] = filesystem.close(?file);
    if (is_some[io_error.Error](closed)) { failed = true; }
    if (failed || length == 0) { clear(output, capacity); ret -1; }
    var i: usize = 0;
    for (i < length) {
        if (output[i] == 0 || output[i] == '\r' || output[i] == '\n') {
            clear(output, capacity);
            ret -1;
        }
        i = i + 1;
    }
    output[length] = 0;
    ret length::i64;
}

fun native(provider: str, key: str, output: *u8, capacity: usize) i64 {
    if (str_equals(provider, "env")) { ret env.get(key, output, capacity); }
    if (str_equals(provider, "file")) { ret read_file(key, output, capacity); }
    ret -1;
}

pub fun resolve(graph: *schema.Graph, name: str, custom: Resolver,
    output: *u8, capacity: usize) usize {
    if (graph == nil || name == nil || output == nil || capacity < 2
     || capacity > MAX_VALUE_BYTES + 1) { ret 0; }
    clear(output, capacity);
    val configured: *schema.Secret = schema.find_secret(graph, name);
    if (configured == nil) { ret 0; }
    val provider: str = schema.text(?configured.provider);
    val key: str = schema.text(?configured.key);
    var length: i64 = native(provider, key, output, capacity);
    if (length < 0 && custom.resolve::usize != 0) {
        clear(output, capacity);
        length = custom.resolve(custom.context, provider, key, output, capacity);
    }
    if (length <= 0 || length::usize >= capacity) {
        clear(output, capacity);
        ret 0;
    }
    var i: usize = 0;
    for (i < length::usize) {
        if (output[i] == 0 || output[i] == '\r' || output[i] == '\n') {
            clear(output, capacity);
            ret 0;
        }
        i = i + 1;
    }
    output[length::usize] = 0;
    ret length::usize;
}

fun test_resolve(context: ptr, provider: str, key: str, output: *u8,
    capacity: usize) i64 {
    if (!str_equals(provider, "application") || !str_equals(key, "admin")
     || capacity < 6) { ret -1; }
    output[0] = 't'; output[1] = 'o'; output[2] = 'k'; output[3] = 'e';
    output[4] = 'n'; output[5] = 0;
    ret 5;
}

test "secret: typed custom providers resolve into caller-bounded storage" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.secret_count = 1;
    schema.set_text(?graph.secrets[0].name, "admin-token");
    schema.set_text(?graph.secrets[0].provider, "application");
    schema.set_text(?graph.secrets[0].key, "admin");
    var output: [16]u8;
    val resolver: Resolver = Resolver{context: nil, resolve: test_resolve};
    if (resolve(?graph, "admin-token", resolver, ?output[0], 16) != 5
     || output[0] != 't' || output[4] != 'n' || output[5] != 0) { ret 1; }
    ret 0;
}

fun test_oversize(context: ptr, provider: str, key: str, output: *u8,
    capacity: usize) i64 {
    if (capacity != 0) { output[0] = 'x'; }
    ret capacity::i64;
}

test "secret: overflow fails closed and clears partial secret material" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.secret_count = 1;
    schema.set_text(?graph.secrets[0].name, "admin-token");
    schema.set_text(?graph.secrets[0].provider, "os");
    schema.set_text(?graph.secrets[0].key, "admin");
    var output: [8]u8;
    val resolver: Resolver = Resolver{context: nil, resolve: test_oversize};
    if (resolve(?graph, "admin-token", resolver, ?output[0], 8) != 0) { ret 1; }
    var i: usize = 0;
    for (i < 8) { if (output[i] != 0) { ret 2; } i = i + 1; }
    ret 0;
}
