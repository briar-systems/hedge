# validated server configuration contracts

use std.types.bool.bool;
use std.types.size.usize;

pub rec Limits {
    max_connections:          usize;
    max_connections_per_peer: usize;
    max_header_bytes:         usize;
    max_header_count:         usize;
    max_body_bytes:           usize;
    max_pipeline_depth:       usize;
}

pub rec Timeouts {
    handshake_ms:  u64;
    header_ms:     u64;
    request_ms:    u64;
    write_ms:      u64;
    keep_alive_ms: u64;
    drain_ms:      u64;
}

pub rec Features {
    http1: bool;
    http2: bool;
    http3: bool;
    tls:   bool;
    acme:  bool;
    proxy: bool;
    cache: bool;
}

pub rec Config {
    limits:   Limits;
    timeouts: Timeouts;
    features: Features;
}
