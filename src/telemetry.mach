# bounded production telemetry surfaces

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use std.chrono.time;
use std.chrono.duration;
use std.log.record;
use std.log.sink;
use http.core.exchange;
use http.core.field;
use http.core.message;
use hedge.config.schema;
use call: hedge.dispatch.call;
use telemetry_log: hedge.telemetry.log;
use telemetry_metrics: hedge.telemetry.metrics;
use telemetry_health: hedge.telemetry.health;
use telemetry_admin: hedge.telemetry.admin;
use telemetry_trace: hedge.telemetry.trace;

fwd hedge.telemetry.log;
fwd hedge.telemetry.metrics;
fwd hedge.telemetry.trace;
fwd hedge.telemetry.health;
fwd hedge.telemetry.admin;

pub def FlushFun: fun(ptr) bool;

pub val BUILT_IN_METRIC_SERIES: usize = schema.MIN_METRIC_SERIES;

pub rec Runtime {
    logger: telemetry_log.Logger;
    log_sink: sink.Sink;
    metrics: telemetry_metrics.Registry;
    health: telemetry_health.Health;
    admin: telemetry_admin.Handler;
    flush_context: ptr;
    flush: FlushFun;
    logs_enabled: bool;
    metrics_enabled: bool;
    traces_enabled: bool;
    admin_enabled: bool;
    trace_state_bytes: usize;
    requests: telemetry_metrics.Token;
    failures: telemetry_metrics.Token;
    request_bytes: telemetry_metrics.Token;
    response_bytes: telemetry_metrics.Token;
    duration_us: telemetry_metrics.Token;
    initialized: bool;
}

pub rec Access {
    listener: str;
    method: str;
    target: str;
    protocol: str;
    status: u16;
    duration_us: u64;
    request_bytes: u64;
    response_bytes: u64;
    trace_id: str;
}

pub rec Failure {
    component: str;
    operation: str;
    code: str;
    message: str;
    trace_id: str;
}

fun copy_text(output: *u8, capacity: usize, value: str) usize {
    if (output == nil || value == nil) { ret 0; }
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    if (length > capacity) { ret 0; }
    var i: usize = 0;
    for (i < length) { output[i] = value[i]; i = i + 1; }
    ret length;
}

fun built_in_metrics(context: ptr, output: *u8, capacity: usize) usize {
    val runtime: *Runtime = context::*Runtime;
    if (!runtime.metrics_enabled) { ret copy_text(output, capacity, "# metrics disabled\n"); }
    val rendered: telemetry_metrics.Rendered = telemetry_metrics.render(?runtime.metrics, output, capacity);
    if (!rendered.ok) { ret 0; }
    if (rendered.len == 0) { ret copy_text(output, capacity, "# no metrics\n"); }
    ret rendered.len;
}

fun built_in_state(context: ptr, output: *u8, capacity: usize) usize {
    val runtime: *Runtime = context::*Runtime;
    val state: telemetry_health.Snapshot = telemetry_health.snapshot(?runtime.health);
    if (!state.live) { ret copy_text(output, capacity, "{\"live\":false,\"ready\":false}\n"); }
    if (state.ready) { ret copy_text(output, capacity, "{\"live\":true,\"ready\":true}\n"); }
    ret copy_text(output, capacity, "{\"live\":true,\"ready\":false}\n");
}

pub fun make(
    runtime: *Runtime,
    graph: *schema.Graph,
    output: *sink.Sink,
    metric_storage: *telemetry_metrics.Series,
    metric_capacity: usize,
    check_storage: *telemetry_health.Check,
    check_capacity: usize,
    auth_context: ptr,
    authenticate: telemetry_admin.AuthenticateFun,
    render_context: ptr,
    render_metrics: telemetry_admin.RenderFun,
    render_state: telemetry_admin.RenderFun,
    flush_context: ptr,
    flush: FlushFun,
) bool {
    if (runtime == nil || graph == nil || check_storage == nil || check_capacity == 0) { ret false; }
    if (graph.telemetry.traces && (graph.telemetry.trace_state_bytes == 0 || graph.telemetry.trace_state_bytes > telemetry_trace.TRACESTATE_CAPACITY)) { ret false; }
    runtime.logs_enabled = graph.telemetry.logs;
    runtime.metrics_enabled = graph.telemetry.metrics;
    runtime.traces_enabled = graph.telemetry.traces;
    runtime.admin_enabled = graph.admin.enabled;
    runtime.trace_state_bytes = graph.telemetry.trace_state_bytes;
    runtime.flush_context = flush_context;
    runtime.flush = flush;
    if (!telemetry_health.make(?runtime.health, check_storage, check_capacity)) { ret false; }
    if (runtime.logs_enabled) {
        if (output == nil || graph.telemetry.log_record_bytes == 0 || graph.telemetry.log_record_bytes > record.MAX_RECORD_BYTES) { ret false; }
        if (output.contract.delivery == sink.DELIVERY_BOUNDED_QUEUED
            && (output.contract.queue_capacity != graph.telemetry.log_queue_depth || flush::usize == 0)) {
            ret false;
        }
        runtime.log_sink = @output;
        runtime.log_sink.contract.max_record = graph.telemetry.log_record_bytes;
        if (!telemetry_log.make(
            ?runtime.logger,
            ?runtime.log_sink,
            record.system_clock(record.PRECISION_MILLIS),
            record.INFO,
            telemetry_log.MAX_FIELDS,
            false,
        )) { ret false; }
    }
    if (runtime.metrics_enabled) {
        if (metric_storage == nil || metric_capacity < graph.telemetry.metric_series
         || graph.telemetry.metric_series < BUILT_IN_METRIC_SERIES
         || !telemetry_metrics.make(?runtime.metrics, metric_storage,
            graph.telemetry.metric_series)) { ret false; }
        var bounds: [9]u64 = [9]u64{100, 500, 1000, 5000, 10000,
            50000, 100000, 500000, 1000000};
        if (!telemetry_metrics.register(?runtime.metrics,
                telemetry_metrics.COUNTER, "hedge_requests_total", nil, 0,
                nil, 0, ?runtime.requests)
         || !telemetry_metrics.register(?runtime.metrics,
                telemetry_metrics.COUNTER, "hedge_request_failures_total", nil, 0,
                nil, 0, ?runtime.failures)
         || !telemetry_metrics.register(?runtime.metrics,
                telemetry_metrics.COUNTER, "hedge_request_bytes_total", nil, 0,
                nil, 0, ?runtime.request_bytes)
         || !telemetry_metrics.register(?runtime.metrics,
                telemetry_metrics.COUNTER, "hedge_response_bytes_total", nil, 0,
                nil, 0, ?runtime.response_bytes)
         || !telemetry_metrics.register(?runtime.metrics,
                telemetry_metrics.HISTOGRAM, "hedge_request_duration_us", nil, 0,
                ?bounds[0], 9, ?runtime.duration_us)) { ret false; }
    }
    if (runtime.admin_enabled) {
        var metrics_context: ptr = render_context;
        var state_context: ptr = render_context;
        var selected_metrics: telemetry_admin.RenderFun = render_metrics;
        var selected_state: telemetry_admin.RenderFun = render_state;
        if (selected_metrics::usize == 0) { selected_metrics = built_in_metrics; metrics_context = runtime::ptr; }
        if (selected_state::usize == 0) { selected_state = built_in_state; state_context = runtime::ptr; }
        val policy: telemetry_admin.Policy = telemetry_admin.Policy{
            listener: schema.text(?graph.admin.listener),
            auth_context: auth_context,
            authenticate: authenticate,
            metrics_context: metrics_context,
            render_metrics: selected_metrics,
            state_context: state_context,
            render_state: selected_state,
            max_response_bytes: graph.admin.max_response_bytes,
        };
        if (!telemetry_admin.make(?runtime.admin, policy, ?runtime.health)) { ret false; }
    }
    runtime.initialized = true;
    ret true;
}

pub fun parse_trace(runtime: *Runtime, traceparent: str, tracestate: str, output: *telemetry_trace.Context) bool {
    if (runtime == nil || !runtime.initialized || !runtime.traces_enabled) { ret false; }
    ret telemetry_trace.parse_bounded(traceparent, tracestate, runtime.trace_state_bytes, output);
}

pub fun access(runtime: *Runtime, event: Access) sink.WriteReport {
    if (runtime == nil || !runtime.initialized || !runtime.logs_enabled) { ret sink.suppressed(); }
    var fields: [9]record.Field;
    fields[0] = record.field_string("kind", "access");
    fields[1] = record.field_string("listener", event.listener);
    fields[2] = record.field_string("method", event.method);
    fields[3] = record.field_string("target", event.target);
    fields[4] = record.field_string("protocol", event.protocol);
    fields[5] = record.field_u64("status", event.status::u64);
    fields[6] = record.field_u64("duration_us", event.duration_us);
    fields[7] = record.field_u64("request_bytes", event.request_bytes);
    fields[8] = record.field_u64("response_bytes", event.response_bytes);
    if (event.trace_id != nil && event.trace_id[0] != 0) {
        var traced: [10]record.Field;
        var i: usize = 0;
        for (i < 9) { traced[i] = fields[i]; i = i + 1; }
        traced[9] = record.field_string("trace_id", event.trace_id);
        ret telemetry_log.emit(?runtime.logger, record.INFO, "request completed", ?traced[0], 10);
    }
    ret telemetry_log.emit(?runtime.logger, record.INFO, "request completed", ?fields[0], 9);
}

fun access_request(runtime: *Runtime, request: *message.Request, listener: str,
    protocol: str, status: u16, duration_us: u64, request_bytes: u64,
    response_bytes: u64, trace_id: str) sink.WriteReport {
    if (runtime == nil || !runtime.initialized || !runtime.logs_enabled) {
        ret sink.suppressed();
    }
    var fields: [10]record.Field;
    fields[0] = record.field_string("kind", "access");
    fields[1] = record.field_string("listener", listener);
    fields[2] = record.field_bytes("method", request.method.token.data,
        request.method.token.len);
    fields[3] = record.field_bytes("target", request.target.raw.data,
        request.target.raw.len);
    fields[4] = record.field_string("protocol", protocol);
    fields[5] = record.field_u64("status", status::u64);
    fields[6] = record.field_u64("duration_us", duration_us);
    fields[7] = record.field_u64("request_bytes", request_bytes);
    fields[8] = record.field_u64("response_bytes", response_bytes);
    var count: usize = 9;
    if (trace_id != nil && trace_id[0] != 0) {
        fields[9] = record.field_string("trace_id", trace_id);
        count = 10;
    }
    ret telemetry_log.emit(?runtime.logger, record.INFO, "request completed",
        ?fields[0], count);
}

pub fun error(runtime: *Runtime, event: Failure) sink.WriteReport {
    if (runtime == nil || !runtime.initialized || !runtime.logs_enabled) { ret sink.suppressed(); }
    var fields: [5]record.Field;
    fields[0] = record.field_string("kind", "error");
    fields[1] = record.field_string("component", event.component);
    fields[2] = record.field_string("operation", event.operation);
    fields[3] = record.field_string("code", event.code);
    fields[4] = record.field_string("trace_id", event.trace_id);
    ret telemetry_log.emit(?runtime.logger, record.ERROR, event.message, ?fields[0], 5);
}

fun copy_header(request: *message.Request, name: str, name_length: usize,
    output: *u8, capacity: usize, combine: bool, found: *usize) bool {
    if (request == nil || output == nil || capacity == 0 || found == nil) {
        ret false;
    }
    var length: usize = 0;
    var i: usize = 0;
    for (i < request.fields.len) {
        val item: *field.Field = ?request.fields.items[i];
        if (field.name_equal(item.name, view.view(name, name_length))) {
            if (!combine && @found != 0) { ret false; }
            if (@found != 0) {
                if (length + 1 >= capacity) { ret false; }
                output[length] = ',';
                length = length + 1;
            }
            if (item.value.len > capacity - length - 1) { ret false; }
            var j: usize = 0;
            for (j < item.value.len) {
                output[length + j] = item.value.data[j];
                j = j + 1;
            }
            length = length + item.value.len;
            @found = @found + 1;
        }
        i = i + 1;
    }
    output[length] = 0;
    ret true;
}

fun observe_begin(context: ptr, active: *call.Call) bool {
    val runtime: *Runtime = context::*Runtime;
    if (runtime == nil || !runtime.initialized || active == nil
     || active.telemetry == nil) { ret false; }
    if (!runtime.traces_enabled) { ret true; }
    val request: *message.Request = call.request(active);
    var parent: [telemetry_trace.TRACEPARENT_LENGTH + 1]u8;
    var state: [telemetry_trace.TRACESTATE_CAPACITY + 1]u8;
    var parent_count: usize = 0;
    var state_count: usize = 0;
    val parent_valid: bool = copy_header(request, "traceparent", 11,
        ?parent[0], telemetry_trace.TRACEPARENT_LENGTH + 1, false,
        ?parent_count);
    val state_valid: bool = copy_header(request, "tracestate", 10,
        ?state[0], runtime.trace_state_bytes + 1, true, ?state_count);
    if (!parent_valid || parent_count != 1) { ret true; }
    var state_text: str = nil;
    if (state_count != 0 && state_valid) { state_text = (?state[0])::str; }
    var parsed: telemetry_trace.Context;
    if (!telemetry_trace.parse_bounded((?parent[0])::str, state_text,
            runtime.trace_state_bytes, ?parsed)) { ret true; }
    if (!state_valid) {
        parsed.tracestate[0] = 0;
        parsed.tracestate_len = 0;
        parsed.tracestate_valid = false;
    }
    @active.telemetry = parsed;
    ret true;
}

fun protocol_name(version: message.Version) str {
    if (version.wire == message.WIRE_H1 && version.minor == 0) { ret "HTTP/1.0"; }
    if (version.wire == message.WIRE_H1) { ret "HTTP/1.1"; }
    if (version.wire == message.WIRE_H2) { ret "HTTP/2"; }
    ret "HTTP/3";
}

fun failure_code(outcome: exchange.Outcome) str {
    if (outcome == exchange.OUTCOME_CANCELLED) { ret "cancelled"; }
    if (outcome == exchange.OUTCOME_TIMED_OUT) { ret "timed_out"; }
    ret "failed";
}

fun observe_end(context: ptr, active: *call.Call, complete: bool) {
    val runtime: *Runtime = context::*Runtime;
    if (runtime == nil || !runtime.initialized || active == nil
     || active.exchange == nil) { ret; }
    val request: *message.Request = call.request(active);
    val completion: exchange.Completion = active.exchange.completion;
    var elapsed: i64 = time.time_sub(time.now(), request.metadata.received_at);
    if (elapsed < 0) { elapsed = 0; }
    val elapsed_us: u64 = duration.duration_usec(elapsed)::u64;
    var trace_id: [33]u8;
    var trace_text: str = nil;
    if (telemetry_trace.format_id(active.telemetry, ?trace_id[0], 33) != 0) {
        trace_text = (?trace_id[0])::str;
    }
    if (runtime.metrics_enabled) {
        telemetry_metrics.counter_add(?runtime.metrics, runtime.requests, 1);
        telemetry_metrics.counter_add(?runtime.metrics, runtime.request_bytes,
            completion.bytes_in);
        telemetry_metrics.counter_add(?runtime.metrics, runtime.response_bytes,
            completion.bytes_out);
        telemetry_metrics.observe(?runtime.metrics, runtime.duration_us, elapsed_us);
        if (!complete || completion.outcome != exchange.OUTCOME_OK) {
            telemetry_metrics.counter_add(?runtime.metrics, runtime.failures, 1);
        }
    }
    access_request(runtime, request, active.listener,
        protocol_name(request.metadata.version), completion.status,
        elapsed_us, completion.bytes_in, completion.bytes_out, trace_text);
    if (!complete || completion.outcome != exchange.OUTCOME_OK) {
        var message: str = completion.error;
        if (message == nil || message[0] == 0) { message = "request did not complete"; }
        error(runtime, Failure{component: "request", operation: "serve",
            code: failure_code(completion.outcome), message: message,
            trace_id: trace_text});
    }
}

pub fun observer(runtime: *Runtime) call.Observer {
    if (runtime == nil || !runtime.initialized) { ret call.no_observer(); }
    ret call.Observer{ctx: runtime::ptr, begin: observe_begin, end: observe_end};
}

pub fun begin_ready(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.initialized) { ret false; }
    ret telemetry_health.begin_accepting(?runtime.health);
}

pub fun begin_drain(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.initialized) { ret false; }
    ret telemetry_health.begin_drain(?runtime.health);
}

pub fun shutdown(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.initialized) { ret false; }
    telemetry_health.begin_drain(?runtime.health);
    var flushed: bool = true;
    if (runtime.logs_enabled && runtime.flush::usize != 0) { flushed = runtime.flush(runtime.flush_context); }
    runtime.initialized = false;
    ret flushed;
}

rec TestOutput {
    writes: usize;
}

rec TestFlush {
    calls: usize;
    succeed: bool;
}

rec TestRender {
    calls: usize;
}

fun test_publish(context: ptr, data: *u8, length: usize) sink.WriteReport {
    val output: *TestOutput = context::*TestOutput;
    output.writes = output.writes + 1;
    ret sink.persisted(length);
}

fun test_queue_publish(context: ptr, data: *u8, length: usize) sink.WriteReport {
    val output: *TestOutput = context::*TestOutput;
    output.writes = output.writes + 1;
    ret sink.report(sink.WRITE_ENQUEUED, length, 0, false, nil);
}

fun test_flush(context: ptr) bool {
    val state: *TestFlush = context::*TestFlush;
    state.calls = state.calls + 1;
    ret state.succeed;
}

fun test_auth(context: ptr, value: str) bool { ret true; }
fun test_render(context: ptr, output: *u8, capacity: usize) usize { if (capacity == 0) { ret 0; } output[0] = 'x'; ret 1; }

fun test_context_render(context: ptr, output: *u8, capacity: usize) usize {
    val state: *TestRender = context::*TestRender;
    state.calls = state.calls + 1;
    ret copy_text(output, capacity, "custom_metric 1\n");
}

test "telemetry: access, readiness, and flush share one bounded runtime" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs = true;
    graph.telemetry.metrics = true;
    graph.telemetry.metric_series = BUILT_IN_METRIC_SERIES;
    graph.telemetry.log_record_bytes = 512;
    graph.admin.enabled = false;
    var target: TestOutput;
    target.writes = 0;
    val contract: sink.Contract = sink.Contract{delivery: sink.DELIVERY_DIRECT, max_record: 512, oversize: record.OVERSIZE_REJECT, adapter: sink.ADAPTER_CUSTOM, target_atomic_limit: 0, queue_capacity: 0, overload: sink.OVERLOAD_REJECT_NEW};
    var output: sink.Sink = sink.Sink{ctx: (?target)::ptr, f_publish: test_publish, contract: contract};
    var series: [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks: [2]telemetry_health.Check;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, ?output, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 2, nil, test_auth, nil, test_render, test_render,
        nil, (0::usize)::FlushFun)) { ret 1; }
    if (!begin_ready(?runtime)) { ret 2; }
    val report: sink.WriteReport = access(?runtime, Access{listener: "public", method: "GET", target: "/", protocol: "HTTP/1.1", status: 200, duration_us: 10, request_bytes: 0, response_bytes: 2, trace_id: nil});
    if (report.status != sink.WRITE_PERSISTED || target.writes != 1 || !telemetry_health.snapshot(?runtime.health).ready) { ret 3; }
    if (error(?runtime, Failure{component: "listener", operation: "accept", code: "EMFILE", message: "descriptor budget exhausted", trace_id: nil}).status != sink.WRITE_PERSISTED || target.writes != 2) { ret 4; }
    if (!shutdown(?runtime) || telemetry_health.snapshot(?runtime.health).ready) { ret 5; }
    ret 0;
}

test "telemetry: bounded queue flushes exactly once during shutdown" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs = true;
    graph.telemetry.log_record_bytes = 512;
    graph.telemetry.log_queue_depth = 1;
    var target: TestOutput;
    target.writes = 0;
    val contract: sink.Contract = sink.Contract{delivery: sink.DELIVERY_BOUNDED_QUEUED, max_record: 512, oversize: record.OVERSIZE_REJECT, adapter: sink.ADAPTER_CUSTOM, target_atomic_limit: 0, queue_capacity: 1, overload: sink.OVERLOAD_REJECT_NEW};
    var output: sink.Sink = sink.Sink{ctx: (?target)::ptr, f_publish: test_queue_publish, contract: contract};
    var checks: [1]telemetry_health.Check;
    var runtime: Runtime;
    var flush_state: TestFlush;
    flush_state.calls = 0;
    flush_state.succeed = true;
    if (!make(?runtime, ?graph, ?output, nil, 0, ?checks[0], 1, nil, test_auth, nil, test_render, test_render, (?flush_state)::ptr, test_flush)) { ret 1; }
    if (access(?runtime, Access{listener: "public", method: "GET", target: "/", protocol: "HTTP/1.1", status: 200, duration_us: 1, request_bytes: 0, response_bytes: 0, trace_id: nil}).status != sink.WRITE_ENQUEUED) { ret 2; }
    if (!shutdown(?runtime) || flush_state.calls != 1 || target.writes != 1) { ret 3; }
    if (shutdown(?runtime) || flush_state.calls != 1) { ret 4; }
    flush_state.calls = 0;
    flush_state.succeed = false;
    var failed_checks: [1]telemetry_health.Check;
    var failed_runtime: Runtime;
    if (!make(?failed_runtime, ?graph, ?output, nil, 0, ?failed_checks[0], 1, nil, test_auth, nil, test_render, test_render, (?flush_state)::ptr, test_flush)) { ret 5; }
    if (shutdown(?failed_runtime) || flush_state.calls != 1) { ret 6; }
    ret 0;
}

test "telemetry: built-in administration keeps custom renderer ownership" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs = false;
    graph.telemetry.metrics = true;
    graph.telemetry.metric_series = BUILT_IN_METRIC_SERIES;
    graph.admin.enabled = true;
    graph.admin.max_response_bytes = 256;
    schema.set_text(?graph.admin.listener, "admin");
    var series: [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks: [1]telemetry_health.Check;
    var render_state: TestRender;
    render_state.calls = 0;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 1, nil, test_auth, (?render_state)::ptr,
        test_context_render, (0::usize)::telemetry_admin.RenderFun,
        nil, (0::usize)::FlushFun)) { ret 1; }
    var output: [256]u8;
    var response: telemetry_admin.Response;
    if (!telemetry_admin.handle(?runtime.admin, telemetry_admin.Request{listener: "admin", method: "GET", path: "/metrics", authorization: "Bearer test"}, ?output[0], 256, ?response)
        || response.status != 200 || render_state.calls != 1) { ret 2; }
    if (!telemetry_admin.handle(?runtime.admin, telemetry_admin.Request{listener: "admin", method: "GET", path: "/state", authorization: "Bearer test"}, ?output[0], 256, ?response)
        || response.status != 200 || render_state.calls != 1) { ret 3; }
    ret 0;
}

test "telemetry: trace propagation obeys the configured state budget" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs = false;
    graph.telemetry.traces = true;
    graph.telemetry.trace_state_bytes = 8;
    var checks: [1]telemetry_health.Check;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, nil, 0, ?checks[0], 1, nil, test_auth, nil, test_render, test_render, nil, (0::usize)::FlushFun)) { ret 1; }
    var context: telemetry_trace.Context;
    val traceparent: str = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
    if (!parse_trace(?runtime, traceparent, "a=value", ?context)) { ret 2; }
    if (!parse_trace(?runtime, traceparent, "vendor=value", ?context) || context.tracestate_valid || context.tracestate_len != 0) { ret 3; }
    ret 0;
}
