# bounded production telemetry surfaces

use hedge.clock;
use hedge.config.schema;
use hedge.dispatch.call;
use hedge_memory:      hedge.memory;
use telemetry_admin:   hedge.telemetry.admin;
use telemetry_health:  hedge.telemetry.health;
use telemetry_log:     hedge.telemetry.log;
use telemetry_metrics: hedge.telemetry.metrics;
use telemetry_trace:   hedge.telemetry.trace;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use std.log.record;
use std.log.sink;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view;

fun status_enqueued(status: sink.WriteStatus) bool {
    ret sel status.enqueued;
}

fun status_persisted(status: sink.WriteStatus) bool {
    ret sel status.persisted;
}

fwd hedge.telemetry.log;
fwd hedge.telemetry.metrics;
fwd hedge.telemetry.trace;
fwd hedge.telemetry.health;
fwd hedge.telemetry.admin;

pub def FlushFun: fun(ptr) bool;

pub val BUILT_IN_METRIC_SERIES: usize = schema.MIN_METRIC_SERIES;

pub rec Runtime {
    logger:            telemetry_log.Logger;
    log_sink:          sink.Sink;
    metrics:           telemetry_metrics.Registry;
    health:            telemetry_health.Health;
    admin:             telemetry_admin.Handler;
    flush_context:     ptr;
    flush:             FlushFun;
    logs_enabled:      bool;
    metrics_enabled:   bool;
    traces_enabled:    bool;
    admin_enabled:     bool;
    trace_state_bytes: usize;
    requests:          telemetry_metrics.Token;
    failures:          telemetry_metrics.Token;
    request_bytes:     telemetry_metrics.Token;
    response_bytes:    telemetry_metrics.Token;
    duration_us:       telemetry_metrics.Token;
    memory_refusals:   telemetry_metrics.Token;
    replay_full:       telemetry_metrics.Token;
    # the last QUIC replay refusal total reported, so each report adds the rise
    replay_full_seen: u64;
    # the admitted QUIC connections hedge holds, from admission until release
    quic_connections: telemetry_metrics.Token;
    # the QUIC handshake bound: a gauge of what holds a slot, and the running
    # totals of Initials held back, promoted, dropped and refused, plus the
    # Retries a pump dropped at its stateless send ceiling
    handshakes_in_flight:      telemetry_metrics.Token;
    handshake_service_ns:      telemetry_metrics.Token;
    handshakes_deferred:       telemetry_metrics.Token;
    handshakes_promoted:       telemetry_metrics.Token;
    handshakes_completed:      telemetry_metrics.Token;
    handshakes_dropped:        telemetry_metrics.Token;
    handshakes_refused:        telemetry_metrics.Token;
    handshakes_expired:        telemetry_metrics.Token;
    handshake_finish_ns:       telemetry_metrics.Token;
    retries_dropped:           telemetry_metrics.Token;
    arrivals_dropped:          [ARRIVAL_CLASSES]telemetry_metrics.Token;
    handshakes_deferred_seen:  u64;
    handshakes_promoted_seen:  u64;
    handshakes_completed_seen: u64;
    handshakes_dropped_seen:   u64;
    handshakes_refused_seen:   u64;
    handshakes_expired_seen:   u64;
    retries_dropped_seen:      u64;
    arrivals_dropped_seen:     [ARRIVAL_CLASSES]u64;
    # the worker pool, lane by lane, and the connections it could not admit
    memory_held:         [5]telemetry_metrics.Token;
    memory_refused:      [5]telemetry_metrics.Token;
    memory_timeouts:     [5]telemetry_metrics.Token;
    refused_connections: telemetry_metrics.Token;
    memory_seen:         [5]hedge_memory.LaneCounters;
    refused_memory_seen: u64;
    # the timer wheel: entries claimed by a connection or plane, and those armed
    timers_claimed: telemetry_metrics.Token;
    timers_armed:   telemetry_metrics.Token;
    initialized:    bool;
}

pub rec Access {
    listener:       str;
    method:         str;
    target:         str;
    protocol:       str;
    status:         u16;
    duration_us:    u64;
    request_bytes:  u64;
    response_bytes: u64;
    trace_id:       str;
}

pub rec Failure {
    component: str;
    operation: str;
    code:      str;
    message:   str;
    trace_id:  str;
}

fun copy_text(output: *u8, capacity: usize, value: str) usize {
    if (output == nil || value == nil) { ret 0; }
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    if (length > capacity) { ret 0; }
    var i: usize = 0;
    for (i < length) {
        output[i] = value[i];
        i         = i + 1;
    }
    ret length;
}

fun built_in_metrics(context: ptr, output: *u8, capacity: usize) usize {
    val runtime: *Runtime = context::*Runtime;
    if (!runtime.metrics_enabled) { ret copy_text(output, capacity, "# metrics disabled\n"); }
    val rendered: telemetry_metrics.Rendered = telemetry_metrics.render(?runtime.metrics, output, capacity);
    if (!rendered.ok)      { ret 0; }
    if (rendered.len == 0) { ret copy_text(output, capacity, "# no metrics\n"); }
    ret rendered.len;
}

fun built_in_state(context: ptr, output: *u8, capacity: usize) usize {
    val runtime: *Runtime                  = context::*Runtime;
    val state:   telemetry_health.Snapshot = telemetry_health.snapshot(?runtime.health);
    if (!state.live) { ret copy_text(output, capacity, "{\"live\":false,\"ready\":false}\n"); }
    if (state.ready) { ret copy_text(output, capacity, "{\"live\":true,\"ready\":true}\n"); }
    ret copy_text(output, capacity, "{\"live\":true,\"ready\":false}\n");
}

pub fun make(
    runtime: *Runtime,
    graph: *schema.Graph,
    output: *sink.Sink,
    metric_storage: *telemetry_metrics.Series,
    metric_capacity: usize,
    check_storage: *telemetry_health.Check,
    check_capacity: usize,
    auth_context: ptr,
    authenticate: telemetry_admin.AuthenticateFun,
    render_context: ptr,
    render_metrics: telemetry_admin.RenderFun,
    render_state: telemetry_admin.RenderFun,
    flush_context: ptr,
    flush: FlushFun,
) bool {
    if (runtime == nil || graph == nil || check_storage == nil || check_capacity == 0)                                                                 { ret false; }
    if (graph.telemetry.traces && (graph.telemetry.trace_state_bytes == 0 || graph.telemetry.trace_state_bytes > telemetry_trace.TRACESTATE_CAPACITY)) { ret false; }
    runtime.logs_enabled              = graph.telemetry.logs;
    runtime.metrics_enabled           = graph.telemetry.metrics;
    runtime.traces_enabled            = graph.telemetry.traces;
    runtime.admin_enabled             = graph.admin.enabled;
    runtime.trace_state_bytes         = graph.telemetry.trace_state_bytes;
    runtime.replay_full_seen          = 0;
    runtime.handshakes_deferred_seen  = 0;
    runtime.handshakes_promoted_seen  = 0;
    runtime.handshakes_completed_seen = 0;
    runtime.handshakes_dropped_seen   = 0;
    runtime.handshakes_refused_seen   = 0;
    runtime.handshakes_expired_seen   = 0;
    runtime.retries_dropped_seen      = 0;
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        runtime.arrivals_dropped_seen[class] = 0;
        class                                = class + 1;
    }
    runtime.refused_memory_seen = 0;
    var lane: usize = 0;
    for (lane < LANE_COUNT) {
        runtime.memory_seen[lane] = hedge_memory.LaneCounters{held: 0, peak: 0,
            refusals: 0, exhausted: 0, timeouts: 0};
        lane = lane + 1;
    }
    runtime.flush_context = flush_context;
    runtime.flush         = flush;
    if (!telemetry_health.make(?runtime.health, check_storage, check_capacity)) { ret false; }
    if (runtime.logs_enabled) {
        if (output == nil || graph.telemetry.log_record_bytes == 0 || graph.telemetry.log_record_bytes > record.MAX_RECORD_BYTES) { ret false; }
        if (output.contract.delivery == sink.DELIVERY_BOUNDED_QUEUED
            && (output.contract.queue_capacity != graph.telemetry.log_queue_depth || flush::usize == 0)) {
            ret false;
        }
        runtime.log_sink                     = @output;
        runtime.log_sink.contract.max_record = graph.telemetry.log_record_bytes;
        if (!telemetry_log.make(
            ?runtime.logger,
            ?runtime.log_sink,
            record.system_clock(record.PRECISION_MILLIS),
            record.INFO,
            telemetry_log.MAX_FIELDS,
            false,
        )) { ret false; }
    }
    if (runtime.metrics_enabled) {
        if (metric_storage == nil || metric_capacity < graph.telemetry.metric_series
            || graph.telemetry.metric_series < BUILT_IN_METRIC_SERIES
            || !telemetry_metrics.make(?runtime.metrics, metric_storage,
            graph.telemetry.metric_series)) { ret false; }
        var bounds: [9]u64 = [9]u64{100, 500, 1000, 5000, 10000,
            50000, 100000, 500000, 1000000};
        if (!telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_requests_total", nil, 0,
            nil, 0, ?runtime.requests)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_request_failures_total", nil, 0,
            nil, 0, ?runtime.failures)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_request_bytes_total", nil, 0,
            nil, 0, ?runtime.request_bytes)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_response_bytes_total", nil, 0,
            nil, 0, ?runtime.response_bytes)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.HISTOGRAM, "hedge_request_duration_us", nil, 0,
            ?bounds[0], 9, ?runtime.duration_us)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_request_memory_refusals_total", nil, 0,
            nil, 0, ?runtime.memory_refusals)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_retry_replay_full_total", nil, 0,
            nil, 0, ?runtime.replay_full)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_connections_refused_memory_total", nil, 0,
            nil, 0, ?runtime.refused_connections)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.GAUGE, "hedge_quic_handshakes_in_flight", nil, 0,
            nil, 0, ?runtime.handshakes_in_flight)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.GAUGE, "hedge_quic_connections", nil, 0,
            nil, 0, ?runtime.quic_connections)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.GAUGE, "hedge_quic_handshake_service_ns", nil, 0,
            nil, 0, ?runtime.handshake_service_ns)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_handshakes_deferred_total", nil, 0,
            nil, 0, ?runtime.handshakes_deferred)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_handshakes_promoted_total", nil, 0,
            nil, 0, ?runtime.handshakes_promoted)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_handshakes_completed_total", nil, 0,
            nil, 0, ?runtime.handshakes_completed)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_handshakes_dropped_total", nil, 0,
            nil, 0, ?runtime.handshakes_dropped)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_handshakes_refused_total", nil, 0,
            nil, 0, ?runtime.handshakes_refused)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_handshakes_expired_total", nil, 0,
            nil, 0, ?runtime.handshakes_expired)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.GAUGE, "hedge_quic_handshake_finish_ns", nil, 0,
            nil, 0, ?runtime.handshake_finish_ns)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.COUNTER, "hedge_quic_retries_dropped_total", nil, 0,
            nil, 0, ?runtime.retries_dropped)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.GAUGE, "hedge_timers_claimed", nil, 0,
            nil, 0, ?runtime.timers_claimed)
            || !telemetry_metrics.register(?runtime.metrics,
            telemetry_metrics.GAUGE, "hedge_timers_armed", nil, 0,
            nil, 0, ?runtime.timers_armed)
            || !register_arrival_classes(runtime)
            || !register_lanes(runtime)) { ret false; }
    }
    if (runtime.admin_enabled) {
        var metrics_context:  ptr                       = render_context;
        var state_context:    ptr                       = render_context;
        var selected_metrics: telemetry_admin.RenderFun = render_metrics;
        var selected_state:   telemetry_admin.RenderFun = render_state;
        if (selected_metrics::usize == 0) {
            selected_metrics = built_in_metrics;
            metrics_context  = runtime::ptr;
        }
        if (selected_state::usize == 0) {
            selected_state = built_in_state;
            state_context  = runtime::ptr;
        }
        val policy: telemetry_admin.Policy = telemetry_admin.Policy{
            listener:           schema.text(?graph.admin.listener),
            auth_context:       auth_context,
            authenticate:       authenticate,
            metrics_context:    metrics_context,
            render_metrics:     selected_metrics,
            state_context:      state_context,
            render_state:       selected_state,
            max_response_bytes: graph.admin.max_response_bytes,
        };
        if (!telemetry_admin.make(?runtime.admin, policy, ?runtime.health)) { ret false; }
    }
    runtime.initialized = true;
    ret true;
}

pub fun parse_trace(runtime: *Runtime, traceparent: str, tracestate: str, output: *telemetry_trace.Context) bool {
    if (runtime == nil || !runtime.initialized || !runtime.traces_enabled) { ret false; }
    ret telemetry_trace.parse_bounded(traceparent, tracestate, runtime.trace_state_bytes, output);
}

pub fun access(runtime: *Runtime, event: Access) sink.WriteReport {
    if (runtime == nil || !runtime.initialized || !runtime.logs_enabled) { ret sink.suppressed(); }
    var fields: [9]record.Field;
    fields[0] = record.field_string("kind", "access");
    fields[1] = record.field_string("listener", event.listener);
    fields[2] = record.field_string("method", event.method);
    fields[3] = record.field_string("target", event.target);
    fields[4] = record.field_string("protocol", event.protocol);
    fields[5] = record.field_u64("status", event.status::u64);
    fields[6] = record.field_u64("duration_us", event.duration_us);
    fields[7] = record.field_u64("request_bytes", event.request_bytes);
    fields[8] = record.field_u64("response_bytes", event.response_bytes);
    if (event.trace_id != nil && event.trace_id[0] != 0) {
        var traced: [10]record.Field;
        var i:      usize = 0;
        for (i < 9) {
            traced[i] = fields[i];
            i         = i + 1;
        }
        traced[9] = record.field_string("trace_id", event.trace_id);
        ret telemetry_log.emit(?runtime.logger, record.INFO, "request completed", ?traced[0], 10);
    }
    ret telemetry_log.emit(?runtime.logger, record.INFO, "request completed", ?fields[0], 9);
}

fun access_request(runtime: *Runtime, request: *message.Request, listener: str,
    protocol: str, status: u16, duration_us: u64, request_bytes: u64,
    response_bytes: u64, trace_id: str) sink.WriteReport {
    if (runtime == nil || !runtime.initialized || !runtime.logs_enabled) {
        ret sink.suppressed();
    }
    var fields: [10]record.Field;
    fields[0] = record.field_string("kind", "access");
    fields[1] = record.field_string("listener", listener);
    fields[2] = record.field_text("method", request.method.token.data,
        request.method.token.len);
    fields[3] = record.field_text("target", request.target.raw.data,
        request.target.raw.len);
    fields[4] = record.field_string("protocol", protocol);
    fields[5] = record.field_u64("status", status::u64);
    fields[6] = record.field_u64("duration_us", duration_us);
    fields[7] = record.field_u64("request_bytes", request_bytes);
    fields[8] = record.field_u64("response_bytes", response_bytes);
    var count: usize = 9;
    if (trace_id != nil && trace_id[0] != 0) {
        fields[9] = record.field_string("trace_id", trace_id);
        count     = 10;
    }
    ret telemetry_log.emit(?runtime.logger, record.INFO, "request completed",
        ?fields[0], count);
}

pub fun error(runtime: *Runtime, event: Failure) sink.WriteReport {
    if (runtime == nil || !runtime.initialized || !runtime.logs_enabled) { ret sink.suppressed(); }
    var fields: [5]record.Field;
    fields[0] = record.field_string("kind", "error");
    fields[1] = record.field_string("component", event.component);
    fields[2] = record.field_string("operation", event.operation);
    fields[3] = record.field_string("code", event.code);
    fields[4] = record.field_string("trace_id", event.trace_id);
    ret telemetry_log.emit(?runtime.logger, record.ERROR, event.message, ?fields[0], 5);
}

fun copy_header(request: *message.Request, name: str, name_length: usize,
    output: *u8, capacity: usize, combine: bool, found: *usize) bool {
    if (request == nil || output == nil || capacity == 0 || found == nil) {
        ret false;
    }
    var length: usize = 0;
    var i:      usize = 0;
    for (i < request.fields.len) {
        val item: *field.Field = ?request.fields.items[i];
        if (field.name_equal(item.name, view.view(name, name_length))) {
            if (!combine && @found != 0) { ret false; }
            if (@found != 0) {
                if (length + 1 >= capacity) { ret false; }
                output[length] = ',';
                length         = length + 1;
            }
            if (item.value.len > capacity - length - 1) { ret false; }
            var j: usize = 0;
            for (j < item.value.len) {
                output[length + j] = item.value.data[j];
                j                  = j + 1;
            }
            length = length + item.value.len;
            @found = @found + 1;
        }
        i = i + 1;
    }
    output[length] = 0;
    ret true;
}

fun observe_begin(context: ptr, active: *call.Call) bool {
    val runtime: *Runtime = context::*Runtime;
    if (runtime == nil || !runtime.initialized || active == nil
        || active.telemetry == nil) { ret false; }
    if (!runtime.traces_enabled) {
        active.telemetry.propagate = false;
        ret true;
    }
    val request:      *message.Request = call.request(active);
    var parent:       [telemetry_trace.TRACEPARENT_LENGTH + 1]u8;
    var state:        [telemetry_trace.TRACESTATE_CAPACITY + 1]u8;
    var parent_count: usize            = 0;
    var state_count:  usize            = 0;
    val parent_valid: bool             = copy_header(request, "traceparent", 11,
        ?parent[0], telemetry_trace.TRACEPARENT_LENGTH + 1, false,
        ?parent_count);
    val state_valid: bool = copy_header(request, "tracestate", 10,
        ?state[0], runtime.trace_state_bytes + 1, true, ?state_count);
    if (!parent_valid || parent_count != 1) {
        active.telemetry.propagate = true;
        ret true;
    }
    var state_text: str = nil;
    if (state_count != 0 && state_valid) { state_text = (?state[0])::str; }
    var parsed: telemetry_trace.Context;
    if (!telemetry_trace.parse_bounded((?parent[0])::str, state_text,
        runtime.trace_state_bytes, ?parsed)) { ret true; }
    if (!state_valid) {
        parsed.tracestate[0]    = 0;
        parsed.tracestate_len   = 0;
        parsed.tracestate_valid = false;
    }
    @active.telemetry = parsed;
    ret true;
}

fun protocol_name(version: message.Version) str {
    if (version.wire == message.WIRE_H1 && version.minor == 0) { ret "HTTP/1.0"; }
    if (version.wire == message.WIRE_H1)                       { ret "HTTP/1.1"; }
    if (version.wire == message.WIRE_H2)                       { ret "HTTP/2"; }
    ret "HTTP/3";
}

# the engine's closure names why a request ended before the outcome does: a
# request the connection took with it is not one the caller cancelled
fun failure_code(completion: *exchange.Completion) str {
    val cause: exchange.Cause = completion.closure.cause;
    if (cause == exchange.CAUSE_CONNECTION)  { ret "connection_closed"; }
    if (cause == exchange.CAUSE_TRANSPORT)   { ret "transport"; }
    if (cause == exchange.CAUSE_PEER_RESET)  { ret "peer_reset"; }
    if (cause == exchange.CAUSE_LOCAL_RESET) { ret "local_reset"; }
    if (cause == exchange.CAUSE_TIMEOUT
        || completion.outcome == exchange.OUTCOME_TIMED_OUT) { ret "timed_out"; }
    if (completion.outcome == exchange.OUTCOME_CANCELLED) { ret "cancelled"; }
    ret "failed";
}

fun request_failure(runtime: *Runtime, completion: *exchange.Completion,
    trace_id: str) sink.WriteReport {
    if (!runtime.logs_enabled) { ret sink.suppressed(); }
    var message: str = completion.error;
    if (message == nil || message[0] == 0) { message = "request did not complete"; }
    var fields: [7]record.Field;
    fields[0] = record.field_string("kind", "error");
    fields[1] = record.field_string("component", "request");
    fields[2] = record.field_string("operation", "serve");
    fields[3] = record.field_string("code", failure_code(completion));
    fields[4] = record.field_string("trace_id", trace_id);
    fields[5] = record.field_u64("close_code", completion.closure.code);
    fields[6] = record.field_u64("transport_error", completion.closure.detail);
    ret telemetry_log.emit(?runtime.logger, record.ERROR, message, ?fields[0], 7);
}

fun memory_refusal(runtime: *Runtime, active: *call.Call, trace_id: str) sink.WriteReport {
    if (!runtime.logs_enabled) { ret sink.suppressed(); }
    var fields: [6]record.Field;
    fields[0] = record.field_string("kind", "error");
    fields[1] = record.field_string("component", "request");
    fields[2] = record.field_string("code", "memory_exhausted");
    # a refusal before routing has no route to name
    var route: str = active.route.name;
    if (route == nil) { route = ""; }
    fields[3] = record.field_string("route", route);
    fields[4] = record.field_u64("memory_bytes", call.memory_capacity(active)::u64);
    var count: usize = 5;
    if (trace_id != nil && trace_id[0] != 0) {
        fields[5] = record.field_string("trace_id", trace_id);
        count     = 6;
    }
    ret telemetry_log.emit(?runtime.logger, record.ERROR,
        "request memory bound was exhausted", ?fields[0], count);
}

# the request's age on the monotonic clock, in microseconds. a call bound
# before the stamp existed measures as zero rather than as a clock reading
fun request_elapsed_us(active: *call.Call, now_ns: u64) u64 {
    if (active.received_ns == 0 || now_ns < active.received_ns) { ret 0; }
    ret (now_ns - active.received_ns) / 1000;
}

fun observe_end(context: ptr, active: *call.Call, complete: bool) {
    val runtime: *Runtime = context::*Runtime;
    if (runtime == nil || !runtime.initialized || active == nil
        || active.exchange == nil) { ret; }
    val request:    *message.Request    = call.request(active);
    val completion: exchange.Completion = active.exchange.completion;
    val elapsed_us: u64                 = request_elapsed_us(active, clock.monotonic_ns());
    var trace_id:   [33]u8;
    var trace_text: str                 = nil;
    if (telemetry_trace.format_id(active.telemetry, ?trace_id[0], 33) != 0) {
        trace_text = (?trace_id[0])::str;
    }
    if (runtime.metrics_enabled) {
        telemetry_metrics.counter_add(?runtime.metrics, runtime.requests, 1);
        telemetry_metrics.counter_add(?runtime.metrics, runtime.request_bytes,
            completion.bytes_in);
        telemetry_metrics.counter_add(?runtime.metrics, runtime.response_bytes,
            completion.bytes_out);
        telemetry_metrics.observe(?runtime.metrics, runtime.duration_us, elapsed_us);
        if (!complete || completion.outcome != exchange.OUTCOME_OK) {
            telemetry_metrics.counter_add(?runtime.metrics, runtime.failures, 1);
        }
        if (call.memory_refused(active)) {
            telemetry_metrics.counter_add(?runtime.metrics, runtime.memory_refusals, 1);
        }
    }
    access_request(runtime, request, active.listener,
        protocol_name(request.metadata.version), completion.status,
        elapsed_us, completion.bytes_in, completion.bytes_out, trace_text);
    # whatever a service made of the refusal, the log names the bound it hit
    if (call.memory_refused(active)) {
        memory_refusal(runtime, active, trace_text);
    }
    if (!complete || completion.outcome != exchange.OUTCOME_OK) {
        request_failure(runtime, ?completion, trace_text);
    }
}

# report the QUIC runtime's running total of Retry tokens refused at the replay
# bound, which a full store turns into dropped Initials the client retransmits
pub fun quic_replay_full(runtime: *Runtime, total: u64) {
    if (runtime == nil || total <= runtime.replay_full_seen) { ret; }
    if (runtime.metrics_enabled) {
        telemetry_metrics.counter_add(?runtime.metrics, runtime.replay_full,
            total - runtime.replay_full_seen);
    }
    runtime.replay_full_seen = total;
}

fun report_rise(runtime: *Runtime, token: telemetry_metrics.Token, total: u64,
    seen: *u64) {
    if (total <= @seen) { ret; }
    if (runtime.metrics_enabled) {
        telemetry_metrics.counter_add(?runtime.metrics, token, total - @seen);
    }
    @seen = total;
}

# the QUIC runtime's handshake admission: what holds a slot now and the running
# totals since it was made
pub rec HandshakeReport {
    in_flight:        usize;
    connections:      usize;
    service_ns:       u64;
    deferred:         u64;
    promoted:         u64;
    completed:        u64;
    dropped:          u64;
    refused:          u64;
    expired:          u64;
    finish_ns:        u64;
    retries_dropped:  u64;
    arrivals_dropped: [ARRIVAL_CLASSES]u64;
}

# the classes an unknown datagram is dropped under at a pump's arrival queue,
# the `class` label of hedge_quic_arrivals_dropped_total
pub val ARRIVAL_TOKEN:     usize = 0;
pub val ARRIVAL_UNTOKEN:   usize = 1;
pub val ARRIVAL_OTHER:     usize = 2;
pub val ARRIVAL_DUPLICATE: usize = 3;
pub val ARRIVAL_CLASSES:   usize = 4;

fun arrival_class_name(class: usize) str {
    if (class == ARRIVAL_TOKEN)     { ret "token"; }
    if (class == ARRIVAL_UNTOKEN)   { ret "untoken"; }
    if (class == ARRIVAL_DUPLICATE) { ret "duplicate"; }
    ret "other";
}

fun register_arrival_classes(runtime: *Runtime) bool {
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        var label: [1]telemetry_metrics.LabelView = [1]telemetry_metrics.LabelView{
            telemetry_metrics.LabelView{key: "class", value: arrival_class_name(class)}
        };
        if (!telemetry_metrics.register(?runtime.metrics, telemetry_metrics.COUNTER,
            "hedge_quic_arrivals_dropped_total", ?label[0], 1, nil, 0,
            ?runtime.arrivals_dropped[class])) { ret false; }
        class = class + 1;
    }
    ret true;
}

pub fun quic_handshakes(runtime: *Runtime, report: HandshakeReport) {
    if (runtime == nil) { ret; }
    if (runtime.metrics_enabled) {
        telemetry_metrics.gauge_set(?runtime.metrics, runtime.handshakes_in_flight,
            report.in_flight::i64);
        telemetry_metrics.gauge_set(?runtime.metrics, runtime.quic_connections,
            report.connections::i64);
        telemetry_metrics.gauge_set(?runtime.metrics, runtime.handshake_service_ns,
            report.service_ns::i64);
        telemetry_metrics.gauge_set(?runtime.metrics, runtime.handshake_finish_ns,
            report.finish_ns::i64);
    }
    report_rise(runtime, runtime.handshakes_deferred, report.deferred,
        ?runtime.handshakes_deferred_seen);
    report_rise(runtime, runtime.handshakes_promoted, report.promoted,
        ?runtime.handshakes_promoted_seen);
    report_rise(runtime, runtime.handshakes_completed, report.completed,
        ?runtime.handshakes_completed_seen);
    report_rise(runtime, runtime.handshakes_dropped, report.dropped,
        ?runtime.handshakes_dropped_seen);
    report_rise(runtime, runtime.handshakes_refused, report.refused,
        ?runtime.handshakes_refused_seen);
    report_rise(runtime, runtime.handshakes_expired, report.expired,
        ?runtime.handshakes_expired_seen);
    report_rise(runtime, runtime.retries_dropped, report.retries_dropped,
        ?runtime.retries_dropped_seen);
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        report_rise(runtime, runtime.arrivals_dropped[class],
            report.arrivals_dropped[class], ?runtime.arrivals_dropped_seen[class]);
        class = class + 1;
    }
}

val LANE_COUNT: usize = 5;

fun lane_name(lane: usize) str {
    if (lane == hedge_memory.LANE_SEND::usize)    { ret "send"; }
    if (lane == hedge_memory.LANE_RECEIVE::usize) { ret "receive"; }
    if (lane == hedge_memory.LANE_TLS::usize)     { ret "tls"; }
    if (lane == hedge_memory.LANE_IO::usize)      { ret "io"; }
    ret "request";
}

fun register_lanes(runtime: *Runtime) bool {
    var lane: usize = 0;
    for (lane < LANE_COUNT) {
        var label: [1]telemetry_metrics.LabelView = [1]telemetry_metrics.LabelView{
            telemetry_metrics.LabelView{key: "lane", value: lane_name(lane)}
        };
        if (!telemetry_metrics.register(?runtime.metrics, telemetry_metrics.GAUGE,
            "hedge_memory_held_bytes", ?label[0], 1, nil, 0,
            ?runtime.memory_held[lane])
            || !telemetry_metrics.register(?runtime.metrics, telemetry_metrics.COUNTER,
            "hedge_memory_refusals_total", ?label[0], 1, nil, 0,
            ?runtime.memory_refused[lane])
            || !telemetry_metrics.register(?runtime.metrics, telemetry_metrics.COUNTER,
            "hedge_memory_timeouts_total", ?label[0], 1, nil, 0,
            ?runtime.memory_timeouts[lane])) { ret false; }
        lane = lane + 1;
    }
    ret true;
}

fun rise(total: u64, seen: u64) u64 {
    if (total <= seen) { ret 0; }
    ret total - seen;
}

# report a worker pool's running totals, so each report adds only the rise.
# a refusal is any acquire the lane could not fund, whether or not it waited
pub fun timers(runtime: *Runtime, claimed: usize, armed: usize) {
    if (runtime == nil || !runtime.metrics_enabled) { ret; }
    telemetry_metrics.gauge_set(?runtime.metrics, runtime.timers_claimed, claimed::i64);
    telemetry_metrics.gauge_set(?runtime.metrics, runtime.timers_armed, armed::i64);
}

pub fun memory(runtime: *Runtime, pool: hedge_memory.Snapshot, refused_connections: u64) {
    if (runtime == nil) { ret; }
    if (runtime.metrics_enabled) {
        var lane: usize = 0;
        for (lane < LANE_COUNT) {
            val now:  hedge_memory.LaneCounters  = pool.lanes[lane];
            val seen: *hedge_memory.LaneCounters = ?runtime.memory_seen[lane];
            telemetry_metrics.gauge_set(?runtime.metrics, runtime.memory_held[lane],
                now.held::i64);
            val refused: u64 = rise(now.refusals + now.exhausted,
                seen.refusals + seen.exhausted);
            if (refused != 0) {
                telemetry_metrics.counter_add(?runtime.metrics,
                    runtime.memory_refused[lane], refused);
            }
            val timeouts: u64 = rise(now.timeouts, seen.timeouts);
            if (timeouts != 0) {
                telemetry_metrics.counter_add(?runtime.metrics,
                    runtime.memory_timeouts[lane], timeouts);
            }
            lane = lane + 1;
        }
        val connections: u64 = rise(refused_connections, runtime.refused_memory_seen);
        if (connections != 0) {
            telemetry_metrics.counter_add(?runtime.metrics, runtime.refused_connections,
                connections);
        }
    }
    runtime.memory_seen = pool.lanes;
    if (refused_connections > runtime.refused_memory_seen) {
        runtime.refused_memory_seen = refused_connections;
    }
}

pub fun observer(runtime: *Runtime) call.Observer {
    if (runtime == nil || !runtime.initialized) { ret call.no_observer(); }
    ret call.Observer{ctx: runtime::ptr, begin: observe_begin, end: observe_end};
}

pub fun begin_ready(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.initialized) { ret false; }
    ret telemetry_health.begin_accepting(?runtime.health);
}

pub fun begin_drain(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.initialized) { ret false; }
    ret telemetry_health.begin_drain(?runtime.health);
}

pub fun shutdown(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.initialized) { ret false; }
    telemetry_health.begin_drain(?runtime.health);
    var flushed: bool = true;
    if (runtime.logs_enabled && runtime.flush::usize != 0) { flushed = runtime.flush(runtime.flush_context); }
    runtime.initialized = false;
    ret flushed;
}

rec TestOutput {
    writes: usize;
    len:    usize;
    buffer: [1024]u8;
}

rec TestFlush {
    calls:   usize;
    succeed: bool;
}

rec TestRender {
    calls: usize;
}

fun test_publish(context: ptr, data: *u8, length: usize) sink.WriteReport {
    val output: *TestOutput = context::*TestOutput;
    output.writes = output.writes + 1;
    if (data != nil && length > 0) {
        var copy_len: usize = length;
        if (copy_len > 1024 - output.len) {
            copy_len = 1024 - output.len;
        }
        var i: usize = 0;
        for (i < copy_len) {
            output.buffer[output.len + i] = data[i];
            i                             = i + 1;
        }
        output.len = output.len + copy_len;
    }
    ret sink.persisted(length);
}

fun buffer_contains(data: *u8, len: usize, needle: str) bool {
    val nlen: usize = str_len(needle);
    if (nlen == 0)                 { ret true; }
    if (len < nlen || data == nil) { ret false; }
    var i: usize = 0;
    for (i <= len - nlen) {
        var j:       usize = 0;
        var matched: bool  = true;
        for (j < nlen) {
            if (data[i + j] != needle[j]) {
                matched = false;
            }
            j = j + 1;
        }
        if (matched) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun test_queue_publish(context: ptr, data: *u8, length: usize) sink.WriteReport {
    val output: *TestOutput = context::*TestOutput;
    output.writes = output.writes + 1;
    ret sink.enqueued(length);
}

fun test_flush(context: ptr) bool {
    val state: *TestFlush = context::*TestFlush;
    state.calls = state.calls + 1;
    ret state.succeed;
}

fun test_auth(context: ptr, value: str) bool {
    ret true;
}

fun test_render(context: ptr, output: *u8, capacity: usize) usize {
    if (capacity == 0) { ret 0; }
    output[0] = 'x';
    ret 1;
}

fun test_context_render(context: ptr, output: *u8, capacity: usize) usize {
    val state: *TestRender = context::*TestRender;
    state.calls = state.calls + 1;
    ret copy_text(output, capacity, "custom_metric 1\n");
}

test "telemetry: access, readiness, and flush share one bounded runtime" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs             = true;
    graph.telemetry.metrics          = true;
    graph.telemetry.metric_series    = BUILT_IN_METRIC_SERIES;
    graph.telemetry.log_record_bytes = 512;
    graph.admin.enabled              = false;
    var target: TestOutput;
    target.writes = 0;
    val contract: sink.Contract = sink.Contract{delivery: sink.DELIVERY_DIRECT, max_record: 512, oversize: record.OVERSIZE_REJECT, adapter: sink.ADAPTER_CUSTOM, target_atomic_limit: 0, queue_capacity: 0, overload: sink.OVERLOAD_REJECT_NEW};
    var output:   sink.Sink     = sink.Sink{ctx: (?target)::ptr, f_publish: test_publish, contract: contract};
    var series:   [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks:   [2]telemetry_health.Check;
    var runtime:  Runtime;
    if (!make(?runtime, ?graph, ?output, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 2, nil, test_auth, nil, test_render, test_render,
        nil, (0::usize)::FlushFun)) { ret 1; }
    if (!begin_ready(?runtime)) { ret 2; }
    val report: sink.WriteReport = access(?runtime, Access{listener: "public", method: "GET", target: "/", protocol: "HTTP/1.1", status: 200, duration_us: 10, request_bytes: 0, response_bytes: 2, trace_id: nil});
    if (!status_persisted(report.status) || target.writes != 1 || !telemetry_health.snapshot(?runtime.health).ready)                                                                                 { ret 3; }
    if (!status_persisted(error(?runtime, Failure{component: "listener", operation: "accept", code: "EMFILE", message: "descriptor budget exhausted", trace_id: nil}).status) || target.writes != 2) { ret 4; }
    if (!shutdown(?runtime) || telemetry_health.snapshot(?runtime.health).ready)                                                                                                                     { ret 5; }
    ret 0;
}

test "telemetry: access log encodes method and target as text, not hex" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs             = true;
    graph.telemetry.log_record_bytes = 512;
    graph.admin.enabled              = false;
    var target: TestOutput;
    target.writes = 0;
    target.len    = 0;
    val contract: sink.Contract = sink.Contract{delivery: sink.DELIVERY_DIRECT, max_record: 512, oversize: record.OVERSIZE_REJECT, adapter: sink.ADAPTER_CUSTOM, target_atomic_limit: 0, queue_capacity: 0, overload: sink.OVERLOAD_REJECT_NEW};
    var output:   sink.Sink     = sink.Sink{ctx: (?target)::ptr, f_publish: test_publish, contract: contract};
    var checks:   [1]telemetry_health.Check;
    var runtime:  Runtime;
    if (!make(?runtime, ?graph, ?output, nil, 0, ?checks[0], 1, nil, test_auth, nil, test_render, test_render, nil, (0::usize)::FlushFun)) { ret 1; }
    var request: message.Request;
    request.method     = method.from_kind(method.GET);
    request.target.raw = view.view("/hello", 6);
    val report: sink.WriteReport = access_request(?runtime, ?request, "public", "HTTP/1.1", 200, 10, 0, 2, nil);
    if (!status_persisted(report.status) || target.writes != 1)               { ret 2; }
    if (!buffer_contains(?target.buffer[0], target.len, "method=\"GET\""))    { ret 3; }
    if (!buffer_contains(?target.buffer[0], target.len, "target=\"/hello\"")) { ret 4; }
    if (buffer_contains(?target.buffer[0], target.len, "0x47"))               { ret 5; }
    ret 0;
}

test "telemetry: bounded queue flushes exactly once during shutdown" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs             = true;
    graph.telemetry.log_record_bytes = 512;
    graph.telemetry.log_queue_depth  = 1;
    var target: TestOutput;
    target.writes = 0;
    val contract:    sink.Contract = sink.Contract{delivery: sink.DELIVERY_BOUNDED_QUEUED, max_record: 512, oversize: record.OVERSIZE_REJECT, adapter: sink.ADAPTER_CUSTOM, target_atomic_limit: 0, queue_capacity: 1, overload: sink.OVERLOAD_REJECT_NEW};
    var output:      sink.Sink     = sink.Sink{ctx: (?target)::ptr, f_publish: test_queue_publish, contract: contract};
    var checks:      [1]telemetry_health.Check;
    var runtime:     Runtime;
    var flush_state: TestFlush;
    flush_state.calls   = 0;
    flush_state.succeed = true;
    if (!make(?runtime, ?graph, ?output, nil, 0, ?checks[0], 1, nil, test_auth, nil, test_render, test_render, (?flush_state)::ptr, test_flush))                                                                  { ret 1; }
    if (!status_enqueued(access(?runtime, Access{listener: "public", method: "GET", target: "/", protocol: "HTTP/1.1", status: 200, duration_us: 1, request_bytes: 0, response_bytes: 0, trace_id: nil}).status)) { ret 2; }
    if (!shutdown(?runtime) || flush_state.calls != 1 || target.writes != 1)                                                                                                                                      { ret 3; }
    if (shutdown(?runtime) || flush_state.calls != 1)                                                                                                                                                             { ret 4; }
    flush_state.calls   = 0;
    flush_state.succeed = false;
    var failed_checks:  [1]telemetry_health.Check;
    var failed_runtime: Runtime;
    if (!make(?failed_runtime, ?graph, ?output, nil, 0, ?failed_checks[0], 1, nil, test_auth, nil, test_render, test_render, (?flush_state)::ptr, test_flush)) { ret 5; }
    if (shutdown(?failed_runtime) || flush_state.calls != 1)                                                                                                   { ret 6; }
    ret 0;
}

test "telemetry: built-in administration keeps custom renderer ownership" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs           = false;
    graph.telemetry.metrics        = true;
    graph.telemetry.metric_series  = BUILT_IN_METRIC_SERIES;
    graph.admin.enabled            = true;
    graph.admin.max_response_bytes = 256;
    schema.set_text(?graph.admin.listener, "admin");
    var series:       [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks:       [1]telemetry_health.Check;
    var render_state: TestRender;
    render_state.calls = 0;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 1, nil, test_auth, (?render_state)::ptr,
        test_context_render, (0::usize)::telemetry_admin.RenderFun,
        nil, (0::usize)::FlushFun)) { ret 1; }
    var output:   [256]u8;
    var response: telemetry_admin.Response;
    if (!telemetry_admin.handle(?runtime.admin, telemetry_admin.Request{listener: "admin", method: "GET", path: "/metrics", authorization: "Bearer test"}, ?output[0], 256, ?response)
        || response.status != 200 || render_state.calls != 1) { ret 2; }
    if (!telemetry_admin.handle(?runtime.admin, telemetry_admin.Request{listener: "admin", method: "GET", path: "/state", authorization: "Bearer test"}, ?output[0], 256, ?response)
        || response.status != 200 || render_state.calls != 1) { ret 3; }
    ret 0;
}

test "telemetry: trace propagation obeys the configured state budget" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs              = false;
    graph.telemetry.traces            = true;
    graph.telemetry.trace_state_bytes = 8;
    var checks:  [1]telemetry_health.Check;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, nil, 0, ?checks[0], 1, nil, test_auth, nil, test_render, test_render, nil, (0::usize)::FlushFun)) { ret 1; }
    var context:     telemetry_trace.Context;
    val traceparent: str = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
    if (!parse_trace(?runtime, traceparent, "a=value", ?context))                                                                 { ret 2; }
    if (!parse_trace(?runtime, traceparent, "vendor=value", ?context) || context.tracestate_valid || context.tracestate_len != 0) { ret 3; }
    ret 0;
}

test "telemetry: QUIC replay refusals are counted once each" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs          = false;
    graph.telemetry.metrics       = true;
    graph.telemetry.metric_series = BUILT_IN_METRIC_SERIES;
    graph.admin.enabled           = false;
    var series:  [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks:  [2]telemetry_health.Check;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 2, nil, test_auth, nil, test_render, test_render,
        nil, (0::usize)::FlushFun)) { ret 1; }
    # the runtime reports a running total, so a repeated total adds nothing
    quic_replay_full(?runtime, 3);
    quic_replay_full(?runtime, 3);
    quic_replay_full(?runtime, 5);
    var sampled: telemetry_metrics.Sample;
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.replay_full, ?sampled)) { ret 2; }
    if (sampled.value != 5)                                                         { ret (10 + sampled.value)::i32; }
    ret 0;
}

test "telemetry: the live QUIC connection gauge follows each report" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs          = false;
    graph.telemetry.metrics       = true;
    graph.telemetry.metric_series = BUILT_IN_METRIC_SERIES;
    graph.admin.enabled           = false;
    var series:  [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks:  [2]telemetry_health.Check;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 2, nil, test_auth, nil, test_render, test_render,
        nil, (0::usize)::FlushFun)) { ret 1; }
    var report: HandshakeReport;
    report.connections = 3445;
    quic_handshakes(?runtime, report);
    var sampled: telemetry_metrics.Sample;
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.quic_connections, ?sampled)
        || sampled.signed_value != 3445) { ret 2; }
    report.connections = 0;
    quic_handshakes(?runtime, report);
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.quic_connections, ?sampled)
        || sampled.signed_value != 0) { ret 3; }
    ret 0;
}

test "telemetry: pool lanes report held bytes and add only the rise in refusals" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.telemetry.logs          = false;
    graph.telemetry.metrics       = true;
    graph.telemetry.metric_series = BUILT_IN_METRIC_SERIES;
    graph.admin.enabled           = false;
    var series:  [BUILT_IN_METRIC_SERIES]telemetry_metrics.Series;
    var checks:  [2]telemetry_health.Check;
    var runtime: Runtime;
    if (!make(?runtime, ?graph, nil, ?series[0], BUILT_IN_METRIC_SERIES,
        ?checks[0], 2, nil, test_auth, nil, test_render, test_render,
        nil, (0::usize)::FlushFun)) { ret 1; }
    var pool: hedge_memory.Snapshot;
    val io:   usize = hedge_memory.LANE_IO::usize;
    pool.lanes[io].held      = 4096;
    pool.lanes[io].refusals  = 1;
    pool.lanes[io].exhausted = 2;
    pool.lanes[io].timeouts  = 1;
    memory(?runtime, pool, 2);
    memory(?runtime, pool, 2);
    pool.lanes[io].held     = 0;
    pool.lanes[io].timeouts = 3;
    memory(?runtime, pool, 5);
    var sampled: telemetry_metrics.Sample;
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.memory_held[io], ?sampled)
        || sampled.signed_value != 0) { ret 2; }
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.memory_refused[io], ?sampled)
        || sampled.value != 3) { ret 3; }
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.memory_timeouts[io], ?sampled)
        || sampled.value != 3) { ret 4; }
    if (!telemetry_metrics.sample(?runtime.metrics, runtime.refused_connections, ?sampled)
        || sampled.value != 5) { ret 5; }
    ret 0;
}

test "telemetry: request duration is measured on the monotonic clock" {
    var active: call.Call;
    active.received_ns = 5000000000;
    # a request stamped with a far-off calendar receipt still measures from the
    # monotonic stamp alone
    if (request_elapsed_us(?active, 5000000000) != 0)    { ret 1; }
    if (request_elapsed_us(?active, 5002500000) != 2500) { ret 2; }
    # the monotonic clock never runs backwards, so a reading before the stamp
    # is a call bound elsewhere and measures as zero rather than wrapping
    if (request_elapsed_us(?active, 4999000000) != 0) { ret 3; }
    active.received_ns = 0;
    if (request_elapsed_us(?active, 5002500000) != 0) { ret 4; }
    ret 0;
}

# the failure code names the engine's closure first: a request a connection
# took with it, a reset from either side or a transport fault is not a caller
# cancellation, and only a closure the engine did not make falls back to the
# outcome (#248)
test "telemetry: a request failure is coded by the engine's closure before its outcome" {
    var completion: exchange.Completion;
    completion.outcome = exchange.OUTCOME_CANCELLED;
    completion.closure = exchange.no_closure();
    if (!str_equals(failure_code(?completion), "cancelled")) { ret 1; }
    completion.closure = exchange.closure(exchange.CAUSE_CALLER, 268, 0);
    if (!str_equals(failure_code(?completion), "cancelled")) { ret 2; }
    completion.closure = exchange.closure(exchange.CAUSE_CONNECTION, 0x101, 0);
    if (!str_equals(failure_code(?completion), "connection_closed")) { ret 3; }
    completion.closure = exchange.closure(exchange.CAUSE_TRANSPORT, 0x102, 7);
    if (!str_equals(failure_code(?completion), "transport")) { ret 4; }
    completion.closure = exchange.closure(exchange.CAUSE_PEER_RESET, 0x10c, 0);
    if (!str_equals(failure_code(?completion), "peer_reset")) { ret 5; }
    completion.closure = exchange.closure(exchange.CAUSE_LOCAL_RESET, 0x10c, 0);
    if (!str_equals(failure_code(?completion), "local_reset")) { ret 6; }
    completion.closure = exchange.closure(exchange.CAUSE_TIMEOUT, 0, 0);
    if (!str_equals(failure_code(?completion), "timed_out")) { ret 7; }
    completion.closure = exchange.no_closure();
    completion.outcome = exchange.OUTCOME_TIMED_OUT;
    if (!str_equals(failure_code(?completion), "timed_out")) { ret 8; }
    completion.outcome = exchange.OUTCOME_FAILED;
    if (!str_equals(failure_code(?completion), "failed")) { ret 9; }
    ret 0;
}
