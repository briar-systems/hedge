# a file of key material, read straight into secret storage
#
# every key file hedge reads comes through here: TLS private keys, QUIC listener
# key files and the ACME key store. one open handle is checked and then read, so
# the file checked is the file read. a file group or other can read is refused
# before a byte of it is read. windows synthesizes the mode from attributes, so
# it says nothing about who may read the file and the check is skipped there.

use std.allocator;
use std.allocator.page;
use std.filesystem;
use io_error:      std.io.error;
use secret_memory: std.memory.secret;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub def Status: u8;
pub val OK:         Status = 0;
pub val UNREADABLE: Status = 1;
# group or other may read it
pub val EXPOSED: Status = 2;
# it holds more than the caller's bound
pub val TOO_LARGE: Status = 3;

pub fun message(status: Status) str {
    if (status == OK)        { ret "the key file was read"; }
    if (status == EXPOSED)   { ret "the key file can be read by group or other; restrict it with chmod 600"; }
    if (status == TOO_LARGE) { ret "the key file is larger than any key it could hold"; }
    ret "the key file cannot be read";
}

# whether group or other may read the file behind `metadata`
pub fun exposed(metadata: filesystem.Metadata) bool {
    $if ($mach.build.os == $mach.os.windows) { ret false; }
    $or                                      { ret (metadata.mode & 0o077) != 0; }
}

# the whole file at `path` into secret storage at `output`, which the caller
# releases with `release`. a file of `limit` bytes or more is TOO_LARGE.
# anything but OK leaves `output` empty
pub fun read(path: str, limit: usize, output: *filesystem.SecretBytes) Status {
    output.data = nil;
    output.size = 0;
    if (path == nil || path[0] == 0) { ret UNREADABLE; }
    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { ret UNREADABLE; }
    var handle: filesystem.File     = opened.ok;
    val status: Status              = read_of(handle, limit, output);
    val closed: err[io_error.Error] = filesystem.close(?handle);
    if (status == OK && (sel closed.err)) {
        release(output);
        ret UNREADABLE;
    }
    ret status;
}

fun read_of(handle: filesystem.File, limit: usize, output: *filesystem.SecretBytes) Status {
    val metadata: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(handle);
    if (sel metadata.err)          { ret UNREADABLE; }
    if (exposed(metadata.ok))      { ret EXPOSED; }
    if (metadata.ok.size >= limit) { ret TOO_LARGE; }
    val read: res[filesystem.SecretBytes, filesystem.FsError] = filesystem.read_secret_of(handle);
    if (sel read.err) { ret UNREADABLE; }
    @output = read.ok;
    # a file that grew past the bound between the stat and the read is no key
    if (output.size >= limit) {
        release(output);
        ret TOO_LARGE;
    }
    ret OK;
}

# wipe and free what `read` returned
pub fun release(bytes: *filesystem.SecretBytes) {
    if (bytes.data != nil) { secret_memory.deallocate(bytes.data, bytes.size); }
    bytes.data = nil;
    bytes.size = 0;
}

# `length` bytes at `path`, readable by the owner alone. the file is replaced
# atomically, so tests writing one path at once never see part of it, and a
# file left by an earlier run cannot keep a wider mode
#[testing]
pub fun write_owner_only(path: str, data: *u8, length: usize) bool {
    var heap:  allocator.Allocator;
    val ready: err[allocator.Error] = page.make(?heap);
    if (sel ready.err) { ret false; }
    val written: err[filesystem.FsError] = filesystem.replace_bytes_atomic(?heap, path, data,
        length, 0o600, 0o755);
    ret sel written.ok;
}

# the checked-in test material at `source`, copied owner-only to `destination`,
# since git keeps no mode bit but the executable one. `destination` either way,
# so a failed copy shows as the key file it could not read
#[testing]
pub fun owner_only(source: str, destination: str) str {
    var heap:  allocator.Allocator;
    val ready: err[allocator.Error] = page.make(?heap);
    if (sel ready.err) { ret destination; }
    val text: res[str, filesystem.FsError] = filesystem.read_string(?heap, source);
    if (sel text.err) { ret destination; }
    val length: usize                = str_len(text.ok);
    val copied: bool                 = write_owner_only(destination, text.ok::*u8, length);
    val freed:  err[allocator.Error] = allocator.deallocate[u8](?heap, text.ok::*u8, length + 1);
    ret destination;
}
