# immutable middleware plans with explicit before, after, and error paths

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use http.core.exchange;
use http.core.status;
use call: hedge.dispatch.call;

pub def Decision: u8;
pub val CONTINUE: Decision = 1;
pub val RESPOND: Decision = 2;
pub val FAIL: Decision = 3;

pub val ANY_ROUTE: str = "*";

# before may short-circuit, after observes a settled exchange, on_error observes a failure
pub def BeforeFun: fun(ptr, *call.Call) Decision;
pub def AfterFun: fun(ptr, *call.Call);
pub def ErrorFun: fun(ptr, *call.Call, exchange.ServiceStatus);

pub rec Middleware {
    ctx: ptr;
    before: BeforeFun;
    after: AfterFun;
    on_error: ErrorFun;
}

pub fun valid(item: Middleware) bool {
    ret item.before::usize != 0 || item.after::usize != 0 || item.on_error::usize != 0;
}

# a named run of middleware supplied at composition time; `*` applies to any route
# that names no run of its own
pub rec Chain {
    route: str;
    items: *Middleware;
    count: usize;
    start: usize;
    installed: bool;
}

pub rec Chains {
    items: *Chain;
    capacity: usize;
    len: usize;
}

pub fun make_chains(chains: *Chains, items: *Chain, capacity: usize) bool {
    if (chains == nil || (capacity != 0 && items == nil)) { ret false; }
    chains.items = items;
    chains.capacity = capacity;
    chains.len = 0;
    ret true;
}

pub fun add_chain(chains: *Chains, route: str, items: *Middleware, count: usize) bool {
    if (chains == nil || chains.len >= chains.capacity || route == nil
     || (count != 0 && items == nil)) { ret false; }
    var i: usize = 0;
    for (i < count) {
        if (!valid(items[i])) { ret false; }
        i = i + 1;
    }
    val slot: *Chain = ?chains.items[chains.len];
    chains.len = chains.len + 1;
    slot.route = route;
    slot.items = items;
    slot.count = count;
    slot.start = 0;
    slot.installed = false;
    ret true;
}

# copy every declared run into the plan's contiguous storage exactly once, so a
# request walks an index range and never constructs a chain
pub fun install(chains: *Chains, storage: *Middleware, capacity: usize, installed: *usize) bool {
    if (installed == nil) { ret false; }
    @installed = 0;
    if (chains == nil || chains.len == 0) { ret true; }
    if (storage == nil && capacity != 0) { ret false; }
    var used: usize = 0;
    var i: usize = 0;
    for (i < chains.len) {
        val chain: *Chain = ?chains.items[i];
        if (used + chain.count > capacity) { ret false; }
        var j: usize = 0;
        for (j < chain.count) {
            storage[used + j] = chain.items[j];
            j = j + 1;
        }
        chain.start = used;
        chain.installed = true;
        used = used + chain.count;
        i = i + 1;
    }
    @installed = used;
    ret true;
}

pub fun select(chains: *Chains, route: str, start: *usize, count: *usize) bool {
    if (start == nil || count == nil) { ret false; }
    @start = 0;
    @count = 0;
    if (chains == nil || route == nil) { ret false; }
    var fallback: *Chain = nil;
    var i: usize = 0;
    for (i < chains.len) {
        val chain: *Chain = ?chains.items[i];
        if (!chain.installed) { i = i + 1; cnt; }
        if (str_equals(chain.route, route)) {
            @start = chain.start;
            @count = chain.count;
            ret true;
        }
        if (str_equals(chain.route, ANY_ROUTE)) { fallback = chain; }
        i = i + 1;
    }
    if (fallback == nil) { ret false; }
    @start = fallback.start;
    @count = fallback.count;
    ret true;
}

# run the before path in order, reporting how many entries committed so their
# after and error paths unwind over exactly the entries that ran
pub fun run_before(storage: *Middleware, start: usize, count: usize, active: *call.Call,
    ran: *usize) Decision {
    if (ran == nil) { ret FAIL; }
    @ran = 0;
    if (count == 0) { ret CONTINUE; }
    if (storage == nil || active == nil) { ret FAIL; }
    var i: usize = 0;
    for (i < count) {
        val item: *Middleware = ?storage[start + i];
        @ran = i + 1;
        if (item.before::usize != 0) {
            val decision: Decision = item.before(item.ctx, active);
            if (decision != CONTINUE) { ret decision; }
        }
        i = i + 1;
    }
    ret CONTINUE;
}

pub fun run_after(storage: *Middleware, start: usize, ran: usize, active: *call.Call) {
    if (storage == nil || active == nil || ran == 0) { ret; }
    var i: usize = ran;
    for (i > 0) {
        i = i - 1;
        val item: *Middleware = ?storage[start + i];
        if (item.after::usize != 0) { item.after(item.ctx, active); }
    }
}

pub fun run_error(storage: *Middleware, start: usize, ran: usize, active: *call.Call,
    outcome: exchange.ServiceStatus) {
    if (storage == nil || active == nil || ran == 0) { ret; }
    var i: usize = ran;
    for (i > 0) {
        i = i - 1;
        val item: *Middleware = ?storage[start + i];
        if (item.on_error::usize != 0) { item.on_error(item.ctx, active, outcome); }
    }
}

rec Recorder {
    before_calls: usize;
    after_calls: usize;
    error_calls: usize;
    decision: Decision;
}

fun record_before(context: ptr, active: *call.Call) Decision {
    val state: *Recorder = context::*Recorder;
    state.before_calls = state.before_calls + 1;
    ret state.decision;
}

fun record_after(context: ptr, active: *call.Call) {
    val state: *Recorder = context::*Recorder;
    state.after_calls = state.after_calls + 1;
}

fun record_error(context: ptr, active: *call.Call, outcome: exchange.ServiceStatus) {
    val state: *Recorder = context::*Recorder;
    state.error_calls = state.error_calls + 1;
}

test "middleware: a short circuit unwinds exactly the entries that ran" {
    var first: Recorder = Recorder{before_calls: 0, after_calls: 0, error_calls: 0, decision: CONTINUE};
    var second: Recorder = Recorder{before_calls: 0, after_calls: 0, error_calls: 0, decision: RESPOND};
    var third: Recorder = Recorder{before_calls: 0, after_calls: 0, error_calls: 0, decision: CONTINUE};
    var items: [3]Middleware;
    items[0] = Middleware{ctx: (?first)::ptr, before: record_before, after: record_after, on_error: record_error};
    items[1] = Middleware{ctx: (?second)::ptr, before: record_before, after: record_after, on_error: record_error};
    items[2] = Middleware{ctx: (?third)::ptr, before: record_before, after: record_after, on_error: record_error};
    var storage: [3]Middleware;
    var chains_storage: [1]Chain;
    var chains: Chains;
    if (!make_chains(?chains, ?chains_storage[0], 1)) { ret 1; }
    if (!add_chain(?chains, ANY_ROUTE, ?items[0], 3)) { ret 2; }
    var installed: usize = 0;
    if (!install(?chains, ?storage[0], 3, ?installed) || installed != 3) { ret 3; }
    var start: usize = 0;
    var count: usize = 0;
    if (!select(?chains, "anything", ?start, ?count) || start != 0 || count != 3) { ret 4; }
    var ran: usize = 0;
    var placeholder: call.Call;
    placeholder.bound = false;
    if (run_before(?storage[0], start, count, ?placeholder, ?ran) != RESPOND || ran != 2) { ret 5; }
    if (first.before_calls != 1 || second.before_calls != 1 || third.before_calls != 0) { ret 6; }
    run_after(?storage[0], start, ran, ?placeholder);
    if (first.after_calls != 1 || second.after_calls != 1 || third.after_calls != 0) { ret 7; }
    run_error(?storage[0], start, ran, ?placeholder, exchange.SERVICE_FAILED);
    if (first.error_calls != 1 || second.error_calls != 1 || third.error_calls != 0) { ret 8; }
    ret 0;
}

test "middleware: an uninstalled chain selects nothing" {
    var chains_storage: [2]Chain;
    var chains: Chains;
    var items: [1]Middleware;
    items[0] = Middleware{ctx: nil, before: record_before, after: (0::usize)::AfterFun, on_error: (0::usize)::ErrorFun};
    if (!make_chains(?chains, ?chains_storage[0], 2)) { ret 1; }
    if (!add_chain(?chains, "assets", ?items[0], 1)) { ret 2; }
    var start: usize = 9;
    var count: usize = 9;
    if (select(?chains, "assets", ?start, ?count) || start != 0 || count != 0) { ret 3; }
    var storage: [1]Middleware;
    var installed: usize = 0;
    if (!install(?chains, ?storage[0], 1, ?installed) || installed != 1) { ret 4; }
    if (!select(?chains, "assets", ?start, ?count) || count != 1) { ret 5; }
    if (select(?chains, "other", ?start, ?count)) { ret 6; }
    ret 0;
}
