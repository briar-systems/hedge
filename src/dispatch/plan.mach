# compiled route graphs and middleware plans, immutable for one generation

use hedge.config.schema;
use hedge.dispatch.call;
use hedge.dispatch.middleware;
use hedge.service;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use http.router.router;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view;

pub val NO_INDEX: usize = 0xffffffffffffffff;

pub def Status: u8;
pub val PLAN_OK:          Status = 1;
pub val PLAN_INVALID:     Status = 2;
pub val PLAN_CAPACITY:    Status = 3;
pub val PLAN_UNRESOLVED:  Status = 4;
pub val PLAN_UNSUPPORTED: Status = 5;
pub val PLAN_ROUTE:       Status = 6;
pub val PLAN_SEALED:      Status = 7;

# one compiled route: which service answers it, under which middleware plan
pub rec Entry {
    name:             str;
    host:             str;
    service:          str;
    service_index:    usize;
    middleware_start: usize;
    middleware_count: usize;
    budget_index:     usize;
}

# caller-owned storage for one generation's compiled graph
pub rec Storage {
    routes:              *router.CompiledRoute;
    route_capacity:      usize;
    segments:            *router.Segment;
    segment_capacity:    usize;
    specs:               *router.Route;
    spec_capacity:       usize;
    entries:             *Entry;
    entry_capacity:      usize;
    services:            *service.Descriptor;
    service_capacity:    usize;
    middleware:          *middleware.Middleware;
    middleware_capacity: usize;
    text:                *u8;
    text_capacity:       usize;
}

pub rec Report {
    status:  Status;
    route:   usize;
    service: usize;
    detail:  str;
}

# a plan is written once during construction and read-only once sealed
pub rec Plan {
    generation:             u64;
    storage:                Storage;
    graph:                  router.Router;
    entry_count:            usize;
    service_count:          usize;
    middleware_count:       usize;
    text_len:               usize;
    observer:               call.Observer;
    listener_services:      [schema.MAX_LISTENERS]service.ListenerService;
    listener_service_count: usize;
    sealed:                 bool;
}

fun report(code: Status, route: usize, service_index: usize, detail: str) Report {
    ret Report{status: code, route: route, service: service_index, detail: detail};
}

# every borrowed view a compiled route holds points into plan-owned text, never
# into the configuration graph, so a plan outlives the document that produced it
fun intern(plan: *Plan, value: str) str {
    if (value == nil) { ret nil; }
    val length: usize = str_len(value);
    if (plan.text_len + length + 1 > plan.storage.text_capacity) { ret nil; }
    val start: usize = plan.text_len;
    var i:     usize = 0;
    for (i < length) {
        plan.storage.text[start + i] = value[i];
        i                            = i + 1;
    }
    plan.storage.text[start + length] = 0;
    plan.text_len                     = start + length + 1;
    ret (?plan.storage.text[start])::str;
}

pub fun make_storage(
    storage: *Storage,
    routes: *router.CompiledRoute,
    route_capacity: usize,
    segments: *router.Segment,
    segment_capacity: usize,
    specs: *router.Route,
    spec_capacity: usize,
    entries: *Entry,
    entry_capacity: usize,
    services: *service.Descriptor,
    service_capacity: usize,
    middlewares: *middleware.Middleware,
    middleware_capacity: usize,
    text: *u8,
    text_capacity: usize,
) bool {
    if (storage == nil || routes == nil || segments == nil || specs == nil || entries == nil
        || services == nil || text == nil || route_capacity == 0 || segment_capacity == 0
        || spec_capacity == 0 || entry_capacity == 0 || service_capacity == 0 || text_capacity == 0
        || (middleware_capacity != 0 && middlewares == nil)) { ret false; }
    storage.routes              = routes;
    storage.route_capacity      = route_capacity;
    storage.segments            = segments;
    storage.segment_capacity    = segment_capacity;
    storage.specs               = specs;
    storage.spec_capacity       = spec_capacity;
    storage.entries             = entries;
    storage.entry_capacity      = entry_capacity;
    storage.services            = services;
    storage.service_capacity    = service_capacity;
    storage.middleware          = middlewares;
    storage.middleware_capacity = middleware_capacity;
    storage.text                = text;
    storage.text_capacity       = text_capacity;
    ret true;
}

# a configured path pattern becomes a router pattern: `/**` is a terminal catch-all
fun translate_pattern(plan: *Plan, configured: str) str {
    if (configured == nil || configured[0] != '/') { ret nil; }
    val length: usize = str_len(configured);
    if (length >= 3 && configured[length - 1] == '*' && configured[length - 2] == '*'
        && configured[length - 3] == '/') {
        if (plan.text_len + length + 5 > plan.storage.text_capacity) { ret nil; }
        val start: usize = plan.text_len;
        var i:     usize = 0;
        for (i < length - 2) {
            plan.storage.text[start + i] = configured[i];
            i                            = i + 1;
        }
        plan.storage.text[start + length - 2] = '*';
        plan.storage.text[start + length - 1] = 'r';
        plan.storage.text[start + length]     = 'e';
        plan.storage.text[start + length + 1] = 's';
        plan.storage.text[start + length + 2] = 't';
        plan.storage.text[start + length + 3] = 0;
        plan.text_len                         = start + length + 4;
        ret (?plan.storage.text[start])::str;
    }
    ret intern(plan, configured);
}

fun find_service(plan: *Plan, name: str) usize {
    var i: usize = 0;
    for (i < plan.service_count) {
        if (str_equals(plan.storage.services[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret NO_INDEX;
}

# the configured identity of a service, shared by construction and reuse so the
# two can never describe a service differently
fun describe(plan: *Plan, descriptor: *service.Descriptor,
    configured: *schema.Service) bool {
    descriptor.kind         = configured.kind;
    descriptor.name         = intern(plan, schema.text(?configured.name));
    descriptor.target       = intern(plan, schema.text(?configured.target));
    descriptor.content_type = intern(plan, schema.text(?configured.content_type));
    descriptor.status       = configured.status::status.Status;
    ret descriptor.name != nil && descriptor.target != nil;
}

# the service's own setting wins, then what its application declared, then the server's
fun memory_bound(configured: *schema.Service, descriptor: *service.Descriptor,
    server_memory_bytes: usize) usize {
    if (configured.memory_bytes != 0)          { ret configured.memory_bytes; }
    if (descriptor.declared_memory_bytes != 0) { ret descriptor.declared_memory_bytes; }
    ret server_memory_bytes;
}

# service construction happens once per generation, before any listener is ready
fun compile_service(plan: *Plan, configured: *schema.Service, resolver: *service.Resolver,
    server_memory_bytes: usize) Report {
    val index: usize = plan.service_count;
    if (index >= plan.storage.service_capacity) {
        ret report(PLAN_CAPACITY, NO_INDEX, index, "service storage is exhausted");
    }
    val descriptor: *service.Descriptor = ?plan.storage.services[index];
    if (!describe(plan, descriptor, configured)) {
        ret report(PLAN_CAPACITY, NO_INDEX, index, "service text storage is exhausted");
    }
    descriptor.handler               = service.no_handler();
    descriptor.declared_memory_bytes = 0;
    if (configured.kind == schema.SERVICE_FIXED) {
        descriptor.handler = service.Handler{ctx: (descriptor)::ptr, serve: service.serve_fixed};
    }
    or (configured.kind == schema.SERVICE_REDIRECT) {
        descriptor.handler = service.Handler{ctx: (descriptor)::ptr, serve: service.serve_redirect};
    }
    or (configured.kind == schema.SERVICE_LAUREL) {
        val application: *service.Application = service.find_application(resolver.applications, descriptor.target);
        if (application == nil) {
            ret report(PLAN_UNRESOLVED, NO_INDEX, index, "no application is registered under this name");
        }
        descriptor.handler               = application.handler;
        descriptor.declared_memory_bytes = application.memory_bytes;
    }
    or (configured.kind == schema.SERVICE_STATIC) {
        if (!service.has_factory(resolver.static_files)
            || !resolver.static_files.build(resolver.static_files.ctx, configured, ?descriptor.handler)) {
            ret report(PLAN_UNSUPPORTED, NO_INDEX, index, "static file service is unavailable");
        }
    }
    or (configured.kind == schema.SERVICE_PROXY) {
        if (!service.has_factory(resolver.proxy)
            || !resolver.proxy.build(resolver.proxy.ctx, configured, ?descriptor.handler)) {
            ret report(PLAN_UNSUPPORTED, NO_INDEX, index, "proxy service is unavailable");
        }
    }
    or (configured.kind == schema.SERVICE_NATIVE) {
        if (!service.has_factory(resolver.native)
            || !resolver.native.build(resolver.native.ctx, configured, ?descriptor.handler)) {
            ret report(PLAN_UNSUPPORTED, NO_INDEX, index, "native service is unavailable");
        }
    }
    or {
        ret report(PLAN_INVALID, NO_INDEX, index, "unknown service kind");
    }
    descriptor.memory_bytes = memory_bound(configured, descriptor, server_memory_bytes);
    if (!service.has_handler(descriptor.handler)) {
        ret report(PLAN_UNRESOLVED, NO_INDEX, index, "service produced no handler");
    }
    # an optional layer may replace the handler, and refusing is a construction
    # failure rather than a silent fall back to the unwrapped service
    if (service.has_wrapper(resolver.caching)) {
        var wrapped: service.Handler = descriptor.handler;
        if (!resolver.caching.wrap(resolver.caching.ctx, configured, descriptor.handler,
            ?wrapped)) {
            ret report(PLAN_UNSUPPORTED, NO_INDEX, index, "cache layer could not wrap this service");
        }
        descriptor.handler = wrapped;
    }
    plan.service_count = index + 1;
    ret report(PLAN_OK, NO_INDEX, index, nil);
}

# how many router patterns one configured route becomes
#
# a host block declares a set of names and every one of them is a name the host
# answers to, so a route on that host is a route under each. taking only the
# first left every other name resolving to no host at all, which is a 404 after a
# handshake the same configuration negotiated successfully.
fun host_name_count(graph: *schema.Graph, route: *schema.Route) usize {
    val host: *schema.Host = schema.find_host(graph, schema.text(?route.host));
    if (host == nil || host.server_name_count == 0) { ret 1; }
    ret host.server_name_count;
}

# the `index`th name of this route's host, or the any-host pattern when the route
# names no host
#
# these are independent patterns, not an ordered list. Position within a host
# block confers no precedence: every name of a host produces an equally ranked
# pattern for the same route, and which one answers a request is decided by the
# router's specificity rule, not by which was written first.
# which budget one route is charged against
#
# the most specific name wins: a route's own budget, else the budget of the
# service it dispatches to, else the budget of the virtual host it belongs to.
# an unnamed budget at every level is unbudgeted work, which is admitted without
# accounting rather than refused.
fun route_budget(graph: *schema.Graph, route: *schema.Route) usize {
    if (route.budget.len != 0) {
        ret schema.budget_index(graph, schema.text(?route.budget));
    }
    val configured: *schema.Service = schema.find_service(graph,
        schema.text(?route.service));
    if (configured != nil && configured.budget.len != 0) {
        ret schema.budget_index(graph, schema.text(?configured.budget));
    }
    val host: *schema.Host = schema.find_host(graph, schema.text(?route.host));
    if (host != nil && host.budget.len != 0) {
        ret schema.budget_index(graph, schema.text(?host.budget));
    }
    ret schema.NO_BUDGET_INDEX;
}

fun host_pattern(plan: *Plan, graph: *schema.Graph, route: *schema.Route,
    index: usize) str {
    val host: *schema.Host = schema.find_host(graph, schema.text(?route.host));
    if (host == nil || host.server_name_count == 0) { ret intern(plan, "*"); }
    ret intern(plan, schema.text(?host.server_names[index]));
}

# what the whole configuration expands to, so exhaustion is reported before any
# of it is written rather than partway through
fun expanded_route_count(graph: *schema.Graph) usize {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < graph.route_count) {
        total = total + host_name_count(graph, ?graph.routes[i]);
        i     = i + 1;
    }
    ret total;
}

# why the router refused
#
# expanding a host's names makes a conflict reachable from ordinary configuration
# — two host blocks that share a name, each with a route on the same path — so
# these can no longer all report as a malformed pattern.
fun route_failure(status: router.CompileStatus) str {
    if (status == router.COMPILE_CONFLICT) {
        ret "two routes match the same host, path, and method";
    }
    if (status == router.COMPILE_HOST)             { ret "a host name is not a valid pattern"; }
    if (status == router.COMPILE_UNREACHABLE)      { ret "a route can never be reached"; }
    if (status == router.COMPILE_ROUTE_CAPACITY)   { ret "compiled route storage is exhausted"; }
    if (status == router.COMPILE_SEGMENT_CAPACITY) { ret "route segment storage is exhausted"; }
    if (status == router.COMPILE_PARAMETER)        { ret "a route parameter is not valid"; }
    if (status == router.COMPILE_METHOD)           { ret "a route method is not a valid token"; }
    ret "route pattern did not compile";
}

fun service_reusable(active: *schema.Service, candidate: *schema.Service) bool {
    # budget selection belongs to the route plan and may change on reload. every
    # field below shapes the service instance itself and therefore may not.
    if (active == nil || candidate == nil || active.kind != candidate.kind
        || active.status != candidate.status
        || active.precompressed != candidate.precompressed
        || active.cache != candidate.cache
        || !schema.text_equals(?active.name, schema.text(?candidate.name))
        || !schema.text_equals(?active.target, schema.text(?candidate.target))
        || !schema.text_equals(?active.content_type,
        schema.text(?candidate.content_type))
        || !schema.text_equals(?active.index, schema.text(?candidate.index))) {
        ret false;
    }
    # a cache wrapper owns a binding to its original inner descriptor, so it
    # cannot survive that descriptor's storage being reused on a later reload
    ret !active.cache;
}

pub fun services_reusable(active: *schema.Graph, candidate: *schema.Graph) bool {
    if (active == nil || candidate == nil
        || active.service_count != candidate.service_count) { ret false; }
    var i: usize = 0;
    for (i < active.service_count) {
        if (!service_reusable(?active.services[i], ?candidate.services[i])) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

fun features_reusable(active: *schema.Features,
    candidate: *schema.Features) bool {
    ret active.http1 == candidate.http1
        && active.http2 == candidate.http2
        && active.http3 == candidate.http3
        && active.tls == candidate.tls
        && active.acme == candidate.acme
        && active.proxy == candidate.proxy
        && active.cache == candidate.cache;
}

fun telemetry_reusable(active: *schema.Telemetry,
    candidate: *schema.Telemetry) bool {
    ret active.logs == candidate.logs
        && active.metrics == candidate.metrics
        && active.traces == candidate.traces
        && active.log_record_bytes == candidate.log_record_bytes
        && active.log_queue_depth == candidate.log_queue_depth
        && active.metric_series == candidate.metric_series
        && active.trace_state_bytes == candidate.trace_state_bytes;
}

fun cache_reusable(active: *schema.Cache, candidate: *schema.Cache) bool {
    ret active.enabled == candidate.enabled
        && active.memory_bytes == candidate.memory_bytes
        && active.disk_bytes == candidate.disk_bytes
        && schema.text_equals(?active.disk_root,
        schema.text(?candidate.disk_root))
        && active.max_entry_bytes == candidate.max_entry_bytes
        && active.entries == candidate.entries
        && active.heuristic_percent == candidate.heuristic_percent;
}

fun acme_reusable(active: *schema.Acme, candidate: *schema.Acme) bool {
    if (active.enabled != candidate.enabled
        || !schema.text_equals(?active.directory,
        schema.text(?candidate.directory))
        || !schema.text_equals(?active.contact, schema.text(?candidate.contact))
        || !schema.text_equals(?active.storage, schema.text(?candidate.storage))
        || !schema.text_equals(?active.origin, schema.text(?candidate.origin))
        || active.terms_agreed != candidate.terms_agreed
        || active.challenge != candidate.challenge
        || active.renew_before_seconds != candidate.renew_before_seconds
        || active.name_count != candidate.name_count) { ret false; }
    var i: usize = 0;
    for (i < active.name_count) {
        if (!schema.text_equals(?active.names[i],
            schema.text(?candidate.names[i]))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun admin_reusable(active: *schema.Admin, candidate: *schema.Admin) bool {
    ret active.enabled == candidate.enabled
        && schema.text_equals(?active.listener,
        schema.text(?candidate.listener))
        && schema.text_equals(?active.auth_secret,
        schema.text(?candidate.auth_secret))
        && active.max_response_bytes == candidate.max_response_bytes;
}

fun secrets_reusable(active: *schema.Graph, candidate: *schema.Graph) bool {
    if (active.secret_count != candidate.secret_count) { ret false; }
    var i: usize = 0;
    for (i < active.secret_count) {
        val a: *schema.Secret = ?active.secrets[i];
        val b: *schema.Secret = ?candidate.secrets[i];
        if (!schema.text_equals(?a.name, schema.text(?b.name))
            || !schema.text_equals(?a.provider, schema.text(?b.provider))
            || !schema.text_equals(?a.key, schema.text(?b.key))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun listener_reusable(active: *schema.Listener,
    candidate: *schema.Listener) bool {
    if (!schema.text_equals(?active.name, schema.text(?candidate.name))
        || !schema.text_equals(?active.address, schema.text(?candidate.address))
        || active.transport != candidate.transport
        || active.protocols != candidate.protocols
        || !schema.text_equals(?active.tls_policy,
        schema.text(?candidate.tls_policy))
        || active.backlog != candidate.backlog
        || active.accept_depth != candidate.accept_depth
        || active.proxy_protocol != candidate.proxy_protocol
        || active.trusted_peer_count != candidate.trusted_peer_count) {
        ret false;
    }
    var i: usize = 0;
    for (i < active.trusted_peer_count) {
        if (!schema.text_equals(?active.trusted_peers[i],
            schema.text(?candidate.trusted_peers[i]))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun listeners_reusable(active: *schema.Graph,
    candidate: *schema.Graph) bool {
    if (active.listener_count != candidate.listener_count) { ret false; }
    var i: usize = 0;
    for (i < active.listener_count) {
        if (!listener_reusable(?active.listeners[i],
            ?candidate.listeners[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun tls_identity_reusable(active: *schema.TlsIdentity,
    candidate: *schema.TlsIdentity) bool {
    ret schema.text_equals(?active.server_name,
        schema.text(?candidate.server_name))
        && schema.text_equals(?active.certificate,
        schema.text(?candidate.certificate))
        && schema.text_equals(?active.key, schema.text(?candidate.key));
}

fun tls_reusable(active: *schema.Graph, candidate: *schema.Graph) bool {
    if (active.tls_policy_count != candidate.tls_policy_count) { ret false; }
    var i: usize = 0;
    for (i < active.tls_policy_count) {
        val a: *schema.TlsPolicy = ?active.tls_policies[i];
        val b: *schema.TlsPolicy = ?candidate.tls_policies[i];
        if (!schema.text_equals(?a.name, schema.text(?b.name))
            || a.identity_count != b.identity_count
            || !schema.text_equals(?a.default_name,
            schema.text(?b.default_name))
            || a.has_default != b.has_default
            || a.client_auth != b.client_auth
            || !schema.text_equals(?a.client_trust,
            schema.text(?b.client_trust))) { ret false; }
        var identity: usize = 0;
        for (identity < a.identity_count) {
            if (!tls_identity_reusable(?a.identities[identity],
                ?b.identities[identity])) { ret false; }
            identity = identity + 1;
        }
        i = i + 1;
    }
    # a secure listener is published into the TLS runtime by name at startup
    i = 0;
    for (i < candidate.listener_count) {
        val next: *schema.Listener = ?candidate.listeners[i];
        if (next.tls_policy.len != 0) {
            val prior: *schema.Listener = schema.find_listener(active,
                schema.text(?next.name));
            if (prior == nil || prior.tls_policy.len == 0
                || prior.protocols != next.protocols
                || !schema.text_equals(?prior.tls_policy,
                schema.text(?next.tls_policy))) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

# only state rebuilt or republished by the reload path may change
pub fun reload_compatible(active: *schema.Graph,
    candidate: *schema.Graph) bool {
    if (active == nil || candidate == nil
        || !schema.text_equals(?active.server_name,
        schema.text(?candidate.server_name))
        || active.limits.max_connections != candidate.limits.max_connections
        || active.limits.max_connections_per_peer
        != candidate.limits.max_connections_per_peer
        || !features_reusable(?active.features, ?candidate.features)
        || !listeners_reusable(active, candidate)
        || !secrets_reusable(active, candidate)
        || !tls_reusable(active, candidate)
        || !telemetry_reusable(?active.telemetry, ?candidate.telemetry)
        || !cache_reusable(?active.cache, ?candidate.cache)
        || !acme_reusable(?active.acme, ?candidate.acme)
        || !admin_reusable(?active.admin, ?candidate.admin)) { ret false; }
    ret true;
}

fun prepare(plan: *Plan, generation: u64, graph: *schema.Graph,
    storage: Storage) Report {
    if (plan == nil || graph == nil || generation == 0) {
        ret report(PLAN_INVALID, NO_INDEX, NO_INDEX, "invalid plan inputs");
    }
    plan.generation             = generation;
    plan.storage                = storage;
    plan.entry_count            = 0;
    plan.service_count          = 0;
    plan.middleware_count       = 0;
    plan.text_len               = 0;
    plan.observer               = call.no_observer();
    plan.listener_service_count = 0;
    plan.sealed                 = false;
    plan.graph.generation       = 0;
    plan.graph.initialized      = false;
    val expanded: usize = expanded_route_count(graph);
    if (expanded > storage.spec_capacity || expanded > storage.entry_capacity) {
        ret report(PLAN_CAPACITY, NO_INDEX, NO_INDEX,
            "route storage is exhausted");
    }
    ret report(PLAN_OK, NO_INDEX, NO_INDEX, nil);
}

fun install_listener_services(plan: *Plan, services: *service.ListenerService,
    count: usize) bool {
    if (count > schema.MAX_LISTENERS || (count != 0 && services == nil)) {
        ret false;
    }
    var i: usize = 0;
    for (i < count) {
        if (!service.has_handler(services[i].handler)) { ret false; }
        val listener: str = intern(plan, services[i].listener);
        val name:     str = intern(plan, services[i].name);
        if (listener == nil || listener[0] == 0 || name == nil || name[0] == 0) {
            ret false;
        }
        var j: usize = 0;
        for (j < i) {
            if (str_equals(plan.listener_services[j].listener, listener)) {
                ret false;
            }
            j = j + 1;
        }
        plan.listener_services[i] = service.ListenerService{
            listener: listener, name: name, handler: services[i].handler
        };
        i = i + 1;
    }
    plan.listener_service_count = count;
    ret true;
}

fun reuse_listener_services(plan: *Plan, active: *Plan) bool {
    var i: usize = 0;
    for (i < active.listener_service_count) {
        val source:   *service.ListenerService = ?active.listener_services[i];
        val listener: str                      = intern(plan, source.listener);
        val name:     str                      = intern(plan, source.name);
        if (listener == nil || name == nil) { ret false; }
        plan.listener_services[i] = service.ListenerService{
            listener: listener, name: name, handler: source.handler
        };
        i = i + 1;
    }
    plan.listener_service_count = active.listener_service_count;
    ret true;
}

fun reuse_service(plan: *Plan, configured: *schema.Service,
    active: *Plan, index: usize, server_memory_bytes: usize) Report {
    if (active == nil || !active.sealed || index >= active.service_count
        || index >= plan.storage.service_capacity) {
        ret report(PLAN_INVALID, NO_INDEX, index,
            "active service cannot be reused");
    }
    val source:     *service.Descriptor = ?active.storage.services[index];
    val descriptor: *service.Descriptor = ?plan.storage.services[index];
    if (!describe(plan, descriptor, configured)) {
        ret report(PLAN_CAPACITY, NO_INDEX, index,
            "service text storage is exhausted");
    }
    descriptor.handler               = source.handler;
    descriptor.declared_memory_bytes = source.declared_memory_bytes;
    descriptor.memory_bytes          = memory_bound(configured, descriptor,
        server_memory_bytes);
    if (configured.kind == schema.SERVICE_FIXED) {
        descriptor.handler = service.Handler{ctx: (descriptor)::ptr,
            serve: service.serve_fixed};
    }
    or (configured.kind == schema.SERVICE_REDIRECT) {
        descriptor.handler = service.Handler{ctx: (descriptor)::ptr,
            serve: service.serve_redirect};
    }
    if (!service.has_handler(descriptor.handler)) {
        ret report(PLAN_UNSUPPORTED, NO_INDEX, index,
            "active service has no handler");
    }
    plan.service_count = index + 1;
    ret report(PLAN_OK, NO_INDEX, index, nil);
}

fun compile_routes(plan: *Plan, graph: *schema.Graph,
    plans: *middleware.Chains) Report {
    if (plans != nil && !middleware.install(plans, plan.storage.middleware,
        plan.storage.middleware_capacity, ?plan.middleware_count)) {
        ret report(PLAN_CAPACITY, NO_INDEX, NO_INDEX,
            "middleware storage is exhausted");
    }
    var i:       usize = 0;
    var emitted: usize = 0;
    for (i < graph.route_count) {
        val configured:   *schema.Route = ?graph.routes[i];
        val service_name: str           = schema.text(?configured.service);
        val resolved:     usize         = find_service(plan, service_name);
        if (resolved == NO_INDEX) {
            ret report(PLAN_UNRESOLVED, i, NO_INDEX,
                "route references an unknown service");
        }
        val route_name: str = intern(plan, schema.text(?configured.name));
        val pattern:    str = translate_pattern(plan, schema.text(?configured.path));
        if (route_name == nil || pattern == nil) {
            ret report(PLAN_CAPACITY, i, NO_INDEX,
                "route text storage is exhausted");
        }
        var start: usize = 0;
        var count: usize = 0;
        if (!middleware.select(plans, route_name, ?start, ?count)) {
            start = 0;
            count = 0;
        }
        val names: usize = host_name_count(graph, configured);
        var n:     usize = 0;
        for (n < names) {
            val entry: *Entry        = ?plan.storage.entries[emitted];
            val spec:  *router.Route = ?plan.storage.specs[emitted];
            entry.name             = route_name;
            entry.host             = host_pattern(plan, graph, configured, n);
            entry.service          = plan.storage.services[resolved].name;
            entry.service_index    = resolved;
            entry.budget_index     = route_budget(graph, configured);
            entry.middleware_start = start;
            entry.middleware_count = count;
            if (entry.host == nil) {
                ret report(PLAN_CAPACITY, i, NO_INDEX,
                    "route text storage is exhausted");
            }
            spec.method      = view.view(nil, 0);
            spec.host        = service.text_view(entry.host);
            spec.pattern     = service.text_view(pattern);
            spec.handler_ctx = (entry)::ptr;
            spec.handler     = matched_route;
            emitted          = emitted + 1;
            n                = n + 1;
        }
        i = i + 1;
    }
    plan.entry_count = emitted;
    var configured_limits: router.Limits = router.limits_default();
    configured_limits.max_routes   = plan.storage.route_capacity;
    configured_limits.max_segments = plan.storage.segment_capacity;
    val compiled: router.Compile = router.compile(
        ?plan.graph,
        plan.storage.specs,
        plan.entry_count,
        plan.storage.routes,
        plan.storage.route_capacity,
        plan.storage.segments,
        plan.storage.segment_capacity,
        configured_limits,
    );
    if (compiled.status != router.COMPILE_OK) {
        ret report(PLAN_ROUTE, compiled.route, NO_INDEX,
            route_failure(compiled.status));
    }
    plan.sealed = true;
    ret report(PLAN_OK, NO_INDEX, NO_INDEX, nil);
}

# compile a configuration graph into an immutable route graph and service set
pub fun compile(
    plan: *Plan,
    generation: u64,
    graph: *schema.Graph,
    storage: Storage,
    resolver: *service.Resolver,
    plans: *middleware.Chains,
) Report {
    if (resolver == nil) {
        ret report(PLAN_INVALID, NO_INDEX, NO_INDEX, "invalid plan inputs");
    }
    val ready: Report = prepare(plan, generation, graph, storage);
    if (ready.status != PLAN_OK) { ret ready; }
    plan.observer = resolver.observer;
    if (!install_listener_services(plan, resolver.listener_services,
        resolver.listener_service_count)) {
        ret report(PLAN_INVALID, NO_INDEX, NO_INDEX,
            "listener service configuration is invalid");
    }
    var i: usize = 0;
    for (i < graph.service_count) {
        val built: Report = compile_service(plan, ?graph.services[i], resolver,
            graph.limits.call_memory_bytes);
        if (built.status != PLAN_OK) { ret built; }
        i = i + 1;
    }
    ret compile_routes(plan, graph, plans);
}

pub fun recompile(
    plan: *Plan,
    generation: u64,
    graph: *schema.Graph,
    storage: Storage,
    active_plan: *Plan,
    active_graph: *schema.Graph,
    plans: *middleware.Chains,
) Report {
    if (active_plan == nil || !active_plan.sealed
        || !services_reusable(active_graph, graph)) {
        ret report(PLAN_INVALID, NO_INDEX, NO_INDEX,
            "service definitions require restart");
    }
    val ready: Report = prepare(plan, generation, graph, storage);
    if (ready.status != PLAN_OK) { ret ready; }
    plan.observer = active_plan.observer;
    if (!reuse_listener_services(plan, active_plan)) {
        ret report(PLAN_CAPACITY, NO_INDEX, NO_INDEX,
            "listener service text storage is exhausted");
    }
    var i: usize = 0;
    for (i < graph.service_count) {
        val reused: Report = reuse_service(plan, ?graph.services[i],
            active_plan, i, graph.limits.call_memory_bytes);
        if (reused.status != PLAN_OK) { ret reused; }
        i = i + 1;
    }
    ret compile_routes(plan, graph, plans);
}

pub fun observer(plan: *Plan) call.Observer {
    if (plan == nil || !plan.sealed) { ret call.no_observer(); }
    ret plan.observer;
}

pub fun listener_service(plan: *Plan, listener: str) *service.ListenerService {
    if (plan == nil || !plan.sealed || listener == nil) { ret nil; }
    var i: usize = 0;
    for (i < plan.listener_service_count) {
        if (str_equals(plan.listener_services[i].listener, listener)) {
            ret ?plan.listener_services[i];
        }
        i = i + 1;
    }
    ret nil;
}

# route compilation requires a handler, but hedge matches and serves in separate
# steps so the exchange, the request arena, and telemetry context stay with dispatch.
# reaching this function means a caller invoked the router directly, which is a
# layering error rather than a runtime condition to recover from.
fun matched_route(context: ptr, request: *message.Request, response: *message.Response,
    params: *router.Params) res[u8, str] {
    ret res[u8, str].err{"hedge dispatches through the service exchange, not the router handler"};
}

pub fun entry(plan: *Plan, index: usize) *Entry {
    if (plan == nil || !plan.sealed || index >= plan.entry_count) { ret nil; }
    ret ?plan.storage.entries[index];
}

pub fun descriptor(plan: *Plan, index: usize) *service.Descriptor {
    if (plan == nil || !plan.sealed || index >= plan.service_count) { ret nil; }
    ret ?plan.storage.services[index];
}

pub fun memory_for(plan: *Plan, selected: *Entry) usize {
    if (plan == nil || !plan.sealed || selected == nil
        || selected.service_index >= plan.service_count) { ret 0; }
    ret plan.storage.services[selected.service_index].memory_bytes;
}

pub fun handler_for(plan: *Plan, selected: *Entry) service.Handler {
    if (plan == nil || !plan.sealed || selected == nil
        || selected.service_index >= plan.service_count) { ret service.no_handler(); }
    ret plan.storage.services[selected.service_index].handler;
}

# matching is a read of immutable state: a sealed plan is never mutated by a request
pub fun match(plan: *Plan, request: *message.Request, captures: *router.Capture,
    capture_capacity: usize) router.Dispatch {
    if (plan == nil || !plan.sealed) {
        ret router.Dispatch{
            status:       router.DISPATCH_INVALID,
            route:        router.NO_INDEX,
            source_index: router.NO_INDEX,
            handler_ctx:  nil,
            handler: (0::usize)::router.Handler,
            params: router.Params{items: nil, len: 0, router_generation: 0, request_generation: 0},
        };
    }
    ret router.dispatch(?plan.graph, request, captures, capture_capacity);
}

pub fun sealed(plan: *Plan) bool {
    ret plan != nil && plan.sealed;
}

fun test_graph(graph: *schema.Graph, service_kind: u8, target: str) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "plan-test");
    graph.host_count = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "example.test");
    graph.service_count = 1;
    schema.set_text(?graph.services[0].name, "svc");
    graph.services[0].kind = service_kind;
    schema.set_text(?graph.services[0].target, target);
    graph.services[0].status = 200;
    graph.route_count        = 1;
    schema.set_text(?graph.routes[0].name, "root");
    schema.set_text(?graph.routes[0].host, "site");
    schema.set_text(?graph.routes[0].path, "/a/**");
    schema.set_text(?graph.routes[0].service, "svc");
}

rec Fixture {
    routes:      [4]router.CompiledRoute;
    segments:    [32]router.Segment;
    specs:       [4]router.Route;
    entries:     [4]Entry;
    services:    [4]service.Descriptor;
    middlewares: [4]middleware.Middleware;
    text:        [1024]u8;
    storage:     Storage;
    plan:        Plan;
}

fun build(fixture: *Fixture, generation: u64, graph: *schema.Graph,
    resolver: *service.Resolver, chains: *middleware.Chains) Report {
    make_storage(?fixture.storage,
        ?fixture.routes[0], 4,
        ?fixture.segments[0], 32,
        ?fixture.specs[0], 4,
        ?fixture.entries[0], 4,
        ?fixture.services[0], 4,
        ?fixture.middlewares[0], 4,
        ?fixture.text[0], 1024);
    ret compile(?fixture.plan, generation, graph, fixture.storage, resolver, chains);
}

fun rebuild(fixture: *Fixture, generation: u64, graph: *schema.Graph,
    active: *Fixture, active_graph: *schema.Graph) Report {
    make_storage(?fixture.storage,
        ?fixture.routes[0], 4,
        ?fixture.segments[0], 32,
        ?fixture.specs[0], 4,
        ?fixture.entries[0], 4,
        ?fixture.services[0], 4,
        ?fixture.middlewares[0], 4,
        ?fixture.text[0], 1024);
    ret recompile(?fixture.plan, generation, graph, fixture.storage,
        ?active.plan, active_graph, nil);
}

rec FactoryProbe {
    builds: usize;
}

fun serve_probe(context: ptr, active: *call.Call) exchange.ServiceStatus {
    ret exchange.SERVICE_PENDING;
}

fun build_probe(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    val probe: *FactoryProbe = context::*FactoryProbe;
    if (probe == nil || configured == nil || handler == nil) { ret false; }
    probe.builds = probe.builds + 1;
    @handler     = service.Handler{ctx: context, serve: serve_probe};
    ret true;
}

test "plan: a sealed graph owns its text and outlives the configuration it came from" {
    var graph: schema.Graph;
    test_graph(?graph, schema.SERVICE_FIXED, "body");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    if (build(?fixture, 2, ?graph, ?resolver, nil).status != PLAN_OK) { ret 1; }
    val selected: *Entry = entry(?fixture.plan, 0);
    if (selected == nil || !str_equals(selected.name, "root")
        || !str_equals(selected.host, "example.test")
        || !str_equals(selected.service, "svc")) { ret 2; }
    val compiled_pattern: view.View = fixture.plan.storage.specs[0].pattern;
    if (!view.view_eq_str(compiled_pattern, "/a/*rest")) { ret 3; }
    # rewriting the source document must not reach the sealed plan
    schema.set_text(?graph.routes[0].name, "rewritten");
    schema.set_text(?graph.hosts[0].server_names[0], "rewritten.test");
    schema.set_text(?graph.services[0].name, "rewritten");
    schema.reset_graph(?graph);
    if (!str_equals(selected.name, "root") || !str_equals(selected.host, "example.test")
        || !str_equals(selected.service, "svc")) { ret 4; }
    if (!view.view_eq_str(fixture.plan.storage.specs[0].pattern, "/a/*rest")) { ret 5; }
    if (!sealed(?fixture.plan) || fixture.plan.generation != 2)               { ret 6; }
    ret 0;
}

test "plan: an unregistered application fails before the plan seals" {
    var graph: schema.Graph;
    test_graph(?graph, schema.SERVICE_LAUREL, "site");
    var fixture:  Fixture;
    var slots:    [2]service.Application;
    var registry: service.Applications;
    service.make_applications(?registry, ?slots[0], 2);
    var resolver: service.Resolver = service.no_resolver();
    resolver.applications = ?registry;
    val built: Report = build(?fixture, 2, ?graph, ?resolver, nil);
    if (built.status != PLAN_UNRESOLVED || sealed(?fixture.plan)) { ret 1; }
    ret 0;
}

test "plan: a service kind with no registered factory fails before the plan seals" {
    var graph: schema.Graph;
    test_graph(?graph, schema.SERVICE_STATIC, "./public");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    if (build(?fixture, 2, ?graph, ?resolver, nil).status != PLAN_UNSUPPORTED) { ret 1; }
    if (sealed(?fixture.plan))                                                 { ret 2; }
    test_graph(?graph, schema.SERVICE_PROXY, "http://127.0.0.1:1");
    if (build(?fixture, 2, ?graph, ?resolver, nil).status != PLAN_UNSUPPORTED) { ret 3; }
    if (sealed(?fixture.plan))                                                 { ret 4; }
    ret 0;
}

test "plan: a route naming an absent service fails before the plan seals" {
    var graph: schema.Graph;
    test_graph(?graph, schema.SERVICE_FIXED, "body");
    schema.set_text(?graph.routes[0].service, "missing");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    if (build(?fixture, 2, ?graph, ?resolver, nil).status != PLAN_UNRESOLVED) { ret 1; }
    if (sealed(?fixture.plan))                                                { ret 2; }
    ret 0;
}

test "plan: route-only recompilation reuses a service without calling its factory" {
    var active_graph: schema.Graph;
    test_graph(?active_graph, schema.SERVICE_NATIVE, "probe");
    var probe: FactoryProbe;
    probe.builds = 0;
    var resolver: service.Resolver = service.no_resolver();
    resolver.native = service.Factory{ctx: (?probe)::ptr, build: build_probe};
    var active: Fixture;
    if (build(?active, 1, ?active_graph, ?resolver, nil).status != PLAN_OK
        || probe.builds != 1) { ret 1; }

    var candidate: schema.Graph;
    test_graph(?candidate, schema.SERVICE_NATIVE, "probe");
    schema.set_text(?candidate.routes[0].path, "/changed/**");
    var replacement: Fixture;
    if (rebuild(?replacement, 2, ?candidate, ?active,
        ?active_graph).status != PLAN_OK) { ret 2; }
    if (probe.builds != 1 || replacement.plan.generation != 2) { ret 3; }
    val handler: service.Handler = replacement.services[0].handler;
    if (handler.ctx != (?probe)::ptr || handler.serve::usize != serve_probe::usize) {
        ret 4;
    }
    if (routed(?replacement, "/changed/x", "example.test") == nil
        || routed(?replacement, "/a/x", "example.test") != nil) { ret 5; }
    ret 0;
}

test "plan: route-only recompilation refuses service state it cannot reuse" {
    var active_graph: schema.Graph;
    test_graph(?active_graph, schema.SERVICE_FIXED, "body");
    var resolver: service.Resolver = service.no_resolver();
    var active:   Fixture;
    if (build(?active, 1, ?active_graph, ?resolver, nil).status != PLAN_OK) {
        ret 1;
    }

    var changed: schema.Graph;
    test_graph(?changed, schema.SERVICE_FIXED, "body");
    changed.services[0].status = 201;
    var replacement: Fixture;
    if (rebuild(?replacement, 2, ?changed, ?active,
        ?active_graph).status != PLAN_INVALID) { ret 2; }

    changed.services[0].status = 200;
    changed.services[0].cache  = true;
    if (rebuild(?replacement, 2, ?changed, ?active,
        ?active_graph).status != PLAN_INVALID) { ret 3; }
    ret 0;
}

test "plan: request admission selects the most specific configured budget" {
    var graph: schema.Graph;
    test_graph(?graph, schema.SERVICE_FIXED, "body");
    graph.budget_count = 3;
    schema.set_text(?graph.budgets[0].name, "host");
    schema.set_text(?graph.budgets[1].name, "service");
    schema.set_text(?graph.budgets[2].name, "route");
    schema.set_text(?graph.hosts[0].budget, "host");
    schema.set_text(?graph.services[0].budget, "service");
    schema.set_text(?graph.routes[0].budget, "route");
    var resolver: service.Resolver = service.no_resolver();

    var route_fixture: Fixture;
    if (build(?route_fixture, 1, ?graph, ?resolver, nil).status != PLAN_OK
        || route_fixture.entries[0].budget_index != 2) { ret 1; }
    schema.clear_text(?graph.routes[0].budget);
    var service_fixture: Fixture;
    if (build(?service_fixture, 2, ?graph, ?resolver, nil).status != PLAN_OK
        || service_fixture.entries[0].budget_index != 1) { ret 2; }
    schema.clear_text(?graph.services[0].budget);
    var host_fixture: Fixture;
    if (build(?host_fixture, 3, ?graph, ?resolver, nil).status != PLAN_OK
        || host_fixture.entries[0].budget_index != 0) { ret 3; }
    schema.clear_text(?graph.hosts[0].budget);
    var unbounded_fixture: Fixture;
    if (build(?unbounded_fixture, 4, ?graph, ?resolver, nil).status != PLAN_OK
        || unbounded_fixture.entries[0].budget_index != schema.NO_BUDGET_INDEX) {
        ret 4;
    }
    ret 0;
}

test "plan: reload compatibility permits rebuilt services and rejects process state" {
    var active: schema.Graph;
    test_graph(?active, schema.SERVICE_FIXED, "body");
    active.listener_count = 1;
    schema.set_text(?active.listeners[0].name, "public");
    schema.set_text(?active.listeners[0].address, "127.0.0.1:443");
    active.listeners[0].transport    = schema.TRANSPORT_TCP;
    active.listeners[0].protocols    = schema.PROTOCOL_HTTP1;
    active.listeners[0].backlog      = 64;
    active.listeners[0].accept_depth = 4;
    var candidate: schema.Graph = active;
    schema.set_text(?candidate.routes[0].path, "/changed/**");
    candidate.timeouts.request_ms     = candidate.timeouts.request_ms + 1;
    candidate.limits.max_header_bytes = candidate.limits.max_header_bytes + 1;
    if (!reload_compatible(?active, ?candidate)) { ret 1; }

    candidate.telemetry.logs = !candidate.telemetry.logs;
    if (reload_compatible(?active, ?candidate)) { ret 2; }
    candidate.telemetry.logs = active.telemetry.logs;
    candidate.cache.entries  = candidate.cache.entries + 1;
    if (reload_compatible(?active, ?candidate)) { ret 3; }
    candidate.cache.entries      = active.cache.entries;
    candidate.services[0].status = candidate.services[0].status + 1;
    if (!reload_compatible(?active, ?candidate)) { ret 4; }
    schema.set_text(?candidate.services[0].target, "changed");
    if (!reload_compatible(?active, ?candidate)) { ret 5; }
    schema.set_text(?candidate.listeners[0].address, "127.0.0.1:8443");
    if (reload_compatible(?active, ?candidate)) { ret 6; }
    candidate.listeners[0].address   = active.listeners[0].address;
    candidate.listeners[0].transport = schema.TRANSPORT_QUIC;
    if (reload_compatible(?active, ?candidate)) { ret 7; }
    candidate.listeners[0].transport = active.listeners[0].transport;
    schema.set_text(?candidate.listeners[0].budget, "replacement");
    if (!reload_compatible(?active, ?candidate)) { ret 8; }
    ret 0;
}

fun host_request(request: *message.Request, items: *field.Field, path: str, host: str) {
    request.generation = 1;
    request.method     = method.from_kind(method.GET);
    request.fields     = field.init(items, 2, field.limits(2, 512, 64, 256));
    field.append(?request.fields, field.Field{
        name:      view.view("host", 4),
        value:     view.view(host, str_len(host)),
        sensitive: false,
    });
    request.target.form      = target.ORIGIN;
    request.target.path      = view.view(path, str_len(path));
    request.target.query     = view.view(nil, 0);
    request.target.authority = view.view(nil, 0);
}

# which route answers this host, by name, or nil when none does
fun routed(fixture: *Fixture, path: str, host: str) *Entry {
    var items:   [2]field.Field;
    var request: message.Request;
    host_request(?request, ?items[0], path, host);
    var captures: [4]router.Capture;
    val matched:  router.Dispatch = match(?fixture.plan, ?request, ?captures[0], 4);
    if (matched.status != router.DISPATCH_MATCH) { ret nil; }
    ret entry(?fixture.plan, matched.source_index);
}

fun named_host(graph: *schema.Graph, index: usize, name: str, first: str, second: str) {
    val host: *schema.Host = ?graph.hosts[index];
    schema.set_text(?host.name, name);
    schema.set_text(?host.server_names[0], first);
    host.server_name_count = 1;
    if (second != nil) {
        schema.set_text(?host.server_names[1], second);
        host.server_name_count = 2;
    }
}

fun route_on(graph: *schema.Graph, index: usize, name: str, host: str, path: str,
    service_name: str) {
    val configured: *schema.Route = ?graph.routes[index];
    schema.set_text(?configured.name, name);
    schema.set_text(?configured.host, host);
    schema.set_text(?configured.path, path);
    schema.set_text(?configured.service, service_name);
}

fun fixed_service(graph: *schema.Graph, index: usize, name: str, body: str) {
    schema.set_text(?graph.services[index].name, name);
    graph.services[index].kind = schema.SERVICE_FIXED;
    schema.set_text(?graph.services[index].target, body);
    graph.services[index].status = 200;
}

test "plan: every name a host declares routes to that host's services" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    schema.set_text(?graph.server_name, "plan-test");
    graph.host_count = 1;
    named_host(?graph, 0, "site", "a.example.test", "b.example.test");
    graph.service_count = 1;
    fixed_service(?graph, 0, "svc", "body");
    graph.route_count = 1;
    route_on(?graph, 0, "root", "site", "/a/**", "svc");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    if (build(?fixture, 3, ?graph, ?resolver, nil).status != PLAN_OK) { ret 1; }
    # one configured route became one pattern per name
    if (fixture.plan.entry_count != 2) { ret 2; }
    val first: *Entry = routed(?fixture, "/a/x", "a.example.test");
    if (first == nil || !str_equals(first.name, "root")
        || !str_equals(first.service, "svc")) { ret 3; }
    # the defect: this name completed a handshake and then matched no host at all
    val second: *Entry = routed(?fixture, "/a/x", "b.example.test");
    if (second == nil || !str_equals(second.name, "root")
        || !str_equals(second.service, "svc")) { ret 4; }
    if (!str_equals(first.host, "a.example.test")
        || !str_equals(second.host, "b.example.test")) { ret 5; }
    # and a name no host declares is still refused, which is what proves the
    # patterns above are those two names rather than a catch-all
    if (routed(?fixture, "/a/x", "c.example.test") != nil) { ret 6; }
    ret 0;
}

# precedence comes from the router's specificity rule, not from the order names
# or hosts are written in
test "plan: an exact host name outranks a wildcard declared before it" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    schema.set_text(?graph.server_name, "plan-test");
    graph.host_count = 2;
    # the wildcard is declared first, so source order would answer wrongly, and the
    # exact name that must win is the host's *second*, so it exists only if every
    # name is compiled
    named_host(?graph, 0, "wild", "*.example.test", nil);
    named_host(?graph, 1, "exact", "other.example.test", "api.example.test");
    graph.service_count = 2;
    fixed_service(?graph, 0, "wildsvc", "wild");
    fixed_service(?graph, 1, "apisvc", "api");
    graph.route_count = 2;
    route_on(?graph, 0, "wildroute", "wild", "/**", "wildsvc");
    route_on(?graph, 1, "apiroute", "exact", "/**", "apisvc");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    if (build(?fixture, 4, ?graph, ?resolver, nil).status != PLAN_OK) { ret 1; }
    val second_name: *Entry = routed(?fixture, "/x", "api.example.test");
    if (second_name == nil || !str_equals(second_name.service, "apisvc")) { ret 2; }
    val first_name: *Entry = routed(?fixture, "/x", "other.example.test");
    if (first_name == nil || !str_equals(first_name.service, "apisvc")) { ret 3; }
    # a name the exact host does not claim falls to the wildcard, not the reverse
    val suffix: *Entry = routed(?fixture, "/x", "anything.example.test");
    if (suffix == nil || !str_equals(suffix.service, "wildsvc")) { ret 4; }
    # and a name outside the wildcard's suffix belongs to neither
    if (routed(?fixture, "/x", "api.example.org") != nil) { ret 5; }
    ret 0;
}

test "plan: two hosts claiming one name on one path is a reported conflict" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    schema.set_text(?graph.server_name, "plan-test");
    graph.host_count = 2;
    # the two hosts collide on the second name of the first, so the conflict exists
    # only once every name is compiled
    named_host(?graph, 0, "one", "first.example.test", "shared.example.test");
    named_host(?graph, 1, "two", "shared.example.test", nil);
    graph.service_count = 2;
    fixed_service(?graph, 0, "first", "one");
    fixed_service(?graph, 1, "second", "two");
    graph.route_count = 2;
    route_on(?graph, 0, "a", "one", "/**", "first");
    route_on(?graph, 1, "b", "two", "/**", "second");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    val built:    Report           = build(?fixture, 5, ?graph, ?resolver, nil);
    if (built.status != PLAN_ROUTE) { ret 1; }
    # and it says which kind of failure it is, not just that something did not compile
    if (!str_equals(built.detail, "two routes match the same host, path, and method")) { ret 2; }
    if (sealed(?fixture.plan))                                                         { ret 3; }
    ret 0;
}

test "plan: expansion across names is bounded by the storage it was given" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    schema.set_text(?graph.server_name, "plan-test");
    graph.host_count = 1;
    val host: *schema.Host = ?graph.hosts[0];
    schema.set_text(?host.name, "site");
    host.server_name_count = 5;
    schema.set_text(?host.server_names[0], "a.example.test");
    schema.set_text(?host.server_names[1], "b.example.test");
    schema.set_text(?host.server_names[2], "c.example.test");
    schema.set_text(?host.server_names[3], "d.example.test");
    schema.set_text(?host.server_names[4], "e.example.test");
    graph.service_count = 1;
    fixed_service(?graph, 0, "svc", "body");
    graph.route_count = 1;
    route_on(?graph, 0, "root", "site", "/**", "svc");
    var fixture:  Fixture;
    var resolver: service.Resolver = service.no_resolver();
    # the fixture holds four specs, so five names must be refused rather than
    # written past the end of the storage the caller owns
    val built: Report = build(?fixture, 6, ?graph, ?resolver, nil);
    if (built.status != PLAN_CAPACITY) { ret 1; }
    if (sealed(?fixture.plan))         { ret 2; }
    ret 0;
}
