# the service boundary: what crosses from a connection into a service, exactly once

use hedge.clock;
use hedge.storage;
use hedge.telemetry.trace;
use hedge_wake: hedge.wake;
use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use mem: std.memory;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# request body disposition is decided once by the service that owns the request

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

pub def Disposition: u8;
pub val BODY_UNRESOLVED: Disposition = 0;
pub val BODY_DELIVER:    Disposition = 1;
pub val BODY_DRAIN:      Disposition = 2;
pub val BODY_REJECT:     Disposition = 3;
pub val BODY_CLOSE:      Disposition = 4;

# route identity is immutable for the generation that compiled it
pub rec Route {
    index:   usize;
    name:    str;
    host:    str;
    service: str;
}

pub fun no_route() Route {
    ret Route{index: 0, name: nil, host: nil, service: nil};
}

# the request arena: a bump allocator over chunks claimed as the request needs
# them, bounded by the bytes of chunk it may hold. the bound is the server's
# until a route is selected and the route's after, and every chunk returns to
# the shared classes when the exchange settles.
pub rec Memory {
    allocator:   allocator.Allocator;
    chunks:      *storage.Chunks;
    head:        *u8;
    head_size:   usize;
    offset:      usize;
    last_offset: usize;
    last_size:   usize;
    held:        usize;
    limit:       usize;
    refused:     bool;
    initialized: bool;
}

# each chunk starts with the chunk before it, so release walks back from the head
rec ChunkLink {
    previous:      *u8;
    previous_size: usize;
}

val LINK_BYTES: usize = $size_of(ChunkLink);

fun align_up(value: usize, align: usize) usize {
    val mask: usize = align - 1;
    ret (value + mask) & ~mask;
}

fun memory_allocate(context: ptr, size: usize, align: usize) opt[ptr] {
    val memory: *Memory = context::*Memory;
    if (size == 0) { ret opt[ptr].some{nil}; }
    if (memory.head != nil) {
        val start: usize = align_up(memory.offset, align);
        if (start <= memory.head_size && size <= memory.head_size - start) {
            memory.last_offset = start;
            memory.last_size   = size;
            memory.offset      = start + size;
            ret opt[ptr].some{(memory.head::usize + start)::ptr};
        }
    }
    var wanted: usize = storage.MIN_CHUNK;
    if (size + align + LINK_BYTES > wanted) { wanted = size + align + LINK_BYTES; }
    val chunk_size: usize = storage.chunk_class_size(wanted);
    if (chunk_size == 0 || memory.held + chunk_size > memory.limit) {
        memory.refused = true;
        ret opt[ptr].none{};
    }
    val chunk: *u8 = storage.claim_chunk(memory.chunks, chunk_size);
    if (chunk == nil) {
        memory.refused = true;
        ret opt[ptr].none{};
    }
    val link: *ChunkLink = chunk::*ChunkLink;
    link.previous      = memory.head;
    link.previous_size = memory.head_size;
    memory.head        = chunk;
    memory.head_size   = chunk_size;
    memory.held        = memory.held + chunk_size;
    val start: usize = align_up(LINK_BYTES, align);
    memory.last_offset = start;
    memory.last_size   = size;
    memory.offset      = start + size;
    ret opt[ptr].some{(chunk::usize + start)::ptr};
}

fun memory_reallocate(context: ptr, p: ptr, old_size: usize, new_size: usize,
    align: usize) opt[ptr] {
    val memory: *Memory = context::*Memory;
    if (p == nil)      { ret memory_allocate(context, new_size, align); }
    if (new_size == 0) { ret opt[ptr].some{nil}; }
    if (memory.head != nil && p::usize == memory.head::usize + memory.last_offset
        && old_size == memory.last_size && new_size <= memory.head_size - memory.last_offset) {
        memory.last_size = new_size;
        memory.offset    = memory.last_offset + new_size;
        ret opt[ptr].some{p};
    }
    val fresh: opt[ptr] = memory_allocate(context, new_size, align);
    if (!(sel fresh.some)) { ret fresh; }
    var count: usize = old_size;
    if (new_size < count) { count = new_size; }
    mem.raw_copy(fresh.some, p, count);
    ret fresh;
}

fun memory_deallocate(context: ptr, p: ptr, size: usize, align: usize) i64 {
    val memory: *Memory = context::*Memory;
    if (p != nil && memory.head != nil
        && p::usize == memory.head::usize + memory.last_offset && size == memory.last_size) {
        memory.offset    = memory.last_offset;
        memory.last_size = 0;
    }
    ret 0;
}

pub fun make_memory(memory: *Memory, chunks: *storage.Chunks, limit: usize) bool {
    if (memory == nil || chunks == nil || limit == 0) { ret false; }
    memory.allocator = allocator.Allocator{ctx: memory::ptr, fn_allocate: memory_allocate,
        fn_reallocate: memory_reallocate, fn_deallocate: memory_deallocate};
    memory.chunks      = chunks;
    memory.head        = nil;
    memory.head_size   = 0;
    memory.offset      = 0;
    memory.last_offset = 0;
    memory.last_size   = 0;
    memory.held        = 0;
    memory.limit       = limit;
    memory.refused     = false;
    memory.initialized = true;
    ret true;
}

# returns every chunk. the next exchange starts from the bound it is given
pub fun reset_memory(memory: *Memory, limit: usize) bool {
    if (memory == nil || !memory.initialized) { ret false; }
    var ok: bool = true;
    for (memory.head != nil) {
        val link:     *ChunkLink = memory.head::*ChunkLink;
        val previous: *u8        = link.previous;
        val size:     usize      = link.previous_size;
        if (!storage.release_chunk(memory.chunks, memory.head, memory.head_size)) { ok = false; }
        memory.head      = previous;
        memory.head_size = size;
    }
    memory.offset      = 0;
    memory.last_offset = 0;
    memory.last_size   = 0;
    memory.held        = 0;
    if (limit != 0) { memory.limit = limit; }
    memory.refused = false;
    ret ok;
}

# a response recorder observes the committed head and every body byte on its way
# to the client
#
# the connection is the one place every response passes, whatever produced it, so
# a cache attaches here rather than wrapping each service. `complete` is false
# when the response ended early, and a recorder must then keep nothing.
pub def RecordHeadFun: fun(ptr, *Call) bool;
pub def RecordBodyFun: fun(ptr, *u8, usize) bool;
pub def RecordEndFun:  fun(ptr, bool);

pub rec Recorder {
    ctx:     ptr;
    on_head: RecordHeadFun;
    on_body: RecordBodyFun;
    on_end:  RecordEndFun;
}

pub fun no_recorder() Recorder {
    ret Recorder{
        ctx:     nil,
        on_head: (0::usize)::RecordHeadFun,
        on_body: (0::usize)::RecordBodyFun,
        on_end:  (0::usize)::RecordEndFun,
    };
}

# one service-owned request can defer cleanup until the exchange has the final
# status, transfer counters, and cancellation reason
pub def FinalizeFun: fun(ptr, *Call) bool;

pub rec Finalizer {
    ctx:    ptr;
    finish: FinalizeFun;
}

# process-wide request observation is independent of the one service-owned
# finalizer. it starts before listener-level or route dispatch and finishes once
# after the exchange reaches its terminal state.
pub def ObserveBeginFun: fun(ptr, *Call) bool;
pub def ObserveEndFun:   fun(ptr, *Call, bool);

pub rec Observer {
    ctx:   ptr;
    begin: ObserveBeginFun;
    end:   ObserveEndFun;
}

pub fun no_observer() Observer {
    ret Observer{ctx: nil, begin: (0::usize)::ObserveBeginFun,
        end: (0::usize)::ObserveEndFun};
}

pub fun no_finalizer() Finalizer {
    ret Finalizer{ctx: nil, finish: (0::usize)::FinalizeFun};
}

pub fun recording(active: *Call) bool {
    ret active != nil && active.recorder.on_head::usize != 0;
}

# whether the call's recorder is the one whose head is `on_head`. the head
# function identifies the recorder's owner, as the finish function does a
# finalizer's, so a service entered again finds the recorder it attached
pub fun recorded_by(active: *Call, on_head: RecordHeadFun) bool {
    ret recording(active) && on_head::usize != 0
        && active.recorder.on_head::usize == on_head::usize;
}

# a pre-commit interceptor may replace a proposed response exactly once
pub def Interception: u8;
pub val INTERCEPT_CONTINUE: Interception = 1;
pub val INTERCEPT_REPLACED: Interception = 2;
pub val INTERCEPT_FAILED:   Interception = 3;

pub def InterceptFun: fun(ptr, *Call) Interception;

pub rec Interceptor {
    ctx:       ptr;
    intercept: InterceptFun;
}

pub fun no_interceptor() Interceptor {
    ret Interceptor{ctx: nil, intercept: (0::usize)::InterceptFun};
}

# a call is observed by at most one recorder, attached before the service runs
pub fun attach_recorder(active: *Call, recorder: Recorder) bool {
    if (active == nil || !active.bound || recording(active)
        || recorder.on_head::usize == 0) { ret false; }
    active.recorder      = recorder;
    active.recorder_live = false;
    ret true;
}

pub fun record_head(active: *Call) bool {
    if (!recording(active) || active.recorder_live) { ret true; }
    active.recorder_live = active.recorder.on_head(active.recorder.ctx, active);
    ret active.recorder_live;
}

pub fun record_body(active: *Call, data: *u8, length: usize) bool {
    if (!recording(active) || !active.recorder_live) { ret true; }
    if (active.recorder.on_body::usize == 0)         { ret true; }
    if (!active.recorder.on_body(active.recorder.ctx, data, length)) {
        active.recorder_live = false;
    }
    ret true;
}

pub fun record_end(active: *Call, complete: bool) {
    if (!recording(active)) { ret; }
    if (active.recorder.on_end::usize != 0) {
        active.recorder.on_end(active.recorder.ctx, complete && active.recorder_live);
    }
    active.recorder_live = false;
}

# a call binds one exchange to one route for one generation
#
# deadlines and cancellation are not copied here: the exchange scope remains their
# single authority, and the accessors below read through to it. the fields this
# record does own are the ones the exchange has no place for.
pub rec Call {
    exchange:   *exchange.Exchange;
    memory:     *Memory;
    telemetry:  *trace.Context;
    route:      Route;
    generation: u64;
    listener:   str;
    # the monotonic instant the call was bound at receipt. durations are
    # measured from it, never from the calendar `received_at`
    received_ns:          u64;
    secure:               bool;
    disposition:          Disposition;
    recorder:             Recorder;
    recorder_live:        bool;
    interceptor:          Interceptor;
    interceptor_running:  bool;
    interceptor_replaced: bool;
    finalizer:            Finalizer;
    observer:             Observer;
    observed:             bool;
    bound:                bool;
    entered:              bool;
    settled:              bool;
    # who to wake when something the service waits on settles, what the
    # service said it waits on the last time it reported itself pending, and
    # which of those has moved since
    waker:            hedge_wake.Waker;
    wait:             Wait;
    wait_deadline_ns: u64;
    stirred:          Wait;
}

# what a pending service waits on. a service that reports itself pending names
# at least one, because nothing else would ever give it another turn
pub def Wait: u8;
pub val WAIT_NONE: Wait = 0;
# the request body, which the connection delivers through its own i/o
pub val WAIT_BODY: Wait = 1;
# something that holds this call's waker and wakes it when it settles
pub val WAIT_WAKE: Wait = 2;

pub fun bind(
    call: *Call,
    active: *exchange.Exchange,
    memory: *Memory,
    telemetry: *trace.Context,
    generation: u64,
    listener: str,
    waker: hedge_wake.Waker,
) bool {
    if (call == nil || active == nil || memory == nil || !memory.initialized
        || generation == 0 || !active.valid || active.scope == nil
        || !hedge_wake.valid(?waker)) { ret false; }
    call.waker                = waker;
    call.wait                 = WAIT_NONE;
    call.wait_deadline_ns     = 0;
    call.stirred              = WAIT_NONE;
    call.exchange             = active;
    call.memory               = memory;
    call.telemetry            = telemetry;
    call.route                = no_route();
    call.generation           = generation;
    call.listener             = listener;
    call.received_ns          = clock.monotonic_ns();
    call.secure               = active.request.metadata.secure;
    call.disposition          = BODY_UNRESOLVED;
    call.recorder             = no_recorder();
    call.recorder_live        = false;
    call.interceptor          = no_interceptor();
    call.interceptor_running  = false;
    call.interceptor_replaced = false;
    call.finalizer            = no_finalizer();
    call.observer             = no_observer();
    call.observed             = false;
    call.bound                = true;
    call.entered              = false;
    call.settled              = false;
    ret true;
}

pub fun observe(call: *Call, observer: Observer) bool {
    if (call == nil || !call.bound || call.observed) { ret false; }
    call.observer = observer;
    if (observer.begin::usize != 0 && !observer.begin(observer.ctx, call)) {
        call.observer = no_observer();
        ret false;
    }
    call.observed = true;
    ret true;
}

# a bound call crosses the service boundary exactly once
pub fun enter(call: *Call, route: Route) bool {
    if (call == nil || !call.bound || call.entered) { ret false; }
    call.route   = route;
    call.entered = true;
    ret true;
}

pub fun entered(call: *Call) bool {
    ret call != nil && call.entered;
}

pub fun attach_finalizer(call: *Call, finalizer: Finalizer) bool {
    if (call == nil || !call.bound || !call.entered || call.settled
        || call.finalizer.finish::usize != 0 || finalizer.finish::usize == 0) {
        ret false;
    }
    call.finalizer = finalizer;
    ret true;
}

# a service reclaims the per-exchange state it owns when it is entered again
#
# the finalizer slot is the one place a call holds service-owned state, and the
# function identifies its owner, so a service that reported itself pending finds
# what it left behind without a registry of its own.
pub fun finalizer_state(call: *Call, finish: FinalizeFun) ptr {
    if (call == nil || !call.bound || call.settled || finish::usize == 0
        || call.finalizer.finish::usize != finish::usize) { ret nil; }
    ret call.finalizer.ctx;
}

# a service gives the finalizer slot back once its state is settled some other
# way, so another service the call reaches can take it. only its owner can
pub fun detach_finalizer(call: *Call, finish: FinalizeFun) bool {
    if (finalizer_state(call, finish) == nil) { ret false; }
    call.finalizer = no_finalizer();
    ret true;
}

pub fun attach_interceptor(call: *Call, interceptor: Interceptor) bool {
    if (call == nil || !call.bound || !call.entered || call.settled
        || call.interceptor.intercept::usize != 0 || call.interceptor_running
        || interceptor.intercept::usize == 0) { ret false; }
    call.interceptor = interceptor;
    ret true;
}

fun reset_uncommitted_response(call: *Call) bool {
    if (call == nil || !call.bound || call.settled || call.exchange == nil) {
        ret false;
    }
    val response: *message.Response = call.exchange.response;
    if (response == nil || response.committed) { ret false; }
    if (response.body_kind == message.BODY_READER) {
        val reader: *body.Reader = response.body_reader;
        if (reader == nil) { ret false; }
        if (!body.reader_terminal_state(reader)) {
            if (reader.pending_kind != body.OP_NONE) { ret false; }
            val cancelled: body.Progress = body.cancel_reader(reader);
            if (cancelled.status == body.PENDING
                || !body.reader_terminal_state(reader)) { ret false; }
        }
    }
    or (response.body_kind != message.BODY_NONE) {
        ret false;
    }
    val fields:           *field.Field = response.fields.items;
    val field_capacity:   usize        = response.fields.capacity;
    val trailers:         *field.Field = response.trailers.items;
    val trailer_capacity: usize        = response.trailers.capacity;
    val generation:       u64          = response.generation;
    if (!message.init_response(response, fields, field_capacity, trailers,
        trailer_capacity, generation, call.exchange.limits)) { ret false; }
    ret true;
}

# replacement preserves the inner service's one request-body ownership decision
pub fun reset_response_for_interceptor(call: *Call) bool {
    if (call == nil || !call.interceptor_running
        || call.interceptor_replaced) { ret false; }
    if (!reset_uncommitted_response(call)) { ret false; }
    call.interceptor_replaced = true;
    ret true;
}

# a generated failure never inherits fields or a body from the proposal that
# failed. an asynchronously cancelling body keeps the exchange noncommittable.
pub fun reset_response_for_failure(call: *Call) bool {
    if (call == nil || call.interceptor_running) { ret false; }
    ret reset_uncommitted_response(call);
}

# service.commit is the sole caller, immediately before exchange commitment
pub fun intercept_response(call: *Call) Interception {
    if (call == nil || !call.bound || call.settled || call.exchange == nil
        || call.exchange.response == nil || call.exchange.response.committed) {
        ret INTERCEPT_FAILED;
    }
    if (call.interceptor.intercept::usize == 0) { ret INTERCEPT_CONTINUE; }
    if (!call.entered || call.interceptor_running
        || call.disposition == BODY_UNRESOLVED) { ret INTERCEPT_FAILED; }
    val interceptor: Interceptor = call.interceptor;
    call.interceptor          = no_interceptor();
    call.interceptor_running  = true;
    call.interceptor_replaced = false;
    val outcome: Interception = interceptor.intercept(interceptor.ctx, call);
    call.interceptor_running = false;
    if (outcome == INTERCEPT_REPLACED && call.interceptor_replaced) {
        ret INTERCEPT_REPLACED;
    }
    if (outcome == INTERCEPT_CONTINUE && !call.interceptor_replaced) {
        ret INTERCEPT_CONTINUE;
    }
    ret INTERCEPT_FAILED;
}

# the owning service resolves body disposition once; the connection reads it after
pub fun resolve_body(call: *Call, chosen: Disposition) bool {
    if (call == nil || !call.bound || call.disposition != BODY_UNRESOLVED
        || chosen == BODY_UNRESOLVED || chosen > BODY_CLOSE) { ret false; }
    call.disposition = chosen;
    ret true;
}

pub fun disposition(call: *Call) Disposition {
    if (call == nil) { ret BODY_UNRESOLVED; }
    ret call.disposition;
}

pub fun allocator_of(call: *Call) *allocator.Allocator {
    if (call == nil || call.memory == nil || !call.memory.initialized) { ret nil; }
    ret ?call.memory.allocator;
}

# the bytes of chunk this call may hold, which is what a budget charges
pub fun memory_capacity(call: *Call) usize {
    if (call == nil || call.memory == nil || !call.memory.initialized) { ret 0; }
    ret call.memory.limit;
}

# the selected route's bound replaces the server's before the handler runs
pub fun bound_memory(call: *Call, limit: usize) bool {
    if (call == nil || call.memory == nil || !call.memory.initialized || limit == 0) {
        ret false;
    }
    call.memory.limit = limit;
    ret true;
}

# an allocation was refused because the bound or the chunk classes ran out
pub fun memory_refused(call: *Call) bool {
    ret call != nil && call.memory != nil && call.memory.refused;
}

# the waker a service hands to whatever it is about to wait on
pub fun waker(call: *Call) hedge_wake.Waker {
    if (call == nil || !call.bound) { ret hedge_wake.no_waker(); }
    ret call.waker;
}

# report the service pending on `wait`, and on `deadline_ns` (monotonic, zero for
# none) when it also has to run again at a set time. naming nothing is a service
# that would never run again, so it fails instead
pub fun park(call: *Call, wait: Wait, deadline_ns: u64) exchange.ServiceStatus {
    if (call == nil || !call.bound || call.settled
        || (wait == WAIT_NONE && deadline_ns == 0)) { ret exchange.SERVICE_FAILED; }
    call.wait = call.wait | wait;
    if (deadline_ns != 0
        && (call.wait_deadline_ns == 0 || deadline_ns < call.wait_deadline_ns)) {
        call.wait_deadline_ns = deadline_ns;
    }
    ret exchange.SERVICE_PENDING;
}

# report the service pending and ask for another turn as soon as the worker
# can give one, for a service that has more to do but chooses to yield
pub fun yield_turn(call: *Call) exchange.ServiceStatus {
    if (call == nil || !call.bound || !hedge_wake.wake(?call.waker)) {
        ret exchange.SERVICE_FAILED;
    }
    ret park(call, WAIT_WAKE, 0);
}

# forget the previous turn's wait before the service is entered again
pub fun unpark(call: *Call) {
    if (call == nil) { ret; }
    call.wait             = WAIT_NONE;
    call.wait_deadline_ns = 0;
    call.stirred          = WAIT_NONE;
}

# the host records that `moved` has moved for a parked call. only what the
# service named counts: a wake for a service waiting on its body, or body bytes
# for one waiting on a wake, leave it parked
pub fun stir(call: *Call, moved: Wait) {
    if (call == nil || !call.bound) { ret; }
    call.stirred = call.stirred | (moved & call.wait);
}

# whether something the parked service named has moved since it parked
pub fun stirred(call: *Call) bool {
    ret call != nil && call.stirred != WAIT_NONE;
}

# whether entering a parked service again at `now_ns` (monotonic) can do more
# than park it again: a wait it named moved, its wait deadline passed, or its
# exchange was cancelled, which the service has to see to give it up
pub fun due(call: *Call, now_ns: u64) bool {
    if (call == nil || !call.bound)                                    { ret false; }
    if (call.stirred != WAIT_NONE)                                     { ret true; }
    if (call.wait_deadline_ns != 0 && now_ns >= call.wait_deadline_ns) { ret true; }
    ret cancelled(call);
}

pub fun parked(call: *Call) bool {
    ret call != nil && (call.wait != WAIT_NONE || call.wait_deadline_ns != 0);
}

pub fun wait_deadline(call: *Call, output: *u64) bool {
    if (call == nil || output == nil || call.wait_deadline_ns == 0) { ret false; }
    @output = call.wait_deadline_ns;
    ret true;
}

pub fun scope(call: *Call) *cancel.Scope {
    if (call == nil || call.exchange == nil) { ret nil; }
    ret call.exchange.scope;
}

pub fun deadline(call: *Call, output: *time.Instant) bool {
    val active: *cancel.Scope = scope(call);
    if (active == nil || output == nil) { ret false; }
    val query: cancel.DeadlineQuery = cancel.get_deadline(active);
    if (sel query.err)     { ret false; }
    if (sel query.ok.none) { ret false; }
    @output = query.ok.some.at;
    ret true;
}

pub fun cancelled(call: *Call) bool {
    val active: *cancel.Scope = scope(call);
    if (active == nil) { ret true; }
    ret !scope_active(active);
}

pub fun request(call: *Call) *message.Request {
    if (call == nil || call.exchange == nil) { ret nil; }
    ret call.exchange.request;
}

pub fun response(call: *Call) *message.Response {
    if (call == nil || call.exchange == nil) { ret nil; }
    ret call.exchange.response;
}

pub fun limits(call: *Call) message.Limits {
    ret call.exchange.limits;
}

# a completed exchange needs an explicit body disposition before reuse; an
# abandoned exchange cannot be reused and needs only its terminal state
pub fun releasable(call: *Call) bool {
    if (call == nil || !call.bound) { ret false; }
    val state: exchange.State = call.exchange.state;
    if (state == exchange.COMPLETE_STATE) {
        ret call.disposition != BODY_UNRESOLVED;
    }
    ret state == exchange.CANCELLED_STATE || state == exchange.TIMED_OUT_STATE
        || state == exchange.FAILED_STATE;
}

fun finish_call(call: *Call, complete: bool) bool {
    call.settled = true;
    record_end(call, complete);
    if (call.observed && call.observer.end::usize != 0) {
        call.observer.end(call.observer.ctx, call, complete);
    }
    var finalized: bool = true;
    if (call.finalizer.finish::usize != 0) {
        val finalizer: Finalizer = call.finalizer;
        call.finalizer = no_finalizer();
        finalized      = finalizer.finish(finalizer.ctx, call);
    }
    val reset: bool = reset_memory(call.memory, 0);
    ret finalized && reset;
}

pub fun release(call: *Call) bool {
    if (!releasable(call) || call.settled) { ret false; }
    ret finish_call(call, call.exchange.state == exchange.COMPLETE_STATE);
}

# a permanently invalid exchange still releases call-owned observers, recorders,
# finalizers and arena exactly once before its transport owner is discarded
pub fun abandon(call: *Call) bool {
    if (call == nil || !call.bound || call.settled) { ret false; }
    ret finish_call(call, false);
}

rec FinalizerStateProbe {
    value: usize;
}

fun state_probe_finish(context: ptr, active: *Call) bool {
    ret true;
}

fun other_probe_finish(context: ptr, active: *Call) bool {
    ret true;
}

test "call: a service reclaims its own finalizer state and no one else's" {
    var probe: FinalizerStateProbe;
    probe.value = 42;
    var active: Call;
    active.bound   = true;
    active.entered = true;
    if (finalizer_state(?active, state_probe_finish) != nil) { ret 1; }
    if (!attach_finalizer(?active, Finalizer{
        ctx: (?probe)::ptr, finish: state_probe_finish
    })) { ret 2; }
    val found: ptr = finalizer_state(?active, state_probe_finish);
    if (found == nil) { ret 3; }
    val owner: *FinalizerStateProbe = found::*FinalizerStateProbe;
    if (owner.value != 42) { ret 3; }
    # another service asking with its own function gets nothing rather than a
    # pointer it would read as its own state
    if (finalizer_state(?active, other_probe_finish) != nil) { ret 4; }
    # the slot holds one finalizer, so a second service cannot install another
    # and the lookup can never have two owners to choose between
    if (attach_finalizer(?active, Finalizer{
        ctx: nil, finish: other_probe_finish
    })) { ret 5; }
    # only the owner gives the slot back, and then another service can take it
    if (detach_finalizer(?active, other_probe_finish)) { ret 7; }
    if (!detach_finalizer(?active, state_probe_finish)
        || finalizer_state(?active, state_probe_finish) != nil) { ret 8; }
    if (!attach_finalizer(?active, Finalizer{
        ctx: (?probe)::ptr, finish: state_probe_finish
    })) { ret 9; }
    # a settled call has already run and cleared its finalizer
    active.settled = true;
    if (finalizer_state(?active, state_probe_finish) != nil) { ret 6; }
    ret 0;
}

fun probe_head(context: ptr, active: *Call) bool {
    ret false;
}

fun other_probe_head(context: ptr, active: *Call) bool {
    ret false;
}

test "call: a service finds the recorder it attached and no one else's" {
    var active: Call;
    active.bound    = true;
    active.recorder = no_recorder();
    if (recorded_by(?active, probe_head)) { ret 1; }
    if (!attach_recorder(?active, Recorder{
        ctx:     nil, on_head: probe_head,
        on_body: (0::usize)::RecordBodyFun, on_end: (0::usize)::RecordEndFun,
    })) { ret 2; }
    if (!recorded_by(?active, probe_head))               { ret 3; }
    if (recorded_by(?active, other_probe_head))          { ret 4; }
    if (recorded_by(?active, (0::usize)::RecordHeadFun)) { ret 5; }
    # the recorder outlives its end, so a late entry still finds it
    record_end(?active, false);
    if (!recorded_by(?active, probe_head)) { ret 6; }
    if (recorded_by(nil, probe_head))      { ret 7; }
    ret 0;
}

rec PendingCancelBody {
    finish_calls:  usize;
    release_calls: usize;
}

fun pending_cancel_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.complete(body.REUSE_ALLOWED);
}

fun pending_cancel_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *PendingCancelBody = context::*PendingCancelBody;
    state.finish_calls = state.finish_calls + 1;
    if (mode == body.CANCEL) { ret body.pending(77); }
    ret body.failed("unexpected finish mode", body.REUSE_FORBIDDEN);
}

fun pending_cancel_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    if (token != 77) {
        ret body.failed("unexpected cancellation token", body.REUSE_FORBIDDEN);
    }
    ret body.cancelled(body.REUSE_FORBIDDEN);
}

fun pending_cancel_release(context: ptr) {
    val state: *PendingCancelBody = context::*PendingCancelBody;
    state.release_calls = state.release_calls + 1;
}

fun replace_pending_response(context: ptr, active: *Call) Interception {
    if (reset_response_for_interceptor(active)) { ret INTERCEPT_REPLACED; }
    ret INTERCEPT_FAILED;
}

test "call: an asynchronously cancelling intercepted body remains noncommittable" {
    val configured: message.Limits = message.limits_default();
    var scope:      cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    var trailers:   field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var body_state: PendingCancelBody;
    body_state.finish_calls  = 0;
    body_state.release_calls = 0;
    var reader: body.Reader = body.init_reader((?body_state)::ptr,
        pending_cancel_read, pending_cancel_finish, pending_cancel_complete,
        pending_cancel_release, body.OWNER_APPLICATION, 7, true, 4,
        configured.response_body, ?trailers, ?scope);
    var response_fields:   [4]field.Field;
    var response_trailers: [2]field.Field;
    var response:          message.Response;
    if (!message.init_response(?response, ?response_fields[0], 4,
        ?response_trailers[0], 2, 7, configured)
        || message.set_body_reader(?response, ?reader, configured)
        != message.RESPONSE_OK) {
        operation_ok(cancel.destroy(?scope));
        ret 2;
    }
    var active_exchange: exchange.Exchange;
    active_exchange.response = ?response;
    active_exchange.limits   = configured;
    var active: Call;
    active.exchange             = ?active_exchange;
    active.bound                = true;
    active.entered              = true;
    active.settled              = false;
    active.disposition          = BODY_DRAIN;
    active.interceptor_running  = false;
    active.interceptor_replaced = false;
    active.interceptor          = Interceptor{
        ctx:       nil,
        intercept: replace_pending_response,
    };
    if (intercept_response(?active) != INTERCEPT_FAILED
        || body_state.finish_calls != 1 || body_state.release_calls != 0
        || reader.pending_kind != body.OP_FINISH || response.committed
        || response.body_kind != message.BODY_READER) {
        cancel.destroy(?scope);
        ret 3;
    }
    if (reset_response_for_failure(?active)) {
        operation_ok(cancel.destroy(?scope));
        ret 4;
    }
    if (body.complete_reader(?reader, 77).status != body.CANCELLED
        || body_state.release_calls != 1
        || !reset_response_for_failure(?active)
        || response.body_kind != message.BODY_NONE
        || response.committed) {
        operation_ok(cancel.destroy(?scope));
        ret 5;
    }
    if (!operation_ok(cancel.destroy(?scope))) { ret 6; }
    ret 0;
}

test "call: request memory grows by chunks up to its bound and reports a refusal" {
    var heap: allocator.Allocator;
    page.make(?heap);
    var chunks: storage.Chunks;
    if (!storage.make_chunks(?chunks, ?heap)) { ret 1; }
    var memory: Memory;
    if (!make_memory(?memory, ?chunks, storage.MIN_CHUNK * 2)) { ret 2; }
    val a: *allocator.Allocator = ?memory.allocator;
    # two small allocations share the first chunk
    val first:  res[*u8, allocator.Error] = allocator.allocate[u8](a, 1024);
    val second: res[*u8, allocator.Error] = allocator.allocate[u8](a, 1024);
    if (sel first.err || sel second.err || memory.held != storage.MIN_CHUNK) { ret 3; }
    # the rest of the bound is one more chunk, and everything past it is refused
    val third: res[*u8, allocator.Error] = allocator.allocate[u8](a, storage.MIN_CHUNK - 256);
    if (sel third.err || memory.held != storage.MIN_CHUNK * 2 || memory.refused) { ret 4; }
    val fourth: res[*u8, allocator.Error] = allocator.allocate[u8](a, storage.MIN_CHUNK);
    if (!(sel fourth.err) || !memory.refused) { ret 5; }
    # a larger bound admits a dedicated chunk for a large allocation
    memory.limit = storage.MIN_CHUNK * 8;
    val large: res[*u8, allocator.Error] = allocator.allocate[u8](a, storage.MIN_CHUNK * 3);
    if (sel large.err)                        { ret 6; }
    if (memory.held != storage.MIN_CHUNK * 6) { ret 6; }
    large.ok[storage.MIN_CHUNK * 3 - 1] = 7;
    if (!reset_memory(?memory, storage.MIN_CHUNK) || memory.held != 0 || memory.refused
        || memory.limit != storage.MIN_CHUNK) { ret 7; }
    if (!storage.destroy_chunks(?chunks)) { ret 8; }
    ret 0;
}

test "call: the most recent request allocation resizes and rolls back in place" {
    var heap: allocator.Allocator;
    page.make(?heap);
    var chunks: storage.Chunks;
    if (!storage.make_chunks(?chunks, ?heap)) { ret 1; }
    var memory: Memory;
    if (!make_memory(?memory, ?chunks, storage.MIN_CHUNK)) { ret 2; }
    val a:     *allocator.Allocator      = ?memory.allocator;
    val grown: res[*u8, allocator.Error] = allocator.allocate[u8](a, 16);
    if (sel grown.err) { ret 3; }
    grown.ok[0] = 42;
    val resized: res[*u8, allocator.Error] = allocator.reallocate[u8](a, grown.ok, 16, 64);
    if (sel resized.err)                               { ret 4; }
    if (resized.ok != grown.ok || resized.ok[0] != 42) { ret 4; }
    val before:   usize                = memory.offset;
    val released: err[allocator.Error] = allocator.deallocate[u8](a, resized.ok, 64);
    if (sel released.err)                                              { ret 5; }
    if (memory.offset >= before)                                       { ret 5; }
    if (!reset_memory(?memory, 0) || !storage.destroy_chunks(?chunks)) { ret 6; }
    ret 0;
}
