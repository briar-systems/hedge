# the request line HTTP/2 and HTTP/3 carry as pseudo-header fields
#
# `:method` and `:path` arrive as field values rather than a parsed request
# line, so both engines turn them into a method and a target the same way here

use http.core.method;
use http.core.target;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

# method names are exact tokens, so this compares them exactly. a
# case-insensitive match here would accept `get` as GET, which HTTP/1 does not.
pub fun token_is(name: view.View, expected: str, length: usize) bool {
    if (name.len != length || name.data == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (name.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun method_of(name: view.View) method.Method {
    if (token_is(name, "GET", 3))     { ret method.from_kind(method.GET); }
    if (token_is(name, "HEAD", 4))    { ret method.from_kind(method.HEAD); }
    if (token_is(name, "POST", 4))    { ret method.from_kind(method.POST); }
    if (token_is(name, "PUT", 3))     { ret method.from_kind(method.PUT); }
    if (token_is(name, "DELETE", 6))  { ret method.from_kind(method.DELETE); }
    if (token_is(name, "CONNECT", 7)) { ret method.from_kind(method.CONNECT); }
    if (token_is(name, "OPTIONS", 7)) { ret method.from_kind(method.OPTIONS); }
    if (token_is(name, "TRACE", 5))   { ret method.from_kind(method.TRACE); }
    if (token_is(name, "PATCH", 5))   { ret method.from_kind(method.PATCH); }
    ret method.extension(name);
}

# `:path` carries the origin form, which HTTP/1 splits in its parser. HTTP/2
# and HTTP/3 do not, so the split happens once here rather than in every service.
pub fun target_of(raw: view.View) target.Target {
    if (raw.len == 1 && raw.data != nil && raw.data[0] == '*'::u8) {
        ret target.asterisk();
    }
    var cut: usize = raw.len;
    var i:   usize = 0;
    for (i < raw.len) {
        if (raw.data[i] == '?'::u8) {
            cut = i;
            brk;
        }
        i = i + 1;
    }
    val path:  view.View = view.view(raw.data, cut);
    var query: view.View = view.view(nil, 0);
    if (cut < raw.len) {
        query = view.view(?raw.data[cut + 1], raw.len - cut - 1);
    }
    ret target.origin(raw, path, query);
}

test target_of__path_query_split {
    val plain: target.Target = target_of(view.view("/hello", 6));
    if (plain.path.len != 6 || plain.query.len != 0) { ret 1; }
    val queried: target.Target = target_of(view.view("/hello?a=1", 10));
    if (queried.path.len != 6)                                      { ret 2; }
    if (queried.query.len != 3 || queried.query.data[0] != 'a'::u8) { ret 3; }
    # a trailing marker is an empty query, not a missing one
    val empty: target.Target = target_of(view.view("/hello?", 7));
    if (empty.path.len != 6 || empty.query.len != 0) { ret 4; }
    # and the raw form keeps everything the peer sent
    if (queried.raw.len != 10) { ret 5; }
    val star: target.Target = target_of(view.view("*", 1));
    if (star.form != target.ASTERISK) { ret 6; }
    ret 0;
}

test method_of__kinds_and_extensions {
    if (method_of(view.view("GET", 3)).kind != method.GET)         { ret 1; }
    if (method_of(view.view("POST", 4)).kind != method.POST)       { ret 2; }
    if (method_of(view.view("PATCH", 5)).kind != method.PATCH)     { ret 3; }
    if (method_of(view.view("CONNECT", 7)).kind != method.CONNECT) { ret 4; }
    val custom: method.Method = method_of(view.view("PURGE", 5));
    if (custom.kind != method.EXTENSION || custom.token.len != 5) { ret 5; }
    # case matters: HTTP/2 method names are exact tokens
    if (method_of(view.view("get", 3)).kind != method.EXTENSION) { ret 6; }
    ret 0;
}
