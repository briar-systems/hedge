# field names for the protocols that require them in lowercase
#
# HTTP/1 field names are case-insensitive and arrive however the sender wrote
# them, from a client, an upstream or a service. HTTP/2 and HTTP/3 carry them in
# lowercase only (rfc 9113 section 8.2.1, rfc 9114 section 4.2), and the sender
# is the one that must lower them. the h2 and h3 adapters build every header
# list they send through here, so no producer has to know which protocol its
# fields leave on.
#
# a list is encoded as soon as it is offered, so one scratch per session is
# enough, and it is reset for every list.

use http.core.field;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;

# room for every lowered name of one header list
pub val NAME_BYTES: usize = 4096;

pub rec Scratch {
    bytes: [NAME_BYTES]u8;
    used:  usize;
}

pub fun reset(scratch: *Scratch) {
    scratch.used = 0;
}

fun has_upper(name: view.View) bool {
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] >= 'A' && name.data[i] <= 'Z') { ret true; }
        i = i + 1;
    }
    ret false;
}

# `item` with a lowercase name, copied into `output`. a name that is already
# lowercase is shared rather than copied. false when the scratch is full, which
# the list cannot be sent without
pub fun lower(scratch: *Scratch, item: *field.Field, output: *field.Field) bool {
    if (scratch == nil || item == nil || output == nil) { ret false; }
    @output = @item;
    if (item.name.data == nil || !has_upper(item.name)) { ret true; }
    if (item.name.len > NAME_BYTES - scratch.used)      { ret false; }
    val start: *u8   = ?scratch.bytes[scratch.used];
    var i:     usize = 0;
    for (i < item.name.len) {
        var byte: u8 = item.name.data[i];
        if (byte >= 'A' && byte <= 'Z') { byte = byte + 32; }
        start[i] = byte;
        i        = i + 1;
    }
    scratch.used = scratch.used + item.name.len;
    output.name  = view.view(start, item.name.len);
    ret true;
}

test "names: a mixed-case name is lowered and a lowercase name is shared" {
    var scratch: Scratch;
    reset(?scratch);
    var mixed: field.Field = field.Field{name: view.view("Last-Modified", 13),
        value: view.view("x", 1), sensitive: false};
    var plain: field.Field = field.Field{name: view.view("etag", 4),
        value: view.view("y", 1), sensitive: false};
    var out: [2]field.Field;
    if (!lower(?scratch, ?mixed, ?out[0]) || !lower(?scratch, ?plain, ?out[1])) { ret 1; }
    if (!field.name_equal(out[0].name, view.view("last-modified", 13)))         { ret 2; }
    if (out[0].name.data[0] != 'l' || out[0].name.data[4] != '-')               { ret 3; }
    if (out[1].name.data != plain.name.data || scratch.used != 13)              { ret 4; }
    if (out[0].value.data != mixed.value.data)                                  { ret 5; }
    ret 0;
}

test "names: a list whose names do not fit is refused" {
    var scratch: Scratch;
    reset(?scratch);
    scratch.used = NAME_BYTES - 2;
    var item: field.Field = field.Field{name: view.view("Server", 6),
        value: view.view("x", 1), sensitive: false};
    var out: field.Field;
    if (lower(?scratch, ?item, ?out)) { ret 1; }
    ret 0;
}
