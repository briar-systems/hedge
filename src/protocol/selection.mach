# which application protocol a connection speaks, decided from listener policy
# and the evidence the peer actually offered
#
# selection is pure: it reads policy and bytes and returns a decision. it opens
# nothing and owns nothing, so the same rules are testable without a socket and
# cannot drift between the cleartext, TLS, and QUIC paths.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use schema: hedge.config.schema;

pub def Protocol: u8;
pub val NONE: Protocol = 0;
pub val HTTP1: Protocol = 1;
pub val HTTP2: Protocol = 2;
pub val HTTP3: Protocol = 3;

pub def Outcome: u8;
pub val SELECTED: Outcome = 1;
# the peer offered nothing the listener serves
pub val NO_PROTOCOL: Outcome = 2;
# more bytes are needed before the cleartext form is known
pub val PENDING: Outcome = 3;
# the peer's offer contradicts listener policy
pub val REFUSED: Outcome = 4;

pub rec Policy {
    # bitmask of schema.PROTOCOL_HTTP1 / HTTP2 / HTTP3
    protocols: u8;
    tls: bool;
    # a TLS listener never answers a cleartext request, and vice versa
    require_tls: bool;
}

pub rec Decision {
    outcome: Outcome;
    protocol: Protocol;
}

# assigned by name: an empty record literal does not reliably clear its
# members. see briar-systems/mach#3108.
fun decision(outcome: Outcome, protocol: Protocol) Decision {
    var value: Decision;
    value.outcome = outcome;
    value.protocol = protocol;
    ret value;
}

pub fun policy(protocols: u8, tls: bool, require_tls: bool) Policy {
    var value: Policy;
    value.protocols = protocols;
    value.tls = tls;
    value.require_tls = require_tls;
    ret value;
}

pub fun offers(value: Policy, protocol: Protocol) bool {
    if (protocol == HTTP1) { ret (value.protocols & schema.PROTOCOL_HTTP1) != 0; }
    if (protocol == HTTP2) { ret (value.protocols & schema.PROTOCOL_HTTP2) != 0; }
    if (protocol == HTTP3) { ret (value.protocols & schema.PROTOCOL_HTTP3) != 0; }
    ret false;
}

pub val PREFACE: str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";
pub val PREFACE_BYTES: usize = 24;

fun preface_prefix(data: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len && i < PREFACE_BYTES) {
        if (data[i] != PREFACE[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a cleartext connection is HTTP/2 only by prior knowledge, which is the exact
# client preface and nothing else. anything that diverges from it is HTTP/1,
# and a listener that does not serve HTTP/1 refuses rather than guessing.
pub fun select_cleartext(value: Policy, data: *u8, len: usize) Decision {
    if (value.require_tls) { ret decision(REFUSED, NONE); }
    if (len != 0 && data == nil) { ret decision(REFUSED, NONE); }
    if (preface_prefix(data, len)) {
        if (len < PREFACE_BYTES) {
            # still a possible preface: waiting cannot be skipped without
            # risking an HTTP/2 connection being answered as HTTP/1
            if (offers(value, HTTP2)) { ret decision(PENDING, NONE); }
            if (offers(value, HTTP1)) { ret decision(SELECTED, HTTP1); }
            ret decision(NO_PROTOCOL, NONE);
        }
        if (!offers(value, HTTP2)) { ret decision(REFUSED, NONE); }
        ret decision(SELECTED, HTTP2);
    }
    if (!offers(value, HTTP1)) { ret decision(REFUSED, NONE); }
    ret decision(SELECTED, HTTP1);
}

fun name_is(entry: view.View, expected: str, expected_len: usize) bool {
    if (entry.len != expected_len) { ret false; }
    var i: usize = 0;
    for (i < expected_len) {
        if (entry.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun protocol_of(name: view.View) Protocol {
    if (name_is(name, "h2", 2)) { ret HTTP2; }
    if (name_is(name, "http/1.1", 8)) { ret HTTP1; }
    if (name_is(name, "h3", 2)) { ret HTTP3; }
    ret NONE;
}

# the listener's order decides, not the client's: preferring the peer's order
# would let a client steer every connection onto its weakest supported protocol
pub fun select_alpn(value: Policy, offered: *view.View, count: usize) Decision {
    if (!value.tls) { ret decision(REFUSED, NONE); }
    if (count != 0 && offered == nil) { ret decision(REFUSED, NONE); }
    # RFC 7301 section 3.2: a client that offered no ALPN extension is served
    # without ALPN, on the only protocol reachable without it. HTTP/2 over TLS
    # is reachable only by negotiating "h2", so a listener that does not serve
    # HTTP/1.1 has nothing to fall back to and selects nothing.
    if (count == 0) {
        if (offers(value, HTTP1)) { ret decision(SELECTED, HTTP1); }
        ret decision(NO_PROTOCOL, NONE);
    }
    var preferred: [2]Protocol = [2]Protocol{HTTP2, HTTP1};
    var rank: usize = 0;
    for (rank < 2) {
        if (offers(value, preferred[rank])) {
            var i: usize = 0;
            for (i < count) {
                if (protocol_of(offered[i]) == preferred[rank]) {
                    ret decision(SELECTED, preferred[rank]);
                }
                i = i + 1;
            }
        }
        rank = rank + 1;
    }
    ret decision(NO_PROTOCOL, NONE);
}

# HTTP/3 is reached only through ALPN inside QUIC, so a datagram listener that
# does not serve it has nothing else to fall back to
pub fun select_quic(value: Policy, offered: *view.View, count: usize) Decision {
    if (!offers(value, HTTP3)) { ret decision(REFUSED, NONE); }
    if (count != 0 && offered == nil) { ret decision(REFUSED, NONE); }
    var i: usize = 0;
    for (i < count) {
        if (protocol_of(offered[i]) == HTTP3) {
            ret decision(SELECTED, HTTP3);
        }
        i = i + 1;
    }
    ret decision(NO_PROTOCOL, NONE);
}

fun text(value: str) view.View {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    ret view.view(value, length);
}

fun feed(value: str, buffer: *u8) usize {
    var i: usize = 0;
    for (value[i] != 0) { buffer[i] = value[i]::u8; i = i + 1; }
    ret i;
}

val ALL: u8 = schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2 |
    schema.PROTOCOL_HTTP3;

test "selection: cleartext distinguishes prior knowledge from HTTP/1" {
    var buffer: [64]u8;
    val both: Policy = policy(schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        false, false);
    val full: usize = feed("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", ?buffer[0]);
    if (full != PREFACE_BYTES) { ret 1; }
    val prior: Decision = select_cleartext(both, ?buffer[0], full);
    if (prior.outcome != SELECTED || prior.protocol != HTTP2) { ret 2; }

    val request: usize = feed("GET / HTTP/1.1\r\n", ?buffer[0]);
    val plain: Decision = select_cleartext(both, ?buffer[0], request);
    if (plain.outcome != SELECTED || plain.protocol != HTTP1) { ret 3; }

    # every proper prefix of the preface must wait, or an HTTP/2 connection
    # gets answered as HTTP/1
    var i: usize = 1;
    for (i < PREFACE_BYTES) {
        feed("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", ?buffer[0]);
        if (select_cleartext(both, ?buffer[0], i).outcome != PENDING) {
            ret (100 + i)::i32;
        }
        i = i + 1;
    }
    # a divergence inside that window is decidable at once
    feed("PRX", ?buffer[0]);
    val diverged: Decision = select_cleartext(both, ?buffer[0], 3);
    if (diverged.outcome != SELECTED || diverged.protocol != HTTP1) { ret 4; }
    ret 0;
}

test "selection: policy bounds what cleartext may become" {
    var buffer: [64]u8;
    val full: usize = feed("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", ?buffer[0]);
    # an HTTP/1-only listener refuses prior knowledge rather than mis-parsing it
    val h1_only: Policy = policy(schema.PROTOCOL_HTTP1, false, false);
    if (select_cleartext(h1_only, ?buffer[0], full).outcome != REFUSED) {
        ret 1;
    }
    # an HTTP/2-only listener refuses an HTTP/1 request
    val h2_only: Policy = policy(schema.PROTOCOL_HTTP2, false, false);
    val request: usize = feed("GET / HTTP/1.1\r\n", ?buffer[0]);
    if (select_cleartext(h2_only, ?buffer[0], request).outcome != REFUSED) {
        ret 2;
    }
    # and a TLS listener never answers cleartext at all, whatever the bytes say
    val secure: Policy = policy(ALL, true, true);
    if (select_cleartext(secure, ?buffer[0], full).outcome != REFUSED) {
        ret 3;
    }
    if (select_cleartext(secure, ?buffer[0], request).outcome != REFUSED) {
        ret 4;
    }
    ret 0;
}

test "selection: alpn follows listener preference, not the client's" {
    var offered: [3]view.View;
    val secure: Policy = policy(schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        true, true);
    # the client lists http/1.1 first; the listener still selects h2
    offered[0] = text("http/1.1");
    offered[1] = text("h2");
    val chosen: Decision = select_alpn(secure, ?offered[0], 2);
    if (chosen.outcome != SELECTED || chosen.protocol != HTTP2) { ret 1; }

    # with h2 withdrawn from policy the same offer selects http/1.1
    val h1_only: Policy = policy(schema.PROTOCOL_HTTP1, true, true);
    val fallback: Decision = select_alpn(h1_only, ?offered[0], 2);
    if (fallback.outcome != SELECTED || fallback.protocol != HTTP1) { ret 2; }

    # nothing in common is a refusal to select, not a silent default
    offered[0] = text("spdy/3");
    offered[1] = text("h3");
    val none: Decision = select_alpn(h1_only, ?offered[0], 2);
    if (none.outcome != NO_PROTOCOL || none.protocol != NONE) { ret 3; }

    # a client that offered no ALPN extension is a different case from one
    # whose offer matched nothing. RFC 7301 section 3.2 reserves the
    # no_application_protocol alert for the second: the first is served
    # without ALPN, on HTTP/1.1, the only protocol reachable without it.
    val empty: Decision = select_alpn(secure, ?offered[0], 0);
    if (empty.outcome != SELECTED || empty.protocol != HTTP1) { ret 4; }
    val empty_h1: Decision = select_alpn(h1_only, ?offered[0], 0);
    if (empty_h1.outcome != SELECTED || empty_h1.protocol != HTTP1) { ret 5; }

    # a listener that serves no HTTP/1.1 has nothing to fall back to, so an
    # empty offer selects nothing there and the connection is refused
    val h2_only: Policy = policy(schema.PROTOCOL_HTTP2, true, true);
    val empty_h2: Decision = select_alpn(h2_only, ?offered[0], 0);
    if (empty_h2.outcome != NO_PROTOCOL || empty_h2.protocol != NONE) { ret 6; }
    ret 0;
}

test "selection: http/3 is reached only through alpn inside quic" {
    var offered: [2]view.View;
    offered[0] = text("h3");
    val serving: Policy = policy(ALL, true, true);
    val chosen: Decision = select_quic(serving, ?offered[0], 1);
    if (chosen.outcome != SELECTED || chosen.protocol != HTTP3) { ret 1; }

    # a listener without HTTP/3 refuses rather than falling back over QUIC
    val no_h3: Policy = policy(schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2,
        true, true);
    if (select_quic(no_h3, ?offered[0], 1).outcome != REFUSED) { ret 2; }

    # and h2 offered over QUIC selects nothing rather than downgrading
    offered[0] = text("h2");
    if (select_quic(serving, ?offered[0], 1).outcome != NO_PROTOCOL) { ret 3; }

    # h3 offered over TLS-on-TCP is not selectable either
    if (select_alpn(serving, ?offered[0], 1).protocol == HTTP3) { ret 4; }
    ret 0;
}

