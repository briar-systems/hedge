# per-generation TLS credentials, resolved by server name
#
# hedge publishes immutable runtime generations, and mach-tls publishes
# immutable credential generations. this binds the two: a connection acquires a
# lease at handshake time and holds it for its whole life, so a rotation
# publishes a new generation for new connections without mutating any
# established one. the retired generation stays alive until its last lease is
# released, which is what makes rotation safe rather than merely atomic.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use contracts: crypto.contracts;
use cert: tls.cert;
use credentials: tls.cert.credentials;
use keys: crypto.encoding.keys;
use load: tls.cert.load;
use secret: crypto.secret;
use ct: std.crypto.ct;

pub def Status: u8;
pub val OK: Status = 1;
# no identity matches the requested name and no default is configured
pub val UNKNOWN_NAME: Status = 2;
pub val INVALID: Status = 3;
pub val EXHAUSTED: Status = 4;

pub val NO_DEFAULT: usize = credentials.NO_DEFAULT;

# storage stays caller owned; this record borrows it for the runtime generation
pub rec Bindings {
    store: credentials.Store;
    live: bool;
}

pub rec Held {
    lease: credentials.Lease;
    held: bool;
}

# assigned by name: an empty record literal does not reliably clear its
# members. see briar-systems/mach#3108.
fun empty_held() Held {
    var value: Held;
    value.lease = credentials.empty_lease();
    value.held = false;
    ret value;
}

fun name_bytes(name: str) contracts.Bytes {
    var value: contracts.Bytes;
    if (name == nil) {
        value.data = nil;
        value.len = 0;
        ret value;
    }
    var length: usize = 0;
    for (name[length] != 0) { length = length + 1; }
    value.data = name::*u8;
    value.len = length;
    ret value;
}

# builds one identity from a chain and key the caller already owns. the name is
# borrowed, not copied, so it must outlive the generation.
pub fun identity(name: str, chain: cert.Chain,
    private_key: *keys.PrivateKey) credentials.Identity {
    var value: credentials.Identity;
    value.server_name = name_bytes(name);
    value.chain = chain;
    value.private_key = private_key;
    ret value;
}

# publishes the first generation. `identities` and everything they reference
# stay caller owned for as long as the bindings are live.
pub fun publish(bindings: *Bindings, generation: *credentials.Generation,
    identities: *credentials.Identity, count: usize, default_index: usize,
    client_trust: *cert.TrustStore, require_client_auth: bool) Status {
    if (bindings == nil || bindings.live || generation == nil ||
        identities == nil || count == 0) { ret INVALID; }
    if (credentials.initialize(generation, identities, count, default_index,
            client_trust, require_client_auth) != contracts.OK) {
        ret INVALID;
    }
    if (credentials.initialize_store(?bindings.store, generation) !=
        contracts.OK) { ret INVALID; }
    bindings.live = true;
    ret OK;
}

# a connection takes exactly one lease and holds it until it closes
pub fun acquire(bindings: *Bindings, server_name: str, output: *Held) Status {
    if (bindings == nil || !bindings.live || output == nil || output.held) {
        ret INVALID;
    }
    @output = empty_held();
    val result: contracts.Error = credentials.acquire(?bindings.store,
        name_bytes(server_name), ?output.lease);
    if (result == contracts.UNSUPPORTED) { ret UNKNOWN_NAME; }
    if (result != contracts.OK) { ret EXHAUSTED; }
    output.held = true;
    ret OK;
}

pub fun release(output: *Held) Status {
    if (output == nil || !output.held) { ret INVALID; }
    if (credentials.release(?output.lease) != contracts.OK) { ret INVALID; }
    output.held = false;
    ret OK;
}

# publishes a replacement for new connections. established connections keep the
# generation their lease pins, and `retired` only becomes reclaimable once every
# one of those leases is released.
pub fun rotate(bindings: *Bindings, replacement: *credentials.Generation,
    retired: **credentials.Generation) Status {
    if (bindings == nil || !bindings.live || replacement == nil ||
        retired == nil) { ret INVALID; }
    if (credentials.rotate(?bindings.store, replacement, retired) !=
        contracts.OK) { ret INVALID; }
    ret OK;
}

pub fun reclaimable(generation: *credentials.Generation) bool {
    ret credentials.reclaimable(generation);
}


# real Ed25519 leaf certificates, so generation validation parses and matches
# them the way it will in production. test material only.
val api_cert_hex: str = "";
val api_cert_len: usize = 395;
fun api_key_der() [48]^u8 {
    var value: [48]^u8 = [48]^u8{0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20, 0x7b, 0xb5, 0x9e, 0xe4, 0xe4, 0x04, 0xc9, 0x43, 0x59, 0x2a, 0x21, 0xda, 0x43, 0xba, 0x1c, 0xee, 0x3b, 0x11, 0x81, 0xac, 0x00, 0x20, 0xd2, 0x50, 0xdd, 0x25, 0x1f, 0x8c, 0xbc, 0xeb, 0x27, 0x2b};
    ret value;
}
val api_key_len: usize = 48;
val alt_cert_hex: str = "";
val alt_cert_len: usize = 395;
fun alt_key_der() [48]^u8 {
    var value: [48]^u8 = [48]^u8{0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20, 0x00, 0x94, 0x2b, 0xba, 0x48, 0x5f, 0xba, 0x6c, 0xcf, 0x30, 0xe4, 0x89, 0xca, 0xa1, 0x51, 0x64, 0xc4, 0x67, 0x2a, 0xbf, 0x9a, 0x7a, 0x40, 0x36, 0xa9, 0xef, 0x8b, 0xa7, 0x9d, 0x4d, 0x3d, 0xe0};
    ret value;
}
val alt_key_len: usize = 48;


var api_der: [395]u8;
var alt_der: [395]u8;

fun hex_nibble(value: u8, output: *u8) bool {
    if (value >= '0'::u8 && value <= '9'::u8) { @output = value - '0'::u8; ret true; }
    if (value >= 'a'::u8 && value <= 'f'::u8) { @output = value - 'a'::u8 + 10; ret true; }
    ret false;
}

fun decode_hex(input: str, length: usize, output: *u8, capacity: usize) bool {
    if (output == nil || (length & 1) != 0 || length / 2 > capacity) { ret false; }
    var i: usize = 0;
    for (i < length / 2) {
        var high: u8;
        var low: u8;
        if (!hex_nibble(input[i * 2]::u8, ?high) ||
            !hex_nibble(input[i * 2 + 1]::u8, ?low)) { ret false; }
        output[i] = (high << 4) | low;
        i = i + 1;
    }
    ret true;
}

fun build_identity(name: str, cert_hex: str, cert_len: usize, der: *u8,
    storage: *cert.Certificate, key_der: *^u8, key_len: usize,
    key: *keys.PrivateKey, owner: *secret.Allocator,
    output: *credentials.Identity) bool {
    if (!decode_hex(cert_hex, cert_len * 2, der, cert_len)) { ret false; }
    @key = keys.empty_private();
    val loaded: contracts.Error = load.private_der(
        contracts.SecretBytes{data: key_der, len: key_len}, cert.PKCS8_DER,
        owner, key);
    ct.zeroize(key_der, key_len);
    if (loaded != contracts.OK) { ret false; }
    @storage = cert.Certificate{der: der, der_len: cert_len};
    var value: credentials.Identity;
    value.server_name = name_bytes(name);
    value.chain = cert.Chain{certificates: storage, len: 1};
    value.private_key = key;
    @output = value;
    ret true;
}

test "credentials: server name selects an identity and unknown names fail" {
    var owner: secret.Allocator = secret.system_allocator();
    var api_storage: cert.Certificate;
    var alt_storage: cert.Certificate;
    var api_key: keys.PrivateKey;
    var alt_key: keys.PrivateKey;
    var api_bytes: [48]^u8 = api_key_der();
    var alt_bytes: [48]^u8 = alt_key_der();
    var identities: [2]credentials.Identity;
    if (!build_identity("api.example.com", api_cert_hex, api_cert_len,
            ?api_der[0], ?api_storage, ?api_bytes[0], api_key_len, ?api_key,
            ?owner, ?identities[0])) { ret 1; }
    if (!build_identity("alt.example.com", alt_cert_hex, alt_cert_len,
            ?alt_der[0], ?alt_storage, ?alt_bytes[0], alt_key_len, ?alt_key,
            ?owner, ?identities[1])) { ret 2; }
    var generation: credentials.Generation = credentials.empty_generation();
    var bindings: Bindings;
    if (publish(?bindings, ?generation, ?identities[0], 2, NO_DEFAULT, nil,
            false) != OK) { ret 3; }

    var held: Held = empty_held();
    if (acquire(?bindings, "alt.example.com", ?held) != OK) { ret 4; }
    if (held.lease.identity.chain.certificates.der != ?alt_der[0]) { ret 5; }
    if (release(?held) != OK || held.held) { ret 6; }

    # with no default configured an unmatched name is refused rather than
    # served somebody else's certificate
    var missing: Held = empty_held();
    if (acquire(?bindings, "nowhere.invalid", ?missing) != UNKNOWN_NAME) {
        ret 7;
    }
    if (missing.held) { ret 8; }
    if (keys.destroy_private(?api_key) != contracts.OK ||
        keys.destroy_private(?alt_key) != contracts.OK) { ret 9; }
    ret 0;
}

test "credentials: rotation leaves an established connection on its generation" {
    var owner: secret.Allocator = secret.system_allocator();
    var api_storage: cert.Certificate;
    var alt_storage: cert.Certificate;
    var api_key: keys.PrivateKey;
    var alt_key: keys.PrivateKey;
    var api_bytes: [48]^u8 = api_key_der();
    var alt_bytes: [48]^u8 = alt_key_der();
    var first: [1]credentials.Identity;
    var second: [1]credentials.Identity;
    if (!build_identity("api.example.com", api_cert_hex, api_cert_len,
            ?api_der[0], ?api_storage, ?api_bytes[0], api_key_len, ?api_key,
            ?owner, ?first[0])) { ret 1; }
    # the replacement is a different certificate under a different name, so the
    # two generations are distinguishable by inspection
    if (!build_identity("alt.example.com", alt_cert_hex, alt_cert_len,
            ?alt_der[0], ?alt_storage, ?alt_bytes[0], alt_key_len, ?alt_key,
            ?owner, ?second[0])) { ret 2; }

    var generation: credentials.Generation = credentials.empty_generation();
    var bindings: Bindings;
    if (publish(?bindings, ?generation, ?first[0], 1, 0, nil, false) != OK) {
        ret 3;
    }
    var established: Held = empty_held();
    if (acquire(?bindings, "api.example.com", ?established) != OK) { ret 4; }
    if (established.lease.identity.chain.certificates.der != ?api_der[0]) {
        ret 5;
    }

    var replacement: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?replacement, ?second[0], 1, 0, nil,
            false) != contracts.OK) { ret 6; }
    var retired: *credentials.Generation = nil;
    if (rotate(?bindings, ?replacement, ?retired) != OK || retired == nil) {
        ret 7;
    }

    # the established connection still reads its original certificate
    if (established.lease.identity.chain.certificates.der != ?api_der[0]) {
        ret 8;
    }
    # and the retired generation cannot be reclaimed while that lease is held
    if (reclaimable(retired)) { ret 9; }

    # a new connection gets the replacement
    var fresh: Held = empty_held();
    if (acquire(?bindings, "alt.example.com", ?fresh) != OK) { ret 10; }
    if (fresh.lease.identity.chain.certificates.der != ?alt_der[0]) { ret 11; }

    # only after the last lease on it is released does it become reclaimable
    if (release(?established) != OK) { ret 12; }
    if (!reclaimable(retired)) { ret 13; }
    if (release(?fresh) != OK) { ret 14; }
    if (keys.destroy_private(?api_key) != contracts.OK ||
        keys.destroy_private(?alt_key) != contracts.OK) { ret 15; }
    ret 0;
}
