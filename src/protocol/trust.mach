# which observed peers a listener trusts to speak for another
#
# the PROXY protocol lets a peer assert somebody else's address. that assertion
# is only ever believed from a peer the listener was configured to trust, so the
# trust decision is taken from the observed socket address before any header
# byte is parsed. an empty policy trusts nobody, which is the safe default for a
# listener that forgot to name its front end.

use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub val MAX_PREFIXES:    usize = 8;
pub val MAX_PREFIX_TEXT: usize = 64;

pub rec Prefix {
    addr: ip.Addr;
    bits: usize;
    live: bool;
}

pub rec Policy {
    count:    usize;
    prefixes: [MAX_PREFIXES]Prefix;
}

# assigned by name: an empty record literal does not reliably clear its
# members. see briar-systems/mach#3108.
fun empty_prefix() Prefix {
    var value: Prefix;
    value.addr.is_v6 = 0;
    var i: usize = 0;
    for (i < 4) {
        value.addr.v4.octets[i] = 0;
        i                       = i + 1;
    }
    i = 0;
    for (i < 16) {
        value.addr.v6.octets[i] = 0;
        i                       = i + 1;
    }
    value.bits = 0;
    value.live = false;
    ret value;
}

pub fun clear(policy: *Policy) {
    if (policy == nil) { ret; }
    policy.count = 0;
    var i: usize = 0;
    for (i < MAX_PREFIXES) {
        policy.prefixes[i] = empty_prefix();
        i                  = i + 1;
    }
}

fun width(addr: ip.Addr) usize {
    if (addr.is_v6 != 0) { ret 128; }
    ret 32;
}

fun parse_bits(text: str, start: usize, length: usize, output: *usize) bool {
    if (start >= length || length - start > 3) { ret false; }
    var value: usize = 0;
    var i:     usize = start;
    for (i < length) {
        if (text[i] < '0' || text[i] > '9') { ret false; }
        value = value * 10 + (text[i] - '0')::usize;
        if (value > 128) { ret false; }
        i = i + 1;
    }
    # a leading zero would let "/08" and "/8" name the same width by two spellings
    if (length - start > 1 && text[start] == '0') { ret false; }
    @output = value;
    ret true;
}

# accepts a bare address or an address with a prefix length. a bare address is a
# host route, which is what an operator naming one front end means.
pub fun parse(text: str, output: *Prefix) bool {
    if (text == nil || output == nil) { ret false; }
    @output = empty_prefix();
    val length: usize = str_len(text);
    if (length == 0 || length >= MAX_PREFIX_TEXT) { ret false; }
    var slash: usize = length;
    var i:     usize = 0;
    for (i < length) {
        if (text[i] == '/') {
            if (slash != length) { ret false; }
            slash = i;
        }
        i = i + 1;
    }
    var address: [MAX_PREFIX_TEXT]u8;
    i = 0;
    for (i < slash) {
        address[i] = text[i];
        i          = i + 1;
    }
    address[slash] = 0;
    val parsed: res[ip.Addr, ip.ParseError] = ip.addr_parse((?address[0])::str);
    if (sel parsed.err) { ret false; }
    val value: ip.Addr = parsed.ok;
    var bits:  usize   = width(value);
    if (slash != length && !parse_bits(text, slash + 1, length, ?bits)) {
        ret false;
    }
    if (bits > width(value)) { ret false; }
    output.addr = value;
    output.bits = bits;
    output.live = true;
    ret true;
}

pub fun add(policy: *Policy, text: str) bool {
    if (policy == nil || policy.count >= MAX_PREFIXES) { ret false; }
    var value: Prefix = empty_prefix();
    if (!parse(text, ?value)) { ret false; }
    policy.prefixes[policy.count] = value;
    policy.count                  = policy.count + 1;
    ret true;
}

fun octets_match(a: *u8, b: *u8, bits: usize) bool {
    val whole:     usize = bits / 8;
    val remainder: usize = bits % 8;
    var i:         usize = 0;
    for (i < whole) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    if (remainder == 0) { ret true; }
    # parenthesised: `!=` binds tighter than `&`, the opposite of C.
    # see briar-systems/laurel#32.
    val mask: u8 = (0xff::u8 << (8 - remainder)::u8)::u8;
    ret ((a[whole] & mask)) == ((b[whole] & mask));
}

fun matches(value: Prefix, peer: ip.Addr) bool {
    if (!value.live)                    { ret false; }
    if (value.addr.is_v6 != peer.is_v6) { ret false; }
    if (peer.is_v6 != 0) {
        ret octets_match(?peer.v6.octets[0], ?value.addr.v6.octets[0], value.bits);
    }
    ret octets_match(?peer.v4.octets[0], ?value.addr.v4.octets[0], value.bits);
}

# a dual-stack listener sees an IPv4 front end as ::ffff:a.b.c.d, so a policy
# written in IPv4 terms has to keep matching it. without this the same operator
# configuration trusts the peer on one socket and refuses it on another.
fun unmapped(peer: ip.Addr) ip.Addr {
    if (peer.is_v6 == 0 || !ip.addr_is_v4_mapped(peer)) { ret peer; }
    var value: ip.IPv4;
    var i:     usize = 0;
    for (i < 4) {
        value.octets[i] = peer.v6.octets[12 + i];
        i               = i + 1;
    }
    ret ip.addr_v4(value);
}

pub fun trusts(policy: *Policy, peer: ip.Addr) bool {
    if (policy == nil || policy.count == 0) { ret false; }
    val plain: ip.Addr = unmapped(peer);
    var i:     usize   = 0;
    for (i < policy.count) {
        if (matches(policy.prefixes[i], peer)) { ret true; }
        if (plain.is_v6 != peer.is_v6 && matches(policy.prefixes[i], plain)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun v4(a: u8, b: u8, c: u8, d: u8) ip.Addr {
    ret ip.addr_v4(ip.ipv4(a, b, c, d));
}

fun mapped_v4(a: u8, b: u8, c: u8, d: u8) ip.Addr {
    var value: ip.IPv6;
    var i:     usize = 0;
    for (i < 10) {
        value.octets[i] = 0;
        i               = i + 1;
    }
    value.octets[10] = 0xff;
    value.octets[11] = 0xff;
    value.octets[12] = a;
    value.octets[13] = b;
    value.octets[14] = c;
    value.octets[15] = d;
    ret ip.addr_v6(value);
}

test "trust: an empty policy trusts nobody" {
    var policy: Policy;
    clear(?policy);
    if (trusts(?policy, v4(127, 0, 0, 1))) { ret 1; }
    if (trusts(?policy, v4(10, 0, 0, 1)))  { ret 2; }
    if (trusts(nil, v4(127, 0, 0, 1)))     { ret 3; }
    ret 0;
}

test "trust: a bare address is a host route and a prefix bounds a range" {
    var policy: Policy;
    clear(?policy);
    if (!add(?policy, "127.0.0.1"))         { ret 1; }
    if (!trusts(?policy, v4(127, 0, 0, 1))) { ret 2; }
    # a host route must not widen to its neighbours
    if (trusts(?policy, v4(127, 0, 0, 2))) { ret 3; }

    clear(?policy);
    if (!add(?policy, "10.0.0.0/8")) { ret 4; }
    if (!trusts(?policy, v4(10, 0, 0, 1)) || !trusts(?policy, v4(10, 255, 255, 255))) {
        ret 5;
    }
    if (trusts(?policy, v4(11, 0, 0, 1)) || trusts(?policy, v4(9, 255, 255, 255))) {
        ret 6;
    }

    # a width that is not a whole number of octets still cuts where it says
    clear(?policy);
    if (!add(?policy, "192.0.2.0/25"))        { ret 7; }
    if (!trusts(?policy, v4(192, 0, 2, 127))) { ret 8; }
    if (trusts(?policy, v4(192, 0, 2, 128)))  { ret 9; }
    ret 0;
}

test "trust: a policy refuses what it cannot parse" {
    var policy: Policy;
    clear(?policy);
    if (add(?policy, "10.0.0.0/33"))    { ret 1; }
    if (add(?policy, "10.0.0.0/"))      { ret 2; }
    if (add(?policy, "10.0.0.0/8/8"))   { ret 3; }
    if (add(?policy, "not-an-address")) { ret 4; }
    if (add(?policy, ""))               { ret 5; }
    if (add(?policy, "10.0.0.0/08"))    { ret 6; }
    if (policy.count != 0)              { ret 7; }
    # and a v6 width is refused against a v4 address
    if (add(?policy, "10.0.0.1/64"))                         { ret 8; }
    if (!add(?policy, "::1/128") || policy.count != 1)       { ret 9; }
    if (!add(?policy, "2001:db8::/32") || policy.count != 2) { ret 10; }
    ret 0;
}

test "trust: families do not cross except through the v4-mapped form" {
    var policy: Policy;
    clear(?policy);
    if (!add(?policy, "10.0.0.0/8")) { ret 1; }
    # an IPv6 peer is not covered by an IPv4 prefix
    if (trusts(?policy, mapped_v4(11, 0, 0, 1))) { ret 2; }
    # but the same front end seen through a dual-stack socket still is
    if (!trusts(?policy, mapped_v4(10, 0, 0, 1))) { ret 3; }

    clear(?policy);
    if (!add(?policy, "2001:db8::/32"))   { ret 4; }
    if (trusts(?policy, v4(10, 0, 0, 1))) { ret 5; }
    var inside: ip.IPv6;
    var i:      usize = 0;
    for (i < 16) {
        inside.octets[i] = 0;
        i                = i + 1;
    }
    inside.octets[0]  = 0x20;
    inside.octets[1]  = 0x01;
    inside.octets[2]  = 0x0d;
    inside.octets[3]  = 0xb8;
    inside.octets[15] = 1;
    if (!trusts(?policy, ip.addr_v6(inside))) { ret 6; }
    inside.octets[3] = 0xb9;
    if (trusts(?policy, ip.addr_v6(inside))) { ret 7; }
    ret 0;
}

test "trust: the prefix table is bounded" {
    var policy: Policy;
    clear(?policy);
    var i: usize = 0;
    for (i < MAX_PREFIXES) {
        if (!add(?policy, "10.0.0.1")) { ret (1 + i)::i32; }
        i = i + 1;
    }
    if (add(?policy, "10.0.0.1"))     { ret 20; }
    if (policy.count != MAX_PREFIXES) { ret 21; }
    ret 0;
}
