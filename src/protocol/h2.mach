# the HTTP/2 connection plane
#
# an HTTP/1 connection owns one exchange at a time; an HTTP/2 connection owns as
# many as its stream table allows, and each one carries its own request arena,
# response storage, cancellation scope, and dispatch call. that is the whole
# difference, so this module mirrors the HTTP/1 plane stream for stream rather
# than generalising it: the two engines have different framing, different
# backpressure, and different close handshakes, and one shared abstraction over
# them would have to lie about at least one.
#
# a session is claimed when a connection negotiates HTTP/2 and released with it:
# it holds several hundred kilobytes of stream and compression storage, and a
# connection that never negotiates HTTP/2 must not pay for that.

use hedge.budget;
use hedge.dispatch;
use hedge.dispatch.call;
use hedge.dispatch.plan;
use hedge.service;
use hedge.storage;
use telemetry_trace: hedge.telemetry.trace;
use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use http.core.transport;
use engine_h2: http.h2.connection;
use http.h2.hpack;
use http.router.router;
use std.chrono.time;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use A: std.allocator;
use std.allocator.page;

fun wall_now() time.Time {
    val sampled: time.Clock = time.now();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Time{sec: 0, nsec: 0};
}

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

# concurrent request streams on one connection. the engine's own table is one
# wider, because it validates its stream limit as strictly below its capacity.
pub val MAX_STREAMS:     usize = 8;
pub val STREAM_CAPACITY: usize = MAX_STREAMS + 1;

pub val READ_BYTES:          usize = 8192;
pub val WRITE_BYTES:         usize = 8192;
pub val FRAME_PAYLOAD_BYTES: usize = 16384;
pub val HEADER_OUTPUT_BYTES: usize = 4096;
pub val CONTROL_SLOTS:       usize = 16;
pub val TABLE_ENTRIES:       usize = 64;
pub val TABLE_STORAGE_BYTES: usize = 4096;

pub val STREAM_ENCODED_BYTES:   usize = 4096;
pub val STREAM_FIELD_SLOTS:     usize = 32;
pub val STREAM_STRING_BYTES:    usize = 4096;
pub val STREAM_PENDING_ENTRIES: usize = 32;

pub val STAGE_BYTES:            usize = 8192;
pub val REQUEST_FIELD_SLOTS:    usize = 40;
pub val RESPONSE_FIELD_SLOTS:   usize = 32;
pub val RESPONSE_TRAILER_SLOTS: usize = 8;
pub val INFORMATIONAL_SLOTS:    usize = 4;
pub val CAPTURE_SLOTS:          usize = 8;
pub val HEADER_ITEM_SLOTS:      usize = RESPONSE_FIELD_SLOTS + 1;
pub val MAX_STEPS:              usize = 64;

pub def State: u8;
pub val IDLE:    State = 0;
pub val ACTIVE:  State = 1;
pub val CLOSING: State = 2;
pub val CLOSED:  State = 3;
pub val FAILED:  State = 4;

pub def Step: u8;
pub val STEP_IDLE:     Step = 1;
pub val STEP_PROGRESS: Step = 2;
pub val STEP_BLOCKED:  Step = 3;
pub val STEP_DONE:     Step = 4;
pub val STEP_ERROR:    Step = 5;

pub def ReleaseStatus: u8;
pub val RELEASE_OK:      ReleaseStatus = 1;
pub val RELEASE_PENDING: ReleaseStatus = 2;
pub val RELEASE_FAILED:  ReleaseStatus = 3;

# the request body reader pulls the bytes the engine is holding for one stream
# and reports pending when none have arrived, so flow control reaches the
# service instead of being buffered behind its back
rec Body {
    session:          *Session;
    slot:             usize;
    reader:           body.Reader;
    pending_output:   *u8;
    pending_capacity: usize;
    pending_token:    u64;
    next_token:       u64;
}

rec Slot {
    live:              bool;
    id:                u32;
    generation:        u64;
    scope:             cancel.Scope;
    scope_live:        bool;
    body:              Body;
    request:           message.Request;
    response:          message.Response;
    request_items:     [REQUEST_FIELD_SLOTS]field.Field;
    request_fields:    field.Fields;
    request_trailers:  field.Fields;
    response_fields:   [RESPONSE_FIELD_SLOTS]field.Field;
    response_trailers: [RESPONSE_TRAILER_SLOTS]field.Field;
    informationals:    [INFORMATIONAL_SLOTS]message.Informational;
    captures:          [CAPTURE_SLOTS]router.Capture;
    header_items:      [HEADER_ITEM_SLOTS]field.Field;
    status_text:       [3]u8;
    memory:            call.Memory;
    trace:             telemetry_trace.Context;
    exchange:          exchange.Exchange;
    active_call:       call.Call;
    stage:             [STAGE_BYTES]u8;
    stage_length:      usize;
    stage_offset:      usize;
    body_done:         bool;
    inbound_complete:  bool;
    headers_sent:      bool;
    trailers_sent:     bool;
    response_complete: bool;
    service_pending:   bool;
    exchange_live:     bool;
    cancelling:        bool;
    call_released:     bool;
    stream_released:   bool;
    close_disposition: bool;
    bound:             bool;
    charge:            budget.Charge;
}

pub rec Session {
    live:               bool;
    state:              State;
    engine:             engine_h2.Engine;
    streams:            [STREAM_CAPACITY]engine_h2.Stream;
    memories:           [STREAM_CAPACITY]engine_h2.StreamMemory;
    encoded:            [STREAM_CAPACITY][STREAM_ENCODED_BYTES]u8;
    header_fields:      [STREAM_CAPACITY][STREAM_FIELD_SLOTS]field.Field;
    strings:            [STREAM_CAPACITY][STREAM_STRING_BYTES]u8;
    pending:            [STREAM_CAPACITY][STREAM_PENDING_ENTRIES]hpack.Entry;
    read_buffer:        [READ_BYTES]u8;
    write_buffer:       [WRITE_BYTES]u8;
    frame_payload:      [FRAME_PAYLOAD_BYTES]u8;
    header_output:      [HEADER_OUTPUT_BYTES]u8;
    controls:           [CONTROL_SLOTS]engine_h2.Control;
    inbound_entries:    [TABLE_ENTRIES]hpack.Entry;
    inbound_storage:    [TABLE_STORAGE_BYTES]u8;
    outbound_entries:   [TABLE_ENTRIES]hpack.Entry;
    outbound_storage:   [TABLE_STORAGE_BYTES]u8;
    encoder_pending:    [TABLE_ENTRIES]hpack.Entry;
    slots:              [MAX_STREAMS]Slot;
    held_stream:        u32;
    held_data:          *u8;
    held_length:        usize;
    plan:               *plan.Plan;
    budgets:            *budget.Set;
    limits:             message.Limits;
    listener_name:      str;
    secure:             bool;
    peer:               message.Endpoint;
    local:              message.Endpoint;
    request_timeout_ns: u64;
    chunks:             *storage.Chunks;
    call_memory_bytes:  usize;
    engine_scope:       *cancel.Scope;
    requests:           u64;
    last_event:         engine_h2.EventKind;
    last_step:          Step;
    engine_started:     bool;
    final_goaway_sent:  bool;
    release_failed:     bool;
}

fun reset_slot(slot: *Slot) {
    slot.live              = false;
    slot.id                = 0;
    slot.generation        = 0;
    slot.scope_live        = false;
    slot.stage_length      = 0;
    slot.stage_offset      = 0;
    slot.body_done         = false;
    slot.inbound_complete  = false;
    slot.headers_sent      = false;
    slot.trailers_sent     = false;
    slot.response_complete = false;
    slot.service_pending   = false;
    slot.exchange_live     = false;
    slot.cancelling        = false;
    slot.call_released     = false;
    slot.stream_released   = false;
    slot.close_disposition = false;
    slot.bound             = false;
    slot.charge            = budget.no_charge();
}

pub fun acquire(sessions: *storage.Recycler[Session]) *Session {
    val session: *Session = storage.claim[Session](sessions);
    if (session == nil) { ret nil; }
    session.live              = true;
    session.state             = IDLE;
    session.engine_started    = false;
    session.held_stream       = engine_h2.NO_STREAM;
    session.held_data         = nil;
    session.held_length       = 0;
    session.requests          = 0;
    session.last_event        = engine_h2.EVENT_NONE;
    session.last_step         = STEP_IDLE;
    session.final_goaway_sent = false;
    session.release_failed    = false;
    var j: usize = 0;
    for (j < MAX_STREAMS) {
        reset_slot(?session.slots[j]);
        j = j + 1;
    }
    ret session;
}

fun settle_slot_cancellation(slot: *Slot) exchange.FinishStatus {
    if (!slot.exchange_live) { ret exchange.FINISH_OK; }
    if (slot.exchange.state == exchange.COMPLETE_STATE
        || slot.exchange.state == exchange.CANCELLED_STATE
        || slot.exchange.state == exchange.TIMED_OUT_STATE
        || slot.exchange.state == exchange.FAILED_STATE) {
        slot.cancelling = true;
        ret exchange.FINISH_OK;
    }
    if (!slot.cancelling) {
        slot.cancelling = true;
        if (!scope_active(?slot.scope)) {
            ret exchange.settle_cancellation(?slot.exchange);
        }
        ret exchange.cancel_exchange(?slot.exchange);
    }
    ret exchange.settle_cancellation(?slot.exchange);
}

fun finalize_slot_call(session: *Session, slot: *Slot) bool {
    if (!slot.exchange_live || slot.call_released) { ret true; }
    # call release is one-shot. a finalizer failure is reported after the
    # session has been torn down, but repeating it would only turn a completed
    # cleanup into an unrecoverable retry loop.
    var released: bool = false;
    if (slot.exchange.state == exchange.COMPLETE_STATE
        || slot.exchange.state == exchange.CANCELLED_STATE
        || slot.exchange.state == exchange.TIMED_OUT_STATE
        || slot.exchange.state == exchange.FAILED_STATE) {
        released = call.release(?slot.active_call);
    }
    or             { released = call.abandon(?slot.active_call); }
    if (!released) { session.release_failed = true; }
    slot.call_released = true;
    ret released;
}

fun release_slot_resources(session: *Session, slot: *Slot) bool {
    # one-shot release failures are reported with the completed session. scope
    # destruction is retryable and keeps the slot storage owned until it settles.
    if (slot.charge.live && !budget.release(session.budgets, ?slot.charge)) {
        session.release_failed = true;
    }
    if (slot.scope_live) {
        if (!operation_ok(cancel.destroy(?slot.scope))) { ret false; }
        slot.scope_live = false;
    }
    reset_slot(slot);
    ret true;
}

fun finish_retirement(session: *Session, slot: *Slot,
    release_stream: bool) bool {
    # finalizer failure is permanent and already recorded on the session. it
    # cannot become progress after a transport completion, so teardown proceeds.
    val finalized: bool = finalize_slot_call(session, slot);
    if (release_stream && !slot.stream_released) {
        if (!engine_h2.release_stream(?session.engine, slot.id,
            slot.generation)) { ret false; }
        slot.stream_released = true;
    }
    if (!release_slot_resources(session, slot)) { ret false; }
    ret finalized;
}

fun detach_slot_exchange(session: *Session, slot: *Slot) bool {
    if (!slot.bound || slot.stream_released) { ret true; }
    if (engine_h2.abandon_exchange(?session.engine, slot.id,
        slot.generation) != ?slot.exchange) { ret false; }
    if (!engine_h2.release_stream(?session.engine, slot.id,
        slot.generation)) { ret false; }
    slot.stream_released = true;
    ret true;
}

fun retire_slot(session: *Session, slot: *Slot) bool {
    if (!slot.live) { ret true; }
    var cancellation: exchange.FinishStatus = exchange.FINISH_OK;
    if (slot.exchange_live && slot.exchange.state != exchange.COMPLETE_STATE
        && slot.exchange.state != exchange.CANCELLED_STATE
        && slot.exchange.state != exchange.TIMED_OUT_STATE
        && slot.exchange.state != exchange.FAILED_STATE) {
        cancellation = settle_slot_cancellation(slot);
        if (cancellation != exchange.FINISH_OK
            && cancellation != exchange.FINISH_BODY_PENDING) {
            session.release_failed = true;
            slot.cancelling        = true;
        }
    }
    if (slot.bound && !slot.stream_released) {
        val stream: *engine_h2.Stream = engine_h2.stream_for(?session.engine,
            slot.id);
        if (stream != nil && stream.state != engine_h2.STREAM_CLOSED
            && !engine_h2.cancel_stream(?session.engine, slot.id,
            engine_h2.H2_CANCEL)) { ret false; }
    }
    if (cancellation == exchange.FINISH_BODY_PENDING
        || (cancellation != exchange.FINISH_OK
        && cancellation != exchange.FINISH_ALREADY_COMPLETE)) {
        if (!detach_slot_exchange(session, slot))         { ret false; }
        if (cancellation == exchange.FINISH_BODY_PENDING) { ret false; }
    }
    val finished: bool = finish_retirement(session, slot, slot.bound);
    # a permanent call finalizer failure is not pending ownership. the slot was
    # still fully retired and release_status reports the recorded failure.
    if (!finished && !slot.live) { ret true; }
    ret finished;
}

fun retire_closed_stream(session: *Session, slot: *Slot) Step {
    if (slot.exchange_live) {
        val cancelled: exchange.FinishStatus = settle_slot_cancellation(slot);
        if (cancelled == exchange.FINISH_BODY_PENDING) { ret STEP_BLOCKED; }
        if (cancelled != exchange.FINISH_OK)           { ret STEP_ERROR; }
    }
    if (!finish_retirement(session, slot, slot.bound)) { ret STEP_ERROR; }
    ret STEP_PROGRESS;
}

# storage returns to the recycler once the session has settled, whether or not
# a one-shot release failed along the way
pub fun release_status(sessions: *storage.Recycler[Session], session: *Session) ReleaseStatus {
    if (session == nil || !session.live) { ret RELEASE_FAILED; }
    var pending: bool     = false;
    var j:       usize    = 0;
    for (j < MAX_STREAMS) {
        if (!retire_slot(session, ?session.slots[j])) { pending = true; }
        j = j + 1;
    }
    if (pending) { ret RELEASE_PENDING; }
    if (session.engine_started && !engine_h2.destroy(?session.engine)) {
        ret RELEASE_PENDING;
    }
    session.engine_started = false;
    session.state          = CLOSED;
    session.live           = false;
    val failed: bool = session.release_failed;
    if (!storage.release[Session](sessions, session) || failed) { ret RELEASE_FAILED; }
    ret RELEASE_OK;
}

# --- configuration ---

pub fun config_from(limits: message.Limits, max_streams: usize) engine_h2.Config {
    var configured: engine_h2.Config = engine_h2.config_default();
    if (max_streams > MAX_STREAMS) { max_streams = MAX_STREAMS; }
    configured.max_streams                   = max_streams;
    configured.local.max_concurrent_streams  = max_streams::u32;
    configured.local.enable_push             = 0;
    configured.local.max_frame_size          = FRAME_PAYLOAD_BYTES::u32;
    configured.max_frame_payload             = FRAME_PAYLOAD_BYTES;
    configured.hpack.max_header_count        = STREAM_FIELD_SLOTS;
    configured.hpack.max_encoded_block_bytes = HEADER_OUTPUT_BYTES;
    if (configured.hpack.max_dynamic_table_bytes > TABLE_STORAGE_BYTES) {
        configured.hpack.max_dynamic_table_bytes = TABLE_STORAGE_BYTES;
    }
    if (configured.hpack.max_header_list_bytes > STREAM_STRING_BYTES) {
        configured.hpack.max_header_list_bytes = STREAM_STRING_BYTES;
    }
    configured.local.header_table_size    = configured.hpack.max_dynamic_table_bytes::u32;
    configured.local.max_header_list_size = configured.hpack.max_header_list_bytes::u32;
    ret configured;
}

pub fun begin(session: *Session, channel: *transport.Transport, scope: *cancel.Scope,
    active_plan: *plan.Plan, budgets: *budget.Set, limits: message.Limits,
    max_streams: usize,
    listener_name: str,
    secure: bool, peer: message.Endpoint, local: message.Endpoint,
    request_timeout_ns: u64, chunks: *storage.Chunks, call_memory_bytes: usize) bool {
    if (session == nil || !session.live || channel == nil
        || scope == nil || active_plan == nil || chunks == nil) { ret false; }
    session.chunks             = chunks;
    session.call_memory_bytes  = call_memory_bytes;
    session.plan               = active_plan;
    session.budgets            = budgets;
    session.limits             = limits;
    session.listener_name      = listener_name;
    session.secure             = secure;
    session.peer               = peer;
    session.local              = local;
    session.request_timeout_ns = request_timeout_ns;
    session.engine_scope       = scope;
    var i: usize = 0;
    for (i < STREAM_CAPACITY) {
        session.memories[i] = engine_h2.StreamMemory{
            encoded:          ?session.encoded[i][0],
            encoded_capacity: STREAM_ENCODED_BYTES,
            fields:           ?session.header_fields[i][0],
            field_capacity:   STREAM_FIELD_SLOTS,
            strings:          ?session.strings[i][0],
            string_capacity:  STREAM_STRING_BYTES,
            pending:          ?session.pending[i][0],
            pending_capacity: STREAM_PENDING_ENTRIES,
        };
        i = i + 1;
    }
    val configured: engine_h2.Config = config_from(limits, max_streams);
    session.engine.initialized = false;
    if (!engine_h2.init(?session.engine, engine_h2.SERVER, channel, scope,
        ?session.streams[0], ?session.memories[0], STREAM_CAPACITY,
        ?session.read_buffer[0], READ_BYTES,
        ?session.write_buffer[0], WRITE_BYTES,
        ?session.frame_payload[0], FRAME_PAYLOAD_BYTES,
        ?session.header_output[0], HEADER_OUTPUT_BYTES,
        ?session.controls[0], CONTROL_SLOTS,
        ?session.inbound_entries[0], TABLE_ENTRIES,
        ?session.inbound_storage[0], TABLE_STORAGE_BYTES,
        ?session.outbound_entries[0], TABLE_ENTRIES,
        ?session.outbound_storage[0], TABLE_STORAGE_BYTES,
        ?session.encoder_pending[0], TABLE_ENTRIES, configured)) {
        ret false;
    }
    session.engine_started = true;
    session.state          = ACTIVE;
    # the configured local settings are queued by `init` itself, so they reach
    # the peer with the connection preface and a second send would be refused
    ret true;
}

# --- request body ---

fun slot_for(session: *Session, id: u32) *Slot {
    var i: usize = 0;
    for (i < MAX_STREAMS) {
        if (session.slots[i].live && session.slots[i].id == id) {
            ret ?session.slots[i];
        }
        i = i + 1;
    }
    ret nil;
}

fun free_slot(session: *Session) *Slot {
    var i: usize = 0;
    for (i < MAX_STREAMS) {
        if (!session.slots[i].live) { ret ?session.slots[i]; }
        i = i + 1;
    }
    ret nil;
}

fun body_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    val state: *Body = context::*Body;
    if (state == nil || state.session == nil) {
        ret body.failed("request body has no owner", body.REUSE_FORBIDDEN);
    }
    val session: *Session = state.session;
    val slot:    *Slot    = ?session.slots[state.slot];
    if (session.held_stream == slot.id && session.held_length != 0) {
        var count: usize = session.held_length;
        if (count > capacity) { count = capacity; }
        # a zero-capacity read is the completion signalling that bytes are
        # ready, not a consumption. the engine rejects a zero-byte consume, and
        # calling one here would fail the body rather than hand it over.
        if (count == 0) { ret body.data(0); }
        var i: usize = 0;
        for (i < count) {
            output[i] = session.held_data[i];
            i         = i + 1;
        }
        if (!engine_h2.consume_data(?session.engine, slot.id, count)) {
            ret body.failed("request body consumption was refused",
                body.REUSE_FORBIDDEN);
        }
        session.held_length = session.held_length - count;
        session.held_data   = ?session.held_data[count];
        if (session.held_length == 0) { session.held_stream = engine_h2.NO_STREAM; }
        state.pending_output   = nil;
        state.pending_capacity = 0;
        ret body.data(count);
    }
    if (slot.inbound_complete) {
        state.pending_output   = nil;
        state.pending_capacity = 0;
        ret body.complete(body.REUSE_ALLOWED);
    }
    state.pending_output   = output;
    state.pending_capacity = capacity;
    state.next_token       = state.next_token + 1;
    state.pending_token    = state.next_token;
    ret body.pending(state.pending_token);
}

fun body_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *Body = context::*Body;
    if (state == nil || state.session == nil) {
        ret body.failed("request body has no owner", body.REUSE_FORBIDDEN);
    }
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    val session: *Session = state.session;
    val slot:    *Slot    = ?session.slots[state.slot];
    # an unread request body still owes the peer its flow-control window, so it
    # is consumed rather than abandoned
    if (session.held_stream == slot.id && session.held_length != 0) {
        engine_h2.consume_data(?session.engine, slot.id, session.held_length);
        session.held_length = 0;
        session.held_stream = engine_h2.NO_STREAM;
    }
    if (mode == body.REJECT)   { ret body.rejected(body.REUSE_ALLOWED); }
    if (slot.inbound_complete) { ret body.complete(body.REUSE_ALLOWED); }
    state.next_token    = state.next_token + 1;
    state.pending_token = state.next_token;
    ret body.pending(state.pending_token);
}

# a completion resolves whichever operation was outstanding, and a finish must
# resolve to a terminal status carrying no bytes. resolving one as the other is
# what makes an unread request body hang instead of draining.
fun body_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val state: *Body = context::*Body;
    if (state == nil || state.session == nil
        || token != state.pending_token) {
        ret body.failed("unknown request body completion", body.REUSE_FORBIDDEN);
    }
    val kind: body.Operation = state.reader.pending_kind;
    val mode: body.Mode      = state.reader.pending_mode;
    state.pending_token = 0;
    val session: *Session = state.session;
    val slot:    *Slot    = ?session.slots[state.slot];
    if (kind == body.OP_FINISH) {
        if (session.held_stream == slot.id && session.held_length != 0) {
            engine_h2.consume_data(?session.engine, slot.id, session.held_length);
            session.held_length = 0;
            session.held_stream = engine_h2.NO_STREAM;
        }
        if (!slot.inbound_complete) {
            state.next_token    = state.next_token + 1;
            state.pending_token = state.next_token;
            ret body.pending(state.pending_token);
        }
        if (mode == body.REJECT) { ret body.rejected(body.REUSE_ALLOWED); }
        ret body.complete(body.REUSE_ALLOWED);
    }
    if (slot.inbound_complete && session.held_stream != slot.id) {
        ret body.complete(body.REUSE_ALLOWED);
    }
    ret body_read(context, state.pending_output, state.pending_capacity,
        trailers);
}

fun body_release(context: ptr) {}

# --- exchange construction ---

# HTTP/2 method names are exact tokens, so this compares them exactly. a
# case-insensitive match here would accept `get` as GET, which HTTP/1 does not.
fun token_is(name: view.View, expected: str, length: usize) bool {
    if (name.len != length || name.data == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (name.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun method_of(name: view.View) method.Method {
    if (token_is(name, "GET", 3))     { ret method.from_kind(method.GET); }
    if (token_is(name, "HEAD", 4))    { ret method.from_kind(method.HEAD); }
    if (token_is(name, "POST", 4))    { ret method.from_kind(method.POST); }
    if (token_is(name, "PUT", 3))     { ret method.from_kind(method.PUT); }
    if (token_is(name, "DELETE", 6))  { ret method.from_kind(method.DELETE); }
    if (token_is(name, "CONNECT", 7)) { ret method.from_kind(method.CONNECT); }
    if (token_is(name, "OPTIONS", 7)) { ret method.from_kind(method.OPTIONS); }
    if (token_is(name, "TRACE", 5))   { ret method.from_kind(method.TRACE); }
    if (token_is(name, "PATCH", 5))   { ret method.from_kind(method.PATCH); }
    ret method.extension(name);
}

# `:path` carries the origin form, which HTTP/1 splits in its parser. HTTP/2
# does not, so the split happens once here rather than in every service.
fun target_of(raw: view.View) target.Target {
    if (raw.len == 1 && raw.data != nil && raw.data[0] == '*'::u8) {
        ret target.asterisk();
    }
    var cut: usize = raw.len;
    var i:   usize = 0;
    for (i < raw.len) {
        if (raw.data[i] == '?'::u8) {
            cut = i;
            brk;
        }
        i = i + 1;
    }
    val path:  view.View = view.view(raw.data, cut);
    var query: view.View = view.view(nil, 0);
    if (cut < raw.len) {
        query = view.view(?raw.data[cut + 1], raw.len - cut - 1);
    }
    ret target.origin(raw, path, query);
}

# the regular fields are copied out of the engine's decoding storage into the
# slot's own, and `:authority` is written back as a Host field.
#
# RFC 9113 makes `:authority` the authority of the request, and every part of
# hedge that asks who a request was addressed to reads a Host field: the router,
# the proxy's forwarded metadata, the access log. translating once here is what
# keeps HTTP/2 requests routable by the same virtual-host rules as HTTP/1.
fun copy_fields(slot: *Slot, block: engine_h2.HeaderBlock,
    limits: field.Limits) bool {
    slot.request_fields = field.init(?slot.request_items[0], REQUEST_FIELD_SLOTS,
        limits);
    if (!slot.request_fields.valid) { ret false; }
    var has_host: bool  = false;
    var i:        usize = block.regular_offset;
    for (i < block.count) {
        if (field.name_equal(block.fields[i].name, view.view("host", 4))) {
            has_host = true;
        }
        if (field.append(?slot.request_fields, block.fields[i]) != field.ADD_OK) {
            ret false;
        }
        i = i + 1;
    }
    if (has_host || block.authority.len == 0) { ret true; }
    ret field.append(?slot.request_fields, field.Field{
        name:      view.view("host", 4), value: block.authority,
        sensitive: false
    }) == field.ADD_OK;
}

fun write_status(slot: *Slot, code: status.Status) view.View {
    val value: usize = code::usize;
    slot.status_text[0] = '0'::u8 + (value / 100)::u8;
    slot.status_text[1] = '0'::u8 + ((value / 10) % 10)::u8;
    slot.status_text[2] = '0'::u8 + (value % 10)::u8;
    ret view.view(?slot.status_text[0], 3);
}

fun deadline_from(now: time.Time, timeout_ns: u64) time.Time {
    var deadline: time.Time = now;
    deadline.sec  = now.sec + (timeout_ns / 1000000000)::i64;
    deadline.nsec = now.nsec + (timeout_ns % 1000000000)::i64;
    if (deadline.nsec >= 1000000000) {
        deadline.nsec = deadline.nsec - 1000000000;
        deadline.sec  = deadline.sec + 1;
    }
    ret deadline;
}

fun make_exchange(session: *Session, slot: *Slot, event: engine_h2.Event,
    now: time.Time) bool {
    session.requests = session.requests + 1;
    val has_deadline: bool      = session.request_timeout_ns != 0;
    var deadline:     time.Time = now;
    if (has_deadline) {
        deadline = deadline_from(now, session.request_timeout_ns);
    }
    if (slot.scope_live) { operation_ok(cancel.destroy(?slot.scope)); }
    slot.scope_live = false;
    if (!operation_ok(cancel.make_child(?slot.scope, session.engine_scope, has_deadline,
        deadline))) { ret false; }
    slot.scope_live            = true;
    slot.body.session          = session;
    slot.body.slot             = (slot)::usize - (?session.slots[0])::usize;
    slot.body.slot             = slot.body.slot / $size_of(Slot);
    slot.body.pending_output   = nil;
    slot.body.pending_capacity = 0;
    slot.body.pending_token    = 0;
    slot.body.next_token       = 0;
    var declared:     u64  = 0;
    var length_known: bool = event.headers.has_content_length;
    if (length_known) { declared = event.headers.content_length; }
    if (event.end_stream) {
        length_known = true;
        if (!event.headers.has_content_length) { declared = 0; }
    }
    slot.body.reader = body.init_reader(
        (?slot.body)::ptr,
        body_read,
        body_finish,
        body_complete,
        body_release,
        body.OWNER_APPLICATION,
        event.generation,
        length_known,
        declared,
        session.limits.request_body,
        nil,
        ?slot.scope,
    );
    if (!slot.body.reader.valid) { ret false; }
    if (!copy_fields(slot, event.headers, session.limits.request_fields)) {
        ret false;
    }
    slot.request_trailers = field.init(nil, 0, session.limits.request_trailers);
    var metadata: message.Metadata;
    metadata.version      = message.version_h2();
    metadata.secure       = session.secure;
    metadata.early_data   = false;
    metadata.peer         = session.peer;
    metadata.local        = session.local;
    metadata.received_at  = now;
    metadata.has_deadline = has_deadline;
    metadata.deadline     = deadline;
    # the engine binds an exchange only when its request index is the stream id
    metadata.request_index = event.stream_id::u64;
    if (!message.init_request(?slot.request, method_of(event.headers.method),
        target_of(event.headers.path), metadata, slot.request_fields,
        slot.request_trailers, ?slot.body.reader, event.generation,
        session.limits)) { ret false; }
    if (!message.init_response(?slot.response, ?slot.response_fields[0],
        RESPONSE_FIELD_SLOTS, ?slot.response_trailers[0], RESPONSE_TRAILER_SLOTS,
        event.generation, session.limits)) { ret false; }
    slot.exchange.valid = false;
    if (!exchange.init(?slot.exchange, ?slot.request, ?slot.response,
        ?slot.informationals[0], INFORMATIONAL_SLOTS, ?slot.scope,
        event.generation, session.limits)) { ret false; }
    if (!engine_h2.bind_exchange(?session.engine, event.stream_id, ?slot.exchange)) {
        ret false;
    }
    slot.bound = true;
    if (!exchange.begin(?slot.exchange))                              { ret false; }
    if (!call.make_memory(?slot.memory, session.chunks, session.call_memory_bytes)) {
        ret false;
    }
    if (!telemetry_trace.make_root(?slot.trace, false))               { ret false; }
    if (!call.bind(?slot.active_call, ?slot.exchange, ?slot.memory, ?slot.trace,
        session.plan.generation, session.listener_name)) { ret false; }
    slot.exchange_live = true;
    ret true;
}

# --- response emission ---

fun response_headers(slot: *Slot) usize {
    slot.header_items[0] = field.Field{name: view.view(":status", 7),
        value: write_status(slot, slot.response.status), sensitive: false};
    var count: usize = 1;
    var i:     usize = 0;
    for (i < slot.response.fields.len && count < HEADER_ITEM_SLOTS) {
        val item: *field.Field = ?slot.response.fields.items[i];
        # HTTP/2 carries no connection-specific header fields, and a message
        # that keeps one is malformed rather than merely untidy
        if (!field.name_equal(item.name, view.view("connection", 10))
            && !field.name_equal(item.name, view.view("transfer-encoding", 17))
            && !field.name_equal(item.name, view.view("keep-alive", 10))
            && !field.name_equal(item.name, view.view("upgrade", 7))
            && !field.name_equal(item.name, view.view("proxy-connection", 16))) {
            slot.header_items[count] = @item;
            count                    = count + 1;
        }
        i = i + 1;
    }
    ret count;
}

fun has_body(slot: *Slot) bool {
    ret slot.response.body_kind == message.BODY_READER;
}

fun begin_response(session: *Session, slot: *Slot) Step {
    if (slot.headers_sent)        { ret STEP_IDLE; }
    if (!slot.response.committed) { ret STEP_IDLE; }
    val count:   usize           = response_headers(slot);
    val final:   bool            = !has_body(slot) && slot.response.trailers.len == 0;
    val offered: engine_h2.Offer = engine_h2.send_headers(?session.engine, slot.id,
        ?slot.header_items[0], count, final, true);
    if (offered.status == engine_h2.OFFER_BLOCKED) { ret STEP_BLOCKED; }
    if (offered.status == engine_h2.OFFER_ERROR)   { ret STEP_ERROR; }
    slot.headers_sent = true;
    if (final) { slot.response_complete = true; }
    or         { engine_h2.set_writable(?session.engine, slot.id, true); }
    ret STEP_PROGRESS;
}

fun send_trailers(session: *Session, slot: *Slot) Step {
    if (slot.trailers_sent || slot.response.trailers.len == 0) { ret STEP_IDLE; }
    val offered: engine_h2.Offer = engine_h2.send_headers(?session.engine, slot.id,
        slot.response.trailers.items, slot.response.trailers.len, true, true);
    if (offered.status == engine_h2.OFFER_BLOCKED) { ret STEP_BLOCKED; }
    if (offered.status == engine_h2.OFFER_ERROR)   { ret STEP_ERROR; }
    slot.trailers_sent     = true;
    slot.response_complete = true;
    ret STEP_PROGRESS;
}

fun response_body_progress(reader: *body.Reader, output: *u8,
    capacity: usize) body.Progress {
    if (reader.pending_kind == body.OP_NONE) {
        ret body.read(reader, output, capacity);
    }
    if (reader.pending_kind == body.OP_READ) {
        ret body.complete_reader(reader, reader.pending_token);
    }
    ret body.failed("response body has a conflicting pending operation",
        body.REUSE_FORBIDDEN);
}

# pull from the response body into the staging buffer and offer it to the
# engine. the engine consumes only what its windows admit, so the unconsumed
# remainder is offered again before the body is read further.
fun advance_response(session: *Session, slot: *Slot) Step {
    if (!slot.headers_sent || slot.response_complete) { ret STEP_IDLE; }
    # the engine clears a stream's writable flag once it has taken everything
    # offered, so a response with more to send has to say so again. without this
    # the scheduler never picks the stream a second time and the response stops
    # after its first frame.
    engine_h2.set_writable(?session.engine, slot.id, true);
    if (engine_h2.writable_stream(?session.engine) != slot.id) { ret STEP_BLOCKED; }
    if (slot.stage_offset >= slot.stage_length) {
        slot.stage_offset = 0;
        slot.stage_length = 0;
        if (!slot.body_done) {
            if (has_body(slot)) {
                val reader:   *body.Reader  = slot.response.body_reader;
                val progress: body.Progress = response_body_progress(reader,
                    ?slot.stage[0], STAGE_BYTES);
                if (progress.status == body.DATA) {
                    slot.stage_length = progress.count;
                    call.record_body(?slot.active_call, ?slot.stage[0],
                        progress.count);
                }
                or (progress.status == body.PENDING)  { ret STEP_BLOCKED; }
                or (progress.status == body.COMPLETE) { slot.body_done = true; }
                or                                    { ret STEP_ERROR; }
            }
            or {
                slot.body_done = true;
            }
        }
    }
    var payload: *u8   = nil;
    var length:  usize = 0;
    if (slot.stage_offset < slot.stage_length) {
        payload = ?slot.stage[slot.stage_offset];
        length  = slot.stage_length - slot.stage_offset;
    }
    val final: bool = slot.body_done && length == 0
        && slot.response.trailers.len == 0;
    if (length == 0 && !final) {
        # nothing left to frame, and trailers close the stream instead
        if (slot.body_done) { ret send_trailers(session, slot); }
        ret STEP_BLOCKED;
    }
    val offered: engine_h2.Offer = engine_h2.offer_data(?session.engine, slot.id,
        payload, length, final);
    if (offered.status == engine_h2.OFFER_ERROR)   { ret STEP_ERROR; }
    if (offered.status == engine_h2.OFFER_BLOCKED) { ret STEP_BLOCKED; }
    slot.stage_offset = slot.stage_offset + offered.consumed;
    if (final && offered.status == engine_h2.OFFER_DONE) {
        slot.response_complete = true;
        engine_h2.set_writable(?session.engine, slot.id, false);
    }
    if (offered.consumed == 0 && offered.produced == 0 && !final) {
        ret STEP_BLOCKED;
    }
    ret STEP_PROGRESS;
}

fun begin_close_disposition(session: *Session, slot: *Slot) bool {
    if (slot.close_disposition) { ret true; }
    slot.close_disposition = true;
    if (session.state == ACTIVE) {
        session.state             = CLOSING;
        session.final_goaway_sent = false;
        if (!engine_h2.begin_graceful(?session.engine)) { ret false; }
    }
    ret session.state == CLOSING;
}

fun settle_request_body(session: *Session, slot: *Slot) body.Progress {
    val reader: *body.Reader = slot.request.body;
    if (body.reader_terminal_state(reader)) { ret body.reader_result(reader); }
    val chosen: call.Disposition = call.disposition(?slot.active_call);
    if (chosen == call.BODY_DELIVER) {
        if (reader.pending_kind != body.OP_NONE) {
            ret body.pending(reader.pending_token);
        }
        ret body.failed("delivered request body was left unresolved",
            body.REUSE_FORBIDDEN);
    }
    if (chosen == call.BODY_DRAIN) {
        if (reader.pending_kind != body.OP_NONE) {
            ret body.pending(reader.pending_token);
        }
        ret body.drain(reader);
    }
    if (chosen == call.BODY_REJECT) {
        if (reader.pending_kind != body.OP_NONE) {
            ret body.pending(reader.pending_token);
        }
        ret body.reject(reader);
    }
    if (chosen == call.BODY_CLOSE) {
        if (!begin_close_disposition(session, slot)) {
            ret body.failed("request close disposition could not start",
                body.REUSE_FORBIDDEN);
        }
        ret body.cancel_reader(reader);
    }
    ret body.failed("request body disposition is unresolved",
        body.REUSE_FORBIDDEN);
}

fun settle_exchange(session: *Session, slot: *Slot) Step {
    if (!slot.exchange_live) { ret STEP_IDLE; }
    if (slot.cancelling)     { ret retire_closed_stream(session, slot); }
    val request: body.Progress = settle_request_body(session, slot);
    if (request.status == body.PENDING)                 { ret STEP_BLOCKED; }
    if (!body.reader_terminal_state(slot.request.body)) { ret STEP_ERROR; }
    if (slot.exchange.state == exchange.RESPONDING) {
        val finished: exchange.FinishStatus = exchange.finish(?slot.exchange);
        if (finished == exchange.FINISH_BODY_PENDING) { ret STEP_BLOCKED; }
        if (finished != exchange.FINISH_OK)           { ret STEP_ERROR; }
    }
    if (slot.close_disposition) {
        val stream: *engine_h2.Stream = engine_h2.stream_for(?session.engine,
            slot.id);
        if (stream != nil && stream.state != engine_h2.STREAM_CLOSED
            && !engine_h2.cancel_stream(?session.engine, slot.id,
            engine_h2.H2_CANCEL)) { ret STEP_ERROR; }
    }
    val stream: *engine_h2.Stream = engine_h2.stream_for(?session.engine,
        slot.id);
    if (stream == nil || stream.generation != slot.generation) { ret STEP_ERROR; }
    if (stream.state != engine_h2.STREAM_CLOSED)               { ret STEP_BLOCKED; }
    if (!finish_retirement(session, slot, true))               { ret STEP_ERROR; }
    ret STEP_PROGRESS;
}

fun fail_exchange(session: *Session, slot: *Slot, code: status.Status) Step {
    if (slot.response.committed)                             { ret STEP_ERROR; }
    if (!call.reset_response_for_failure(?slot.active_call)) { ret STEP_ERROR; }
    if (message.set_status(?slot.response, code) != message.RESPONSE_OK) {
        ret STEP_ERROR;
    }
    if (call.disposition(?slot.active_call) == call.BODY_UNRESOLVED
        && !call.resolve_body(?slot.active_call, call.BODY_CLOSE)) { ret STEP_ERROR; }
    if (service.commit(?slot.active_call) != message.RESPONSE_OK) {
        ret STEP_ERROR;
    }
    ret begin_response(session, slot);
}

fun start_exchange(session: *Session, slot: *Slot) Step {
    val served:  dispatch.Result = dispatch.serve(session.plan, ?slot.active_call,
        ?slot.captures[0], CAPTURE_SLOTS, session.budgets, ?slot.charge,
        wall_now());
    if (served.outcome == dispatch.FAILED) {
        ret fail_exchange(session, slot, status.INTERNAL_SERVER_ERROR);
    }
    if (served.outcome == dispatch.PENDING) {
        slot.service_pending = true;
        ret STEP_PROGRESS;
    }
    ret begin_response(session, slot);
}

fun resume_exchange(session: *Session, slot: *Slot) Step {
    val served:  dispatch.Result = dispatch.resume(session.plan, ?slot.active_call,
        session.budgets, ?slot.charge, wall_now());
    if (served.outcome == dispatch.PENDING) { ret STEP_BLOCKED; }
    slot.service_pending = false;
    if (served.outcome == dispatch.FAILED) {
        ret fail_exchange(session, slot, status.BAD_GATEWAY);
    }
    ret begin_response(session, slot);
}

# --- events ---

fun open_stream(session: *Session, event: engine_h2.Event, now: time.Time) Step {
    if (session.state != ACTIVE) {
        if (!engine_h2.cancel_stream(?session.engine, event.stream_id,
            engine_h2.H2_REFUSED_STREAM)
            || !engine_h2.release_event(?session.engine, event.stream_id,
            event.generation)
            || !engine_h2.release_stream(?session.engine, event.stream_id,
            event.generation)) { ret STEP_ERROR; }
        ret STEP_PROGRESS;
    }
    val slot: *Slot = free_slot(session);
    if (slot == nil) {
        if (!engine_h2.cancel_stream(?session.engine, event.stream_id,
            engine_h2.H2_REFUSED_STREAM)
            || !engine_h2.release_event(?session.engine, event.stream_id, event.generation)
            || !engine_h2.release_stream(?session.engine, event.stream_id,
            event.generation)) { ret STEP_ERROR; }
        ret STEP_PROGRESS;
    }
    reset_slot(slot);
    slot.live             = true;
    slot.id               = event.stream_id;
    slot.generation       = event.generation;
    slot.inbound_complete = event.end_stream;
    if (!make_exchange(session, slot, event, now)) {
        if (!engine_h2.release_event(?session.engine, event.stream_id,
            event.generation)
            || !engine_h2.cancel_stream(?session.engine, event.stream_id,
            engine_h2.H2_INTERNAL_ERROR)) { ret STEP_ERROR; }
        val retired: Step = retire_closed_stream(session, slot);
        if (retired != STEP_PROGRESS) { ret STEP_ERROR; }
        ret STEP_PROGRESS;
    }
    engine_h2.release_event(?session.engine, event.stream_id, event.generation);
    ret start_exchange(session, slot);
}

fun apply(session: *Session, event: engine_h2.Event, now: time.Time) Step {
    session.last_event = event.kind;
    if (event.kind == engine_h2.EVENT_NEED_READ) {
        engine_h2.submit_read(?session.engine);
        ret STEP_BLOCKED;
    }
    if (event.kind == engine_h2.EVENT_NONE) { ret STEP_BLOCKED; }
    if (event.kind == engine_h2.EVENT_CLOSED
        || event.kind == engine_h2.EVENT_PEER_CLOSED
        || event.kind == engine_h2.EVENT_ERROR
        || event.kind == engine_h2.EVENT_CANCELLED) {
        session.state = CLOSING;
        ret STEP_DONE;
    }
    if (event.kind == engine_h2.EVENT_REQUEST_HEADERS) {
        ret open_stream(session, event, now);
    }
    if (event.kind == engine_h2.EVENT_DATA) {
        session.held_stream = event.stream_id;
        session.held_data   = event.data;
        session.held_length = event.data_length;
        val slot: *Slot = slot_for(session, event.stream_id);
        if (slot != nil && event.end_stream) { slot.inbound_complete = true; }
        # bytes nobody will read still owe the peer its flow-control window. a
        # rejected body, a settled exchange and a stream we no longer hold all
        # reach this: leaving the frame held would stall the whole connection,
        # because the engine reads nothing more while it holds an event.
        if (slot == nil || !slot.exchange_live
            || body.reader_terminal_state(slot.request.body)) {
            engine_h2.consume_data(?session.engine, event.stream_id,
                event.data_length);
            session.held_stream = engine_h2.NO_STREAM;
            session.held_length = 0;
            ret STEP_PROGRESS;
        }
        complete_outstanding_body(slot);
        ret STEP_PROGRESS;
    }
    if (event.kind == engine_h2.EVENT_STREAM_END
        || event.kind == engine_h2.EVENT_TRAILERS) {
        val slot: *Slot = slot_for(session, event.stream_id);
        if (slot != nil) {
            slot.inbound_complete = true;
            if (slot.exchange_live) { complete_outstanding_body(slot); }
        }
        return_event(session, event);
        ret STEP_PROGRESS;
    }
    if (event.kind == engine_h2.EVENT_STREAM_RESET
        || event.kind == engine_h2.EVENT_STREAM_ERROR) {
        val slot: *Slot = slot_for(session, event.stream_id);
        if (slot != nil) {
            val retired: Step = retire_closed_stream(session, slot);
            if (retired == STEP_ERROR) { session.state = FAILED; }
            ret retired;
        }
        ret STEP_PROGRESS;
    }
    if (event.kind == engine_h2.EVENT_GOAWAY) {
        session.state = CLOSING;
        ret STEP_PROGRESS;
    }
    ret STEP_PROGRESS;
}

# a pending service completes its own suspended operation when it is resumed,
# so the host only completes what was left outstanding after the service returned
fun complete_outstanding_body(slot: *Slot) {
    if (slot.service_pending || slot.body.pending_token == 0) { ret; }
    body.complete_reader(slot.request.body, slot.body.pending_token);
}

fun return_event(session: *Session, event: engine_h2.Event) {
    if (event.stream_id == engine_h2.NO_STREAM) { ret; }
    engine_h2.release_event(?session.engine, event.stream_id,
        event.generation);
}

fun pump_slot(session: *Session, slot: *Slot, now: time.Time) Step {
    if (!slot.live || !slot.exchange_live) { ret STEP_IDLE; }
    if (slot.cancelling) {
        ret retire_closed_stream(session, slot);
    }
    if (slot.service_pending) {
        val resumed: Step = resume_exchange(session, slot);
        if (resumed != STEP_BLOCKED) { ret resumed; }
        ret STEP_BLOCKED;
    }
    if (!slot.headers_sent) {
        val started: Step = begin_response(session, slot);
        if (started != STEP_IDLE) { ret started; }
        ret STEP_BLOCKED;
    }
    if (!slot.response_complete) { ret advance_response(session, slot); }
    ret settle_exchange(session, slot);
}

fun pump_streams(session: *Session, now: time.Time) Step {
    var progressed: bool     = false;
    var i:          usize    = 0;
    for (i < MAX_STREAMS) {
        val stepped: Step = pump_slot(session, ?session.slots[i], now);
        if (stepped == STEP_ERROR)    { ret STEP_ERROR; }
        if (stepped == STEP_PROGRESS) { progressed = true; }
        i = i + 1;
    }
    if (progressed) { ret STEP_PROGRESS; }
    ret STEP_BLOCKED;
}

fun runnable(session: *Session) bool {
    if (session == nil || !session.live
        || !session.engine_started) { ret false; }
    ret session.engine.state != engine_h2.CLOSED
        && session.engine.state != engine_h2.FAILED;
}

pub fun step(session: *Session, now: time.Time) Step {
    if (!runnable(session)) { ret STEP_DONE; }
    if (session.state != ACTIVE && session.state != CLOSING) { ret STEP_DONE; }
    # the engine frames its own preface, settings, acknowledgements and window
    # updates, and only `submit_write` discovers there is something to frame.
    # leaving that to a queued-byte check would never send the preface at all.
    if (!session.engine.write_pending
        && engine_h2.submit_write(?session.engine)) {
        session.last_step = STEP_PROGRESS;
        ret STEP_PROGRESS;
    }
    val pumped: Step = pump_streams(session, now);
    if (pumped == STEP_ERROR) {
        session.state     = FAILED;
        session.last_step = STEP_ERROR;
        ret STEP_ERROR;
    }
    if (pumped == STEP_PROGRESS) {
        session.last_step = STEP_PROGRESS;
        ret STEP_PROGRESS;
    }
    if (session.state == CLOSING) {
        # a graceful HTTP/2 close is two GOAWAYs: the first warns and refuses
        # nothing, the second names the last stream this connection will
        # process. `progress_close` refuses to close until that second one has
        # been sent, so without this a drained connection never closes at all.
        if (!session.final_goaway_sent
            && session.engine.active_local == 0 && session.engine.active_remote == 0
            && engine_h2.finish_graceful(?session.engine)) {
            session.final_goaway_sent = true;
            session.last_step         = STEP_PROGRESS;
            ret STEP_PROGRESS;
        }
        if (engine_h2.progress_close(?session.engine)) {
            session.last_step = STEP_PROGRESS;
            ret STEP_PROGRESS;
        }
    }
    val taken: Step = apply(session, engine_h2.process(?session.engine), now);
    session.last_step = taken;
    ret taken;
}

pub fun advance(session: *Session, now: time.Time) Step {
    if (session == nil || !session.live) { ret STEP_ERROR; }
    var steps: usize = 0;
    for (steps < MAX_STEPS) {
        val progress: Step = step(session, now);
        if (progress != STEP_PROGRESS) { ret progress; }
        steps = steps + 1;
    }
    ret STEP_BLOCKED;
}

# one transport completion settles the engine and the event it returns is the
# next event this connection will ever produce, so it is applied rather than
# dropped
pub fun complete_io(session: *Session, settled: *transport.Completion,
    now: time.Time) Step {
    # terminal engine state stops new protocol work, but every submitted
    # transport operation still owns a completion slot that must be settled
    # before the session storage can be destroyed.
    if (session == nil || !session.live
        || !session.engine_started) { ret STEP_DONE; }
    val event: engine_h2.Event = engine_h2.complete_io(?session.engine,
        settled);
    if (!runnable(session)) { ret STEP_DONE; }
    ret apply(session, event, now);
}

pub fun begin_graceful(session: *Session) bool {
    if (session == nil || !session.live
        || !session.engine_started) { ret false; }
    if (session.state == CLOSING) { ret true; }
    session.state             = CLOSING;
    session.final_goaway_sent = false;
    ret engine_h2.begin_graceful(?session.engine);
}

pub fun requests(session: *Session) u64 {
    if (session == nil) { ret 0; }
    ret session.requests;
}

pub rec Snapshot {
    state:          State;
    engine_state:   engine_h2.State;
    last_event:     engine_h2.EventKind;
    last_step:      Step;
    requests:       u64;
    active_streams: usize;
}

pub fun snapshot(session: *Session) Snapshot {
    var value: Snapshot;
    if (session == nil || !session.live) {
        value.state          = CLOSED;
        value.engine_state   = 0;
        value.last_event     = engine_h2.EVENT_NONE;
        value.last_step      = STEP_IDLE;
        value.requests       = 0;
        value.active_streams = 0;
        ret value;
    }
    value.state        = session.state;
    value.engine_state = session.engine.state;
    value.last_event   = session.last_event;
    value.last_step    = session.last_step;
    value.requests     = session.requests;
    var count: usize = 0;
    var i:     usize = 0;
    for (i < MAX_STREAMS) {
        if (session.slots[i].live) { count = count + 1; }
        i = i + 1;
    }
    value.active_streams = count;
    ret value;
}

rec PendingResponseTest {
    output:   *u8;
    capacity: usize;
    ready:    bool;
    reader:   body.Reader;
}

fun pending_response_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    val state: *PendingResponseTest = context::*PendingResponseTest;
    if (state.ready) { ret body.complete(body.REUSE_ALLOWED); }
    state.output   = output;
    state.capacity = capacity;
    ret body.pending(43);
}

fun pending_response_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT)  { ret body.rejected(body.REUSE_FORBIDDEN); }
    ret body.complete(body.REUSE_ALLOWED);
}

fun pending_response_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val state: *PendingResponseTest = context::*PendingResponseTest;
    if (state == nil || token != 43 || state.output == nil || state.capacity < 4) {
        ret body.failed("pending response completion lost its buffer",
            body.REUSE_FORBIDDEN);
    }
    state.output[0] = 'l';
    state.output[1] = 'a';
    state.output[2] = 't';
    state.output[3] = 'e';
    state.ready     = true;
    ret body.data(4);
}

fun pending_response_release(context: ptr) {}

test "h2: a pending response read completes into the retained stage" {
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 1; }
    var state: PendingResponseTest;
    state.output   = nil;
    state.capacity = 0;
    state.ready    = false;
    state.reader   = body.init_reader((?state)::ptr, pending_response_read,
        pending_response_finish, pending_response_complete,
        pending_response_release, body.OWNER_APPLICATION, 1, true, 4,
        body.limits(4, 4, 2), nil, ?scope);
    var output:  [4]u8;
    val pending: body.Progress = response_body_progress(?state.reader,
        ?output[0], 4);
    if (pending.status != body.PENDING
        || state.reader.pending_kind != body.OP_READ) {
        operation_ok(cancel.destroy(?scope));
        ret 2;
    }
    val completed: body.Progress = response_body_progress(?state.reader,
        ?output[0], 4);
    if (completed.status != body.DATA || completed.count != 4
        || output[0] != 'l' || output[3] != 'e') {
        operation_ok(cancel.destroy(?scope));
        ret 3;
    }
    if (response_body_progress(?state.reader, ?output[0], 4).status
        != body.COMPLETE) {
        operation_ok(cancel.destroy(?scope));
        ret 4;
    }
    cancel.destroy(?scope);
    ret 0;
}

rec PendingCancelTest {
    finish_calls:  usize;
    release_calls: usize;
    reader:        body.Reader;
}

fun pending_cancel_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.pending(71);
}

fun pending_cancel_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *PendingCancelTest = context::*PendingCancelTest;
    state.finish_calls = state.finish_calls + 1;
    if (mode != body.CANCEL) {
        ret body.failed("unexpected response finish mode", body.REUSE_FORBIDDEN);
    }
    if (state.finish_calls == 1) { ret body.pending(72); }
    ret body.cancelled(body.REUSE_FORBIDDEN);
}

fun pending_cancel_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    ret body.failed("cancellation must be retried through settlement",
        body.REUSE_FORBIDDEN);
}

fun pending_cancel_release(context: ptr) {
    val state: *PendingCancelTest = context::*PendingCancelTest;
    state.release_calls = state.release_calls + 1;
}

test "h2: pending exchange cancellation remains owned until settlement" {
    val configured: message.Limits = message.limits_default();
    var slot:       Slot;
    if (!operation_ok(cancel.make_root(?slot.scope, false, time.Time{sec: 0, nsec: 0}))) {
        ret 1;
    }
    slot.scope_live = true;
    val generation:     u64          = 91;
    var request_body:   body.Reader  = body.empty_reader(generation);
    var request_fields: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    var request_trailers: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    var metadata: message.Metadata;
    metadata.version       = message.version_h2();
    metadata.secure        = false;
    metadata.early_data    = false;
    metadata.peer          = message.unspecified_endpoint();
    metadata.local         = message.unspecified_endpoint();
    metadata.received_at   = time.Time{sec: 0, nsec: 0};
    metadata.has_deadline  = false;
    metadata.deadline      = time.Time{sec: 0, nsec: 0};
    metadata.request_index = generation;
    if (!message.init_request(?slot.request, method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1), view.view(nil, 0)),
        metadata, request_fields, request_trailers, ?request_body,
        generation, configured)
        || !message.init_response(?slot.response, ?slot.response_fields[0],
        RESPONSE_FIELD_SLOTS, ?slot.response_trailers[0],
        RESPONSE_TRAILER_SLOTS, generation, configured)) {
        cancel.destroy(?slot.scope);
        ret 2;
    }
    var state: PendingCancelTest;
    state.finish_calls  = 0;
    state.release_calls = 0;
    state.reader        = body.init_reader((?state)::ptr, pending_cancel_read,
        pending_cancel_finish, pending_cancel_complete,
        pending_cancel_release, body.OWNER_APPLICATION, generation,
        true, 0, configured.response_body, ?slot.response.trailers,
        ?slot.scope);
    if (!state.reader.valid
        || message.set_status(?slot.response, status.OK) != message.RESPONSE_OK
        || message.set_body_reader(?slot.response, ?state.reader, configured)
        != message.RESPONSE_OK
        || !exchange.init(?slot.exchange, ?slot.request, ?slot.response,
        ?slot.informationals[0], INFORMATIONAL_SLOTS, ?slot.scope,
        generation, configured)
        || !exchange.begin(?slot.exchange)
        || exchange.commit(?slot.exchange, configured) != message.RESPONSE_OK) {
        cancel.destroy(?slot.scope);
        ret 3;
    }
    slot.exchange_live = true;
    slot.cancelling    = false;
    if (settle_slot_cancellation(?slot) != exchange.FINISH_BODY_PENDING
        || !slot.cancelling || state.finish_calls != 1
        || slot.exchange.state != exchange.RESPONDING) {
        cancel.destroy(?slot.scope);
        ret 4;
    }
    if (settle_slot_cancellation(?slot) != exchange.FINISH_OK
        || slot.exchange.state != exchange.CANCELLED_STATE
        || state.finish_calls != 2 || state.release_calls != 1) {
        cancel.destroy(?slot.scope);
        ret 5;
    }
    if (!operation_ok(cancel.destroy(?slot.scope))) { ret 6; }
    ret 0;
}

rec DispositionTest {
    finish_calls: usize;
    finish_mode:  body.Mode;
    reader:       body.Reader;
}

fun disposition_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.pending(81);
}

fun disposition_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *DispositionTest = context::*DispositionTest;
    state.finish_calls = state.finish_calls + 1;
    state.finish_mode  = mode;
    if (mode == body.DRAIN)  { ret body.complete(body.REUSE_ALLOWED); }
    if (mode == body.REJECT) { ret body.rejected(body.REUSE_ALLOWED); }
    if (mode == body.CANCEL) { ret body.cancelled(body.REUSE_FORBIDDEN); }
    ret body.timed_out(body.REUSE_FORBIDDEN);
}

fun disposition_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    ret body.failed("unexpected disposition completion", body.REUSE_FORBIDDEN);
}

fun disposition_release(context: ptr) {}

fun make_disposition_reader(state: *DispositionTest, scope: *cancel.Scope,
    generation: u64) body.Reader {
    state.finish_calls = 0;
    state.finish_mode  = 0;
    ret body.init_reader((state)::ptr, disposition_read,
        disposition_finish, disposition_complete, disposition_release,
        body.OWNER_APPLICATION, generation, false, 0,
        body.limits(1024, 1024, 4), nil, scope);
}

test "h2: request body dispositions retain their distinct ownership" {
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) {
        ret 1;
    }
    var slot:  Slot;
    var state: DispositionTest;
    state.reader                 = make_disposition_reader(?state, ?scope, 101);
    slot.request.body            = ?state.reader;
    slot.active_call.disposition = call.BODY_DRAIN;
    val drained: body.Progress = settle_request_body(nil, ?slot);
    if (drained.status != body.COMPLETE || state.finish_calls != 1
        || state.finish_mode != body.DRAIN) {
        operation_ok(cancel.destroy(?scope));
        ret 2;
    }

    state.reader                 = make_disposition_reader(?state, ?scope, 102);
    slot.request.body            = ?state.reader;
    slot.active_call.disposition = call.BODY_REJECT;
    val rejected: body.Progress = settle_request_body(nil, ?slot);
    if (rejected.status != body.REJECTED || state.finish_calls != 1
        || state.finish_mode != body.REJECT) {
        operation_ok(cancel.destroy(?scope));
        ret 3;
    }

    state.reader                 = make_disposition_reader(?state, ?scope, 103);
    slot.request.body            = ?state.reader;
    slot.active_call.disposition = call.BODY_DELIVER;
    val delivered: body.Progress = settle_request_body(nil, ?slot);
    if (delivered.status != body.ERROR || state.finish_calls != 0
        || body.reader_terminal_state(?state.reader)) {
        body.cancel_reader(?state.reader);
        operation_ok(cancel.destroy(?scope));
        ret 4;
    }
    body.cancel_reader(?state.reader);

    var a: A.Allocator;
    page.make(?a);
    var sessions: storage.Recycler[Session];
    if (!storage.make[Session](?sessions, ?a, 1)) {
        operation_ok(cancel.destroy(?scope));
        ret 5;
    }
    val session: *Session = acquire(?sessions);
    if (session == nil) {
        operation_ok(cancel.destroy(?scope));
        ret 5;
    }
    session.state                = CLOSING;
    state.reader                 = make_disposition_reader(?state, ?scope, 104);
    slot.request.body            = ?state.reader;
    slot.active_call.disposition = call.BODY_CLOSE;
    slot.close_disposition       = false;
    val closed: body.Progress = settle_request_body(session, ?slot);
    if (closed.status != body.CANCELLED || state.finish_calls != 1
        || state.finish_mode != body.CANCEL || !slot.close_disposition) {
        release_status(?sessions, session);
        operation_ok(cancel.destroy(?scope));
        ret 6;
    }
    if (release_status(?sessions, session) != RELEASE_OK
        || !storage.destroy[Session](?sessions)
        || !operation_ok(cancel.destroy(?scope))) { ret 7; }
    ret 0;
}

test "h2: sessions are claimed per connection and recycled" {
    var a: A.Allocator;
    page.make(?a);
    var sessions: storage.Recycler[Session];
    if (!storage.make[Session](?sessions, ?a, 1)) { ret 1; }
    # far past the sixteen sessions the table used to hold
    var held: [40]*Session;
    var i: usize = 0;
    for (i < 40) {
        held[i] = acquire(?sessions);
        if (held[i] == nil || held[i].live == false) { ret 2; }
        i = i + 1;
    }
    if (storage.held[Session](?sessions) != 40) { ret 3; }
    val returned: *Session = held[39];
    if (release_status(?sessions, returned) != RELEASE_OK) { ret 4; }
    if (release_status(?sessions, returned) != RELEASE_FAILED) { ret 5; }
    held[39] = acquire(?sessions);
    if (held[39] != returned) { ret 6; }
    i = 0;
    for (i < 40) {
        if (release_status(?sessions, held[i]) != RELEASE_OK) { ret 7; }
        i = i + 1;
    }
    if (!storage.destroy[Session](?sessions)) { ret 8; }
    ret 0;
}

test "h2: the configured stream bound reaches local admission and settings" {
    val configured: engine_h2.Config = config_from(message.limits_default(), 1);
    if (configured.max_streams != 1
        || configured.local.max_concurrent_streams != 1) { ret 1; }
    val bounded: engine_h2.Config = config_from(message.limits_default(),
        MAX_STREAMS + 1);
    if (bounded.max_streams != MAX_STREAMS
        || bounded.local.max_concurrent_streams != MAX_STREAMS::u32) { ret 2; }
    ret 0;
}

test "h2: an origin-form path splits into path and query exactly once" {
    val plain: target.Target = target_of(view.view("/hello", 6));
    if (plain.path.len != 6 || plain.query.len != 0) { ret 1; }
    val queried: target.Target = target_of(view.view("/hello?a=1", 10));
    if (queried.path.len != 6)                                      { ret 2; }
    if (queried.query.len != 3 || queried.query.data[0] != 'a'::u8) { ret 3; }
    # a trailing marker is an empty query, not a missing one
    val empty: target.Target = target_of(view.view("/hello?", 7));
    if (empty.path.len != 6 || empty.query.len != 0) { ret 4; }
    # and the raw form keeps everything the peer sent
    if (queried.raw.len != 10) { ret 5; }
    val star: target.Target = target_of(view.view("*", 1));
    if (star.form != target.ASTERISK) { ret 6; }
    ret 0;
}

test "h2: methods map to their kinds and unknown ones stay extensions" {
    if (method_of(view.view("GET", 3)).kind != method.GET)         { ret 1; }
    if (method_of(view.view("POST", 4)).kind != method.POST)       { ret 2; }
    if (method_of(view.view("PATCH", 5)).kind != method.PATCH)     { ret 3; }
    if (method_of(view.view("CONNECT", 7)).kind != method.CONNECT) { ret 4; }
    val custom: method.Method = method_of(view.view("PURGE", 5));
    if (custom.kind != method.EXTENSION || custom.token.len != 5) { ret 5; }
    # case matters: HTTP/2 method names are exact tokens
    if (method_of(view.view("get", 3)).kind != method.EXTENSION) { ret 6; }
    ret 0;
}

test "h2: connection-specific header fields never reach the wire" {
    var slot: Slot;
    reset_slot(?slot);
    var storage:    [4]field.Field;
    val configured: message.Limits = message.limits_default();
    if (!message.init_response(?slot.response, ?storage[0], 4,
        ?slot.response_trailers[0], RESPONSE_TRAILER_SLOTS, 1, configured)) {
        ret 1;
    }
    if (message.set_status(?slot.response, status.OK) != message.RESPONSE_OK) {
        ret 2;
    }
    if (message.add_field(?slot.response, field.Field{name: view.view("server", 6),
        value: view.view("hedge", 5), sensitive: false}) != field.ADD_OK) { ret 3; }
    if (message.add_field(?slot.response, field.Field{
        name:      view.view("connection", 10), value: view.view("close", 5),
        sensitive: false
    }) != field.ADD_OK) { ret 4; }
    val count: usize = response_headers(?slot);
    # :status, server. the hop-by-hop field is dropped rather than framed.
    if (count != 2) { ret 5; }
    if (slot.header_items[0].name.len != 7
        || slot.header_items[0].value.len != 3
        || slot.header_items[0].value.data[0] != '2'::u8) { ret 6; }
    if (!field.name_equal(slot.header_items[1].name, view.view("server", 6))) {
        ret 7;
    }
    ret 0;
}
