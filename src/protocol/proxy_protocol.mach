# bounded PROXY protocol v1 and v2 decoding
#
# the decoded peer replaces the observed one only when the observed peer is
# trusted to speak for another. an untrusted peer sending a header is refused
# rather than believed, because believing it would let any client assert an
# arbitrary source address to every policy downstream.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.view;
use std.types.char.char;
use std.types.string.str;

pub def Status: u8;
# a complete header was decoded and consumed
pub val DECODED: Status = 1;
# not enough bytes yet; the caller supplies more and retries
pub val INCOMPLETE: Status = 2;
# a well formed header declaring a connection with no source of its own
pub val LOCAL: Status = 3;
# the prefix does not begin a PROXY header at all
pub val ABSENT: Status = 4;
# the bytes begin a header and are not a valid one
pub val MALFORMED: Status = 5;
# a valid header from a peer that is not trusted to send one
pub val UNTRUSTED: Status = 6;

pub def Family: u8;
pub val FAMILY_UNSPEC: Family = 0;
pub val FAMILY_INET: Family = 1;
pub val FAMILY_INET6: Family = 2;

# the largest v2 header this accepts: the 16 byte fixed part plus the IPv6
# address block. type-length-value extensions beyond that are skipped, bounded
# by MAX_ADDRESS_BYTES, and never copied.
pub val V2_PREFIX_BYTES: usize = 12;
pub val V2_HEADER_BYTES: usize = 16;
pub val MAX_ADDRESS_BYTES: usize = 536;
pub val MAX_V1_BYTES: usize = 107;
pub val MAX_TEXT_BYTES: usize = 46;

pub rec Peer {
    family: Family;
    # printable form, owned by the caller's storage
    address: view.View;
    port: u16;
}

pub rec Result {
    status: Status;
    consumed: usize;
    peer: Peer;
    local: Peer;
}

fun empty_peer() Peer {
    var value: Peer;
    value.family = FAMILY_UNSPEC;
    value.address = view.view(nil, 0);
    value.port = 0;
    ret value;
}

# every field is assigned by name: an empty record literal is not trusted to
# clear its members. see briar-systems/mach#3108.
fun result(status: Status, consumed: usize) Result {
    var value: Result;
    value.status = status;
    value.consumed = consumed;
    value.peer = empty_peer();
    value.local = empty_peer();
    ret value;
}

val V1_SIGNATURE: str = "PROXY ";
var v2_signature: [12]u8 = [12]u8{0x0d, 0x0a, 0x0d, 0x0a, 0x00, 0x0d,
    0x0a, 0x51, 0x55, 0x49, 0x54, 0x0a};

fun range_valid(data: *u8, len: usize) bool {
    if (len == 0) { ret true; }
    if (data == nil) { ret false; }
    ret len - 1 <= ~(0::usize) - data::usize;
}

fun matches(data: *u8, len: usize, expected: *u8, expected_len: usize) bool {
    if (len < expected_len) { ret false; }
    var i: usize = 0;
    for (i < expected_len) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun prefix_matches(data: *u8, len: usize, expected: str,
    expected_len: usize) bool {
    if (len < expected_len) { ret false; }
    var i: usize = 0;
    for (i < expected_len) {
        if (data[i] != expected[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a shared prefix that has not yet reached the full signature is incomplete
# rather than absent, so the caller waits instead of treating the bytes as the
# start of a request
fun shares_prefix(data: *u8, len: usize, expected: *u8,
    expected_len: usize) bool {
    var i: usize = 0;
    for (i < len && i < expected_len) {
        if (data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun digit(value: u8) bool { ret value >= '0'::u8 && value <= '9'::u8; }

# a decimal port with no leading zero and no overflow past 65535
fun parse_port(data: *u8, len: usize, output: *u16) bool {
    if (len == 0 || len > 5 || output == nil) { ret false; }
    if (len > 1 && data[0] == '0'::u8) { ret false; }
    var value: usize = 0;
    var i: usize = 0;
    for (i < len) {
        if (!digit(data[i])) { ret false; }
        value = value * 10 + (data[i] - '0'::u8)::usize;
        if (value > 65535) { ret false; }
        i = i + 1;
    }
    @output = value::u16;
    ret true;
}

fun valid_inet_text(data: *u8, len: usize) bool {
    if (len == 0 || len > 15) { ret false; }
    var octets: usize = 0;
    var i: usize = 0;
    for (i < len) {
        var span: usize = 0;
        var value: usize = 0;
        for (i + span < len && digit(data[i + span])) {
            value = value * 10 + (data[i + span] - '0'::u8)::usize;
            span = span + 1;
        }
        if (span == 0 || span > 3 || value > 255) { ret false; }
        if (span > 1 && data[i] == '0'::u8) { ret false; }
        octets = octets + 1;
        i = i + span;
        if (i < len) {
            if (data[i] != '.'::u8) { ret false; }
            i = i + 1;
            if (i == len) { ret false; }
        }
    }
    ret octets == 4;
}

fun hex_digit(value: u8) bool {
    ret digit(value) || (value >= 'a'::u8 && value <= 'f'::u8)
     || (value >= 'A'::u8 && value <= 'F'::u8);
}

# accepts the textual IPv6 forms RFC 2373 permits, including one "::" run
fun valid_inet6_text(data: *u8, len: usize) bool {
    if (len == 0 || len > MAX_TEXT_BYTES) { ret false; }
    var groups: usize = 0;
    var compressed: bool = false;
    var i: usize = 0;
    if (len >= 2 && data[0] == ':'::u8) {
        if (data[1] != ':'::u8) { ret false; }
        compressed = true;
        i = 2;
        if (i == len) { ret true; }
    }
    for (i < len) {
        var span: usize = 0;
        for (i + span < len && hex_digit(data[i + span])) { span = span + 1; }
        if (span == 0 || span > 4) { ret false; }
        groups = groups + 1;
        if (groups > 8) { ret false; }
        i = i + span;
        if (i == len) { brk; }
        if (data[i] != ':'::u8) { ret false; }
        i = i + 1;
        if (i < len && data[i] == ':'::u8) {
            if (compressed) { ret false; }
            compressed = true;
            i = i + 1;
            if (i == len) { ret true; }
        } or {
            if (i == len) { ret false; }
        }
    }
    if (compressed) { ret groups <= 7; }
    ret groups == 8;
}

fun field_end(data: *u8, len: usize, start: usize) usize {
    var i: usize = start;
    for (i < len && data[i] != ' '::u8 && data[i] != 0x0d) { i = i + 1; }
    ret i;
}

# decodes the v1 text header, which ends at the first CRLF
fun decode_v1(data: *u8, len: usize) Result {
    var i: usize = 6;
    var terminator: usize = MAX_V1_BYTES;
    var scan: usize = i;
    for (scan + 1 < len && scan + 1 < MAX_V1_BYTES) {
        if (data[scan] == 0x0d && data[scan + 1] == 0x0a) {
            terminator = scan;
            brk;
        }
        scan = scan + 1;
    }
    if (terminator == MAX_V1_BYTES) {
        if (len >= MAX_V1_BYTES) { ret result(MALFORMED, 0); }
        ret result(INCOMPLETE, 0);
    }
    val total: usize = terminator + 2;

    var family: Family = FAMILY_UNSPEC;
    if (prefix_matches(?data[i], terminator - i, "TCP4", 4)) {
        family = FAMILY_INET;
        i = i + 4;
    } or (prefix_matches(?data[i], terminator - i, "TCP6", 4)) {
        family = FAMILY_INET6;
        i = i + 4;
    } or (prefix_matches(?data[i], terminator - i, "UNKNOWN", 7)) {
        # a proxy that cannot describe the source still framed a valid header;
        # the connection is accepted and the observed peer is kept
        ret result(LOCAL, total);
    } or {
        ret result(MALFORMED, 0);
    }
    if (i >= terminator || data[i] != ' '::u8) { ret result(MALFORMED, 0); }
    i = i + 1;

    val source_start: usize = i;
    val source_end: usize = field_end(data, terminator, i);
    if (source_end >= terminator || data[source_end] != ' '::u8) {
        ret result(MALFORMED, 0);
    }
    i = source_end + 1;
    val dest_start: usize = i;
    val dest_end: usize = field_end(data, terminator, i);
    if (dest_end >= terminator || data[dest_end] != ' '::u8) {
        ret result(MALFORMED, 0);
    }
    i = dest_end + 1;
    val source_port_start: usize = i;
    val source_port_end: usize = field_end(data, terminator, i);
    if (source_port_end >= terminator || data[source_port_end] != ' '::u8) {
        ret result(MALFORMED, 0);
    }
    i = source_port_end + 1;
    val dest_port_start: usize = i;
    val dest_port_end: usize = terminator;
    if (dest_port_end <= dest_port_start) { ret result(MALFORMED, 0); }

    val source_len: usize = source_end - source_start;
    val dest_len: usize = dest_end - dest_start;
    if (family == FAMILY_INET) {
        if (!valid_inet_text(?data[source_start], source_len) ||
            !valid_inet_text(?data[dest_start], dest_len)) {
            ret result(MALFORMED, 0);
        }
    } or {
        if (!valid_inet6_text(?data[source_start], source_len) ||
            !valid_inet6_text(?data[dest_start], dest_len)) {
            ret result(MALFORMED, 0);
        }
    }
    var source_port: u16 = 0;
    var dest_port: u16 = 0;
    if (!parse_port(?data[source_port_start],
            source_port_end - source_port_start, ?source_port) ||
        !parse_port(?data[dest_port_start], dest_port_end - dest_port_start,
            ?dest_port)) { ret result(MALFORMED, 0); }

    var decoded: Result = result(DECODED, total);
    decoded.peer.family = family;
    decoded.peer.address = view.view(?data[source_start], source_len);
    decoded.peer.port = source_port;
    decoded.local.family = family;
    decoded.local.address = view.view(?data[dest_start], dest_len);
    decoded.local.port = dest_port;
    ret decoded;
}

fun be16(data: *u8) usize { ret (data[0]::usize << 8) | data[1]::usize; }

fun write_decimal(value: u8, output: *u8, offset: usize) usize {
    var written: usize = 0;
    if (value >= 100) {
        output[offset] = '0'::u8 + value / 100;
        written = written + 1;
    }
    if (value >= 10) {
        output[offset + written] = '0'::u8 + (value / 10) % 10;
        written = written + 1;
    }
    output[offset + written] = '0'::u8 + value % 10;
    ret written + 1;
}

# v2 carries addresses in binary; a printable form is rendered into caller
# storage so the decoded peer has the same shape as a v1 one
fun render_inet(source: *u8, output: *u8, capacity: usize,
    written: *usize) bool {
    if (capacity < 15 || written == nil) { ret false; }
    var offset: usize = 0;
    var i: usize = 0;
    for (i < 4) {
        offset = offset + write_decimal(source[i], output, offset);
        if (i != 3) { output[offset] = '.'::u8; offset = offset + 1; }
        i = i + 1;
    }
    @written = offset;
    ret true;
}

fun hex_char(value: u8) u8 {
    if (value < 10) { ret '0'::u8 + value; }
    ret 'a'::u8 + value - 10;
}

# the full uncompressed form: predictable length, no "::" run to get wrong
fun render_inet6(source: *u8, output: *u8, capacity: usize,
    written: *usize) bool {
    if (capacity < 39 || written == nil) { ret false; }
    var offset: usize = 0;
    var group: usize = 0;
    for (group < 8) {
        val high: u8 = source[group * 2];
        val low: u8 = source[group * 2 + 1];
        output[offset] = hex_char(high >> 4);
        output[offset + 1] = hex_char(high & 0x0f);
        output[offset + 2] = hex_char(low >> 4);
        output[offset + 3] = hex_char(low & 0x0f);
        offset = offset + 4;
        if (group != 7) { output[offset] = ':'::u8; offset = offset + 1; }
        group = group + 1;
    }
    @written = offset;
    ret true;
}

# scratch must stay owned by the caller for as long as the result is read
fun decode_v2(data: *u8, len: usize, scratch: *u8,
    scratch_capacity: usize) Result {
    if (len < V2_HEADER_BYTES) { ret result(INCOMPLETE, 0); }
    val version: u8 = data[12] >> 4;
    val command: u8 = data[12] & 0x0f;
    if (version != 2) { ret result(MALFORMED, 0); }
    if (command != 0 && command != 1) { ret result(MALFORMED, 0); }
    val declared: usize = be16(?data[14]);
    if (declared > MAX_ADDRESS_BYTES) { ret result(MALFORMED, 0); }
    val total: usize = V2_HEADER_BYTES + declared;
    if (len < total) { ret result(INCOMPLETE, 0); }
    # LOCAL: a health check or the proxy's own connection, with no source
    if (command == 0) { ret result(LOCAL, total); }

    val protocol: u8 = data[13];
    val body: *u8 = ?data[V2_HEADER_BYTES];
    if (protocol == 0x11 || protocol == 0x12) {
        if (declared < 12) { ret result(MALFORMED, 0); }
        var source_len: usize = 0;
        var dest_len: usize = 0;
        if (!render_inet(?body[0], scratch, scratch_capacity, ?source_len)) {
            ret result(MALFORMED, 0);
        }
        if (!render_inet(?body[4], ?scratch[source_len],
                scratch_capacity - source_len, ?dest_len)) {
            ret result(MALFORMED, 0);
        }
        var decoded: Result = result(DECODED, total);
        decoded.peer.family = FAMILY_INET;
        decoded.peer.address = view.view(scratch, source_len);
        decoded.peer.port = be16(?body[8])::u16;
        decoded.local.family = FAMILY_INET;
        decoded.local.address = view.view(?scratch[source_len], dest_len);
        decoded.local.port = be16(?body[10])::u16;
        ret decoded;
    }
    if (protocol == 0x21 || protocol == 0x22) {
        if (declared < 36) { ret result(MALFORMED, 0); }
        var source_len: usize = 0;
        var dest_len: usize = 0;
        if (!render_inet6(?body[0], scratch, scratch_capacity, ?source_len)) {
            ret result(MALFORMED, 0);
        }
        if (!render_inet6(?body[16], ?scratch[source_len],
                scratch_capacity - source_len, ?dest_len)) {
            ret result(MALFORMED, 0);
        }
        var decoded: Result = result(DECODED, total);
        decoded.peer.family = FAMILY_INET6;
        decoded.peer.address = view.view(scratch, source_len);
        decoded.peer.port = be16(?body[32])::u16;
        decoded.local.family = FAMILY_INET6;
        decoded.local.address = view.view(?scratch[source_len], dest_len);
        decoded.local.port = be16(?body[34])::u16;
        ret decoded;
    }
    # a family this build does not describe still framed a valid header
    ret result(LOCAL, total);
}

# `trusted` is the listener's policy decision about the observed peer, taken
# before any byte of the header is believed
pub fun decode(data: *u8, len: usize, trusted: bool, scratch: *u8,
    scratch_capacity: usize) Result {
    if (!range_valid(data, len) || !range_valid(scratch, scratch_capacity)) {
        ret result(MALFORMED, 0);
    }
    val v2_prefix: bool = matches(data, len, ?v2_signature[0], V2_PREFIX_BYTES);
    val v1_prefix: bool = prefix_matches(data, len, V1_SIGNATURE, 6);
    if (!v2_prefix && !v1_prefix) {
        # a partial signature is not yet absent: more bytes may complete it
        if (len < V2_PREFIX_BYTES &&
            shares_prefix(data, len, ?v2_signature[0], V2_PREFIX_BYTES)) {
            ret result(INCOMPLETE, 0);
        }
        if (len < 6 && shares_prefix_text(data, len, V1_SIGNATURE, 6)) {
            ret result(INCOMPLETE, 0);
        }
        ret result(ABSENT, 0);
    }
    # a header from an untrusted peer is refused rather than believed, and the
    # refusal does not depend on whether the header would have parsed
    if (!trusted) { ret result(UNTRUSTED, 0); }
    if (v2_prefix) { ret decode_v2(data, len, scratch, scratch_capacity); }
    ret decode_v1(data, len);
}

fun shares_prefix_text(data: *u8, len: usize, expected: str,
    expected_len: usize) bool {
    var i: usize = 0;
    for (i < len && i < expected_len) {
        if (data[i] != expected[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun feed(text: str, buffer: *u8) usize {
    var i: usize = 0;
    for (text[i] != 0) { buffer[i] = text[i]::u8; i = i + 1; }
    ret i;
}

fun view_equals(value: view.View, expected: str) bool {
    var i: usize = 0;
    for (i < value.len) {
        if (expected[i] == 0 || value.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret expected[value.len] == 0;
}

test "proxy_protocol: a v1 header names the source the proxy saw" {
    var buffer: [128]u8;
    var scratch: [64]u8;
    val len: usize = feed("PROXY TCP4 192.168.0.1 10.0.0.7 56324 443\r\nGET /",
        ?buffer[0]);
    val decoded: Result = decode(?buffer[0], len, true, ?scratch[0], 64);
    if (decoded.status != DECODED) { ret 1; }
    # exactly the header is consumed, so the request bytes behind it survive
    if (decoded.consumed != 43) { ret 2; }
    if (decoded.peer.family != FAMILY_INET || decoded.peer.port != 56324 ||
        !view_equals(decoded.peer.address, "192.168.0.1")) { ret 3; }
    if (decoded.local.port != 443 ||
        !view_equals(decoded.local.address, "10.0.0.7")) { ret 4; }
    ret 0;
}

test "proxy_protocol: an untrusted peer is refused rather than believed" {
    var buffer: [128]u8;
    var scratch: [64]u8;
    val len: usize = feed("PROXY TCP4 192.168.0.1 10.0.0.7 56324 443\r\n",
        ?buffer[0]);
    val refused: Result = decode(?buffer[0], len, false, ?scratch[0], 64);
    if (refused.status != UNTRUSTED || refused.consumed != 0) { ret 1; }
    # nothing about the claimed source reaches the caller
    if (refused.peer.address.data != nil || refused.peer.port != 0 ||
        refused.peer.family != FAMILY_UNSPEC) { ret 2; }
    # and the same bytes are accepted once policy trusts the peer, so the
    # refusal is the policy and not a parse failure
    if (decode(?buffer[0], len, true, ?scratch[0], 64).status != DECODED) {
        ret 3;
    }
    ret 0;
}

test "proxy_protocol: malformed v1 headers never publish a peer" {
    var buffer: [128]u8;
    var scratch: [64]u8;
    var i: usize = 0;
    # a bad octet, a bad port, a port with a leading zero, a missing field,
    # a truncated address, and an unknown family token
    for (i < 6) {
        var len: usize = 0;
        if (i == 0) { len = feed("PROXY TCP4 192.168.0.256 10.0.0.7 1 2\r\n", ?buffer[0]); }
        if (i == 1) { len = feed("PROXY TCP4 192.168.0.1 10.0.0.7 70000 2\r\n", ?buffer[0]); }
        if (i == 2) { len = feed("PROXY TCP4 192.168.0.1 10.0.0.7 0443 2\r\n", ?buffer[0]); }
        if (i == 3) { len = feed("PROXY TCP4 192.168.0.1 10.0.0.7\r\n", ?buffer[0]); }
        if (i == 4) { len = feed("PROXY TCP4 192.168.0 10.0.0.7 1 2\r\n", ?buffer[0]); }
        if (i == 5) { len = feed("PROXY TCP5 192.168.0.1 10.0.0.7 1 2\r\n", ?buffer[0]); }
        val decoded: Result = decode(?buffer[0], len, true, ?scratch[0], 64);
        if (decoded.status != MALFORMED) { ret (10 + i)::i32; }
        if (decoded.consumed != 0 || decoded.peer.address.data != nil) {
            ret (20 + i)::i32;
        }
        i = i + 1;
    }
    ret 0;
}

test "proxy_protocol: a partial signature waits instead of being mistaken" {
    var buffer: [128]u8;
    var scratch: [64]u8;
    val len: usize = feed("PROXY TCP4 192.168.0.1 10.0.0.7 1 2\r\n", ?buffer[0]);
    # every prefix of a real header is incomplete, never absent and never a peer
    var i: usize = 1;
    for (i < len - 1) {
        val partial: Result = decode(?buffer[0], i, true, ?scratch[0], 64);
        if (partial.status != INCOMPLETE) { ret (100 + i)::i32; }
        if (partial.consumed != 0) { ret 2; }
        i = i + 1;
    }
    # an ordinary request is absent, so the caller stops waiting
    val plain: usize = feed("GET / HTTP/1.1\r\n", ?buffer[0]);
    if (decode(?buffer[0], plain, true, ?scratch[0], 64).status != ABSENT) {
        ret 3;
    }
    ret 0;
}

test "proxy_protocol: a v2 header renders both binary families" {
    var buffer: [64]u8;
    var scratch: [96]u8;
    var i: usize = 0;
    for (i < 12) { buffer[i] = v2_signature[i]; i = i + 1; }
    buffer[12] = 0x21;
    buffer[13] = 0x11;
    buffer[14] = 0;
    buffer[15] = 12;
    buffer[16] = 203; buffer[17] = 0; buffer[18] = 113; buffer[19] = 9;
    buffer[20] = 10; buffer[21] = 0; buffer[22] = 0; buffer[23] = 7;
    buffer[24] = 0xdc; buffer[25] = 0x04;
    buffer[26] = 0x01; buffer[27] = 0xbb;
    val decoded: Result = decode(?buffer[0], 28, true, ?scratch[0], 96);
    if (decoded.status != DECODED || decoded.consumed != 28) { ret 1; }
    if (!view_equals(decoded.peer.address, "203.0.113.9") ||
        decoded.peer.port != 56324) { ret 2; }
    if (!view_equals(decoded.local.address, "10.0.0.7") ||
        decoded.local.port != 443) { ret 3; }

    # LOCAL carries no source, so the observed peer stands
    buffer[12] = 0x20;
    val local: Result = decode(?buffer[0], 28, true, ?scratch[0], 96);
    if (local.status != LOCAL || local.consumed != 28 ||
        local.peer.address.data != nil) { ret 4; }

    # a declared length longer than the buffer waits rather than reading past it
    buffer[12] = 0x21;
    buffer[15] = 200;
    if (decode(?buffer[0], 28, true, ?scratch[0], 96).status != INCOMPLETE) {
        ret 5;
    }
    # and a version other than 2 is refused
    buffer[15] = 12;
    buffer[12] = 0x31;
    if (decode(?buffer[0], 28, true, ?scratch[0], 96).status != MALFORMED) {
        ret 6;
    }
    ret 0;
}
