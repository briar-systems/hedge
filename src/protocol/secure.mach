# one TLS server session presented to an HTTP engine as an ordered byte transport
#
# a mach-tls stream carries one read and one write at once, each in its own
# lane, which is the shape an HTTP engine already assumes. this module maps the
# engine's operations onto those lanes: its read or readable wait onto the read
# lane, and its writes, half close and close onto the write lane in the order
# they were queued. a close needs both lanes free, so a read outstanding when
# the engine closes is cancelled first. mach-tls keeps every byte a cancelled
# read had received, so that cancel is control flow and never data loss.
#
# every TLS operation runs under a child of the scope the engine submitted it
# with, one per lane. that parentage is how a cancel or timeout reaching the
# engine's operation reaches the socket operation serving it. deadlines are
# timing wheel entries that end those scopes; no scope here carries one.
#
# memory comes from the connection's account on the TLS lane. a lane short of
# memory parks inside mach-tls, and `resume` retries it when the account wakes.
#
# the channel queues its connection itself, on the two events that give it work:
# the engine submitting an operation, and a TLS completion being routed in. a
# submission made while the connection steps is started by that step, and
# `end_step` wakes the connection for one the step left unstarted, so an
# operation is never left queued with nothing to run it (#195).
#
# a TLS session is secret-welded, so no public pointer may name one and a session
# cannot be reached through a callback context. sessions are therefore held in a
# secret table and addressed by index, while every callback context is a public
# `Channel` at the same index in a public table. that split is what the secrecy
# rules require, not a convenience: a public alias into secret state is exactly
# what they exist to prevent.
#
# both tables grow a chunk at a time as connections negotiate TLS, and nothing
# in either moves once it exists. a cleartext deployment never allocates them.

use hedge.listener;
use hedge.memory;
use hedge.protocol.tls;
use hedge.storage;
use hedge_wake:     hedge.wake;
use http_transport: http.core.transport;
use A:              std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use std.memory.buffers;
use net_async: std.net.async;
use std.net.tcp;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use tls_buffer:    tls.buffer;
use tls_engine:    tls.engine;
use tls_error:     tls.error;
use tls_server:    tls.server;
use tls_stream:    tls.stream;
use tls_transport: tls.transport;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret sel outcome.ok;
}

fun runtime_ok(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

pub val NO_SESSION: usize = (-1)::usize;

pub def State: u8;
pub val IDLE:        State = 0;
pub val HANDSHAKING: State = 1;
pub val OPEN:        State = 2;
pub val FAILED:      State = 3;
pub val CLOSED:      State = 4;

pub def Kind: u8;
pub val KIND_NONE:      Kind = 0;
pub val KIND_HANDSHAKE: Kind = 1;
pub val KIND_READ:      Kind = 2;
pub val KIND_WRITE:     Kind = 3;
pub val KIND_SHUTDOWN:  Kind = 4;
pub val KIND_CLOSE:     Kind = 5;
pub val KIND_READABLE:  Kind = 6;

# tls tokens name the lane an operation runs in
val READ_LANE_TOKEN:  u32 = 1;
val WRITE_LANE_TOKEN: u32 = 2;

# bytes the connection prologue already took off the socket, which the TLS
# record layer must see before the socket is read again. a nil buffer asks how
# many are left without taking any
pub def StagedFun: fun(ptr, *u8, usize) usize;

# one operation the HTTP transport handed over. its buffer and scope belong to
# this channel until exactly one completion is published for its token.
rec Pending {
    active: bool;
    token:  http_transport.Token;
    scope:  *cancel.Scope;
    buffer: *u8;
    length: usize;
}

# the completions a session has settled and the engine has not yet taken. each
# lane settles one at a time, so two is always enough
val DONE_SLOTS: usize = 2;

# everything a callback may touch. no secret state is reachable from here.
pub rec Channel {
    live:  bool;
    index: usize;
    state: State;
    # what each lane is running
    reading: Kind;
    writing: Kind;
    # the read lane was cancelled so a close can start
    read_cancelled:    bool;
    read_generation:   u32;
    write_generation:  u32;
    read:              Pending;
    readable:          Pending;
    readable_waiting:  bool;
    write:             Pending;
    shutdown:          Pending;
    close:             Pending;
    done:              [2]http_transport.Completion;
    done_count:        usize;
    handshake_settled: bool;
    handshake_error:   tls_error.Error;
    peer_closed:       bool;
    lower_eof:         bool;
    driver:            *net_async.Driver;
    socket:            *tcp.Stream;
    context:           listener.ConnectionContext;
    owner:             ptr;
    staged:            StagedFun;
    account:           *buffers.Account;
    # who is woken when this channel has work, and whether a wake was lost
    waker:       hedge_wake.Waker;
    wake_failed: bool;
    # the connection is stepping, so its step starts what the engine submits
    stepping: bool;
}

rec Session {
    transport:        tls_transport.Transport;
    engine:           tls_server.Handshake;
    stream:           tls_stream.Stream;
    source:           buffers.Source;
    secrets:          buffers.SecretSource;
    root:             cancel.Scope;
    root_live:        bool;
    read_scope:       cancel.Scope;
    read_scope_live:  bool;
    write_scope:      cancel.Scope;
    write_scope_live: bool;
    engine_started:   bool;
    stream_started:   bool;
}

# channel (plain) and session (welded) are the two halves of one pair
var paired:     storage.Pair[Channel, Session];
var heap:       A.Allocator;
var prepared:   bool;
var live_count: usize;

fun clear_pending(value: *Pending) {
    value.active = false;
    value.scope  = nil;
    value.buffer = nil;
    value.length = 0;
}

fun reset_channel(value: *Channel, index: usize) {
    value.live              = false;
    value.index             = index;
    value.state             = IDLE;
    value.reading           = KIND_NONE;
    value.writing           = KIND_NONE;
    value.read_cancelled    = false;
    value.read_generation   = 0;
    value.write_generation  = 0;
    value.readable_waiting  = false;
    value.done_count        = 0;
    value.handshake_settled = false;
    value.handshake_error   = tls_error.OK;
    value.peer_closed       = false;
    value.lower_eof         = false;
    value.driver            = nil;
    value.socket            = nil;
    value.owner             = nil;
    value.staged            = (0::usize)::StagedFun;
    value.account           = nil;
    value.waker             = hedge_wake.no_waker();
    value.wake_failed       = false;
    value.stepping          = false;
    clear_pending(?value.read);
    clear_pending(?value.readable);
    clear_pending(?value.write);
    clear_pending(?value.shutdown);
    clear_pending(?value.close);
}

fun prepare() {
    if (prepared) { ret; }
    page.make(?heap);
    # channel and session are the two halves of one pair, so they grow and
    # compact in lockstep and channel_at(i)/session_at(i) stay index-locked
    storage.make_pair[Channel, Session](?paired, ?heap);
    live_count = 0;
    prepared   = true;
}

fun session_at(index: usize) *Session {
    ret storage.pair_secret_at[Channel, Session](?paired, index);
}

fun channel_at(index: usize) *Channel {
    ret storage.pair_plain_at[Channel, Session](?paired, index);
}

fun claimed_index(index: usize) bool {
    val value: *Channel = channel_at(index);
    ret value != nil && value.live;
}

pub fun live() usize {
    prepare();
    ret live_count;
}

# one claim grows both storages in lockstep and hands back the lowest free
# index, so channel and session always share it; a table that cannot grow
# refuses the connection rather than overcommitting record storage
pub fun acquire() usize {
    prepare();
    val index: usize = storage.pair_claim[Channel, Session](?paired);
    if (index == storage.NO_INDEX) { ret NO_SESSION; }
    val value: *Channel = channel_at(index);
    reset_channel(value, index);
    value.live = true;
    val record: *Session = session_at(index);
    record.root_live        = false;
    record.read_scope_live  = false;
    record.write_scope_live = false;
    record.engine_started   = false;
    record.stream_started   = false;
    live_count              = live_count + 1;
    ret index;
}

fun release_read_scope(index: usize) {
    if (session_at(index).read_scope_live) {
        cancel.destroy(?session_at(index).read_scope);
        session_at(index).read_scope_live = false;
    }
}

fun release_write_scope(index: usize) {
    if (session_at(index).write_scope_live) {
        cancel.destroy(?session_at(index).write_scope);
        session_at(index).write_scope_live = false;
    }
}

fun destroy_scopes(index: usize) {
    release_read_scope(index);
    release_write_scope(index);
    if (session_at(index).root_live) {
        cancel.destroy(?session_at(index).root);
        session_at(index).root_live = false;
    }
}

fun lane_token(lane: u32, generation: u32) tls_transport.Token {
    ret tls_transport.Token{index: lane, generation: generation};
}

# false while a lane still runs. the connection releases a session only once
# both lanes have settled, which its close sequence waits for
pub fun release(index: usize) bool {
    prepare();
    if (!claimed_index(index)) { ret false; }
    val value:  *Channel = channel_at(index);
    val record: *Session = session_at(index);
    if (record.stream_started) {
        if (value.reading != KIND_NONE) {
            tls_stream.destroy_operation(?record.stream,
                lane_token(READ_LANE_TOKEN, value.read_generation));
        }
        if (value.writing != KIND_NONE) {
            tls_stream.destroy_operation(?record.stream,
                lane_token(WRITE_LANE_TOKEN, value.write_generation));
        }
        tls_stream.destroy(?record.stream);
        record.stream_started = false;
    }
    if (record.engine_started) {
        # destroying the engine releases the credential lease it took at the
        # ClientHello, which is what lets a retired generation be reclaimed
        tls_server.destroy(?record.engine);
        record.engine_started = false;
    }
    destroy_scopes(index);
    reset_channel(value, index);
    if (live_count > 0) { live_count = live_count - 1; }
    # release the shared index, compacting both tables' trailing empty chunks
    storage.pair_release[Channel, Session](?paired, index);
    ret true;
}

# --- the byte transport below TLS ---

fun lower_resource(value: *Channel) usize {
    if (value.socket == nil) { ret 0; }
    ret value.socket.handle.value;
}

fun completion_context(value: *Channel) usize {
    ret (?value.context)::usize;
}

fun deliver_staged(value: *Channel, scope: *cancel.Scope, buffer: *u8,
    length: usize) res[io_runtime.Token, io_error.Error] {
    val count: usize = value.staged(value.owner, buffer, length);
    if (count == 0) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.WOULD_BLOCK, io_error.OP_READ)};
    }
    val submitted: res[io_runtime.Token, io_error.Error] = io_runtime.submit_scoped(
        value.driver.runtime, scope,
        io_runtime.Operation{kind: io_runtime.READ, resource: lower_resource(value),
        buffer:  buffer, length: length, offset: 0,
        context: completion_context(value)});
    if (sel submitted.err) { ret submitted; }
    val token: io_runtime.Token = submitted.ok;
    if (!runtime_ok(io_runtime.complete(value.driver.runtime,
        token, count, lower_resource(value), false))) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_READ)};
    }
    ret submitted;
}

fun staged_left(value: *Channel) bool {
    ret value.staged::usize != 0 && value.staged(value.owner, nil, 0) != 0;
}

fun lower_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || value.driver == nil || value.socket == nil) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_READ)};
    }
    if (value.staged::usize != 0 && length != 0) {
        val staged: res[io_runtime.Token, io_error.Error] = deliver_staged(
            value, scope, buffer, length);
        if (sel staged.ok) { ret staged; }
    }
    ret net_async.submit_read(value.driver, scope, value.socket, buffer, length,
        completion_context(value));
}

fun lower_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || value.driver == nil || value.socket == nil) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_WRITE)};
    }
    ret net_async.submit_write(value.driver, scope, value.socket, buffer, length,
        completion_context(value));
}

fun lower_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || value.driver == nil || value.socket == nil) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_SHUTDOWN)};
    }
    ret net_async.submit_shutdown_write(value.driver, scope, value.socket,
        completion_context(value));
}

fun lower_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || value.driver == nil || value.socket == nil) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_CLOSE)};
    }
    # the argument is the close mode, not a cause: the cause constant selected
    # a graceful shutdown-write whose completion the TLS close never accepts
    ret net_async.submit_stream_close(value.driver, scope, value.socket,
        lifecycle.ABORTIVE, completion_context(value));
}

# the state this transport owns is the channel, the socket it submits on, and
# the runtime. an application buffer that aliased any of them would be mutated
# under the engine, so mach-tls asks and this answers honestly.
fun overlaps(base: usize, size: usize, data: *u8, len: usize) bool {
    if (base == 0 || size == 0) { ret false; }
    val start: usize = (data)::usize;
    ret start < base + size && base < start + len;
}

fun lower_aliases(context: ptr, data: *u8, len: usize) bool {
    val value: *Channel = context::*Channel;
    if (value == nil || data == nil || len == 0)                { ret false; }
    if (overlaps((value)::usize, $size_of(Channel), data, len)) { ret true; }
    if (value.socket != nil
        && overlaps((value.socket)::usize, $size_of(tcp.Stream), data, len)) {
        ret true;
    }
    ret value.driver != nil && io_runtime.aliases(value.driver.runtime, data, len);
}

fun lower_transport(value: *Channel) tls_transport.Transport {
    var descriptor: tls_transport.Transport;
    descriptor.runtime         = value.driver.runtime;
    descriptor.context         = (value)::ptr;
    descriptor.context_size    = $size_of(Channel);
    descriptor.aliases_state   = lower_aliases;
    descriptor.submit_read     = lower_read;
    descriptor.submit_write    = lower_write;
    descriptor.submit_shutdown = lower_shutdown;
    descriptor.submit_close    = lower_close;
    descriptor.submit_abort    = lower_close;
    ret descriptor;
}

# --- the secured side of the HTTP transport adapter ---

fun pending_for(value: *Channel, kind: Kind) *Pending {
    if (kind == KIND_READ)     { ret ?value.read; }
    if (kind == KIND_READABLE) { ret ?value.readable; }
    if (kind == KIND_WRITE)    { ret ?value.write; }
    if (kind == KIND_SHUTDOWN) { ret ?value.shutdown; }
    if (kind == KIND_CLOSE)    { ret ?value.close; }
    ret nil;
}

fun logical_kind(kind: Kind) http_transport.Kind {
    if (kind == KIND_READ)     { ret http_transport.READ; }
    if (kind == KIND_READABLE) { ret http_transport.READABLE; }
    if (kind == KIND_WRITE)    { ret http_transport.WRITE; }
    if (kind == KIND_SHUTDOWN) { ret http_transport.SHUTDOWN_WRITE; }
    ret http_transport.CLOSE;
}

fun operation_for(kind: Kind) io_error.Operation {
    if (kind == KIND_READ || kind == KIND_READABLE) { ret io_error.OP_READ; }
    if (kind == KIND_WRITE)                         { ret io_error.OP_WRITE; }
    if (kind == KIND_SHUTDOWN)                      { ret io_error.OP_SHUTDOWN; }
    ret io_error.OP_CLOSE;
}

fun failure_for(kind: Kind, failure: tls_error.Error) io_error.Error {
    if (failure == tls_error.TIMEOUT) {
        ret io_error.make(io_error.TIMEOUT, operation_for(kind));
    }
    if (failure == tls_error.CANCELLED) {
        ret io_error.make(io_error.CANCELLED, operation_for(kind));
    }
    ret io_error.make(io_error.IO, operation_for(kind));
}

fun next_generation(generation: u32) u32 {
    var value: u32 = generation + 1;
    if (value == 0) { value = 1; }
    ret value;
}

# a TLS operation runs under a child of the scope that asked for it, so the
# owner's cancel or timeout reaches the socket operation it is waiting on. an
# operation nobody scoped runs under the session root, itself under the
# connection. each lane's scope lives only while its operation does.
fun renew_scope(index: usize, reading: bool, owner: *cancel.Scope) bool {
    var parent: *cancel.Scope = owner;
    if (parent == nil) { parent = ?session_at(index).root; }
    if (reading) {
        release_read_scope(index);
        if (!operation_ok(cancel.make_child(?session_at(index).read_scope, parent,
            opt[time.Instant].none{}))) { ret false; }
        session_at(index).read_scope_live = true;
        ret true;
    }
    release_write_scope(index);
    if (!operation_ok(cancel.make_child(?session_at(index).write_scope, parent,
        opt[time.Instant].none{}))) { ret false; }
    session_at(index).write_scope_live = true;
    ret true;
}

# queue the connection for its next step
fun notify(value: *Channel) {
    if (!hedge_wake.wake(?value.waker)) { value.wake_failed = true; }
}

fun push_done(value: *Channel, settled: http_transport.Completion) {
    if (value.done_count >= DONE_SLOTS) { ret; }
    value.done[value.done_count] = settled;
    value.done_count             = value.done_count + 1;
}

fun fail_pending(value: *Channel, kind: Kind, failure: tls_error.Error) {
    val slot: *Pending = pending_for(value, kind);
    if (slot == nil || !slot.active) { ret; }
    slot.active = false;
    push_done(value, http_transport.failed(slot.token, logical_kind(kind), 0,
        failure_for(kind, failure)));
}

fun publish(value: *Channel, kind: Kind, snapshot: tls_transport.Snapshot) {
    val slot: *Pending = pending_for(value, kind);
    if (slot == nil || !slot.active) { ret; }
    slot.active = false;
    if (snapshot.terminal_error != tls_error.OK) {
        push_done(value, http_transport.failed(slot.token, logical_kind(kind),
            snapshot.application_bytes, failure_for(kind, snapshot.terminal_error)));
        if (snapshot.terminal_error != tls_error.CANCELLED
            && snapshot.terminal_error != tls_error.TIMEOUT) { value.state = FAILED; }
        ret;
    }
    # a peer that sent close_notify is at end of stream for the engine, which is
    # what lets a request without a length terminate rather than hang
    if (kind == KIND_READ && snapshot.application_bytes == 0
        && (value.peer_closed || value.lower_eof)) {
        push_done(value, http_transport.end(slot.token, 0));
        ret;
    }
    push_done(value, http_transport.completed(slot.token, logical_kind(kind),
        snapshot.application_bytes));
}

fun observe(index: usize) {
    val value: *Channel            = channel_at(index);
    val view:  tls_stream.Snapshot = tls_stream.snapshot(?session_at(index).stream);
    value.peer_closed = view.peer_closed;
    value.lower_eof   = view.state == tls_stream.CLOSED;
    if (view.state == tls_stream.FAILED && value.state == OPEN) { value.state = FAILED; }
}

fun settle_read(index: usize, snapshot: tls_transport.Snapshot) {
    val value: *Channel = channel_at(index);
    if (value.reading == KIND_NONE || snapshot.state != tls_transport.OPERATION_TERMINAL) {
        ret;
    }
    val kind: Kind = value.reading;
    value.reading        = KIND_NONE;
    value.read_cancelled = false;
    tls_stream.destroy_operation(?session_at(index).stream, snapshot.token);
    release_read_scope(index);
    publish(value, kind, snapshot);
}

fun settle_write(index: usize, snapshot: tls_transport.Snapshot) {
    val value: *Channel = channel_at(index);
    if (value.writing == KIND_NONE || snapshot.state != tls_transport.OPERATION_TERMINAL) {
        ret;
    }
    val kind: Kind = value.writing;
    value.writing = KIND_NONE;
    tls_stream.destroy_operation(?session_at(index).stream, snapshot.token);
    release_write_scope(index);
    if (kind == KIND_HANDSHAKE) {
        value.handshake_settled = true;
        value.handshake_error   = snapshot.terminal_error;
        if (snapshot.terminal_error == tls_error.OK) { value.state = OPEN; }
        or                                           { value.state = FAILED; }
        ret;
    }
    publish(value, kind, snapshot);
}

# resolve whichever lanes have finished, publishing their completions
fun settle(index: usize) {
    val value: *Channel = channel_at(index);
    if (value.reading == KIND_NONE && value.writing == KIND_NONE) { ret; }
    val view: tls_stream.Snapshot = tls_stream.snapshot(?session_at(index).stream);
    observe(index);
    settle_read(index, view.read);
    settle_write(index, view.write);
}

# the failure a queued operation settles with when its submitting scope has
# already been cancelled or timed out, or OK while it may still run
fun ended_by_owner(slot: *Pending) tls_error.Error {
    if (slot == nil || slot.scope == nil) { ret tls_error.OK; }
    val observed: cancel.Reason = cancel.reason(slot.scope);
    if (sel observed.cancelled) { ret tls_error.CANCELLED; }
    if (sel observed.timed_out) { ret tls_error.TIMEOUT; }
    ret tls_error.OK;
}

# whether a read would return something without the socket: plaintext or
# ciphertext mach-tls already holds, bytes the prologue read, or the end
fun buffered(index: usize) bool {
    val value:  *Channel           = channel_at(index);
    val stream: *tls_stream.Stream = ?session_at(index).stream;
    ret stream.plaintext_read < stream.plaintext_len
        || stream.wire_input_read < stream.wire_input_len || stream.holding
        || stream.peer_closed || stream.lower_eof || staged_left(value);
}

fun start_read(index: usize) {
    val value: *Channel = channel_at(index);
    val slot:  *Pending = ?value.read;
    if (!renew_scope(index, true, slot.scope)) {
        fail_pending(value, KIND_READ, tls_error.INTERNAL_ERROR);
        ret;
    }
    value.read_generation = next_generation(value.read_generation);
    if (!tls_stream.read(?session_at(index).stream, ?session_at(index).read_scope,
        lane_token(READ_LANE_TOKEN, value.read_generation), slot.buffer, slot.length,
        completion_context(value))) {
        release_read_scope(index);
        fail_pending(value, KIND_READ, tls_error.INTERNAL_ERROR);
        ret;
    }
    value.reading = KIND_READ;
}

# a readable wait holds no buffer. it answers at once when mach-tls or the
# prologue already holds input, and otherwise waits on the socket
fun start_readable(index: usize) {
    val value: *Channel = channel_at(index);
    val slot:  *Pending = ?value.readable;
    if (buffered(index)) {
        slot.active = false;
        if (session_at(index).stream.peer_closed || session_at(index).stream.lower_eof) {
            push_done(value, http_transport.end_of(slot.token, http_transport.READABLE, 0));
        }
        or { push_done(value, http_transport.completed(slot.token, http_transport.READABLE, 0)); }
        ret;
    }
    if (value.readable_waiting) { ret; }
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_readable(
        value.driver, slot.scope, value.socket, completion_context(value));
    if (sel submitted.err) {
        fail_pending(value, KIND_READABLE, tls_error.INTERNAL_ERROR);
        ret;
    }
    value.readable_waiting = true;
}

fun start_write(index: usize, kind: Kind) {
    val value: *Channel = channel_at(index);
    val slot:  *Pending = pending_for(value, kind);
    if (!renew_scope(index, false, slot.scope)) {
        fail_pending(value, kind, tls_error.INTERNAL_ERROR);
        ret;
    }
    value.write_generation = next_generation(value.write_generation);
    val token:   tls_transport.Token = lane_token(WRITE_LANE_TOKEN, value.write_generation);
    val scope:   *cancel.Scope       = ?session_at(index).write_scope;
    val stream:  *tls_stream.Stream  = ?session_at(index).stream;
    var started: bool                = false;
    if (kind == KIND_WRITE) {
        started = tls_stream.write(stream, scope, token, slot.buffer, slot.length,
            completion_context(value));
    }
    or (kind == KIND_SHUTDOWN) {
        started = tls_stream.half_close(stream, scope, token, completion_context(value));
    }
    or { started = tls_stream.close(stream, scope, token, completion_context(value)); }
    if (!started) {
        release_write_scope(index);
        fail_pending(value, kind, tls_error.INTERNAL_ERROR);
        ret;
    }
    value.writing = kind;
}

# the write lane runs what was queued: a close waits for any write or half
# close queued before it, and for the read lane to end
fun next_write(value: *Channel) Kind {
    if (value.write.active)    { ret KIND_WRITE; }
    if (value.shutdown.active) { ret KIND_SHUTDOWN; }
    if (value.close.active)    { ret KIND_CLOSE; }
    ret KIND_NONE;
}

fun settle_ended(value: *Channel, kind: Kind) bool {
    val ended: tls_error.Error = ended_by_owner(pending_for(value, kind));
    if (ended == tls_error.OK) { ret false; }
    fail_pending(value, kind, ended);
    ret true;
}

fun drive_read(index: usize) {
    val value: *Channel = channel_at(index);
    if (value.reading != KIND_NONE) { ret; }
    if (value.read.active) {
        # an operation whose owner already ended it settles without starting,
        # or a closing connection waits forever on a read it will never begin
        if (settle_ended(value, KIND_READ)) { ret; }
        start_read(index);
        ret;
    }
    if (value.readable.active && !value.readable_waiting) {
        if (settle_ended(value, KIND_READABLE)) { ret; }
        start_readable(index);
    }
}

fun drive_write(index: usize) {
    val value: *Channel = channel_at(index);
    if (value.writing != KIND_NONE) { ret; }
    val wanted: Kind = next_write(value);
    if (wanted == KIND_NONE)         { ret; }
    if (settle_ended(value, wanted)) { ret; }
    if (wanted == KIND_CLOSE && value.reading != KIND_NONE) {
        # a close needs the read lane free. the read ends as cancelled with every
        # byte it had received kept, and the close starts once it has settled
        if (!value.read_cancelled
            && transition_ok(cancel.cancel(?session_at(index).read_scope))) {
            value.read_cancelled = true;
        }
        ret;
    }
    start_write(index, wanted);
}

fun fail_all(value: *Channel, failure: tls_error.Error) {
    if (value.reading == KIND_NONE) {
        fail_pending(value, KIND_READ, failure);
        if (!value.readable_waiting) { fail_pending(value, KIND_READABLE, failure); }
    }
    if (value.writing == KIND_NONE) {
        fail_pending(value, KIND_WRITE, failure);
        fail_pending(value, KIND_SHUTDOWN, failure);
        fail_pending(value, KIND_CLOSE, failure);
    }
}

# start whatever each lane should run next, and resolve what has finished.
# true when a completion is ready to take
pub fun drive(index: usize) bool {
    prepare();
    if (!claimed_index(index)) { ret false; }
    val value: *Channel = channel_at(index);
    if (session_at(index).stream_started) { settle(index); }
    if (value.state == FAILED || value.state == CLOSED) {
        # a failed stream may still be closed abortively, which ends a read the
        # engine left outstanding
        if (value.writing == KIND_NONE && value.close.active
            && session_at(index).stream_started && !settle_ended(value, KIND_CLOSE)) {
            start_write(index, KIND_CLOSE);
            settle(index);
        }
        fail_all(value, tls_error.INTERNAL_ERROR);
        ret value.done_count != 0;
    }
    if (value.state == OPEN) {
        drive_read(index);
        drive_write(index);
        settle(index);
    }
    ret value.done_count != 0;
}

fun adapter_submit(value: *Channel, kind: Kind, token: http_transport.Token,
    scope: *cancel.Scope, buffer: *u8, length: usize) res[bool, io_error.Error] {
    if (value == nil || !value.live) {
        ret res[bool, io_error.Error].err{io_error.make(io_error.CLOSED, operation_for(kind))};
    }
    val slot: *Pending = pending_for(value, kind);
    if (slot == nil || slot.active) {
        ret res[bool, io_error.Error].err{io_error.make(io_error.BUSY, operation_for(kind))};
    }
    # a read and a readable wait share the read direction
    if ((kind == KIND_READ && value.readable.active)
        || (kind == KIND_READABLE && value.read.active)) {
        ret res[bool, io_error.Error].err{io_error.make(io_error.BUSY, operation_for(kind))};
    }
    slot.active = true;
    slot.token  = token;
    slot.scope  = scope;
    slot.buffer = buffer;
    slot.length = length;
    # starting is deferred to the connection's own step, so a completion is
    # never published from inside a submission that holds the transport's lock.
    # a step in progress starts it, and otherwise the connection is queued
    if (!value.stepping) { notify(value); }
    ret res[bool, io_error.Error].ok{true};
}

fun adapter_read(context: ptr, token: http_transport.Token, scope: *cancel.Scope,
    buffer: *u8, length: usize) res[bool, io_error.Error] {
    ret adapter_submit(context::*Channel, KIND_READ, token, scope, buffer, length);
}

fun adapter_readable(context: ptr, token: http_transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    ret adapter_submit(context::*Channel, KIND_READABLE, token, scope, nil, 0);
}

fun adapter_write(context: ptr, token: http_transport.Token, scope: *cancel.Scope,
    buffer: *u8, length: usize) res[bool, io_error.Error] {
    ret adapter_submit(context::*Channel, KIND_WRITE, token, scope, buffer, length);
}

fun adapter_shutdown(context: ptr, token: http_transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    ret adapter_submit(context::*Channel, KIND_SHUTDOWN, token, scope, nil, 0);
}

fun adapter_close(context: ptr, token: http_transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    ret adapter_submit(context::*Channel, KIND_CLOSE, token, scope, nil, 0);
}

# the engine drives this adapter exactly as it drives a plaintext one
pub fun adapter(index: usize) http_transport.Adapter {
    prepare();
    var value: http_transport.Adapter;
    value.runtime               = nil;
    value.context               = nil;
    value.security              = http_transport.SECURED;
    value.submit_read           = adapter_read;
    value.submit_readable       = adapter_readable;
    value.submit_write          = adapter_write;
    value.submit_shutdown_write = adapter_shutdown;
    value.submit_close          = adapter_close;
    if (!claimed_index(index) || channel_at(index).driver == nil) { ret value; }
    value.runtime = channel_at(index).driver.runtime;
    value.context = (channel_at(index))::ptr;
    ret value;
}

pub fun channel(index: usize) *Channel {
    prepare();
    if (!claimed_index(index)) { ret nil; }
    ret channel_at(index);
}

# --- lifecycle ---

# bind the socket this session speaks over, the connection that owns the bytes
# the prologue already read, the memory its buffers come from, and who is woken
# when the channel has work. `borrower` and `account` are the connection's, and
# the account must stay open until the session is released
pub fun attach(index: usize, driver: *net_async.Driver, socket: *tcp.Stream,
    owner: ptr, staged: StagedFun, borrower: *memory.Borrower,
    account: *buffers.Account, waker: hedge_wake.Waker) bool {
    prepare();
    if (!claimed_index(index) || driver == nil || socket == nil || borrower == nil
        || account == nil || !account.open || !hedge_wake.valid(?waker)) { ret false; }
    channel_at(index).waker   = waker;
    channel_at(index).driver  = driver;
    channel_at(index).socket  = socket;
    channel_at(index).owner   = owner;
    channel_at(index).staged  = staged;
    channel_at(index).account = account;
    session_at(index).source  = memory.borrowed_source(borrower);
    session_at(index).secrets = memory.borrowed_secret_source(borrower);
    ret true;
}

fun lease(index: usize) tls_buffer.Lease {
    ret tls_buffer.Lease{source: ?session_at(index).source,
        account: channel_at(index).account, lane: memory.LANE_TLS};
}

fun secret_lease(index: usize) tls_buffer.SecretLease {
    ret tls_buffer.SecretLease{source: ?session_at(index).secrets,
        account: channel_at(index).account, lane: memory.LANE_TLS};
}

# `connection` is the scope every operation of this session descends from, and
# `handshake` bounds the handshake. both belong to the caller and must outlive
# the session and its handshake respectively. the policy's clock supplies every
# time the handshake reads
pub fun begin(index: usize, policy: *tls.Policy, connection: *cancel.Scope,
    handshake: *cancel.Scope) bool {
    prepare();
    if (!claimed_index(index) || policy == nil || !policy.live
        || channel_at(index).driver == nil || channel_at(index).account == nil
        || connection == nil || handshake == nil) { ret false; }
    val value: *Channel = channel_at(index);
    value.state                 = IDLE;
    value.reading               = KIND_NONE;
    value.writing               = KIND_NONE;
    value.done_count            = 0;
    value.handshake_settled     = false;
    value.handshake_error       = tls_error.OK;
    session_at(index).transport = lower_transport(value);
    if (!operation_ok(cancel.make_child(?session_at(index).root, connection,
        opt[time.Instant].none{}))) {
        ret false;
    }
    session_at(index).root_live = true;
    var extra: tls_server.ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    if (!tls_server.init_with_credential_selector(?session_at(index).engine,
        ?policy.configuration, lease(index), extra, 0,
        tls.tls_alpn_selector(policy))) {
        destroy_scopes(index);
        ret false;
    }
    session_at(index).engine_started = true;
    if (!renew_scope(index, false, handshake)) {
        tls_server.destroy(?session_at(index).engine);
        session_at(index).engine_started = false;
        destroy_scopes(index);
        ret false;
    }
    value.write_generation = next_generation(value.write_generation);
    if (!tls_stream.serve(?session_at(index).stream, ?session_at(index).engine,
        lease(index), secret_lease(index), ?session_at(index).transport,
        ?session_at(index).write_scope,
        lane_token(WRITE_LANE_TOKEN, value.write_generation),
        completion_context(value))) {
        tls_server.destroy(?session_at(index).engine);
        session_at(index).engine_started = false;
        destroy_scopes(index);
        ret false;
    }
    session_at(index).stream_started = true;
    value.state                      = HANDSHAKING;
    value.writing                    = KIND_HANDSHAKE;
    settle(index);
    ret true;
}

# route one runtime completion into the TLS stream and resolve whatever it
# finished, and queue the connection to take it. a socket readiness wait is this
# channel's own, not the stream's
pub fun accept(index: usize, completion: *io_runtime.Completion) bool {
    prepare();
    if (!claimed_index(index) || !session_at(index).stream_started) { ret false; }
    val value: *Channel = channel_at(index);
    fin { notify(value); }
    if (completion.kind == io_runtime.READABLE) {
        value.readable_waiting = false;
        val slot: *Pending = ?value.readable;
        if (!slot.active) { ret true; }
        slot.active = false;
        if (completion.has_error) {
            push_done(value, http_transport.failed(slot.token, http_transport.READABLE, 0,
                completion.error));
        }
        or (completion.end_of_stream) {
            push_done(value, http_transport.end_of(slot.token, http_transport.READABLE, 0));
        }
        or { push_done(value, http_transport.completed(slot.token, http_transport.READABLE, 0)); }
        ret true;
    }
    if (!tls_stream.accept(?session_at(index).stream, completion)) { ret false; }
    settle(index);
    ret true;
}

# retry a lane parked for memory, when the connection's account is woken. a
# stream with nothing parked ignores it. each retry arrives as a completion for
# `accept`, which queues the connection
pub fun resume(index: usize) bool {
    prepare();
    if (!claimed_index(index) || !session_at(index).stream_started) { ret false; }
    ret tls_stream.resume(?session_at(index).stream);
}

pub fun handshake_settled(index: usize) bool {
    prepare();
    ret claimed_index(index) && channel_at(index).handshake_settled;
}

pub fun handshake_error(index: usize) tls_error.Error {
    prepare();
    if (!claimed_index(index)) { ret tls_error.INTERNAL_ERROR; }
    ret channel_at(index).handshake_error;
}

pub fun negotiated(index: usize) tls_engine.Snapshot {
    prepare();
    if (!claimed_index(index) || !session_at(index).stream_started) {
        ret tls_engine.empty_snapshot();
    }
    ret tls_stream.negotiated(?session_at(index).stream);
}

pub fun open(index: usize) bool {
    prepare();
    ret claimed_index(index) && channel_at(index).state == OPEN;
}

# whether both lanes have settled, which is when the session may be released
pub fun idle(index: usize) bool {
    prepare();
    if (!claimed_index(index)) { ret true; }
    val value: *Channel = channel_at(index);
    ret value.reading == KIND_NONE && value.writing == KIND_NONE && !value.readable_waiting;
}

# collect one completion this session has published, oldest first
pub fun take(index: usize, settled: *http_transport.Completion) bool {
    prepare();
    if (!claimed_index(index) || settled == nil) { ret false; }
    val value: *Channel = channel_at(index);
    if (value.done_count == 0) { ret false; }
    @settled = value.done[0];
    if (value.done_count == 2) { value.done[0] = value.done[1]; }
    value.done_count = value.done_count - 1;
    ret true;
}

# the connection steps: what the engine submits meanwhile is started by the step
pub fun begin_step(index: usize) {
    prepare();
    if (!claimed_index(index)) { ret; }
    channel_at(index).stepping = true;
}

# the step is over. an operation it left queued behind a free lane has nothing
# else to start it, so the connection is queued for it
pub fun end_step(index: usize) {
    prepare();
    if (!claimed_index(index)) { ret; }
    val value: *Channel = channel_at(index);
    value.stepping = false;
    if (startable(value)) { notify(value); }
}

# an operation queued behind a lane that is free to start it
fun startable(value: *Channel) bool {
    if (value.state != OPEN && value.state != FAILED && value.state != CLOSED) {
        ret false;
    }
    if (value.reading == KIND_NONE
        && (value.read.active || (value.readable.active && !value.readable_waiting))) {
        ret true;
    }
    if (value.writing != KIND_NONE) { ret false; }
    val wanted: Kind = next_write(value);
    if (wanted == KIND_NONE) { ret false; }
    # an open session's close waits for the read it has already cancelled
    ret value.state != OPEN || wanted != KIND_CLOSE
        || value.reading == KIND_NONE || !value.read_cancelled;
}

# whether the connection's next step would find work here: a completion
# published and not yet taken, a lane the stream finished that nobody settled,
# an operation queued behind a lane that is free to start it (#182), or a wake
# that could not be queued
pub fun pending_work(index: usize) bool {
    prepare();
    if (!claimed_index(index)) { ret false; }
    val value: *Channel = channel_at(index);
    if (value.done_count != 0 || value.wake_failed) { ret true; }
    if (session_at(index).stream_started
        && (value.reading != KIND_NONE || value.writing != KIND_NONE)) {
        val view: tls_stream.Snapshot = tls_stream.snapshot(?session_at(index).stream);
        if (value.reading != KIND_NONE
            && view.read.state == tls_transport.OPERATION_TERMINAL) { ret true; }
        if (value.writing != KIND_NONE
            && view.write.state == tls_transport.OPERATION_TERMINAL) { ret true; }
    }
    ret startable(value);
}

pub rec Snapshot {
    state:             State;
    reading:           Kind;
    writing:           Kind;
    read_queued:       bool;
    write_queued:      bool;
    ready:             bool;
    handshake_settled: bool;
    handshake_error:   tls_error.Error;
}

pub fun snapshot(index: usize) Snapshot {
    prepare();
    var value: Snapshot;
    if (!claimed_index(index)) {
        value.state             = CLOSED;
        value.reading           = KIND_NONE;
        value.writing           = KIND_NONE;
        value.read_queued       = false;
        value.write_queued      = false;
        value.ready             = false;
        value.handshake_settled = false;
        value.handshake_error   = tls_error.INTERNAL_ERROR;
        ret value;
    }
    val entry: *Channel = channel_at(index);
    value.state             = entry.state;
    value.reading           = entry.reading;
    value.writing           = entry.writing;
    value.read_queued       = entry.read.active || entry.readable.active;
    value.write_queued      = entry.write.active || entry.shutdown.active || entry.close.active;
    value.ready             = entry.done_count != 0;
    value.handshake_settled = entry.handshake_settled;
    value.handshake_error   = entry.handshake_error;
    ret value;
}

test "secure: the write lane keeps the order its operations were queued in" {
    val index: usize = acquire();
    if (index == NO_SESSION) { ret 1; }
    val entry: *Channel = channel_at(index);
    entry.close.active    = true;
    entry.shutdown.active = true;
    entry.write.active    = true;
    # a response goes out before the half close and the close behind it
    if (next_write(entry) != KIND_WRITE) {
        release(index);
        ret 2;
    }
    entry.write.active = false;
    if (next_write(entry) != KIND_SHUTDOWN) {
        release(index);
        ret 3;
    }
    entry.shutdown.active = false;
    if (next_write(entry) != KIND_CLOSE) {
        release(index);
        ret 4;
    }
    entry.close.active = false;
    if (next_write(entry) != KIND_NONE) {
        release(index);
        ret 5;
    }
    release(index);
    ret 0;
}

# what the worker's debug audit asks of a session (#182): work is a completion
# not taken, or a queued operation whose lane is free to start it
fun pending_case(index: usize) i32 {
    val entry: *Channel = channel_at(index);
    if (pending_work(index)) { ret 1; }
    entry.state = OPEN;
    if (pending_work(index)) { ret 2; }
    # a write queued behind a free lane, then the same write running
    entry.write.active = true;
    if (!pending_work(index)) { ret 3; }
    entry.writing = KIND_WRITE;
    if (pending_work(index)) { ret 4; }
    entry.writing      = KIND_NONE;
    entry.write.active = false;
    # a read queued behind a free lane, and a readiness wait already submitted
    entry.read.active = true;
    if (!pending_work(index)) { ret 5; }
    entry.read.active      = false;
    entry.readable.active  = true;
    entry.readable_waiting = true;
    if (pending_work(index)) { ret 6; }
    entry.readable_waiting = false;
    entry.readable.active  = false;
    # a close waiting on the read it already cancelled
    entry.close.active   = true;
    entry.reading        = KIND_READ;
    entry.read_cancelled = true;
    if (pending_work(index)) { ret 7; }
    entry.read_cancelled = false;
    if (!pending_work(index)) { ret 8; }
    entry.close.active = false;
    entry.reading      = KIND_NONE;
    # a completion published and not taken
    entry.done_count = 1;
    if (!pending_work(index)) { ret 9; }
    entry.done_count = 0;
    entry.state      = IDLE;
    ret 0;
}

test "secure: pending work is a completion not taken or an operation a free lane can start" {
    val index: usize = acquire();
    if (index == NO_SESSION) { ret 1; }
    val code: i32 = pending_case(index);
    release(index);
    ret code;
}

# a submission outside a step queues the connection at once. inside one, the
# step starts it, and `end_step` queues the connection only for an operation
# the step left queued behind a free lane (#195)
fun submit_case(index: usize, wakes: *hedge_wake.Queue) i32 {
    val entry:   *Channel = channel_at(index);
    val context: ptr      = (entry)::ptr;
    var owners:  [4]u64;
    entry.state = OPEN;
    entry.waker = hedge_wake.waker(wakes, 31);
    val read: res[bool, io_error.Error] = adapter_read(context,
        http_transport.Token{index: 0, generation: 1}, nil, nil, 0);
    if ((sel read.err) || hedge_wake.take(wakes, ?owners[0], 4) != 1 || owners[0] != 31) {
        ret 1;
    }
    # the read is running, and a step submits a write it then starts
    entry.reading = KIND_READ;
    begin_step(index);
    val write: res[bool, io_error.Error] = adapter_write(context,
        http_transport.Token{index: 1, generation: 1}, nil, nil, 0);
    if ((sel write.err) || hedge_wake.pending(wakes)) { ret 2; }
    entry.writing = KIND_WRITE;
    end_step(index);
    if (hedge_wake.pending(wakes)) { ret 3; }
    # a half close queued behind the running write waits for its completion,
    # which queues the connection through `accept`
    begin_step(index);
    val shut: res[bool, io_error.Error] = adapter_shutdown(context,
        http_transport.Token{index: 1, generation: 2}, nil);
    end_step(index);
    if ((sel shut.err) || hedge_wake.pending(wakes)) { ret 4; }
    # a step that ends with the write lane free and the half close not started
    # leaves it to the next step
    entry.writing      = KIND_NONE;
    entry.write.active = false;
    begin_step(index);
    end_step(index);
    if (hedge_wake.take(wakes, ?owners[0], 4) != 1 || owners[0] != 31) { ret 5; }
    # a wake that cannot be queued is work the audit reports
    entry.shutdown.active = false;
    entry.read.active     = false;
    entry.reading         = KIND_NONE;
    if (pending_work(index)) { ret 6; }
    entry.waker = hedge_wake.no_waker();
    notify(entry);
    if (!entry.wake_failed || !pending_work(index)) { ret 7; }
    ret 0;
}

test "secure: the channel queues its connection for what the engine submits" {
    var pages: A.Allocator;
    page.make(?pages);
    var wakes: hedge_wake.Queue;
    if (!hedge_wake.make(?wakes, ?pages)) { ret 90; }
    val index: usize = acquire();
    if (index == NO_SESSION) { ret 91; }
    val code: i32 = submit_case(index, ?wakes);
    release(index);
    hedge_wake.destroy(?wakes);
    ret code;
}

# mach-tls keeps a stream open when a write is cancelled between records, so
# the cancellation is the engine's to see and the channel serves on (#195)
test "secure: a write cancelled between records leaves the channel open" {
    val index: usize = acquire();
    if (index == NO_SESSION) { ret 1; }
    val entry: *Channel = channel_at(index);
    entry.state        = OPEN;
    entry.write.active = true;
    entry.write.token  = http_transport.Token{index: 1, generation: 4};
    var cancelled: tls_transport.Snapshot;
    cancelled.state             = tls_transport.OPERATION_TERMINAL;
    cancelled.application_bytes = 0;
    cancelled.terminal_error    = tls_error.CANCELLED;
    publish(entry, KIND_WRITE, cancelled);
    var settled: http_transport.Completion;
    if (!take(index, ?settled) || settled.status != http_transport.IO_CANCELLED
        || settled.token.generation != 4) {
        release(index);
        ret 2;
    }
    if (entry.state != OPEN) {
        release(index);
        ret 3;
    }
    # the next write the engine queues is one the free lane starts
    entry.write.active = true;
    if (!startable(entry)) {
        release(index);
        ret 4;
    }
    entry.write.active = false;
    release(index);
    ret 0;
}

test "secure: an operation the engine did not submit is refused" {
    val index: usize = acquire();
    if (index == NO_SESSION) { ret 1; }
    channel_at(index).state = OPEN;
    val context:  ptr                       = (channel_at(index))::ptr;
    val accepted: res[bool, io_error.Error] = adapter_read(context,
        http_transport.Token{index: 0, generation: 1}, nil, nil, 0);
    if (sel accepted.err) {
        release(index);
        ret 2;
    }
    # a second read while the first is outstanding is busy, not silently merged
    val second: res[bool, io_error.Error] = adapter_read(context,
        http_transport.Token{index: 0, generation: 2}, nil, nil, 0);
    if (sel second.ok) {
        release(index);
        ret 3;
    }
    # a readable wait shares the read direction with it
    val waiting: res[bool, io_error.Error] = adapter_readable(context,
        http_transport.Token{index: 0, generation: 3}, nil);
    if (sel waiting.ok) {
        release(index);
        ret 4;
    }
    # a write runs in the other lane, so it is taken beside the read
    val writing: res[bool, io_error.Error] = adapter_write(context,
        http_transport.Token{index: 1, generation: 1}, nil, nil, 0);
    if (sel writing.err) {
        release(index);
        ret 5;
    }
    # and a session that is not live accepts nothing at all
    channel_at(index).live = false;
    val dead: res[bool, io_error.Error] = adapter_shutdown(context,
        http_transport.Token{index: 1, generation: 2}, nil);
    channel_at(index).live = true;
    if (sel dead.ok) {
        release(index);
        ret 6;
    }
    release(index);
    ret 0;
}

test "secure: a failed session settles every queued operation rather than hanging" {
    val index: usize = acquire();
    if (index == NO_SESSION) { ret 1; }
    val entry: *Channel = channel_at(index);
    entry.state        = FAILED;
    entry.read.active  = true;
    entry.read.token   = http_transport.Token{index: 0, generation: 7};
    entry.write.active = true;
    entry.write.token  = http_transport.Token{index: 1, generation: 8};
    if (!drive(index)) {
        release(index);
        ret 2;
    }
    var first:  http_transport.Completion;
    var second: http_transport.Completion;
    if (!take(index, ?first) || !take(index, ?second)) {
        release(index);
        ret 3;
    }
    if (first.status != http_transport.IO_ERROR || second.status != http_transport.IO_ERROR) {
        release(index);
        ret 4;
    }
    if (first.kind != http_transport.READ || first.token.generation != 7
        || second.kind != http_transport.WRITE || second.token.generation != 8) {
        release(index);
        ret 5;
    }
    # each completion is published exactly once
    if (take(index, ?first)) {
        release(index);
        ret 6;
    }
    release(index);
    ret 0;
}

test "secure: sessions grow past any fixed table and never move" {
    val before: usize = live();
    val first:  usize = acquire();
    if (first == NO_SESSION) { ret 1; }
    val anchor: *Channel = channel_at(first);
    # far past the sixty-four sessions the table used to hold
    var held: [200]usize;
    var i:    usize = 0;
    for (i < 200) {
        held[i] = acquire();
        if (held[i] == NO_SESSION || held[i] == first) { ret 2; }
        i = i + 1;
    }
    if (live() != before + 201)                                               { ret 3; }
    if (channel_at(first) != anchor || !anchor.live || anchor.index != first) { ret 4; }
    if (!release(held[150]) || live() != before + 200)                        { ret 5; }
    # the released index is the one handed out next, so the tables do not drift
    val reused: usize = acquire();
    if (reused != held[150]) { ret 6; }
    i = 0;
    for (i < 200) {
        if (!release(held[i])) { ret 7; }
        i = i + 1;
    }
    if (!release(first) || live() != before)   { ret 8; }
    if (release(NO_SESSION) || release(first)) { ret 9; }
    ret 0;
}

test "secure: channel and session share one index space in lockstep" {
    val before: usize = live();
    var held:   [40]usize;
    var i:      usize = 0;
    for (i < 40) {
        held[i] = acquire();
        # one claim on the shared slab grows both storages, so the plain channel
        # and the welded session both resolve at the same index
        if (held[i] == NO_SESSION || channel_at(held[i]) == nil
            || session_at(held[i]) == nil) { ret 1; }
        i = i + 1;
    }
    # the shared slab covers every claimed index for both storages
    if (storage.pair_capacity[Channel, Session](?paired) <= held[39]) { ret 2; }
    i = 0;
    for (i < 40) {
        if (!release(held[i])) { ret 3; }
        i = i + 1;
    }
    if (live() != before) { ret 4; }
    ret 0;
}
