# the TLS listener runtime: one credential generation per configured policy
#
# a policy names certificate and key files; this loads them once, publishes them
# with every managed certificate installed into the listener as one immutable
# mach-tls credential generation, and holds the listener configuration every
# connection on that listener borrows. nothing here is
# per-connection: the generation is shared, and a connection pins it with a
# lease for exactly as long as it lives.
#
# every field the configuration points at lives inside the policy record, so the
# borrowed ALPN list, version list, suite list and entropy source outlive every
# connection that reads them.

use crypto.contracts;
use crypto.encoding.keys;
use crypto.secret;
use hedge.acme.challenge;
use acme_keys: hedge.acme.keys;
use acme:      hedge.acme.manager;
use hedge.clock;
use hedge.config.schema;
use hedge.memory;
use hedge_credentials: hedge.protocol.credentials;
use hedge.secret_file;
use std.chrono.time;
use std.filesystem;
use io_error: std.io.error;
use std.io.file;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls_clock:  tls.clock;
use tls_config: tls.config;
use tls_server: tls.server;
use tls.session;
use tls.tls13;

#[testing]
fun present(outcome: res[bool, io_error.Error]) bool {
    ret (sel outcome.ok) && outcome.ok;
}

#[testing]
fun fs_ok(outcome: err[filesystem.FsError]) bool {
    ret sel outcome.ok;
}

pub val MAX_IDENTITIES: usize = schema.MAX_TLS_IDENTITIES;
pub val MAX_CHAIN:      usize = 4;
pub val MAX_ANCHORS:    usize = 4;
# one PEM chain file, and the DER it decodes to
pub val MAX_PEM_BYTES:  usize = 8192;
pub val MAX_KEY_BYTES:  usize = 4096;
pub val MAX_ALPN:       usize = 3;
pub val MAX_ALPN_BYTES: usize = 10;

pub def Status: u8;
pub val OK:      Status = 1;
pub val INVALID: Status = 2;
# a certificate or key file could not be read
pub val UNREADABLE: Status = 3;
# a file was read and is not a certificate chain or a private key
pub val UNDECODABLE: Status = 4;
# the policy is well formed and mach-tls refuses the listener configuration
pub val UNSUPPORTED: Status = 5;
pub val EXHAUSTED:   Status = 6;
# a replacement arrived while the previously retired generation still has a live
# lease, so there is no bank free to build the new one in
pub val RETIRED_IN_USE: Status = 7;
# a private key file group or other can read
pub val EXPOSED: Status = 8;

# the largest handshake messages a listener takes and sends. their buffers come
# from the connection's TLS lane, so a configuration whose flight cannot fit
# that lane fails at load rather than at the first handshake
pub val HANDSHAKE_INPUT_BYTES:  usize = 16384;
pub val HANDSHAKE_OUTPUT_BYTES: usize = 16384;
pub val HELLO_BYTES:            usize = 8192;

pub fun listener_limits() tls_config.Limits {
    var limits: tls_config.Limits = tls_config.production_limits();
    limits.max_peer_handshake_bytes = HANDSHAKE_INPUT_BYTES;
    limits.max_client_hello_bytes   = HELLO_BYTES;
    limits.max_client_flight_bytes  = HANDSHAKE_INPUT_BYTES;
    limits.max_server_flight_bytes  = HANDSHAKE_OUTPUT_BYTES;
    limits.max_chain_bytes          = MAX_PEM_BYTES;
    limits.max_ticket_bytes         = 4096;
    ret limits;
}

rec Identity {
    der:          [MAX_PEM_BYTES]u8;
    certificates: [MAX_CHAIN]cert.Certificate;
    chain_len:    usize;
    private_key:  keys.PrivateKey;
    name:         [schema.TEXT_CAP]u8;
    name_len:     usize;
    live:         bool;
}

# two banks, so a replacement is built while the current one is still leased
#
# a retired generation stays readable until its last connection closes, which
# means its certificates and keys must stay where they are. One bank cannot hold
# both, so the policy holds two and alternates. Two is enough for the real
# workload — a renewal every sixty days against connections that live for
# seconds — and a replacement that arrives while the previous retired generation
# is still leased is refused rather than allowed to overwrite it.
pub val BANKS: usize = 2;

# the managed certificates the TLS layer holds, one per configured certificate
pub val MAX_MANAGED: usize = schema.MAX_ACME_CERTIFICATES;
# what one generation can publish: every configured identity and every name of
# every managed certificate
pub val MAX_PUBLISHED: usize = MAX_IDENTITIES + MAX_MANAGED * schema.MAX_ACME_NAMES;
# the tls-alpn-01 presentations one listener holds at once, one per managed
# certificate that could validate through it
pub val MAX_CHALLENGES: usize = schema.MAX_ACME_CERTIFICATES;
pub val NO_CHALLENGE:   usize = MAX_CHALLENGES;
# the largest rfc 8737 certificate a presentation carries
pub val CHALLENGE_BYTES: usize = challenge.ALPN_CERTIFICATE_BYTES;

# one issuance of a managed certificate: its chain, its key, and the names it
# is published under. every name shares the one chain and key
rec Issued {
    der:          [MAX_PEM_BYTES]u8;
    certificates: [MAX_CHAIN]cert.Certificate;
    chain_len:    usize;
    private_key:  keys.PrivateKey;
    names:        [schema.MAX_ACME_NAMES][schema.TEXT_CAP]u8;
    name_lens:    [schema.MAX_ACME_NAMES]usize;
    name_count:   usize;
    live:         bool;
}

# a managed certificate as the TLS layer holds it. it belongs to one policy for
# the life of the process, and alternates between two issuances so a renewal is
# built while connections still hold the one it replaces
rec Managed {
    policy:    usize;
    issued:    [BANKS]Issued;
    current:   usize;
    installed: bool;
}

# one tls-alpn-01 presentation slot, claimed by the one certificate that
# presents through it
rec Challenge {
    der:         [CHALLENGE_BYTES]u8;
    certificate: cert.Certificate;
    key:         keys.PrivateKey;
    name:        [schema.TEXT_CAP]u8;
    name_len:    usize;
    identity:    credentials.Identity;
    generation:  credentials.Generation;
    claimed:     bool;
    live:        bool;
    retiring:    bool;
}

pub rec Policy {
    name:     [schema.TEXT_CAP]u8;
    name_len: usize;
    # the configured identities, loaded once and served by every generation
    # except under a name a managed certificate has taken over
    identities:     [MAX_IDENTITIES]Identity;
    identity_count: usize;
    # the configured default identity's name, resolved in every generation
    default_name:     [schema.TEXT_CAP]u8;
    default_name_len: usize;
    has_default:      bool;
    published_counts: [BANKS]usize;
    published:        [BANKS][MAX_PUBLISHED]credentials.Identity;
    generations:      [BANKS]credentials.Generation;
    # whether that bank's generation was ever published, which `reclaimable`
    # cannot tell us: it reports false for a generation that was never published
    # and for one still leased alike
    generation_live: [BANKS]bool;
    active:          usize;
    bindings:        hedge_credentials.Bindings;
    challenges:      [MAX_CHALLENGES]Challenge;
    # beside the slots rather than in them, so the selector walks them as one
    # array from the one store pointer it is handed
    challenge_stores:            [MAX_CHALLENGES]credentials.Store;
    challenge_enabled:           bool;
    anchor_der:                  [MAX_PEM_BYTES]u8;
    anchor_certificates:         [MAX_ANCHORS]cert.Certificate;
    client_trust:                cert.TrustStore;
    require_client_auth:         bool;
    alpn_storage:                [MAX_ALPN][MAX_ALPN_BYTES]u8;
    alpn:                        [MAX_ALPN]tls_config.ProtocolName;
    alpn_len:                    usize;
    require_alpn:                bool;
    versions:                    [1]u16;
    suites:                      [3]tls13.CipherSuite;
    groups:                      [2]tls13.NamedGroup;
    signatures:                  [4]tls13.SignatureScheme;
    entropy:                     secret.Entropy;
    clock:                       tls_clock.Source;
    ticket_ring:                 session.KeyRing;
    replay_window:               session.ReplayWindow;
    ticket_key_lifetime_seconds: u32;
    # when the ticket key is next due, in monotonic nanoseconds. every worker
    # handshaking under the policy reads it, and one claims each rotation
    ticket_rotate_ns:       i64;
    ticket_replay_policy:   session.ReplayPolicy;
    tickets_per_connection: u8;
    tickets_live:           bool;
    replay_live:            bool;
    configuration:          tls_config.ServerConfig;
    live:                   bool;
}

# a policy is secret-welded through its credential store and private keys, so no
# public record may hold a pointer to one. they live in one bounded table and are
# named by index, exactly as TLS sessions are.
pub val MAX_POLICIES: usize = schema.MAX_TLS_POLICIES;
pub val NO_POLICY:    usize = MAX_POLICIES;

var policies:     [MAX_POLICIES]Policy;
var policy_count: usize;
# every managed certificate, by its configured index
var managed: [MAX_MANAGED]Managed;
# a parsed private key stores a *pointer* to the allocator that owns its secret
# memory and calls back through it when destroyed, so the allocator must outlive
# every key. A stack local in the function that loads them does not: it leaves
# each key holding a dangling pointer, and destroying one then calls a function
# pointer read from a dead frame. This lives beside the table the keys do.
var identity_owner: secret.Allocator;
var scratch:        [MAX_PEM_BYTES]u8;

fun clear_challenge(slot: *Challenge) {
    slot.claimed  = false;
    slot.live     = false;
    slot.retiring = false;
    slot.name_len = 0;
}

pub fun reset() {
    destroy();
    var i: usize = 0;
    for (i < MAX_POLICIES) {
        policies[i].live                = false;
        policies[i].identity_count      = 0;
        policies[i].published_counts[0] = 0;
        policies[i].published_counts[1] = 0;
        policies[i].generation_live[0]  = false;
        policies[i].generation_live[1]  = false;
        policies[i].challenge_enabled   = false;
        var j: usize = 0;
        for (j < MAX_CHALLENGES) {
            clear_challenge(?policies[i].challenges[j]);
            j = j + 1;
        }
        policies[i].active           = 0;
        policies[i].name_len         = 0;
        policies[i].tickets_live     = false;
        policies[i].replay_live      = false;
        policies[i].ticket_rotate_ns = 0;
        i                            = i + 1;
    }
    i = 0;
    for (i < MAX_MANAGED) {
        managed[i].installed      = false;
        managed[i].policy         = NO_POLICY;
        managed[i].issued[0].live = false;
        managed[i].issued[1].live = false;
        i                         = i + 1;
    }
    policy_count   = 0;
    identity_owner = secret.system_allocator();
}

pub fun count() usize {
    ret policy_count;
}

pub fun policy_at(index: usize) *Policy {
    if (index >= policy_count || !policies[index].live) { ret nil; }
    ret ?policies[index];
}

# the monotonic nanosecond a ticket key minted at `now` falls due
fun rotation_after(now: time.Instant, lifetime_seconds: u32) i64 {
    val due: u64 = clock.after_ns(clock.to_ns(now), lifetime_seconds::u64 * 1000000000);
    if (due > 0x7fffffffffffffff) { ret 0x7fffffffffffffff; }
    ret due::i64;
}

# rotate the ticket key when it is due, before a handshake uses the ring. the
# rotation schedule is an interval, so it runs on the monotonic clock, and the
# ring takes both readings of one moment.
#
# every worker handshakes under the same policy, so the due time is claimed by
# compare and swap: the one handshake that moves it rotates, and the others
# carry on with the ring as it stands, whose current key still opens
# ---
# index: the policy a connection is about to handshake under
# ret:   false when the policy is gone, the clocks cannot be read, or a new key
#        cannot be minted
pub fun prepare(index: usize) bool {
    val policy: *Policy = policy_at(index);
    if (policy == nil)        { ret false; }
    if (!policy.tickets_live) { ret true; }
    var moment: tls_clock.Moment;
    if (!tls_clock.read(?policy.clock, ?moment)) { ret false; }
    var due: i64 = atomic.load(?policy.ticket_rotate_ns);
    if (clock.to_ns(moment.monotonic) < due::u64) { ret true; }
    val claimed: i64 = due;
    if (!atomic.cas(?policy.ticket_rotate_ns, ?due,
        rotation_after(moment.monotonic, policy.ticket_key_lifetime_seconds))) {
        ret true;
    }
    if (!session.keyring_rotate(?policy.ticket_ring, ?policy.entropy, moment)) {
        # the claim is handed back, so the next handshake tries again
        atomic.store(?policy.ticket_rotate_ns, claimed);
        ret false;
    }
    ret true;
}

pub fun find(name: str) usize {
    if (name == nil) { ret NO_POLICY; }
    val length: usize = str_len(name);
    var i:      usize = 0;
    for (i < policy_count) {
        val policy: *Policy = ?policies[i];
        if (policy.live && policy.name_len == length) {
            var j: usize = 0;
            for (j < length && policy.name[j] == name[j]) { j = j + 1; }
            if (j == length) { ret i; }
        }
        i = i + 1;
    }
    ret NO_POLICY;
}

fun copy_name(output: *u8, length: *usize, value: str) bool {
    val n: usize = str_len(value);
    if (n >= schema.TEXT_CAP) { ret false; }
    var i: usize = 0;
    for (i < n) {
        output[i] = value[i];
        i         = i + 1;
    }
    output[n] = 0;
    @length   = n;
    ret true;
}

fun copy_view_name(output: *u8, length: *usize, value: view.View) bool {
    if (value.data == nil || value.len >= schema.TEXT_CAP) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        output[i] = value.data[i];
        i         = i + 1;
    }
    output[value.len] = 0;
    @length           = value.len;
    ret true;
}

fun read_file(path: str, buffer: *u8, capacity: usize, length: *usize) bool {
    if (path == nil || path[0] == 0) { ret false; }
    val opened: res[filesystem.File, io_error.Error] = filesystem.open(path);
    if (sel opened.err) { ret false; }
    var handle: filesystem.File            = opened.ok;
    val read:   res[usize, io_error.Error] = file.read_at(handle, buffer, capacity, 0);
    filesystem.close(?handle);
    if (sel read.err) { ret false; }
    @length = read.ok;
    # a file that exactly fills the buffer may have been truncated, and a
    # truncated chain would be published as if it were the whole one
    ret @length != 0 && @length < capacity;
}

# the private key file the last failed publish could not load
var refused_key_path: str = nil;

# the private key file the last failed publish could not load, nil when a
# publish failed before any key or on something else
pub fun refused_key() str {
    ret refused_key_path;
}

# the key file is read straight into secret storage and parsed from there, so
# no key byte is ever public. one group or other can read is refused
# (hedge.secret_file), and the read storage is wiped when it is released
fun load_key(path: str, owner: *secret.Allocator,
    output: *keys.PrivateKey) Status {
    var bytes: filesystem.SecretBytes;
    val read:  secret_file.Status = secret_file.read(path, MAX_KEY_BYTES + 1, ?bytes);
    if (read == secret_file.EXPOSED)   { ret EXPOSED; }
    if (read == secret_file.TOO_LARGE) { ret UNDECODABLE; }
    if (read != secret_file.OK)        { ret UNREADABLE; }
    var status: Status = UNREADABLE;
    if (bytes.size != 0) {
        status = UNDECODABLE;
        if (load.private_pem(contracts.SecretBytes{data: bytes.data, len: bytes.size},
            owner, output) == contracts.OK) { status = OK; }
    }
    secret_file.release(?bytes);
    ret status;
}

#[oblivious]
fun wipe(buffer: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        buffer[i] = 0;
        i         = i + 1;
    }
}

fun load_identity(policy: *Policy, configured: *schema.TlsIdentity,
    owner: *secret.Allocator) Status {
    if (policy.identity_count >= MAX_IDENTITIES) { ret EXHAUSTED; }
    val identity: *Identity = ?policy.identities[policy.identity_count];
    identity.live = false;
    if (!copy_name(?identity.name[0], ?identity.name_len,
        schema.text(?configured.server_name))) { ret INVALID; }
    var pem_length: usize = 0;
    if (!read_file(schema.text(?configured.certificate), ?scratch[0],
        MAX_PEM_BYTES, ?pem_length)) { ret UNREADABLE; }
    var chain:   cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?scratch[0], len: pem_length},
        contracts.Buffer{data: ?identity.der[0], capacity: MAX_PEM_BYTES},
        ?identity.certificates[0], MAX_CHAIN, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret UNDECODABLE; }
    identity.private_key = keys.empty_private();
    val loaded: Status = load_key(schema.text(?configured.key), owner,
        ?identity.private_key);
    if (loaded != OK) {
        refused_key_path = schema.text(?configured.key);
        ret loaded;
    }
    identity.chain_len    = chain.len;
    identity.live         = true;
    policy.identity_count = policy.identity_count + 1;
    ret OK;
}

fun load_anchor(policy: *Policy, path: str) Status {
    var pem_length: usize = 0;
    if (!read_file(path, ?scratch[0], MAX_PEM_BYTES, ?pem_length)) {
        ret UNREADABLE;
    }
    var chain:   cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?scratch[0], len: pem_length},
        contracts.Buffer{data: ?policy.anchor_der[0], capacity: MAX_PEM_BYTES},
        ?policy.anchor_certificates[0], MAX_ANCHORS, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret UNDECODABLE; }
    policy.client_trust.anchors = chain.certificates;
    policy.client_trust.len     = chain.len;
    ret OK;
}

fun offer_protocol(policy: *Policy, value: str) {
    if (policy.alpn_len >= MAX_ALPN) { ret; }
    val slot:   usize = policy.alpn_len;
    val length: usize = str_len(value);
    if (length == 0 || length > MAX_ALPN_BYTES) { ret; }
    var i: usize = 0;
    for (i < length) {
        policy.alpn_storage[slot][i] = value[i];
        i                            = i + 1;
    }
    policy.alpn[slot] = tls_config.ProtocolName{
        data: ?policy.alpn_storage[slot][0], len: length
    };
    policy.alpn_len = slot + 1;
}

pub rec PublishOptions {
    tls_alpn_challenge: bool;
}

pub fun publish_options() PublishOptions {
    ret PublishOptions{tls_alpn_challenge: false};
}

# the listener's preference order, not the client's. mach-tls walks this list in
# order, so putting h2 first is what makes a client offering both get h2.
fun offer_protocols(policy: *Policy, protocols: u8) {
    policy.alpn_len = 0;
    # parenthesised: `!=` binds tighter than `&`. see briar-systems/laurel#32.
    if ((protocols & schema.PROTOCOL_HTTP3) != 0) { offer_protocol(policy, "h3"); }
    if ((protocols & schema.PROTOCOL_HTTP2) != 0) { offer_protocol(policy, "h2"); }
    if ((protocols & schema.PROTOCOL_HTTP1) != 0) {
        offer_protocol(policy, "http/1.1");
    }
}

# server names compare as dns names do: ascii case folded, and a trailing dot
# ignored
fun same_name(first: contracts.Bytes, second: contracts.Bytes) bool {
    var first_len:  usize = first.len;
    var second_len: usize = second.len;
    if (first_len > 0 && first.data[first_len - 1] == '.')    { first_len = first_len - 1; }
    if (second_len > 0 && second.data[second_len - 1] == '.') { second_len = second_len - 1; }
    if (first_len != second_len)                              { ret false; }
    var i: usize = 0;
    for (i < first_len) {
        var left:  u8 = first.data[i];
        var right: u8 = second.data[i];
        if (left >= 'A' && left <= 'Z')   { left = left + ('a' - 'A'); }
        if (right >= 'A' && right <= 'Z') { right = right + ('a' - 'A'); }
        if (left != right)                { ret false; }
        i = i + 1;
    }
    ret true;
}

# the published identity the configured default names in `bank`, which may be
# a managed certificate that took the name over, or none
fun default_index(policy: *Policy, bank: usize) usize {
    if (!policy.has_default) { ret credentials.NO_DEFAULT; }
    val wanted: contracts.Bytes = contracts.Bytes{data: ?policy.default_name[0],
        len: policy.default_name_len};
    var i: usize = 0;
    for (i < policy.published_counts[bank]) {
        val name: contracts.Bytes = policy.published[bank][i].server_name;
        if ((wanted.len == 0 && name.len == 0)
            || (wanted.len != 0 && name.len != 0 && same_name(name, wanted))) { ret i; }
        i = i + 1;
    }
    ret credentials.NO_DEFAULT;
}

fun build_configuration(policy: *Policy) Status {
    policy.versions[0]   = tls13.VERSION;
    policy.suites[0]     = tls13.AES_128_GCM_SHA256;
    policy.suites[1]     = tls13.AES_256_GCM_SHA384;
    policy.suites[2]     = tls13.CHACHA20_POLY1305_SHA256;
    policy.groups[0]     = tls13.X25519;
    policy.groups[1]     = tls13.SECP256R1;
    policy.signatures[0] = tls13.ED25519;
    policy.signatures[1] = tls13.ECDSA_SECP256R1_SHA256;
    policy.signatures[2] = tls13.RSA_PSS_RSAE_SHA256;
    policy.signatures[3] = tls13.RSA_PSS_RSAE_SHA384;
    var configuration: tls_config.ServerConfig;
    configuration.credentials          = ?policy.bindings.store;
    configuration.alpn                 = ?policy.alpn[0];
    configuration.alpn_len             = policy.alpn_len;
    configuration.require_alpn         = policy.require_alpn;
    configuration.versions             = ?policy.versions[0];
    configuration.version_len          = 1;
    configuration.suites               = ?policy.suites[0];
    configuration.suite_len            = 3;
    configuration.groups               = ?policy.groups[0];
    configuration.group_len            = 2;
    configuration.signatures           = ?policy.signatures[0];
    configuration.signature_len        = 4;
    configuration.entropy              = ?policy.entropy;
    configuration.entropy_context_size = 0;
    configuration.clock                = ?policy.clock;
    if (policy.tickets_live) {
        configuration.tickets                = ?policy.ticket_ring;
        configuration.tickets_per_connection = policy.tickets_per_connection;
        configuration.replay_policy          = policy.ticket_replay_policy;
        if (policy.replay_live) {
            configuration.replay = ?policy.replay_window;
        }
        or {
            configuration.replay = nil;
        }
    }
    or {
        configuration.tickets                = nil;
        configuration.replay                 = nil;
        configuration.replay_policy          = session.REPLAY_PERMISSIVE;
        configuration.tickets_per_connection = 0;
    }
    configuration.limits = listener_limits();
    policy.configuration = configuration;

    var extra: tls_server.ExtraExtension;
    extra.kind      = 0;
    extra.data.data = nil;
    extra.data.len  = 0;
    var hello_required:  usize = 0;
    var flight_required: usize = 0;
    if (!tls_server.storage_requirements(?policy.configuration, extra,
        ?hello_required, ?flight_required)) { ret UNSUPPORTED; }
    # the handshake's output comes from the connection's TLS lane, so a
    # configuration that needs more than the lane holds fails here
    if (hello_required + flight_required > memory.TLS_BUDGET) { ret UNSUPPORTED; }
    ret OK;
}

fun destroy_resumption(policy: *Policy) {
    if (policy.replay_live) {
        session.replay_destroy(?policy.replay_window);
        policy.replay_live = false;
    }
    if (policy.tickets_live) {
        session.keyring_destroy(?policy.ticket_ring);
        policy.tickets_live = false;
    }
    policy.ticket_rotate_ns = 0;
}

fun configure_resumption(policy: *Policy, configured: *schema.TlsResumption) Status {
    policy.tickets_live           = false;
    policy.replay_live            = false;
    policy.ticket_rotate_ns       = 0;
    policy.ticket_replay_policy   = session.REPLAY_PERMISSIVE;
    policy.tickets_per_connection = 0;
    if (configured == nil || !configured.enabled) { ret OK; }
    if (configured.retirement_overlap_seconds::usize >
        configured.key_lifetime_seconds::usize *
        (session.MAX_TICKET_KEYS - 1)) { ret INVALID; }
    var moment: tls_clock.Moment;
    if (!tls_clock.read(?policy.clock, ?moment)) { ret UNSUPPORTED; }
    if (!session.keyring_init(?policy.ticket_ring, ?policy.entropy, moment,
        configured.key_lifetime_seconds,
        configured.retirement_overlap_seconds,
        configured.ticket_lifetime_seconds)) { ret UNSUPPORTED; }
    policy.tickets_live                = true;
    policy.ticket_key_lifetime_seconds = configured.key_lifetime_seconds;
    atomic.store(?policy.ticket_rotate_ns, rotation_after(moment.monotonic,
        configured.key_lifetime_seconds));
    policy.tickets_per_connection = configured.tickets_per_connection;
    if (configured.replay_policy == schema.TLS_REPLAY_SINGLE_USE) {
        if (!session.replay_init(?policy.replay_window)) {
            destroy_resumption(policy);
            ret UNSUPPORTED;
        }
        policy.replay_live          = true;
        policy.ticket_replay_policy = session.REPLAY_SINGLE_USE;
    }
    or (configured.replay_policy == schema.TLS_REPLAY_PERMISSIVE) {
        policy.ticket_replay_policy = session.REPLAY_PERMISSIVE;
    }
    or {
        destroy_resumption(policy);
        ret INVALID;
    }
    ret OK;
}

# release the configured identities' keys
#
# the caller must have established that no generation still reaches them. every
# generation publishes them, so that is only ever the policy's teardown.
fun destroy_statics(policy: *Policy) bool {
    var success: bool  = true;
    var i:       usize = 0;
    for (i < policy.identity_count) {
        val identity: *Identity = ?policy.identities[i];
        if (identity.live
            && keys.destroy_private(?identity.private_key) != contracts.OK) {
            success = false;
        }
        identity.live = false;
        i             = i + 1;
    }
    policy.identity_count = 0;
    ret success;
}

# release one issuance's key and forget it. the caller must have established
# that no live generation publishes it
fun destroy_issued(issued: *Issued) bool {
    var success: bool = true;
    if (issued.live && keys.destroy_private(?issued.private_key) != contracts.OK) {
        success = false;
    }
    issued.live       = false;
    issued.name_count = 0;
    issued.chain_len  = 0;
    ret success;
}

# forget what a bank's generation published. its keys belong to the configured
# identities and the managed certificates, never to the bank
fun clear_bank(policy: *Policy, bank: usize) {
    policy.published_counts[bank] = 0;
    policy.generation_live[bank]  = false;
    policy.generations[bank]      = credentials.empty_generation();
}

fun publish_entry(policy: *Policy, bank: usize, name: contracts.Bytes,
    chain: cert.Chain, private_key: *keys.PrivateKey) bool {
    val slot: usize = policy.published_counts[bank];
    if (slot >= MAX_PUBLISHED) { ret false; }
    var entry: credentials.Identity;
    entry.server_name             = name;
    entry.chain                   = chain;
    entry.private_key             = private_key;
    policy.published[bank][slot]  = entry;
    policy.published_counts[bank] = slot + 1;
    ret true;
}

fun issued_name(issued: *Issued, index: usize) contracts.Bytes {
    ret contracts.Bytes{data: ?issued.names[index][0], len: issued.name_lens[index]};
}

# the issuance managed certificate `certificate` publishes on policy `index`:
# `pending` for the one being replaced, the current one for any other installed
# there, or nil
fun issuance(index: usize, certificate: usize, replacing: usize,
    pending: *Issued) *Issued {
    if (certificate == replacing) { ret pending; }
    val held: *Managed = ?managed[certificate];
    if (!held.installed || held.policy != index) { ret nil; }
    ret ?held.issued[held.current];
}

fun managed_serves(index: usize, replacing: usize, pending: *Issued,
    name: contracts.Bytes) bool {
    var certificate: usize = 0;
    for (certificate < MAX_MANAGED) {
        val issued: *Issued = issuance(index, certificate, replacing, pending);
        if (issued != nil) {
            var i: usize = 0;
            for (i < issued.name_count) {
                if (same_name(issued_name(issued, i), name)) { ret true; }
                i = i + 1;
            }
        }
        certificate = certificate + 1;
    }
    ret false;
}

# fills `bank` with everything the policy serves: each configured identity
# whose name no managed certificate has taken over, then every name of every
# managed certificate on the listener, with `pending` standing in for
# certificate `replacing`. sni then selects across both
fun compose_bank(index: usize, bank: usize, replacing: usize,
    pending: *Issued) bool {
    val policy: *Policy = ?policies[index];
    policy.published_counts[bank] = 0;
    var i: usize = 0;
    for (i < policy.identity_count) {
        val identity: *Identity       = ?policy.identities[i];
        var name:     contracts.Bytes = contracts.Bytes{data: nil, len: 0};
        if (identity.name_len != 0) {
            name = contracts.Bytes{data: ?identity.name[0], len: identity.name_len};
        }
        if (name.len == 0 || !managed_serves(index, replacing, pending, name)) {
            if (!publish_entry(policy, bank, name, cert.Chain{
                certificates: ?identity.certificates[0], len: identity.chain_len
            }, ?identity.private_key)) { ret false; }
        }
        i = i + 1;
    }
    var certificate: usize = 0;
    for (certificate < MAX_MANAGED) {
        val issued: *Issued = issuance(index, certificate, replacing, pending);
        if (issued != nil) {
            i = 0;
            for (i < issued.name_count) {
                if (!publish_entry(policy, bank, issued_name(issued, i), cert.Chain{
                    certificates: ?issued.certificates[0], len: issued.chain_len
                }, ?issued.private_key)) { ret false; }
                i = i + 1;
            }
        }
        certificate = certificate + 1;
    }
    ret true;
}

# published once per secure listener rather than once per configured policy, and
# named by that listener. the ALPN offer is the listener's protocol set, so two
# listeners sharing one certificate but serving different protocols must not
# share one published generation.
fun publish_inner(name: str, configured: *schema.TlsPolicy, protocols: u8,
    options: PublishOptions) Status {
    refused_key_path = nil;
    if (configured == nil || name == nil) { ret INVALID; }
    if (policy_count >= MAX_POLICIES)     { ret EXHAUSTED; }
    identity_owner = secret.system_allocator();
    val index:  usize   = policy_count;
    val policy: *Policy = ?policies[index];
    policy.live                = false;
    policy.identity_count      = 0;
    policy.published_counts[0] = 0;
    policy.published_counts[1] = 0;
    policy.generation_live[0]  = false;
    policy.generation_live[1]  = false;
    policy.challenge_enabled   = options.tls_alpn_challenge;
    var slot: usize = 0;
    for (slot < MAX_CHALLENGES) {
        val challenge_slot: *Challenge = ?policy.challenges[slot];
        clear_challenge(challenge_slot);
        challenge_slot.generation     = credentials.empty_generation();
        challenge_slot.key            = keys.empty_private();
        policy.challenge_stores[slot] = credentials.empty_store();
        if (policy.challenge_enabled &&
            credentials.initialize_vacant_store(?policy.challenge_stores[slot]) !=
            contracts.OK) { ret UNSUPPORTED; }
        slot = slot + 1;
    }
    policy.active               = 0;
    policy.alpn_len             = 0;
    policy.require_client_auth  = configured.client_auth;
    policy.tickets_live         = false;
    policy.replay_live          = false;
    policy.ticket_rotate_ns     = 0;
    policy.client_trust.anchors = nil;
    policy.client_trust.len     = 0;
    policy.has_default          = configured.has_default;
    policy.default_name_len     = 0;
    if (!copy_name(?policy.name[0], ?policy.name_len, name)) { ret INVALID; }
    if (configured.has_default && !copy_name(?policy.default_name[0],
        ?policy.default_name_len, schema.text(?configured.default_name))) { ret INVALID; }
    if (configured.identity_count == 0) { ret INVALID; }
    policy.entropy = secret.system_entropy();
    policy.clock   = tls_clock.system();
    val resumable: Status = configure_resumption(policy, ?configured.resumption);
    if (resumable != OK) { ret resumable; }
    var i: usize = 0;
    for (i < configured.identity_count) {
        val loaded: Status = load_identity(policy, ?configured.identities[i],
            ?identity_owner);
        if (loaded != OK) {
            destroy_resumption(policy);
            destroy_statics(policy);
            ret loaded;
        }
        i = i + 1;
    }
    var trust: *cert.TrustStore = nil;
    if (configured.client_auth) {
        val anchored: Status = load_anchor(policy,
            schema.text(?configured.client_trust));
        if (anchored != OK) {
            destroy_resumption(policy);
            destroy_statics(policy);
            ret anchored;
        }
        trust = ?policy.client_trust;
    }
    offer_protocols(policy, protocols);
    if (policy.challenge_enabled) { offer_protocol(policy, "acme-tls/1"); }
    # a listener that serves nothing over TLS has nothing to negotiate, and a
    # client that offers nothing we serve is refused rather than defaulted
    policy.require_alpn   = policy.alpn_len != 0;
    policy.generations[0] = credentials.empty_generation();
    # no managed certificate is installed on a policy not yet published
    if (!compose_bank(index, 0, MAX_MANAGED, nil)
        || hedge_credentials.publish(?policy.bindings, ?policy.generations[0],
        ?policy.published[0][0], policy.published_counts[0],
        default_index(policy, 0), trust,
        configured.client_auth) != hedge_credentials.OK) {
        destroy_resumption(policy);
        destroy_statics(policy);
        ret UNSUPPORTED;
    }
    policy.generation_live[0] = true;
    val built: Status = build_configuration(policy);
    if (built != OK) {
        destroy_resumption(policy);
        destroy_statics(policy);
        ret built;
    }
    policy.live  = true;
    policy_count = policy_count + 1;
    ret OK;
}

pub fun publish(name: str, configured: *schema.TlsPolicy, protocols: u8) Status {
    ret publish_inner(name, configured, protocols, publish_options());
}

pub fun publish_with_options(name: str, configured: *schema.TlsPolicy,
    protocols: u8, options: PublishOptions) Status {
    ret publish_inner(name, configured, protocols, options);
}

# whether a server name resolves to a credential in this policy's generation
#
# a virtual host configured on a TLS listener with no certificate for its name
# would negotiate nothing and refuse every client that asked for it. asking the
# published generation at startup turns that into a configuration failure, which
# is the only point at which an operator can still act on it.
pub fun servable(index: usize, name: str) bool {
    val policy: *Policy = policy_at(index);
    if (policy == nil) { ret false; }
    var held: hedge_credentials.Held;
    held.held = false;
    val status: hedge_credentials.Status = hedge_credentials.acquire(?policy.bindings,
        name, ?held);
    if (status != hedge_credentials.OK) { ret false; }
    hedge_credentials.release(?held);
    ret true;
}

# copies one managed certificate's chain and PKCS#8 key into `issued`
fun load_issued(issued: *Issued, manager: *acme.Manager) Status {
    val names:     usize = acme.name_count(manager);
    val chain_len: usize = acme.chain_count(manager);
    if (names == 0 || names > schema.MAX_ACME_NAMES || chain_len == 0
        || chain_len > MAX_CHAIN) { ret INVALID; }
    var name_index: usize = 0;
    for (name_index < names) {
        var length: usize = 0;
        if (!copy_view_name(?issued.names[name_index][0], ?length,
            acme.name(manager, name_index))) { ret INVALID; }
        issued.name_lens[name_index] = length;
        name_index                   = name_index + 1;
    }
    var chain_bytes:       usize = 0;
    var certificate_index: usize = 0;
    for (certificate_index < chain_len) {
        var encoded: view.View;
        if (!acme.chain_entry(manager, certificate_index, ?encoded)
            || encoded.data == nil || encoded.len == 0) { ret UNDECODABLE; }
        if (encoded.len > MAX_PEM_BYTES - chain_bytes) { ret EXHAUSTED; }
        var byte_index: usize = 0;
        for (byte_index < encoded.len) {
            issued.der[chain_bytes + byte_index] = encoded.data[byte_index];
            byte_index                           = byte_index + 1;
        }
        if (load.certificate_der(contracts.Bytes{
            data: ?issued.der[chain_bytes], len: encoded.len
        },
            ?issued.certificates[certificate_index]) != contracts.OK) {
            ret UNDECODABLE;
        }
        chain_bytes       = chain_bytes + encoded.len;
        certificate_index = certificate_index + 1;
    }
    issued.private_key = keys.empty_private();
    if (load.private_der(acme_keys.private_der(acme.certificate_key(manager)),
        cert.PKCS8_DER, ?identity_owner, ?issued.private_key) != contracts.OK) {
        ret UNDECODABLE;
    }
    issued.name_count = names;
    issued.chain_len  = chain_len;
    issued.live       = true;
    ret OK;
}

# publishes the listener's generation with one managed certificate's new
# issuance, leaving every other certificate and configured identity as it was
pub fun install_acme(index: usize, manager: *acme.Manager) Status {
    val policy: *Policy = policy_at(index);
    if (policy == nil || !acme.certificate_ready(manager)) { ret INVALID; }
    val certificate: usize = acme.certificate_index(manager);
    if (certificate >= MAX_MANAGED) { ret INVALID; }
    val held: *Managed = ?managed[certificate];
    if (held.installed && held.policy != index) { ret INVALID; }
    val target: usize = 1 - policy.active;
    if (policy.generation_live[target]) {
        if (!hedge_credentials.reclaimable(?policy.generations[target])) {
            ret RETIRED_IN_USE;
        }
        clear_bank(policy, target);
    }
    # only the active generation is live now, and it reaches this certificate's
    # current issuance at most, so the other one is free to replace
    var spare: usize = 0;
    if (held.installed) { spare = 1 - held.current; }
    val pending: *Issued = ?held.issued[spare];
    if (!destroy_issued(pending)) { ret INVALID; }
    identity_owner = secret.system_allocator();
    val loaded: Status = load_issued(pending, manager);
    if (loaded != OK) {
        destroy_issued(pending);
        ret loaded;
    }
    if (!compose_bank(index, target, certificate, pending)) {
        destroy_issued(pending);
        clear_bank(policy, target);
        ret EXHAUSTED;
    }
    var trust: *cert.TrustStore = nil;
    if (policy.require_client_auth) { trust = ?policy.client_trust; }
    policy.generations[target] = credentials.empty_generation();
    if (credentials.initialize(?policy.generations[target],
        ?policy.published[target][0], policy.published_counts[target],
        default_index(policy, target), trust,
        policy.require_client_auth) != contracts.OK) {
        destroy_issued(pending);
        clear_bank(policy, target);
        ret UNSUPPORTED;
    }
    var retired: *credentials.Generation = nil;
    if (hedge_credentials.rotate(?policy.bindings, ?policy.generations[target],
        ?retired) != hedge_credentials.OK || retired == nil) {
        destroy_issued(pending);
        clear_bank(policy, target);
        ret UNSUPPORTED;
    }
    policy.generation_live[target] = true;
    policy.active                  = target;
    held.current                   = spare;
    held.installed                 = true;
    held.policy                    = index;
    ret OK;
}

# answers an `acme-tls/1` handshake from whichever presentation slot holds its
# server name. `store` is the first of the policy's MAX_CHALLENGES stores
fun select_tls_alpn(store: *credentials.Store, offer: tls_server.CredentialOffer,
    output: *credentials.Lease) contracts.Error {
    if (store == nil || !tls_server.offered_alpn_exactly(offer,
        contracts.Bytes{data: "acme-tls/1"::*u8, len: 10})) {
        ret contracts.UNSUPPORTED;
    }
    # a presentation's generation defaults to its one identity, so a store
    # answers any name. the lease is kept only from the store presenting the
    # name the client asked for
    var i: usize = 0;
    for (i < MAX_CHALLENGES) {
        if (credentials.acquire(?store[i], offer.server_name, output) == contracts.OK) {
            if (same_name(output.identity.server_name, offer.server_name)) {
                ret contracts.OK;
            }
            credentials.release(output);
            @output = credentials.empty_lease();
        }
        i = i + 1;
    }
    ret contracts.UNSUPPORTED;
}

pub fun tls_alpn_selector(policy: *Policy) tls_server.CredentialSelector {
    var value: tls_server.CredentialSelector = tls_server.no_credential_selector();
    if (policy == nil || !policy.challenge_enabled) { ret value; }
    value.store  = ?policy.challenge_stores[0];
    value.select = select_tls_alpn;
    ret value;
}

pub fun tls_alpn_enabled(index: usize) bool {
    val policy: *Policy = policy_at(index);
    ret policy != nil && policy.challenge_enabled;
}

# a presentation slot of its own for one certificate validating through the
# listener, or NO_CHALLENGE when the listener answers no tls-alpn-01 or every
# slot is taken
pub fun claim_tls_alpn(index: usize) usize {
    val policy: *Policy = policy_at(index);
    if (policy == nil || !policy.challenge_enabled) { ret NO_CHALLENGE; }
    var slot: usize = 0;
    for (slot < MAX_CHALLENGES) {
        if (!policy.challenges[slot].claimed) {
            policy.challenges[slot].claimed = true;
            ret slot;
        }
        slot = slot + 1;
    }
    ret NO_CHALLENGE;
}

fun challenge_at(index: usize, slot: usize) *Challenge {
    val policy: *Policy = policy_at(index);
    if (policy == nil || !policy.challenge_enabled || slot >= MAX_CHALLENGES
        || !policy.challenges[slot].claimed) { ret nil; }
    ret ?policy.challenges[slot];
}

fun retire_tls_alpn(policy: *Policy, slot: usize) bool {
    val presented: *Challenge = ?policy.challenges[slot];
    if (!presented.live || presented.retiring) { ret true; }
    var retired: *credentials.Generation = nil;
    if (credentials.withdraw_store(?policy.challenge_stores[slot], ?retired) !=
        contracts.OK || retired != ?presented.generation) {
        ret false;
    }
    presented.retiring = true;
    ret true;
}

fun reap_tls_alpn(presented: *Challenge) Status {
    if (!presented.live)     { ret OK; }
    if (!presented.retiring) { ret INVALID; }
    if (!credentials.reclaimable(?presented.generation)) {
        ret RETIRED_IN_USE;
    }
    if (credentials.clear(?presented.generation) != contracts.OK ||
        keys.destroy_private(?presented.key) != contracts.OK) {
        ret UNSUPPORTED;
    }
    wipe(?presented.der[0], CHALLENGE_BYTES);
    presented.name_len = 0;
    presented.live     = false;
    presented.retiring = false;
    ret OK;
}

# copies one RFC 8737 certificate and PKCS#8 key into a claimed slot of the
# listener-owned store
pub fun install_tls_alpn(index: usize, slot: usize, name: view.View,
    certificate: view.View, private_der: contracts.SecretBytes) Status {
    val presented: *Challenge = challenge_at(index, slot);
    if (presented == nil || name.data == nil ||
        name.len == 0 || name.len >= schema.TEXT_CAP || certificate.data == nil ||
        certificate.len == 0 || certificate.len > CHALLENGE_BYTES ||
        private_der.data == nil || private_der.len == 0 ||
        private_der.len > MAX_KEY_BYTES) { ret INVALID; }
    val policy: *Policy = policy_at(index);
    if (presented.live) {
        if (!presented.retiring) { ret INVALID; }
        val reaped: Status = reap_tls_alpn(presented);
        if (reaped != OK) { ret reaped; }
    }
    var i: usize = 0;
    for (i < certificate.len) {
        presented.der[i] = certificate.data[i];
        i                = i + 1;
    }
    if (!copy_view_name(?presented.name[0], ?presented.name_len, name)) {
        wipe(?presented.der[0], CHALLENGE_BYTES);
        ret INVALID;
    }
    presented.certificate = cert.Certificate{der: ?presented.der[0],
        der_len: certificate.len};
    presented.key = keys.empty_private();
    if (load.private_der(private_der, cert.PKCS8_DER, ?identity_owner,
        ?presented.key) != contracts.OK) {
        wipe(?presented.der[0], CHALLENGE_BYTES);
        presented.name_len = 0;
        ret UNDECODABLE;
    }
    presented.identity = credentials.Identity{
        server_name: contracts.Bytes{data: ?presented.name[0],
            len: presented.name_len},
        chain:       cert.Chain{certificates: ?presented.certificate, len: 1},
        private_key: ?presented.key
    };
    presented.generation = credentials.empty_generation();
    if (credentials.initialize_tls_alpn_challenge(?presented.generation,
        ?presented.identity) != contracts.OK ||
        credentials.publish_store(?policy.challenge_stores[slot],
        ?presented.generation) != contracts.OK) {
        keys.destroy_private(?presented.key);
        wipe(?presented.der[0], CHALLENGE_BYTES);
        presented.name_len   = 0;
        presented.generation = credentials.empty_generation();
        ret UNSUPPORTED;
    }
    presented.live     = true;
    presented.retiring = false;
    ret OK;
}

pub fun withdraw_tls_alpn(index: usize, slot: usize) Status {
    val presented: *Challenge = challenge_at(index, slot);
    if (presented == nil || !presented.live)      { ret INVALID; }
    if (!retire_tls_alpn(policy_at(index), slot)) { ret UNSUPPORTED; }
    val reaped: Status = reap_tls_alpn(presented);
    if (reaped != OK && reaped != RETIRED_IN_USE) { ret reaped; }
    ret OK;
}

pub fun maintain() bool {
    var success: bool  = true;
    var i:       usize = 0;
    for (i < policy_count) {
        val policy: *Policy = ?policies[i];
        var slot:   usize   = 0;
        for (slot < MAX_CHALLENGES) {
            val presented: *Challenge = ?policy.challenges[slot];
            if (presented.live && presented.retiring) {
                val reaped: Status = reap_tls_alpn(presented);
                if (reaped != OK && reaped != RETIRED_IN_USE) { success = false; }
            }
            slot = slot + 1;
        }
        i = i + 1;
    }
    ret success;
}

pub fun destroy() bool {
    var success: bool  = true;
    var i:       usize = 0;
    for (i < policy_count) {
        val policy: *Policy = ?policies[i];
        var slot:   usize   = 0;
        for (slot < MAX_CHALLENGES) {
            if (!retire_tls_alpn(policy, slot))                { success = false; }
            if (reap_tls_alpn(?policy.challenges[slot]) != OK) { success = false; }
            clear_challenge(?policy.challenges[slot]);
            slot = slot + 1;
        }
        destroy_resumption(policy);
        if (!destroy_statics(policy)) { success = false; }
        clear_bank(policy, 0);
        clear_bank(policy, 1);
        policy.live = false;
        i           = i + 1;
    }
    i = 0;
    for (i < MAX_MANAGED) {
        if (!destroy_issued(?managed[i].issued[0])) { success = false; }
        if (!destroy_issued(?managed[i].issued[1])) { success = false; }
        managed[i].installed = false;
        managed[i].policy    = NO_POLICY;
        i                    = i + 1;
    }
    policy_count = 0;
    ret success;
}

test offer_protocols__listener_order {
    var policy: Policy;
    policy.alpn_len = 0;
    offer_protocols(?policy, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2);
    if (policy.alpn_len != 2) { ret 1; }
    # h2 is offered first, so a client listing http/1.1 first still gets h2
    if (policy.alpn[0].len != 2 || policy.alpn[0].data[0] != 'h'
        || policy.alpn[0].data[1] != '2') { ret 2; }
    if (policy.alpn[1].len != 8 || policy.alpn[1].data[0] != 'h') { ret 3; }

    offer_protocols(?policy, schema.PROTOCOL_HTTP1);
    if (policy.alpn_len != 1 || policy.alpn[0].len != 8) { ret 4; }

    offer_protocols(?policy, schema.PROTOCOL_HTTP2);
    if (policy.alpn_len != 1 || policy.alpn[0].len != 2) { ret 5; }

    # loader validation confines h3 to quic listeners
    offer_protocols(?policy, schema.PROTOCOL_HTTP3);
    if (policy.alpn_len != 1 || policy.alpn[0].len != 2
        || policy.alpn[0].data[0] != 'h' || policy.alpn[0].data[1] != '3') {
        ret 6;
    }
    ret 0;
}

test build_configuration__bounded_tls13_only {
    var policy: Policy;
    policy.entropy  = secret.system_entropy();
    policy.clock    = tls_clock.system();
    policy.alpn_len = 0;
    # the widest offer this listener can make, which is what sizes the flight
    offer_protocols(?policy, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2);
    policy.require_alpn   = true;
    policy.bindings.store = credentials.empty_store();
    policy.bindings.live  = false;
    policy.tickets_live   = false;
    policy.replay_live    = false;
    # the same call the listener makes, so an oversized configuration is caught
    # here rather than at the first handshake
    if (build_configuration(?policy) != OK) { ret 1; }
    if (policy.configuration.limits.max_peer_handshake_bytes != HANDSHAKE_INPUT_BYTES) {
        ret 2;
    }
    if (policy.configuration.limits.max_client_hello_bytes != HELLO_BYTES) { ret 3; }
    if (!policy.configuration.require_alpn || policy.configuration.alpn_len != 2) {
        ret 4;
    }
    # TLS 1.3 only: a listener configured here cannot be talked down a version
    if (policy.configuration.version_len != 1
        || policy.configuration.versions[0] != tls13.VERSION) { ret 5; }
    ret 0;
}

test publish__unreadable_or_empty_refused {
    reset();
    var configured: schema.TlsPolicy;
    schema.set_text(?configured.name, "public");
    configured.identity_count = 1;
    schema.clear_text(?configured.identities[0].server_name);
    schema.set_text(?configured.identities[0].certificate, "no/such/file.pem");
    schema.set_text(?configured.identities[0].key, "no/such/file.key");
    configured.has_default = true;
    schema.clear_text(?configured.default_name);
    configured.client_auth = false;
    schema.clear_text(?configured.client_trust);
    configured.resumption.enabled = false;
    # nothing is published, so a listener referencing this policy cannot start
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != UNREADABLE) {
        ret 1;
    }
    if (count() != 0 || find("secure") != NO_POLICY) { ret 2; }
    if (policy_at(0) != nil)                         { ret 3; }
    # and a policy with no identity at all is not a policy
    configured.identity_count = 0;
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != INVALID) { ret 4; }
    if (count() != 0)                                                     { ret 5; }
    # the key is read into secret storage: a missing key file is unreadable, one
    # group or other can read is exposed and named, and one that is not a key,
    # or is past the bound, is undecodable
    val dir: str = "out/tls-load";
    if (!material_written(dir)) { ret 6; }
    var oversized: [MAX_KEY_BYTES + 1]u8;
    var i:         usize = 0;
    for (i < MAX_KEY_BYTES + 1) {
        oversized[i] = 'A';
        i            = i + 1;
    }
    if (!secret_file.write_owner_only(joined(dir, "big.key", 1), ?oversized[0],
        MAX_KEY_BYTES + 1)
        || !secret_file.write_owner_only(joined(dir, "cert.key", 2), api_cert_pem::*u8,
        str_len(api_cert_pem))) { ret 7; }
    configure(?configured, "api.hedge.test", joined(dir, "api.pem", 0),
        joined(dir, "none.key", 1));
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != UNREADABLE) {
        ret 8;
    }
    $if ($mach.build.os != $mach.os.windows) {
        # a key others can read is refused before a byte of it is read
        configure(?configured, "api.hedge.test", joined(dir, "api.pem", 0),
            joined(dir, "api.pem", 1));
        if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != EXPOSED
            || !schema.text_equals(?configured.identities[0].key, refused_key())) {
            ret 13;
        }
    }
    configure(?configured, "api.hedge.test", joined(dir, "api.pem", 0),
        joined(dir, "cert.key", 2));
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != UNDECODABLE) {
        ret 9;
    }
    configure(?configured, "api.hedge.test", joined(dir, "api.pem", 0),
        joined(dir, "big.key", 1));
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != UNDECODABLE) {
        ret 10;
    }
    if (count() != 0) { ret 11; }
    api_policy(?configured, dir);
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) {
        destroy();
        ret 12;
    }
    reset();
    ret 0;
}

# a self-signed Ed25519 identity the listener tests publish
#[testing]
val api_cert_pem: str = "-----BEGIN CERTIFICATE-----\nMIIBhjCCATigAwIBAgIUb1yMHSXgfQwYEQyY37QwWtTUVfMwBQYDK2VwMBkxFzAV\nBgNVBAMMDmFwaS5oZWRnZS50ZXN0MB4XDTI2MDgyOTAzNDQ1MVoXDTM2MDgyNjAz\nNDQ1MVowGTEXMBUGA1UEAwwOYXBpLmhlZGdlLnRlc3QwKjAFBgMrZXADIQC6GbDj\nK+V+WR5whTjn+IHlf+2kR5/3HNyHoPA271PhLKOBkTCBjjAdBgNVHQ4EFgQU2Ucc\nT9sn30693AkomFKf64g+djowHwYDVR0jBBgwFoAU2UccT9sn30693AkomFKf64g+\ndjowGQYDVR0RBBIwEIIOYXBpLmhlZGdlLnRlc3QwDgYDVR0PAQH/BAQDAgeAMBMG\nA1UdJQQMMAoGCCsGAQUFBwMBMAwGA1UdEwEB/wQCMAAwBQYDK2VwA0EA8KdvXtof\nftWx7/8unun/tMfnuk6UJPliBSRaKZOKwAMgv+h2yVgkTlrqBbfSajC2jbKLICdK\ncJHdzizPtTmRBg==\n-----END CERTIFICATE-----\n";
#[testing]
val api_key_pem: str = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIBRn6QSXLVl2hvtWrT5gXwgtwIJ3Uh0xz+u7ILSYzppC\n-----END PRIVATE KEY-----\n";

#[testing]
fun write_pem(path: str, contents: str) bool {
    var length: usize = 0;
    for (contents[length] != 0) { length = length + 1; }
    ret fs_ok(filesystem.write_bytes(path, contents::*u8, length, 420));
}

#[testing]
fun ensure_dir(path: str) bool {
    if (present(filesystem.is_dir(path))) { ret true; }
    val created: err[io_error.Error] = filesystem.create_dir(path, 493);
    ret sel created.ok;
}

# every test runs as its own process and they run at once, so each writes its
# material into its own directory. Sharing one would have them truncating and
# rewriting the same files while another was reading them, which shows up as a
# publish that fails perhaps one run in three.
#[testing]
var path_storage: [3][64]u8;

#[testing]
fun joined(dir: str, leaf: str, slot: usize) str {
    var at: usize = 0;
    for (dir[at] != 0 && at < 48) {
        path_storage[slot][at] = dir[at];
        at                     = at + 1;
    }
    path_storage[slot][at] = '/';
    at                     = at + 1;
    var i: usize = 0;
    for (leaf[i] != 0 && at + i < 62) {
        path_storage[slot][at + i] = leaf[i];
        i                          = i + 1;
    }
    path_storage[slot][at + i] = 0;
    ret (?path_storage[slot][0])::str;
}

#[testing]
fun material_written(dir: str) bool {
    if (!ensure_dir("out") || !ensure_dir(dir)) { ret false; }
    ret write_pem(joined(dir, "api.pem", 0), api_cert_pem)
        && secret_file.write_owner_only(joined(dir, "api.key", 0), api_key_pem::*u8,
        str_len(api_key_pem));
}

#[testing]
fun configure(configured: *schema.TlsPolicy, name: str, cert_path: str,
    key_path: str) {
    schema.set_text(?configured.name, "public");
    configured.identity_count = 1;
    schema.set_text(?configured.identities[0].server_name, name);
    schema.set_text(?configured.identities[0].certificate, cert_path);
    schema.set_text(?configured.identities[0].key, key_path);
    configured.has_default = false;
    schema.clear_text(?configured.default_name);
    configured.client_auth = false;
    schema.clear_text(?configured.client_trust);
    configured.resumption.enabled = false;
}

#[testing]
fun api_policy(configured: *schema.TlsPolicy, dir: str) {
    configure(configured, "api.hedge.test", joined(dir, "api.pem", 0),
        joined(dir, "api.key", 1));
}

test prepare__ticket_keys_rotate_on_schedule {
    reset();
    if (!material_written("out/tls-resumption")) {
        destroy();
        ret 1;
    }
    var configured: schema.TlsPolicy;
    api_policy(?configured, "out/tls-resumption");
    configured.resumption.enabled                    = true;
    configured.resumption.key_lifetime_seconds       = 60;
    configured.resumption.retirement_overlap_seconds = 30;
    configured.resumption.ticket_lifetime_seconds    = 120;
    configured.resumption.replay_policy              = schema.TLS_REPLAY_SINGLE_USE;
    configured.resumption.tickets_per_connection     = 2;
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) {
        destroy();
        ret 2;
    }
    val index:  usize   = find("secure");
    val policy: *Policy = policy_at(index);
    if (policy == nil || !policy.tickets_live || !policy.replay_live
        || policy.configuration.tickets != ?policy.ticket_ring
        || policy.configuration.replay != ?policy.replay_window
        || policy.configuration.replay_policy != session.REPLAY_SINGLE_USE
        || policy.configuration.tickets_per_connection != 2) {
        destroy();
        ret 3;
    }
    # the policy reads a clock the test holds, so the schedule is exact
    var moment: tls_clock.Moment = tls_clock.at(1000, 0);
    policy.clock = tls_clock.frozen(?moment);
    val first:    u64          = session.keyring_generation(?policy.ticket_ring);
    val boundary: time.Instant = clock.from_ns(atomic.load(?policy.ticket_rotate_ns)::u64);
    moment.monotonic = time.instant_add(boundary, -1);
    if (first == 0 || !prepare(index)
        || session.keyring_generation(?policy.ticket_ring) != first) {
        destroy();
        ret 4;
    }
    moment.monotonic = boundary;
    if (!prepare(index)
        || session.keyring_generation(?policy.ticket_ring) != first + 1
        || session.keyring_openable(?policy.ticket_ring, boundary) != 2
        || atomic.load(?policy.ticket_rotate_ns)
        != clock.to_ns(time.instant_add(boundary, 60000000000))::i64) {
        destroy();
        ret 5;
    }
    # the claim moved the due time, so a second handshake at the same moment,
    # as another worker's would be, finds nothing due and does not rotate again
    if (!prepare(index)
        || session.keyring_generation(?policy.ticket_ring) != first + 1) {
        destroy();
        ret 7;
    }
    reset();
    if (count() != 0 || policy.tickets_live || policy.replay_live
        || policy.ticket_ring.initialized) { ret 6; }
    ret 0;
}
