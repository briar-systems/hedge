# the TLS listener runtime: one credential generation per configured policy
#
# a policy names certificate and key files; this loads them once, publishes them
# as one immutable mach-tls credential generation, and holds the listener
# configuration every connection on that listener borrows. nothing here is
# per-connection: the generation is shared, and a connection pins it with a
# lease for exactly as long as it lives.
#
# every field the configuration points at lives inside the policy record, so the
# borrowed ALPN list, version list, suite list and entropy source outlive every
# connection that reads them.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.filesystem;
use std.types.option;
use std.crypto.ct;
use std.chrono.time;
use file: std.io.file;
use io_error: std.io.error;
use contracts: crypto.contracts;
use keys: crypto.encoding.keys;
use secret: crypto.secret;
use cert: tls.cert;
use credentials: tls.cert.credentials;
use load: tls.cert.load;
use tls_config: tls.config;
use tls_server: tls.server;
use session: tls.session;
use tls13: tls.tls13;
use schema: hedge.config.schema;
use acme: hedge.acme.manager;
use acme_keys: hedge.acme.keys;
use hedge_credentials: hedge.protocol.credentials;

pub val MAX_IDENTITIES: usize = schema.MAX_TLS_IDENTITIES;
pub val MAX_CHAIN: usize = 4;
pub val MAX_ANCHORS: usize = 4;
# one PEM chain file, and the DER it decodes to
pub val MAX_PEM_BYTES: usize = 8192;
pub val MAX_KEY_BYTES: usize = 4096;
pub val MAX_ALPN: usize = 3;
pub val MAX_ALPN_BYTES: usize = 10;

pub def Status: u8;
pub val OK: Status = 1;
pub val INVALID: Status = 2;
# a certificate or key file could not be read
pub val UNREADABLE: Status = 3;
# a file was read and is not a certificate chain or a private key
pub val UNDECODABLE: Status = 4;
# the policy is well formed and mach-tls refuses the listener configuration
pub val UNSUPPORTED: Status = 5;
pub val EXHAUSTED: Status = 6;
# a replacement arrived while the previously retired generation still has a live
# lease, so there is no bank free to build the new one in
pub val RETIRED_IN_USE: Status = 7;

# the exact storage one server handshake needs, checked against mach-tls at load
# time so an unusable listener fails before it becomes ready
pub val HANDSHAKE_INPUT_BYTES: usize = 16384;
pub val HANDSHAKE_OUTPUT_BYTES: usize = 16384;
pub val HELLO_BYTES: usize = 8192;
pub val PEER_CERTIFICATES: usize = 8;

pub fun listener_limits() tls_config.Limits {
    var limits: tls_config.Limits = tls_config.production_limits();
    limits.max_peer_handshake_bytes = HANDSHAKE_INPUT_BYTES;
    limits.max_client_hello_bytes = HELLO_BYTES;
    limits.max_client_flight_bytes = HANDSHAKE_INPUT_BYTES;
    limits.max_server_flight_bytes = HANDSHAKE_OUTPUT_BYTES;
    limits.max_chain_bytes = MAX_PEM_BYTES;
    limits.max_ticket_bytes = 4096;
    ret limits;
}

rec Identity {
    der: [MAX_PEM_BYTES]u8;
    certificates: [MAX_CHAIN]cert.Certificate;
    private_key: keys.PrivateKey;
    name: [schema.TEXT_CAP]u8;
    name_len: usize;
    live: bool;
}

# two banks, so a replacement is built while the current one is still leased
#
# a retired generation stays readable until its last connection closes, which
# means its certificates and keys must stay where they are. One bank cannot hold
# both, so the policy holds two and alternates. Two is enough for the real
# workload — a renewal every sixty days against connections that live for
# seconds — and a replacement that arrives while the previous retired generation
# is still leased is refused rather than allowed to overwrite it.
pub val BANKS: usize = 2;

pub rec Policy {
    name: [schema.TEXT_CAP]u8;
    name_len: usize;
    identity_counts: [BANKS]usize;
    identities: [BANKS][MAX_IDENTITIES]Identity;
    published: [BANKS][MAX_IDENTITIES]credentials.Identity;
    generations: [BANKS]credentials.Generation;
    # whether that bank's generation was ever published, which `reclaimable`
    # cannot tell us: it reports false for a generation that was never published
    # and for one still leased alike
    generation_live: [BANKS]bool;
    active: usize;
    bindings: hedge_credentials.Bindings;
    challenge_der: [MAX_PEM_BYTES]u8;
    challenge_certificate: cert.Certificate;
    challenge_key: keys.PrivateKey;
    challenge_name: [schema.TEXT_CAP]u8;
    challenge_name_len: usize;
    challenge_identity: credentials.Identity;
    challenge_generation: credentials.Generation;
    challenge_store: credentials.Store;
    challenge_live: bool;
    challenge_retiring: bool;
    challenge_enabled: bool;
    anchor_der: [MAX_PEM_BYTES]u8;
    anchor_certificates: [MAX_ANCHORS]cert.Certificate;
    client_trust: cert.TrustStore;
    require_client_auth: bool;
    alpn_storage: [MAX_ALPN][MAX_ALPN_BYTES]u8;
    alpn: [MAX_ALPN]tls_config.ProtocolName;
    alpn_len: usize;
    require_alpn: bool;
    versions: [1]u16;
    suites: [3]tls13.CipherSuite;
    groups: [2]tls13.NamedGroup;
    signatures: [4]tls13.SignatureScheme;
    entropy: secret.Entropy;
    ticket_ring: session.KeyRing;
    replay_window: session.ReplayWindow;
    ticket_key_lifetime_seconds: u32;
    ticket_rotate_at: i64;
    ticket_replay_policy: session.ReplayPolicy;
    tickets_per_connection: u8;
    tickets_live: bool;
    replay_live: bool;
    configuration: tls_config.ServerConfig;
    live: bool;
}

# a policy is secret-welded through its credential store and private keys, so no
# public record may hold a pointer to one. they live in one bounded table and are
# named by index, exactly as TLS sessions are.
pub val MAX_POLICIES: usize = schema.MAX_TLS_POLICIES;
pub val NO_POLICY: usize = MAX_POLICIES;

var policies: [MAX_POLICIES]Policy;
var policy_count: usize;
# a parsed private key stores a *pointer* to the allocator that owns its secret
# memory and calls back through it when destroyed, so the allocator must outlive
# every key. A stack local in the function that loads them does not: it leaves
# each key holding a dangling pointer, and destroying one then calls a function
# pointer read from a dead frame. This lives beside the table the keys do.
var identity_owner: secret.Allocator;
var scratch: [MAX_PEM_BYTES]u8;
var key_scratch: [MAX_KEY_BYTES]^u8;

pub fun reset() {
    destroy();
    var i: usize = 0;
    for (i < MAX_POLICIES) {
        policies[i].live = false;
        policies[i].identity_counts[0] = 0;
        policies[i].identity_counts[1] = 0;
        policies[i].generation_live[0] = false;
        policies[i].generation_live[1] = false;
        policies[i].challenge_live = false;
        policies[i].challenge_retiring = false;
        policies[i].challenge_enabled = false;
        policies[i].challenge_name_len = 0;
        policies[i].active = 0;
        policies[i].name_len = 0;
        policies[i].tickets_live = false;
        policies[i].replay_live = false;
        policies[i].ticket_rotate_at = 0;
        i = i + 1;
    }
    policy_count = 0;
    identity_owner = secret.system_allocator();
}

pub fun count() usize { ret policy_count; }

pub fun policy_at(index: usize) *Policy {
    if (index >= policy_count || !policies[index].live) { ret nil; }
    ret ?policies[index];
}

pub fun prepare(index: usize, now: i64) bool {
    val policy: *Policy = policy_at(index);
    if (policy == nil) { ret false; }
    if (!policy.tickets_live || now <= policy.ticket_rotate_at) { ret true; }
    if (!session.keyring_rotate(?policy.ticket_ring, ?policy.entropy, now)) {
        ret false;
    }
    policy.ticket_rotate_at = now + policy.ticket_key_lifetime_seconds::i64;
    ret true;
}

pub fun find(name: str) usize {
    if (name == nil) { ret NO_POLICY; }
    val length: usize = str_len(name);
    var i: usize = 0;
    for (i < policy_count) {
        val policy: *Policy = ?policies[i];
        if (policy.live && policy.name_len == length) {
            var j: usize = 0;
            for (j < length && policy.name[j] == name[j]) { j = j + 1; }
            if (j == length) { ret i; }
        }
        i = i + 1;
    }
    ret NO_POLICY;
}

fun copy_name(output: *u8, length: *usize, value: str) bool {
    val n: usize = str_len(value);
    if (n >= schema.TEXT_CAP) { ret false; }
    var i: usize = 0;
    for (i < n) { output[i] = value[i]; i = i + 1; }
    output[n] = 0;
    @length = n;
    ret true;
}

fun copy_view_name(output: *u8, length: *usize, value: view.View) bool {
    if (value.data == nil || value.len >= schema.TEXT_CAP) { ret false; }
    var i: usize = 0;
    for (i < value.len) { output[i] = value.data[i]; i = i + 1; }
    output[value.len] = 0;
    @length = value.len;
    ret true;
}

fun read_file(path: str, buffer: *u8, capacity: usize, length: *usize) bool {
    if (path == nil || path[0] == 0) { ret false; }
    val opened: Result[filesystem.File, io_error.Error] = filesystem.open(path);
    if (is_err[filesystem.File, io_error.Error](opened)) { ret false; }
    var handle: filesystem.File = unwrap_ok[filesystem.File, io_error.Error](opened);
    val read: Result[usize, io_error.Error] = file.read_at(handle, buffer, capacity, 0);
    filesystem.close(?handle);
    if (is_err[usize, io_error.Error](read)) { ret false; }
    @length = unwrap_ok[usize, io_error.Error](read);
    # a file that exactly fills the buffer may have been truncated, and a
    # truncated chain would be published as if it were the whole one
    ret @length != 0 && @length < capacity;
}

# the key never stays in shared public storage: it is copied up into secret
# storage and the staging bytes are overwritten before the parse runs
#[oblivious]
fun copy_secret(destination: *^u8, source: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        destination[i] = source[i];
        i = i + 1;
    }
}

#[oblivious]
fun wipe(buffer: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        buffer[i] = 0;
        i = i + 1;
    }
}

fun load_identity(policy: *Policy, bank: usize, configured: *schema.TlsIdentity,
    owner: *secret.Allocator) Status {
    if (policy.identity_counts[bank] >= MAX_IDENTITIES) { ret EXHAUSTED; }
    val slot: usize = policy.identity_counts[bank];
    val identity: *Identity = ?policy.identities[bank][slot];
    identity.live = false;
    if (!copy_name(?identity.name[0], ?identity.name_len,
        schema.text(?configured.server_name))) { ret INVALID; }
    var pem_length: usize = 0;
    if (!read_file(schema.text(?configured.certificate), ?scratch[0],
        MAX_PEM_BYTES, ?pem_length)) { ret UNREADABLE; }
    var chain: cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?scratch[0], len: pem_length},
        contracts.Buffer{data: ?identity.der[0], capacity: MAX_PEM_BYTES},
        ?identity.certificates[0], MAX_CHAIN, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret UNDECODABLE; }
    var key_length: usize = 0;
    if (!read_file(schema.text(?configured.key), ?scratch[0], MAX_PEM_BYTES,
        ?key_length)) { ret UNREADABLE; }
    if (key_length > MAX_KEY_BYTES) {
        wipe(?scratch[0], MAX_PEM_BYTES);
        ret UNDECODABLE;
    }
    copy_secret(?key_scratch[0], ?scratch[0], key_length);
    wipe(?scratch[0], MAX_PEM_BYTES);
    identity.private_key = keys.empty_private();
    val parsed: contracts.Error = load.private_pem(
        contracts.SecretBytes{data: ?key_scratch[0], len: key_length}, owner,
        ?identity.private_key);
    ct.zeroize(?key_scratch[0], MAX_KEY_BYTES);
    if (parsed != contracts.OK) { ret UNDECODABLE; }
    var name: contracts.Bytes;
    name.data = nil;
    name.len = 0;
    if (identity.name_len != 0) {
        name.data = ?identity.name[0];
        name.len = identity.name_len;
    }
    var published: credentials.Identity;
    published.server_name = name;
    published.chain = chain;
    published.private_key = ?identity.private_key;
    policy.published[bank][slot] = published;
    identity.live = true;
    policy.identity_counts[bank] = slot + 1;
    ret OK;
}

fun load_anchor(policy: *Policy, path: str) Status {
    var pem_length: usize = 0;
    if (!read_file(path, ?scratch[0], MAX_PEM_BYTES, ?pem_length)) {
        ret UNREADABLE;
    }
    var chain: cert.Chain;
    val decoded: contracts.Operation = load.chain_pem(
        contracts.Bytes{data: ?scratch[0], len: pem_length},
        contracts.Buffer{data: ?policy.anchor_der[0], capacity: MAX_PEM_BYTES},
        ?policy.anchor_certificates[0], MAX_ANCHORS, ?chain);
    if (decoded.error != contracts.OK || chain.len == 0) { ret UNDECODABLE; }
    policy.client_trust.anchors = chain.certificates;
    policy.client_trust.len = chain.len;
    ret OK;
}

fun offer_protocol(policy: *Policy, value: str) {
    if (policy.alpn_len >= MAX_ALPN) { ret; }
    val slot: usize = policy.alpn_len;
    val length: usize = str_len(value);
    if (length == 0 || length > MAX_ALPN_BYTES) { ret; }
    var i: usize = 0;
    for (i < length) { policy.alpn_storage[slot][i] = value[i]; i = i + 1; }
    policy.alpn[slot] = tls_config.ProtocolName{
        data: ?policy.alpn_storage[slot][0], len: length};
    policy.alpn_len = slot + 1;
}

pub rec PublishOptions {
    tls_alpn_challenge: bool;
}

pub fun publish_options() PublishOptions {
    ret PublishOptions{tls_alpn_challenge: false};
}

# the listener's preference order, not the client's. mach-tls walks this list in
# order, so putting h2 first is what makes a client offering both get h2.
fun offer_protocols(policy: *Policy, protocols: u8) {
    policy.alpn_len = 0;
    # parenthesised: `!=` binds tighter than `&`. see briar-systems/laurel#32.
    if ((protocols & schema.PROTOCOL_HTTP3) != 0) { offer_protocol(policy, "h3"); }
    if ((protocols & schema.PROTOCOL_HTTP2) != 0) { offer_protocol(policy, "h2"); }
    if ((protocols & schema.PROTOCOL_HTTP1) != 0) {
        offer_protocol(policy, "http/1.1");
    }
}

fun default_index(policy: *Policy, bank: usize,
    configured: *schema.TlsPolicy) usize {
    if (!configured.has_default) { ret credentials.NO_DEFAULT; }
    val wanted: str = schema.text(?configured.default_name);
    var i: usize = 0;
    for (i < policy.identity_counts[bank]) {
        val identity: *Identity = ?policy.identities[bank][i];
        if (identity.name_len == str_len(wanted)) {
            var j: usize = 0;
            for (j < identity.name_len && identity.name[j] == wanted[j]) {
                j = j + 1;
            }
            if (j == identity.name_len) { ret i; }
        }
        i = i + 1;
    }
    ret credentials.NO_DEFAULT;
}

fun build_configuration(policy: *Policy) Status {
    policy.versions[0] = tls13.VERSION;
    policy.suites[0] = tls13.AES_128_GCM_SHA256;
    policy.suites[1] = tls13.AES_256_GCM_SHA384;
    policy.suites[2] = tls13.CHACHA20_POLY1305_SHA256;
    policy.groups[0] = tls13.X25519;
    policy.groups[1] = tls13.SECP256R1;
    policy.signatures[0] = tls13.ED25519;
    policy.signatures[1] = tls13.ECDSA_SECP256R1_SHA256;
    policy.signatures[2] = tls13.RSA_PSS_RSAE_SHA256;
    policy.signatures[3] = tls13.RSA_PSS_RSAE_SHA384;
    var configuration: tls_config.ServerConfig;
    configuration.credentials = ?policy.bindings.store;
    configuration.alpn = ?policy.alpn[0];
    configuration.alpn_len = policy.alpn_len;
    configuration.require_alpn = policy.require_alpn;
    configuration.versions = ?policy.versions[0];
    configuration.version_len = 1;
    configuration.suites = ?policy.suites[0];
    configuration.suite_len = 3;
    configuration.groups = ?policy.groups[0];
    configuration.group_len = 2;
    configuration.signatures = ?policy.signatures[0];
    configuration.signature_len = 4;
    configuration.entropy = ?policy.entropy;
    configuration.entropy_context_size = 0;
    if (policy.tickets_live) {
        configuration.tickets = ?policy.ticket_ring;
        configuration.tickets_per_connection = policy.tickets_per_connection;
        configuration.replay_policy = policy.ticket_replay_policy;
        if (policy.replay_live) {
            configuration.replay = ?policy.replay_window;
        } or {
            configuration.replay = nil;
        }
    } or {
        configuration.tickets = nil;
        configuration.replay = nil;
        configuration.replay_policy = session.REPLAY_PERMISSIVE;
        configuration.tickets_per_connection = 0;
    }
    configuration.limits = listener_limits();
    policy.configuration = configuration;

    var extra: tls_server.ExtraExtension;
    extra.kind = 0;
    extra.data.data = nil;
    extra.data.len = 0;
    var hello_required: usize = 0;
    var flight_required: usize = 0;
    if (!tls_server.storage_requirements(?policy.configuration, extra,
        ?hello_required, ?flight_required)) { ret UNSUPPORTED; }
    # the per-connection buffers are fixed, so a configuration that needs more
    # than they hold must fail here rather than at the first handshake
    if (hello_required > HANDSHAKE_OUTPUT_BYTES
     || flight_required > HANDSHAKE_OUTPUT_BYTES) { ret UNSUPPORTED; }
    ret OK;
}

fun destroy_resumption(policy: *Policy) {
    if (policy.replay_live) {
        session.replay_destroy(?policy.replay_window);
        policy.replay_live = false;
    }
    if (policy.tickets_live) {
        session.keyring_destroy(?policy.ticket_ring);
        policy.tickets_live = false;
    }
    policy.ticket_rotate_at = 0;
}

fun configure_resumption(policy: *Policy, configured: *schema.TlsResumption,
    now: i64) Status {
    policy.tickets_live = false;
    policy.replay_live = false;
    policy.ticket_rotate_at = 0;
    policy.ticket_replay_policy = session.REPLAY_PERMISSIVE;
    policy.tickets_per_connection = 0;
    if (configured == nil || !configured.enabled) { ret OK; }
    if (configured.retirement_overlap_seconds::usize >
        configured.key_lifetime_seconds::usize *
            (session.MAX_TICKET_KEYS - 1)) { ret INVALID; }
    if (!session.keyring_init(?policy.ticket_ring, ?policy.entropy, now,
        configured.key_lifetime_seconds,
        configured.retirement_overlap_seconds,
        configured.ticket_lifetime_seconds)) { ret UNSUPPORTED; }
    policy.tickets_live = true;
    policy.ticket_key_lifetime_seconds = configured.key_lifetime_seconds;
    policy.ticket_rotate_at = now + configured.key_lifetime_seconds::i64;
    policy.tickets_per_connection = configured.tickets_per_connection;
    if (configured.replay_policy == schema.TLS_REPLAY_SINGLE_USE) {
        if (!session.replay_init(?policy.replay_window)) {
            destroy_resumption(policy);
            ret UNSUPPORTED;
        }
        policy.replay_live = true;
        policy.ticket_replay_policy = session.REPLAY_SINGLE_USE;
    } or (configured.replay_policy == schema.TLS_REPLAY_PERMISSIVE) {
        policy.ticket_replay_policy = session.REPLAY_PERMISSIVE;
    } or {
        destroy_resumption(policy);
        ret INVALID;
    }
    ret OK;
}

# release one bank's private keys and forget what it held
#
# the caller must have established that this bank's generation is reclaimable.
# Destroying a key an established connection is still handshaking against would
# be exactly the failure lease pinning exists to prevent.
fun destroy_bank(policy: *Policy, bank: usize) bool {
    var success: bool = true;
    var i: usize = 0;
    for (i < policy.identity_counts[bank]) {
        val identity: *Identity = ?policy.identities[bank][i];
        if (identity.live
         && keys.destroy_private(?identity.private_key) != contracts.OK) {
            success = false;
        }
        identity.live = false;
        i = i + 1;
    }
    policy.identity_counts[bank] = 0;
    policy.generation_live[bank] = false;
    ret success;
}

# published once per secure listener rather than once per configured policy, and
# named by that listener. the ALPN offer is the listener's protocol set, so two
# listeners sharing one certificate but serving different protocols must not
# share one published generation.
fun publish_inner(name: str, configured: *schema.TlsPolicy, protocols: u8,
    options: PublishOptions) Status {
    if (configured == nil || name == nil) { ret INVALID; }
    if (policy_count >= MAX_POLICIES) { ret EXHAUSTED; }
    identity_owner = secret.system_allocator();
    val policy: *Policy = ?policies[policy_count];
    policy.live = false;
    policy.identity_counts[0] = 0;
    policy.identity_counts[1] = 0;
    policy.generation_live[0] = false;
    policy.generation_live[1] = false;
    policy.challenge_live = false;
    policy.challenge_retiring = false;
    policy.challenge_enabled = options.tls_alpn_challenge;
    policy.challenge_name_len = 0;
    policy.challenge_generation = credentials.empty_generation();
    policy.challenge_store = credentials.empty_store();
    policy.challenge_key = keys.empty_private();
    if (policy.challenge_enabled &&
        credentials.initialize_vacant_store(?policy.challenge_store) !=
            contracts.OK) { ret UNSUPPORTED; }
    policy.active = 0;
    policy.alpn_len = 0;
    policy.require_client_auth = configured.client_auth;
    policy.tickets_live = false;
    policy.replay_live = false;
    policy.ticket_rotate_at = 0;
    policy.client_trust.anchors = nil;
    policy.client_trust.len = 0;
    if (!copy_name(?policy.name[0], ?policy.name_len, name)) { ret INVALID; }
    if (configured.identity_count == 0) { ret INVALID; }
    policy.entropy = secret.system_entropy();
    val resumable: Status = configure_resumption(policy,
        ?configured.resumption, time.time_unix_sec(time.now()));
    if (resumable != OK) { ret resumable; }
    var i: usize = 0;
    for (i < configured.identity_count) {
        val loaded: Status = load_identity(policy, 0, ?configured.identities[i],
            ?identity_owner);
        if (loaded != OK) {
            destroy_resumption(policy);
            destroy_bank(policy, 0);
            ret loaded;
        }
        i = i + 1;
    }
    var trust: *cert.TrustStore = nil;
    if (configured.client_auth) {
        val anchored: Status = load_anchor(policy,
            schema.text(?configured.client_trust));
        if (anchored != OK) {
            destroy_resumption(policy);
            destroy_bank(policy, 0);
            ret anchored;
        }
        trust = ?policy.client_trust;
    }
    offer_protocols(policy, protocols);
    if (policy.challenge_enabled) { offer_protocol(policy, "acme-tls/1"); }
    # a listener that serves nothing over TLS has nothing to negotiate, and a
    # client that offers nothing we serve is refused rather than defaulted
    policy.require_alpn = policy.alpn_len != 0;
    policy.generations[0] = credentials.empty_generation();
    if (hedge_credentials.publish(?policy.bindings, ?policy.generations[0],
        ?policy.published[0][0], policy.identity_counts[0],
        default_index(policy, 0, configured), trust,
        configured.client_auth) != hedge_credentials.OK) {
        destroy_resumption(policy);
        destroy_bank(policy, 0);
        ret UNSUPPORTED;
    }
    policy.generation_live[0] = true;
    val built: Status = build_configuration(policy);
    if (built != OK) {
        destroy_resumption(policy);
        destroy_bank(policy, 0);
        ret built;
    }
    policy.live = true;
    policy_count = policy_count + 1;
    ret OK;
}

pub fun publish(name: str, configured: *schema.TlsPolicy, protocols: u8) Status {
    ret publish_inner(name, configured, protocols, publish_options());
}

pub fun publish_with_options(name: str, configured: *schema.TlsPolicy,
    protocols: u8, options: PublishOptions) Status {
    ret publish_inner(name, configured, protocols, options);
}

# whether a server name resolves to a credential in this policy's generation
#
# a virtual host configured on a TLS listener with no certificate for its name
# would negotiate nothing and refuse every client that asked for it. asking the
# published generation at startup turns that into a configuration failure, which
# is the only point at which an operator can still act on it.
pub fun servable(index: usize, name: str) bool {
    val policy: *Policy = policy_at(index);
    if (policy == nil) { ret false; }
    var held: hedge_credentials.Held;
    held.held = false;
    val status: hedge_credentials.Status = hedge_credentials.acquire(?policy.bindings,
        name, ?held);
    if (status != hedge_credentials.OK) { ret false; }
    hedge_credentials.release(?held);
    ret true;
}

# is the generation this policy retired at its last replacement finished with
#
# false both for a policy that has never replaced anything and for one whose
# retired generation still has a connection on it. Callers wanting the second
# meaning should ask `replaceable`, which distinguishes them.
pub fun retired_reclaimable(index: usize) bool {
    val policy: *Policy = policy_at(index);
    if (policy == nil) { ret false; }
    val idle: usize = 1 - policy.active;
    if (!policy.generation_live[idle]) { ret false; }
    ret hedge_credentials.reclaimable(?policy.generations[idle]);
}

# can this policy take a replacement right now
pub fun replaceable(index: usize) bool {
    val policy: *Policy = policy_at(index);
    if (policy == nil) { ret false; }
    val idle: usize = 1 - policy.active;
    # a bank that has never been published is free; one that has is free only
    # once the generation it holds has no connections left on it
    if (!policy.generation_live[idle]) { ret true; }
    ret hedge_credentials.reclaimable(?policy.generations[idle]);
}

# the identities a live listener serves, replaced without restarting it
#
# the new generation answers new handshakes; every established connection keeps
# the one its lease pins, chain and key both, until it closes. The listener
# configuration is untouched because it names the credential store rather than a
# generation, so the swap reaches every connection that arrives after it without
# anything else being republished.
#
# Client trust is not replaceable here. A generation's trust store is borrowed by
# reference, so rewriting it would change what the retired generation presents to
# connections still using it. Changing who a listener trusts is a configuration
# reload, not a credential rotation, and a policy asking for a different setting
# is refused rather than half applied.
pub fun replace(index: usize, configured: *schema.TlsPolicy) Status {
    val policy: *Policy = policy_at(index);
    if (policy == nil || configured == nil) { ret INVALID; }
    if (configured.identity_count == 0) { ret INVALID; }
    if (configured.client_auth != policy.require_client_auth) { ret INVALID; }
    val target: usize = 1 - policy.active;
    if (policy.generation_live[target]) {
        # the previous replacement's retired generation still has a lease on it,
        # and it owns the only other bank. refusing is what keeps this safe
        # rather than usually safe.
        if (!hedge_credentials.reclaimable(?policy.generations[target])) {
            ret RETIRED_IN_USE;
        }
        if (!destroy_bank(policy, target)) { ret INVALID; }
    }
    policy.identity_counts[target] = 0;
    identity_owner = secret.system_allocator();
    var i: usize = 0;
    for (i < configured.identity_count) {
        val loaded: Status = load_identity(policy, target,
            ?configured.identities[i], ?identity_owner);
        if (loaded != OK) {
            # nothing was published, so the listener is still serving the active
            # bank; the half-built one is torn down rather than left to be
            # mistaken for a generation
            destroy_bank(policy, target);
            ret loaded;
        }
        i = i + 1;
    }
    var trust: *cert.TrustStore = nil;
    if (policy.require_client_auth) { trust = ?policy.client_trust; }
    policy.generations[target] = credentials.empty_generation();
    if (credentials.initialize(?policy.generations[target],
        ?policy.published[target][0], policy.identity_counts[target],
        default_index(policy, target, configured), trust,
        policy.require_client_auth) != contracts.OK) {
        destroy_bank(policy, target);
        ret UNSUPPORTED;
    }
    var retired: *credentials.Generation = nil;
    if (hedge_credentials.rotate(?policy.bindings, ?policy.generations[target],
        ?retired) != hedge_credentials.OK || retired == nil) {
        destroy_bank(policy, target);
        ret UNSUPPORTED;
    }
    policy.generation_live[target] = true;
    policy.active = target;
    ret OK;
}

# imports ACME source bytes into the listener-owned idle bank.
pub fun install_acme(index: usize, manager: *acme.Manager) Status {
    val policy: *Policy = policy_at(index);
    if (policy == nil || !acme.certificate_ready(manager)) { ret INVALID; }
    val names: usize = acme.name_count(manager);
    val chain_len: usize = acme.chain_count(manager);
    if (names == 0 || names > MAX_IDENTITIES || chain_len == 0
     || chain_len > MAX_CHAIN) { ret INVALID; }
    val target: usize = 1 - policy.active;
    if (policy.generation_live[target]) {
        if (!hedge_credentials.reclaimable(?policy.generations[target])) {
            ret RETIRED_IN_USE;
        }
        if (!destroy_bank(policy, target)) { ret INVALID; }
    }
    policy.identity_counts[target] = 0;
    identity_owner = secret.system_allocator();
    var name_index: usize = 0;
    for (name_index < names) {
        val slot: usize = policy.identity_counts[target];
        val identity: *Identity = ?policy.identities[target][slot];
        identity.live = false;
        if (!copy_view_name(?identity.name[0], ?identity.name_len,
            acme.name(manager, name_index))) {
            destroy_bank(policy, target);
            ret INVALID;
        }
        var chain_bytes: usize = 0;
        var certificate_index: usize = 0;
        for (certificate_index < chain_len) {
            var encoded: view.View;
            if (!acme.chain_entry(manager, certificate_index, ?encoded)
             || encoded.data == nil || encoded.len == 0) {
                destroy_bank(policy, target);
                ret UNDECODABLE;
            }
            if (encoded.len > MAX_PEM_BYTES - chain_bytes) {
                destroy_bank(policy, target);
                ret EXHAUSTED;
            }
            var byte_index: usize = 0;
            for (byte_index < encoded.len) {
                identity.der[chain_bytes + byte_index] = encoded.data[byte_index];
                byte_index = byte_index + 1;
            }
            if (load.certificate_der(contracts.Bytes{
                data: ?identity.der[chain_bytes], len: encoded.len},
                ?identity.certificates[certificate_index]) != contracts.OK) {
                destroy_bank(policy, target);
                ret UNDECODABLE;
            }
            chain_bytes = chain_bytes + encoded.len;
            certificate_index = certificate_index + 1;
        }
        identity.private_key = keys.empty_private();
        val private_der: contracts.SecretBytes = acme_keys.private_der(
            acme.certificate_key(manager), ?key_scratch[0]);
        val parsed: contracts.Error = load.private_der(private_der,
            cert.PKCS8_DER, ?identity_owner, ?identity.private_key);
        ct.zeroize(?key_scratch[0], MAX_KEY_BYTES);
        if (parsed != contracts.OK) {
            destroy_bank(policy, target);
            ret UNDECODABLE;
        }
        var served: credentials.Identity;
        served.server_name = contracts.Bytes{data: ?identity.name[0],
            len: identity.name_len};
        served.chain = cert.Chain{certificates: ?identity.certificates[0],
            len: chain_len};
        served.private_key = ?identity.private_key;
        policy.published[target][slot] = served;
        identity.live = true;
        policy.identity_counts[target] = slot + 1;
        name_index = name_index + 1;
    }
    var trust: *cert.TrustStore = nil;
    if (policy.require_client_auth) { trust = ?policy.client_trust; }
    policy.generations[target] = credentials.empty_generation();
    if (credentials.initialize(?policy.generations[target],
        ?policy.published[target][0], policy.identity_counts[target], 0, trust,
        policy.require_client_auth) != contracts.OK) {
        destroy_bank(policy, target);
        ret UNSUPPORTED;
    }
    var retired: *credentials.Generation = nil;
    if (hedge_credentials.rotate(?policy.bindings, ?policy.generations[target],
        ?retired) != hedge_credentials.OK || retired == nil) {
        destroy_bank(policy, target);
        ret UNSUPPORTED;
    }
    policy.generation_live[target] = true;
    policy.active = target;
    ret OK;
}

fun select_tls_alpn(store: *credentials.Store, offer: tls_server.CredentialOffer,
    output: *credentials.Lease) contracts.Error {
    if (store == nil || !tls_server.offered_alpn_exactly(offer,
            contracts.Bytes{data: "acme-tls/1"::*u8, len: 10})) {
        ret contracts.UNSUPPORTED;
    }
    ret credentials.acquire(store, offer.server_name, output);
}

pub fun tls_alpn_selector(policy: *Policy) tls_server.CredentialSelector {
    var value: tls_server.CredentialSelector = tls_server.no_credential_selector();
    if (policy == nil || !policy.challenge_enabled) { ret value; }
    value.store = ?policy.challenge_store;
    value.select = select_tls_alpn;
    ret value;
}

pub fun tls_alpn_enabled(index: usize) bool {
    val policy: *Policy = policy_at(index);
    ret policy != nil && policy.challenge_enabled;
}

fun retire_tls_alpn(policy: *Policy) bool {
    if (policy == nil || !policy.challenge_live || policy.challenge_retiring) {
        ret true;
    }
    var retired: *credentials.Generation = nil;
    if (credentials.withdraw_store(?policy.challenge_store, ?retired) !=
            contracts.OK || retired != ?policy.challenge_generation) {
        ret false;
    }
    policy.challenge_retiring = true;
    ret true;
}

fun reap_tls_alpn(policy: *Policy) Status {
    if (policy == nil || !policy.challenge_live) { ret OK; }
    if (!policy.challenge_retiring) {
        ret INVALID;
    }
    if (!credentials.reclaimable(?policy.challenge_generation)) {
        ret RETIRED_IN_USE;
    }
    if (credentials.clear(?policy.challenge_generation) != contracts.OK ||
        keys.destroy_private(?policy.challenge_key) != contracts.OK) {
        ret UNSUPPORTED;
    }
    wipe(?policy.challenge_der[0], MAX_PEM_BYTES);
    policy.challenge_name_len = 0;
    policy.challenge_live = false;
    policy.challenge_retiring = false;
    ret OK;
}

# copies one RFC 8737 certificate and PKCS#8 key into the listener-owned store.
pub fun install_tls_alpn(index: usize, name: view.View, certificate: view.View,
    private_der: contracts.SecretBytes) Status {
    val policy: *Policy = policy_at(index);
    if (policy == nil || !policy.challenge_enabled || name.data == nil ||
        name.len == 0 || name.len >= schema.TEXT_CAP || certificate.data == nil ||
        certificate.len == 0 || certificate.len > MAX_PEM_BYTES ||
        private_der.data == nil || private_der.len == 0 ||
        private_der.len > MAX_KEY_BYTES) { ret INVALID; }
    if (policy.challenge_live) {
        if (!policy.challenge_retiring) { ret INVALID; }
        val reaped: Status = reap_tls_alpn(policy);
        if (reaped != OK) { ret reaped; }
    }
    var i: usize = 0;
    for (i < certificate.len) {
        policy.challenge_der[i] = certificate.data[i];
        i = i + 1;
    }
    if (!copy_view_name(?policy.challenge_name[0], ?policy.challenge_name_len,
            name)) {
        wipe(?policy.challenge_der[0], MAX_PEM_BYTES);
        ret INVALID;
    }
    policy.challenge_certificate = cert.Certificate{der: ?policy.challenge_der[0],
        der_len: certificate.len};
    policy.challenge_key = keys.empty_private();
    if (load.private_der(private_der, cert.PKCS8_DER, ?identity_owner,
            ?policy.challenge_key) != contracts.OK) {
        wipe(?policy.challenge_der[0], MAX_PEM_BYTES);
        policy.challenge_name_len = 0;
        ret UNDECODABLE;
    }
    policy.challenge_identity = credentials.Identity{
        server_name: contracts.Bytes{data: ?policy.challenge_name[0],
            len: policy.challenge_name_len},
        chain: cert.Chain{certificates: ?policy.challenge_certificate, len: 1},
        private_key: ?policy.challenge_key};
    policy.challenge_generation = credentials.empty_generation();
    if (credentials.initialize_tls_alpn_challenge(?policy.challenge_generation,
            ?policy.challenge_identity) != contracts.OK ||
        credentials.publish_store(?policy.challenge_store,
            ?policy.challenge_generation) != contracts.OK) {
        keys.destroy_private(?policy.challenge_key);
        wipe(?policy.challenge_der[0], MAX_PEM_BYTES);
        policy.challenge_name_len = 0;
        policy.challenge_generation = credentials.empty_generation();
        ret UNSUPPORTED;
    }
    policy.challenge_live = true;
    policy.challenge_retiring = false;
    ret OK;
}

pub fun withdraw_tls_alpn(index: usize) Status {
    val policy: *Policy = policy_at(index);
    if (policy == nil || !policy.challenge_live) { ret INVALID; }
    if (!retire_tls_alpn(policy)) { ret UNSUPPORTED; }
    val reaped: Status = reap_tls_alpn(policy);
    if (reaped != OK && reaped != RETIRED_IN_USE) { ret reaped; }
    ret OK;
}

pub fun maintain() bool {
    var success: bool = true;
    var i: usize = 0;
    for (i < policy_count) {
        val policy: *Policy = ?policies[i];
        if (policy.challenge_live && policy.challenge_retiring) {
            val reaped: Status = reap_tls_alpn(policy);
            if (reaped != OK && reaped != RETIRED_IN_USE) { success = false; }
        }
        i = i + 1;
    }
    ret success;
}

pub fun destroy() bool {
    var success: bool = true;
    var i: usize = 0;
    for (i < policy_count) {
        val policy: *Policy = ?policies[i];
        if (!retire_tls_alpn(policy)) { success = false; }
        val reaped: Status = reap_tls_alpn(policy);
        if (reaped != OK) { success = false; }
        destroy_resumption(policy);
        if (!destroy_bank(policy, 0)) { success = false; }
        if (!destroy_bank(policy, 1)) { success = false; }
        policy.live = false;
        i = i + 1;
    }
    policy_count = 0;
    ret success;
}

test "tls: a policy offers the listener's protocols in the listener's order" {
    var policy: Policy;
    policy.alpn_len = 0;
    offer_protocols(?policy, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2);
    if (policy.alpn_len != 2) { ret 1; }
    # h2 is offered first, so a client listing http/1.1 first still gets h2
    if (policy.alpn[0].len != 2 || policy.alpn[0].data[0] != 'h'
     || policy.alpn[0].data[1] != '2') { ret 2; }
    if (policy.alpn[1].len != 8 || policy.alpn[1].data[0] != 'h') { ret 3; }

    offer_protocols(?policy, schema.PROTOCOL_HTTP1);
    if (policy.alpn_len != 1 || policy.alpn[0].len != 8) { ret 4; }

    offer_protocols(?policy, schema.PROTOCOL_HTTP2);
    if (policy.alpn_len != 1 || policy.alpn[0].len != 2) { ret 5; }

    # loader validation confines h3 to quic listeners
    offer_protocols(?policy, schema.PROTOCOL_HTTP3);
    if (policy.alpn_len != 1 || policy.alpn[0].len != 2
     || policy.alpn[0].data[0] != 'h' || policy.alpn[0].data[1] != '3') {
        ret 6;
    }
    ret 0;
}

test "tls: the handshake storage a listener configuration needs is bounded" {
    var policy: Policy;
    policy.entropy = secret.system_entropy();
    policy.alpn_len = 0;
    # the widest offer this listener can make, which is what sizes the flight
    offer_protocols(?policy, schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2);
    policy.require_alpn = true;
    policy.bindings.store = credentials.empty_store();
    policy.bindings.live = false;
    policy.tickets_live = false;
    policy.replay_live = false;
    # the same call the listener makes, so an oversized configuration is caught
    # here rather than at the first handshake
    if (build_configuration(?policy) != OK) { ret 1; }
    if (policy.configuration.limits.max_peer_handshake_bytes != HANDSHAKE_INPUT_BYTES) {
        ret 2;
    }
    if (policy.configuration.limits.max_client_hello_bytes != HELLO_BYTES) { ret 3; }
    if (!policy.configuration.require_alpn || policy.configuration.alpn_len != 2) {
        ret 4;
    }
    # TLS 1.3 only: a listener configured here cannot be talked down a version
    if (policy.configuration.version_len != 1
     || policy.configuration.versions[0] != tls13.VERSION) { ret 5; }
    ret 0;
}

test "tls: a policy naming a certificate that cannot be read is refused" {
    reset();
    var configured: schema.TlsPolicy;
    schema.set_text(?configured.name, "public");
    configured.identity_count = 1;
    schema.clear_text(?configured.identities[0].server_name);
    schema.set_text(?configured.identities[0].certificate, "no/such/file.pem");
    schema.set_text(?configured.identities[0].key, "no/such/file.key");
    configured.has_default = true;
    schema.clear_text(?configured.default_name);
    configured.client_auth = false;
    schema.clear_text(?configured.client_trust);
    configured.resumption.enabled = false;
    # nothing is published, so a listener referencing this policy cannot start
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != UNREADABLE) {
        ret 1;
    }
    if (count() != 0 || find("secure") != NO_POLICY) { ret 2; }
    if (policy_at(0) != nil) { ret 3; }
    # and a policy with no identity at all is not a policy
    configured.identity_count = 0;
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != INVALID) { ret 4; }
    if (count() != 0) { ret 5; }
    ret 0;
}


# --- replacement tests ---
#
# two self-signed Ed25519 identities under different names, so which generation a
# lease is pinned to is decidable by looking at the certificate it hands back.

val api_cert_pem: str = "-----BEGIN CERTIFICATE-----\nMIIBhjCCATigAwIBAgIUb1yMHSXgfQwYEQyY37QwWtTUVfMwBQYDK2VwMBkxFzAV\nBgNVBAMMDmFwaS5oZWRnZS50ZXN0MB4XDTI2MDgyOTAzNDQ1MVoXDTM2MDgyNjAz\nNDQ1MVowGTEXMBUGA1UEAwwOYXBpLmhlZGdlLnRlc3QwKjAFBgMrZXADIQC6GbDj\nK+V+WR5whTjn+IHlf+2kR5/3HNyHoPA271PhLKOBkTCBjjAdBgNVHQ4EFgQU2Ucc\nT9sn30693AkomFKf64g+djowHwYDVR0jBBgwFoAU2UccT9sn30693AkomFKf64g+\ndjowGQYDVR0RBBIwEIIOYXBpLmhlZGdlLnRlc3QwDgYDVR0PAQH/BAQDAgeAMBMG\nA1UdJQQMMAoGCCsGAQUFBwMBMAwGA1UdEwEB/wQCMAAwBQYDK2VwA0EA8KdvXtof\nftWx7/8unun/tMfnuk6UJPliBSRaKZOKwAMgv+h2yVgkTlrqBbfSajC2jbKLICdK\ncJHdzizPtTmRBg==\n-----END CERTIFICATE-----\n";
val api_key_pem: str = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIBRn6QSXLVl2hvtWrT5gXwgtwIJ3Uh0xz+u7ILSYzppC\n-----END PRIVATE KEY-----\n";
val alt_cert_pem: str = "-----BEGIN CERTIFICATE-----\nMIIBhjCCATigAwIBAgIULpeD/Z6xJFleF615bsyI5sfkSb8wBQYDK2VwMBkxFzAV\nBgNVBAMMDmFsdC5oZWRnZS50ZXN0MB4XDTI2MDgyOTAzNDQ1MVoXDTM2MDgyNjAz\nNDQ1MVowGTEXMBUGA1UEAwwOYWx0LmhlZGdlLnRlc3QwKjAFBgMrZXADIQCptZaN\njojjbakhNU+QrolGuk4fHY9FSeDu8kZhG1dvZqOBkTCBjjAdBgNVHQ4EFgQU8ahq\npbXhN63cmoxygs2boRFx8gkwHwYDVR0jBBgwFoAU8ahqpbXhN63cmoxygs2boRFx\n8gkwGQYDVR0RBBIwEIIOYWx0LmhlZGdlLnRlc3QwDgYDVR0PAQH/BAQDAgeAMBMG\nA1UdJQQMMAoGCCsGAQUFBwMBMAwGA1UdEwEB/wQCMAAwBQYDK2VwA0EAbt5MDK9w\nwcy5lOp7RrHPo+vmnT93g+DGbc5H25V1r2GUdZVT2Ka244ST/+5R1i63N5rAcjeo\nr1Cu4LdqaBGZDw==\n-----END CERTIFICATE-----\n";
val alt_key_pem: str = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIIfXVNkxUdAtSzSVA3Xa5kn+qynPTJrWpHN1QvINItju\n-----END PRIVATE KEY-----\n";

fun write_pem(path: str, contents: str) bool {
    var length: usize = 0;
    for (contents[length] != 0) { length = length + 1; }
    ret !option.is_some[str](filesystem.write_bytes(path, contents::*u8, length, 420));
}

fun ensure_dir(path: str) bool {
    if (filesystem.is_dir(path)) { ret true; }
    ret !option.is_some[str](filesystem.create_dir(path, 493));
}

# every test runs as its own process and they run at once, so each writes its
# material into its own directory. Sharing one would have them truncating and
# rewriting the same files while another was reading them, which shows up as a
# publish that fails perhaps one run in three.
var path_storage: [2][64]u8;

fun joined(dir: str, leaf: str, slot: usize) str {
    var at: usize = 0;
    for (dir[at] != 0 && at < 48) { path_storage[slot][at] = dir[at]; at = at + 1; }
    path_storage[slot][at] = '/';
    at = at + 1;
    var i: usize = 0;
    for (leaf[i] != 0 && at + i < 62) {
        path_storage[slot][at + i] = leaf[i];
        i = i + 1;
    }
    path_storage[slot][at + i] = 0;
    ret (?path_storage[slot][0])::str;
}

fun material_written(dir: str) bool {
    if (!ensure_dir("out") || !ensure_dir(dir)) { ret false; }
    ret write_pem(joined(dir, "api.pem", 0), api_cert_pem)
     && write_pem(joined(dir, "api.key", 0), api_key_pem)
     && write_pem(joined(dir, "alt.pem", 0), alt_cert_pem)
     && write_pem(joined(dir, "alt.key", 0), alt_key_pem);
}

fun configure(configured: *schema.TlsPolicy, name: str, cert_path: str,
    key_path: str) {
    schema.set_text(?configured.name, "public");
    configured.identity_count = 1;
    schema.set_text(?configured.identities[0].server_name, name);
    schema.set_text(?configured.identities[0].certificate, cert_path);
    schema.set_text(?configured.identities[0].key, key_path);
    configured.has_default = false;
    schema.clear_text(?configured.default_name);
    configured.client_auth = false;
    schema.clear_text(?configured.client_trust);
    configured.resumption.enabled = false;
}

fun api_policy(configured: *schema.TlsPolicy, dir: str) {
    configure(configured, "api.hedge.test", joined(dir, "api.pem", 0),
        joined(dir, "api.key", 1));
}

fun alt_policy(configured: *schema.TlsPolicy, dir: str) {
    configure(configured, "alt.hedge.test", joined(dir, "alt.pem", 0),
        joined(dir, "alt.key", 1));
}

test "tls: configured session keys rotate and retain their exact overlap" {
    reset();
    if (!material_written("out/tls-resumption")) { destroy(); ret 1; }
    var configured: schema.TlsPolicy;
    api_policy(?configured, "out/tls-resumption");
    configured.resumption.enabled = true;
    configured.resumption.key_lifetime_seconds = 60;
    configured.resumption.retirement_overlap_seconds = 30;
    configured.resumption.ticket_lifetime_seconds = 120;
    configured.resumption.replay_policy = schema.TLS_REPLAY_SINGLE_USE;
    configured.resumption.tickets_per_connection = 2;
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) {
        destroy(); ret 2;
    }
    val index: usize = find("secure");
    val policy: *Policy = policy_at(index);
    if (policy == nil || !policy.tickets_live || !policy.replay_live
     || policy.configuration.tickets != ?policy.ticket_ring
     || policy.configuration.replay != ?policy.replay_window
     || policy.configuration.replay_policy != session.REPLAY_SINGLE_USE
     || policy.configuration.tickets_per_connection != 2) {
        destroy(); ret 3;
    }
    val first: u64 = session.keyring_generation(?policy.ticket_ring);
    val boundary: i64 = policy.ticket_rotate_at;
    if (first == 0 || !prepare(index, boundary)
     || session.keyring_generation(?policy.ticket_ring) != first) {
        destroy(); ret 4;
    }
    if (!prepare(index, boundary + 1)
     || session.keyring_generation(?policy.ticket_ring) != first + 1
     || session.keyring_openable(?policy.ticket_ring, boundary + 1) != 2
     || policy.ticket_rotate_at != boundary + 61) {
        destroy(); ret 5;
    }
    reset();
    if (count() != 0 || policy.tickets_live || policy.replay_live
     || policy.ticket_ring.initialized) { ret 6; }
    ret 0;
}

# the certificate bytes a held lease resolves to, which names its generation
fun leased_der(held: *hedge_credentials.Held) *u8 {
    ret held.lease.identity.chain.certificates.der;
}

test "tls: a replacement serves new connections and leaves established ones alone" {
    reset();
    if (!material_written("out/tls-serve")) { destroy(); ret 1; }
    var configured: schema.TlsPolicy;
    api_policy(?configured, "out/tls-serve");
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) { destroy(); ret 2; }
    val index: usize = find("secure");
    if (index == NO_POLICY) { destroy(); ret 3; }
    val policy: *Policy = policy_at(index);
    if (policy == nil || policy.active != 0) { destroy(); ret 4; }

    # a connection established before the replacement
    var established: hedge_credentials.Held;
    established.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "api.hedge.test",
        ?established) != hedge_credentials.OK) { destroy(); ret 5; }
    val original: *u8 = leased_der(?established);
    if (original == nil) { destroy(); ret 6; }

    if (!replaceable(index)) { destroy(); ret 7; }
    var replacement: schema.TlsPolicy;
    alt_policy(?replacement, "out/tls-serve");
    if (replace(index, ?replacement) != OK) { destroy(); ret 8; }
    # the replacement went into the other bank, and that bank is now serving
    if (policy.active != 1) { destroy(); ret 9; }

    # the established connection still reads the certificate it handshook against
    if (leased_der(?established) != original) { destroy(); ret 10; }
    # and the name it was issued for no longer resolves for a new connection,
    # which is what proves the store is answering from the replacement
    var stale: hedge_credentials.Held;
    stale.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "api.hedge.test", ?stale)
        == hedge_credentials.OK) { destroy(); ret 11; }

    # a connection established after it gets the new certificate
    var fresh: hedge_credentials.Held;
    fresh.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "alt.hedge.test", ?fresh)
        != hedge_credentials.OK) { destroy(); ret 12; }
    if (leased_der(?fresh) == original || leased_der(?fresh) == nil) { destroy(); ret 13; }

    hedge_credentials.release(?established);
    hedge_credentials.release(?fresh);
    destroy();
    ret 0;
}

test "tls: a retired generation is reclaimable only once its last lease is released" {
    reset();
    if (!material_written("out/tls-reclaim")) { destroy(); ret 1; }
    var configured: schema.TlsPolicy;
    api_policy(?configured, "out/tls-reclaim");
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) { destroy(); ret 2; }
    val index: usize = find("secure");
    val policy: *Policy = policy_at(index);
    if (policy == nil) { destroy(); ret 3; }
    # nothing has been retired yet, so there is nothing to reclaim
    if (retired_reclaimable(index)) { destroy(); ret 4; }

    var established: hedge_credentials.Held;
    established.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "api.hedge.test",
        ?established) != hedge_credentials.OK) { destroy(); ret 5; }

    var replacement: schema.TlsPolicy;
    alt_policy(?replacement, "out/tls-reclaim");
    if (replace(index, ?replacement) != OK) { destroy(); ret 6; }
    # the lease pins the retired generation, so its storage cannot be reused
    if (retired_reclaimable(index)) { destroy(); ret 7; }
    if (replaceable(index)) { destroy(); ret 8; }

    if (hedge_credentials.release(?established) != hedge_credentials.OK) {
        destroy(); ret 9;
    }
    # and only now does the bank it occupies come free
    if (!retired_reclaimable(index)) { destroy(); ret 10; }
    if (!replaceable(index)) { destroy(); ret 11; }
    destroy();
    ret 0;
}

# the property that makes two banks sufficient rather than merely usually
# sufficient: a third generation has nowhere to go while the first is still read
test "tls: a replacement is refused while the retired generation is still leased" {
    reset();
    if (!material_written("out/tls-refuse")) { destroy(); ret 1; }
    var configured: schema.TlsPolicy;
    api_policy(?configured, "out/tls-refuse");
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) { destroy(); ret 2; }
    val index: usize = find("secure");
    val policy: *Policy = policy_at(index);
    if (policy == nil) { destroy(); ret 3; }

    var established: hedge_credentials.Held;
    established.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "api.hedge.test",
        ?established) != hedge_credentials.OK) { destroy(); ret 4; }
    val original: *u8 = leased_der(?established);

    var replacement: schema.TlsPolicy;
    alt_policy(?replacement, "out/tls-refuse");
    if (replace(index, ?replacement) != OK) { destroy(); ret 5; }

    # the second replacement has no bank to build in, because the first retired
    # generation is still being read by the established connection
    var again: schema.TlsPolicy;
    api_policy(?again, "out/tls-refuse");
    if (replace(index, ?again) != RETIRED_IN_USE) { destroy(); ret 6; }
    # and the refusal changed nothing: the same generation is still serving and
    # the established lease still reads its own certificate
    if (policy.active != 1) { destroy(); ret 7; }
    if (leased_der(?established) != original) { destroy(); ret 8; }
    var current: hedge_credentials.Held;
    current.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "alt.hedge.test", ?current)
        != hedge_credentials.OK) { destroy(); ret 9; }
    hedge_credentials.release(?current);

    # once the lease goes, the same replacement is accepted
    hedge_credentials.release(?established);
    if (replace(index, ?again) != OK) { destroy(); ret 10; }
    if (policy.active != 0) { destroy(); ret 11; }
    var restored: hedge_credentials.Held;
    restored.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "api.hedge.test", ?restored)
        != hedge_credentials.OK) { destroy(); ret 12; }
    hedge_credentials.release(?restored);
    destroy();
    ret 0;
}

test "tls: a replacement that cannot be loaded leaves the listener serving" {
    reset();
    if (!material_written("out/tls-partial")) { destroy(); ret 1; }
    var configured: schema.TlsPolicy;
    api_policy(?configured, "out/tls-partial");
    if (publish("secure", ?configured, schema.PROTOCOL_HTTP1) != OK) { destroy(); ret 2; }
    val index: usize = find("secure");
    val policy: *Policy = policy_at(index);
    if (policy == nil) { destroy(); ret 3; }

    # the first identity loads and the second does not, so the failure happens
    # with a half-filled bank holding a live key rather than an empty one
    var broken: schema.TlsPolicy;
    configure(?broken, "alt.hedge.test", joined("out/tls-partial", "alt.pem", 0),
        joined("out/tls-partial", "alt.key", 1));
    broken.identity_count = 2;
    schema.set_text(?broken.identities[1].server_name, "missing.hedge.test");
    schema.set_text(?broken.identities[1].certificate, "no/such/file.pem");
    schema.set_text(?broken.identities[1].key, "no/such/file.key");
    if (replace(index, ?broken) != UNREADABLE) { destroy(); ret 4; }
    # nothing was published, so the original generation is still the live one
    if (policy.active != 0) { destroy(); ret 5; }
    if (policy.identity_counts[1] != 0 || policy.generation_live[1]) { destroy(); ret 6; }
    var held: hedge_credentials.Held;
    held.held = false;
    if (hedge_credentials.acquire(?policy.bindings, "api.hedge.test", ?held)
        != hedge_credentials.OK) { destroy(); ret 7; }
    hedge_credentials.release(?held);
    # and the failure did not consume the free bank
    if (!replaceable(index)) { destroy(); ret 8; }

    # client trust is fixed for the life of a policy, so a replacement that asks
    # for a different setting is refused rather than half applied
    var trusted: schema.TlsPolicy;
    alt_policy(?trusted, "out/tls-partial");
    trusted.client_auth = true;
    if (replace(index, ?trusted) != INVALID) { destroy(); ret 9; }
    if (policy.active != 0) { destroy(); ret 10; }
    destroy();
    ret 0;
}
