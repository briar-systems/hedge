# checked fixed-capacity contracts shared by the listener and quic runtime

use std.types.size.usize;
use schema: hedge.config.schema;
use assembly: quic.connection.assembly;

pub val MAX_PUMPS: usize = schema.MAX_LISTENERS;
pub val ADMISSION_BANKS: usize = 2;
pub val STATELESS_SENDS: usize = 4;

pub fun operation_capacity_required(connection_capacity: usize,
    pump_capacity: usize) usize {
    val extra_per_connection: usize = assembly.SEND_CAPACITY - 1;
    if (connection_capacity == 0 || pump_capacity == 0
     || pump_capacity > MAX_PUMPS
     || connection_capacity > (-1)::usize / extra_per_connection) {
        ret 0;
    }
    val connections: usize = connection_capacity * extra_per_connection;
    val per_pump: usize = 1 + STATELESS_SENDS;
    if (pump_capacity > (-1)::usize / per_pump) { ret 0; }
    val pumps: usize = pump_capacity * per_pump;
    if (connections > (-1)::usize - pumps) { ret 0; }
    ret connections + pumps;
}

pub fun admission_capacity_required(connection_capacity: usize,
    pump_capacity: usize) usize {
    if (connection_capacity == 0 || pump_capacity == 0
     || pump_capacity > MAX_PUMPS
     || pump_capacity > (-1)::usize / ADMISSION_BANKS) { ret 0; }
    val banks: usize = pump_capacity * ADMISSION_BANKS;
    if (connection_capacity > (-1)::usize / banks) { ret 0; }
    ret banks * connection_capacity;
}

test "hedge.protocol.quic.capacity: operation capacity is exact and checked" {
    val per_connection: usize = assembly.SEND_CAPACITY - 1;
    val per_pump: usize = 1 + STATELESS_SENDS;
    val expected: usize = 3 * per_connection + 2 * per_pump;
    if (operation_capacity_required(0, 1) != 0
     || operation_capacity_required(3, 0) != 0
     || operation_capacity_required(3, 2) != expected
     || operation_capacity_required(1, MAX_PUMPS)
        != per_connection + MAX_PUMPS * per_pump
     || operation_capacity_required(1, MAX_PUMPS + 1) != 0
     || operation_capacity_required(
        ((-1)::usize / per_connection) + 1, 1) != 0) { ret 1; }
    ret 0;
}

test "hedge.protocol.quic.capacity: admission capacity is exact and checked" {
    val banks: usize = MAX_PUMPS * ADMISSION_BANKS;
    if (admission_capacity_required(0, 1) != 0
     || admission_capacity_required(3, 0) != 0
     || admission_capacity_required(3, 2) != 6 * ADMISSION_BANKS
     || admission_capacity_required(1, MAX_PUMPS) != banks
     || admission_capacity_required(1, MAX_PUMPS + 1) != 0
     || admission_capacity_required(((-1)::usize / banks) + 1,
        MAX_PUMPS) != 0) { ret 1; }
    ret 0;
}
