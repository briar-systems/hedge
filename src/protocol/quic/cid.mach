# the connection IDs one worker mints and every worker decodes
#
# a server CID is 20 bytes, the most RFC 9000 17.2 allows, laid out as
# draft-ietf-quic-load-balancers-21 describes (an expired draft, followed for
# its construction):
#
#   octet 0       config rotation codepoint (3 bits) | 5 random bits
#   octets 1..19  host(h) | worker(1) | slot(4) | counter(8) | random(6 - h),
#                 encrypted with the draft's four-pass construction (5.4.2)
#                 under the codepoint's key
#
# h is the codepoint's host ID length, 0 to 2 octets. it is zero unless an
# operator's key file sets it, and h = 0 is the layout with no host at all.
# the host and worker are the QUIC-LB server ID and the rest its nonce. a CID
# that decodes to another host's ID is that host's, never this one's. the counter starts
# at random for each codepoint and never repeats under one key, which is the
# draft's rule that a nonce is not reused (9.6). the plaintext is 19 bytes, not
# 16, so the construction is a four-round Feistel network whose round function
# is AES-128 (5.4.2), and it needs only the forward cipher. a slot of NO_SLOT is
# a CID minted before its connection has a slot: a Retry's source.
#
# decoding names the worker and slot. it proves nothing on its own: the owner
# accepts the datagram only when the slot's connection holds these exact bytes.
#
# the stateless reset token of a CID is HMAC-SHA256 under its codepoint's reset
# key, truncated to 16 bytes (RFC 9000 10.3.2).

use crypto.cipher.aes;
use crypto.contracts;
use crypto.hmac;
use hedge.protocol.quic.keyfile;
use hedge.protocol.quic.keys;
use std.crypto.ct;
use random:   std.crypto.rand;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

pub val BYTES:             usize = 20;
pub val PLAINTEXT:         usize = 19;
pub val RESET_TOKEN_BYTES: usize = 16;
pub val NO_SLOT:           u32   = 0xffffffff;
val     MAX_HALF:          usize = 10;

pub def Status: u8;
pub val DECODED: Status = 1;
# not a CID this listener minted under a codepoint it still keys
pub val UNROUTABLE: Status = 2;
# a CID another host sharing the listener's keys minted
pub val FOREIGN: Status = 3;

pub rec Decoded {
    status:    Status;
    codepoint: u8;
    host:      u32;
    worker:    usize;
    slot:      u32;
}

# one codepoint's expanded key as a worker holds it, the host ID length its
# CIDs carry, and its minting counter
pub rec Installed {
    context:        aes.Context;
    sequence:       i64;
    host_id_length: u8;
    counter:        u64;
}

# a worker's codec for one listener
pub rec Codec {
    listener:  *keys.Listener;
    host:      u32;
    worker:    usize;
    installed: [keys.CODEPOINTS]Installed;
    live:      bool;
}

fun unroutable() Decoded {
    ret Decoded{status: UNROUTABLE, codepoint: keys.UNROUTABLE, host: 0, worker: 0, slot: 0};
}

# one Feistel round: the 16-byte expansion of `source` (its bytes, zeros, the
# plaintext length and the pass) is encrypted, and its first `half` bytes are
# xored into `target`. an odd length keeps only the nibbles each half owns
fun round(context: *aes.Context, length: usize, pass: u8, source: *u8, target: *u8,
    half: usize, right: bool) bool {
    var block:  [aes.BLOCK_SIZE]^u8;
    var output: [aes.BLOCK_SIZE]^u8;
    var i:      usize = 0;
    for (i < half) {
        block[i] = source[i];
        i        = i + 1;
    }
    block[14] = length::u8;
    block[15] = pass;
    if (aes.encrypt_block(context,
        contracts.SecretBytes{data: ?block[0], len: aes.BLOCK_SIZE},
        contracts.SecretBuffer{data: ?output[0], capacity: aes.BLOCK_SIZE})
        != contracts.OK) { ret false; }
    i = 0;
    for (i < half) {
        target[i] = target[i] ^ (output[i]:>u8);
        i         = i + 1;
    }
    if ((length & 1) != 0) {
        if (right) { target[0] = target[0] & 0x0f; }
        or         { target[half - 1] = target[half - 1] & 0xf0; }
    }
    ret true;
}

fun split(input: *u8, length: usize, left: *u8, right: *u8, half: usize) {
    var i: usize = 0;
    for (i < half) {
        left[i]  = input[i];
        right[i] = input[length - half + i];
        i        = i + 1;
    }
    if ((length & 1) != 0) {
        left[half - 1] = left[half - 1] & 0xf0;
        right[0]       = right[0] & 0x0f;
    }
}

fun join(output: *u8, length: usize, left: *u8, right: *u8, half: usize) {
    var i: usize = 0;
    for (i < half) {
        output[i] = left[i];
        i         = i + 1;
    }
    if ((length & 1) != 0) {
        output[half - 1] = left[half - 1] | right[0];
        i                = 1;
        for (i < half) {
            output[half - 1 + i] = right[i];
            i                    = i + 1;
        }
        ret;
    }
    i = 0;
    for (i < half) {
        output[half + i] = right[i];
        i                = i + 1;
    }
}

fun four_pass_length(length: usize) bool {
    ret length >= 5 && length <= PLAINTEXT && length != 16;
}

# the draft's four-pass encryption of `length` bytes. the single-pass case of
# exactly 16 bytes is not this construction and is refused
pub fun encrypt(context: *aes.Context, input: *u8, length: usize, output: *u8) bool {
    if (context == nil || input == nil || output == nil || !four_pass_length(length)) {
        ret false;
    }
    val half:  usize = (length + 1) / 2;
    var left:  [MAX_HALF]u8;
    var right: [MAX_HALF]u8;
    split(input, length, ?left[0], ?right[0], half);
    if (!round(context, length, 1, ?left[0], ?right[0], half, true)
        || !round(context, length, 2, ?right[0], ?left[0], half, false)
        || !round(context, length, 3, ?left[0], ?right[0], half, true)
        || !round(context, length, 4, ?right[0], ?left[0], half, false)) { ret false; }
    join(output, length, ?left[0], ?right[0], half);
    ret true;
}

pub fun decrypt(context: *aes.Context, input: *u8, length: usize, output: *u8) bool {
    if (context == nil || input == nil || output == nil || !four_pass_length(length)) {
        ret false;
    }
    val half:  usize = (length + 1) / 2;
    var left:  [MAX_HALF]u8;
    var right: [MAX_HALF]u8;
    split(input, length, ?left[0], ?right[0], half);
    if (!round(context, length, 4, ?right[0], ?left[0], half, false)
        || !round(context, length, 3, ?left[0], ?right[0], half, true)
        || !round(context, length, 2, ?right[0], ?left[0], half, false)
        || !round(context, length, 1, ?left[0], ?right[0], half, true)) { ret false; }
    join(output, length, ?left[0], ?right[0], half);
    ret true;
}

pub fun make(codec: *Codec, listener: *keys.Listener, worker: usize) bool {
    if (codec == nil || listener == nil || worker > 0xff) { ret false; }
    codec.listener = listener;
    codec.host     = listener.host_id;
    codec.worker   = worker;
    var i: usize = 0;
    for (i < keys.CODEPOINTS) {
        codec.installed[i].context  = aes.empty();
        codec.installed[i].sequence = 0;
        codec.installed[i].counter  = 0;
        i                           = i + 1;
    }
    codec.live = true;
    ret true;
}

pub fun destroy(codec: *Codec) {
    if (codec == nil || !codec.live) { ret; }
    var i: usize = 0;
    for (i < keys.CODEPOINTS) {
        aes.dnit(?codec.installed[i].context);
        codec.installed[i].sequence = 0;
        i                           = i + 1;
    }
    codec.live = false;
}

# the expanded key of `codepoint`, taken from the listener when this worker's
# copy is missing or stale. nil when the codepoint is not keyed
fun context_for(codec: *Codec, codepoint: usize) *aes.Context {
    if (!codec.live || codepoint >= keys.CODEPOINTS) { ret nil; }
    val installed: *Installed = ?codec.installed[codepoint];
    if (installed.sequence != 0
        && keys.still_keyed(codec.listener, codepoint, installed.sequence)) {
        ret ?installed.context;
    }
    aes.dnit(?installed.context);
    installed.sequence = 0;
    var key:      [keys.CID_KEY_BYTES]^u8;
    var length:   u8  = 0;
    val sequence: i64 = keys.take_cid_key(codec.listener, codepoint, ?key[0], ?length);
    if (sequence == 0 || length > keys.MAX_HOST_ID_LENGTH) {
        ct.zeroize(?key[0], keys.CID_KEY_BYTES);
        ret nil;
    }
    val expanded: contracts.Error = aes.init(?installed.context,
        contracts.SecretBytes{data: ?key[0], len: keys.CID_KEY_BYTES});
    ct.zeroize(?key[0], keys.CID_KEY_BYTES);
    if (expanded != contracts.OK) { ret nil; }
    var start:  u64                 = 0;
    val filled: err[io_error.Error] = random.fill((?start)::*u8, 8);
    if (sel filled.err) {
        aes.dnit(?installed.context);
        ret nil;
    }
    installed.counter        = start;
    installed.host_id_length = length;
    installed.sequence       = sequence;
    ret ?installed.context;
}

fun put_u32(output: *u8, value: u32) {
    output[0] = ((value >> 24) & 0xff)::u8;
    output[1] = ((value >> 16) & 0xff)::u8;
    output[2] = ((value >> 8) & 0xff)::u8;
    output[3] = (value & 0xff)::u8;
}

fun get_u32(input: *u8) u32 {
    ret (input[0]::u32 << 24) | (input[1]::u32 << 16) | (input[2]::u32 << 8)
        | input[3]::u32;
}

# mint a CID for `slot` under the listener's current codepoint into `output`,
# BYTES long. the codepoint it was minted under, or keys.UNROUTABLE when the
# codepoint is not keyed or the random source refused
pub fun mint(codec: *Codec, slot: u32, output: *u8) u8 {
    if (codec == nil || output == nil || !codec.live) { ret keys.UNROUTABLE; }
    val codepoint: u8           = keys.current(codec.listener);
    val context:   *aes.Context = context_for(codec, codepoint::usize);
    if (context == nil) { ret keys.UNROUTABLE; }
    var plain:        [PLAINTEXT]u8;
    var random_bytes: [7]u8;
    val filled:       err[io_error.Error] = random.fill(?random_bytes[0], 7);
    if (sel filled.err) { ret keys.UNROUTABLE; }
    val installed: *Installed = ?codec.installed[codepoint::usize];
    val host:      usize      = installed.host_id_length::usize;
    val counter:   u64        = installed.counter;
    installed.counter = counter + 1;
    var i: usize = 0;
    for (i < host) {
        plain[i] = ((codec.host >> ((host - 1 - i) * 8)::u32) & 0xff)::u8;
        i        = i + 1;
    }
    plain[host] = codec.worker::u8;
    put_u32(?plain[host + 1], slot);
    i = 0;
    for (i < 8) {
        plain[host + 5 + i] = ((counter >> ((7 - i) * 8)::u64) & 0xff)::u8;
        i                   = i + 1;
    }
    i = 0;
    for (i < 6 - host) {
        plain[host + 13 + i] = random_bytes[i];
        i                    = i + 1;
    }
    output[0] = (codepoint << 5) | (random_bytes[6] & 0x1f);
    if (!encrypt(context, ?plain[0], PLAINTEXT, ?output[1])) { ret keys.UNROUTABLE; }
    ret codepoint;
}

# which host, worker and slot `id` names. anything but a BYTES-long CID under a
# codepoint this listener still keys is UNROUTABLE, and one naming another host
# is FOREIGN
pub fun decode(codec: *Codec, id: *u8, length: usize) Decoded {
    if (codec == nil || id == nil || length != BYTES || !codec.live) { ret unroutable(); }
    val codepoint: u8 = id[0] >> 5;
    if (codepoint == keys.UNROUTABLE) { ret unroutable(); }
    val context: *aes.Context = context_for(codec, codepoint::usize);
    if (context == nil) { ret unroutable(); }
    var plain: [PLAINTEXT]u8;
    if (!decrypt(context, ?id[1], PLAINTEXT, ?plain[0])) { ret unroutable(); }
    val host_length: usize = codec.installed[codepoint::usize].host_id_length::usize;
    var host:        u32   = 0;
    var i:           usize = 0;
    for (i < host_length) {
        host = (host << 8) | plain[i]::u32;
        i    = i + 1;
    }
    var status: Status = DECODED;
    if (host != codec.host) { status = FOREIGN; }
    ret Decoded{status: status, codepoint: codepoint, host: host,
        worker: plain[host_length]::usize, slot: get_u32(?plain[host_length + 1])};
}

# whether `left` and `right` hold the same BYTES, in time that does not depend
# on where they differ
pub fun same(left: *u8, right: *u8) bool {
    var difference: u8    = 0;
    var i:          usize = 0;
    for (i < BYTES) {
        difference = difference | (left[i] ^ right[i]);
        i          = i + 1;
    }
    ret difference == 0;
}

# the stateless reset token of `id` into `output`, RESET_TOKEN_BYTES long.
# false when its codepoint is not keyed
pub fun reset_token(listener: *keys.Listener, id: *u8, output: *u8) bool {
    if (listener == nil || id == nil || output == nil) { ret false; }
    var key:      [keys.RESET_KEY_BYTES]^u8;
    val sequence: i64 = keys.take_reset_key(listener, (id[0] >> 5)::usize, ?key[0]);
    if (sequence == 0) { ret false; }
    var tag:  [hmac.SHA256_TAG_SIZE]u8;
    val made: contracts.Operation = hmac.sha256(
        contracts.SecretBytes{data: ?key[0], len: keys.RESET_KEY_BYTES},
        contracts.Bytes{data: id, len: BYTES},
        contracts.Buffer{data: ?tag[0], capacity: hmac.SHA256_TAG_SIZE});
    ct.zeroize(?key[0], keys.RESET_KEY_BYTES);
    if (made.error != contracts.OK) { ret false; }
    var i: usize = 0;
    for (i < RESET_TOKEN_BYTES) {
        output[i] = tag[i];
        i         = i + 1;
    }
    ret true;
}

#[testing]
fun hex_byte(high: u8, low: u8) u8 {
    ret (nibble(high) << 4) | nibble(low);
}

#[testing]
fun nibble(c: u8) u8 {
    if (c >= 'a') { ret c - 'a' + 10; }
    ret c - '0';
}

#[testing]
fun from_hex(text: *u8, output: *u8) usize {
    var i: usize = 0;
    for (text[i * 2] != 0) {
        output[i] = hex_byte(text[i * 2], text[i * 2 + 1]);
        i         = i + 1;
    }
    ret i;
}

# the draft's encrypted test vectors (Appendix B.2) that use four passes, one
# of them with a server ID longer than its nonce. the key is the draft's
#[testing]
fun vector(context: *aes.Context, plain_hex: *u8, cipher_hex: *u8) bool {
    var plain:    [PLAINTEXT]u8;
    var expected: [PLAINTEXT]u8;
    var got:      [PLAINTEXT]u8;
    var back:     [PLAINTEXT]u8;
    val length:   usize = from_hex(plain_hex, ?plain[0]);
    if (from_hex(cipher_hex, ?expected[0]) != length
        || !encrypt(context, ?plain[0], length, ?got[0])
        || !decrypt(context, ?got[0], length, ?back[0])) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (got[i] != expected[i] || back[i] != plain[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test four_pass__draft_vectors {
    var bytes: [16]u8;
    var key:   [16]^u8;
    from_hex("8f95f09245765f80256934e50c66207f", ?bytes[0]);
    var i: usize = 0;
    for (i < 16) {
        key[i] = bytes[i];
        i      = i + 1;
    }
    var context: aes.Context = aes.empty();
    if (aes.init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.OK) {
        ret 1;
    }
    # sid ed793a, nonce ee080dbf: seven bytes
    if (!vector(?context, "ed793aee080dbf", "20b1d07b359d3c")) { ret 2; }
    # a ten-byte server ID and five-byte nonce: the fourth pass is needed
    if (!vector(?context, "ed793a51d49b8f5fab65ee080dbf48",
        "cc381bc74cb4fbad2823a3d1f8fed2")) { ret 3; }
    # nine and nine: an even length
    if (!vector(?context, "ed793a51d49b8f5fabee080dbf48c0d1e55d",
        "5779c9cc86beb3a3a4a3ca96fce4bfe0cdbc")) { ret 4; }
    var sixteen: [16]u8;
    if (encrypt(?context, ?sixteen[0], 16, ?sixteen[0])) { ret 5; }
    aes.dnit(?context);
    ret 0;
}

# a minted CID decodes to its worker and slot under every codec of its
# listener, and to nothing under another listener's keys
test mint__decodes_to_its_worker_and_slot {
    if (!keys.make(2)) { ret 1; }
    var minting: Codec;
    var other:   Codec;
    var foreign: Codec;
    if (!make(?minting, keys.listener_at(0), 3)
        || !make(?other, keys.listener_at(0), 5)
        || !make(?foreign, keys.listener_at(1), 3)) { ret 2; }
    var first:  [BYTES]u8;
    var second: [BYTES]u8;
    if (mint(?minting, 41, ?first[0]) != 0 || mint(?minting, 41, ?second[0]) != 0) { ret 3; }
    # two CIDs for one slot share nothing an observer can see past octet 0
    if (same(?first[0], ?second[0])) { ret 4; }
    val decoded: Decoded = decode(?other, ?first[0], BYTES);
    if (decoded.status != DECODED || decoded.worker != 3 || decoded.slot != 41
        || decoded.codepoint != 0) { ret 5; }
    val retry: Decoded = decode(?other, ?second[0], BYTES);
    if (retry.status != DECODED || retry.slot != 41) { ret 6; }
    var sentinel: [BYTES]u8;
    if (mint(?minting, NO_SLOT, ?sentinel[0]) != 0
        || decode(?other, ?sentinel[0], BYTES).slot != NO_SLOT) { ret 7; }
    val wrong: Decoded = decode(?foreign, ?first[0], BYTES);
    if (wrong.status == DECODED && wrong.worker == 3 && wrong.slot == 41) { ret 8; }
    if (decode(?other, ?first[0], BYTES - 1).status != UNROUTABLE)        { ret 9; }
    # a codepoint that was never keyed decodes to nothing
    first[0] = (first[0] & 0x1f) | (2 << 5);
    if (decode(?other, ?first[0], BYTES).status != UNROUTABLE) { ret 10; }
    first[0] = first[0] | 0xe0;
    if (decode(?other, ?first[0], BYTES).status != UNROUTABLE) { ret 11; }
    destroy(?minting);
    destroy(?other);
    destroy(?foreign);
    keys.destroy();
    ret 0;
}

# after a rotation new CIDs carry the new codepoint while the old ones still
# decode, and once the old codepoint is retired they no longer do
test mint__rotation_keeps_old_ids_until_retired {
    if (!keys.make(1)) { ret 1; }
    val listener: *keys.Listener = keys.listener_at(0);
    var codec:    Codec;
    if (!make(?codec, listener, 0)) { ret 2; }
    var old: [BYTES]u8;
    var new: [BYTES]u8;
    if (mint(?codec, 7, ?old[0]) != 0)                                       { ret 3; }
    if (!keys.rotate(listener, 100, 10, 1) || mint(?codec, 8, ?new[0]) != 1) { ret 4; }
    if (decode(?codec, ?old[0], BYTES).slot != 7
        || decode(?codec, ?new[0], BYTES).slot != 8) { ret 5; }
    if (!keys.rotate(listener, 200, 10, 1)) { ret 6; }
    if (decode(?codec, ?old[0], BYTES).status != UNROUTABLE
        || decode(?codec, ?new[0], BYTES).slot != 8) { ret 7; }
    destroy(?codec);
    keys.destroy();
    ret 0;
}

# the reset token is RFC 9000 10.3.2's HMAC over the whole CID: stable for one
# CID, different for another, and gone once its codepoint is
test reset_token__follows_the_codepoint_key {
    if (!keys.make(1)) { ret 1; }
    val listener: *keys.Listener = keys.listener_at(0);
    var codec:    Codec;
    if (!make(?codec, listener, 0)) { ret 2; }
    var id:     [BYTES]u8;
    var twin:   [BYTES]u8;
    var first:  [RESET_TOKEN_BYTES]u8;
    var again:  [RESET_TOKEN_BYTES]u8;
    var second: [RESET_TOKEN_BYTES]u8;
    if (mint(?codec, 1, ?id[0]) != 0 || mint(?codec, 1, ?twin[0]) != 0) { ret 3; }
    if (!reset_token(listener, ?id[0], ?first[0])
        || !reset_token(listener, ?id[0], ?again[0])
        || !reset_token(listener, ?twin[0], ?second[0])) { ret 4; }
    var i:       usize = 0;
    var differs: bool  = false;
    for (i < RESET_TOKEN_BYTES) {
        if (first[i] != again[i])  { ret 5; }
        if (first[i] != second[i]) { differs = true; }
        i = i + 1;
    }
    if (!differs) { ret 6; }
    if (!keys.rotate(listener, 100, 0, 1) || !keys.rotate(listener, 200, 0, 1)
        || reset_token(listener, ?id[0], ?first[0])) { ret 7; }
    destroy(?codec);
    keys.destroy();
    ret 0;
}

# a CID minted under a key file decodes after a restart on the same file, and
# another host sharing the file sees it as foreign
test mint__survives_a_restart_on_its_key_file {
    val text:   str   = "current 1\ncodepoint 1 host_id_length 1 cid 8f95f09245765f80256934e50c66207f reset 00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\ntoken 1 ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100\n";
    var length: usize = 0;
    for (text[length] != 0) { length = length + 1; }
    var file: keys.File;
    if (keyfile.parse(text, length, ?file) != keyfile.OK || !keys.make(1)
        || keys.start_filed(keys.listener_at(0), 5, ?file, 1) != keys.KEYED) { ret 1; }
    var codec: Codec;
    var id:    [BYTES]u8;
    if (!make(?codec, keys.listener_at(0), 3) || mint(?codec, 9, ?id[0]) != 1) { ret 2; }
    destroy(?codec);
    keys.destroy();
    if (keyfile.parse(text, length, ?file) != keyfile.OK || !keys.make(1)
        || keys.start_filed(keys.listener_at(0), 5, ?file, 1) != keys.KEYED
        || !make(?codec, keys.listener_at(0), 4)) { ret 3; }
    val decoded: Decoded = decode(?codec, ?id[0], BYTES);
    if (decoded.status != DECODED || decoded.host != 5 || decoded.worker != 3
        || decoded.slot != 9) { ret 4; }
    destroy(?codec);
    keys.destroy();
    if (keyfile.parse(text, length, ?file) != keyfile.OK || !keys.make(1)
        || keys.start_filed(keys.listener_at(0), 6, ?file, 1) != keys.KEYED
        || !make(?codec, keys.listener_at(0), 3)) { ret 5; }
    val foreign: Decoded = decode(?codec, ?id[0], BYTES);
    if (foreign.status != FOREIGN || foreign.host != 5 || foreign.slot != 9) { ret 6; }
    destroy(?codec);
    keys.destroy();
    if (keyfile.parse(text, length, ?file) != keyfile.OK || !keys.make(1)
        || keys.start_filed(keys.listener_at(0), 256, ?file, 1) != keys.HOST_UNFIT) { ret 7; }
    keys.wipe_file(?file);
    keys.destroy();
    ret 0;
}
