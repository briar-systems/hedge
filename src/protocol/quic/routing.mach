# generation-safe destination cid routing for one udp server

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val MAX_CID_BYTES: usize = 20;

pub def Status: u8;
pub val ROUTE_OK:       Status = 1;
pub val ROUTE_INVALID:  Status = 2;
pub val ROUTE_CONFLICT: Status = 3;
pub val ROUTE_FULL:     Status = 4;
pub val ROUTE_MISSING:  Status = 5;
pub val ROUTE_STALE:    Status = 6;

pub def EntryState: u8;
pub val ENTRY_EMPTY:     EntryState = 1;
pub val ENTRY_LIVE:      EntryState = 2;
pub val ENTRY_TOMBSTONE: EntryState = 3;

pub rec Key {
    bytes:  [MAX_CID_BYTES]u8;
    length: usize;
    valid:  bool;
}

pub rec Binding {
    connection_slot:       usize;
    connection_generation: u64;
    route_index:           usize;
    route_generation:      u64;
    route_sequence:        u64;
    pump_generation:       u64;
}

pub rec Entry {
    key:     Key;
    binding: Binding;
    state:   EntryState;
}

pub rec Table {
    entries:     *Entry;
    capacity:    usize;
    len:         usize;
    initialized: bool;
}

pub rec Lookup {
    status:  Status;
    binding: Binding;
}

pub fun key(data: *u8, length: usize) Key {
    var value: Key;
    value.length = 0;
    value.valid  = false;
    if (data == nil || length == 0 || length > MAX_CID_BYTES) { ret value; }
    var i: usize = 0;
    for (i < length) {
        value.bytes[i] = data[i];
        i              = i + 1;
    }
    value.length = length;
    value.valid  = true;
    ret value;
}

fun same_key(left: Key, right: Key) bool {
    if (!left.valid || !right.valid || left.length != right.length) {
        ret false;
    }
    var i: usize = 0;
    for (i < left.length) {
        if (left.bytes[i] != right.bytes[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_binding(left: Binding, right: Binding) bool {
    ret left.connection_slot == right.connection_slot
        && left.connection_generation == right.connection_generation
        && left.route_index == right.route_index
        && left.route_generation == right.route_generation
        && left.route_sequence == right.route_sequence
        && left.pump_generation == right.pump_generation;
}

fun hash(value: Key) u64 {
    var hashed: u64   = 14695981039346656037;
    var i:      usize = 0;
    for (i < value.length) {
        hashed = hashed ^ value.bytes[i]::u64;
        hashed = hashed * 1099511628211;
        i      = i + 1;
    }
    ret hashed;
}

fun next(index: usize, capacity: usize) usize {
    if (index + 1 == capacity) { ret 0; }
    ret index + 1;
}

pub fun make(table: *Table, entries: *Entry, capacity: usize) bool {
    if (table == nil || entries == nil || capacity == 0) { ret false; }
    table.entries     = entries;
    table.capacity    = capacity;
    table.len         = 0;
    table.initialized = true;
    var i: usize = 0;
    for (i < capacity) {
        entries[i].state      = ENTRY_EMPTY;
        entries[i].key.valid  = false;
        entries[i].key.length = 0;
        i                     = i + 1;
    }
    ret true;
}

fun write(table: *Table, index: usize, wanted: Key,
    binding: Binding) Status {
    table.entries[index].key     = wanted;
    table.entries[index].binding = binding;
    table.entries[index].state   = ENTRY_LIVE;
    table.len                    = table.len + 1;
    ret ROUTE_OK;
}

pub fun publish(table: *Table, wanted: Key, binding: Binding) Status {
    # a connection ID sequence number is zero for the first ID a connection
    # issues, so it carries no validity signal. the generations do.
    if (table == nil || !table.initialized || table.entries == nil
        || table.capacity == 0 || !wanted.valid || wanted.length == 0
        || binding.connection_generation == 0 || binding.route_generation == 0
        || binding.pump_generation == 0) {
        ret ROUTE_INVALID;
    }
    var index:     usize = (hash(wanted) % table.capacity::u64)::usize;
    var tombstone: usize = table.capacity;
    var visited:   usize = 0;
    for (visited < table.capacity) {
        val entry: *Entry = ?table.entries[index];
        if (entry.state == ENTRY_EMPTY) {
            if (tombstone != table.capacity) { index = tombstone; }
            ret write(table, index, wanted, binding);
        }
        if (entry.state == ENTRY_TOMBSTONE && tombstone == table.capacity) {
            tombstone = index;
        }
        if (entry.state == ENTRY_LIVE && same_key(entry.key, wanted)) {
            if (same_binding(entry.binding, binding)) { ret ROUTE_OK; }
            ret ROUTE_CONFLICT;
        }
        index   = next(index, table.capacity);
        visited = visited + 1;
    }
    if (tombstone != table.capacity) {
        ret write(table, tombstone, wanted, binding);
    }
    ret ROUTE_FULL;
}

pub fun lookup(table: *Table, wanted: Key) Lookup {
    var result: Lookup;
    result.status = ROUTE_INVALID;
    if (table == nil || !table.initialized || table.entries == nil
        || table.capacity == 0 || !wanted.valid) { ret result; }
    var index:   usize = (hash(wanted) % table.capacity::u64)::usize;
    var visited: usize = 0;
    for (visited < table.capacity) {
        val entry: *Entry = ?table.entries[index];
        if (entry.state == ENTRY_EMPTY) {
            result.status = ROUTE_MISSING;
            ret result;
        }
        if (entry.state == ENTRY_LIVE && same_key(entry.key, wanted)) {
            result.status  = ROUTE_OK;
            result.binding = entry.binding;
            ret result;
        }
        index   = next(index, table.capacity);
        visited = visited + 1;
    }
    result.status = ROUTE_MISSING;
    ret result;
}

pub fun unpublish(table: *Table, wanted: Key, expected: Binding) Status {
    if (table == nil || !table.initialized || table.entries == nil
        || table.capacity == 0 || !wanted.valid) { ret ROUTE_INVALID; }
    var index:   usize = (hash(wanted) % table.capacity::u64)::usize;
    var visited: usize = 0;
    for (visited < table.capacity) {
        val entry: *Entry = ?table.entries[index];
        if (entry.state == ENTRY_EMPTY) { ret ROUTE_MISSING; }
        if (entry.state == ENTRY_LIVE && same_key(entry.key, wanted)) {
            if (!same_binding(entry.binding, expected)) { ret ROUTE_STALE; }
            entry.state      = ENTRY_TOMBSTONE;
            entry.key.valid  = false;
            entry.key.length = 0;
            if (table.len > 0) { table.len = table.len - 1; }
            ret ROUTE_OK;
        }
        index   = next(index, table.capacity);
        visited = visited + 1;
    }
    ret ROUTE_MISSING;
}

fun test_binding(slot: usize, generation: u64) Binding {
    ret Binding{connection_slot: slot, connection_generation: generation,
        route_index:    slot + 10, route_generation: generation + 10,
        route_sequence: generation + 20, pump_generation: 1};
}

test "hedge.protocol.quic.routing: copied keys survive source reuse" {
    var entries: [2]Entry;
    var table:   Table;
    if (!make(?table, ?entries[0], 2)) { ret 1; }
    var source:  [8]u8   = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    val wanted:  Key     = key(?source[0], 8);
    val binding: Binding = test_binding(0, 1);
    if (publish(?table, wanted, binding) != ROUTE_OK) { ret 2; }
    source[0] = 99;
    val found: Lookup = lookup(?table, wanted);
    if (found.status != ROUTE_OK
        || found.binding.connection_generation != 1) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.routing: collisions remain bounded and reusable" {
    var entries: [2]Entry;
    var table:   Table;
    if (!make(?table, ?entries[0], 2)) { ret 1; }
    var first_bytes:  [1]u8   = [1]u8{1};
    var second_bytes: [1]u8   = [1]u8{3};
    var third_bytes:  [1]u8   = [1]u8{5};
    val first:        Key     = key(?first_bytes[0], 1);
    val second:       Key     = key(?second_bytes[0], 1);
    val third:        Key     = key(?third_bytes[0], 1);
    val one:          Binding = test_binding(0, 1);
    val two:          Binding = test_binding(1, 2);
    val three:        Binding = test_binding(2, 3);
    if (publish(?table, first, one) != ROUTE_OK
        || publish(?table, second, two) != ROUTE_OK
        || publish(?table, third, three) != ROUTE_FULL) { ret 2; }
    if (unpublish(?table, first, one) != ROUTE_OK
        || publish(?table, third, three) != ROUTE_OK) { ret 3; }
    if (lookup(?table, first).status != ROUTE_MISSING
        || lookup(?table, second).status != ROUTE_OK
        || lookup(?table, third).status != ROUTE_OK || table.len != 2) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.routing: stale owners cannot replace or retire routes" {
    var entries: [1]Entry;
    var table:   Table;
    if (!make(?table, ?entries[0], 1)) { ret 1; }
    var bytes:   [8]u8   = [8]u8{9, 8, 7, 6, 5, 4, 3, 2};
    val wanted:  Key     = key(?bytes[0], 8);
    val current: Binding = test_binding(0, 4);
    val stale:   Binding = test_binding(0, 3);
    if (publish(?table, wanted, current) != ROUTE_OK
        || publish(?table, wanted, stale) != ROUTE_CONFLICT) { ret 2; }
    if (unpublish(?table, wanted, stale) != ROUTE_STALE
        || lookup(?table, wanted).status != ROUTE_OK) { ret 3; }
    if (unpublish(?table, wanted, current) != ROUTE_OK
        || lookup(?table, wanted).status != ROUTE_MISSING) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.routing: invalid keys and generations fail closed" {
    var entries: [1]Entry;
    var table:   Table;
    if (!make(?table, ?entries[0], 1)) { ret 1; }
    var bytes:     [21]u8;
    val empty:     Key     = key(?bytes[0], 0);
    val oversized: Key     = key(?bytes[0], 21);
    var invalid:   Binding = test_binding(0, 1);
    invalid.pump_generation = 0;
    if (empty.valid || oversized.valid
        || publish(?table, empty, test_binding(0, 1)) != ROUTE_INVALID
        || publish(?table, key(?bytes[0], 8), invalid) != ROUTE_INVALID) {
        ret 2;
    }
    # the first connection ID a QUIC connection issues is sequence zero, and it
    # has to route: rejecting it made every accepted connection unreachable
    var sequence_zero: Binding = test_binding(0, 1);
    sequence_zero.route_sequence = 0;
    if (publish(?table, key(?bytes[0], 8), sequence_zero) != ROUTE_OK) {
        ret 3;
    }
    val found: Lookup = lookup(?table, key(?bytes[0], 8));
    if (found.status != ROUTE_OK || found.binding.route_sequence != 0) {
        ret 4;
    }
    ret 0;
}
