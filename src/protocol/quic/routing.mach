# generation-safe destination cid routing for one udp server

use A: std.allocator;
use std.allocator.page;
use allocator_testing: std.allocator.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

pub val MAX_CID_BYTES: usize = 20;

pub def Status: u8;
pub val ROUTE_OK:       Status = 1;
pub val ROUTE_INVALID:  Status = 2;
pub val ROUTE_CONFLICT: Status = 3;
pub val ROUTE_FULL:     Status = 4;
pub val ROUTE_MISSING:  Status = 5;
pub val ROUTE_STALE:    Status = 6;

pub def EntryState: u8;
pub val ENTRY_EMPTY:     EntryState = 1;
pub val ENTRY_LIVE:      EntryState = 2;
pub val ENTRY_TOMBSTONE: EntryState = 3;

pub rec Key {
    bytes:  [MAX_CID_BYTES]u8;
    length: usize;
    valid:  bool;
}

# a binding names a connection slot, or a pending initial's slot while the
# Initial waits in the queue: the datagrams a client sends behind its first
# belong to that connection-to-be
pub rec Binding {
    connection_slot:       usize;
    connection_generation: u64;
    route_index:           usize;
    route_generation:      u64;
    route_sequence:        u64;
    pump_generation:       u64;
    pending:               bool;
}

pub rec Entry {
    key:     Key;
    binding: Binding;
    state:   EntryState;
}

# open addressing that owns its entries. live entries plus tombstones stay at or
# under half of capacity, so a probe always meets an empty entry, and reaching
# that bound rehashes into fresh storage. a rehash is the only time an entry
# moves: bindings are copied values, and nothing holds a pointer into the table.
pub rec Table {
    allocator:   *A.Allocator;
    entries:     *Entry;
    capacity:    usize;
    len:         usize;
    used:        usize;
    initialized: bool;
}

pub val MIN_CAPACITY: usize = 16;

pub rec Lookup {
    status:  Status;
    binding: Binding;
}

pub fun key(data: *u8, length: usize) Key {
    var value: Key;
    value.length = 0;
    value.valid  = false;
    if (data == nil || length == 0 || length > MAX_CID_BYTES) { ret value; }
    var i: usize = 0;
    for (i < length) {
        value.bytes[i] = data[i];
        i              = i + 1;
    }
    value.length = length;
    value.valid  = true;
    ret value;
}

fun same_key(left: Key, right: Key) bool {
    if (!left.valid || !right.valid || left.length != right.length) {
        ret false;
    }
    var i: usize = 0;
    for (i < left.length) {
        if (left.bytes[i] != right.bytes[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_binding(left: Binding, right: Binding) bool {
    ret left.connection_slot == right.connection_slot
        && left.connection_generation == right.connection_generation
        && left.route_index == right.route_index
        && left.route_generation == right.route_generation
        && left.route_sequence == right.route_sequence
        && left.pump_generation == right.pump_generation
        && left.pending == right.pending;
}

fun hash(value: Key) u64 {
    var hashed: u64   = 14695981039346656037;
    var i:      usize = 0;
    for (i < value.length) {
        hashed = hashed ^ value.bytes[i]::u64;
        hashed = hashed * 1099511628211;
        i      = i + 1;
    }
    ret hashed;
}

# the key's hash and equality as a map's hooks, for an index of held keys
pub fun key_hash(value: *Key) u64 {
    ret hash(@value);
}

pub fun key_equal(left: *Key, right: *Key) bool {
    ret same_key(@left, @right);
}

fun start(value: Key, capacity: usize) usize {
    ret (hash(value) % capacity::u64)::usize;
}

fun next(index: usize, capacity: usize) usize {
    if (index + 1 == capacity) { ret 0; }
    ret index + 1;
}

# an empty table holds no storage until its first publish
pub fun make(table: *Table, a: *A.Allocator) bool {
    if (table == nil || a == nil) { ret false; }
    table.allocator   = a;
    table.entries     = nil;
    table.capacity    = 0;
    table.len         = 0;
    table.used        = 0;
    table.initialized = true;
    ret true;
}

# every route must have been unpublished first
pub fun destroy(table: *Table) bool {
    if (table == nil || !table.initialized || table.len != 0) { ret false; }
    if (table.entries != nil) {
        val returned: err[A.Error] = A.deallocate[Entry](table.allocator,
            table.entries, table.capacity);
        if (sel returned.err) { ret false; }
    }
    table.entries     = nil;
    table.capacity    = 0;
    table.used        = 0;
    table.initialized = false;
    ret true;
}

# a quarter load after the rehash, so the next one is as far away as this one was
fun capacity_for(live: usize, current: usize) usize {
    var capacity: usize = MIN_CAPACITY;
    for (capacity < current || capacity / 4 < live) {
        if (capacity > (-1)::usize / 2) { ret 0; }
        capacity = capacity * 2;
    }
    ret capacity;
}

fun rehash(table: *Table, live: usize) bool {
    val capacity: usize = capacity_for(live, table.capacity);
    if (capacity == 0) { ret false; }
    val allocated: res[*Entry, A.Error] = A.allocate[Entry](table.allocator, capacity);
    if (sel allocated.err) { ret false; }
    val entries: *Entry = allocated.ok;
    var i:       usize  = 0;
    for (i < capacity) {
        entries[i].state      = ENTRY_EMPTY;
        entries[i].key.valid  = false;
        entries[i].key.length = 0;
        i                     = i + 1;
    }
    i = 0;
    for (i < table.capacity) {
        val moved: *Entry = ?table.entries[i];
        if (moved.state == ENTRY_LIVE) {
            var index: usize = start(moved.key, capacity);
            for (entries[index].state != ENTRY_EMPTY) { index = next(index, capacity); }
            entries[index] = @moved;
        }
        i = i + 1;
    }
    if (table.entries != nil) {
        # the entries are already copied, so a refused free leaks the old array
        # rather than losing a route
        A.deallocate[Entry](table.allocator, table.entries, table.capacity);
    }
    table.entries  = entries;
    table.capacity = capacity;
    table.used     = table.len;
    ret true;
}

fun ready(table: *Table) bool {
    ret table != nil && table.initialized && table.allocator != nil;
}

fun write(table: *Table, index: usize, wanted: Key, binding: Binding,
    reused_tombstone: bool) Status {
    table.entries[index].key     = wanted;
    table.entries[index].binding = binding;
    table.entries[index].state   = ENTRY_LIVE;
    table.len                    = table.len + 1;
    if (!reused_tombstone) { table.used = table.used + 1; }
    ret ROUTE_OK;
}

# ROUTE_FULL means the allocator refused the storage a rehash needed
pub fun publish(table: *Table, wanted: Key, binding: Binding) Status {
    # a connection ID sequence number is zero for the first ID a connection
    # issues, so it carries no validity signal. the generations do.
    if (!ready(table) || !wanted.valid || wanted.length == 0
        || binding.connection_generation == 0 || binding.route_generation == 0
        || binding.pump_generation == 0) {
        ret ROUTE_INVALID;
    }
    if (table.capacity != 0) {
        var index: usize = start(wanted, table.capacity);
        for (table.entries[index].state != ENTRY_EMPTY) {
            val entry: *Entry = ?table.entries[index];
            if (entry.state == ENTRY_LIVE && same_key(entry.key, wanted)) {
                if (same_binding(entry.binding, binding)) { ret ROUTE_OK; }
                ret ROUTE_CONFLICT;
            }
            index = next(index, table.capacity);
        }
    }
    if ((table.used + 1) * 2 > table.capacity && !rehash(table, table.len + 1)) {
        ret ROUTE_FULL;
    }
    var index:     usize = start(wanted, table.capacity);
    var tombstone: bool  = false;
    for (table.entries[index].state != ENTRY_EMPTY) {
        if (table.entries[index].state == ENTRY_TOMBSTONE) {
            tombstone = true;
            brk;
        }
        index = next(index, table.capacity);
    }
    ret write(table, index, wanted, binding, tombstone);
}

pub fun lookup(table: *Table, wanted: Key) Lookup {
    var result: Lookup;
    result.status = ROUTE_INVALID;
    if (!ready(table) || !wanted.valid) { ret result; }
    result.status = ROUTE_MISSING;
    if (table.capacity == 0) { ret result; }
    var index: usize = start(wanted, table.capacity);
    for (table.entries[index].state != ENTRY_EMPTY) {
        val entry: *Entry = ?table.entries[index];
        if (entry.state == ENTRY_LIVE && same_key(entry.key, wanted)) {
            result.status  = ROUTE_OK;
            result.binding = entry.binding;
            ret result;
        }
        index = next(index, table.capacity);
    }
    ret result;
}

pub fun unpublish(table: *Table, wanted: Key, expected: Binding) Status {
    if (!ready(table) || !wanted.valid) { ret ROUTE_INVALID; }
    if (table.capacity == 0)            { ret ROUTE_MISSING; }
    var index: usize = start(wanted, table.capacity);
    for (table.entries[index].state != ENTRY_EMPTY) {
        val entry: *Entry = ?table.entries[index];
        if (entry.state == ENTRY_LIVE && same_key(entry.key, wanted)) {
            if (!same_binding(entry.binding, expected)) { ret ROUTE_STALE; }
            entry.state      = ENTRY_TOMBSTONE;
            entry.key.valid  = false;
            entry.key.length = 0;
            table.len        = table.len - 1;
            ret ROUTE_OK;
        }
        index = next(index, table.capacity);
    }
    ret ROUTE_MISSING;
}

fun test_binding(slot: usize, generation: u64) Binding {
    ret Binding{connection_slot: slot, connection_generation: generation,
        route_index:    slot + 10, route_generation: generation + 10,
        route_sequence: generation + 20, pump_generation: 1};
}

fun test_key(bytes: *u8, value: usize) Key {
    var i: usize = 0;
    for (i < 8) {
        bytes[i] = ((value >> (i * 8)) & 0xff)::u8;
        i        = i + 1;
    }
    ret key(bytes, 8);
}

test "hedge.protocol.quic.routing: copied keys survive source reuse" {
    var a:     A.Allocator;
    var table: Table;
    page.make(?a);
    if (!make(?table, ?a) || table.capacity != 0) { ret 1; }
    var source:  [8]u8   = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    val wanted:  Key     = key(?source[0], 8);
    val binding: Binding = test_binding(0, 1);
    if (publish(?table, wanted, binding) != ROUTE_OK) { ret 2; }
    source[0] = 99;
    val found: Lookup = lookup(?table, wanted);
    if (found.status != ROUTE_OK
        || found.binding.connection_generation != 1) { ret 3; }
    if (destroy(?table))                                                    { ret 4; }
    if (unpublish(?table, wanted, binding) != ROUTE_OK || !destroy(?table)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.routing: an empty table holds no storage and finds nothing" {
    var a:     A.Allocator;
    var table: Table;
    page.make(?a);
    if (!make(?table, ?a)) { ret 1; }
    var bytes:  [8]u8;
    val wanted: Key = test_key(?bytes[0], 3);
    if (table.entries != nil || lookup(?table, wanted).status != ROUTE_MISSING
        || unpublish(?table, wanted, test_binding(0, 1)) != ROUTE_MISSING) { ret 2; }
    if (!destroy(?table)) { ret 3; }
    ret 0;
}

# the rehash is the one place routes move, so every route has to be found at
# its new position and none may be lost or duplicated
test "hedge.protocol.quic.routing: growth rehashes every live route" {
    var a:     A.Allocator;
    var table: Table;
    page.make(?a);
    if (!make(?table, ?a)) { ret 1; }
    val count: usize = 4000;
    var bytes: [8]u8;
    var i:     usize = 0;
    for (i < count) {
        if (publish(?table, test_key(?bytes[0], i), test_binding(i, i::u64 + 1)) != ROUTE_OK) { ret 2; }
        if (table.used * 2 > table.capacity)                                                  { ret 3; }
        i = i + 1;
    }
    if (table.len != count || table.capacity < count * 2) { ret 4; }
    i = 0;
    for (i < count) {
        val found: Lookup = lookup(?table, test_key(?bytes[0], i));
        if (found.status != ROUTE_OK || found.binding.connection_slot != i
            || found.binding.connection_generation != i::u64 + 1) { ret 5; }
        i = i + 1;
    }
    if (publish(?table, test_key(?bytes[0], 7), test_binding(7, 8)) != ROUTE_OK
        || publish(?table, test_key(?bytes[0], 7), test_binding(7, 9)) != ROUTE_CONFLICT
        || table.len != count) { ret 6; }
    i = 0;
    for (i < count) {
        if (unpublish(?table, test_key(?bytes[0], i), test_binding(i, i::u64 + 1)) != ROUTE_OK) { ret 7; }
        i = i + 1;
    }
    if (table.len != 0 || !destroy(?table)) { ret 8; }
    ret 0;
}

# a connection's routes churn for its whole life, so tombstones have to be
# purged rather than accumulating until every probe walks the whole table
test "hedge.protocol.quic.routing: churn purges tombstones without growing" {
    var a:     A.Allocator;
    var table: Table;
    page.make(?a);
    if (!make(?table, ?a)) { ret 1; }
    var bytes: [8]u8;
    var i:     usize = 0;
    for (i < 10000) {
        val binding: Binding = test_binding(i, i::u64 + 1);
        if (publish(?table, test_key(?bytes[0], i), binding) != ROUTE_OK
            || unpublish(?table, test_key(?bytes[0], i), binding) != ROUTE_OK) { ret 2; }
        if (table.used * 2 > table.capacity) { ret 3; }
        i = i + 1;
    }
    if (table.capacity != MIN_CAPACITY || table.len != 0)                  { ret 4; }
    if (lookup(?table, test_key(?bytes[0], 9999)).status != ROUTE_MISSING) { ret 5; }
    if (!destroy(?table))                                                  { ret 6; }
    ret 0;
}

test "hedge.protocol.quic.routing: a refused rehash is full and loses nothing" {
    var t:       allocator_testing.Testing;
    val tracked: err[A.Error] = allocator_testing.make(?t);
    if (sel tracked.err) { ret 1; }
    var table: Table;
    if (!make(?table, allocator_testing.allocator_of(?t))) { ret 2; }
    var bytes: [8]u8;
    var i:     usize = 0;
    for (i < 8) {
        if (publish(?table, test_key(?bytes[0], i), test_binding(i, 1)) != ROUTE_OK) { ret 3; }
        i = i + 1;
    }
    allocator_testing.fail_at_ordinal(?t, allocator_testing.attempt_count(?t) + 1);
    if (publish(?table, test_key(?bytes[0], 8), test_binding(8, 1)) != ROUTE_FULL
        || table.len != 8) { ret 4; }
    allocator_testing.clear_failure(?t);
    i = 0;
    for (i < 8) {
        if (lookup(?table, test_key(?bytes[0], i)).status != ROUTE_OK) { ret 5; }
        i = i + 1;
    }
    if (publish(?table, test_key(?bytes[0], 8), test_binding(8, 1)) != ROUTE_OK) { ret 6; }
    i = 0;
    for (i < 9) {
        if (unpublish(?table, test_key(?bytes[0], i), test_binding(i, 1)) != ROUTE_OK) { ret 7; }
        i = i + 1;
    }
    if (!destroy(?table) || allocator_testing.leaked(?t)) { ret 8; }
    ret 0;
}

test "hedge.protocol.quic.routing: stale owners cannot replace or retire routes" {
    var a:     A.Allocator;
    var table: Table;
    page.make(?a);
    if (!make(?table, ?a)) { ret 1; }
    var bytes:   [8]u8   = [8]u8{9, 8, 7, 6, 5, 4, 3, 2};
    val wanted:  Key     = key(?bytes[0], 8);
    val current: Binding = test_binding(0, 4);
    val stale:   Binding = test_binding(0, 3);
    if (publish(?table, wanted, current) != ROUTE_OK
        || publish(?table, wanted, stale) != ROUTE_CONFLICT) { ret 2; }
    if (unpublish(?table, wanted, stale) != ROUTE_STALE
        || lookup(?table, wanted).status != ROUTE_OK) { ret 3; }
    if (unpublish(?table, wanted, current) != ROUTE_OK
        || lookup(?table, wanted).status != ROUTE_MISSING) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.routing: invalid keys and generations fail closed" {
    var a:     A.Allocator;
    var table: Table;
    page.make(?a);
    if (!make(?table, ?a)) { ret 1; }
    var bytes:     [21]u8;
    val empty:     Key     = key(?bytes[0], 0);
    val oversized: Key     = key(?bytes[0], 21);
    var invalid:   Binding = test_binding(0, 1);
    invalid.pump_generation = 0;
    if (empty.valid || oversized.valid
        || publish(?table, empty, test_binding(0, 1)) != ROUTE_INVALID
        || publish(?table, key(?bytes[0], 8), invalid) != ROUTE_INVALID) {
        ret 2;
    }
    # the first connection ID a QUIC connection issues is sequence zero, and it
    # has to route: rejecting it made every accepted connection unreachable
    var sequence_zero: Binding = test_binding(0, 1);
    sequence_zero.route_sequence = 0;
    if (publish(?table, key(?bytes[0], 8), sequence_zero) != ROUTE_OK) {
        ret 3;
    }
    val found: Lookup = lookup(?table, key(?bytes[0], 8));
    if (found.status != ROUTE_OK || found.binding.route_sequence != 0) {
        ret 4;
    }
    ret 0;
}
