fun filled(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

fun monotonic_ns() u64 {
    ret clock.monotonic_ns();
}

pub val MAX_PUMPS:             usize = quic_capacity.MAX_PUMPS;
pub val ADMISSION_BANKS:       usize = quic_capacity.ADMISSION_BANKS;
pub val RECEIVE_BATCH:         usize = 64;
pub val MAX_STATELESS_PENDING: usize = quic_capacity.MAX_STATELESS_PENDING;
pub val CONNECTION_ID_BYTES:   usize = 20;
# how long one closed connection may linger before the transport abandons it.
# this is a per-connection RFC 9000 close period, not the process drain budget:
# sourcing it from the shutdown budget held every finished connection open for
# the whole of that budget and made shutdown wait it out.
pub val CONNECTION_DRAIN_NS: u64   = 3000000000;
pub val ENDPOINT_BYTES:      usize = 80;
pub val NO_PUMP:             usize = (-1)::usize;
pub val NO_CONNECTION:       usize = (-1)::usize;
val     NO_HANDSHAKE:        usize = (-1)::usize;
# the worker time one handshake is taken to cost before any has been measured.
# the running estimate replaces it from the first promotion
pub val HANDSHAKE_SERVICE_SEED_NS: u64 = 10000000;
# one sample moves the estimate by at most this factor's worth: a stall or a
# client that answered late is one outlier, a worker that really slowed down
# keeps sampling and gets there in a few
val HANDSHAKE_SERVICE_SAMPLE_CAP: u64 = 4;
# datagrams held for one connection mid-handshake, and for one pending
# initial, before more are dropped. a handshake exchanges a few; what a
# waiting client retransmits repeats its ClientHello and is dropped past the
# ceiling, and the copy after promotion goes to the connection instead
pub val HELD_PER_CONNECTION: usize = 8;
pub val HELD_PER_PENDING:    usize = 4;
# the smallest datagram a client may carry an Initial in (RFC 9000 14.1): what
# one held arrival costs the socket, so the arrival queue is sized in these
pub val MIN_INITIAL_BYTES: usize = 1200;
# preflights per turn at most. the sockets are read after every one, and the
# turn's arrival work is bounded in time as well, by what the last unit of
# handshake work cost, so a burst of Initials takes at most half the worker
pub val PREFLIGHT_BUDGET: usize = 4 * RECEIVE_BATCH;

pub def Status: u8;
pub val OK:      Status = 1;
pub val INVALID: Status = 2;
pub val BLOCKED: Status = 3;
pub val STALE:   Status = 4;
pub val FAILED:  Status = 5;
pub val STOPPED: Status = 6;

pub def ConnectionState: u8;
pub val CONNECTION_FREE:       ConnectionState = 0;
pub val CONNECTION_ACCEPTING:  ConnectionState = 1;
pub val CONNECTION_LIVE:       ConnectionState = 2;
pub val CONNECTION_GRACEFUL:   ConnectionState = 3;
pub val CONNECTION_CANCELLING: ConnectionState = 4;
pub val CONNECTION_RELEASING:  ConnectionState = 5;
pub val CONNECTION_BROKEN:     ConnectionState = 6;
pub val CONNECTION_CLEANUP:    ConnectionState = 7;
pub val CONNECTION_FINALIZING: ConnectionState = 8;

def CompletionKind: u8;
val COMPLETION_RECEIVE:   CompletionKind = 1;
val COMPLETION_SEND:      CompletionKind = 2;
val COMPLETION_STATELESS: CompletionKind = 3;

pub rec RuntimeConfig {
    # every per-connection record and directory grows from here
    backing: *A.Allocator;
    # request memory for every h3 exchange is claimed from here
    chunks: *hedge_storage.Chunks;
    # the worker's buffer pool, which every connection's account is opened on
    memory: *memory.Memory;
    # the worker's timer, which holds every connection deadline. the worker
    # advances it and hands each QUIC entry back through `fire`
    timers: *wheel.Wheel;
    # the worker's wake queue. a service waiting on something wakes its
    # connection through it, and the worker hands the wake back through `wake`
    wakes: *hedge_wake.Queue;
}

# a wheel owner is tagged as QUIC so a worker sharing one wheel can route it
val TIMER_TAG:   u64 = 0x5155000000000000;
val TIMER_MASK:  u64 = 0xffff000000000000;
val PENDING_TAG: u64 = 0x5149000000000000;
# how long a forced release that is still waiting sleeps before it looks again
val BROKEN_RETRY_NS: u64 = 10000000;

pub rec PumpConfig {
    admission_generation: u64;
    # absent is no cap: storage grows until the allocator refuses
    connection_limit:         opt[usize];
    max_connections_per_peer: opt[usize];
    # the process-wide bound on connections admitted but not yet established,
    # and the share of it one address may hold. every pump carries the same
    # values, and the runtime takes them from whichever update it applies last
    max_handshakes:          usize;
    max_handshakes_per_peer: opt[usize];
    # the socket receive buffer the listener asked for: the arrival queue holds
    # as many Initials as that buffer would
    receive_buffer_bytes: usize;
    require_retry:        bool;
    retry_max_age_ns:     u64;
    address_max_age_ns:   u64;
    # the Retry nonces remembered against replay, never zero
    max_replay:           usize;
    tls_policy:           *hedge_tls.Policy;
    tls_policy_index:     usize;
    plan:                 *plan.Plan;
    budgets:              *budget.Set;
    listener_budget:      usize;
    limits:               message.Limits;
    max_requests:         usize;
    call_memory_bytes:    usize;
    listener_name:        str;
    handshake_timeout_ns: u64;
    request_timeout_ns:   u64;
    idle_timeout_ms:      u64;
    drain_timeout_ns:     u64;
    # what each connection's account may hold, and how long it may wait for
    # memory before it is closed
    memory_budgets: memory.Budgets;
    memory_wait_ns: u64;
}

rec ConnectionConfig {
    tls_policy:           *hedge_tls.Policy;
    plan:                 *plan.Plan;
    budgets:              *budget.Set;
    limits:               message.Limits;
    max_requests:         usize;
    call_memory_bytes:    usize;
    listener_name:        str;
    handshake_timeout_ns: u64;
    request_timeout_ns:   u64;
    idle_timeout_ms:      u64;
    drain_timeout_ns:     u64;
    memory_budgets:       memory.Budgets;
    memory_wait_ns:       u64;
}

pub rec PumpStorage {
    scope:            cancel.Scope;
    receive_buffers:  [RECEIVE_BATCH][assembly.MAX_UDP_PAYLOAD]u8;
    receive_packets:  [RECEIVE_BATCH]net_types.Packet;
    preflight_output: [assembly.MAX_UDP_PAYLOAD]u8;
    versions:         [2]u32;
    receive_context:  CompletionContext;
    # the per-call buffers every connection on this pump shares
    scratch: assembly.Scratch;
}

pub rec ConnectionStorage {
    scope:            cancel.Scope;
    assembly_storage: assembly.Storage;
    # the connection's view of the worker's pool. its sources are held by the
    # assembly, so it stays put until the storage is released
    borrower:         memory.Borrower;
    local_parameters: [assembly.PARAMETER_CAPACITY]u8;
    local_cid:        [CONNECTION_ID_BYTES]u8;
    peer_text:        [ENDPOINT_BYTES]u8;
    local_text:       [ENDPOINT_BYTES]u8;
    listener_name:    [schema.TEXT_CAP]u8;
    sends:            [assembly.SEND_CAPACITY]SendOperation;
    published:        [assembly.CONNECTION_ID_CAPACITY]PublishedRoute;
}

pub rec PendingConfig {
    admission_generation: u64;
    tls_policy_index:     usize;
    plan:                 *plan.Plan;
    budgets:              *budget.Set;
    listener_budget:      usize;
    limits:               message.Limits;
    max_requests:         usize;
    call_memory_bytes:    usize;
    listener_name:        [schema.TEXT_CAP]u8;
    handshake_timeout_ns: u64;
    request_timeout_ns:   u64;
    idle_timeout_ms:      u64;
    drain_timeout_ns:     u64;
    memory_budgets:       memory.Budgets;
    memory_wait_ns:       u64;
}

pub rec PendingInitial {
    next_live: usize;
    prev_live: usize;
    # counted in the runtime's superseded total once its pump moved on
    superseded: bool;
    data:       [assembly.MAX_UDP_PAYLOAD]u8;
    # the listener's acceptance stays reserved, not committed, while the
    # Initial waits: a wait that ends in a drop cancels it, and the token the
    # client holds is still good for its retransmit. `accepted` is set only on
    # a cleanup-only record that owns a committed charge
    acceptance:            quic_listener.Acceptance;
    acceptance_live:       bool;
    accepted:              quic_listener.Accepted;
    config:                PendingConfig;
    budget_charge:         budget.Charge;
    lease:                 process_admission.Lease;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    length:                usize;
    interface_index:       u32;
    pump:                  usize;
    pump_generation:       u64;
    admission_bank:        usize;
    has_local_destination: bool;
    q_charge_live:         bool;
    budget_charge_live:    bool;
    lease_live:            bool;
    cleanup_only:          bool;
    live:                  bool;
    # a queued initial waits on its budget: a release wakes it and this entry
    # fires when its queue deadline passes. a deferred one waits on a handshake
    # slot, and the entry fires at its admission deadline instead
    timer:      wheel.Handle;
    timer_live: bool;
    ready:      bool;
    ready_next: usize;
    ready_prev: usize;
    # when the Initial arrived. its handshake deadline counts from here whether
    # it waits or not, so waiting never buys a connection more time
    arrival_ns: u64;
    # budget admitted, waiting for a handshake slot in arrival order
    deferred:      bool;
    deferred_next: usize;
    deferred_prev: usize;
    # counted once, the first time a handshake slot was not there for it
    counted_deferred:     bool;
    handshake_lease:      process_admission.Lease;
    handshake_lease_live: bool;
    # the client's later datagrams, routed here by the connection ID it was
    # given, held in order for the connection it becomes
    generation: u64;
    route_key:  routing.Key;
    route_live: bool;
    held:       HeldQueue;
}

# the welded records are owned by the caller, which grows nothing itself. the
# runtime grows these tables through the view, and a record never moves once
# its chunk exists, so a slot's index addresses it for the table's lifetime.
pub rec ControlView {
    pumps:       *Pump;
    connections: *hedge_storage.SecretTable[Connection];
    # tls handshake records, held by a connection only until its handshake
    # has handed everything over, then reused
    handshakes: *hedge_storage.SecretTable[server.Handshake];
    sessions:   *hedge_storage.SecretTable[h3_session.Session];
}

pub rec PumpHandle {
    index:      usize;
    generation: u64;
}

pub rec PumpUpdate {
    handle: PumpHandle;
    config: PumpConfig;
}

pub rec UpdateResult {
    status:          Status;
    committed:       bool;
    rollback_failed: bool;
}

rec CompletionContext {
    route:                 listener.ConnectionContext;
    operation_owner:       hedge_operation.Operation;
    completion:            io_runtime.Completion;
    kind:                  CompletionKind;
    pump:                  usize;
    pump_generation:       u64;
    connection:            usize;
    connection_generation: u64;
    operation:             usize;
    operation_generation:  u64;
    token_source:          u64;
    token_index:           u32;
    token_generation:      u64;
    # a settled completion waits on its runtime's list until advance takes it
    runtime:            *Runtime;
    next_pending:       *CompletionContext;
    prev_pending:       *CompletionContext;
    completion_pending: bool;
}

rec SendOperation {
    buffer:     [assembly.MAX_UDP_PAYLOAD]u8;
    packet:     net_types.Packet;
    token:      qt.Token;
    context:    CompletionContext;
    generation: u64;
    pending:    bool;
}

# pinned while pending, because the io completion context lives inside it
rec StatelessSend {
    buffer:       [assembly.MAX_UDP_PAYLOAD]u8;
    packet:       net_types.Packet;
    context:      CompletionContext;
    generation:   u64;
    next_pending: usize;
    prev_pending: usize;
    pending:      bool;
}

# an Initial or version request from no known connection, held as received
# until the worker's preflight turn. preflight may answer it with a Retry, which
# is crypto, and crypto never runs in the receive path: the socket is read at
# read speed and this queue, sized to the socket's own buffer, is the visible
# backlog the kernel's buffer used to be
rec Arrival {
    data:                  [assembly.MAX_UDP_PAYLOAD]u8;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    key:                   routing.Key;
    length:                usize;
    interface_index:       u32;
    has_local_destination: bool;
    arrival_ns:            u64;
    class:                 usize;
    next:                  usize;
}

# an arrival's class is its worth to the server, in preflight order. a token
# Initial has cost a Retry and its client an RTT, an untoken Initial is a first
# flight that costs only a Retry, other is a version to negotiate, and a
# duplicate carries the destination CID of something already held. under
# pressure a new arrival takes the slot of the oldest held arrival of a lower
# class, and a duplicate takes nothing
pub val ARRIVAL_TOKEN:     usize = telemetry.ARRIVAL_TOKEN;
pub val ARRIVAL_UNTOKEN:   usize = telemetry.ARRIVAL_UNTOKEN;
pub val ARRIVAL_OTHER:     usize = telemetry.ARRIVAL_OTHER;
pub val ARRIVAL_DUPLICATE: usize = telemetry.ARRIVAL_DUPLICATE;
pub val ARRIVAL_CLASSES:   usize = telemetry.ARRIVAL_CLASSES;

rec PublishedRoute {
    key:     routing.Key;
    binding: routing.Binding;
    live:    bool;
}

# a datagram for a connection mid-handshake, held until the worker's turn for
# handshake work comes: delivering it is where the handshake crypto runs, so
# the receive path copies it and reads on
rec HeldDatagram {
    data:                  [assembly.MAX_UDP_PAYLOAD]u8;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    length:                usize;
    interface_index:       u32;
    next:                  usize;
    has_local_destination: bool;
}

rec HeldQueue {
    head:  usize;
    tail:  usize;
    count: usize;
}

rec AdmissionGeneration {
    listener:                  quic_listener.Listener;
    lease:                     quic_listener.LeaseHandle;
    admissions:                admission.Manager;
    tokens:                    token.Manager;
    source:                    u64;
    active_connections:        usize;
    queued_initials:           usize;
    live:                      bool;
    retiring:                  bool;
    listener_owned:            bool;
    listener_published:        bool;
    listener_cleanup_retained: bool;
}

pub rec Connection {
    storage:  *ConnectionStorage;
    assembly: assembly.Connection;
    # counted in the runtime's superseded total once its pump moved on
    superseded: bool;
    # the handshake record this connection holds, or NO_HANDSHAKE
    handshake: usize;
    # the peer's share of the handshake bound, held with the record
    handshake_lease:      process_admission.Lease;
    handshake_lease_live: bool;
    # when the handshake was promoted and when it must be done by, so a
    # completion samples the wall time a handshake takes and an early end
    # past the deadline is counted as an expiry
    handshake_started_ns:  u64;
    handshake_deadline_ns: u64;
    # datagrams held for delivery on the worker's handshake turn, in order
    held:          HeldQueue;
    charge:        admission.Charge;
    budget_charge: budget.Charge;
    lease:         process_admission.Lease;
    policy:        *hedge_tls.Policy;
    plan:          *plan.Plan;
    budgets:       *budget.Set;
    limits:        message.Limits;
    peer:          ip.Endpoint;
    local:         ip.Endpoint;
    h3_session:    usize;
    # the earliest h3 request deadline, folded into the connection's wheel entry
    h3_deadline_ns:       u64;
    listener_name_length: usize;
    max_requests:         usize;
    call_memory_bytes:    usize;
    request_timeout_ns:   u64;
    memory_wait_ns:       u64;
    # when a connection waiting on memory is closed, zero when it is not waiting
    memory_deadline_ns: u64;
    # the connection's wheel entry, armed at the earlier of the transport's
    # next deadline and the drain deadline once closing
    timer:           wheel.Handle;
    transport_timer: qt.Timer;
    # the connections with work, in arrival order, and those an h3 service
    # holds waiting, which are tried every turn until #181 gives services wakers
    ready_next:   usize;
    ready_prev:   usize;
    waiting_next: usize;
    waiting_prev: usize;
    ready:        bool;
    # which ready list holds it: the handshake list while it holds a record
    ready_handshake:    bool;
    waiting:            bool;
    generation:         u64;
    source:             u64;
    next_live:          usize;
    prev_live:          usize;
    pump:               usize;
    pump_generation:    u64;
    admission_bank:     usize;
    state:              ConnectionState;
    scope_live:         bool;
    charge_live:        bool;
    budget_charge_live: bool;
    lease_live:         bool;
    h3_started:         bool;
    h3_abandoning:      bool;
    h3_cancelled:       bool;
    close_started:      bool;
    close_deadline_ns:  u64;
    transport_finished: bool;
    timer_disarmed:     bool;
    routes_removed:     bool;
    tls_live:           bool;
    assembly_attempted: bool;
    assembly_released:  bool;
    live:               bool;
}

pub rec Pump {
    storage:    *PumpStorage;
    backing:    *A.Allocator;
    admissions: [ADMISSION_BANKS]AdmissionGeneration;
    token_key:  [token.KEY_SIZE]^u8;
    # the secret half of the per-call buffers this pump's connections share
    secret_scratch:           assembly.SecretScratch;
    driver:                   *net_async.Driver;
    socket:                   *udp.Socket;
    root:                     *cancel.Scope;
    tls_policy:               *hedge_tls.Policy;
    plan:                     *plan.Plan;
    budgets:                  *budget.Set;
    config:                   PumpConfig;
    limits:                   message.Limits;
    local:                    ip.Endpoint;
    listener_name:            str;
    handshake_timeout_ns:     u64;
    request_timeout_ns:       u64;
    idle_timeout_ms:          u64;
    drain_timeout_ns:         u64;
    connection_limit:         opt[usize];
    max_connections_per_peer: opt[usize];
    max_requests:             usize;
    active_connections:       usize;
    queued_initials:          usize;
    generation:               u64;
    active_admission:         usize;
    token_generation:         u64;
    # stateless sends grow on demand up to MAX_STATELESS_PENDING. the pending
    # list is what the completion sweep walks, so it costs what is in flight
    stateless: hedge_storage.Table[StatelessSend];
    # a per-pump monotonic generation stamped on each send, so a completion for a
    # slot the table has since released and reused (or compacted away and regrown)
    # is detected as stale. u64 never wraps in practice
    stateless_generation: u64;
    stateless_pending:    usize;
    stateless_live:       usize;
    # unknown Initials held for the preflight turn, in arrival order
    arrivals:      hedge_storage.Table[Arrival];
    arrival_heads: [ARRIVAL_CLASSES]usize;
    arrival_tails: [ARRIVAL_CLASSES]usize;
    arrival_held:  [ARRIVAL_CLASSES]usize;
    # held destination CIDs, each with the count of arrivals that carry it
    arrival_index:    map.MapBy[routing.Key, usize];
    arrival_live:     usize;
    arrival_capacity: usize;
    receive_pending:  bool;
    scope_live:       bool;
    started:          bool;
    draining:         bool;
    cancelling:       bool;
    live:             bool;
}

pub rec Snapshot {
    pumps:      usize;
    live:       usize;
    superseded: usize;
    routes:     usize;
    timers:     usize;
    broken:     usize;
    # datagrams dropped and connection steps that failed, since make
    datagram_failures:   u64;
    connection_failures: u64;
    # Retries dropped because a pump held its ceiling of pending sends
    stateless_dropped: u64;
    # unknown datagrams dropped at a pump's arrival queue, by arrival class
    arrivals_dropped: [ARRIVAL_CLASSES]u64;
    # Retry-token Initials refused because a replay store was full
    replay_full: u64;
    # the handshake bound: what holds a slot now, what waits for one now, and
    # since make, what was held back, promoted, completed, dropped silently
    # and refused
    handshakes_in_flight: usize;
    handshakes_waiting:   usize;
    handshakes_deferred:  u64;
    handshakes_promoted:  u64;
    handshakes_completed: u64;
    handshakes_dropped:   u64;
    handshakes_refused:   u64;
    handshakes_expired:   u64;
    service_ns:           u64;
    finish_ns:            u64;
    stopping:             bool;
    initialized:          bool;
}

pub rec Runtime {
    # half a megabyte each, claimed as a connection is taken and returned with it
    connection_storages: hedge_storage.Recycler[ConnectionStorage];
    pending_initials:    hedge_storage.Table[PendingInitial];
    routes:              routing.Table;
    timers:              *wheel.Wheel;
    wakes:               *hedge_wake.Queue;
    sessions:            h3_session.Pool;
    chunks:              *hedge_storage.Chunks;
    memory:              *memory.Memory;
    backing:             *A.Allocator;
    # the live connections, so every sweep costs what is live rather than what
    # was configured. an idle QUIC listener sweeps nothing.
    live_head:        usize;
    ready_head:       usize;
    ready_tail:       usize;
    waiting_head:     usize;
    completions_head: *CompletionContext;
    completions_tail: *CompletionContext;
    admission:        *process_admission.Manager;
    live_connections: usize;
    live_total:       usize;
    # live records whose pump has moved to a later plan or admission bank,
    # kept exact by the marks at each swap and the releases
    superseded_total:    usize;
    datagram_failures:   u64;
    connection_failures: u64;
    stateless_dropped:   u64;
    arrivals_dropped:    [ARRIVAL_CLASSES]u64;
    # Retry-token Initials refused because a replay store was full
    replay_full: u64;
    # the queued initials, so a sweep costs what is queued rather than what
    # the configured connection limit reserved
    pending_live_head:     usize;
    pending_ready_head:    usize;
    pending_ready_tail:    usize;
    pending_initial_count: usize;
    # the handshake bound. connections holding a handshake record count
    # against max_handshakes, and the manager holds each peer's share of the
    # deferred and in-flight handshakes together
    max_handshakes:       usize;
    handshakes:           process_admission.Manager;
    handshakes_in_flight: usize;
    # stamped on each pending initial so a route to a slot the table has
    # since reused is detected as stale
    pending_generation: u64;
    # the Initials waiting for a slot, in arrival order
    deferred_head:  usize;
    deferred_tail:  usize;
    deferred_count: usize;
    # connections mid-handshake with work, in order. their work is the
    # handshake crypto, so it is taken one connection per turn under the
    # crypto budget rather than swept with the ready list
    handshake_ready_head: usize;
    handshake_ready_tail: usize;
    held:                 hedge_storage.Table[HeldDatagram];
    held_dropped:         u64;
    # the running estimate of the worker's time per handshake, sampled as the
    # interval between two handshakes completing while handshake work waited,
    # admitted or deferred: the worker was saturated, so the interval is what
    # one handshake costs it with everything else a turn carries, the burst's
    # own Retries and reads included, which is what the deadline rule has to
    # divide by. zero when no chain of samples is open
    service_ns:         u64;
    last_completion_ns: u64;
    # the running estimate of the wall time a promoted handshake takes to
    # reach established: its crypto plus the client's round trip. the
    # promotion rule judges a record's remaining time by this, not by one
    # crypto unit. zero until the first completion seeds it
    finish_ns: u64;
    # the worker time spent turning arrivals away or sending them Retries: a
    # burst's front is thousands of these before its first handshake completes,
    # and they are the one transient the samples leave out, since the arrival
    # queue bounds them and a refused client sends nothing more
    arrival_work_ns:      u64;
    arrival_work_mark_ns: u64;
    # what the last turn's unit of handshake work cost: the next turn's
    # arrival work is bounded by it, so a burst of Initials takes at most half
    # the worker and the handshakes already admitted keep the other half
    unit_ns: u64;
    # one unit of handshake work is done per turn: a promotion or a held
    # delivery
    crypto_budget: usize;
    # the owner's socket poll, called between units of preflight crypto so a
    # receive that settled meanwhile is read before the next unit. nil when no
    # owner drives the sockets
    read_on:             fun(ptr) bool;
    read_on_ctx:         ptr;
    handshakes_deferred: u64;
    handshakes_promoted: u64;
    # promoted handshakes that reached established; the rest ended early
    handshakes_completed: u64;
    # dropped: turned away silently, the client's PTO retransmits. refused: told
    # so with a stateless close, once quic can send one
    handshakes_dropped: u64;
    handshakes_refused: u64;
    # promoted handshakes that ended on their own deadline: crypto spent,
    # client told nothing. the promotion rule exists to keep this at zero
    handshakes_expired:    u64;
    pump_count:            usize;
    next_source:           u64;
    connection_generation: u64;
    # calendar time of the current advance, read only to verify certificates.
    # everything that schedules uses the monotonic clock
    stopping:    bool;
    initialized: bool;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun saturated_add(left: u64, right: u64) u64 {
    if (left > 0xffffffffffffffff - right) { ret 0xffffffffffffffff; }
    ret left + right;
}

fun exact_h3(policy: *hedge_tls.Policy) bool {
    ret policy != nil && policy.live && policy.configuration.require_alpn
        && policy.configuration.alpn != nil
        && policy.configuration.alpn_len == 1
        && policy.configuration.alpn[0].data != nil
        && policy.configuration.alpn[0].len == 2
        && policy.configuration.alpn[0].data[0] == 'h'::u8
        && policy.configuration.alpn[0].data[1] == '3'::u8;
}

# a present limit is a cap, and zero is not a spelling of no cap
fun limit_valid(limit: opt[usize]) bool {
    if (sel limit.some) { ret limit.some != 0; }
    ret true;
}

fun per_peer_within(config: *PumpConfig) bool {
    if (sel config.connection_limit.some) {
        if (sel config.max_connections_per_peer.some) {
            ret config.max_connections_per_peer.some <= config.connection_limit.some;
        }
    }
    ret true;
}

# whether a limit leaves room for these active connections and queued initials
fun limit_holds(limit: opt[usize], active: usize, queued: usize) bool {
    if (sel limit.some) {
        ret active <= limit.some && queued <= limit.some - active;
    }
    ret true;
}

fun handshake_limits_valid(config: *PumpConfig) bool {
    if (config.max_handshakes == 0) { ret false; }
    if (sel config.max_handshakes_per_peer.some) {
        ret config.max_handshakes_per_peer.some != 0
            && config.max_handshakes_per_peer.some <= config.max_handshakes;
    }
    ret true;
}

fun pump_config_shape_valid(config: *PumpConfig) bool {
    ret config != nil && config.admission_generation != 0
        && limit_valid(config.connection_limit)
        && limit_valid(config.max_connections_per_peer)
        && per_peer_within(config)
        && config.retry_max_age_ns != 0 && config.address_max_age_ns != 0
        && config.max_replay != 0
        && exact_h3(config.tls_policy) && config.plan != nil
        && config.plan.sealed && config.budgets != nil
        && (config.listener_budget == budget.NO_BUDGET
        || budget.at(config.budgets, config.listener_budget) != nil)
        && config.max_requests != 0
        && config.max_requests <= h3_session.MAX_STREAMS
        && config.listener_name != nil
        && str_len(config.listener_name) != 0
        && handshake_limits_valid(config)
        && str_len(config.listener_name) < schema.TEXT_CAP
        && config.handshake_timeout_ns != 0
        && config.idle_timeout_ms != 0 && config.drain_timeout_ns != 0;
}

fun pump_config_valid(config: *PumpConfig) bool {
    ret pump_config_shape_valid(config)
        && hedge_tls.policy_at(config.tls_policy_index) == config.tls_policy;
}

pub fun operation_capacity_required(connection_capacity: usize,
    pump_capacity: usize) usize {
    ret quic_capacity.operation_capacity_required(connection_capacity,
        pump_capacity);
}

# a control view is borrowed for the duration of one call and never retained
pub fun view_valid(controls: *ControlView) bool {
    ret controls != nil && controls.pumps != nil && controls.connections != nil
        && controls.sessions != nil && controls.handshakes != nil;
}

pub fun connection_at(controls: *ControlView, index: usize) *Connection {
    ret hedge_storage.secret_table_at[Connection](controls.connections, index);
}

fun pending_at(runtime: *Runtime, index: usize) *PendingInitial {
    ret hedge_storage.table_at[PendingInitial](?runtime.pending_initials, index);
}

# a free slot owns no connection storage. it is claimed when the slot is taken
# and returned when the slot is freed, so an idle listener holds none of it.
fun reset_connection(value: *Connection) {
    value.live                  = false;
    value.state                 = CONNECTION_FREE;
    value.storage               = nil;
    value.next_live             = NO_CONNECTION;
    value.prev_live             = NO_CONNECTION;
    value.h3_session            = h3_session.NO_SESSION;
    value.h3_deadline_ns        = 0;
    value.memory_deadline_ns    = 0;
    value.handshake             = NO_HANDSHAKE;
    value.handshake_lease       = process_admission.no_lease();
    value.handshake_lease_live  = false;
    value.handshake_started_ns  = 0;
    value.handshake_deadline_ns = 0;
    reset_held(?value.held);
    value.ready_handshake      = false;
    value.scope_live           = false;
    value.charge_live          = false;
    value.budget_charge_live   = false;
    value.lease_live           = false;
    value.lease                = process_admission.no_lease();
    value.policy               = nil;
    value.plan                 = nil;
    value.budgets              = nil;
    value.budget_charge        = budget.no_charge();
    value.listener_name_length = 0;
    value.h3_started           = false;
    value.h3_abandoning        = false;
    value.h3_cancelled         = false;
    value.close_started        = false;
    value.close_deadline_ns    = 0;
    value.transport_finished   = false;
    value.timer_disarmed       = false;
    value.timer                = wheel.no_handle();
    value.ready                = false;
    value.waiting              = false;
    value.ready_next           = NO_CONNECTION;
    value.ready_prev           = NO_CONNECTION;
    value.waiting_next         = NO_CONNECTION;
    value.waiting_prev         = NO_CONNECTION;
    value.routes_removed       = false;
    value.tls_live             = false;
    value.assembly_attempted   = false;
    value.assembly_released    = false;
}

# a fresh or reused slot from the slab reads as unclaimed: the enqueue paths set
# the rest, and link_pending_live sets the live links
fun reset_pending_initial(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    pending.live                 = false;
    pending.next_live            = NO_CONNECTION;
    pending.prev_live            = NO_CONNECTION;
    pending.timer                = wheel.no_handle();
    pending.timer_live           = false;
    pending.ready                = false;
    pending.ready_next           = NO_CONNECTION;
    pending.ready_prev           = NO_CONNECTION;
    pending.arrival_ns           = 0;
    pending.deferred             = false;
    pending.deferred_next        = NO_CONNECTION;
    pending.deferred_prev        = NO_CONNECTION;
    pending.counted_deferred     = false;
    pending.handshake_lease      = process_admission.no_lease();
    pending.handshake_lease_live = false;
    pending.generation           = 0;
    pending.route_live           = false;
    pending.acceptance_live      = false;
    reset_held(?pending.held);
}

# a free pending initial exists afterwards, so an admitted initial always has
# somewhere to queue; the connection slot is claimed on demand at acquire, which
# refuses gracefully when the slab cannot grow
fun reserve_capacity(runtime: *Runtime) bool {
    ret hedge_storage.table_live[PendingInitial](?runtime.pending_initials)
        < hedge_storage.table_capacity[PendingInitial](?runtime.pending_initials)
        || hedge_storage.grow_table[PendingInitial](?runtime.pending_initials);
}

fun handshake_at(controls: *ControlView, index: usize) *server.Handshake {
    ret hedge_storage.secret_table_at[server.Handshake](controls.handshakes, index);
}

# a handshake record for a connection about to be initialized, welded on demand
# and reused from the slab's free list, or NO_HANDSHAKE when the table cannot grow
fun claim_handshake(controls: *ControlView) usize {
    ret hedge_storage.secret_table_claim[server.Handshake](controls.handshakes);
}

# the record goes back once nothing refers to it: its engine was destroyed, or
# the assembly finished the handshake or released the connection. releasing the
# index zeroizes and unwelds its chunk once the chunk goes empty. the record is
# what holds a slot of the handshake bound, so the slot and the peer's share go
# back with it, and the oldest deferred Initial may take the slot next turn
fun release_handshake(controls: *ControlView, runtime: *Runtime, index: usize,
    completed: bool, now_ns: u64) bool {
    val value: *Connection = connection_at(controls, index);
    if (value.handshake == NO_HANDSHAKE) { ret true; }
    if (!hedge_storage.secret_table_release[server.Handshake](controls.handshakes,
        value.handshake)) { ret false; }
    value.handshake = NO_HANDSHAKE;
    if (runtime.handshakes_in_flight != 0) {
        runtime.handshakes_in_flight = runtime.handshakes_in_flight - 1;
    }
    release_held(runtime, ?value.held);
    # its work is no longer handshake work: what it is marked for moves lists
    if (value.ready && value.ready_handshake) {
        unmark_ready(controls, runtime, index);
        mark_ready(controls, runtime, index);
    }
    if (completed) {
        runtime.handshakes_completed = runtime.handshakes_completed + 1;
        observe_service(runtime, now_ns);
        observe_finish(runtime, value.handshake_started_ns, now_ns);
    }
    or (now_ns != 0 && value.handshake_deadline_ns != 0
        && now_ns >= value.handshake_deadline_ns) {
        runtime.handshakes_expired = runtime.handshakes_expired + 1;
    }
    value.handshake_started_ns  = 0;
    value.handshake_deadline_ns = 0;
    if (value.handshake_lease_live) {
        if (!process_admission.release(?runtime.handshakes, value.handshake_lease)) {
            connection_failed(runtime);
        }
        value.handshake_lease_live = false;
        value.handshake_lease      = process_admission.no_lease();
    }
    ret true;
}

fun handshake_room(runtime: *Runtime) bool {
    ret runtime.handshakes_in_flight < runtime.max_handshakes;
}

# whether the oldest deferred Initial could take a slot this turn
fun promotable(runtime: *Runtime) bool {
    ret runtime.deferred_head != NO_CONNECTION && handshake_room(runtime);
}

fun link_deferred(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    pending.deferred      = true;
    pending.deferred_next = NO_CONNECTION;
    pending.deferred_prev = runtime.deferred_tail;
    if (runtime.deferred_tail != NO_CONNECTION) {
        pending_at(runtime, runtime.deferred_tail).deferred_next = index;
    }
    or { runtime.deferred_head = index; }
    runtime.deferred_tail  = index;
    runtime.deferred_count = runtime.deferred_count + 1;
}

fun unlink_deferred(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!pending.deferred) { ret; }
    if (pending.deferred_prev != NO_CONNECTION) {
        pending_at(runtime, pending.deferred_prev).deferred_next = pending.deferred_next;
    }
    or { runtime.deferred_head = pending.deferred_next; }
    if (pending.deferred_next != NO_CONNECTION) {
        pending_at(runtime, pending.deferred_next).deferred_prev = pending.deferred_prev;
    }
    or { runtime.deferred_tail = pending.deferred_prev; }
    pending.deferred      = false;
    pending.deferred_next = NO_CONNECTION;
    pending.deferred_prev = NO_CONNECTION;
    if (runtime.deferred_count != 0) {
        runtime.deferred_count = runtime.deferred_count - 1;
    }
}

# the first time a slot is not there for an Initial it is counted as deferred
fun hold_deferred(runtime: *Runtime, pending: *PendingInitial) {
    if (pending.counted_deferred) { ret; }
    pending.counted_deferred    = true;
    runtime.handshakes_deferred = runtime.handshakes_deferred + 1;
}

# the wall time one handshake takes from promotion to established: the
# measured finish once one has completed, its crypto unit alone before that
fun own_ns(runtime: *Runtime) u64 {
    if (runtime.finish_ns != 0) { ret runtime.finish_ns; }
    ret runtime.service_ns;
}

# the time the handshakes ahead of one represent: every handshake in flight
# and, for an arrival, every Initial already waiting, at the running worker
# cost per handshake, plus the wall time its own takes to finish
fun work_ahead_ns(runtime: *Runtime, waiting: usize) u64 {
    val count: usize = waiting + runtime.handshakes_in_flight;
    if (count::u64 > 0xffffffffffffffff / runtime.service_ns) {
        ret 0xffffffffffffffff;
    }
    ret saturated_add(count::u64 * runtime.service_ns, own_ns(runtime));
}

# whether an Initial that arrived at arrival_ns can still finish inside its
# own handshake deadline once the work ahead of it is done. a record promoted
# with less than a finish left would spend its crypto and expire, so it is
# refused at its turn instead
fun deadline_allows(runtime: *Runtime, arrival_ns: u64, handshake_timeout_ns: u64,
    now_ns: u64, waiting: usize) bool {
    ret saturated_add(now_ns, work_ahead_ns(runtime, waiting))
        < saturated_add(arrival_ns, handshake_timeout_ns);
}

# the one place an Initial that will not be served is turned away: a stateless
# CONNECTION_CLOSE(CONNECTION_REFUSED) under the Initial keys its destination
# id derives (RFC 9000 10.2.3), so the client learns in one round trip rather
# than after its retransmissions. a close that cannot be built or sent is a
# drop, counted apart, and the client's PTO retransmits. the ceiling drop and
# the deadline drop route here and nothing else does
fun refuse_initial(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    bank_index: usize, initial: *net_types.Packet, now_ns: u64) {
    val pump: *Pump                = ?controls.pumps[pump_index];
    val bank: *AdmissionGeneration = ?pump.admissions[bank_index];
    if (!pump.live || pump.draining || pump.cancelling) {
        runtime.handshakes_dropped = runtime.handshakes_dropped + 1;
        ret;
    }
    var request: quic_listener.Request;
    request.peer                     = initial.peer;
    request.data                     = initial.buffer;
    request.length                   = initial.length;
    request.now                      = clock.from_ns(now_ns);
    request.version_negotiation_bits = 0;
    request.output                   = ?pump.storage.preflight_output[0];
    request.output_capacity          = assembly.MAX_UDP_PAYLOAD;
    val result: quic_listener.Result = quic_listener.refuse(?bank.listener,
        ?request, quic_core.CONNECTION_REFUSED);
    if (result.action == quic_listener.ACTION_REFUSE
        && submit_stateless(controls, runtime, pump_index, initial,
        ?pump.storage.preflight_output[0], result.output_count) == OK) {
        runtime.handshakes_refused = runtime.handshakes_refused + 1;
        ret;
    }
    runtime.handshakes_dropped = runtime.handshakes_dropped + 1;
}

fun refuse_pending(controls: *ControlView, runtime: *Runtime, pending: *PendingInitial,
    now_ns: u64) {
    var initial:    net_types.Packet = pending_packet(pending);
    val started_ns: u64              = monotonic_ns();
    refuse_initial(controls, runtime, pending.pump, pending.admission_bank, ?initial,
        now_ns);
    charge_arrival_work(runtime, started_ns);
}

fun elapsed_since(started_ns: u64) u64 {
    val ended_ns: u64 = monotonic_ns();
    if (ended_ns <= started_ns) { ret 0; }
    ret ended_ns - started_ns;
}

fun charge_arrival_work(runtime: *Runtime, started_ns: u64) {
    runtime.arrival_work_ns = saturated_add(runtime.arrival_work_ns,
        elapsed_since(started_ns));
}

# a receive batch's time is charged to arrival work by the share of it that
# was unknown datagrams: a burst's front is batches of nothing else
fun charge_arrival_batch(runtime: *Runtime, pump: *Pump, started_ns: u64,
    held_before: usize, dropped_before: u64, items: usize) {
    if (items == 0) { ret; }
    val unknown: u64 = (pump.arrival_live - held_before)::u64
        + (arrivals_dropped_total(runtime) - dropped_before);
    if (unknown == 0) { ret; }
    val elapsed: u64 = elapsed_since(started_ns);
    runtime.arrival_work_ns = saturated_add(runtime.arrival_work_ns,
        elapsed / items::u64 * unknown);
}

# a handshake completed. with handshake work still queued, admitted or
# deferred, the worker runs one unit per turn back to back, so the interval
# between completions, less the arrival work in it, is one sample of its cost
# per handshake; with none, the worker may idle before the next and the chain
# of samples closes. an admitted queue samples too, so a warm-up under the
# bound seeds the estimate a burst is then judged by
fun observe_service(runtime: *Runtime, now_ns: u64) {
    if (runtime.deferred_count == 0 && runtime.handshake_ready_head == NO_CONNECTION) {
        runtime.last_completion_ns = 0;
        ret;
    }
    if (runtime.last_completion_ns != 0 && now_ns > runtime.last_completion_ns) {
        var sample:  u64 = now_ns - runtime.last_completion_ns;
        val arrival: u64 = runtime.arrival_work_ns - runtime.arrival_work_mark_ns;
        if (arrival < sample) { sample = sample - arrival; }
        or                    { sample = 0; }
        val cap: u64 = runtime.service_ns * HANDSHAKE_SERVICE_SAMPLE_CAP;
        if (cap > runtime.service_ns && sample > cap) { sample = cap; }
        if (sample != 0) {
            runtime.service_ns = runtime.service_ns - runtime.service_ns / 8 + sample / 8;
            if (runtime.service_ns == 0) { runtime.service_ns = 1; }
        }
    }
    runtime.last_completion_ns   = now_ns;
    runtime.arrival_work_mark_ns = runtime.arrival_work_ns;
}

# a promoted handshake reached established: the wall time from its promotion
# is one sample of what a handshake takes to finish. the first seeds the
# estimate, later ones move it by the same eighth and cap as the service
# estimate, so one client mid-PTO is an outlier and a slower population gets
# there in a few
fun observe_finish(runtime: *Runtime, started_ns: u64, now_ns: u64) {
    if (started_ns == 0 || now_ns <= started_ns) { ret; }
    var sample: u64 = now_ns - started_ns;
    if (runtime.finish_ns == 0) {
        runtime.finish_ns = sample;
        ret;
    }
    val cap: u64 = runtime.finish_ns * HANDSHAKE_SERVICE_SAMPLE_CAP;
    if (cap > runtime.finish_ns && sample > cap) { sample = cap; }
    runtime.finish_ns = runtime.finish_ns - runtime.finish_ns / 8 + sample / 8;
    if (runtime.finish_ns == 0) { runtime.finish_ns = 1; }
}

# put the storage a taken slot is about to use into its empty state. a
# completion that settled after its connection was freed may still be marked,
# and it belongs to no connection that can take this storage now.
fun arm_connection_storage(value: *Connection) {
    value.storage.listener_name[0] = 0;
    var i: usize = 0;
    for (i < assembly.SEND_CAPACITY) {
        value.storage.sends[i].pending                    = false;
        value.storage.sends[i].context.completion_pending = false;
        value.storage.sends[i].context.next_pending       = nil;
        value.storage.sends[i].context.prev_pending       = nil;
        i                                                 = i + 1;
    }
    i = 0;
    for (i < assembly.CONNECTION_ID_CAPACITY) {
        value.storage.published[i].live = false;
        i                               = i + 1;
    }
}

# the live list is intrusive and doubly linked, so a connection leaves it in
# constant time from wherever a sweep happens to be standing
fun link_live(controls: *ControlView, runtime: *Runtime, index: usize) {
    val value: *Connection = connection_at(controls, index);
    value.prev_live = NO_CONNECTION;
    value.next_live = runtime.live_head;
    if (runtime.live_head != NO_CONNECTION) {
        connection_at(controls, runtime.live_head).prev_live = index;
    }
    runtime.live_head = index;
}

# the length of the live list, which is what a sweep costs
fun live_walk_length(controls: *ControlView, runtime: *Runtime) usize {
    var count: usize = 0;
    var i:     usize = runtime.live_head;
    for (i != NO_CONNECTION) {
        count = count + 1;
        i     = connection_at(controls, i).next_live;
    }
    ret count;
}

fun link_pending_live(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    pending.prev_live = NO_CONNECTION;
    pending.next_live = runtime.pending_live_head;
    if (runtime.pending_live_head != NO_CONNECTION) {
        pending_at(runtime, runtime.pending_live_head).prev_live = index;
    }
    runtime.pending_live_head = index;
}

fun mark_pending_ready(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (pending == nil || !pending.live || pending.ready) { ret; }
    pending.ready      = true;
    pending.ready_next = NO_CONNECTION;
    pending.ready_prev = runtime.pending_ready_tail;
    if (runtime.pending_ready_tail != NO_CONNECTION) {
        pending_at(runtime, runtime.pending_ready_tail).ready_next = index;
    }
    or { runtime.pending_ready_head = index; }
    runtime.pending_ready_tail = index;
}

fun unmark_pending_ready(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!pending.ready) { ret; }
    if (pending.ready_prev != NO_CONNECTION) {
        pending_at(runtime, pending.ready_prev).ready_next = pending.ready_next;
    }
    or { runtime.pending_ready_head = pending.ready_next; }
    if (pending.ready_next != NO_CONNECTION) {
        pending_at(runtime, pending.ready_next).ready_prev = pending.ready_prev;
    }
    or { runtime.pending_ready_tail = pending.ready_prev; }
    pending.ready      = false;
    pending.ready_next = NO_CONNECTION;
    pending.ready_prev = NO_CONNECTION;
}

# the wheel deadline a pending initial waits under: its admission deadline
# once deferred, otherwise its budget queue deadline if it has one, else none
fun pending_deadline(pending: *PendingInitial, deferred: bool,
    charge: *budget.Charge, output: *u64) bool {
    if (deferred) {
        @output = saturated_add(pending.arrival_ns, pending.config.handshake_timeout_ns);
        ret true;
    }
    var deadline: time.Instant;
    if (!budget.deadline(charge, ?deadline)) { ret false; }
    @output = clock.to_ns(deadline);
    ret true;
}

# claim and arm the wheel entry a queued charge waits on, before the charge
# moves into the pending record, so a failure leaves it with the caller
fun claim_pending_timer(runtime: *Runtime, index: usize, deferred: bool,
    charge: *budget.Charge) bool {
    val pending: *PendingInitial = pending_at(runtime, index);
    val handle:  wheel.Handle    = wheel.claim(runtime.timers, pending_owner(index));
    if (handle.index == wheel.NONE) { ret false; }
    var deadline_ns: u64 = 0;
    if (pending_deadline(pending, deferred, charge, ?deadline_ns)
        && wheel.arm(runtime.timers, handle, deadline_ns) != wheel.OK) {
        wheel.release(runtime.timers, handle);
        ret false;
    }
    pending.timer      = handle;
    pending.timer_live = true;
    ret true;
}

# the queued charge moves into its pending record, and a release that admits
# it wakes that record
fun take_pending_charge(runtime: *Runtime, index: usize, budgets: *budget.Set,
    charge: *budget.Charge) {
    val pending: *PendingInitial = pending_at(runtime, index);
    budget.relocate(budgets, ?pending.budget_charge, charge);
    pending.budget_charge.waker = hedge_wake.waker(runtime.wakes, pending_owner(index));
}

fun unlink_pending_live(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (pending.prev_live != NO_CONNECTION) {
        pending_at(runtime, pending.prev_live).next_live = pending.next_live;
    }
    or (runtime.pending_live_head == index) {
        runtime.pending_live_head = pending.next_live;
    }
    if (pending.next_live != NO_CONNECTION) {
        pending_at(runtime, pending.next_live).prev_live = pending.prev_live;
    }
    pending.next_live = NO_CONNECTION;
    pending.prev_live = NO_CONNECTION;
}

fun unlink_live(controls: *ControlView, runtime: *Runtime, index: usize) {
    val value: *Connection = connection_at(controls, index);
    if (value.prev_live != NO_CONNECTION) {
        connection_at(controls, value.prev_live).next_live = value.next_live;
    }
    or (runtime.live_head == index) {
        runtime.live_head = value.next_live;
    }
    if (value.next_live != NO_CONNECTION) {
        connection_at(controls, value.next_live).prev_live = value.prev_live;
    }
    value.next_live = NO_CONNECTION;
    value.prev_live = NO_CONNECTION;
}

# nothing per connection is allocated here. slots the caller's tables already
# hold, from an earlier runtime, are threaded back onto the free lists.
pub fun make(controls: *ControlView, runtime: *Runtime, config: RuntimeConfig) bool {
    if (runtime == nil || runtime.initialized || config.chunks == nil
        || config.memory == nil || config.backing == nil || config.timers == nil
        || !view_valid(controls)) { ret false; }
    if (!hedge_storage.make[ConnectionStorage](?runtime.connection_storages,
        config.backing, 1)) { ret false; }
    if (!hedge_storage.make_table[PendingInitial](?runtime.pending_initials,
        config.backing)
        || !routing.make(?runtime.routes, config.backing)
        || !h3_session.make_pool(?runtime.sessions, config.backing,
        controls.sessions)
        || !process_admission.make(?runtime.handshakes, config.backing,
        opt[usize].none{}, opt[usize].none{})
        || !hedge_storage.make_table[HeldDatagram](?runtime.held, config.backing)) {
        hedge_storage.destroy[ConnectionStorage](?runtime.connection_storages);
        ret false;
    }
    runtime.chunks            = config.chunks;
    runtime.memory            = config.memory;
    runtime.backing           = config.backing;
    runtime.timers            = config.timers;
    runtime.wakes             = config.wakes;
    runtime.ready_head        = NO_CONNECTION;
    runtime.ready_tail        = NO_CONNECTION;
    runtime.waiting_head      = NO_CONNECTION;
    runtime.completions_head  = nil;
    runtime.completions_tail  = nil;
    runtime.admission         = nil;
    runtime.live_head         = NO_CONNECTION;
    runtime.live_connections  = 0;
    runtime.live_total        = 0;
    runtime.superseded_total  = 0;
    runtime.stateless_dropped = 0;
    clear_arrival_drops(runtime);
    runtime.replay_full           = 0;
    runtime.datagram_failures     = 0;
    runtime.connection_failures   = 0;
    runtime.pending_live_head     = NO_CONNECTION;
    runtime.pending_ready_head    = NO_CONNECTION;
    runtime.pending_ready_tail    = NO_CONNECTION;
    runtime.pending_initial_count = 0;
    runtime.max_handshakes        = schema.DEFAULT_MAX_HANDSHAKES;
    runtime.handshakes_in_flight  = 0;
    runtime.pending_generation    = 0;
    runtime.deferred_head         = NO_CONNECTION;
    runtime.deferred_tail         = NO_CONNECTION;
    runtime.deferred_count        = 0;
    runtime.service_ns            = HANDSHAKE_SERVICE_SEED_NS;
    runtime.last_completion_ns    = 0;
    runtime.finish_ns             = 0;
    runtime.arrival_work_ns       = 0;
    runtime.arrival_work_mark_ns  = 0;
    runtime.unit_ns               = HANDSHAKE_SERVICE_SEED_NS;
    runtime.crypto_budget         = 0;
    runtime.handshake_ready_head  = NO_CONNECTION;
    runtime.handshake_ready_tail  = NO_CONNECTION;
    runtime.held_dropped          = 0;
    runtime.read_on               = nil;
    runtime.read_on_ctx           = nil;
    runtime.handshakes_deferred   = 0;
    runtime.handshakes_promoted   = 0;
    runtime.handshakes_dropped    = 0;
    runtime.handshakes_refused    = 0;
    runtime.handshakes_completed  = 0;
    runtime.handshakes_expired    = 0;
    runtime.pump_count            = 0;
    runtime.next_source           = 1;
    runtime.connection_generation = next_generation(runtime.connection_generation);
    runtime.stopping              = false;
    var i: usize = 0;
    for (i < MAX_PUMPS) {
        controls.pumps[i].live       = false;
        controls.pumps[i].started    = false;
        controls.pumps[i].scope_live = false;
        i                            = i + 1;
    }
    runtime.initialized = true;
    ret true;
}

fun pump_for(controls: *ControlView, runtime: *Runtime, handle: PumpHandle) *Pump {
    if (runtime == nil || !runtime.initialized || handle.index >= MAX_PUMPS) {
        ret nil;
    }
    val pump: *Pump = ?controls.pumps[handle.index];
    if (!pump.live || pump.generation != handle.generation) { ret nil; }
    ret pump;
}

fun queue_completion(owner: ptr, token_context: usize,
    completion: io_runtime.Completion) {
    val context: *CompletionContext = owner::*CompletionContext;
    if (context == nil || context.completion_pending || context.runtime == nil) { ret; }
    val runtime: *Runtime = context.runtime;
    context.completion         = completion;
    context.completion_pending = true;
    context.next_pending       = nil;
    context.prev_pending       = runtime.completions_tail;
    if (runtime.completions_tail != nil) {
        runtime.completions_tail.next_pending = context;
    }
    or {
        runtime.completions_head = context;
    }
    runtime.completions_tail = context;
}

# a context leaves the list when advance takes it, or before its storage goes
# away when its owner is freed first
fun unqueue_completion(runtime: *Runtime, context: *CompletionContext) {
    if (!context.completion_pending) { ret; }
    context.completion_pending = false;
    if (context.prev_pending != nil) {
        context.prev_pending.next_pending = context.next_pending;
    }
    or { runtime.completions_head = context.next_pending; }
    if (context.next_pending != nil) {
        context.next_pending.prev_pending = context.prev_pending;
    }
    or { runtime.completions_tail = context.prev_pending; }
    context.next_pending = nil;
    context.prev_pending = nil;
}

fun make_context(context: *CompletionContext, runtime: *Runtime, kind: CompletionKind,
    pump: usize, pump_generation: u64, connection: usize,
    connection_generation: u64, operation: usize,
    operation_generation: u64, value: qt.Token) bool {
    if (context == nil) { ret false; }
    context.kind                  = kind;
    context.pump                  = pump;
    context.pump_generation       = pump_generation;
    context.connection            = connection;
    context.connection_generation = connection_generation;
    context.operation             = operation;
    context.operation_generation  = operation_generation;
    context.token_source          = value.source;
    context.token_index           = value.index;
    context.token_generation      = value.generation;
    context.runtime               = runtime;
    context.next_pending          = nil;
    context.prev_pending          = nil;
    context.completion_pending    = false;
    ret hedge_operation.bind_operation(?context.operation_owner,
        ?context.route, (context)::ptr, queue_completion, 0);
}

fun no_token() qt.Token {
    ret qt.Token{source: 0, index: 0, generation: 0};
}

fun reset_receive_packet(pump: *Pump, index: usize) {
    val packet: *net_types.Packet = ?pump.storage.receive_packets[index];
    packet.buffer                = ?pump.storage.receive_buffers[index][0];
    packet.capacity              = assembly.MAX_UDP_PAYLOAD;
    packet.length                = 0;
    packet.interface_index       = 0;
    packet.has_local_destination = false;
    packet.truncated             = false;
    packet.zero_length           = false;
}

# an unpublished listener is aborted rather than closed, and a cleanup that
# reported retained ownership is retried under the same handle
fun release_listener_lease(bank: *AdmissionGeneration) bool {
    if (bank == nil || !bank.listener_owned) { ret true; }
    var result: quic_listener.LeaseCleanupResult;
    if (bank.listener_cleanup_retained) {
        result = quic_listener.retry_initialization_cleanup(?bank.listener,
            bank.lease);
    }
    or (!bank.listener_published) {
        result = quic_listener.abort_initialize(?bank.listener, bank.lease);
    }
    or {
        if (!quic_listener.begin_close(?bank.listener)) { ret false; }
        result = quic_listener.finish_close_result(?bank.listener);
    }
    if (result.status == quic_listener.CLEANUP_RETAINED) {
        bank.listener_cleanup_retained = true;
        ret false;
    }
    if (result.status != quic_listener.CLEANUP_COMPLETE) { ret false; }
    bank.listener_cleanup_retained = false;
    bank.listener_published        = false;
    bank.listener_owned            = false;
    ret true;
}

fun abandon_admission_parts(bank: *AdmissionGeneration,
    listener_live: bool, admissions_live: bool, tokens_live: bool) bool {
    if (bank == nil) { ret false; }
    var success: bool = true;
    if (listener_live) {
        if (!release_listener_lease(bank)) { success = false; }
    }
    if (admissions_live) {
        if (!admission.begin_close(?bank.admissions)
            || !admission.finish_close(?bank.admissions)) { success = false; }
    }
    if (tokens_live) {
        if (!token.begin_close(?bank.tokens)
            || !token.finish_close(?bank.tokens)) { success = false; }
    }
    ret success;
}

fun initialize_admission_inner(pump: *Pump, bank_index: usize,
    config: *PumpConfig, require_policy_identity: bool) bool {
    if (pump == nil || pump.backing == nil || bank_index >= ADMISSION_BANKS
        || !pump_config_shape_valid(config)
        || (require_policy_identity && !pump_config_valid(config))) {
        ret false;
    }
    val bank: *AdmissionGeneration = ?pump.admissions[bank_index];
    if (bank.live) { ret false; }
    if (!admission.initialize(?bank.admissions, admission.Config{
        source:                   config.admission_generation,
        max_connections:          config.connection_limit,
        max_connections_per_peer: config.max_connections_per_peer
    },
        pump.backing)) { ret false; }
    if (!token.initialize(?bank.tokens, token.Config{
        source:          config.admission_generation,
        retry_max_age:   config.retry_max_age_ns::i64 * duration.NANOSECOND,
        address_max_age: config.address_max_age_ns::i64 * duration.NANOSECOND,
        max_replay:      config.max_replay
    },
        pump.backing, pump.token_generation, contracts.SecretBytes{
        data: ?pump.token_key[0], len: token.KEY_SIZE
    })) {
        abandon_admission_parts(bank, false, true, false);
        ret false;
    }
    pump.storage.versions[0] = 0x00000001;
    pump.storage.versions[1] = 0x6b3343cf;
    val opened: quic_listener.InitializeResult =
        quic_listener.initialize_result(?bank.listener, quic_listener.Config{
        source:                  config.admission_generation,
        supported_versions:      ?pump.storage.versions[0],
        supported_version_count: 2, minimum_initial_size: 1200,
        require_retry:           config.require_retry
    },
        pump.backing, ?bank.admissions, ?bank.tokens);
    if (!opened.ok) {
        bank.lease          = opened.handle;
        bank.listener_owned =
            opened.cleanup.status == quic_listener.CLEANUP_RETAINED;
        bank.listener_cleanup_retained = bank.listener_owned;
        bank.listener_published        = false;
        abandon_admission_parts(bank, false, true, true);
        ret false;
    }
    bank.lease                     = opened.handle;
    bank.listener_owned            = true;
    bank.listener_published        = false;
    bank.listener_cleanup_retained = false;
    bank.source                    = config.admission_generation;
    bank.active_connections        = 0;
    bank.queued_initials           = 0;
    bank.retiring                  = false;
    bank.live                      = true;
    ret true;
}

fun initialize_admission(pump: *Pump, bank_index: usize,
    config: *PumpConfig) bool {
    ret initialize_admission_inner(pump, bank_index, config, true);
}

fun abandon_attached_pump(pump: *Pump) bool {
    if (pump == nil) { ret false; }
    var success: bool  = true;
    var i:       usize = 0;
    for (i < ADMISSION_BANKS) {
        val bank: *AdmissionGeneration = ?pump.admissions[i];
        if (bank.live) {
            if (!begin_retire(bank) || !reap_admission(bank)) {
                success = false;
            }
        }
        i = i + 1;
    }
    if (pump.scope_live) {
        if (!operation_ok(cancel.destroy(?pump.storage.scope))) {
            success = false;
        }
        or {
            pump.scope_live = false;
        }
    }
    ct.zeroize(?pump.token_key[0], token.KEY_SIZE);
    if (!hedge_storage.destroy_table[StatelessSend](?pump.stateless)) {
        success = false;
    }
    if (!destroy_arrivals(pump)) { success = false; }
    if (!success)                { ret false; }
    pump.driver        = nil;
    pump.socket        = nil;
    pump.root          = nil;
    pump.tls_policy    = nil;
    pump.plan          = nil;
    pump.budgets       = nil;
    pump.listener_name = nil;
    clear_pump_config(pump);
    pump.storage         = nil;
    pump.started         = false;
    pump.receive_pending = false;
    pump.draining        = false;
    pump.cancelling      = false;
    pump.live            = false;
    ret true;
}

fun free_pump(controls: *ControlView, runtime: *Runtime) usize {
    var i: usize = 0;
    for (i < MAX_PUMPS) {
        if (!controls.pumps[i].live) { ret i; }
        i = i + 1;
    }
    ret NO_PUMP;
}

pub fun attach(controls: *ControlView, runtime: *Runtime, driver: *net_async.Driver,
    socket: *udp.Socket, root: *cancel.Scope, local: ip.Endpoint,
    config: PumpConfig, storage: *PumpStorage,
    output: *PumpHandle) Status {
    if (runtime == nil || !runtime.initialized || runtime.stopping
        || driver == nil || socket == nil || root == nil || storage == nil
        || output == nil
        || !pump_config_valid(?config)) { ret INVALID; }
    val index: usize = free_pump(controls, runtime);
    if (index == NO_PUMP) { ret BLOCKED; }
    val pump: *Pump = ?controls.pumps[index];
    pump.storage          = storage;
    pump.backing          = runtime.backing;
    pump.generation       = next_generation(pump.generation);
    pump.token_generation = next_generation(pump.token_generation);
    pump.live             = false;
    pump.scope_live       = false;
    pump.receive_pending  = false;
    pump.started          = false;
    pump.draining         = false;
    pump.cancelling       = false;
    if (!hedge_storage.make_table[StatelessSend](?pump.stateless, pump.backing)) {
        ret FAILED;
    }
    pump.stateless_generation = 0;
    pump.stateless_pending    = NO_CONNECTION;
    pump.stateless_live       = 0;
    if (!make_arrivals(pump, pump.backing)) {
        if (!hedge_storage.destroy_table[StatelessSend](?pump.stateless)) {
            connection_failed(runtime);
        }
        ret FAILED;
    }
    reset_arrivals(pump);
    var i: usize = 0;
    for (i < ADMISSION_BANKS) {
        pump.admissions[i].live     = false;
        pump.admissions[i].retiring = false;
        i                           = i + 1;
    }
    val keyed: err[io_error.Error] = memory_secret.random_fill(?pump.token_key[0], token.KEY_SIZE);
    if (sel keyed.err) {
        ct.zeroize(?pump.token_key[0], token.KEY_SIZE);
        ret FAILED;
    }
    if (!operation_ok(cancel.make_child(?pump.storage.scope, root,
        opt[time.Instant].none{}))) {
        ct.zeroize(?pump.token_key[0], token.KEY_SIZE);
        ret FAILED;
    }
    pump.scope_live         = true;
    pump.driver             = driver;
    pump.socket             = socket;
    pump.root               = root;
    pump.local              = local;
    pump.active_connections = 0;
    pump.queued_initials    = 0;
    pump.active_admission   = 0;
    if (!initialize_admission(pump, 0, ?config)) {
        abandon_attached_pump(pump);
        ret FAILED;
    }
    apply_pump_config(runtime, pump, ?config);
    i = 0;
    for (i < RECEIVE_BATCH) {
        reset_receive_packet(pump, i);
        i = i + 1;
    }
    if (!make_context(?pump.storage.receive_context, runtime, COMPLETION_RECEIVE, index,
        pump.generation, NO_CONNECTION, 0, 0, 0, no_token())) {
        abandon_attached_pump(pump);
        ret FAILED;
    }
    pump.live          = true;
    runtime.pump_count = runtime.pump_count + 1;
    @output            = PumpHandle{index: index, generation: pump.generation};
    ret OK;
}

fun submit_receive(pump: *Pump) Status {
    if (pump == nil || !pump.live || !pump.started || pump.receive_pending
        || pump.driver == nil || pump.socket == nil || !pump.scope_live
        || !scope_active(?pump.storage.scope)) { ret INVALID; }
    val submitted: res[io_runtime.Token, io_error.Error] =
        net_async.submit_receive_batch(pump.driver, ?pump.storage.scope, pump.socket,
        ?pump.storage.receive_packets[0], RECEIVE_BATCH,
        (?pump.storage.receive_context.route)::usize);
    if (sel submitted.err) { ret FAILED; }
    pump.receive_pending = true;
    ret OK;
}

pub fun start(controls: *ControlView, runtime: *Runtime, handle: PumpHandle) Status {
    val pump: *Pump = pump_for(controls, runtime, handle);
    if (pump == nil || pump.started || pump.draining || pump.cancelling) {
        ret INVALID;
    }
    pump.started = true;
    val status: Status = submit_receive(pump);
    if (status != OK) {
        pump.started = false;
        ret status;
    }
    val bank: *AdmissionGeneration = ?pump.admissions[pump.active_admission];
    if (bank.live) { bank.listener_published = true; }
    ret status;
}

fun begin_retire(bank: *AdmissionGeneration) bool {
    if (bank == nil || !bank.live) { ret false; }
    if (bank.retiring)             { ret true; }
    if (!bank.listener_published) {
        bank.retiring = true;
        ret true;
    }
    if (!quic_listener.begin_close(?bank.listener)) { ret false; }
    bank.retiring = true;
    ret true;
}

# begin_close already ran for a published listener, so the terminal step is the
# lease-reporting close; an unpublished one is aborted instead
fun finish_listener_close(bank: *AdmissionGeneration) bool {
    if (bank == nil || !bank.listener_owned) { ret true; }
    var result: quic_listener.LeaseCleanupResult;
    if (bank.listener_cleanup_retained) {
        result = quic_listener.retry_initialization_cleanup(?bank.listener,
            bank.lease);
    }
    or (!bank.listener_published) {
        result = quic_listener.abort_initialize(?bank.listener, bank.lease);
    }
    or {
        result = quic_listener.finish_close_result(?bank.listener);
    }
    if (result.status == quic_listener.CLEANUP_RETAINED) {
        bank.listener_cleanup_retained = true;
        ret false;
    }
    if (result.status != quic_listener.CLEANUP_COMPLETE) { ret false; }
    bank.listener_cleanup_retained = false;
    bank.listener_published        = false;
    bank.listener_owned            = false;
    ret true;
}

fun reap_admission(bank: *AdmissionGeneration) bool {
    if (bank == nil || !bank.live || !bank.retiring
        || bank.active_connections != 0 || bank.queued_initials != 0) { ret false; }
    if (!finish_listener_close(bank)
        || !admission.begin_close(?bank.admissions)
        || !admission.finish_close(?bank.admissions)
        || !token.begin_close(?bank.tokens)
        || !token.finish_close(?bank.tokens)) { ret false; }
    bank.live     = false;
    bank.retiring = false;
    bank.source   = 0;
    ret true;
}

fun apply_pump_config(runtime: *Runtime, pump: *Pump, config: *PumpConfig) {
    runtime.max_handshakes = config.max_handshakes;
    process_admission.retune(?runtime.handshakes, opt[usize].none{},
        config.max_handshakes_per_peer);
    pump.config                   = @config;
    pump.tls_policy               = config.tls_policy;
    pump.plan                     = config.plan;
    pump.budgets                  = config.budgets;
    pump.limits                   = config.limits;
    pump.listener_name            = config.listener_name;
    pump.handshake_timeout_ns     = config.handshake_timeout_ns;
    pump.request_timeout_ns       = config.request_timeout_ns;
    pump.idle_timeout_ms          = config.idle_timeout_ms;
    pump.drain_timeout_ns         = config.drain_timeout_ns;
    pump.connection_limit         = config.connection_limit;
    pump.max_connections_per_peer = config.max_connections_per_peer;
    pump.max_requests             = config.max_requests;
    pump.arrival_capacity         = arrival_capacity(config.receive_buffer_bytes);
}

# as many held Initials as the socket's receive buffer holds, and never fewer
# than one receive batch, so a reload that shrinks the buffer cannot leave the
# queue smaller than one turn's reads
fun arrival_capacity(receive_buffer_bytes: usize) usize {
    var capacity: usize = receive_buffer_bytes / MIN_INITIAL_BYTES;
    if (capacity < RECEIVE_BATCH) { capacity = RECEIVE_BATCH; }
    ret capacity;
}

fun clear_pump_config(pump: *Pump) {
    pump.config.tls_policy       = nil;
    pump.config.tls_policy_index = hedge_tls.NO_POLICY;
    pump.config.plan             = nil;
    pump.config.budgets          = nil;
    pump.config.listener_name    = nil;
}

fun rollback_staged_updates(controls: *ControlView, runtime: *Runtime, updates: *PumpUpdate,
    count: usize, staged: *bool) bool {
    var success: bool  = true;
    var i:       usize = 0;
    for (i < count) {
        if (staged[i]) {
            val pump:   *Pump                = ?controls.pumps[updates[i].handle.index];
            val target: usize                = 1 - pump.active_admission;
            val bank:   *AdmissionGeneration = ?pump.admissions[target];
            if (!begin_retire(bank) || !reap_admission(bank)) {
                success = false;
            }
        }
        i = i + 1;
    }
    ret success;
}

fun connection_superseded(controls: *ControlView, runtime: *Runtime, value: *Connection) bool {
    if (runtime == nil || value == nil || !value.live
        || value.pump >= MAX_PUMPS) { ret false; }
    val pump: *Pump = ?controls.pumps[value.pump];
    ret !pump.live || value.pump_generation != pump.generation
        || value.admission_bank != pump.active_admission
        || value.plan == nil || pump.plan == nil
        || value.plan.generation != pump.plan.generation;
}

fun pending_superseded(controls: *ControlView, pending: *PendingInitial) bool {
    if (pending == nil || !pending.live || pending.pump >= MAX_PUMPS) { ret false; }
    val pump: *Pump = ?controls.pumps[pending.pump];
    ret !pump.live || pending.pump_generation != pump.generation
        || pending.admission_bank != pump.active_admission
        || pending.config.plan == nil || pump.plan == nil
        || pending.config.plan.generation != pump.plan.generation;
}

# a record enters the superseded total once and leaves it on release
fun note_superseded(runtime: *Runtime, flag: *bool, is: bool) {
    if (!is || @flag) { ret; }
    @flag                    = true;
    runtime.superseded_total = runtime.superseded_total + 1;
}

fun release_superseded(runtime: *Runtime, flag: *bool) {
    if (!@flag) { ret; }
    @flag = false;
    if (runtime.superseded_total != 0) {
        runtime.superseded_total = runtime.superseded_total - 1;
    }
}

fun mark_connection_superseded(controls: *ControlView, runtime: *Runtime,
    index: usize) {
    val value: *Connection = connection_at(controls, index);
    val is:    bool        = connection_superseded(controls, runtime, value);
    note_superseded(runtime, ?value.superseded, is);
    if (value.state == CONNECTION_LIVE && is) {
        value.state = CONNECTION_GRACEFUL;
        mark_ready(controls, runtime, index);
    }
}

# a pump swap is the one event that supersedes records, so it is the one
# place that walks them: every live record and waiting Initial of the pump
# is marked here, and the count is O(1) from then on
fun mark_superseded_graceful(controls: *ControlView, runtime: *Runtime) {
    var i: usize = runtime.live_head;
    for (i != NO_CONNECTION) {
        val next: usize = connection_at(controls, i).next_live;
        mark_connection_superseded(controls, runtime, i);
        i = next;
    }
    i = runtime.pending_live_head;
    for (i != NO_CONNECTION) {
        val pending: *PendingInitial = pending_at(runtime, i);
        note_superseded(runtime, ?pending.superseded,
            pending_superseded(controls, pending));
        i = pending.next_live;
    }
}

fun update_result(status: Status, committed: bool,
    rollback_failed: bool) UpdateResult {
    ret UpdateResult{status: status, committed: committed,
        rollback_failed: rollback_failed};
}

fun rollback_result(controls: *ControlView, runtime: *Runtime, updates: *PumpUpdate,
    count: usize, staged: *bool, status: Status) UpdateResult {
    val rolled_back: bool = rollback_staged_updates(controls, runtime, updates,
        count, staged);
    ret update_result(status, false, !rolled_back);
}

fun update_transaction(controls: *ControlView, runtime: *Runtime, updates: *PumpUpdate,
    count: usize, require_all: bool,
    require_policy_identity: bool) UpdateResult {
    if (runtime == nil || !runtime.initialized || runtime.stopping
        || count > MAX_PUMPS || (count != 0 && updates == nil)
        || (require_all && count != runtime.pump_count)) {
        ret update_result(INVALID, false, false);
    }
    if (count == 0) { ret update_result(OK, true, false); }
    var changed: [MAX_PUMPS]bool;
    var staged:  [MAX_PUMPS]bool;
    var i:       usize = 0;
    for (i < count) {
        val update: *PumpUpdate = ?updates[i];
        val pump:   *Pump       = pump_for(controls, runtime, update.handle);
        if (pump == nil || !pump_config_shape_valid(?update.config)
            || (require_policy_identity && !pump_config_valid(?update.config))
            || pump.draining || pump.cancelling
            || !limit_holds(update.config.connection_limit,
            pump.active_connections, pump.queued_initials)) {
            ret update_result(INVALID, false, false);
        }
        var prior: usize = 0;
        for (prior < i) {
            if (updates[prior].handle.index == update.handle.index) {
                ret update_result(INVALID, false, false);
            }
            prior = prior + 1;
        }
        val current: usize                = pump.active_admission;
        val old:     *AdmissionGeneration = ?pump.admissions[current];
        if (!old.live || old.retiring) {
            ret update_result(INVALID, false, false);
        }
        changed[i] = update.config.admission_generation != old.source;
        if (changed[i]) {
            val next: *AdmissionGeneration =
                ?pump.admissions[1 - current];
            if (next.live
                && (!next.retiring || next.active_connections != 0
                || next.queued_initials != 0)) {
                ret update_result(BLOCKED, false, false);
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (changed[i]) {
            val pump:   *Pump                = ?controls.pumps[updates[i].handle.index];
            val target: usize                = 1 - pump.active_admission;
            val next:   *AdmissionGeneration = ?pump.admissions[target];
            if (next.live && !reap_admission(next)) {
                ret rollback_result(controls, runtime, updates, count, ?staged[0],
                    BLOCKED);
            }
            if (!initialize_admission_inner(pump, target,
                ?updates[i].config, require_policy_identity)) {
                ret rollback_result(controls, runtime, updates, count, ?staged[0],
                    FAILED);
            }
            staged[i] = true;
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        val pump: *Pump = ?controls.pumps[updates[i].handle.index];
        if (changed[i]) { pump.active_admission = 1 - pump.active_admission; }
        apply_pump_config(runtime, pump, ?updates[i].config);
        i = i + 1;
    }
    mark_superseded_graceful(controls, runtime);
    i = 0;
    for (i < count) {
        if (changed[i]) {
            val pump: *Pump                = ?controls.pumps[updates[i].handle.index];
            val old:  *AdmissionGeneration =
                ?pump.admissions[1 - pump.active_admission];
            if (!begin_retire(old)) {
                ret update_result(FAILED, true, false);
            }
        }
        i = i + 1;
    }
    ret update_result(OK, true, false);
}

pub fun update(controls: *ControlView, runtime: *Runtime, handle: PumpHandle,
    config: PumpConfig) UpdateResult {
    var updates: [1]PumpUpdate;
    updates[0] = PumpUpdate{handle: handle, config: config};
    ret update_transaction(controls, runtime, ?updates[0], 1, false, true);
}

pub fun update_all(controls: *ControlView, runtime: *Runtime, updates: *PumpUpdate,
    count: usize) UpdateResult {
    ret update_transaction(controls, runtime, updates, count, true, true);
}

# one more connection fits the pump's cap, if it has one, and a slot and a
# pending initial are reserved for it. a refused reservation is a refusal.
fun capacity_available(controls: *ControlView, runtime: *Runtime, pump: *Pump) bool {
    if (runtime == nil || pump == nil || runtime.admission == nil
        || !process_admission.available(runtime.admission)) {
        ret false;
    }
    if (sel pump.connection_limit.some
        && (pump.queued_initials >= pump.connection_limit.some
        || pump.active_connections
        >= pump.connection_limit.some - pump.queued_initials)) {
        ret false;
    }
    ret reserve_capacity(runtime);
}

# NO_CONNECTION when the allocator refuses a slot or its storage
fun acquire_connection(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    admission_bank: usize, lease: process_admission.Lease) usize {
    if (runtime == nil || pump_index >= MAX_PUMPS
        || admission_bank >= ADMISSION_BANKS) {
        ret NO_CONNECTION;
    }
    # the slab welds a chunk on demand and hands back the lowest free index; the
    # timer and connection storage are claimed alongside and unwound on refusal
    val index: usize = hedge_storage.secret_table_claim[Connection](controls.connections);
    if (index == NO_CONNECTION) { ret NO_CONNECTION; }
    val handle: wheel.Handle = wheel.claim(runtime.timers, timer_owner(index));
    if (handle.index == wheel.NONE) {
        hedge_storage.secret_table_release[Connection](controls.connections, index);
        ret NO_CONNECTION;
    }
    val storage: *ConnectionStorage =
        hedge_storage.claim[ConnectionStorage](?runtime.connection_storages);
    if (storage == nil) {
        wheel.release(runtime.timers, handle);
        hedge_storage.secret_table_release[Connection](controls.connections, index);
        ret NO_CONNECTION;
    }
    # a claimed slot is either reused or a freshly welded (zeroed) chunk, and zero
    # is not the sentinel for the link fields, so normalize it before arming
    val value: *Connection = connection_at(controls, index);
    reset_connection(value);
    var idle: qt.Timer;
    value.timer                   = handle;
    value.transport_timer         = idle;
    value.storage                 = storage;
    runtime.connection_generation = next_generation(runtime.connection_generation);
    value.generation              = runtime.connection_generation;
    value.source                  = runtime.next_source;
    runtime.next_source           = next_generation(runtime.next_source);
    value.pump                    = pump_index;
    value.pump_generation         = controls.pumps[pump_index].generation;
    value.admission_bank          = admission_bank;
    value.lease                   = lease;
    value.state                   = CONNECTION_ACCEPTING;
    value.h3_session              = h3_session.NO_SESSION;
    value.h3_deadline_ns          = 0;
    value.memory_deadline_ns      = 0;
    value.handshake               = NO_HANDSHAKE;
    value.scope_live              = false;
    value.charge_live             = false;
    value.budget_charge_live      = false;
    value.lease_live              = lease.generation != 0;
    value.h3_started              = false;
    value.h3_abandoning           = false;
    value.h3_cancelled            = false;
    value.close_started           = false;
    value.close_deadline_ns       = 0;
    value.transport_finished      = false;
    value.timer_disarmed          = false;
    value.routes_removed          = false;
    value.tls_live                = false;
    value.assembly_attempted      = false;
    value.assembly_released       = false;
    arm_connection_storage(value);
    value.superseded = false;
    value.live       = true;
    link_live(controls, runtime, index);
    runtime.live_connections                      = runtime.live_connections + 1;
    runtime.live_total                            = runtime.live_total + 1;
    controls.pumps[pump_index].active_connections =
        controls.pumps[pump_index].active_connections + 1;
    controls.pumps[pump_index].admissions[admission_bank].active_connections =
        controls.pumps[pump_index].admissions[admission_bank].active_connections + 1;
    ret index;
}

fun release_process_lease(runtime: *Runtime, value: *Connection) bool {
    if (value.lease_live) {
        if (runtime.admission == nil
            || !process_admission.release(runtime.admission,
            value.lease)) { ret false; }
        value.lease_live = false;
    }
    ret true;
}

fun free_connection(controls: *ControlView, runtime: *Runtime, index: usize) {
    val value: *Connection = connection_at(controls, index);
    if (value.pump < MAX_PUMPS) {
        val pump: *Pump = ?controls.pumps[value.pump];
        if (pump.active_connections != 0) {
            pump.active_connections = pump.active_connections - 1;
        }
        if (value.admission_bank < ADMISSION_BANKS) {
            val bank: *AdmissionGeneration =
                ?pump.admissions[value.admission_bank];
            if (bank.active_connections != 0) {
                bank.active_connections = bank.active_connections - 1;
            }
        }
    }
    if (runtime.live_connections != 0) {
        runtime.live_connections = runtime.live_connections - 1;
    }
    if (runtime.live_total != 0) { runtime.live_total = runtime.live_total - 1; }
    release_superseded(runtime, ?value.superseded);
    value.lease                    = process_admission.no_lease();
    value.policy                   = nil;
    value.plan                     = nil;
    value.budgets                  = nil;
    value.charge.source            = 0;
    value.charge.index             = 0;
    value.charge.generation        = 0;
    value.budget_charge            = budget.no_charge();
    value.storage.listener_name[0] = 0;
    value.listener_name_length     = 0;
    value.peer                     = ip.endpoint(0, 0, 0, 0, 0);
    value.local                    = ip.endpoint(0, 0, 0, 0, 0);
    unmark_ready(controls, runtime, index);
    set_waiting(controls, runtime, index, false);
    release_held(runtime, ?value.held);
    wheel.release(runtime.timers, value.timer);
    value.timer = wheel.no_handle();
    var send: usize = 0;
    for (send < assembly.SEND_CAPACITY) {
        unqueue_completion(runtime, ?value.storage.sends[send].context);
        send = send + 1;
    }
    value.live = false;
    unlink_live(controls, runtime, index);
    # the scope is destroyed by now, so nothing io holds points into the storage
    hedge_storage.release[ConnectionStorage](?runtime.connection_storages,
        value.storage);
    value.storage = nil;
    value.state   = CONNECTION_FREE;
    # release last: the timer and storage are already back, so a compacted-away
    # chunk strands nothing. `value` must not be touched after this.
    hedge_storage.secret_table_release[Connection](controls.connections, index);
}

fun return_connection(controls: *ControlView, runtime: *Runtime, index: usize) bool {
    val value: *Connection = connection_at(controls, index);
    if (!release_process_lease(runtime, value)) { ret false; }
    free_connection(controls, runtime, index);
    ret true;
}

fun connection_for(controls: *ControlView, runtime: *Runtime, index: usize,
    generation: u64) *Connection {
    if (runtime == nil || !runtime.initialized) { ret nil; }
    val value: *Connection = connection_at(controls, index);
    if (value == nil || !value.live || value.generation != generation) { ret nil; }
    ret value;
}

fun same_route_binding(left: routing.Binding,
    right: routing.Binding) bool {
    ret left.connection_slot == right.connection_slot
        && left.connection_generation == right.connection_generation
        && left.route_index == right.route_index
        && left.route_generation == right.route_generation
        && left.route_sequence == right.route_sequence
        && left.pump_generation == right.pump_generation
        && left.pending == right.pending;
}

fun route_binding(value: *Connection, slot: usize,
    route: assembly.Route) routing.Binding {
    ret routing.Binding{connection_slot: slot,
        connection_generation: value.generation,
        route_index:           route.index, route_generation: route.generation,
        route_sequence:        route.sequence,
        pump_generation:       value.pump_generation};
}

fun unpublish_route(runtime: *Runtime,
    published: *PublishedRoute) bool {
    if (!published.live) { ret true; }
    val removed: routing.Status = routing.unpublish(?runtime.routes,
        published.key, published.binding);
    if (removed != routing.ROUTE_OK && removed != routing.ROUTE_MISSING) {
        ret false;
    }
    published.live = false;
    ret true;
}

fun route_matches(value: *Connection, published: *PublishedRoute,
    route: assembly.Route, binding_value: routing.Binding) bool {
    ret published.live && same_route_binding(published.binding, binding_value)
        && route.active && route.id.length == published.key.length
        && assembly.route_valid(?value.assembly, ?route);
}

# the copied table is reconciled after every operation that can mutate core state
fun reconcile_routes(controls: *ControlView, runtime: *Runtime, index: usize) bool {
    val value: *Connection = connection_at(controls, index);
    if (!value.live || !value.assembly.initialized) { ret false; }
    val snapshot: assembly.RoutingSnapshot =
        assembly.routing_snapshot(?value.assembly);
    if (!snapshot.initialized
        || snapshot.capacity > assembly.CONNECTION_ID_CAPACITY) { ret false; }
    var i: usize = 0;
    for (i < assembly.CONNECTION_ID_CAPACITY) {
        val published: *PublishedRoute = ?value.storage.published[i];
        if (published.live) {
            if (i >= snapshot.capacity) {
                if (!unpublish_route(runtime, published)) { ret false; }
            }
            or {
                val current: assembly.Route =
                    assembly.route_at(?value.assembly, i);
                val current_binding: routing.Binding =
                    route_binding(value, index, current);
                if (!route_matches(value, published, current,
                    current_binding)) {
                    if (!unpublish_route(runtime, published)) { ret false; }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < snapshot.capacity) {
        val route: assembly.Route = assembly.route_at(?value.assembly, i);
        if (route.active) {
            if (!assembly.route_valid(?value.assembly, ?route)
                || route.id.length == 0
                || route.id.length > routing.MAX_CID_BYTES) { ret false; }
            val key: routing.Key = routing.key(?route.id.data[0],
                route.id.length);
            val binding_value: routing.Binding =
                route_binding(value, index, route);
            val published: *PublishedRoute = ?value.storage.published[i];
            if (!published.live) {
                if (routing.publish(?runtime.routes, key,
                    binding_value) != routing.ROUTE_OK) { ret false; }
                published.key     = key;
                published.binding = binding_value;
                published.live    = true;
            }
        }
        i = i + 1;
    }
    ret true;
}

fun remove_routes(runtime: *Runtime, value: *Connection) bool {
    var i: usize = 0;
    for (i < assembly.CONNECTION_ID_CAPACITY) {
        if (!unpublish_route(runtime, ?value.storage.published[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun timer_owner(index: usize) u64 {
    ret TIMER_TAG | index::u64;
}

pub fun owns_timer(owner: u64) bool {
    ret (owner & TIMER_MASK) == TIMER_TAG;
}

fun pending_owner(index: usize) u64 {
    ret PENDING_TAG | index::u64;
}

fun owns_pending(owner: u64) bool {
    ret (owner & TIMER_MASK) == PENDING_TAG;
}

# every owner this runtime hands to the wheel or to a waker
pub fun owns(owner: u64) bool {
    ret owns_timer(owner) || owns_pending(owner);
}

# the wheel entry follows the earliest thing this connection is waiting for in
# time: the transport's deadline, the drain deadline once closing, the earliest
# h3 deadline, the memory-wait deadline, and a short retry while a forced
# release is still blocked
fun arm_timer(runtime: *Runtime, value: *Connection, now_ns: u64) bool {
    if (value.state == CONNECTION_BROKEN) {
        ret wheel.arm(runtime.timers, value.timer,
            saturated_add(now_ns, BROKEN_RETRY_NS)) == wheel.OK;
    }
    var armed:    bool = false;
    var deadline: u64  = 0;
    if (!value.timer_disarmed && value.transport_timer.armed) {
        armed    = true;
        deadline = clock.to_ns(value.transport_timer.deadline);
    }
    if (value.close_started && value.close_deadline_ns != 0
        && (!armed || value.close_deadline_ns < deadline)) {
        armed    = true;
        deadline = value.close_deadline_ns;
    }
    if (value.h3_deadline_ns != 0 && (!armed || value.h3_deadline_ns < deadline)) {
        armed    = true;
        deadline = value.h3_deadline_ns;
    }
    if (value.memory_deadline_ns != 0
        && (!armed || value.memory_deadline_ns < deadline)) {
        armed    = true;
        deadline = value.memory_deadline_ns;
    }
    if (!armed) { ret wheel.disarm(runtime.timers, value.timer) == wheel.OK; }
    ret wheel.arm(runtime.timers, value.timer, deadline) == wheel.OK;
}

fun refresh_timer(controls: *ControlView, runtime: *Runtime, index: usize) bool {
    val value: *Connection = connection_at(controls, index);
    if (!value.live || !value.assembly.initialized) { ret false; }
    value.transport_timer = qt.timer[binding.Binding](?value.assembly.driver);
    ret arm_timer(runtime, value, 0);
}

# a connection's turn is handshake work while its handshake is running: the
# record a cleanup or a broken connection still holds is bookkeeping, and
# bookkeeping retried every turn must not spend the crypto budget or a
# promotion waits behind it
fun handshake_work(value: *Connection) bool {
    ret value.handshake != NO_HANDSHAKE && value.state != CONNECTION_BROKEN
        && value.state != CONNECTION_CLEANUP && value.state != CONNECTION_FINALIZING;
}

# a connection with work joins the ready list, or the handshake ready list
# while its work is the crypto
fun mark_ready(controls: *ControlView, runtime: *Runtime, index: usize) {
    val value: *Connection = connection_at(controls, index);
    if (value == nil || !value.live || value.ready) { ret; }
    val handshaking: bool  = handshake_work(value);
    var tail:        usize = runtime.ready_tail;
    if (handshaking) { tail = runtime.handshake_ready_tail; }
    value.ready           = true;
    value.ready_handshake = handshaking;
    value.ready_next      = NO_CONNECTION;
    value.ready_prev      = tail;
    if (tail != NO_CONNECTION) {
        connection_at(controls, tail).ready_next = index;
    }
    or (handshaking) { runtime.handshake_ready_head = index; }
    or               { runtime.ready_head = index; }
    if (handshaking) { runtime.handshake_ready_tail = index; }
    or               { runtime.ready_tail = index; }
}

fun unmark_ready(controls: *ControlView, runtime: *Runtime, index: usize) {
    val value: *Connection = connection_at(controls, index);
    if (!value.ready) { ret; }
    if (value.ready_prev != NO_CONNECTION) {
        connection_at(controls, value.ready_prev).ready_next = value.ready_next;
    }
    or (value.ready_handshake) { runtime.handshake_ready_head = value.ready_next; }
    or                         { runtime.ready_head = value.ready_next; }
    if (value.ready_next != NO_CONNECTION) {
        connection_at(controls, value.ready_next).ready_prev = value.ready_prev;
    }
    or (value.ready_handshake) { runtime.handshake_ready_tail = value.ready_prev; }
    or                         { runtime.ready_tail = value.ready_prev; }
    value.ready           = false;
    value.ready_handshake = false;
    value.ready_next      = NO_CONNECTION;
    value.ready_prev      = NO_CONNECTION;
}

fun held_at(runtime: *Runtime, index: usize) *HeldDatagram {
    ret hedge_storage.table_at[HeldDatagram](?runtime.held, index);
}

fun reset_held(queue: *HeldQueue) {
    queue.head  = NO_CONNECTION;
    queue.tail  = NO_CONNECTION;
    queue.count = 0;
}

# copy a datagram onto a held queue: a connection's mid-handshake, or a pending
# initial's. past the per-queue ceiling, or when the table cannot grow, it is
# dropped and the client's retransmit is the retry
fun hold_datagram(runtime: *Runtime, queue: *HeldQueue, ceiling: usize,
    received: *net_types.Packet) bool {
    if (queue.count >= ceiling) {
        runtime.held_dropped = runtime.held_dropped + 1;
        ret false;
    }
    val slot: usize = hedge_storage.table_claim[HeldDatagram](?runtime.held);
    if (slot == hedge_storage.NO_INDEX) {
        runtime.held_dropped = runtime.held_dropped + 1;
        ret false;
    }
    val held: *HeldDatagram = held_at(runtime, slot);
    std_memory.raw_copy(?held.data[0], received.buffer, received.length);
    held.peer                  = received.peer;
    held.local_destination     = received.local_destination;
    held.length                = received.length;
    held.interface_index       = received.interface_index;
    held.has_local_destination = received.has_local_destination;
    held.next                  = NO_CONNECTION;
    if (queue.tail != NO_CONNECTION) {
        held_at(runtime, queue.tail).next = slot;
    }
    or { queue.head = slot; }
    queue.tail  = slot;
    queue.count = queue.count + 1;
    ret true;
}

fun release_held(runtime: *Runtime, queue: *HeldQueue) {
    var i: usize = queue.head;
    for (i != NO_CONNECTION) {
        val next: usize = held_at(runtime, i).next;
        hedge_storage.table_release[HeldDatagram](?runtime.held, i);
        i = next;
    }
    reset_held(queue);
}

# a promoted initial's held datagrams become its connection's
fun move_held(target: *HeldQueue, source: *HeldQueue) {
    @target = @source;
    reset_held(source);
}

# deliver what was held, in order. this is where a handshake's crypto runs
fun deliver_held(controls: *ControlView, runtime: *Runtime, index: usize,
    now_ns: u64) {
    val value: *Connection = connection_at(controls, index);
    for (value.held.head != NO_CONNECTION && value.live
        && value.state != CONNECTION_BROKEN) {
        val slot:   usize         = value.held.head;
        val held:   *HeldDatagram = held_at(runtime, slot);
        var packet: net_types.Packet;
        packet.buffer                = ?held.data[0];
        packet.capacity              = held.length;
        packet.length                = held.length;
        packet.peer                  = held.peer;
        packet.local_destination     = held.local_destination;
        packet.interface_index       = held.interface_index;
        packet.has_local_destination = held.has_local_destination;
        packet.truncated             = false;
        packet.zero_length           = false;
        val delivered: qt.OperationResult = qt.receive_native[binding.Binding](
            ?value.assembly.driver, ?packet, value.local, clock.from_ns(now_ns), 0);
        # released after delivery: a release may compact the chunk the data is in
        value.held.head = held.next;
        if (value.held.head == NO_CONNECTION) { value.held.tail = NO_CONNECTION; }
        value.held.count = value.held.count - 1;
        hedge_storage.table_release[HeldDatagram](?runtime.held, slot);
        if (delivered.status == qt.STATUS_ERROR
            || !reconcile_routes(controls, runtime, index)
            || !refresh_timer(controls, runtime, index)) {
            fail_connection(controls, runtime, index, now_ns);
        }
    }
}

fun set_waiting(controls: *ControlView, runtime: *Runtime, index: usize, waiting: bool) {
    val value: *Connection = connection_at(controls, index);
    if (value.waiting == waiting) { ret; }
    if (waiting) {
        value.waiting      = true;
        value.waiting_prev = NO_CONNECTION;
        value.waiting_next = runtime.waiting_head;
        if (runtime.waiting_head != NO_CONNECTION) {
            connection_at(controls, runtime.waiting_head).waiting_prev = index;
        }
        runtime.waiting_head = index;
        ret;
    }
    if (value.waiting_prev != NO_CONNECTION) {
        connection_at(controls, value.waiting_prev).waiting_next = value.waiting_next;
    }
    or { runtime.waiting_head = value.waiting_next; }
    if (value.waiting_next != NO_CONNECTION) {
        connection_at(controls, value.waiting_next).waiting_prev = value.waiting_prev;
    }
    value.waiting      = false;
    value.waiting_next = NO_CONNECTION;
    value.waiting_prev = NO_CONNECTION;
}

pub fun has_ready(runtime: *Runtime) bool {
    ret runtime != nil && runtime.initialized
        && (runtime.ready_head != NO_CONNECTION || runtime.completions_head != nil
        || runtime.pending_ready_head != NO_CONNECTION
        || runtime.handshake_ready_head != NO_CONNECTION || promotable(runtime));
}

fun copy_listener_name(value: *Connection, name: str) bool {
    val length: usize = str_len(name);
    if (length == 0 || length >= schema.TEXT_CAP) { ret false; }
    var i: usize = 0;
    for (i < length) {
        value.storage.listener_name[i] = name[i];
        i                              = i + 1;
    }
    value.storage.listener_name[length] = 0;
    value.listener_name_length          = length;
    ret true;
}

fun connection_local(pump: *Pump, received: *net_types.Packet) ip.Endpoint {
    var local: ip.Endpoint = pump.local;
    if (received.has_local_destination) {
        local.addr = received.local_destination;
        if (local.addr.is_v6 != 0) {
            local.scope = received.interface_index;
        }
    }
    ret local;
}

# the engine borrows through the assembly's lease, which points into the
# connection record, so the record never moves while the engine is live
fun initialize_tls(value: *Connection, engine: *server.Handshake,
    parameters_length: usize) bool {
    ret server.init(engine, ?value.policy.configuration,
        assembly.tls_lease(?value.assembly),
        server.ExtraExtension{kind: server.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?value.storage.local_parameters[0],
        len:  parameters_length}},
        server.QUIC_TRANSPORT_PARAMETERS);
}

fun cleanup_accepting(controls: *ControlView, runtime: *Runtime, index: usize) bool {
    val value: *Connection          = connection_at(controls, index);
    val pump:  *Pump                = ?controls.pumps[value.pump];
    val bank:  *AdmissionGeneration = ?pump.admissions[value.admission_bank];
    if (value.state != CONNECTION_CLEANUP) { ret false; }
    if (value.assembly_attempted && !assembly.reusable(?value.assembly)) {
        set_waiting(controls, runtime, index, true);
        ret false;
    }
    if (value.tls_live && server.destroy(handshake_at(controls, value.handshake))) {
        value.tls_live = false;
    }
    if (!value.tls_live && (!value.assembly_attempted || assembly.reusable(?value.assembly))) {
        release_handshake(controls, runtime, index, false, 0);
    }
    if (value.charge_live) {
        if (quic_listener.release_connection(?bank.listener,
            value.charge).action == quic_listener.ACTION_ACCEPT) {
            value.charge_live = false;
        }
    }
    if (value.budget_charge_live) {
        if (budget.release(value.budgets, ?value.budget_charge)) {
            value.budget_charge_live = false;
        }
    }
    if (value.scope_live) {
        if (operation_ok(cancel.destroy(?value.storage.scope))) { value.scope_live = false; }
    }
    # a cleanup that cannot finish now is tried again every turn
    if (value.tls_live || value.handshake != NO_HANDSHAKE || value.charge_live
        || value.budget_charge_live || value.scope_live
        || !return_connection(controls, runtime, index)) {
        set_waiting(controls, runtime, index, true);
        ret false;
    }
    ret true;
}

fun own_connection_admission(value: *Connection,
    accepted: *quic_listener.Accepted,
    budgets: *budget.Set, named_charge: *budget.Charge) {
    value.charge      = accepted.charge;
    value.charge_live = true;
    budget.relocate(budgets, ?value.budget_charge, named_charge);
    value.budget_charge_live = value.budget_charge.live;
}

# the client addresses this connection by the id the server chose in its Retry,
# and the production core carries exactly one local routing id, so the
# connection adopts that id rather than inventing a second one nothing is sent
# to. short headers are parsed at a fixed local id length, so a peer-chosen
# length is refused rather than silently mis-routed.
fun adopt_local_cid(value: *Connection,
    accepted: *quic_listener.Accepted) bool {
    val id: *packet.ConnectionId = ?accepted.initial_destination;
    if (id.len::usize != CONNECTION_ID_BYTES) { ret false; }
    var i: usize = 0;
    for (i < CONNECTION_ID_BYTES) {
        value.storage.local_cid[i] = id.data[i];
        i                          = i + 1;
    }
    ret true;
}

fun initialize_connection(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    bank_index: usize, index: usize, accepted: *quic_listener.Accepted,
    received: *net_types.Packet, config_snapshot: *ConnectionConfig,
    arrival_ns: u64, now_ns: u64) bool {
    val pump:  *Pump       = ?controls.pumps[pump_index];
    val value: *Connection = connection_at(controls, index);
    value.policy             = config_snapshot.tls_policy;
    value.plan               = config_snapshot.plan;
    value.budgets            = config_snapshot.budgets;
    value.limits             = config_snapshot.limits;
    value.peer               = accepted.peer;
    value.local              = connection_local(pump, received);
    value.max_requests       = config_snapshot.max_requests;
    value.call_memory_bytes  = config_snapshot.call_memory_bytes;
    value.request_timeout_ns = config_snapshot.request_timeout_ns;
    value.memory_wait_ns     = config_snapshot.memory_wait_ns;
    value.handshake          = claim_handshake(controls);
    if (value.handshake != NO_HANDSHAKE) {
        runtime.handshakes_in_flight = runtime.handshakes_in_flight + 1;
    }
    # the connection's account spans every hedge lane. quic owns its three
    # (send, receive, crypto) and hedge composes its own (io, request) onto the
    # lanes after them through the assembly config below; the borrower declares
    # the whole set and holds the owner the account is woken under
    memory.borrower(?value.storage.borrower, runtime.memory, timer_owner(index),
        memory.LANES, config_snapshot.memory_budgets);
    if (value.handshake == NO_HANDSHAKE
        || !copy_listener_name(value, config_snapshot.listener_name)
        || !adopt_local_cid(value, accepted)
        || !operation_ok(cancel.make_child(?value.storage.scope, ?pump.storage.scope,
        opt[time.Instant].none{}))) {
        value.state = CONNECTION_CLEANUP;
        cleanup_accepting(controls, runtime, index);
        ret false;
    }
    value.scope_live = true;
    var config: assembly.Config = assembly.default_config(value.source,
        value.local, value.peer);
    config.local_source        = ?value.storage.local_cid[0];
    config.local_source_length = CONNECTION_ID_BYTES;
    config.alpn                = "h3"::*u8;
    config.alpn_length         = 2;
    config.server_name         = nil;
    config.server_name_length  = 0;
    config.max_idle_timeout    = config_snapshot.idle_timeout_ms::i64 * duration.MILLISECOND;
    config.drain_timeout       = config_snapshot.drain_timeout_ns::i64 * duration.NANOSECOND;
    # the deadline counts from arrival: time spent waiting for a slot was the
    # client's, and a wait that could not fit was refused before this
    value.handshake_started_ns  = now_ns;
    value.handshake_deadline_ns = saturated_add(arrival_ns,
        config_snapshot.handshake_timeout_ns);
    config.tls_deadline = opt[time.Instant].some{clock.from_ns(value.handshake_deadline_ns)};
    config.tls_budget   = config_snapshot.memory_budgets.lanes[memory.LANE_TLS::usize];
    # hedge composes its own lanes onto quic's supply: the lanes after quic's
    # three carry hedge's io and request budgets, and the account is opened and
    # woken under the connection's timer owner
    config.account_handle              = timer_owner(index);
    config.extra_budgets               = ?config_snapshot.memory_budgets.lanes[quic_supply.LANES::usize];
    config.extra_lanes                 = memory.LANES::usize - quic_supply.LANES::usize;
    config.entropy_context_size        = value.policy.configuration.entropy_context_size;
    config.entropy_secret_context_size = 0;
    config.enable_early_data           = false;
    if (!assembly.apply_server_acceptance(?config, accepted)) {
        value.state = CONNECTION_CLEANUP;
        cleanup_accepting(controls, runtime, index);
        ret false;
    }
    val encoded: transport_parameters.EncodeResult =
        assembly.encode_parameters(?config, qt.SERVER,
        ?value.storage.local_parameters[0], assembly.PARAMETER_CAPACITY);
    val engine: *server.Handshake = handshake_at(controls, value.handshake);
    if (!encoded.ok || !initialize_tls(value, engine, encoded.count)) {
        value.state = CONNECTION_CLEANUP;
        cleanup_accepting(controls, runtime, index);
        ret false;
    }
    value.tls_live           = true;
    value.assembly_attempted = true;
    val initialized: assembly.InitResult = assembly.init_server(
        ?value.assembly, ?config, ?value.storage.assembly_storage,
        ?pump.storage.scratch, ?pump.secret_scratch,
        memory.borrowed_source(?value.storage.borrower), engine,
        ?value.storage.scope, clock.from_ns(now_ns));
    if (!initialized.ok) {
        # an attempt that leased nothing (the pool refused the account, or a
        # range was invalid) left the record as it found it, so there is no
        # assembly to release and the cleanup finishes in one pass
        if (!initialized.cleanup_retained) { value.assembly_attempted = false; }
        value.state = CONNECTION_CLEANUP;
        cleanup_accepting(controls, runtime, index);
        ret false;
    }
    value.tls_live = false;
    value.state    = CONNECTION_LIVE;
    if (!reconcile_routes(controls, runtime, index)
        || !refresh_timer(controls, runtime, index)) {
        fail_connection(controls, runtime, index, now_ns);
        ret false;
    }
    ret true;
}

fun stateless_at(pump: *Pump, index: usize) *StatelessSend {
    ret hedge_storage.table_at[StatelessSend](?pump.stateless, index);
}

# NO_CONNECTION when the pump already holds its ceiling of pending sends or the
# allocator refuses to grow
fun claim_stateless(pump: *Pump) usize {
    if (pump.stateless_live >= MAX_STATELESS_PENDING) { ret NO_CONNECTION; }
    val index: usize = hedge_storage.table_claim[StatelessSend](?pump.stateless);
    if (index == hedge_storage.NO_INDEX) { ret NO_CONNECTION; }
    val operation: *StatelessSend = stateless_at(pump, index);
    operation.prev_pending = NO_CONNECTION;
    operation.next_pending = pump.stateless_pending;
    if (pump.stateless_pending != NO_CONNECTION) {
        stateless_at(pump, pump.stateless_pending).prev_pending = index;
    }
    pump.stateless_pending = index;
    pump.stateless_live    = pump.stateless_live + 1;
    ret index;
}

fun release_stateless(pump: *Pump, index: usize) {
    val operation: *StatelessSend = stateless_at(pump, index);
    if (operation.prev_pending != NO_CONNECTION) {
        stateless_at(pump, operation.prev_pending).next_pending = operation.next_pending;
    }
    or {
        pump.stateless_pending = operation.next_pending;
    }
    if (operation.next_pending != NO_CONNECTION) {
        stateless_at(pump, operation.next_pending).prev_pending = operation.prev_pending;
    }
    operation.pending      = false;
    operation.next_pending = NO_CONNECTION;
    operation.prev_pending = NO_CONNECTION;
    pump.stateless_live    = pump.stateless_live - 1;
    hedge_storage.table_release[StatelessSend](?pump.stateless, index);
}

fun submit_stateless(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    received: *net_types.Packet, data: *u8, length: usize) Status {
    val pump: *Pump = ?controls.pumps[pump_index];
    if (data == nil || length == 0 || length > assembly.MAX_UDP_PAYLOAD) { ret FAILED; }
    val index: usize = claim_stateless(pump);
    if (index == NO_CONNECTION) {
        runtime.stateless_dropped = runtime.stateless_dropped + 1;
        ret BLOCKED;
    }
    val operation: *StatelessSend = stateless_at(pump, index);
    pump.stateless_generation = next_generation(pump.stateless_generation);
    operation.generation      = pump.stateless_generation;
    std_memory.raw_copy(?operation.buffer[0], data, length);
    operation.packet.buffer                = ?operation.buffer[0];
    operation.packet.capacity              = length;
    operation.packet.length                = length;
    operation.packet.peer                  = received.peer;
    operation.packet.local_destination     = received.local_destination;
    operation.packet.interface_index       = received.interface_index;
    operation.packet.has_local_destination = received.has_local_destination;
    operation.packet.truncated             = false;
    operation.packet.zero_length           = false;
    if (!make_context(?operation.context, runtime, COMPLETION_STATELESS,
        pump_index, pump.generation, NO_CONNECTION, 0, index,
        operation.generation, no_token())) {
        release_stateless(pump, index);
        ret FAILED;
    }
    val submitted: res[io_runtime.Token, io_error.Error] =
        net_async.submit_send_batch(pump.driver, ?pump.storage.scope, pump.socket,
        ?operation.packet, 1, (?operation.context.route)::usize);
    if (sel submitted.err) {
        release_stateless(pump, index);
        ret FAILED;
    }
    operation.pending = true;
    ret OK;
}

fun retry_identity(request: *quic_listener.Request) bool {
    var source: [CONNECTION_ID_BYTES]u8;
    var nonce:  u64 = 0;
    if (!filled(random.fill(?source[0], CONNECTION_ID_BYTES))
        || !filled(random.fill((?nonce)::*u8, 8)) || nonce == 0
        || !quic_listener.set_retry_source(request, ?source[0],
        CONNECTION_ID_BYTES)) { ret false; }
    request.retry_nonce = nonce;
    ret true;
}

fun cancel_acceptance(bank: *AdmissionGeneration,
    value: quic_listener.Acceptance) bool {
    val result: quic_listener.Result =
        quic_listener.cancel(?bank.listener, value);
    if (result.action != quic_listener.ACTION_ACCEPT)            { ret false; }
    if (result.cleanup.status != quic_listener.CLEANUP_RETAINED) { ret true; }
    ret quic_listener.retry_cleanup(?bank.listener,
        result.cleanup.acceptance).status == quic_listener.CLEANUP_COMPLETE;
}

# NO_CONNECTION when the allocator refuses to grow the pending initials
fun free_pending_initial(runtime: *Runtime) usize {
    if (runtime == nil) { ret NO_CONNECTION; }
    val index: usize = hedge_storage.table_claim[PendingInitial](?runtime.pending_initials);
    if (index == NO_CONNECTION) { ret NO_CONNECTION; }
    reset_pending_initial(runtime, index);
    ret index;
}

fun snapshot_pending_config(source: *PumpConfig,
    output: *PendingConfig) bool {
    if (source == nil || output == nil
        || hedge_tls.policy_at(source.tls_policy_index)
        != source.tls_policy) { ret false; }
    val name_length: usize = str_len(source.listener_name);
    if (name_length == 0 || name_length >= schema.TEXT_CAP) { ret false; }
    output.admission_generation = source.admission_generation;
    output.tls_policy_index     = source.tls_policy_index;
    output.plan                 = source.plan;
    output.budgets              = source.budgets;
    output.listener_budget      = source.listener_budget;
    output.limits               = source.limits;
    output.max_requests         = source.max_requests;
    output.call_memory_bytes    = source.call_memory_bytes;
    output.handshake_timeout_ns = source.handshake_timeout_ns;
    output.request_timeout_ns   = source.request_timeout_ns;
    output.idle_timeout_ms      = source.idle_timeout_ms;
    output.drain_timeout_ns     = source.drain_timeout_ns;
    output.memory_budgets       = source.memory_budgets;
    output.memory_wait_ns       = source.memory_wait_ns;
    std_memory.raw_copy(?output.listener_name[0], source.listener_name::*u8,
        name_length);
    output.listener_name[name_length] = 0;
    ret true;
}

fun materialize_pending_config(source: *PendingConfig,
    output: *ConnectionConfig) bool {
    if (source == nil || output == nil) { ret false; }
    val policy: *hedge_tls.Policy = hedge_tls.policy_at(
        source.tls_policy_index);
    if (policy == nil) { ret false; }
    output.tls_policy           = policy;
    output.plan                 = source.plan;
    output.budgets              = source.budgets;
    output.limits               = source.limits;
    output.max_requests         = source.max_requests;
    output.call_memory_bytes    = source.call_memory_bytes;
    output.listener_name        = ?source.listener_name[0];
    output.handshake_timeout_ns = source.handshake_timeout_ns;
    output.request_timeout_ns   = source.request_timeout_ns;
    output.idle_timeout_ms      = source.idle_timeout_ms;
    output.drain_timeout_ns     = source.drain_timeout_ns;
    output.memory_budgets       = source.memory_budgets;
    output.memory_wait_ns       = source.memory_wait_ns;
    ret true;
}

fun active_connection_config(source: *PumpConfig,
    output: *ConnectionConfig) bool {
    if (source == nil || output == nil) { ret false; }
    output.tls_policy           = source.tls_policy;
    output.plan                 = source.plan;
    output.budgets              = source.budgets;
    output.limits               = source.limits;
    output.max_requests         = source.max_requests;
    output.call_memory_bytes    = source.call_memory_bytes;
    output.listener_name        = source.listener_name;
    output.handshake_timeout_ns = source.handshake_timeout_ns;
    output.request_timeout_ns   = source.request_timeout_ns;
    output.idle_timeout_ms      = source.idle_timeout_ms;
    output.drain_timeout_ns     = source.drain_timeout_ns;
    output.memory_budgets       = source.memory_budgets;
    output.memory_wait_ns       = source.memory_wait_ns;
    ret true;
}

fun copy_pending_packet(pending: *PendingInitial,
    received: *net_types.Packet) bool {
    if (pending == nil || received == nil || received.buffer == nil
        || received.length == 0
        || received.length > assembly.MAX_UDP_PAYLOAD) { ret false; }
    std_memory.raw_copy(?pending.data[0], received.buffer, received.length);
    pending.peer                  = received.peer;
    pending.local_destination     = received.local_destination;
    pending.length                = received.length;
    pending.interface_index       = received.interface_index;
    pending.has_local_destination = received.has_local_destination;
    ret true;
}

# every token Initial queues here. one whose budget admitted it is deferred:
# it waits its turn for a handshake slot in arrival order and is promoted by
# advance_pending_initials, so the receive path never spends a handshake's
# crypto and the socket is read at read speed. one whose budget queued it waits
# on the budget first and is deferred when that admits it.
fun enqueue_initial(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    bank_index: usize, acceptance: quic_listener.Acceptance,
    key: routing.Key, received: *net_types.Packet, config_snapshot: PumpConfig,
    named_charge: *budget.Charge, lease: process_admission.Lease,
    deferred: bool, handshake_lease: process_admission.Lease,
    arrival_ns: u64) bool {
    val index: usize = free_pending_initial(runtime);
    if (index == NO_CONNECTION) { ret false; }
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!snapshot_pending_config(?config_snapshot, ?pending.config)
        || !copy_pending_packet(pending, received)) {
        hedge_storage.table_release[PendingInitial](?runtime.pending_initials, index);
        ret false;
    }
    pending.arrival_ns = arrival_ns;
    if (!claim_pending_timer(runtime, index, deferred, named_charge)) {
        hedge_storage.table_release[PendingInitial](?runtime.pending_initials, index);
        ret false;
    }
    pending.acceptance      = acceptance;
    pending.acceptance_live = true;
    take_pending_charge(runtime, index, config_snapshot.budgets, named_charge);
    pending.lease              = lease;
    pending.pump               = pump_index;
    pending.pump_generation    = controls.pumps[pump_index].generation;
    pending.admission_bank     = bank_index;
    pending.q_charge_live      = false;
    pending.budget_charge_live = pending.budget_charge.live;
    pending.lease_live         = true;
    pending.cleanup_only       = false;
    pending.superseded         = false;
    pending.live               = true;
    if (deferred) {
        pending.handshake_lease      = handshake_lease;
        pending.handshake_lease_live = true;
        link_deferred(runtime, index);
        if (!handshake_room(runtime) || runtime.deferred_count > 1) {
            hold_deferred(runtime, pending);
        }
    }
    # a route that cannot be published loses the client's later datagrams to
    # the unknown path, which drops them as replays; the client retransmits
    publish_pending_route(runtime, index, key);
    link_pending_live(runtime, index);
    runtime.pending_initial_count              = runtime.pending_initial_count + 1;
    runtime.live_total                         = runtime.live_total + 1;
    controls.pumps[pump_index].queued_initials =
        controls.pumps[pump_index].queued_initials + 1;
    controls.pumps[pump_index].admissions[bank_index].queued_initials =
        controls.pumps[pump_index].admissions[bank_index].queued_initials + 1;
    ret true;
}

fun own_pending_cleanup(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    bank_index: usize, accepted: quic_listener.Accepted,
    q_charge_live: bool, config_snapshot: PumpConfig,
    named_charge: *budget.Charge, lease: process_admission.Lease,
    lease_live: bool) bool {
    val index: usize = free_pending_initial(runtime);
    if (index == NO_CONNECTION) { ret false; }
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!snapshot_pending_config(?config_snapshot, ?pending.config)) {
        hedge_storage.table_release[PendingInitial](?runtime.pending_initials, index);
        ret false;
    }
    pending.accepted = accepted;
    budget.relocate(config_snapshot.budgets, ?pending.budget_charge, named_charge);
    pending.lease              = lease;
    pending.length             = 0;
    pending.pump               = pump_index;
    pending.pump_generation    = controls.pumps[pump_index].generation;
    pending.admission_bank     = bank_index;
    pending.q_charge_live      = q_charge_live;
    pending.budget_charge_live = pending.budget_charge.live;
    pending.lease_live         = lease_live;
    pending.cleanup_only       = true;
    pending.superseded         = false;
    pending.live               = true;
    link_pending_live(runtime, index);
    mark_pending_ready(runtime, index);
    runtime.pending_initial_count              = runtime.pending_initial_count + 1;
    runtime.live_total                         = runtime.live_total + 1;
    controls.pumps[pump_index].queued_initials =
        controls.pumps[pump_index].queued_initials + 1;
    controls.pumps[pump_index].admissions[bank_index].queued_initials =
        controls.pumps[pump_index].admissions[bank_index].queued_initials + 1;
    ret true;
}

fun take_pending_initial(controls: *ControlView, runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!pending.live) { ret; }
    if (runtime.pending_initial_count != 0) {
        runtime.pending_initial_count = runtime.pending_initial_count - 1;
    }
    if (runtime.live_total != 0) { runtime.live_total = runtime.live_total - 1; }
    release_superseded(runtime, ?pending.superseded);
    if (pending.pump < MAX_PUMPS) {
        val pump: *Pump = ?controls.pumps[pending.pump];
        if (pump.queued_initials != 0) {
            pump.queued_initials = pump.queued_initials - 1;
        }
        if (pending.admission_bank < ADMISSION_BANKS
            && pump.admissions[pending.admission_bank].queued_initials != 0) {
            pump.admissions[pending.admission_bank].queued_initials =
                pump.admissions[pending.admission_bank].queued_initials - 1;
        }
    }
    pending.config.tls_policy_index    = hedge_tls.NO_POLICY;
    pending.config.plan                = nil;
    pending.config.budgets             = nil;
    pending.config.listener_name[0]    = 0;
    pending.accepted.charge.source     = 0;
    pending.accepted.charge.index      = 0;
    pending.accepted.charge.generation = 0;
    pending.acceptance_live            = false;
    pending.budget_charge              = budget.no_charge();
    pending.lease                      = process_admission.no_lease();
    pending.q_charge_live              = false;
    pending.budget_charge_live         = false;
    pending.lease_live                 = false;
    pending.cleanup_only               = false;
    pending.length                     = 0;
    pending.handshake_lease            = process_admission.no_lease();
    pending.handshake_lease_live       = false;
    pending.counted_deferred           = false;
    unpublish_pending_route(runtime, index);
    release_held(runtime, ?pending.held);
    unlink_deferred(runtime, index);
    unmark_pending_ready(runtime, index);
    if (pending.timer_live) {
        wheel.release(runtime.timers, pending.timer);
        pending.timer      = wheel.no_handle();
        pending.timer_live = false;
    }
    pending.live = false;
    unlink_pending_live(runtime, index);
    hedge_storage.table_release[PendingInitial](?runtime.pending_initials, index);
}

fun release_pending_initial(controls: *ControlView, runtime: *Runtime, index: usize) bool {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!pending.live || pending.pump >= MAX_PUMPS
        || pending.admission_bank >= ADMISSION_BANKS) { ret false; }
    val bank: *AdmissionGeneration =
        ?controls.pumps[pending.pump].admissions[pending.admission_bank];
    if (pending.budget_charge_live) {
        if (!pending.budget_charge.live) {
            pending.budget_charge_live = false;
        }
        or (budget.release(pending.config.budgets,
            ?pending.budget_charge)) {
            pending.budget_charge_live = false;
        }
    }
    if (pending.q_charge_live
        && quic_listener.release_connection(?bank.listener,
        pending.accepted.charge).action == quic_listener.ACTION_ACCEPT) {
        pending.q_charge_live = false;
    }
    if (pending.acceptance_live && cancel_acceptance(bank, pending.acceptance)) {
        pending.acceptance_live = false;
    }
    if (pending.lease_live && runtime.admission != nil
        && process_admission.release(runtime.admission,
        pending.lease)) { pending.lease_live = false; }
    if (pending.handshake_lease_live
        && process_admission.release(?runtime.handshakes,
        pending.handshake_lease)) { pending.handshake_lease_live = false; }
    val success: bool = !pending.budget_charge_live
        && !pending.q_charge_live && !pending.acceptance_live
        && !pending.lease_live && !pending.handshake_lease_live;
    if (!success) { ret false; }
    take_pending_initial(controls, runtime, index);
    if (bank.retiring && bank.active_connections == 0
        && bank.queued_initials == 0) { reap_admission(bank); }
    ret true;
}

fun pending_binding(runtime: *Runtime, index: usize) routing.Binding {
    val pending: *PendingInitial = pending_at(runtime, index);
    ret routing.Binding{connection_slot: index,
        connection_generation: pending.generation, route_index: 0,
        route_generation:      1, route_sequence: 0,
        pump_generation:       pending.pump_generation, pending: true};
}

# the connection ID the client was given in its Retry routes to the pending
# initial until it is promoted, so the datagrams the client sends behind its
# first Initial wait with it instead of arriving as strangers
fun publish_pending_route(runtime: *Runtime, index: usize, key: routing.Key) bool {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!key.valid) { ret false; }
    runtime.pending_generation = next_generation(runtime.pending_generation);
    pending.generation         = runtime.pending_generation;
    pending.route_key          = key;
    if (routing.publish(?runtime.routes, pending.route_key,
        pending_binding(runtime, index)) != routing.ROUTE_OK) { ret false; }
    pending.route_live = true;
    ret true;
}

fun unpublish_pending_route(runtime: *Runtime, index: usize) {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!pending.route_live) { ret; }
    routing.unpublish(?runtime.routes, pending.route_key,
        pending_binding(runtime, index));
    pending.route_live = false;
}

# a datagram routed to a pending initial is held with it
fun deliver_pending(runtime: *Runtime, found: routing.Lookup,
    received: *net_types.Packet) Status {
    val index: usize = found.binding.connection_slot;
    if (index >= hedge_storage.table_capacity[PendingInitial](?runtime.pending_initials)) { ret STALE; }
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!pending.live || !pending.route_live
        || pending.generation != found.binding.connection_generation) { ret STALE; }
    hold_datagram(runtime, ?pending.held, HELD_PER_PENDING, received);
    ret OK;
}

fun pending_packet(pending: *PendingInitial) net_types.Packet {
    var value: net_types.Packet;
    value.buffer                = ?pending.data[0];
    value.capacity              = pending.length;
    value.length                = pending.length;
    value.peer                  = pending.peer;
    value.local_destination     = pending.local_destination;
    value.interface_index       = pending.interface_index;
    value.has_local_destination = pending.has_local_destination;
    value.truncated             = false;
    value.zero_length           = false;
    ret value;
}

fun transfer_pending_ownership(pending: *PendingInitial,
    accepted: *quic_listener.Accepted, value: *Connection) bool {
    if (pending == nil || value == nil || !pending.live
        || !value.live || !pending.lease_live) { ret false; }
    value.charge      = accepted.charge;
    value.charge_live = true;
    budget.relocate(pending.config.budgets, ?value.budget_charge, ?pending.budget_charge);
    value.budget_charge_live     = pending.budget_charge_live;
    value.handshake_lease        = pending.handshake_lease;
    value.handshake_lease_live   = pending.handshake_lease_live;
    pending.lease_live           = false;
    pending.q_charge_live        = false;
    pending.budget_charge_live   = false;
    pending.handshake_lease_live = false;
    ret true;
}

fun deliver_initial(controls: *ControlView, runtime: *Runtime, index: usize,
    received: *net_types.Packet, now_ns: u64) bool {
    val value:     *Connection        = connection_at(controls, index);
    val delivered: qt.OperationResult = qt.receive_native[binding.Binding](
        ?value.assembly.driver, received, value.local, clock.from_ns(now_ns), 0);
    # a cancel that does not start the close never arms the drain deadline, so
    # the connection would hold its slot and its lease and block shutdown
    if (delivered.status == qt.STATUS_ERROR
        || !reconcile_routes(controls, runtime, index)
        || !refresh_timer(controls, runtime, index)) {
        fail_connection(controls, runtime, index, now_ns);
        ret false;
    }
    ret true;
}

fun replay_refused(result: *quic_listener.Result) bool {
    ret result.action == quic_listener.ACTION_BLOCKED
        && result.error == quic_listener.ERROR_TOKEN
        && result.detail == token.ERROR_REPLAY_FULL::u64;
}

fun reset_arrivals(pump: *Pump) {
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        pump.arrival_heads[class] = NO_CONNECTION;
        pump.arrival_tails[class] = NO_CONNECTION;
        pump.arrival_held[class]  = 0;
        class                     = class + 1;
    }
    pump.arrival_live = 0;
}

fun make_arrivals(pump: *Pump, backing: *A.Allocator) bool {
    if (!hedge_storage.make_table[Arrival](?pump.arrivals, backing)) { ret false; }
    pump.arrival_index = map.init_by[routing.Key, usize](backing,
        routing.key_hash, routing.key_equal);
    reset_arrivals(pump);
    ret true;
}

fun destroy_arrivals(pump: *Pump) bool {
    var success: bool = true;
    if (!hedge_storage.destroy_table[Arrival](?pump.arrivals)) { success = false; }
    val dropped: err[A.Error] = map.dnit_by[routing.Key, usize](?pump.arrival_index);
    if (sel dropped.err) { success = false; }
    reset_arrivals(pump);
    ret success;
}

fun arrivals_dropped_total(runtime: *Runtime) u64 {
    var total: u64   = 0;
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        total = saturated_add(total, runtime.arrivals_dropped[class]);
        class = class + 1;
    }
    ret total;
}

fun clear_arrival_drops(runtime: *Runtime) {
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        runtime.arrivals_dropped[class] = 0;
        class                           = class + 1;
    }
}

fun arrival_dropped(runtime: *Runtime, class: usize) {
    runtime.arrivals_dropped[class] = runtime.arrivals_dropped[class] + 1;
}

fun arrivals_held(pump: *Pump) bool {
    ret pump.arrival_live != 0;
}

# the class of an unknown Initial or negotiation datagram at the queue: a
# destination CID already held makes it a duplicate whatever it carries
fun arrival_class(pump: *Pump, classified: *quic_listener.ClassifiedDatagram,
    key: routing.Key) usize {
    val held: opt[*usize] = map.get_by[routing.Key, usize](?pump.arrival_index, ?key);
    if (sel held.some)                                      { ret ARRIVAL_DUPLICATE; }
    if (classified.class != quic_listener.DATAGRAM_INITIAL) { ret ARRIVAL_OTHER; }
    if (classified.token_length != 0)                       { ret ARRIVAL_TOKEN; }
    ret ARRIVAL_UNTOKEN;
}

fun index_arrival(pump: *Pump, key: routing.Key) bool {
    val held: opt[*usize] = map.get_by[routing.Key, usize](?pump.arrival_index, ?key);
    if (sel held.some) {
        @held.some = @held.some + 1;
        ret true;
    }
    val inserted: res[bool, A.Error] =
        map.insert_by[routing.Key, usize](?pump.arrival_index, key, 1);
    ret !(sel inserted.err);
}

fun unindex_arrival(pump: *Pump, key: routing.Key) {
    val held: opt[*usize] = map.get_by[routing.Key, usize](?pump.arrival_index, ?key);
    if (!(sel held.some)) { ret; }
    if (@held.some > 1) {
        @held.some = @held.some - 1;
        ret;
    }
    map.remove_by[routing.Key, usize](?pump.arrival_index, ?key);
}

# unlinks the oldest arrival of a class and releases its record
fun evict_arrival(pump: *Pump, class: usize) bool {
    val index: usize = pump.arrival_heads[class];
    if (index == NO_CONNECTION) { ret false; }
    val arrival: *Arrival = arrival_at(pump, index);
    pump.arrival_heads[class] = arrival.next;
    if (pump.arrival_heads[class] == NO_CONNECTION) {
        pump.arrival_tails[class] = NO_CONNECTION;
    }
    pump.arrival_held[class] = pump.arrival_held[class] - 1;
    pump.arrival_live        = pump.arrival_live - 1;
    unindex_arrival(pump, arrival.key);
    hedge_storage.table_release[Arrival](?pump.arrivals, index);
    ret true;
}

# frees a slot for an arrival of the given class by evicting the oldest held
# arrival of the lowest class below it. false when nothing below it is held
fun preempt_arrival(runtime: *Runtime, pump: *Pump, class: usize) bool {
    var victim: usize = ARRIVAL_CLASSES;
    for (victim > class + 1) {
        victim = victim - 1;
        if (evict_arrival(pump, victim)) {
            arrival_dropped(runtime, victim);
            ret true;
        }
    }
    ret false;
}

fun arrival_at(pump: *Pump, index: usize) *Arrival {
    ret hedge_storage.table_at[Arrival](?pump.arrivals, index);
}

# holds an unknown datagram for the preflight turn, or drops it at the queue's
# bound: the client's PTO retransmits it, exactly as a kernel drop would have
# cost, except that this one is counted by class. at the bound a token
# Initial takes the slot of a held duplicate, negotiation or first flight, an
# untoken one takes a duplicate's or a negotiation's, and a duplicate is
# dropped
fun hold_arrival(runtime: *Runtime, pump: *Pump, received: *net_types.Packet,
    key: routing.Key, class: usize, now_ns: u64) Status {
    if (received.length == 0 || received.length > assembly.MAX_UDP_PAYLOAD
        || class >= ARRIVAL_CLASSES) { ret INVALID; }
    if (pump.arrival_live >= pump.arrival_capacity
        && !preempt_arrival(runtime, pump, class)) {
        arrival_dropped(runtime, class);
        ret BLOCKED;
    }
    val index: usize = hedge_storage.table_claim[Arrival](?pump.arrivals);
    if (index == hedge_storage.NO_INDEX) {
        arrival_dropped(runtime, class);
        ret BLOCKED;
    }
    if (!index_arrival(pump, key)) {
        hedge_storage.table_release[Arrival](?pump.arrivals, index);
        arrival_dropped(runtime, class);
        ret BLOCKED;
    }
    val arrival: *Arrival = arrival_at(pump, index);
    std_memory.raw_copy(?arrival.data[0], received.buffer, received.length);
    arrival.peer                  = received.peer;
    arrival.local_destination     = received.local_destination;
    arrival.key                   = key;
    arrival.length                = received.length;
    arrival.interface_index       = received.interface_index;
    arrival.has_local_destination = received.has_local_destination;
    arrival.arrival_ns            = now_ns;
    arrival.class                 = class;
    arrival.next                  = NO_CONNECTION;
    if (pump.arrival_tails[class] != NO_CONNECTION) {
        arrival_at(pump, pump.arrival_tails[class]).next = index;
    }
    or { pump.arrival_heads[class] = index; }
    pump.arrival_tails[class] = index;
    pump.arrival_held[class]  = pump.arrival_held[class] + 1;
    pump.arrival_live         = pump.arrival_live + 1;
    ret OK;
}

# the class whose oldest arrival preflights next: the highest class held
fun next_arrival_class(pump: *Pump) usize {
    var class: usize = 0;
    for (class < ARRIVAL_CLASSES) {
        if (pump.arrival_heads[class] != NO_CONNECTION) { ret class; }
        class = class + 1;
    }
    ret ARRIVAL_CLASSES;
}

fun arrival_packet(arrival: *Arrival) net_types.Packet {
    var value: net_types.Packet;
    value.buffer                = ?arrival.data[0];
    value.capacity              = arrival.length;
    value.length                = arrival.length;
    value.peer                  = arrival.peer;
    value.local_destination     = arrival.local_destination;
    value.interface_index       = arrival.interface_index;
    value.has_local_destination = arrival.has_local_destination;
    value.truncated             = false;
    value.zero_length           = false;
    ret value;
}

# preflights the oldest held arrival of the highest class held. its packet is
# copied out first so the record is released before admission, which may
# itself claim storage
fun preflight_arrival(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    now: time.Instant, now_ns: u64) Status {
    val pump:  *Pump = ?controls.pumps[pump_index];
    val class: usize = next_arrival_class(pump);
    if (class == ARRIVAL_CLASSES) { ret BLOCKED; }
    var copy: Arrival = @arrival_at(pump, pump.arrival_heads[class]);
    if (!evict_arrival(pump, class)) { ret FAILED; }
    var received:   net_types.Packet                 = arrival_packet(?copy);
    val classified: quic_listener.ClassifiedDatagram =
        quic_listener.classify_datagram(received.buffer, received.length,
        CONNECTION_ID_BYTES);
    if (classified.class == quic_listener.DATAGRAM_MALFORMED) { ret OK; }
    val key: routing.Key = routing.key(?classified.destination.data[0],
        classified.destination.length);
    # a route published since it was held claims it: a retransmission of an
    # Initial whose first copy was admitted from this same queue
    val found: routing.Lookup = routing.lookup(?runtime.routes, key);
    if (found.status == routing.ROUTE_OK && found.binding.pending) {
        ret deliver_pending(runtime, found, ?received);
    }
    if (found.status == routing.ROUTE_OK) {
        ret deliver_known(controls, runtime, ?received, found, now, now_ns);
    }
    ret handle_unknown(controls, runtime, pump_index, ?received, key, now,
        now_ns, copy.arrival_ns);
}

# the sockets are read between units of crypto: the owner's poll settles any
# receive that completed meanwhile onto the completion list, and settling it
# submits the next read, so the socket is never left unread for longer than
# one unit costs. true when something settled
fun read_on(controls: *ControlView, runtime: *Runtime, now: time.Instant,
    now_ns: u64) bool {
    if (runtime.read_on::usize == 0 || !runtime.read_on(runtime.read_on_ctx)
        || runtime.completions_head == nil) { ret false; }
    if (drain_completions(controls, runtime, now, now_ns) == FAILED) {
        connection_failed(runtime);
    }
    ret true;
}

# a turn of preflight work across the pumps, oldest arrival first pump by
# pump, the sockets read after every one: a Retry is crypto, and a burst of
# Initials must not stall the reads that carry it. the turn ends at the
# preflight bound or once its arrival work has cost what the last unit of
# handshake work did
fun advance_arrivals(controls: *ControlView, runtime: *Runtime, now: time.Instant,
    now_ns: u64) Status {
    var status: Status = OK;
    var budget: usize  = PREFLIGHT_BUDGET;
    var spent:  u64    = 0;
    var i:      usize  = 0;
    for (i < MAX_PUMPS && budget != 0 && spent < runtime.unit_ns) {
        val pump: *Pump = ?controls.pumps[i];
        for (pump.live && budget != 0 && spent < runtime.unit_ns
            && arrivals_held(pump)) {
            val started_ns: u64 = monotonic_ns();
            if (preflight_arrival(controls, runtime, i, now, now_ns) == FAILED) {
                status = FAILED;
            }
            spent  = saturated_add(spent, elapsed_since(started_ns));
            budget = budget - 1;
            read_on(controls, runtime, now, now_ns);
        }
        i = i + 1;
    }
    ret status;
}

fun handle_unknown(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    received: *net_types.Packet, key: routing.Key, now: time.Instant,
    now_ns: u64, arrival_ns: u64) Status {
    val pump: *Pump = ?controls.pumps[pump_index];
    if (pump.draining || pump.cancelling) { ret STOPPED; }
    val bank_index: usize                = pump.active_admission;
    val bank:       *AdmissionGeneration = ?pump.admissions[bank_index];
    var request:    quic_listener.Request;
    request.peer                     = received.peer;
    request.data                     = received.buffer;
    request.length                   = received.length;
    request.now                      = clock.from_ns(now_ns);
    request.version_negotiation_bits = 0x5a;
    request.output                   = ?pump.storage.preflight_output[0];
    request.output_capacity          = assembly.MAX_UDP_PAYLOAD;
    if (!retry_identity(?request)) { ret FAILED; }
    val result: quic_listener.Result =
        quic_listener.preflight(?bank.listener, ?request);
    if (result.action == quic_listener.ACTION_RETRY
        || result.action == quic_listener.ACTION_VERSION_NEGOTIATION) {
        ret submit_stateless(controls, runtime, pump_index, received,
            ?pump.storage.preflight_output[0], result.output_count);
    }
    if (result.action == quic_listener.ACTION_DROP) { ret OK; }
    if (result.action == quic_listener.ACTION_BLOCKED) {
        # the replay store is at its bound: the datagram is dropped and the
        # client's retransmission is admitted once expiry frees room
        if (replay_refused(?result)) {
            runtime.replay_full = runtime.replay_full + 1;
        }
        ret BLOCKED;
    }
    if (result.action != quic_listener.ACTION_ACCEPT) { ret FAILED; }
    if (!capacity_available(controls, runtime, pump)) {
        if (!cancel_acceptance(bank, result.acceptance)) { ret FAILED; }
        ret BLOCKED;
    }
    var lease: process_admission.Lease = process_admission.no_lease();
    if (!process_admission.acquire(runtime.admission,
        ?received.peer, ?lease)) {
        val cancelled: bool = cancel_acceptance(bank, result.acceptance);
        if (!cancelled) { ret FAILED; }
        ret BLOCKED;
    }
    var named_charge: budget.Charge;
    val outcome:      budget.Outcome = budget.charge(pump.budgets,
        pump.config.listener_budget, $size_of(Connection), now,
        ?named_charge, hedge_wake.no_waker());
    if (outcome != budget.ADMITTED && outcome != budget.QUEUED) {
        ret abandon_admission(controls, runtime, pump_index, bank_index,
            result.acceptance, ?named_charge, lease);
    }
    var handshake_lease: process_admission.Lease = process_admission.no_lease();
    if (outcome == budget.ADMITTED) {
        # the ceiling: an Initial the queue ahead of it would carry past its
        # own deadline is turned away now rather than promoted with no time
        # left, and so is one past its peer's share of the bound
        if (!deadline_allows(runtime, arrival_ns, pump.config.handshake_timeout_ns,
            now_ns, runtime.deferred_count)
            || !process_admission.acquire(?runtime.handshakes, ?received.peer,
            ?handshake_lease)) {
            refuse_initial(controls, runtime, pump_index, bank_index, received, now_ns);
            ret abandon_admission(controls, runtime, pump_index, bank_index,
                result.acceptance, ?named_charge, lease);
        }
    }
    if (!enqueue_initial(controls, runtime, pump_index, bank_index,
        result.acceptance, key, received, pump.config, ?named_charge, lease,
        outcome == budget.ADMITTED, handshake_lease, arrival_ns)) {
        release_handshake_lease(runtime, ?handshake_lease);
        if (abandon_admission(controls, runtime, pump_index, bank_index,
            result.acceptance, ?named_charge, lease) != OK) { ret FAILED; }
        ret BLOCKED;
    }
    ret OK;
}

fun release_handshake_lease(runtime: *Runtime, lease: *process_admission.Lease) {
    if (lease.generation == 0) { ret; }
    if (!process_admission.release(?runtime.handshakes, @lease)) {
        connection_failed(runtime);
    }
    @lease = process_admission.no_lease();
}

# an acceptance that goes no further: its budget charge, process lease and
# listener acceptance all go back, through a cleanup-only pending record when
# a release refuses now
fun abandon_admission(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    bank_index: usize, acceptance: quic_listener.Acceptance,
    named_charge: *budget.Charge, lease: process_admission.Lease) Status {
    val pump:            *Pump                = ?controls.pumps[pump_index];
    val bank:            *AdmissionGeneration = ?pump.admissions[bank_index];
    var charge_released: bool                 = true;
    if (named_charge.live) {
        charge_released = budget.release(pump.budgets, named_charge);
    }
    val lease_released: bool = process_admission.release(runtime.admission, lease);
    val cancelled:      bool = cancel_acceptance(bank, acceptance);
    if (!lease_released || !charge_released) {
        var none: quic_listener.Accepted;
        if (!own_pending_cleanup(controls, runtime, pump_index, bank_index,
            none, false, pump.config, named_charge, lease,
            !lease_released)) { ret FAILED; }
    }
    if (!cancelled) { ret FAILED; }
    ret OK;
}

fun route_is_current(controls: *ControlView, runtime: *Runtime, found: routing.Lookup) bool {
    if (found.status != routing.ROUTE_OK) { ret false; }
    val value: *Connection =
        connection_at(controls, found.binding.connection_slot);
    if (value == nil || !value.live
        || value.generation != found.binding.connection_generation
        || value.pump >= MAX_PUMPS
        || value.pump_generation != found.binding.pump_generation
        || !controls.pumps[value.pump].live
        || controls.pumps[value.pump].generation != value.pump_generation
        || found.binding.route_index >= assembly.CONNECTION_ID_CAPACITY
        || !value.storage.published[found.binding.route_index].live
        || !same_route_binding(
        value.storage.published[found.binding.route_index].binding,
        found.binding)) { ret false; }
    val route: assembly.Route = assembly.route_at(?value.assembly,
        found.binding.route_index);
    ret route.active && route.generation == found.binding.route_generation
        && route.sequence == found.binding.route_sequence
        && assembly.route_valid(?value.assembly, ?route);
}

fun mark_close_started(value: *Connection, now_ns: u64) {
    if (!value.close_started) {
        value.close_started     = true;
        value.close_deadline_ns = saturated_add(now_ns, CONNECTION_DRAIN_NS);
    }
}

fun begin_transport_close(value: *Connection, code: u64,
    now_ns: u64) bool {
    if (value.close_started) { ret true; }
    val result: qt.OperationResult = qt.begin_close[binding.Binding](
        ?value.assembly.driver, code, nil, 0, clock.from_ns(now_ns));
    if (result.status != qt.STATUS_OK && result.status != qt.STATUS_CLOSED) {
        ret false;
    }
    mark_close_started(value, now_ns);
    value.state = CONNECTION_RELEASING;
    ret true;
}

fun close_or_cancel_transport(value: *Connection, code: u64,
    now_ns: u64) bool {
    if (begin_transport_close(value, code, now_ns)) { ret true; }
    mark_close_started(value, now_ns);
    val cancelled: bool = qt.cancel_connection[binding.Binding](?value.assembly.driver);
    if (cancelled) {
        value.state = CONNECTION_CANCELLING;
    }
    or {
        value.state = CONNECTION_BROKEN;
    }
    ret cancelled;
}

fun fail_connection(controls: *ControlView, runtime: *Runtime, index: usize,
    now_ns: u64) {
    val value: *Connection = connection_at(controls, index);
    if (!value.live || value.state == CONNECTION_CANCELLING
        || value.state == CONNECTION_BROKEN
        || value.state == CONNECTION_FINALIZING
        || value.state == CONNECTION_CLEANUP
        || value.state == CONNECTION_FREE) { ret; }
    if (value.h3_session != h3_session.NO_SESSION
        && !value.h3_abandoning
        && !value.h3_cancelled) {
        val session: *h3_session.Session = h3_session.session_at(
            ?runtime.sessions, controls.sessions, value.h3_session);
        if (session != nil) { h3_session.cancel_session(session); }
        value.h3_cancelled = true;
    }
    val cancelled: bool = qt.cancel_connection[binding.Binding](?value.assembly.driver);
    mark_close_started(value, now_ns);
    if (cancelled) {
        value.state = CONNECTION_CANCELLING;
    }
    or {
        value.state = CONNECTION_BROKEN;
    }
    mark_ready(controls, runtime, index);
}

# the abortive counterpart of release_connection. each step either completes
# or leaves the connection live to be retried on a later pass, and the slot is
# only finalized once the transport and the assembly are both released: a slot
# reused over an unreleased assembly refuses every connection it is given.
fun force_release_connection(controls: *ControlView, runtime: *Runtime,
    index: usize, now: time.Instant, now_ns: u64) Status {
    val value: *Connection = connection_at(controls, index);
    if (!value.live) { ret OK; }
    value.state          = CONNECTION_BROKEN;
    value.timer_disarmed = true;
    arm_timer(runtime, value, now_ns);
    if (!value.routes_removed) {
        reconcile_routes(controls, runtime, index);
        if (!remove_routes(runtime, value)) { ret FAILED; }
        value.routes_removed = true;
    }
    val pump: *Pump                = ?controls.pumps[value.pump];
    val bank: *AdmissionGeneration = ?pump.admissions[value.admission_bank];
    if (value.charge_live) {
        quic_listener.release_connection(?bank.listener, value.charge);
        value.charge_live = false;
    }
    if (value.budget_charge_live) {
        budget.release(value.budgets, ?value.budget_charge);
        value.budget_charge_live = false;
    }
    # the transport is cancelled before the session is waited on: a request
    # stream only closes once the transport settles it, and past the drain
    # deadline nothing else will, since the peer may be gone and the timer is off
    if (value.assembly_attempted && !value.transport_finished) {
        qt.cancel_connection[binding.Binding](?value.assembly.driver);
    }
    if (value.h3_session != h3_session.NO_SESSION) {
        val session: *h3_session.Session = h3_session.session_at(
            ?runtime.sessions, controls.sessions, value.h3_session);
        if (session != nil && !value.h3_cancelled) {
            h3_session.cancel_session(session);
            value.h3_cancelled = true;
        }
        if (!drive_h3(controls, runtime, value, now, now_ns)
            || value.h3_session != h3_session.NO_SESSION) { ret BLOCKED; }
    }
    # finishing the close unregisters the transport from the connection scope
    # and clears its operation scope, which release_closed requires
    if (value.assembly_attempted && !value.transport_finished) {
        val finished: qt.OperationResult =
            qt.finish_close[binding.Binding](?value.assembly.driver);
        if (finished.status == qt.STATUS_BLOCKED) { ret BLOCKED; }
        if (finished.status != qt.STATUS_OK)      { ret FAILED; }
        value.transport_finished = true;
    }
    # an operation still registered on the scope settles through its own
    # cancellation, so the scope is released on a later pass rather than orphaned
    if (value.scope_live) {
        if (scope_active(?value.storage.scope)) {
            transition_ok(cancel.cancel(?value.storage.scope));
        }
        if (!operation_ok(cancel.destroy(?value.storage.scope))) { ret BLOCKED; }
        value.scope_live = false;
    }
    # an assembly that was never initialized holds nothing to release
    if (value.assembly_attempted && !value.assembly_released) {
        if (!assembly.release_closed(?value.assembly)) { ret FAILED; }
        value.assembly_released = true;
    }
    if (!release_handshake(controls, runtime, index, false, 0)) { ret FAILED; }
    value.state = CONNECTION_FINALIZING;
    ret finalize_connection(controls, runtime, index);
}

fun endpoint_metadata(endpoint: ip.Endpoint, storage: *u8,
    capacity: usize) message.Endpoint {
    val length: usize = ip.endpoint_format(endpoint, storage, capacity);
    if (length == 0) { ret message.unspecified_endpoint(); }
    ret message.endpoint(message.ENDPOINT_IP,
        view.view(storage, length), endpoint.port);
}

# an active transport finished its handshake, and a pump only serves a policy
# that requires ALPN and offers exactly h3, so the handshake selected h3. the
# handshake record may already be reused by then, so it is not consulted
fun selected_h3(value: *Connection) bool {
    ret exact_h3(value.policy);
}

fun start_h3(controls: *ControlView, runtime: *Runtime, value: *Connection,
    now: time.Instant, now_ns: u64) bool {
    if (value.h3_started) { ret true; }
    val index: usize = h3_session.acquire(?runtime.sessions,
        controls.sessions);
    if (index == h3_session.NO_SESSION) { ret false; }
    val session: *h3_session.Session =
        h3_session.session_at(?runtime.sessions, controls.sessions,
        index);
    val peer: message.Endpoint = endpoint_metadata(value.peer,
        ?value.storage.peer_text[0], ENDPOINT_BYTES);
    val local: message.Endpoint = endpoint_metadata(value.local,
        ?value.storage.local_text[0], ENDPOINT_BYTES);
    if (session == nil || peer.kind == message.ENDPOINT_UNSPECIFIED
        || local.kind == message.ENDPOINT_UNSPECIFIED
        || !h3_session.begin(session, ?value.assembly.driver, ?value.storage.scope,
        value.plan, value.budgets, value.limits, value.max_requests,
        (?value.storage.listener_name[0])::str, peer, local,
        value.request_timeout_ns, now_ns,
        memory.borrowed_source(?value.storage.borrower), ?value.assembly.account,
        runtime.chunks, value.call_memory_bytes,
        hedge_wake.waker(runtime.wakes, timer_owner(index)))) {
        if (!h3_session.abandon(?runtime.sessions,
            controls.sessions, index)) {
            value.h3_session    = index;
            value.h3_started    = true;
            value.h3_abandoning = true;
        }
        ret false;
    }
    value.h3_session = index;
    value.h3_started = true;
    ret true;
}

fun drive_h3(controls: *ControlView, runtime: *Runtime, value: *Connection,
    now: time.Instant, now_ns: u64) bool {
    val transport: qt.Snapshot =
        qt.snapshot[binding.Binding](?value.assembly.driver);
    if (!value.h3_started
        && (value.state == CONNECTION_LIVE
        || value.state == CONNECTION_GRACEFUL)
        && transport.state == qt.ACTIVE) {
        if (!selected_h3(value) || !start_h3(controls, runtime, value, now, now_ns)) {
            ret close_or_cancel_transport(value,
                h3.H3_GENERAL_PROTOCOL_ERROR, now_ns);
        }
    }
    if (value.h3_session == h3_session.NO_SESSION) { ret true; }
    if (value.h3_abandoning) {
        if (!h3_session.abandon(?runtime.sessions,
            controls.sessions, value.h3_session)) { ret false; }
        value.h3_session    = h3_session.NO_SESSION;
        value.h3_abandoning = false;
        ret true;
    }
    val session: *h3_session.Session = h3_session.session_at(
        ?runtime.sessions, controls.sessions, value.h3_session);
    if (session == nil) { ret false; }
    if (transport.state != qt.ACTIVE && !value.h3_cancelled
        && session.state != h3_session.CLOSED) {
        h3_session.cancel_session(session);
        value.h3_cancelled = true;
    }
    if (value.state == CONNECTION_GRACEFUL
        && session.state == h3_session.ACTIVE) {
        if (!h3_session.begin_graceful(session)) { ret false; }
    }
    var attempts: usize = 0;
    for (attempts < h3_session.MAX_STEPS) {
        val progress: h3_session.Step =
            h3_session.advance(session, now, now_ns);
        if (progress == h3_session.STEP_DONE) {
            val index:    usize                    = value.h3_session;
            val released: h3_session.ReleaseStatus =
                h3_session.release_status(?runtime.sessions,
                controls.sessions, index);
            if (released == h3_session.RELEASE_PENDING) { ret true; }
            value.h3_session = h3_session.NO_SESSION;
            if (released != h3_session.RELEASE_OK) {
                close_or_cancel_transport(value,
                    h3.H3_GENERAL_PROTOCOL_ERROR, now_ns);
                ret false;
            }
            ret close_or_cancel_transport(value, h3.H3_NO_ERROR, now_ns);
        }
        # an h3 step error transitions the session into its drain path
        if (progress == h3_session.STEP_BLOCKED
            || progress == h3_session.STEP_IDLE) { ret true; }
        attempts = attempts + 1;
    }
    ret true;
}

fun free_send(value: *Connection) usize {
    var i: usize = 0;
    for (i < assembly.SEND_CAPACITY) {
        if (!value.storage.sends[i].pending) { ret i; }
        i = i + 1;
    }
    ret assembly.SEND_CAPACITY;
}

fun fill_send_packet(operation: *SendOperation,
    generated: qt.Generated) {
    operation.packet.buffer                = generated.buffer;
    operation.packet.capacity              = generated.count;
    operation.packet.length                = generated.count;
    operation.packet.peer                  = generated.peer;
    operation.packet.local_destination     = generated.local_destination;
    operation.packet.interface_index       = generated.interface_index;
    operation.packet.has_local_destination = generated.has_local_destination;
    operation.packet.truncated             = false;
    operation.packet.zero_length           = false;
}

fun generate_sends(controls: *ControlView, runtime: *Runtime, index: usize,
    now_ns: u64) bool {
    val value:    *Connection = connection_at(controls, index);
    val pump:     *Pump       = ?controls.pumps[value.pump];
    var attempts: usize       = 0;
    for (attempts < assembly.SEND_CAPACITY) {
        val operation_index: usize = free_send(value);
        if (operation_index == assembly.SEND_CAPACITY) { ret true; }
        val operation: *SendOperation =
            ?value.storage.sends[operation_index];
        operation.generation = next_generation(operation.generation);
        val generated: qt.Generated = qt.generate[binding.Binding](
            ?value.assembly.driver, ?value.storage.scope, ?operation.buffer[0],
            assembly.MAX_UDP_PAYLOAD, clock.from_ns(now_ns), operation.generation::usize);
        if (!reconcile_routes(controls, runtime, index)
            || !refresh_timer(controls, runtime, index)) { ret false; }
        if (generated.status == qt.STATUS_EMPTY
            || generated.status == qt.STATUS_BLOCKED
            || generated.status == qt.STATUS_CLOSED
            || generated.status == qt.STATUS_CANCELLED) { ret true; }
        if (generated.status != qt.STATUS_OK) { ret false; }
        operation.token = generated.token;
        fill_send_packet(operation, generated);
        if (!make_context(?operation.context, runtime, COMPLETION_SEND,
            value.pump, value.pump_generation, index, value.generation,
            operation_index, operation.generation, generated.token)) {
            qt.complete_send[binding.Binding](?value.assembly.driver,
                generated.token, qt.SEND_FAILED, 0, clock.from_ns(now_ns));
            ret false;
        }
        val submitted: res[io_runtime.Token, io_error.Error] =
            net_async.submit_send_batch(pump.driver, ?value.storage.scope, pump.socket,
            ?operation.packet, 1, (?operation.context.route)::usize);
        if (sel submitted.err) {
            qt.complete_send[binding.Binding](?value.assembly.driver,
                generated.token, qt.SEND_FAILED, 0, clock.from_ns(now_ns));
            if (!reconcile_routes(controls, runtime, index)
                || !refresh_timer(controls, runtime, index)) { ret false; }
            ret false;
        }
        operation.pending = true;
        attempts          = attempts + 1;
    }
    ret true;
}

# a connection waiting on memory is shed once it has waited memory_wait_ns.
# under memory pressure that is deliberate: a connection that cannot get memory
# makes no progress, and waiting without bound would hold its account and its
# reservation from connections that could
fun observe_memory(value: *Connection, now_ns: u64) {
    if (!memory.waiting(?value.assembly.account)) {
        value.memory_deadline_ns = 0;
        ret;
    }
    if (value.memory_deadline_ns == 0) {
        value.memory_deadline_ns = saturated_add(now_ns, value.memory_wait_ns);
    }
}

fun progress_connection(controls: *ControlView, runtime: *Runtime, index: usize,
    now: time.Instant, now_ns: u64) bool {
    val value: *Connection = connection_at(controls, index);
    if (!value.live || value.state == CONNECTION_BROKEN) { ret false; }
    # an h3 failure must not stop the transport: its queued close still has to
    # reach the wire and its drain timer still has to fire for the connection
    # to be reclaimed
    val h3_ok: bool = drive_h3(controls, runtime, value, now, now_ns);
    value.h3_deadline_ns = 0;
    if (value.h3_session != h3_session.NO_SESSION) {
        val session: *h3_session.Session = h3_session.session_at(
            ?runtime.sessions, controls.sessions, value.h3_session);
        var due: u64 = 0;
        if (session != nil && h3_session.next_deadline(session, ?due)) {
            value.h3_deadline_ns = due;
        }
    }
    val sends_ok: bool = generate_sends(controls, runtime, index, now_ns);
    if (value.handshake != NO_HANDSHAKE && assembly.tls_released(?value.assembly)
        && !release_handshake(controls, runtime, index, true, now_ns)) { ret false; }
    observe_memory(value, now_ns);
    if (!reconcile_routes(controls, runtime, index)
        || !refresh_timer(controls, runtime, index)) { ret false; }
    ret h3_ok && sends_ok;
}

fun deliver_known(controls: *ControlView, runtime: *Runtime, received: *net_types.Packet,
    found: routing.Lookup, now: time.Instant, now_ns: u64) Status {
    if (!route_is_current(controls, runtime, found)) { ret STALE; }
    val index: usize       = found.binding.connection_slot;
    val value: *Connection = connection_at(controls, index);
    # a connection mid-handshake takes its datagrams on the worker's handshake
    # turn, so the receive path spends no crypto and reads on
    if (value.handshake != NO_HANDSHAKE) {
        hold_datagram(runtime, ?value.held, HELD_PER_CONNECTION, received);
        mark_ready(controls, runtime, index);
        ret OK;
    }
    val delivered: qt.OperationResult = qt.receive_native[binding.Binding](
        ?value.assembly.driver, received, value.local, clock.from_ns(now_ns), 0);
    if (delivered.status == qt.STATUS_ERROR
        || !reconcile_routes(controls, runtime, index)
        || !refresh_timer(controls, runtime, index)) {
        fail_connection(controls, runtime, index, now_ns);
    }
    mark_ready(controls, runtime, index);
    ret OK;
}

fun process_datagram(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    received: *net_types.Packet, now: time.Instant, now_ns: u64) Status {
    if (received == nil || received.truncated || received.zero_length
        || received.length == 0
        || received.length > assembly.MAX_UDP_PAYLOAD) { ret INVALID; }
    val classified: quic_listener.ClassifiedDatagram =
        quic_listener.classify_datagram(received.buffer, received.length,
        CONNECTION_ID_BYTES);
    if (classified.class == quic_listener.DATAGRAM_MALFORMED) { ret OK; }
    val key: routing.Key = routing.key(?classified.destination.data[0],
        classified.destination.length);
    val found: routing.Lookup = routing.lookup(?runtime.routes, key);
    if (found.status == routing.ROUTE_OK && found.binding.pending) {
        ret deliver_pending(runtime, found, received);
    }
    if (found.status == routing.ROUTE_OK) {
        ret deliver_known(controls, runtime, received, found, now, now_ns);
    }
    if (classified.class == quic_listener.DATAGRAM_INITIAL
        || classified.class == quic_listener.DATAGRAM_NEGOTIATE) {
        val pump: *Pump = ?controls.pumps[pump_index];
        if (pump.draining || pump.cancelling) { ret STOPPED; }
        ret hold_arrival(runtime, pump, received, key,
            arrival_class(pump, ?classified, key), now_ns);
    }
    ret OK;
}

fun context_current(controls: *ControlView, runtime: *Runtime, context: *CompletionContext) bool {
    if (runtime == nil || !runtime.initialized || context == nil
        || context.pump >= MAX_PUMPS) { ret false; }
    val pump: *Pump = ?controls.pumps[context.pump];
    if (!pump.live || pump.generation != context.pump_generation) {
        ret false;
    }
    if (context.kind == COMPLETION_RECEIVE
        || context.kind == COMPLETION_STATELESS) { ret true; }
    ret context.kind == COMPLETION_SEND
        && connection_for(controls, runtime, context.connection,
        context.connection_generation) != nil;
}

fun settle_receive(controls: *ControlView, runtime: *Runtime, context: *CompletionContext,
    completion: io_runtime.Completion, now: time.Instant,
    now_ns: u64) Status {
    val pump: *Pump = ?controls.pumps[context.pump];
    if (!pump.receive_pending) { ret STALE; }
    pump.receive_pending = false;
    if (completion.kind != io_runtime.RECEIVE_FROM
        || completion.items > RECEIVE_BATCH) { ret FAILED; }
    var status: Status = OK;
    if (!completion.has_error) {
        val started_ns:     u64   = monotonic_ns();
        val held_before:    usize = pump.arrival_live;
        val dropped_before: u64   = arrivals_dropped_total(runtime);
        var i:              usize = 0;
        for (i < completion.items) {
            val applied: Status = process_datagram(controls, runtime, context.pump,
                ?pump.storage.receive_packets[i], now, now_ns);
            if (applied == FAILED) {
                runtime.datagram_failures = runtime.datagram_failures + 1;
            }
            i = i + 1;
        }
        charge_arrival_batch(runtime, pump, started_ns, held_before, dropped_before,
            completion.items);
    }
    or (scope_active(?pump.storage.scope)) {
        status = FAILED;
    }
    var i: usize = 0;
    for (i < RECEIVE_BATCH) {
        reset_receive_packet(pump, i);
        i = i + 1;
    }
    if (pump.started && pump.scope_live && scope_active(?pump.storage.scope)
        && (!pump.cancelling || pump.active_connections != 0)) {
        if (submit_receive(pump) != OK) { status = FAILED; }
    }
    ret status;
}

fun token_matches(context: *CompletionContext, value: qt.Token) bool {
    ret context.token_source == value.source
        && context.token_index == value.index
        && context.token_generation == value.generation;
}

fun settle_send(controls: *ControlView, runtime: *Runtime, context: *CompletionContext,
    completion: io_runtime.Completion, now: time.Instant,
    now_ns: u64) Status {
    val value: *Connection = connection_for(controls, runtime, context.connection,
        context.connection_generation);
    if (value == nil || context.operation >= assembly.SEND_CAPACITY) {
        ret STALE;
    }
    val operation: *SendOperation =
        ?value.storage.sends[context.operation];
    if (!operation.pending || operation.generation != context.operation_generation
        || !token_matches(context, operation.token)) { ret STALE; }
    # a cancelled or timed-out send still reports what went out before it
    # stopped, and a datagram that went out whole was sent: reporting it unsent
    # would refund its anti-amplification credit and send its frames again
    val whole: bool = completion.kind == io_runtime.SEND_TO
        && completion.items == 1 && completion.bytes == operation.packet.length;
    val stopped: bool = completion.has_error
        && (completion.error.kind == io_error.CANCELLED
        || completion.error.kind == io_error.TIMEOUT);
    var send_status: qt.SendStatus = qt.SEND_SENT;
    var count:       usize         = operation.packet.length;
    if (!whole || (completion.has_error && !stopped)) {
        send_status = qt.SEND_FAILED;
        count       = 0;
        if (stopped && completion.error.kind == io_error.CANCELLED) {
            send_status = qt.SEND_CANCELLED;
        }
        if (stopped && completion.error.kind == io_error.TIMEOUT) {
            send_status = qt.SEND_TIMED_OUT;
        }
    }
    val settled: qt.Completion = qt.complete_send[binding.Binding](
        ?value.assembly.driver, operation.token, send_status, count,
        clock.from_ns(now_ns));
    operation.pending = false;
    if (settled.status == qt.STATUS_ERROR
        || !reconcile_routes(controls, runtime, context.connection)
        || !refresh_timer(controls, runtime, context.connection)) {
        fail_connection(controls, runtime, context.connection, now_ns);
    }
    mark_ready(controls, runtime, context.connection);
    ret OK;
}

fun settle_stateless(controls: *ControlView, runtime: *Runtime, context: *CompletionContext,
    completion: io_runtime.Completion) Status {
    val pump: *Pump = ?controls.pumps[context.pump];
    if (context.operation >= hedge_storage.table_capacity[StatelessSend](?pump.stateless)) { ret STALE; }
    val operation: *StatelessSend = stateless_at(pump, context.operation);
    if (!operation.pending
        || operation.generation != context.operation_generation) { ret STALE; }
    release_stateless(pump, context.operation);
    ret OK;
}

fun complete_at(controls: *ControlView, runtime: *Runtime, context: *CompletionContext,
    completion: io_runtime.Completion, now: time.Instant,
    now_ns: u64) Status {
    if (!context_current(controls, runtime, context)) { ret STALE; }
    if (context.kind == COMPLETION_RECEIVE) {
        ret settle_receive(controls, runtime, context, completion, now, now_ns);
    }
    if (context.kind == COMPLETION_SEND) {
        ret settle_send(controls, runtime, context, completion, now, now_ns);
    }
    if (context.kind == COMPLETION_STATELESS) {
        ret settle_stateless(controls, runtime, context, completion);
    }
    ret INVALID;
}

# the shared cap is the manager itself, so there is nothing to agree on beyond
# binding it before anything is connected
# the owner's socket poll: a non-blocking wait on its io runtime that settles
# what completed. bound once, before anything is connected
pub fun bind_read_on(runtime: *Runtime, hook: fun(ptr) bool, ctx: ptr) bool {
    if (runtime == nil || !runtime.initialized || hook::usize == 0
        || runtime.live_total != 0) { ret false; }
    runtime.read_on     = hook;
    runtime.read_on_ctx = ctx;
    ret true;
}

pub fun bind_admission(runtime: *Runtime,
    manager: *process_admission.Manager) bool {
    if (runtime == nil || !runtime.initialized || manager == nil
        || !manager.initialized || runtime.live_total != 0) {
        ret false;
    }
    runtime.admission = manager;
    ret true;
}

# only what settled before this call is taken, so a completion that settles
# while these are handled waits for the next turn instead of starving it
fun drain_completions(controls: *ControlView, runtime: *Runtime, now: time.Instant,
    now_ns: u64) Status {
    var status: Status             = OK;
    val last:   *CompletionContext = runtime.completions_tail;
    for (last != nil && runtime.completions_head != nil) {
        val context:    *CompletionContext    = runtime.completions_head;
        val completion: io_runtime.Completion = context.completion;
        unqueue_completion(runtime, context);
        if (complete_at(controls, runtime, context, completion,
            now, now_ns) == FAILED) { status = FAILED; }
        if (context == last) { brk; }
    }
    ret status;
}

fun send_operations_pending(value: *Connection) bool {
    var i: usize = 0;
    for (i < assembly.SEND_CAPACITY) {
        if (value.storage.sends[i].pending) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun observe_transport_close(value: *Connection, now_ns: u64) {
    val snapshot: qt.Snapshot =
        qt.snapshot[binding.Binding](?value.assembly.driver);
    if (snapshot.state == qt.CLOSING || snapshot.state == qt.DRAINING
        || snapshot.state == qt.CLOSED) {
        mark_close_started(value, now_ns);
        if (value.state != CONNECTION_CANCELLING && value.state != CONNECTION_BROKEN) {
            value.state = CONNECTION_RELEASING;
        }
    }
}

fun finalize_connection(controls: *ControlView, runtime: *Runtime, index: usize) Status {
    val value: *Connection = connection_at(controls, index);
    if (!value.live || value.state != CONNECTION_FINALIZING) { ret INVALID; }
    val pump:       *Pump = ?controls.pumps[value.pump];
    val bank_index: usize = value.admission_bank;
    if (!release_process_lease(runtime, value)) { ret FAILED; }
    free_connection(controls, runtime, index);
    if (pump.admissions[bank_index].retiring
        && pump.admissions[bank_index].active_connections == 0
        && pump.admissions[bank_index].queued_initials == 0) {
        reap_admission(?pump.admissions[bank_index]);
    }
    ret OK;
}

fun release_connection(controls: *ControlView, runtime: *Runtime, index: usize,
    now: time.Instant, now_ns: u64) Status {
    val value: *Connection = connection_at(controls, index);
    if (value.live && value.state == CONNECTION_FINALIZING) {
        ret finalize_connection(controls, runtime, index);
    }
    if (!value.live || value.state == CONNECTION_CLEANUP) { ret BLOCKED; }
    if (value.state == CONNECTION_BROKEN) {
        ret force_release_connection(controls, runtime, index, now, now_ns);
    }
    if (value.close_deadline_ns != 0 && now_ns >= value.close_deadline_ns) {
        ret force_release_connection(controls, runtime, index, now, now_ns);
    }
    if (!value.transport_finished) {
        observe_transport_close(value, now_ns);
        if (!value.close_started) { ret BLOCKED; }
        if (value.h3_session != h3_session.NO_SESSION) {
            if (!drive_h3(controls, runtime, value, now, now_ns)
                || value.h3_session != h3_session.NO_SESSION) { ret BLOCKED; }
        }
        if (send_operations_pending(value)) { ret BLOCKED; }
        val snapshot: qt.Snapshot =
            qt.snapshot[binding.Binding](?value.assembly.driver);
        if (snapshot.state != qt.DRAINING && snapshot.state != qt.CLOSED) {
            ret BLOCKED;
        }
        val finished: qt.OperationResult =
            qt.finish_close[binding.Binding](?value.assembly.driver);
        if (finished.status == qt.STATUS_BLOCKED) { ret BLOCKED; }
        if (finished.status != qt.STATUS_OK) {
            value.state = CONNECTION_BROKEN;
            ret force_release_connection(controls, runtime, index, now, now_ns);
        }
        value.timer_disarmed = true;
        if (!arm_timer(runtime, value, now_ns)) { ret FAILED; }
        value.transport_finished = true;
    }
    if (qt.snapshot[binding.Binding](?value.assembly.driver).state !=
        qt.CLOSED) { ret BLOCKED; }
    if (!value.routes_removed) {
        if (!reconcile_routes(controls, runtime, index)
            || !remove_routes(runtime, value)) { ret FAILED; }
        value.routes_removed = true;
    }
    val pump: *Pump                = ?controls.pumps[value.pump];
    val bank: *AdmissionGeneration = ?pump.admissions[value.admission_bank];
    if (value.charge_live) {
        if (quic_listener.release_connection(?bank.listener,
            value.charge).action == quic_listener.ACTION_ACCEPT) {
            value.charge_live = false;
        }
    }
    if (value.budget_charge_live) {
        if (budget.release(value.budgets, ?value.budget_charge)) {
            value.budget_charge_live = false;
        }
    }
    if (value.scope_live) {
        if (operation_ok(cancel.destroy(?value.storage.scope))) { value.scope_live = false; }
    }
    if (value.charge_live || value.budget_charge_live
        || value.scope_live) { ret FAILED; }
    if (!value.assembly_released) {
        if (!assembly.release_closed(?value.assembly)) {
            value.state = CONNECTION_BROKEN;
            ret force_release_connection(controls, runtime, index, now, now_ns);
        }
        value.assembly_released = true;
    }
    if (!release_handshake(controls, runtime, index, false, 0)) { ret FAILED; }
    value.state = CONNECTION_FINALIZING;
    ret finalize_connection(controls, runtime, index);
}

# a budget-admitted initial takes its place in the deferred queue. its wheel
# entry moves from the budget deadline to the admission deadline, and the
# ceiling and the peer's share apply as they do at arrival
fun defer_admitted(controls: *ControlView, runtime: *Runtime, index: usize,
    now_ns: u64) bool {
    val pending: *PendingInitial = pending_at(runtime, index);
    if (!deadline_allows(runtime, pending.arrival_ns,
        pending.config.handshake_timeout_ns, now_ns, runtime.deferred_count)
        || !process_admission.acquire(?runtime.handshakes, ?pending.peer,
        ?pending.handshake_lease)) {
        refuse_pending(controls, runtime, pending, now_ns);
        ret false;
    }
    pending.handshake_lease_live = true;
    if (pending.timer_live) {
        wheel.arm(runtime.timers, pending.timer,
            saturated_add(pending.arrival_ns, pending.config.handshake_timeout_ns));
    }
    link_deferred(runtime, index);
    if (!handshake_room(runtime) || runtime.deferred_count > 1) {
        hold_deferred(runtime, pending);
    }
    ret true;
}

# the deferred queue is promoted one Initial per turn, in arrival order, when
# a handshake slot is free and the turn's crypto budget is unspent. one per
# turn keeps every turn short enough that the receive is back on the socket
# between handshakes, and costs no throughput: a turn with a promotion waiting
# is a turn the worker runs at once
fun advance_pending_initials(controls: *ControlView, runtime: *Runtime, now: time.Instant,
    now_ns: u64) Status {
    var status: Status = OK;
    if (promotable(runtime) && runtime.crypto_budget != 0) {
        mark_pending_ready(runtime, runtime.deferred_head);
    }
    # an initial marked while these are serviced waits for the next turn
    val last: usize = runtime.pending_ready_tail;
    var i:    usize = runtime.pending_ready_head;
    for (last != NO_CONNECTION && i != NO_CONNECTION) {
        val pending: *PendingInitial = pending_at(runtime, i);
        var next:    usize           = pending.ready_next;
        if (i == last) { next = NO_CONNECTION; }
        unmark_pending_ready(runtime, i);
        if (pending.pump >= MAX_PUMPS
            || pending.admission_bank >= ADMISSION_BANKS) {
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        val pump: *Pump                = ?controls.pumps[pending.pump];
        val bank: *AdmissionGeneration =
            ?pump.admissions[pending.admission_bank];
        if (pending.cleanup_only) {
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        if (!pump.live || pump.generation != pending.pump_generation
            || pump.draining || pump.cancelling || !bank.live) {
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        if (!pending.deferred) {
            val outcome: budget.Outcome = budget.retry(
                pending.config.budgets, ?pending.budget_charge, now);
            if (outcome == budget.QUEUED) {
                i = next;
                cnt;
            }
            if (outcome != budget.ADMITTED) {
                if (!pending.budget_charge.live) {
                    pending.budget_charge_live = false;
                }
                if (!release_pending_initial(controls, runtime, i)) {
                    retry_release(runtime, i);
                    status = FAILED;
                }
                i = next;
                cnt;
            }
            if (!defer_admitted(controls, runtime, i, now_ns)) {
                if (!release_pending_initial(controls, runtime, i)) {
                    retry_release(runtime, i);
                    status = FAILED;
                }
                i = next;
                cnt;
            }
        }
        val deadline_ns: u64 = saturated_add(pending.arrival_ns,
            pending.config.handshake_timeout_ns);
        if (now_ns >= deadline_ns) {
            refuse_pending(controls, runtime, pending, now_ns);
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        if (i != runtime.deferred_head || runtime.crypto_budget == 0
            || !handshake_room(runtime)) {
            hold_deferred(runtime, pending);
            i = next;
            cnt;
        }
        # the deadline drop: promoted now, this handshake would still end past
        # its own deadline, so the crypto is not spent on it
        if (!deadline_allows(runtime, pending.arrival_ns,
            pending.config.handshake_timeout_ns, now_ns, 0)) {
            refuse_pending(controls, runtime, pending, now_ns);
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        val packet_value:    net_types.Packet = pending_packet(pending);
        var config_snapshot: ConnectionConfig;
        if (!materialize_pending_config(?pending.config,
            ?config_snapshot)) {
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        val lease:            process_admission.Lease = pending.lease;
        val pump_index:       usize                   = pending.pump;
        val bank_index:       usize                   = pending.admission_bank;
        val connection_index: usize                   = acquire_connection(controls, runtime,
            pump_index, bank_index, lease);
        if (connection_index == NO_CONNECTION) {
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        # the acceptance is committed only now: the connection is being made
        val accepted: quic_listener.Accepted =
            quic_listener.commit(?bank.listener, pending.acceptance);
        pending.acceptance_live = false;
        if (accepted.action != quic_listener.ACTION_ACCEPT) {
            connection_failed(runtime);
            free_connection(controls, runtime, connection_index);
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        val value: *Connection =
            connection_at(controls, connection_index);
        if (!transfer_pending_ownership(pending, ?accepted, value)) {
            status           = FAILED;
            value.lease_live = false;
            value.lease      = process_admission.no_lease();
            value.state      = CONNECTION_CLEANUP;
            cleanup_accepting(controls, runtime, connection_index);
            if (!release_pending_initial(controls, runtime, i)) {
                retry_release(runtime, i);
                status = FAILED;
            }
            i = next;
            cnt;
        }
        val arrival_ns: u64 = pending.arrival_ns;
        # the connection publishes the same ID once initialized
        unpublish_pending_route(runtime, i);
        val initialized: bool = initialize_connection(controls, runtime,
            pump_index, bank_index,
            connection_index, ?accepted, ?packet_value,
            ?config_snapshot, arrival_ns, now_ns);
        var delivered: bool = false;
        if (initialized) {
            move_held(?value.held, ?pending.held);
            delivered = deliver_initial(controls, runtime, connection_index,
                ?packet_value, now_ns);
            if (delivered) { deliver_held(controls, runtime, connection_index, now_ns); }
            mark_connection_superseded(controls, runtime, connection_index);
            if (delivered
                && !progress_connection(controls, runtime, connection_index,
                now, now_ns)) {
                fail_connection(controls, runtime, connection_index, now_ns);
            }
        }
        take_pending_initial(controls, runtime, i);
        runtime.handshakes_promoted = runtime.handshakes_promoted + 1;
        runtime.crypto_budget       = runtime.crypto_budget - 1;
        i                           = next;
    }
    ret status;
}

# an initial whose release waits on nothing that wakes it is tried every turn
# until #182 gives teardown a wake of its own
fun retry_release(runtime: *Runtime, index: usize) {
    mark_pending_ready(runtime, index);
}

fun cancel_pending_bank(controls: *ControlView, runtime: *Runtime, pump_index: usize,
    bank_index: usize) bool {
    var success: bool  = true;
    var i:       usize = runtime.pending_live_head;
    for (i != NO_CONNECTION) {
        val pending: *PendingInitial = pending_at(runtime, i);
        val next:    usize           = pending.next_live;
        if (pending.pump == pump_index
            && pending.admission_bank == bank_index
            && !release_pending_initial(controls, runtime, i)) {
            retry_release(runtime, i);
            success = false;
        }
        i = next;
    }
    ret success;
}

fun connection_failed(runtime: *Runtime) {
    runtime.connection_failures = runtime.connection_failures + 1;
}

# a connection whose teardown waits on nothing that wakes it is tried every
# turn until #182 gives teardown a wake of its own. a service it holds wakes it
fun needs_polling(controls: *ControlView, runtime: *Runtime, value: *Connection) bool {
    if (value.state == CONNECTION_CLEANUP || value.state == CONNECTION_FINALIZING
        || value.h3_abandoning) { ret true; }
    if (value.h3_session == h3_session.NO_SESSION) { ret false; }
    ret value.close_started;
}

# whether servicing the connection now would do work nothing else will start:
# datagrams held for its handshake turn, a pool wake nobody routed, or a
# teardown that finishes only by being serviced (#182)
fun pending_work(controls: *ControlView, runtime: *Runtime, value: *Connection) bool {
    if (value.held.count != 0)                                          { ret true; }
    if (value.assembly.account.open && value.assembly.account.is_ready) { ret true; }
    ret needs_polling(controls, runtime, value);
}

# the worker's debug audit over this runtime's records: every live connection
# on neither the ready lists nor the waiting list must hold no work. returns
# how many do (#182)
pub fun audit(controls: *ControlView, runtime: *Runtime) usize {
    if (runtime == nil || !runtime.initialized) { ret 0; }
    var found: usize = 0;
    var i:     usize = runtime.live_head;
    for (i != NO_CONNECTION) {
        val value: *Connection = connection_at(controls, i);
        if (value.live && !value.ready && !value.waiting
            && pending_work(controls, runtime, value)) { found = found + 1; }
        i = value.next_live;
    }
    ret found;
}

fun service_connection(controls: *ControlView, runtime: *Runtime, index: usize,
    now: time.Instant, now_ns: u64) {
    val value: *Connection = connection_at(controls, index);
    if (!value.live) { ret; }
    if (value.state == CONNECTION_CLEANUP) {
        if (!cleanup_accepting(controls, runtime, index)) { connection_failed(runtime); }
    }
    or (value.state == CONNECTION_FINALIZING) {
        if (finalize_connection(controls, runtime, index) == FAILED) { connection_failed(runtime); }
    }
    or (value.state == CONNECTION_BROKEN) {
        if (release_connection(controls, runtime, index, now, now_ns) == FAILED) {
            connection_failed(runtime);
        }
    }
    or {
        if (!progress_connection(controls, runtime, index, now, now_ns)) {
            fail_connection(controls, runtime, index, now_ns);
        }
        val released: Status = release_connection(controls, runtime, index, now, now_ns);
        if (released == FAILED) {
            connection_failed(runtime);
            fail_connection(controls, runtime, index, now_ns);
        }
    }
    # a release may have freed the connection, compacting its chunk out from under
    # `value`, so reach it again through the nil-guarded accessor
    val current: *Connection = connection_at(controls, index);
    if (current == nil || !current.live) { ret; }
    if (!arm_timer(runtime, current, now_ns)) {
        connection_failed(runtime);
        fail_connection(controls, runtime, index, now_ns);
    }
    set_waiting(controls, runtime, index, needs_polling(controls, runtime, current));
}

# a wheel entry of this runtime came due. the transport's own deadline is
# handed to it, and either way the connection is looked at this turn
pub fun fire(controls: *ControlView, runtime: *Runtime, owner: u64, now_ns: u64) {
    if (runtime == nil || !runtime.initialized) { ret; }
    if (owns_pending(owner)) {
        wake_pending(runtime, owner);
        ret;
    }
    if (!owns_timer(owner)) { ret; }
    val index: usize = (owner & ~TIMER_MASK)::usize;
    if (index >= hedge_storage.secret_table_capacity[Connection](controls.connections)) { ret; }
    val value: *Connection = connection_at(controls, index);
    if (!value.live) { ret; }
    if (!value.timer_disarmed && value.assembly.initialized
        && value.transport_timer.armed
        && clock.to_ns(value.transport_timer.deadline) <= now_ns) {
        val timed: qt.OperationResult = qt.on_timeout[binding.Binding](
            ?value.assembly.driver, value.transport_timer, clock.from_ns(now_ns));
        value.transport_timer.armed = false;
        if (timed.status != qt.STATUS_STALE
            && timed.status != qt.STATUS_CLOSED
            && timed.status != qt.STATUS_CANCELLED
            && timed.status != qt.STATUS_OK) {
            fail_connection(controls, runtime, index, now_ns);
        }
        if (!reconcile_routes(controls, runtime, index)
            || !refresh_timer(controls, runtime, index)) {
            fail_connection(controls, runtime, index, now_ns);
        }
    }
    if (value.memory_deadline_ns != 0 && value.memory_deadline_ns <= now_ns) {
        value.memory_deadline_ns = 0;
        if (memory.waiting(?value.assembly.account)) {
            memory.timed_out(?value.storage.borrower);
            fail_connection(controls, runtime, index, now_ns);
        }
    }
    mark_ready(controls, runtime, index);
}

# a wake from the worker's queue for a connection this runtime owns. the owner
# is the connection's timer owner, so the wake routes the same way a timer does
fun wake_pending(runtime: *Runtime, owner: u64) {
    val index: usize = (owner & ~TIMER_MASK)::usize;
    if (index >= hedge_storage.table_capacity[PendingInitial](?runtime.pending_initials)) { ret; }
    mark_pending_ready(runtime, index);
}

pub fun wake(controls: *ControlView, runtime: *Runtime, owner: u64) {
    if (runtime == nil || !runtime.initialized) { ret; }
    if (owns_pending(owner)) {
        wake_pending(runtime, owner);
        ret;
    }
    if (!owns_timer(owner)) { ret; }
    val index: usize = (owner & ~TIMER_MASK)::usize;
    if (index >= hedge_storage.secret_table_capacity[Connection](controls.connections)) { ret; }
    # the owner is also the account's wake handle. the pool's wake may be for
    # quic's chunks or for the h3 session's, and both are retried
    val value: *Connection = connection_at(controls, index);
    if (value.live && value.assembly.initialized) {
        qt.storage_ready[binding.Binding](?value.assembly.driver);
    }
    mark_ready(controls, runtime, index);
}

# every deadline and budget is scheduled on now_ns, the monotonic clock. TLS
# reads calendar time through its policy's clock. only connections something
# happened to are visited: settled io, a fired timer, or a state change
pub fun advance(controls: *ControlView, runtime: *Runtime, now_ns: u64) Status {
    if (runtime == nil || !runtime.initialized || now_ns == 0) { ret INVALID; }
    val now:    time.Instant = clock.from_ns(now_ns);
    val status: Status       = drain_completions(controls, runtime, now, now_ns);
    var i:      usize        = runtime.waiting_head;
    for (i != NO_CONNECTION) {
        mark_ready(controls, runtime, i);
        i = connection_at(controls, i).waiting_next;
    }
    # a connection marked while these are serviced waits for the next turn
    val last: usize = runtime.ready_tail;
    for (last != NO_CONNECTION && runtime.ready_head != NO_CONNECTION) {
        val index: usize = runtime.ready_head;
        unmark_ready(controls, runtime, index);
        service_connection(controls, runtime, index, now, now_ns);
        if (index == last) { brk; }
    }
    # one unit of handshake work per turn, so every turn returns to the
    # socket between handshakes. a turn with handshake work waiting runs at once
    runtime.crypto_budget = 1;
    for (runtime.handshake_ready_head != NO_CONNECTION) {
        val index: usize = runtime.handshake_ready_head;
        unmark_ready(controls, runtime, index);
        # marked as handshake work and then failed or released: bookkeeping,
        # serviced without the budget so the next real handshake gets it
        if (!handshake_work(connection_at(controls, index))) {
            service_connection(controls, runtime, index, now, now_ns);
            cnt;
        }
        val started_ns: u64 = monotonic_ns();
        deliver_held(controls, runtime, index, now_ns);
        service_connection(controls, runtime, index, now, now_ns);
        runtime.crypto_budget = 0;
        runtime.unit_ns       = elapsed_since(started_ns);
        brk;
    }
    val arrivals_started_ns: u64 = monotonic_ns();
    if (advance_arrivals(controls, runtime, now, now_ns) == FAILED) {
        connection_failed(runtime);
    }
    charge_arrival_work(runtime, arrivals_started_ns);
    val promotion_started_ns: u64 = monotonic_ns();
    if (advance_pending_initials(controls, runtime, now, now_ns) == FAILED) {
        connection_failed(runtime);
    }
    if (runtime.crypto_budget == 0) {
        runtime.unit_ns = elapsed_since(promotion_started_ns);
    }
    ret status;
}

# the handshake admission counters, read every turn, so they cost no walk
pub fun admission_report(runtime: *Runtime) telemetry.HandshakeReport {
    var value: telemetry.HandshakeReport;
    if (runtime == nil || !runtime.initialized) { ret value; }
    value.in_flight        = runtime.handshakes_in_flight;
    value.service_ns       = runtime.service_ns;
    value.deferred         = runtime.handshakes_deferred;
    value.promoted         = runtime.handshakes_promoted;
    value.completed        = runtime.handshakes_completed;
    value.dropped          = runtime.handshakes_dropped;
    value.refused          = runtime.handshakes_refused;
    value.expired          = runtime.handshakes_expired;
    value.finish_ns        = runtime.finish_ns;
    value.retries_dropped  = runtime.stateless_dropped;
    value.arrivals_dropped = runtime.arrivals_dropped;
    ret value;
}

# Retry-token Initials refused at the replay bound since make
pub fun replay_full(runtime: *Runtime) u64 {
    if (runtime == nil || !runtime.initialized) { ret 0; }
    ret runtime.replay_full;
}

pub fun graceful_pump(controls: *ControlView, runtime: *Runtime, handle: PumpHandle,
    now_ns: u64) Status {
    val pump: *Pump = pump_for(controls, runtime, handle);
    if (pump == nil || now_ns == 0) { ret INVALID; }
    pump.draining = true;
    val active: usize = pump.active_admission;
    if (pump.admissions[active].live
        && (!begin_retire(?pump.admissions[active])
        || !cancel_pending_bank(controls, runtime, handle.index, active))) { ret FAILED; }
    var i: usize = runtime.live_head;
    for (i != NO_CONNECTION) {
        val value: *Connection = connection_at(controls, i);
        val next:  usize       = value.next_live;
        if (value.pump == handle.index
            && value.pump_generation == handle.generation) {
            if (value.state == CONNECTION_LIVE) {
                value.state = CONNECTION_GRACEFUL;
                mark_ready(controls, runtime, i);
                if (value.h3_session == h3_session.NO_SESSION
                    && !begin_transport_close(value, h3.H3_NO_ERROR, now_ns)) {
                    ret FAILED;
                }
            }
            # a handshake still running at drain cannot be served after it,
            # so it ends now rather than at its idle timeout
            or (value.state == CONNECTION_ACCEPTING) {
                fail_connection(controls, runtime, i, now_ns);
            }
        }
        i = next;
    }
    ret OK;
}

pub fun graceful_all(controls: *ControlView, runtime: *Runtime, now_ns: u64) Status {
    if (runtime == nil || !runtime.initialized || now_ns == 0) { ret INVALID; }
    var status: Status = OK;
    var i:      usize  = 0;
    for (i < MAX_PUMPS) {
        if (controls.pumps[i].live) {
            val applied: Status = graceful_pump(controls, runtime,
                PumpHandle{index: i,
                generation: controls.pumps[i].generation}, now_ns);
            if (applied != OK) { status = applied; }
        }
        i = i + 1;
    }
    ret status;
}

pub fun cancel_all(controls: *ControlView, runtime: *Runtime) Status {
    if (runtime == nil || !runtime.initialized) { ret INVALID; }
    val now_ns: u64    = monotonic_ns();
    var status: Status = OK;
    var i:      usize  = runtime.live_head;
    for (i != NO_CONNECTION) {
        val value: *Connection = connection_at(controls, i);
        val next:  usize       = value.next_live;
        if (value.state == CONNECTION_CLEANUP) {
            if (!cleanup_accepting(controls, runtime, i)) { status = FAILED; }
        }
        or (value.state == CONNECTION_FINALIZING) {
            if (finalize_connection(controls, runtime, i) == FAILED) { status = FAILED; }
        }
        or (value.state != CONNECTION_BROKEN) {
            fail_connection(controls, runtime, i, now_ns);
        }
        i = next;
    }
    i = 0;
    for (i < MAX_PUMPS) {
        val pump: *Pump = ?controls.pumps[i];
        if (pump.live) {
            pump.draining   = true;
            pump.cancelling = true;
            var bank: usize = 0;
            for (bank < ADMISSION_BANKS) {
                if (pump.admissions[bank].live
                    && (!begin_retire(?pump.admissions[bank])
                    || !cancel_pending_bank(controls, runtime, i, bank))) {
                    status = FAILED;
                }
                bank = bank + 1;
            }
        }
        i = i + 1;
    }
    ret status;
}

pub fun stop(controls: *ControlView, runtime: *Runtime, now_ns: u64) Status {
    if (runtime == nil || !runtime.initialized) { ret INVALID; }
    runtime.stopping = true;
    ret graceful_all(controls, runtime, now_ns);
}

fun stateless_pending(pump: *Pump) bool {
    ret pump.stateless_live != 0;
}

pub fun release_pump(controls: *ControlView, runtime: *Runtime, handle: PumpHandle) Status {
    val pump: *Pump = pump_for(controls, runtime, handle);
    if (pump == nil) { ret STALE; }
    if (!pump.draining || pump.active_connections != 0
        || pump.queued_initials != 0) { ret BLOCKED; }
    pump.cancelling = true;
    if (pump.scope_live && scope_active(?pump.storage.scope)) {
        transition_ok(cancel.cancel(?pump.storage.scope));
    }
    if (pump.receive_pending || stateless_pending(pump)) { ret BLOCKED; }
    var i: usize = 0;
    for (i < ADMISSION_BANKS) {
        val bank: *AdmissionGeneration = ?pump.admissions[i];
        if (bank.live) {
            if (!begin_retire(bank) || !reap_admission(bank)) { ret BLOCKED; }
        }
        i = i + 1;
    }
    if (pump.scope_live) {
        if (!operation_ok(cancel.destroy(?pump.storage.scope))) { ret BLOCKED; }
        pump.scope_live = false;
    }
    unqueue_completion(runtime, ?pump.storage.receive_context);
    ct.zeroize(?pump.token_key[0], token.KEY_SIZE);
    pump.driver        = nil;
    pump.socket        = nil;
    pump.root          = nil;
    pump.tls_policy    = nil;
    pump.plan          = nil;
    pump.budgets       = nil;
    pump.listener_name = nil;
    clear_pump_config(pump);
    if (!hedge_storage.destroy_table[StatelessSend](?pump.stateless)) { ret FAILED; }
    if (!destroy_arrivals(pump))                                      { ret FAILED; }
    pump.stateless_generation = 0;
    pump.stateless_pending    = NO_CONNECTION;
    pump.storage              = nil;
    pump.started              = false;
    pump.live                 = false;
    if (runtime.pump_count != 0) { runtime.pump_count = runtime.pump_count - 1; }
    ret OK;
}

pub fun release(controls: *ControlView, runtime: *Runtime) Status {
    if (runtime == nil || !runtime.initialized) { ret INVALID; }
    if (runtime.live_total != 0 || runtime.live_connections != 0
        || runtime.pending_initial_count != 0 || runtime.routes.len != 0) { ret BLOCKED; }
    var i: usize = 0;
    for (i < MAX_PUMPS) {
        if (controls.pumps[i].live) {
            val released: Status = release_pump(controls, runtime,
                PumpHandle{index: i,
                generation: controls.pumps[i].generation});
            if (released != OK) { ret released; }
        }
        i = i + 1;
    }
    if (runtime.sessions.live != 0 || runtime.pump_count != 0) { ret BLOCKED; }
    # each part is released once, so a refused release retries only what remains
    if ((runtime.connection_storages.live
        && !hedge_storage.destroy[ConnectionStorage](?runtime.connection_storages))
        || !hedge_storage.destroy_table[PendingInitial](?runtime.pending_initials)
        || (runtime.routes.initialized && !routing.destroy(?runtime.routes))
        || (runtime.sessions.storages.live && !h3_session.destroy_pool(?runtime.sessions))
        || (runtime.handshakes.initialized
        && !process_admission.destroy(?runtime.handshakes))
        || !hedge_storage.destroy_table[HeldDatagram](?runtime.held)) {
        ret FAILED;
    }
    # every record is back by now, since no connection is live; the secret tables
    # are owned and destroyed by composition, so nothing to free here
    runtime.admission   = nil;
    runtime.initialized = false;
    ret OK;
}

pub fun live(runtime: *Runtime) usize {
    if (runtime == nil || !runtime.initialized) { ret 0; }
    ret runtime.live_total;
}

pub fun superseded(controls: *ControlView, runtime: *Runtime) usize {
    if (runtime == nil || !runtime.initialized) { ret 0; }
    ret runtime.superseded_total;
}

pub fun budgets_in_use(controls: *ControlView, runtime: *Runtime, target: *budget.Set) bool {
    if (runtime == nil || !runtime.initialized || target == nil) { ret false; }
    var i: usize = runtime.live_head;
    for (i != NO_CONNECTION) {
        val value: *Connection = connection_at(controls, i);
        if (value.budgets == target) { ret true; }
        i = value.next_live;
    }
    i = runtime.pending_live_head;
    for (i != NO_CONNECTION) {
        val pending: *PendingInitial = pending_at(runtime, i);
        if (pending.config.budgets == target) { ret true; }
        i = pending.next_live;
    }
    ret false;
}

pub fun snapshot(controls: *ControlView, runtime: *Runtime) Snapshot {
    var value: Snapshot;
    if (runtime == nil || !runtime.initialized) { ret value; }
    value.pumps                = runtime.pump_count;
    value.live                 = runtime.live_total;
    value.superseded           = superseded(controls, runtime);
    value.routes               = runtime.routes.len;
    value.timers               = wheel.armed_count(runtime.timers);
    value.datagram_failures    = runtime.datagram_failures;
    value.connection_failures  = runtime.connection_failures;
    value.stateless_dropped    = runtime.stateless_dropped;
    value.arrivals_dropped     = runtime.arrivals_dropped;
    value.replay_full          = runtime.replay_full;
    value.handshakes_in_flight = runtime.handshakes_in_flight;
    value.handshakes_waiting   = runtime.deferred_count;
    value.handshakes_deferred  = runtime.handshakes_deferred;
    value.handshakes_promoted  = runtime.handshakes_promoted;
    value.handshakes_completed = runtime.handshakes_completed;
    value.handshakes_dropped   = runtime.handshakes_dropped;
    value.handshakes_refused   = runtime.handshakes_refused;
    value.handshakes_expired   = runtime.handshakes_expired;
    value.service_ns           = runtime.service_ns;
    value.finish_ns            = runtime.finish_ns;
    value.stopping             = runtime.stopping;
    value.initialized          = true;
    var i: usize = runtime.live_head;
    for (i != NO_CONNECTION) {
        if (connection_at(controls, i).state == CONNECTION_BROKEN) {
            value.broken = value.broken + 1;
        }
        i = connection_at(controls, i).next_live;
    }
    ret value;
}

fun test_policy(policy: *hedge_tls.Policy,
    protocols: *tls_config.ProtocolName, bytes: *u8) {
    protocols[0]                      = tls_config.ProtocolName{data: bytes, len: 2};
    policy.configuration.alpn         = protocols;
    policy.configuration.alpn_len     = 1;
    policy.configuration.require_alpn = true;
    policy.live                       = true;
}

fun test_pump_config(generation: u64, policy: *hedge_tls.Policy,
    selected_plan: *plan.Plan, budgets: *budget.Set) PumpConfig {
    var config: PumpConfig;
    config.admission_generation     = generation;
    config.connection_limit         = opt[usize].some{1};
    config.max_connections_per_peer = opt[usize].some{1};
    config.max_handshakes           = schema.DEFAULT_MAX_HANDSHAKES;
    config.max_handshakes_per_peer  = opt[usize].none{};
    config.receive_buffer_bytes     = schema.DEFAULT_QUIC_RECEIVE_BUFFER;
    config.require_retry            = false;
    config.retry_max_age_ns         = 1000000000;
    config.address_max_age_ns       = 1000000000;
    config.max_replay               = 64;
    config.tls_policy               = policy;
    config.tls_policy_index         = 0;
    config.plan                     = selected_plan;
    config.budgets                  = budgets;
    config.listener_budget          = budget.NO_BUDGET;
    config.max_requests             = 1;
    config.listener_name            = "quic-test";
    config.handshake_timeout_ns     = 1000000000;
    config.request_timeout_ns       = 1000000000;
    config.idle_timeout_ms          = 30000;
    config.drain_timeout_ns         = 1000000000;
    ret config;
}

# the caller-side owner of the runtime's welded records, as composition keeps it
rec TestControls {
    pumps:       [MAX_PUMPS]Pump;
    connections: hedge_storage.SecretTable[Connection];
    handshakes:  hedge_storage.SecretTable[server.Handshake];
    sessions:    hedge_storage.SecretTable[h3_session.Session];
    view:        ControlView;
    chunks:      hedge_storage.Chunks;
    memory:      memory.Memory;
    timers:      wheel.Wheel;
    wakes:       hedge_wake.Queue;
}

fun test_controls(fixture: *TestControls) *ControlView {
    hedge_storage.make_secret_table[Connection](?fixture.connections, test_allocator());
    hedge_storage.make_secret_table[server.Handshake](?fixture.handshakes, test_allocator());
    hedge_storage.make_secret_table[h3_session.Session](?fixture.sessions, test_allocator());
    hedge_storage.make_chunks(?fixture.chunks, test_allocator());
    wheel.make(?fixture.timers, test_allocator(), 1);
    hedge_wake.make(?fixture.wakes, test_allocator());
    memory.make(?fixture.memory, 64 * 1024 * 1024, test_allocator());
    fixture.view = ControlView{pumps: ?fixture.pumps[0],
        connections: ?fixture.connections,
        handshakes:  ?fixture.handshakes, sessions: ?fixture.sessions};
    ret ?fixture.view;
}

fun test_take_pending(runtime: *Runtime) *PendingInitial {
    val index: usize = free_pending_initial(runtime);
    if (index == NO_CONNECTION) { ret nil; }
    val pending: *PendingInitial = pending_at(runtime, index);
    ret pending;
}

fun test_make(fixture: *TestControls, runtime: *Runtime, backing: *A.Allocator) bool {
    ret make(?fixture.view, runtime,
        RuntimeConfig{backing: backing, chunks: ?fixture.chunks,
        memory: ?fixture.memory, timers: ?fixture.timers, wakes: ?fixture.wakes});
}

var test_backing:      A.Allocator;
var test_backing_live: bool;

fun test_allocator() *A.Allocator {
    if (!test_backing_live) {
        page.make(?test_backing);
        test_backing_live = true;
    }
    ret ?test_backing;
}

fun test_prepare_pump(runtime: *Runtime, pump: *Pump, storage: *PumpStorage,
    generation: u64, config: *PumpConfig) bool {
    pump.storage                = storage;
    pump.backing                = test_allocator();
    pump.generation             = generation;
    pump.token_generation       = 1;
    pump.live                   = true;
    pump.active_admission       = 0;
    pump.active_connections     = 0;
    pump.queued_initials        = 0;
    pump.draining               = false;
    pump.cancelling             = false;
    pump.admissions[0].live     = false;
    pump.admissions[0].retiring = false;
    pump.admissions[1].live     = false;
    pump.admissions[1].retiring = false;
    apply_pump_config(runtime, pump, config);
    if (!initialize_admission_inner(pump, 0, config, false)) {
        ret false;
    }
    # a prepared pump stands in for one that is receiving, so its active bank
    # is published exactly as start() would have left it
    pump.admissions[0].listener_published = true;
    ret true;
}

fun test_update_all(controls: *ControlView, runtime: *Runtime, updates: *PumpUpdate,
    count: usize) UpdateResult {
    ret update_transaction(controls, runtime, updates, count, true, false);
}

test "hedge.protocol.quic.runtime: production config validates identity" {
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var selected_plan: plan.Plan;
    selected_plan.generation = 1;
    selected_plan.sealed     = true;
    var budgets: budget.Set;
    var config:  PumpConfig = test_pump_config(1, ?policy,
        ?selected_plan, ?budgets);
    if (!pump_config_shape_valid(?config) || pump_config_valid(?config)) {
        ret 1;
    }
    config.listener_name = "";
    if (pump_config_shape_valid(?config)) { ret 2; }
    config.listener_name   = "quic-test";
    config.listener_budget = 0;
    if (pump_config_shape_valid(?config)) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: multi-pump update rolls back staging" {
    var control_pumps:   [MAX_PUMPS]Pump;
    var control_storage: ControlView;
    val controls:        *ControlView = ?control_storage;
    control_storage.pumps = ?control_pumps[0];
    var runtime:  Runtime;
    var storages: [2]PumpStorage;
    runtime.live_head         = NO_CONNECTION;
    runtime.pending_live_head = NO_CONNECTION;
    runtime.initialized       = true;
    runtime.pump_count        = 2;
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var selected_plan: plan.Plan;
    selected_plan.generation = 1;
    selected_plan.sealed     = true;
    var budgets:   budget.Set;
    val first_old: PumpConfig = test_pump_config(10, ?policy,
        ?selected_plan, ?budgets);
    val second_old: PumpConfig = test_pump_config(20, ?policy,
        ?selected_plan, ?budgets);
    val first_new: PumpConfig = test_pump_config(11, ?policy,
        ?selected_plan, ?budgets);
    val second_new: PumpConfig = test_pump_config(21, ?policy,
        ?selected_plan, ?budgets);
    if (!test_prepare_pump(?runtime, ?controls.pumps[0], ?storages[0], 1, ?first_old)
        || !test_prepare_pump(?runtime, ?controls.pumps[1], ?storages[1], 2, ?second_old)) { ret 1; }
    # the second pump cannot grow a bank, so staging the first must roll back
    controls.pumps[1].backing = nil;
    var updates: [2]PumpUpdate;
    updates[0] = PumpUpdate{handle: PumpHandle{index: 0, generation: 1},
        config: first_new};
    updates[1] = PumpUpdate{handle: PumpHandle{index: 1, generation: 2},
        config: second_new};
    val updated: UpdateResult = test_update_all(controls, ?runtime, ?updates[0], 2);
    if (updated.status != FAILED || updated.committed
        || updated.rollback_failed
        || controls.pumps[0].active_admission != 0
        || controls.pumps[1].active_admission != 0
        || controls.pumps[0].admissions[1].live
        || controls.pumps[0].admissions[0].retiring
        || controls.pumps[1].admissions[0].retiring) { ret 2; }
    if (!begin_retire(?controls.pumps[0].admissions[0])
        || !reap_admission(?controls.pumps[0].admissions[0])
        || !begin_retire(?controls.pumps[1].admissions[0])
        || !reap_admission(?controls.pumps[1].admissions[0])) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: failed rollback is fatal before commit" {
    var control_pumps:   [MAX_PUMPS]Pump;
    var control_storage: ControlView;
    val controls:        *ControlView = ?control_storage;
    control_storage.pumps = ?control_pumps[0];
    var runtime: Runtime;
    var storage: PumpStorage;
    runtime.live_head         = NO_CONNECTION;
    runtime.pending_live_head = NO_CONNECTION;
    runtime.initialized       = true;
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var selected_plan: plan.Plan;
    selected_plan.generation = 1;
    selected_plan.sealed     = true;
    var budgets:    budget.Set;
    val old_config: PumpConfig = test_pump_config(10, ?policy,
        ?selected_plan, ?budgets);
    val new_config: PumpConfig = test_pump_config(11, ?policy,
        ?selected_plan, ?budgets);
    if (!test_prepare_pump(?runtime, ?controls.pumps[0], ?storage, 1, ?old_config)
        || !initialize_admission_inner(?controls.pumps[0], 1, ?new_config,
        false)) { ret 1; }
    controls.pumps[0].admissions[1].listener.closing = true;
    var update: [1]PumpUpdate;
    update[0] = PumpUpdate{handle: PumpHandle{index: 0, generation: 1},
        config: new_config};
    var staged: [1]bool;
    staged[0] = true;
    val result: UpdateResult = rollback_result(controls, ?runtime, ?update[0], 1,
        ?staged[0], FAILED);
    if (result.status != FAILED || result.committed
        || !result.rollback_failed || !controls.pumps[0].admissions[1].live) {
        ret 2;
    }
    controls.pumps[0].admissions[1].listener.closing = false;
    if (!begin_retire(?controls.pumps[0].admissions[0])
        || !reap_admission(?controls.pumps[0].admissions[0])
        || !begin_retire(?controls.pumps[0].admissions[1])
        || !reap_admission(?controls.pumps[0].admissions[1])) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: update reports committed retirement failure" {
    var control_pumps:   [MAX_PUMPS]Pump;
    var control_storage: ControlView;
    val controls:        *ControlView = ?control_storage;
    control_storage.pumps = ?control_pumps[0];
    var runtime: Runtime;
    var storage: PumpStorage;
    runtime.live_head         = NO_CONNECTION;
    runtime.pending_live_head = NO_CONNECTION;
    runtime.initialized       = true;
    runtime.pump_count        = 1;
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var old_plan: plan.Plan;
    old_plan.generation = 1;
    old_plan.sealed     = true;
    var new_plan: plan.Plan;
    new_plan.generation = 2;
    new_plan.sealed     = true;
    var budgets:    budget.Set;
    val old_config: PumpConfig = test_pump_config(40, ?policy,
        ?old_plan, ?budgets);
    val new_config: PumpConfig = test_pump_config(41, ?policy,
        ?new_plan, ?budgets);
    if (!test_prepare_pump(?runtime, ?controls.pumps[0], ?storage, 5, ?old_config)) { ret 1; }
    controls.pumps[0].admissions[0].listener.closing = true;
    var updates: [1]PumpUpdate;
    updates[0] = PumpUpdate{handle: PumpHandle{index: 0, generation: 5},
        config: new_config};
    val updated: UpdateResult = test_update_all(controls, ?runtime, ?updates[0], 1);
    if (updated.status != FAILED || !updated.committed
        || updated.rollback_failed
        || controls.pumps[0].active_admission != 1
        || controls.pumps[0].plan != ?new_plan
        || !controls.pumps[0].admissions[1].live
        || controls.pumps[0].admissions[0].retiring) { ret 2; }
    controls.pumps[0].admissions[0].listener.closing = false;
    if (!begin_retire(?controls.pumps[0].admissions[0])
        || !reap_admission(?controls.pumps[0].admissions[0])
        || !begin_retire(?controls.pumps[0].admissions[1])
        || !reap_admission(?controls.pumps[0].admissions[1])) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: update gracefully retires superseded" {
    var fixture:      TestControls;
    val controls:     *ControlView = test_controls(?fixture);
    var runtime:      Runtime;
    var pump_storage: PumpStorage;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    runtime.pump_count = 1;
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var old_plan: plan.Plan;
    old_plan.generation = 1;
    old_plan.sealed     = true;
    var new_plan: plan.Plan;
    new_plan.generation = 2;
    new_plan.sealed     = true;
    var old_budgets: budget.Set;
    var new_budgets: budget.Set;
    val old_config:  PumpConfig = test_pump_config(30, ?policy,
        ?old_plan, ?old_budgets);
    val new_config: PumpConfig = test_pump_config(31, ?policy,
        ?new_plan, ?new_budgets);
    if (!test_prepare_pump(?runtime, ?controls.pumps[0], ?pump_storage, 4, ?old_config)) { ret 1; }
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (index != 0) { ret 2; }
    val connection: *Connection = connection_at(controls, index);
    connection.plan  = ?old_plan;
    connection.state = CONNECTION_LIVE;
    var updates: [1]PumpUpdate;
    updates[0] = PumpUpdate{handle: PumpHandle{index: 0, generation: 4},
        config: new_config};
    val updated: UpdateResult = test_update_all(controls, ?runtime, ?updates[0], 1);
    if (updated.status != OK || !updated.committed
        || updated.rollback_failed
        || controls.pumps[0].active_admission != 1
        || !controls.pumps[0].admissions[0].retiring
        || connection.state != CONNECTION_GRACEFUL
        || superseded(controls, ?runtime) != 1) { ret 2; }
    return_connection(controls, ?runtime, index);
    if (!reap_admission(?controls.pumps[0].admissions[0])
        || superseded(controls, ?runtime) != 0
        || !begin_retire(?controls.pumps[0].admissions[1])
        || !reap_admission(?controls.pumps[0].admissions[1])) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: failed assembly init returns capacity" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (index != 0) { ret 2; }
    val value: *Connection = connection_at(controls, index);

    var owner:    secret.Allocator = secret.system_allocator();
    var chain:    [1]cert.Certificate;
    var key:      keys.PrivateKey;
    var identity: credentials.Identity;
    if (!test_credentials.load_credentials(?identity, ?chain[0], ?key,
        ?owner)) { ret 3; }
    var generation: credentials.Generation = credentials.empty_generation();
    var store:      credentials.Store      = credentials.empty_store();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK
        || credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }
    var protocol_bytes: [2]u8                      = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName = [1]tls_config.ProtocolName{
        tls_config.ProtocolName{data: ?protocol_bytes[0], len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite = [1]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256
    };
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme = [1]tls13.SignatureScheme{
        tls13.ED25519
    };
    var entropy:           secret.Entropy = secret.system_entropy();
    var tls_configuration: tls_config.ServerConfig;
    tls_configuration.credentials          = ?store;
    tls_configuration.alpn                 = ?protocols[0];
    tls_configuration.alpn_len             = 1;
    tls_configuration.require_alpn         = true;
    tls_configuration.versions             = ?versions[0];
    tls_configuration.version_len          = 1;
    tls_configuration.suites               = ?suites[0];
    tls_configuration.suite_len            = 1;
    tls_configuration.groups               = ?groups[0];
    tls_configuration.group_len            = 1;
    tls_configuration.signatures           = ?signatures[0];
    tls_configuration.signature_len        = 1;
    tls_configuration.entropy              = ?entropy;
    tls_configuration.entropy_context_size = 0;
    tls_configuration.limits               = hedge_tls.listener_limits();
    var tls_clock_source: tls_clock.Source = tls_clock.system();
    tls_configuration.clock = ?tls_clock_source;
    value.handshake         = claim_handshake(controls);
    if (value.handshake == NO_HANDSHAKE) { ret 4; }
    val engine:       *server.Handshake = handshake_at(controls, value.handshake);
    var conn_budgets: memory.Budgets    = memory.no_budgets();
    memory.borrower(?value.storage.borrower, ?fixture.memory, timer_owner(index),
        memory.LANES, conn_budgets);

    var local_id:   [8]u8           = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var peer_id:    [8]u8           = [8]u8{9, 10, 11, 12, 13, 14, 15, 16};
    var initial_id: [8]u8           = [8]u8{17, 18, 19, 20, 21, 22, 23, 24};
    val local:      ip.Endpoint     = ip.endpoint(192, 0, 2, 1, 4433);
    val peer:       ip.Endpoint     = ip.endpoint(192, 0, 2, 2, 55000);
    var config:     assembly.Config = assembly.default_config(81, local, peer);
    config.local_source         = ?local_id[0];
    config.local_source_length  = 8;
    config.alpn                 = ?protocol_bytes[0];
    config.alpn_length          = 2;
    config.entropy_context_size = 0;
    config.account_handle       = timer_owner(index);
    config.extra_budgets        = ?conn_budgets.lanes[quic_supply.LANES::usize];
    config.extra_lanes          = memory.LANES::usize - quic_supply.LANES::usize;
    var accepted: quic_listener.Accepted;
    accepted.action = quic_listener.ACTION_ACCEPT;
    packet.set_connection_id(?accepted.original_destination, ?initial_id[0], 8);
    packet.set_connection_id(?accepted.initial_destination, ?initial_id[0], 8);
    packet.set_connection_id(?accepted.initial_source, ?peer_id[0], 8);
    accepted.peer           = peer;
    accepted.version        = packet.VERSION_1;
    accepted.peer_validated = true;
    if (!assembly.apply_server_acceptance(?config, ?accepted)) { ret 4; }
    val encoded: transport_parameters.EncodeResult =
        assembly.encode_parameters(?config, qt.SERVER,
        ?value.storage.local_parameters[0], assembly.PARAMETER_CAPACITY);
    if (!encoded.ok || !server.init(engine, ?tls_configuration,
        assembly.tls_lease(?value.assembly),
        server.ExtraExtension{kind: server.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{
        data: ?value.storage.local_parameters[0],
        len:  encoded.count
    }},
        server.QUIC_TRANSPORT_PARAMETERS)
        || !operation_ok(cancel.make_root(?value.storage.scope,
        opt[time.Instant].none{}))) { ret 5; }
    value.scope_live = true;
    cancel.cancel(?value.storage.scope);
    # this pump has no storage attached, so the public scratch is the test's
    var scratch:     assembly.Scratch;
    val initialized: assembly.InitResult = assembly.init_server(
        ?value.assembly, ?config, ?value.storage.assembly_storage,
        ?scratch, ?controls.pumps[0].secret_scratch,
        memory.borrowed_source(?value.storage.borrower), engine,
        ?value.storage.scope, clock.from_ns(1));
    if (initialized.ok) { ret 6; }
    if (initialized.stage != assembly.STAGE_DRIVER) {
        ret (20 + initialized.stage::usize)::i32;
    }
    if (!assembly.reusable(?value.assembly)) { ret 7; }
    value.state              = CONNECTION_CLEANUP;
    value.tls_live           = true;
    value.assembly_attempted = true;
    if (!cleanup_accepting(controls, ?runtime, index)) { ret 8; }
    # freeing the only connection compacts its chunk and its handshake away, so
    # the record pointer is gone rather than merely cleared
    if (runtime.live_connections != 0 || connection_at(controls, index) != nil
        || hedge_storage.secret_table_capacity[server.Handshake](
        controls.handshakes) != 0) { ret 9; }
    val reused: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (reused != index || runtime.live_connections != 1
        || connection_at(controls, reused).storage == nil) { ret 10; }
    return_connection(controls, ?runtime, reused);
    var retired: *credentials.Generation = nil;
    if (credentials.withdraw_store(?store, ?retired) != contracts.OK
        || retired != ?generation || !credentials.reclaimable(?generation)
        || keys.destroy_private(?key) != contracts.OK) { ret 11; }
    ret 0;
}

test "hedge.protocol.quic.runtime: stale completion generations are inert" {
    var control_pumps:   [MAX_PUMPS]Pump;
    var control_storage: ControlView;
    val controls:        *ControlView = ?control_storage;
    control_storage.pumps = ?control_pumps[0];
    var runtime: Runtime;
    runtime.live_head         = NO_CONNECTION;
    runtime.pending_live_head = NO_CONNECTION;
    runtime.initialized       = true;
    var context: CompletionContext;
    context.pump                 = 0;
    context.pump_generation      = 9;
    context.kind                 = COMPLETION_RECEIVE;
    controls.pumps[0].live       = true;
    controls.pumps[0].generation = 10;
    if (context_current(controls, ?runtime, ?context)) { ret 1; }
    context.pump_generation = 10;
    if (!context_current(controls, ?runtime, ?context)) { ret 2; }
    ret 0;
}

test "hedge.protocol.quic.runtime: budget generation remains pinned by quic work" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var first:    budget.Set;
    var second:   budget.Set;
    if (!test_make(?fixture, ?runtime, test_allocator())
        || hedge_storage.secret_table_claim[Connection](controls.connections) == NO_CONNECTION
        || !hedge_storage.grow_table[PendingInitial](?runtime.pending_initials)) { ret 90; }
    reset_connection(connection_at(controls, 0));
    reset_pending_initial(?runtime, 0);
    val connection: *Connection     = connection_at(controls, 0);
    val pending:    *PendingInitial = pending_at(?runtime, 0);
    connection.live    = true;
    connection.budgets = ?first;
    link_live(controls, ?runtime, 0);
    if (!budgets_in_use(controls, ?runtime, ?first)
        || budgets_in_use(controls, ?runtime, ?second)) { ret 1; }
    connection.live = false;
    unlink_live(controls, ?runtime, 0);
    pending.live = true;
    link_pending_live(?runtime, 0);
    pending.config.budgets = ?second;
    if (budgets_in_use(controls, ?runtime, ?first)
        || !budgets_in_use(controls, ?runtime, ?second)) { ret 2; }
    pending.live = false;
    unlink_pending_live(?runtime, 0);
    if (budgets_in_use(controls, ?runtime, ?second)) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: pending initial owns a private packet copy" {
    var pending:  PendingInitial;
    var bytes:    [4]u8 = [4]u8{1, 2, 3, 4};
    var received: net_types.Packet;
    received.buffer                = ?bytes[0];
    received.capacity              = 4;
    received.length                = 4;
    received.peer                  = ip.endpoint(192, 0, 2, 1, 4000);
    received.interface_index       = 7;
    received.has_local_destination = true;
    if (!copy_pending_packet(?pending, ?received)) { ret 1; }
    bytes[0] = 99;
    val copied: net_types.Packet = pending_packet(?pending);
    if (copied.buffer == received.buffer || copied.length != 4
        || copied.buffer[0] != 1 || copied.buffer[3] != 4
        || copied.peer.port != 4000 || copied.interface_index != 7
        || !copied.has_local_destination) { ret 2; }
    ret 0;
}

test "hedge.protocol.quic.runtime: pending transfer preserves old generation" {
    var fixture:     TestControls;
    val controls:    *ControlView = test_controls(?fixture);
    var runtime:     Runtime;
    var old_plan:    plan.Plan;
    var new_plan:    plan.Plan;
    var old_budgets: budget.Set;
    old_plan.generation = 1;
    new_plan.generation = 2;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_take_pending(?runtime);
    if (pending == nil) { ret 91; }
    controls.pumps[0].live             = true;
    controls.pumps[0].generation       = 4;
    controls.pumps[0].active_admission = 1;
    controls.pumps[0].plan             = ?new_plan;
    val lease: process_admission.Lease =
        process_admission.Lease{index: 0, generation: 1};
    val index: usize = acquire_connection(controls, ?runtime, 0, 0, lease);
    pending.live = true;
    link_pending_live(?runtime, 0);
    pending.pump                                    = 0;
    pending.admission_bank                          = 0;
    pending.accepted.charge.source                  = 20;
    pending.accepted.charge.index                   = 3;
    pending.accepted.charge.generation              = 5;
    pending.lease                                   = lease;
    pending.q_charge_live                           = true;
    pending.lease_live                              = true;
    pending.config.plan                             = ?old_plan;
    pending.config.budgets                          = ?old_budgets;
    runtime.pending_initial_count                   = 1;
    runtime.live_total                              = runtime.live_total + 1;
    controls.pumps[0].queued_initials               = 1;
    controls.pumps[0].admissions[0].queued_initials = 1;
    val value: *Connection = connection_at(controls, index);
    value.plan = pending.config.plan;
    if (index != 0 || !transfer_pending_ownership(pending, ?pending.accepted, value)) { ret 1; }
    value.state = CONNECTION_LIVE;
    mark_connection_superseded(controls, ?runtime, index);
    take_pending_initial(controls, ?runtime, 0);
    if (pending.live || pending.config.plan != nil
        || pending.config.budgets != nil || runtime.pending_initial_count != 0
        || runtime.live_total != 1 || controls.pumps[0].queued_initials != 0
        || controls.pumps[0].admissions[0].queued_initials != 0
        || !value.charge_live || value.charge.source != 20
        || !value.lease_live || value.state != CONNECTION_GRACEFUL) { ret 2; }
    value.charge_live = false;
    value.lease_live  = false;
    free_connection(controls, ?runtime, index);
    ret 0;
}

# queue `waiting` as pending initial 0 the way enqueue_initial does
fun test_queue_pending(controls: *ControlView, runtime: *Runtime,
    budgets: *budget.Set, waiting: *budget.Charge) *PendingInitial {
    val pending: *PendingInitial = test_take_pending(runtime);
    if (pending == nil || !claim_pending_timer(runtime, 0, false, waiting)) { ret nil; }
    runtime.pending_initial_count                   = 1;
    runtime.live_total                              = 1;
    controls.pumps[0].live                          = true;
    controls.pumps[0].generation                    = 2;
    controls.pumps[0].queued_initials               = 1;
    controls.pumps[0].admissions[0].live            = true;
    controls.pumps[0].admissions[0].queued_initials = 1;
    pending.live                                    = true;
    link_pending_live(runtime, 0);
    pending.pump            = 0;
    pending.pump_generation = 2;
    pending.admission_bank  = 0;
    pending.config.budgets  = budgets;
    take_pending_charge(runtime, 0, budgets, waiting);
    pending.budget_charge_live = true;
    ret pending;
}

test "hedge.protocol.quic.runtime: a queued initial is left alone until its deadline fires" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var items:    [1]budget.Budget;
    var budgets:  budget.Set;
    if (!budget.make(?budgets, ?items[0], 1)) { ret 1; }
    val allowance: usize = budget.define(?budgets, "quic", 1, 1,
        3000000000, 0);
    var running: budget.Charge;
    var waiting: budget.Charge;
    if (budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?running, hedge_wake.no_waker()) != budget.ADMITTED
        || budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?waiting, hedge_wake.no_waker()) != budget.QUEUED) { ret 2; }
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_queue_pending(controls, ?runtime, ?budgets, ?waiting);
    if (pending == nil) { ret 91; }
    var owners: [4]u64;
    if (!wheel.armed(?fixture.timers, pending.timer) || has_ready(?runtime)
        || wheel.advance(?fixture.timers, 2999999999, ?owners[0], 4) != 0) { ret 3; }
    # nothing woke it, so a turn past its deadline does not look at it
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 4, nsec: 0}, 4000000000) != OK
        || !pending.live || items[0].expired != 0) { ret 4; }
    if (wheel.advance(?fixture.timers, 4000000000, ?owners[0], 4) != 1
        || !owns(owners[0])) { ret 5; }
    fire(controls, ?runtime, owners[0], 4000000000);
    if (!has_ready(?runtime)) { ret 6; }
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 4, nsec: 0}, 4000000000) != OK
        || pending.live || runtime.pending_initial_count != 0
        || runtime.live_total != 0 || items[0].waiting != 0
        || items[0].expired != 1 || has_ready(?runtime)
        || wheel.armed_count(?fixture.timers) != 0) { ret 7; }
    if (!budget.release(?budgets, ?running)) { ret 8; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a budget release wakes the initial queued behind it" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var items:    [1]budget.Budget;
    var budgets:  budget.Set;
    if (!budget.make(?budgets, ?items[0], 1)) { ret 1; }
    val allowance: usize = budget.define(?budgets, "quic", 1, 1, 0, 0);
    var running:   budget.Charge;
    var waiting:   budget.Charge;
    if (budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?running, hedge_wake.no_waker()) != budget.ADMITTED
        || budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?waiting, hedge_wake.no_waker()) != budget.QUEUED) { ret 2; }
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_queue_pending(controls, ?runtime, ?budgets, ?waiting);
    if (pending == nil)                                                 { ret 91; }
    if (wheel.armed_count(?fixture.timers) != 0 || has_ready(?runtime)) { ret 3; }
    if (!budget.release(?budgets, ?running)
        || pending.budget_charge.outcome != budget.ADMITTED) { ret 4; }
    var owners: [4]u64;
    if (hedge_wake.take(?fixture.wakes, ?owners[0], 4) != 1 || !owns(owners[0])) { ret 5; }
    wake(controls, ?runtime, owners[0]);
    if (!pending.ready || runtime.pending_ready_head != 0) { ret 6; }
    # the pump went away meanwhile, so the woken initial is released, not admitted
    controls.pumps[0].live = false;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 1, nsec: 0}, 1000000000) != OK
        || pending.live || has_ready(?runtime) || items[0].active != 0) { ret 7; }
    ret 0;
}

test "hedge.protocol.quic.runtime: accepting cleanup retries shared lease" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var manager:  process_admission.Manager;
    if (!process_admission.make(?manager, test_allocator(),
        opt[usize].some{1}, opt[usize].some{1})) { ret 1; }
    var lease: process_admission.Lease;
    if (!process_admission.reserve(?manager, nil, ?lease)
        || !process_admission.commit(?manager, lease)) { ret 2; }
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    runtime.admission = ?manager;
    val index: usize = acquire_connection(controls, ?runtime, 0, 0, lease);
    if (index == NO_CONNECTION) { ret 91; }
    val connection: *Connection = connection_at(controls, index);
    connection.state  = CONNECTION_CLEANUP;
    runtime.admission = nil;
    if (cleanup_accepting(controls, ?runtime, index) || !connection.live
        || !connection.lease_live || process_admission.in_use(?manager) != 1) {
        ret 3;
    }
    runtime.admission = ?manager;
    # the retry frees the only connection, compacting its chunk away
    if (!cleanup_accepting(controls, ?runtime, index)
        || connection_at(controls, index) != nil
        || process_admission.in_use(?manager) != 0) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.runtime: pending cleanup retries each lease once" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var manager:  process_admission.Manager;
    if (!process_admission.make(?manager, test_allocator(),
        opt[usize].some{1}, opt[usize].some{1})) { ret 1; }
    var lease: process_admission.Lease;
    if (!process_admission.acquire(?manager, nil, ?lease)) { ret 2; }
    var items:   [1]budget.Budget;
    var budgets: budget.Set;
    budget.make(?budgets, ?items[0], 1);
    val allowance: usize = budget.define(?budgets, "quic", 1, 1,
        1000000000, 0);
    var running: budget.Charge;
    var waiting: budget.Charge;
    budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?running, hedge_wake.no_waker());
    budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?waiting, hedge_wake.no_waker());
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_take_pending(?runtime);
    if (pending == nil) { ret 91; }
    runtime.pending_initial_count                   = 1;
    runtime.live_total                              = 1;
    controls.pumps[0].live                          = true;
    controls.pumps[0].queued_initials               = 1;
    controls.pumps[0].admissions[0].live            = true;
    controls.pumps[0].admissions[0].queued_initials = 1;
    pending.live                                    = true;
    link_pending_live(?runtime, 0);
    pending.pump           = 0;
    pending.admission_bank = 0;
    pending.config.budgets = ?budgets;
    budget.relocate(?budgets, ?pending.budget_charge, ?waiting);
    pending.budget_charge_live = true;
    pending.lease              = lease;
    pending.lease_live         = true;
    if (release_pending_initial(controls, ?runtime, 0) || !pending.live
        || pending.budget_charge_live || !pending.lease_live
        || items[0].waiting != 0
        || process_admission.in_use(?manager) != 1) { ret 3; }
    runtime.admission = ?manager;
    if (!release_pending_initial(controls, ?runtime, 0) || pending.live
        || runtime.pending_initial_count != 0 || runtime.live_total != 0
        || items[0].waiting != 0
        || process_admission.in_use(?manager) != 0) { ret 4; }
    if (!budget.release(?budgets, ?running)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: shutdown cancels queued ownership" {
    var fixture:      TestControls;
    val controls:     *ControlView = test_controls(?fixture);
    var runtime:      Runtime;
    var pump_storage: PumpStorage;
    var manager:      process_admission.Manager;
    if (!process_admission.make(?manager, test_allocator(),
        opt[usize].some{1}, opt[usize].some{1})) { ret 1; }
    var lease: process_admission.Lease;
    if (!process_admission.reserve(?manager, nil, ?lease)
        || !process_admission.commit(?manager, lease)) { ret 2; }
    var items:   [1]budget.Budget;
    var budgets: budget.Set;
    budget.make(?budgets, ?items[0], 1);
    val allowance: usize = budget.define(?budgets, "quic", 1, 1,
        1000000000, 0);
    var running: budget.Charge;
    var waiting: budget.Charge;
    budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?running, hedge_wake.no_waker());
    budget.charge(?budgets, allowance, 0,
        time.Instant{sec: 0, nsec: 0}, ?waiting, hedge_wake.no_waker());
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var selected_plan: plan.Plan;
    selected_plan.generation = 1;
    selected_plan.sealed     = true;
    val config: PumpConfig = test_pump_config(1, ?policy,
        ?selected_plan, ?budgets);
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_take_pending(?runtime);
    if (pending == nil) { ret 91; }
    runtime.admission             = ?manager;
    runtime.pending_initial_count = 1;
    runtime.live_total            = 1;
    runtime.pump_count            = 1;
    if (!test_prepare_pump(?runtime, ?controls.pumps[0], ?pump_storage, 1, ?config)) { ret 3; }
    controls.pumps[0].queued_initials               = 1;
    controls.pumps[0].admissions[0].queued_initials = 1;
    pending.live                                    = true;
    link_pending_live(?runtime, 0);
    pending.pump            = 0;
    pending.pump_generation = 1;
    pending.admission_bank  = 0;
    pending.config.budgets  = ?budgets;
    budget.relocate(?budgets, ?pending.budget_charge, ?waiting);
    pending.budget_charge_live = true;
    pending.lease              = lease;
    pending.lease_live         = true;
    if (cancel_all(controls, ?runtime) != OK || pending.live
        || runtime.pending_initial_count != 0 || runtime.live_total != 0
        || controls.pumps[0].queued_initials != 0
        || controls.pumps[0].admissions[0].live
        || process_admission.in_use(?manager) != 0
        || items[0].waiting != 0) { ret 4; }
    if (!budget.release(?budgets, ?running)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: queued old generation pins retirement" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var old_plan: plan.Plan;
    var new_plan: plan.Plan;
    old_plan.generation = 1;
    new_plan.generation = 2;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_take_pending(?runtime);
    if (pending == nil) { ret 91; }
    controls.pumps[0].live                          = true;
    controls.pumps[0].generation                    = 1;
    controls.pumps[0].active_admission              = 1;
    controls.pumps[0].plan                          = ?new_plan;
    controls.pumps[0].admissions[0].live            = true;
    controls.pumps[0].admissions[0].retiring        = true;
    controls.pumps[0].admissions[0].queued_initials = 1;
    pending.live                                    = true;
    link_pending_live(?runtime, 0);
    pending.pump            = 0;
    pending.pump_generation = 1;
    pending.admission_bank  = 0;
    pending.config.plan     = ?old_plan;
    # the swap that left the pump on the new plan is the mark
    mark_superseded_graceful(controls, ?runtime);
    if (superseded(controls, ?runtime) != 1
        || reap_admission(?controls.pumps[0].admissions[0])) { ret 1; }
    take_pending_initial(controls, ?runtime, 0);
    if (superseded(controls, ?runtime) != 0) { ret 2; }
    ret 0;
}

test "hedge.protocol.quic.runtime: copied route ownership retires exactly once" {
    var runtime: Runtime;
    if (!routing.make(?runtime.routes, test_allocator())) { ret 1; }
    var bytes:     [4]u8 = [4]u8{1, 2, 3, 4};
    var published: PublishedRoute;
    published.key     = routing.key(?bytes[0], 4);
    published.binding = routing.Binding{connection_slot: 0,
        connection_generation: 1, route_index: 0, route_generation: 1,
        route_sequence:        1, pump_generation: 1};
    if (routing.publish(?runtime.routes, published.key,
        published.binding) != routing.ROUTE_OK) { ret 2; }
    published.live = true;
    bytes[0]       = 99;
    if (!unpublish_route(?runtime, ?published) || published.live
        || runtime.routes.len != 0 || !unpublish_route(?runtime, ?published)
        || !routing.destroy(?runtime.routes)) {
        ret 3;
    }
    ret 0;
}

test "hedge.protocol.quic.runtime: a connection adopts the id the client addressed" {
    var storage: ConnectionStorage;
    var value:   Connection;
    value.storage = ?storage;
    var accepted: quic_listener.Accepted;
    var id:       [CONNECTION_ID_BYTES]u8;
    var i:        usize = 0;
    for (i < CONNECTION_ID_BYTES) {
        id[i] = (i + 1)::u8;
        i     = i + 1;
    }
    if (!packet.set_connection_id(?accepted.initial_destination, ?id[0],
        CONNECTION_ID_BYTES)) { ret 1; }
    # the client sends to the id the server named in its Retry, so the routing
    # id must be that value and not a second one nothing is addressed to
    if (!adopt_local_cid(?value, ?accepted)) { ret 2; }
    i = 0;
    for (i < CONNECTION_ID_BYTES) {
        if (value.storage.local_cid[i] != id[i]) { ret 3; }
        i = i + 1;
    }
    # short headers are parsed at one fixed local length, so any other length is
    # refused rather than published as a route that mis-parses
    if (!packet.set_connection_id(?accepted.initial_destination, ?id[0], 8)) {
        ret 4;
    }
    if (adopt_local_cid(?value, ?accepted)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a connection drains faster than the process" {
    # the connection close period was sourced from the process drain budget, so
    # every finished connection stayed live for that whole budget and shutdown
    # always waited it out. a connection has to let go first.
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    if (CONNECTION_DRAIN_NS == 0)                                 { ret 1; }
    if (graph.timeouts.drain_ms == 0)                             { ret 2; }
    if (CONNECTION_DRAIN_NS >= graph.timeouts.drain_ms * 1000000) { ret 3; }
    ret 0;
}

# an idle QUIC listener must not be resident in the connection storage it is
# not using: a slot's storage is half a megabyte, so it exists only while a
# connection holds it, and a freed slot gives it back
test "hedge.protocol.quic.runtime: an idle runtime holds no connection storage" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    if (hedge_storage.secret_table_capacity[Connection](controls.connections) != 0 || hedge_storage.secret_table_capacity[h3_session.Session](controls.sessions) != 0
        || hedge_storage.table_capacity[PendingInitial](?runtime.pending_initials) != 0 || runtime.routes.capacity != 0
        || fixture.timers.entries.slab.capacity != 0
        || hedge_storage.held[ConnectionStorage](?runtime.connection_storages) != 0) {
        ret 2;
    }
    val taken: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    val value: *Connection = connection_at(controls, taken);
    if (taken != 0 || value == nil || value.storage == nil
        || hedge_storage.held[ConnectionStorage](?runtime.connection_storages) != 1
        || connection_at(controls, 1).storage != nil) { ret 3; }
    val storage: *ConnectionStorage = value.storage;
    # marks a stale owner left behind, which arming the storage has to clear
    storage.sends[0].pending                    = true;
    storage.sends[0].context.completion_pending = true;
    storage.published[0].live                   = true;
    return_connection(controls, ?runtime, taken);
    # releasing the only connection compacts its record away; its half-megabyte
    # storage returns to the pool for the next claim
    if (connection_at(controls, taken) != nil
        || hedge_storage.held[ConnectionStorage](?runtime.connection_storages) != 0) { ret 4; }
    val again: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    val rearmed: *Connection = connection_at(controls, again);
    if (again != taken || rearmed == nil || rearmed.storage != storage
        || storage.sends[0].pending || storage.sends[0].context.completion_pending
        || storage.published[0].live) { ret 5; }
    return_connection(controls, ?runtime, again);
    if (release(controls, ?runtime) != OK) { ret 6; }
    ret 0;
}

# a QUIC connection is pinned by io completion contexts, its cancel scope, the
# assembly connection and its h3 session, so growth appends and moves nothing
test "hedge.protocol.quic.runtime: the pool grows past its first chunk and moves nothing" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    val count:   usize = hedge_storage.FIRST_CHUNK * 3 + 1;
    var taken:   [49]usize;
    var records: [49]*Connection;
    var i:       usize = 0;
    for (i < count) {
        taken[i] = acquire_connection(controls, ?runtime, 0, 0,
            process_admission.no_lease());
        if (taken[i] != i) { ret 2; }
        records[i] = connection_at(controls, i);
        if (records[i].storage == nil) { ret 3; }
        i = i + 1;
    }
    if (runtime.live_connections != count || live_walk_length(controls, ?runtime) != count
        || hedge_storage.secret_table_capacity[Connection](controls.connections) < count) { ret 4; }
    i = 0;
    for (i < count) {
        if (connection_at(controls, i) != records[i]) { ret 5; }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (!return_connection(controls, ?runtime, taken[i])) { ret 6; }
        i = i + 1;
    }
    if (runtime.live_connections != 0
        || hedge_storage.held[ConnectionStorage](?runtime.connection_storages) != 0
        || release(controls, ?runtime) != OK) { ret 7; }
    # draining every connection compacted the tables back to nothing; a runtime
    # made again over them grows fresh from zero, lowest index first
    if (!test_make(?fixture, ?runtime, test_allocator())
        || hedge_storage.secret_table_capacity[Connection](controls.connections) != 0) { ret 8; }
    i = 0;
    for (i < count) {
        if (acquire_connection(controls, ?runtime, 0, 0,
            process_admission.no_lease()) != i) { ret 9; }
        i = i + 1;
    }
    if (hedge_storage.secret_table_capacity[Connection](controls.connections) < count) { ret 10; }
    i = 0;
    for (i < count) {
        return_connection(controls, ?runtime, i);
        i = i + 1;
    }
    if (release(controls, ?runtime) != OK) { ret 11; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a refused connection storage is a refused slot" {
    var t:       allocator_testing.Testing;
    val tracked: err[A.Error] = allocator_testing.make(?t);
    if (sel tracked.err) { ret 1; }
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, allocator_testing.allocator_of(?t))) { ret 2; }
    allocator_testing.fail_at_ordinal(?t, allocator_testing.attempt_count(?t) + 1);
    if (acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease()) != NO_CONNECTION
        || runtime.live_connections != 0
        || hedge_storage.secret_table_capacity[Connection](controls.connections) != 0) { ret 3; }
    allocator_testing.clear_failure(?t);
    val taken: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (taken != 0 || !return_connection(controls, ?runtime, taken))       { ret 4; }
    if (release(controls, ?runtime) != OK || allocator_testing.leaked(?t)) { ret 5; }
    ret 0;
}

# an absent limit admits whatever the allocator will hold, and a present one
# still refuses at exactly its value
test "hedge.protocol.quic.runtime: a pump limit is a cap only when present" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var manager:  process_admission.Manager;
    if (!process_admission.make(?manager, test_allocator(),
        opt[usize].none{}, opt[usize].none{})) { ret 1; }
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 2; }
    runtime.admission = ?manager;
    val pump: *Pump = ?controls.pumps[0];
    pump.connection_limit   = opt[usize].none{};
    pump.active_connections = 5000;
    pump.queued_initials    = 5000;
    if (!capacity_available(controls, ?runtime, pump)
        || hedge_storage.table_live[PendingInitial](?runtime.pending_initials)
        >= hedge_storage.table_capacity[PendingInitial](?runtime.pending_initials)) { ret 3; }
    pump.connection_limit   = opt[usize].some{3};
    pump.active_connections = 2;
    pump.queued_initials    = 0;
    if (!capacity_available(controls, ?runtime, pump)) { ret 4; }
    pump.queued_initials = 1;
    if (capacity_available(controls, ?runtime, pump)) { ret 5; }
    if (!limit_holds(opt[usize].none{}, 9, 9)
        || !limit_holds(opt[usize].some{3}, 2, 1)
        || limit_holds(opt[usize].some{3}, 3, 1)
        || limit_holds(opt[usize].some{3}, 4, 0)) { ret 6; }
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var selected_plan: plan.Plan;
    selected_plan.sealed = true;
    var budgets: budget.Set;
    var config:  PumpConfig = test_pump_config(1, ?policy, ?selected_plan, ?budgets);
    config.connection_limit         = opt[usize].none{};
    config.max_connections_per_peer = opt[usize].none{};
    if (!pump_config_shape_valid(?config)) { ret 7; }
    config.max_connections_per_peer = opt[usize].some{50};
    if (!pump_config_shape_valid(?config)) { ret 8; }
    config.connection_limit = opt[usize].some{10};
    if (pump_config_shape_valid(?config)) { ret 9; }
    config.connection_limit         = opt[usize].some{0};
    config.max_connections_per_peer = opt[usize].none{};
    if (pump_config_shape_valid(?config)) { ret 10; }
    ret 0;
}

test "hedge.protocol.quic.runtime: the live list holds exactly the live connections" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    # a pool with nothing live is a pool a sweep walks in no steps at all,
    # whatever it has grown to
    if (runtime.live_head != NO_CONNECTION || live_walk_length(controls,
        ?runtime) != 0) { ret 2; }
    val first: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    val second: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (first == NO_CONNECTION || second == NO_CONNECTION || first == second
        || live_walk_length(controls, ?runtime) != 2) { ret 3; }
    # a connection released from the middle of a sweep leaves the list whole
    return_connection(controls, ?runtime, first);
    if (live_walk_length(controls, ?runtime) != 1
        || runtime.live_head != second) { ret 4; }
    return_connection(controls, ?runtime, second);
    if (live_walk_length(controls, ?runtime) != 0
        || runtime.live_head != NO_CONNECTION) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: failing a connection leaves the runtime advanceable" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    val first: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (first == NO_CONNECTION) { ret 2; }
    fail_connection(controls, ?runtime, first, 1000);
    if (connection_at(controls, first).state != CONNECTION_BROKEN) { ret 3; }
    if (connection_at(controls, first).close_deadline_ns == 0)     { ret 4; }
    # advancing the runtime reclaims the broken connection without failing
    if (advance(controls, ?runtime, 1000) != OK) {
        ret 5;
    }
    if (live_walk_length(controls, ?runtime) != 0
        || runtime.live_head != NO_CONNECTION) { ret 6; }
    val second: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (second == NO_CONNECTION) { ret 7; }
    connection_at(controls, second).close_deadline_ns = 5000;
    connection_at(controls, second).state             = CONNECTION_RELEASING;
    # before deadline expiry the connection stays live
    if (release_connection(controls, ?runtime, second,
        time.Instant{sec: 1, nsec: 0}, 2000) != BLOCKED) { ret 8; }
    if (live_walk_length(controls, ?runtime) != 1) { ret 9; }
    # once the deadline expires the stalled connection is force released
    if (release_connection(controls, ?runtime, second,
        time.Instant{sec: 1, nsec: 0}, 5000) != OK) { ret 10; }
    if (live_walk_length(controls, ?runtime) != 0) { ret 11; }
    ret 0;
}

rec RegisteredOperation {
    cancelled: usize;
}

fun cancel_registered_operation(context: ptr, reason: cancel.Reason) {
    val state: *RegisteredOperation = context::*RegisteredOperation;
    state.cancelled = state.cancelled + 1;
}

test "hedge.protocol.quic.runtime: a forced release cancels what is still registered on the connection" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (index == NO_CONNECTION) { ret 2; }
    val value: *Connection = connection_at(controls, index);
    # the connection scope hangs from its pump's, as it does in service
    var pump_scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?pump_scope, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_child(?value.storage.scope, ?pump_scope, opt[time.Instant].none{}))) { ret 3; }
    value.scope_live = true;
    var operation:    RegisteredOperation = RegisteredOperation{cancelled: 0};
    var registration: cancel.Registration;
    if (!operation_ok(cancel.init_registration(?registration))) { ret 4; }
    val attached: cancel.Reason = cancel.attach(?value.storage.scope, ?registration,
        cancel_registered_operation, (?operation)::ptr);
    if (!(sel attached.active)) { ret 4; }
    value.close_deadline_ns = 5000;
    value.state             = CONNECTION_RELEASING;
    if (release_connection(controls, ?runtime, index,
        time.Instant{sec: 1, nsec: 0}, 5000) != OK) { ret 5; }
    # releasing the only connection cancels the registered operation, clears the
    # scope, and compacts the record away; the cancel count is the proof
    if (operation.cancelled != 1 || connection_at(controls, index) != nil) { ret 6; }
    # nothing was left hanging from the pump's scope, so it can be released
    if (!operation_ok(cancel.destroy(?pump_scope))) { ret 7; }
    ret 0;
}

# a cancel that never started the close left the connection unreleasable: it
# kept its slot and lease and held shutdown open indefinitely
test "hedge.protocol.quic.runtime: a failed first delivery is released at the drain deadline" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 1; }
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (index == NO_CONNECTION) { ret 2; }
    val value: *Connection = connection_at(controls, index);
    value.state = CONNECTION_LIVE;
    # the transport was never initialized, so the delivery refuses the datagram
    # the way an oversized one was refused
    var bytes:    [1280]u8;
    var received: net_types.Packet;
    received.buffer   = ?bytes[0];
    received.capacity = 1280;
    received.length   = 1280;
    if (deliver_initial(controls, ?runtime, index, ?received, 1000))            { ret 3; }
    if (!value.close_started || value.close_deadline_ns == 0)                   { ret 4; }
    if (advance(controls, ?runtime, value.close_deadline_ns) != OK)             { ret 5; }
    if (connection_at(controls, index) != nil || runtime.live_connections != 0) { ret 6; }
    ret 0;
}

# a connection that cannot finish its cleanup costs that connection. failing
# the runtime instead released every pump, and the pending receive with them,
# so the listener never read again (#145)
test "hedge.protocol.quic.runtime: a connection that cannot finish cleanup does not fail the runtime" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    var manager:  process_admission.Manager;
    if (!process_admission.make(?manager, test_allocator(),
        opt[usize].some{1}, opt[usize].some{1})) { ret 1; }
    var lease: process_admission.Lease;
    if (!process_admission.reserve(?manager, nil, ?lease)
        || !process_admission.commit(?manager, lease)) { ret 2; }
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    runtime.admission = ?manager;
    val index: usize = acquire_connection(controls, ?runtime, 0, 0, lease);
    if (index == NO_CONNECTION) { ret 91; }
    val connection: *Connection = connection_at(controls, index);
    connection.state = CONNECTION_CLEANUP;
    # the lease cannot be returned, so the cleanup cannot finish this pass
    runtime.admission = nil;
    if (cleanup_accepting(controls, ?runtime, index) || !connection.waiting) { ret 5; }
    if (advance(controls, ?runtime, 1) != OK
        || !connection.live
        || snapshot(controls, ?runtime).connection_failures != 1) { ret 3; }
    runtime.admission = ?manager;
    # the retry finishes cleanup and frees the connection, compacting it away
    if (advance(controls, ?runtime, 2) != OK
        || connection_at(controls, index) != nil
        || process_admission.in_use(?manager) != 0) { ret 4; }
    ret 0;
}

# a slot reused over an assembly that was never released refuses every
# connection it is given, so a forced release that cannot release the assembly
# keeps the slot and retries rather than freeing it (#145)
test "hedge.protocol.quic.runtime: a forced release keeps a slot whose assembly is not released" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (index == NO_CONNECTION) { ret 91; }
    val value: *Connection = connection_at(controls, index);
    # an attempted assembly whose transport never initialized cannot be released
    value.assembly_attempted = true;
    value.transport_finished = true;
    value.close_started      = true;
    value.close_deadline_ns  = 5;
    value.state              = CONNECTION_RELEASING;
    if (release_connection(controls, ?runtime, index,
        time.Instant{sec: 1, nsec: 0}, 10) == OK) { ret 1; }
    if (!value.live || value.assembly_released
        || value.state != CONNECTION_BROKEN) { ret 2; }
    val other: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.no_lease());
    if (other == index || other == NO_CONNECTION) { ret 3; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a pump holds more pending stateless sends than a fixed pool" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    val pump:     *Pump        = ?controls.pumps[0];
    if (!hedge_storage.make_table[StatelessSend](?pump.stateless, test_allocator())) { ret 90; }
    pump.stateless_generation = 0;
    pump.stateless_pending    = NO_CONNECTION;
    var claimed: [64]usize;
    var i:       usize = 0;
    for (i < 64) {
        claimed[i] = claim_stateless(pump);
        if (claimed[i] != i) { ret 1; }
        stateless_at(pump, claimed[i]).pending = true;
        i                                      = i + 1;
    }
    if (pump.stateless_live != 64
        || hedge_storage.table_live[StatelessSend](?pump.stateless) != 64) { ret 2; }
    # settle out of order, then every pending send is still reachable
    release_stateless(pump, 0);
    release_stateless(pump, 63);
    release_stateless(pump, 17);
    var seen: usize = 0;
    var at:   usize = pump.stateless_pending;
    for (at != NO_CONNECTION) {
        if (at == 0 || at == 63 || at == 17 || !stateless_at(pump, at).pending) { ret 3; }
        seen = seen + 1;
        at   = stateless_at(pump, at).next_pending;
    }
    if (seen != 61 || pump.stateless_live != 61) { ret 4; }
    # the lowest released slot is reused before the table grows
    val reused: usize = claim_stateless(pump);
    if (reused != 0 || hedge_storage.table_chunks[StatelessSend](?pump.stateless) != 3) { ret 5; }
    release_stateless(pump, reused);
    i = 1;
    for (i < 63) {
        if (i != 17) { release_stateless(pump, i); }
        i = i + 1;
    }
    if (pump.stateless_live != 0 || pump.stateless_pending != NO_CONNECTION
        || stateless_pending(pump)) { ret 6; }
    if (!hedge_storage.destroy_table[StatelessSend](?pump.stateless)) { ret 7; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a pump at its stateless ceiling drops and counts" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pump: *Pump = ?controls.pumps[0];
    if (!hedge_storage.make_table[StatelessSend](?pump.stateless, test_allocator())) { ret 91; }
    pump.stateless_generation = 0;
    pump.stateless_pending    = NO_CONNECTION;
    var i: usize = 0;
    for (i < MAX_STATELESS_PENDING) {
        if (claim_stateless(pump) != i) { ret 1; }
        i = i + 1;
    }
    var received: net_types.Packet;
    var data:     [16]u8;
    if (submit_stateless(controls, ?runtime, 0, ?received, ?data[0], 16) != BLOCKED
        || runtime.stateless_dropped != 1
        || snapshot(controls, ?runtime).stateless_dropped != 1
        || pump.stateless_live != MAX_STATELESS_PENDING) { ret 2; }
    # one settled send makes room again without growing
    release_stateless(pump, 9);
    if (claim_stateless(pump) != 9)                                   { ret 3; }
    if (!hedge_storage.destroy_table[StatelessSend](?pump.stateless)) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.runtime: only a full replay store is a replay refusal" {
    var full: quic_listener.Result;
    full.action = quic_listener.ACTION_BLOCKED;
    full.error  = quic_listener.ERROR_TOKEN;
    full.detail = token.ERROR_REPLAY_FULL::u64;
    if (!replay_refused(?full)) { ret 1; }
    var admission: quic_listener.Result = full;
    admission.error = quic_listener.ERROR_ADMISSION;
    if (replay_refused(?admission)) { ret 2; }
    var expired: quic_listener.Result = full;
    expired.action = quic_listener.ACTION_DROP;
    expired.detail = token.ERROR_EXPIRED::u64;
    if (replay_refused(?expired)) { ret 3; }
    ret 0;
}

# queue an admitted initial as deferred pending `index`, the way enqueue_initial
# does for a budget that admitted it, with a live pump and bank so promotion
# and release take their real paths
fun test_defer_pending(controls: *ControlView, runtime: *Runtime, index: usize,
    arrival_ns: u64, handshake_timeout_ns: u64) *PendingInitial {
    val claimed: usize = free_pending_initial(runtime);
    if (claimed != index) { ret nil; }
    val pending: *PendingInitial = pending_at(runtime, index);
    pending.arrival_ns                  = arrival_ns;
    pending.config.handshake_timeout_ns = handshake_timeout_ns;
    if (!claim_pending_timer(runtime, index, true, ?pending.budget_charge)) { ret nil; }
    controls.pumps[0].live               = true;
    controls.pumps[0].generation         = 2;
    controls.pumps[0].admissions[0].live = true;
    pending.live                         = true;
    pending.pump                         = 0;
    pending.pump_generation              = 2;
    pending.admission_bank               = 0;
    link_deferred(runtime, index);
    link_pending_live(runtime, index);
    runtime.pending_initial_count                   = runtime.pending_initial_count + 1;
    runtime.live_total                              = runtime.live_total + 1;
    controls.pumps[0].queued_initials               = controls.pumps[0].queued_initials + 1;
    controls.pumps[0].admissions[0].queued_initials =
        controls.pumps[0].admissions[0].queued_initials + 1;
    ret pending;
}

test "hedge.protocol.quic.runtime: the admission deadline counts the work ahead at the running cost" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    if (runtime.service_ns != HANDSHAKE_SERVICE_SEED_NS)  { ret 1; }
    runtime.service_ns = 10000000;
    # 998 waiting and none in flight: the thousandth handshake ends at 10 s,
    # inside a 10 s deadline. one more waiting and it does not
    if (!deadline_allows(?runtime, 0, 10000000000, 0, 998)
        || deadline_allows(?runtime, 0, 10000000000, 0, 999)) { ret 2; }
    # handshakes in flight are work ahead as much as waiting initials are
    runtime.handshakes_in_flight = 500;
    if (!deadline_allows(?runtime, 0, 10000000000, 0, 498)
        || deadline_allows(?runtime, 0, 10000000000, 0, 499)) { ret 3; }
    # time already spent waiting is time gone from the same deadline
    runtime.handshakes_in_flight = 0;
    if (!deadline_allows(?runtime, 0, 10000000000, 5000000000, 498)
        || deadline_allows(?runtime, 0, 10000000000, 5000000000, 499)) { ret 4; }
    # a cost estimate that halves doubles what the deadline admits
    runtime.service_ns = 5000000;
    if (!deadline_allows(?runtime, 0, 10000000000, 0, 1998)
        || deadline_allows(?runtime, 0, 10000000000, 0, 1999)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: the admission deadline judges a record's own time by the measured finish" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    runtime.service_ns = 10000000;
    # before any handshake has completed, its own time is one crypto unit
    if (runtime.finish_ns != 0 || own_ns(?runtime) != 10000000) { ret 1; }
    if (!deadline_allows(?runtime, 0, 10000000000, 0, 998)
        || deadline_allows(?runtime, 0, 10000000000, 0, 999)) { ret 2; }
    # a finish of 500 ms: 950 units of work ahead end at 9.5 s and the
    # record's own finish just fits inside 10 s. one more unit and it does not
    runtime.finish_ns = 500000000;
    if (own_ns(?runtime) != 500000000) { ret 3; }
    if (!deadline_allows(?runtime, 0, 10000000000, 0, 949)
        || deadline_allows(?runtime, 0, 10000000000, 0, 950)) { ret 4; }
    # at its turn, nothing ahead: a record with less than a finish left is
    # refused rather than promoted to expire
    if (!deadline_allows(?runtime, 0, 10000000000, 9499999999, 0)
        || deadline_allows(?runtime, 0, 10000000000, 9500000000, 0)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: the finish estimate is seeded by the first completion and follows the rest" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    # a completion with no promotion time is no sample, nor one out of order
    observe_finish(?runtime, 0, 1000000000);
    observe_finish(?runtime, 1000000000, 1000000000);
    if (runtime.finish_ns != 0) { ret 1; }
    # the first sample is the estimate
    observe_finish(?runtime, 1000000000, 1040000000);
    if (runtime.finish_ns != 40000000) { ret 2; }
    # later ones fold in at one eighth
    observe_finish(?runtime, 2000000000, 2080000000);
    if (runtime.finish_ns != 40000000 - 5000000 + 10000000) { ret 3; }
    # a client mid-PTO is one outlier: a sample counts for at most four estimates
    val settled: u64 = runtime.finish_ns;
    observe_finish(?runtime, 3000000000, 13000000000);
    if (runtime.finish_ns != settled - settled / 8 + settled * 4 / 8) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a handshake released past its deadline without completing is an expiry" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    controls.pumps[0].live       = true;
    controls.pumps[0].generation = 4;
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.Lease{index: 0, generation: 1});
    if (index == NO_CONNECTION) { ret 1; }
    val value: *Connection = connection_at(controls, index);
    # a completion inside the deadline samples the finish and expires nothing
    value.handshake = claim_handshake(controls);
    if (value.handshake == NO_HANDSHAKE) { ret 2; }
    runtime.handshakes_in_flight = 1;
    value.handshake_started_ns   = 1000000000;
    value.handshake_deadline_ns  = 11000000000;
    if (!release_handshake(controls, ?runtime, index, true, 1050000000)
        || runtime.handshakes_expired != 0 || runtime.finish_ns != 50000000
        || value.handshake_started_ns != 0 || value.handshake_deadline_ns != 0) { ret 3; }
    # an early end inside the deadline is the client going away, not an expiry
    value.handshake = claim_handshake(controls);
    if (value.handshake == NO_HANDSHAKE) { ret 4; }
    runtime.handshakes_in_flight = 1;
    value.handshake_started_ns   = 2000000000;
    value.handshake_deadline_ns  = 12000000000;
    if (!release_handshake(controls, ?runtime, index, false, 5000000000)
        || runtime.handshakes_expired != 0) { ret 5; }
    # an early end at or past the deadline is an expiry: crypto spent for nothing
    value.handshake = claim_handshake(controls);
    if (value.handshake == NO_HANDSHAKE) { ret 6; }
    runtime.handshakes_in_flight = 1;
    value.handshake_started_ns   = 3000000000;
    value.handshake_deadline_ns  = 13000000000;
    if (!release_handshake(controls, ?runtime, index, false, 13000000000)
        || runtime.handshakes_expired != 1) { ret 7; }
    # a release that carries no time classifies nothing
    value.handshake = claim_handshake(controls);
    if (value.handshake == NO_HANDSHAKE) { ret 8; }
    runtime.handshakes_in_flight = 1;
    value.handshake_deadline_ns  = 1;
    if (!release_handshake(controls, ?runtime, index, false, 0)
        || runtime.handshakes_expired != 1) { ret 9; }
    if (admission_report(?runtime).expired != 1) { ret 10; }
    ret 0;
}

test "hedge.protocol.quic.runtime: the service estimate follows completions only while handshake work waits" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    # with nothing waiting the worker may have idled between completions, so
    # no chain of samples opens and the seed stands
    observe_service(?runtime, 1000000000);
    observe_service(?runtime, 1500000000);
    if (runtime.service_ns != HANDSHAKE_SERVICE_SEED_NS
        || runtime.last_completion_ns != 0) { ret 1; }
    # with initials waiting, the first completion opens the chain and each
    # later one folds its interval in at one eighth
    runtime.deferred_count = 5;
    observe_service(?runtime, 2000000000);
    if (runtime.service_ns != HANDSHAKE_SERVICE_SEED_NS
        || runtime.last_completion_ns != 2000000000) { ret 2; }
    observe_service(?runtime, 2002000000);
    if (runtime.service_ns != 10000000 - 1250000 + 250000) { ret 3; }
    # a stall is one outlier: a sample counts for at most four estimates
    val settled_in: u64 = runtime.service_ns;
    observe_service(?runtime, 12002000000);
    if (runtime.service_ns != settled_in - settled_in / 8 + settled_in * 4 / 8) { ret 4; }
    # admitted handshakes waiting their turn keep the chain open as well
    runtime.deferred_count       = 0;
    runtime.handshake_ready_head = 0;
    observe_service(?runtime, 13000000000);
    if (runtime.last_completion_ns != 13000000000) { ret 5; }
    # arrival work done in the interval is not handshake cost and comes out
    val before: u64 = runtime.service_ns;
    runtime.arrival_work_ns = runtime.arrival_work_ns + 1000000000;
    observe_service(?runtime, 14002000000);
    if (runtime.service_ns != before - before / 8 + 2000000 / 8) { ret 6; }
    # an interval that was all arrival work is no sample
    runtime.arrival_work_ns = runtime.arrival_work_ns + 5000000000;
    val held: u64 = runtime.service_ns;
    observe_service(?runtime, 15000000000);
    if (runtime.service_ns != held || runtime.last_completion_ns != 15000000000) { ret 7; }
    # every queue draining closes the chain: the next completion is not a sample
    runtime.handshake_ready_head = NO_CONNECTION;
    val settled: u64 = runtime.service_ns;
    observe_service(?runtime, 16000000000);
    if (runtime.service_ns != settled || runtime.last_completion_ns != 0) { ret 8; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a deferred initial past its deadline is dropped, one inside it waits its turn" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    runtime.max_handshakes = 1;
    val first:  *PendingInitial = test_defer_pending(controls, ?runtime, 0, 0, 10000000000);
    val second: *PendingInitial = test_defer_pending(controls, ?runtime, 1, 1000000000, 10000000000);
    if (first == nil || second == nil || runtime.deferred_count != 2
        || runtime.deferred_head != 0 || runtime.deferred_tail != 1
        || !promotable(?runtime) || !has_ready(?runtime)) { ret 1; }
    # the second was not first in line, so it counts as held back; the first
    # only once a turn passes it over
    if (runtime.handshakes_deferred != 0) { ret 2; }
    # the bound is full: a turn marks nothing and promotes nothing
    runtime.handshakes_in_flight = 1;
    runtime.crypto_budget        = 1;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 2, nsec: 0}, 2000000000) != OK
        || !first.live || !second.live || runtime.handshakes_promoted != 0
        || has_ready(?runtime) || promotable(?runtime)) { ret 3; }
    # the bound has room but the turn has no unit of handshake work left: the
    # head is not marked
    runtime.handshakes_in_flight = 0;
    runtime.crypto_budget        = 0;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 2, nsec: 0}, 2000000000) != OK
        || !first.live || runtime.handshakes_promoted != 0) { ret 4; }
    # its deadline fires: the first is dropped and counted, and nothing else
    # is touched, since the second was not marked
    var owners: [4]u64;
    if (wheel.advance(?fixture.timers, 10000000000, ?owners[0], 4) != 1
        || !owns(owners[0])) { ret 5; }
    fire(controls, ?runtime, owners[0], 10000000000);
    runtime.crypto_budget = 1;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 10, nsec: 0}, 10000000000) != OK
        || first.live || !second.live || runtime.handshakes_dropped != 1
        || runtime.handshakes_refused != 0 || runtime.deferred_count != 1
        || runtime.deferred_head != 1 || runtime.pending_initial_count != 1
        || runtime.live_total != 1) { ret 6; }
    # the second, promoted now, would end past its own deadline at the running
    # cost, so it is dropped rather than started
    runtime.service_ns = 2000000000;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 9, nsec: 500000000}, 9500000000) != OK
        || second.live || runtime.handshakes_dropped != 2
        || runtime.handshakes_promoted != 0 || runtime.deferred_count != 0
        || runtime.pending_initial_count != 0 || runtime.live_total != 0
        || has_ready(?runtime) || wheel.armed_count(?fixture.timers) != 0) { ret 7; }
    ret 0;
}

test "hedge.protocol.quic.runtime: the deferred queue is promoted in arrival order and one per turn" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val first:  *PendingInitial = test_defer_pending(controls, ?runtime, 0, 0, 10000000000);
    val second: *PendingInitial = test_defer_pending(controls, ?runtime, 1, 0, 10000000000);
    val third:  *PendingInitial = test_defer_pending(controls, ?runtime, 2, 0, 10000000000);
    if (first == nil || second == nil || third == nil) { ret 1; }
    # without a unit of handshake work this turn nothing is marked or taken
    runtime.crypto_budget = 0;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 1, nsec: 0}, 1000000000) != OK
        || !first.live || !second.live || !third.live
        || runtime.handshakes_deferred != 0) { ret 2; }
    # no policy stands behind the pending config here, so a promotion goes no
    # further than releasing the initial it took: the order of release is the
    # order of promotion, one per turn
    runtime.crypto_budget = 1;
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 1, nsec: 0}, 1000000000) != OK
        || first.live || !second.live || !third.live
        || runtime.deferred_head != 1 || runtime.handshakes_promoted != 0) { ret 3; }
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 1, nsec: 0}, 1000000000) != OK
        || second.live || !third.live || runtime.deferred_head != 2) { ret 4; }
    if (advance_pending_initials(controls, ?runtime,
        time.Instant{sec: 1, nsec: 0}, 1000000000) != OK
        || third.live || runtime.deferred_count != 0
        || runtime.pending_initial_count != 0 || runtime.live_total != 0
        || has_ready(?runtime)) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a pending initial routes the datagrams behind it and holds a bounded few" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pending: *PendingInitial = test_defer_pending(controls, ?runtime, 0, 0, 10000000000);
    if (pending == nil) { ret 1; }
    var id: [CONNECTION_ID_BYTES]u8;
    var i:  usize = 0;
    for (i < CONNECTION_ID_BYTES) {
        id[i] = (i + 7)::u8;
        i     = i + 1;
    }
    val key: routing.Key = routing.key(?id[0], CONNECTION_ID_BYTES);
    if (!publish_pending_route(?runtime, 0, key) || !pending.route_live
        || runtime.routes.len != 1) { ret 2; }
    val found: routing.Lookup = routing.lookup(?runtime.routes, key);
    if (found.status != routing.ROUTE_OK || !found.binding.pending
        || found.binding.connection_slot != 0) { ret 3; }
    var payload:      [64]u8;
    var packet_value: net_types.Packet;
    packet_value.buffer   = ?payload[0];
    packet_value.capacity = 64;
    packet_value.length   = 64;
    i                     = 0;
    for (i < HELD_PER_PENDING) {
        payload[0] = i::u8;
        if (deliver_pending(?runtime, found, ?packet_value) != OK) { ret 4; }
        i = i + 1;
    }
    if (pending.held.count != HELD_PER_PENDING || runtime.held_dropped != 0) { ret 5; }
    # past the ceiling the datagram is dropped, and the retransmit is the retry
    if (deliver_pending(?runtime, found, ?packet_value) != OK
        || pending.held.count != HELD_PER_PENDING || runtime.held_dropped != 1) { ret 6; }
    # what was held is in arrival order
    if (held_at(?runtime, pending.held.head).data[0] != 0
        || held_at(?runtime, pending.held.tail).data[0] != (HELD_PER_PENDING - 1)::u8) { ret 7; }
    # a stale generation is not this initial
    var stale: routing.Lookup = found;
    stale.binding.connection_generation = stale.binding.connection_generation + 1;
    if (deliver_pending(?runtime, stale, ?packet_value) != STALE) { ret 8; }
    # releasing the initial takes its route and what it held with it
    take_pending_initial(controls, ?runtime, 0);
    if (pending.live || pending.route_live || runtime.routes.len != 0
        || hedge_storage.table_live[HeldDatagram](?runtime.held) != 0) { ret 9; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a connection with work joins the handshake list while it holds a record" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    controls.pumps[0].live       = true;
    controls.pumps[0].generation = 4;
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.Lease{index: 0, generation: 1});
    if (index == NO_CONNECTION) { ret 1; }
    val value: *Connection = connection_at(controls, index);
    value.handshake = claim_handshake(controls);
    if (value.handshake == NO_HANDSHAKE) { ret 2; }
    runtime.handshakes_in_flight = 1;
    mark_ready(controls, ?runtime, index);
    if (!value.ready || !value.ready_handshake || runtime.ready_head != NO_CONNECTION
        || runtime.handshake_ready_head != index
        || runtime.handshake_ready_tail != index || !has_ready(?runtime)) { ret 3; }
    # the record going back moves its work to the ready list and frees a slot
    if (!release_handshake(controls, ?runtime, index, false, 0)
        || value.handshake != NO_HANDSHAKE || runtime.handshakes_in_flight != 0
        || !value.ready || value.ready_handshake || runtime.ready_head != index
        || runtime.handshake_ready_head != NO_CONNECTION) { ret 4; }
    unmark_ready(controls, ?runtime, index);
    if (value.ready || runtime.ready_head != NO_CONNECTION || has_ready(?runtime)) { ret 5; }
    value.lease_live = false;
    free_connection(controls, ?runtime, index);
    ret 0;
}

test "hedge.protocol.quic.runtime: the audit finds a record holding work on no list" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    controls.pumps[0].live       = true;
    controls.pumps[0].generation = 4;
    val index: usize = acquire_connection(controls, ?runtime, 0, 0,
        process_admission.Lease{index: 0, generation: 1});
    if (index == NO_CONNECTION) { ret 1; }
    val value: *Connection = connection_at(controls, index);
    if (audit(controls, ?runtime) != 0) { ret 2; }
    # a datagram held for a handshake turn nobody queued
    value.held.count = 1;
    if (audit(controls, ?runtime) != 1) { ret 3; }
    mark_ready(controls, ?runtime, index);
    if (audit(controls, ?runtime) != 0) { ret 4; }
    unmark_ready(controls, ?runtime, index);
    value.held.count = 0;
    # a pool wake nobody routed
    value.assembly.account.open     = true;
    value.assembly.account.is_ready = true;
    if (audit(controls, ?runtime) != 1) { ret 5; }
    value.assembly.account.is_ready = false;
    value.assembly.account.open     = false;
    # a teardown that finishes only by being serviced, unless the waiting list holds it
    value.state = CONNECTION_CLEANUP;
    if (audit(controls, ?runtime) != 1) { ret 6; }
    set_waiting(controls, ?runtime, index, true);
    if (audit(controls, ?runtime) != 0) { ret 7; }
    set_waiting(controls, ?runtime, index, false);
    value.state      = CONNECTION_ACCEPTING;
    value.lease_live = false;
    free_connection(controls, ?runtime, index);
    ret 0;
}

var test_read_on_calls: usize = 0;

fun test_read_on(ctx: ptr) bool {
    test_read_on_calls = test_read_on_calls + 1;
    ret false;
}

fun test_key(tag: u8) routing.Key {
    var bytes: [CONNECTION_ID_BYTES]u8;
    var i:     usize = 0;
    for (i < CONNECTION_ID_BYTES) {
        bytes[i] = tag;
        i        = i + 1;
    }
    ret routing.key(?bytes[0], CONNECTION_ID_BYTES);
}

fun test_hold(runtime: *Runtime, pump: *Pump, tag: u8, class: usize,
    now_ns: u64) Status {
    var data:   [MIN_INITIAL_BYTES]u8;
    var packet: net_types.Packet;
    packet.buffer   = ?data[0];
    packet.capacity = MIN_INITIAL_BYTES;
    packet.length   = MIN_INITIAL_BYTES;
    data[0]         = tag;
    ret hold_arrival(runtime, pump, ?packet, test_key(tag), class, now_ns);
}

test "hedge.protocol.quic.runtime: an unknown initial is held in arrival order and dropped past the socket's worth" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pump: *Pump = ?controls.pumps[0];
    if (!make_arrivals(pump, test_allocator())) { ret 91; }
    # the queue holds what the socket buffer holds, never less than a batch
    if (arrival_capacity(schema.DEFAULT_QUIC_RECEIVE_BUFFER)
        != schema.DEFAULT_QUIC_RECEIVE_BUFFER / MIN_INITIAL_BYTES) { ret 1; }
    if (arrival_capacity(1) != RECEIVE_BATCH) { ret 2; }
    pump.arrival_capacity = 2;
    if (test_hold(?runtime, pump, 1, ARRIVAL_UNTOKEN, 100) != OK) { ret 3; }
    if (test_hold(?runtime, pump, 2, ARRIVAL_UNTOKEN, 200) != OK) { ret 4; }
    # the third is past the bound with nothing of a lower class to take:
    # dropped under its class and counted, nothing held
    if (test_hold(?runtime, pump, 3, ARRIVAL_UNTOKEN, 300) != BLOCKED
        || runtime.arrivals_dropped[ARRIVAL_UNTOKEN] != 1
        || arrivals_dropped_total(?runtime) != 1 || pump.arrival_live != 2
        || pump.arrival_held[ARRIVAL_UNTOKEN] != 2) { ret 5; }
    # held in arrival order with each one's own arrival time, bytes and key
    val head: *Arrival    = arrival_at(pump, pump.arrival_heads[ARRIVAL_UNTOKEN]);
    var one:  routing.Key = test_key(1);
    if (head.arrival_ns != 100 || head.data[0] != 1
        || head.length != MIN_INITIAL_BYTES || head.class != ARRIVAL_UNTOKEN
        || !routing.key_equal(?head.key, ?one)) { ret 6; }
    if (arrival_at(pump, head.next).arrival_ns != 200
        || arrival_at(pump, head.next).data[0] != 2) { ret 7; }
    # a turn drains the queue, reading the sockets after every preflight.
    # neither held datagram is a well-formed Initial, so each is preflighted
    # off the queue and discarded without reaching a listener
    pump.live          = true;
    test_read_on_calls = 0;
    if (!bind_read_on(?runtime, test_read_on, nil)) { ret 8; }
    if (advance_arrivals(controls, ?runtime, clock.from_ns(500), 500) != OK
        || pump.arrival_live != 0 || arrivals_held(pump)
        || pump.arrival_heads[ARRIVAL_UNTOKEN] != NO_CONNECTION
        || pump.arrival_tails[ARRIVAL_UNTOKEN] != NO_CONNECTION
        || map.length_by[routing.Key, usize](pump.arrival_index) != 0
        || test_read_on_calls != 2) { ret 9; }
    if (test_hold(?runtime, pump, 6, ARRIVAL_UNTOKEN, 600) != OK
        || pump.arrival_heads[ARRIVAL_UNTOKEN] != pump.arrival_tails[ARRIVAL_UNTOKEN]) {
        ret 10;
    }
    pump.live = false;
    if (!destroy_arrivals(pump)) { ret 92; }
    ret 0;
}

test "hedge.protocol.quic.runtime: at the arrival bound a token initial takes a lower class's slot and a duplicate takes none" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pump: *Pump = ?controls.pumps[0];
    if (!make_arrivals(pump, test_allocator())) { ret 91; }
    pump.arrival_capacity = 3;
    if (test_hold(?runtime, pump, 1, ARRIVAL_UNTOKEN, 100) != OK
        || test_hold(?runtime, pump, 2, ARRIVAL_OTHER, 200) != OK
        || test_hold(?runtime, pump, 3, ARRIVAL_DUPLICATE, 300) != OK
        || pump.arrival_live != 3) { ret 1; }
    # full: a duplicate is dropped, and nothing held moves
    if (test_hold(?runtime, pump, 4, ARRIVAL_DUPLICATE, 400) != BLOCKED
        || runtime.arrivals_dropped[ARRIVAL_DUPLICATE] != 1
        || pump.arrival_live != 3) { ret 2; }
    # a token Initial evicts the held duplicate first
    if (test_hold(?runtime, pump, 5, ARRIVAL_TOKEN, 500) != OK
        || runtime.arrivals_dropped[ARRIVAL_DUPLICATE] != 2
        || pump.arrival_held[ARRIVAL_DUPLICATE] != 0
        || pump.arrival_held[ARRIVAL_TOKEN] != 1 || pump.arrival_live != 3) { ret 3; }
    # then the negotiation, then the first flight
    if (test_hold(?runtime, pump, 6, ARRIVAL_TOKEN, 600) != OK
        || runtime.arrivals_dropped[ARRIVAL_OTHER] != 1
        || pump.arrival_held[ARRIVAL_OTHER] != 0) { ret 4; }
    if (test_hold(?runtime, pump, 7, ARRIVAL_TOKEN, 700) != OK
        || runtime.arrivals_dropped[ARRIVAL_UNTOKEN] != 1
        || pump.arrival_held[ARRIVAL_UNTOKEN] != 0
        || pump.arrival_held[ARRIVAL_TOKEN] != 3) { ret 5; }
    # a table of tokens takes no more tokens: the bound is the bound
    if (test_hold(?runtime, pump, 8, ARRIVAL_TOKEN, 800) != BLOCKED
        || runtime.arrivals_dropped[ARRIVAL_TOKEN] != 1
        || pump.arrival_live != 3) { ret 6; }
    # an untoken Initial never evicts a token, and the evicted keys are gone
    # from the index while the held ones remain
    if (test_hold(?runtime, pump, 9, ARRIVAL_UNTOKEN, 900) != BLOCKED
        || runtime.arrivals_dropped[ARRIVAL_UNTOKEN] != 2) { ret 7; }
    var five:      routing.Key = test_key(5);
    var one:       routing.Key = test_key(1);
    val held_five: opt[*usize] =
        map.get_by[routing.Key, usize](?pump.arrival_index, ?five);
    val held_one: opt[*usize] =
        map.get_by[routing.Key, usize](?pump.arrival_index, ?one);
    if (map.length_by[routing.Key, usize](pump.arrival_index) != 3
        || !(sel held_five.some) || sel held_one.some) { ret 8; }
    # the tokens preflight in their own arrival order: 5, 6, 7
    if (next_arrival_class(pump) != ARRIVAL_TOKEN
        || arrival_at(pump, pump.arrival_heads[ARRIVAL_TOKEN]).data[0] != 5) { ret 9; }
    if (arrivals_dropped_total(?runtime) != 6) { ret 10; }
    if (!destroy_arrivals(pump))               { ret 92; }
    ret 0;
}

test "hedge.protocol.quic.runtime: an arrival is classed by its header and a held destination CID makes it a duplicate" {
    var fixture:  TestControls;
    val controls: *ControlView = test_controls(?fixture);
    var runtime:  Runtime;
    if (!test_make(?fixture, ?runtime, test_allocator())) { ret 90; }
    val pump: *Pump = ?controls.pumps[0];
    if (!make_arrivals(pump, test_allocator())) { ret 91; }
    pump.arrival_capacity = 4;
    var classified: quic_listener.ClassifiedDatagram;
    classified.class = quic_listener.DATAGRAM_INITIAL;
    if (arrival_class(pump, ?classified, test_key(1)) != ARRIVAL_UNTOKEN) { ret 1; }
    classified.class = quic_listener.DATAGRAM_NEGOTIATE;
    if (arrival_class(pump, ?classified, test_key(1)) != ARRIVAL_OTHER) { ret 2; }
    # once key 1 is held, anything carrying it is a duplicate, and the class
    # follows the held count: two copies held, released one at a time
    if (test_hold(?runtime, pump, 1, ARRIVAL_UNTOKEN, 100) != OK) { ret 3; }
    classified.class = quic_listener.DATAGRAM_INITIAL;
    if (arrival_class(pump, ?classified, test_key(1)) != ARRIVAL_DUPLICATE
        || arrival_class(pump, ?classified, test_key(2)) != ARRIVAL_UNTOKEN) { ret 4; }
    if (test_hold(?runtime, pump, 1, ARRIVAL_DUPLICATE, 200) != OK) { ret 5; }
    if (!evict_arrival(pump, ARRIVAL_UNTOKEN)
        || arrival_class(pump, ?classified, test_key(1)) != ARRIVAL_DUPLICATE) { ret 6; }
    if (!evict_arrival(pump, ARRIVAL_DUPLICATE)
        || arrival_class(pump, ?classified, test_key(1)) != ARRIVAL_UNTOKEN
        || pump.arrival_live != 0) { ret 7; }
    if (!destroy_arrivals(pump)) { ret 92; }
    ret 0;
}

test "hedge.protocol.quic.runtime: a pump config carries a nonzero handshake bound and a share within it" {
    var protocol_bytes: [2]u8 = [2]u8{'h', '3'};
    var protocols:      [1]tls_config.ProtocolName;
    var policy:         hedge_tls.Policy;
    var chosen:         plan.Plan;
    var items:          [1]budget.Budget;
    var set:            budget.Set;
    if (!budget.make(?set, ?items[0], 1)) { ret 1; }
    chosen.sealed = true;
    test_policy(?policy, ?protocols[0], ?protocol_bytes[0]);
    var config: PumpConfig = test_pump_config(1, ?policy, ?chosen, ?set);
    if (!handshake_limits_valid(?config)) { ret 2; }
    config.max_handshakes = 0;
    if (handshake_limits_valid(?config)) { ret 3; }
    config.max_handshakes          = 8;
    config.max_handshakes_per_peer = opt[usize].some{9};
    if (handshake_limits_valid(?config)) { ret 4; }
    config.max_handshakes_per_peer = opt[usize].some{8};
    if (!handshake_limits_valid(?config)) { ret 5; }
    config.max_handshakes_per_peer = opt[usize].some{0};
    if (handshake_limits_valid(?config)) { ret 6; }
    ret 0;
}
