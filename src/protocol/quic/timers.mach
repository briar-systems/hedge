# quic timer scheduling with one heap node per connection slot

use quic.transport;
use A: std.allocator;
use std.allocator.page;
use allocator_testing: std.allocator.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

pub def Status: u8;
pub val TIMER_OK:      Status = 1;
pub val TIMER_INVALID: Status = 2;
pub val TIMER_STALE:   Status = 3;
# the allocator refused the storage a new slot or node needed
pub val TIMER_FULL:    Status = 4;
pub val TIMER_EMPTY:   Status = 5;
pub val TIMER_NOT_DUE: Status = 6;

pub rec Node {
    timer:                 transport.Timer;
    connection_slot:       usize;
    connection_generation: u64;
}

pub rec Position {
    index:                 usize;
    connection_generation: u64;
    live:                  bool;
}

# the heap and the per-slot positions both grow on demand. nodes are values
# addressed by heap index and positions by slot, so growing either copies it.
pub rec Queue {
    allocator:         *A.Allocator;
    nodes:             *Node;
    node_capacity:     usize;
    positions:         *Position;
    position_capacity: usize;
    len:               usize;
    initialized:       bool;
}

pub rec Result {
    status: Status;
    node:   Node;
}

# a position's index while its slot has no node in the heap
pub val NOT_QUEUED: usize = (-1)::usize;

pub val MIN_CAPACITY: usize = 16;

pub fun make(queue: *Queue, a: *A.Allocator) bool {
    if (queue == nil || a == nil) { ret false; }
    queue.allocator         = a;
    queue.nodes             = nil;
    queue.node_capacity     = 0;
    queue.positions         = nil;
    queue.position_capacity = 0;
    queue.len               = 0;
    queue.initialized       = true;
    ret true;
}

# every timer must have been taken or disarmed first
pub fun destroy(queue: *Queue) bool {
    if (queue == nil || !queue.initialized || queue.len != 0) { ret false; }
    if (queue.nodes != nil) {
        val returned: err[A.Error] = A.deallocate[Node](queue.allocator,
            queue.nodes, queue.node_capacity);
        if (sel returned.err) { ret false; }
        queue.nodes         = nil;
        queue.node_capacity = 0;
    }
    if (queue.positions != nil) {
        val returned: err[A.Error] = A.deallocate[Position](queue.allocator,
            queue.positions, queue.position_capacity);
        if (sel returned.err) { ret false; }
        queue.positions         = nil;
        queue.position_capacity = 0;
    }
    queue.initialized = false;
    ret true;
}

fun capacity_covering(current: usize, wanted: usize) usize {
    var capacity: usize = current;
    if (capacity < MIN_CAPACITY) { capacity = MIN_CAPACITY; }
    for (capacity <= wanted) {
        if (capacity > (-1)::usize / 2) { ret 0; }
        capacity = capacity * 2;
    }
    ret capacity;
}

fun grow_positions(queue: *Queue, slot: usize) bool {
    val capacity: usize = capacity_covering(queue.position_capacity, slot);
    if (capacity == 0) { ret false; }
    var grown: res[*Position, A.Error];
    if (queue.positions == nil) {
        grown = A.allocate[Position](queue.allocator, capacity);
    }
    or {
        grown = A.reallocate[Position](queue.allocator, queue.positions,
            queue.position_capacity, capacity);
    }
    if (sel grown.err) { ret false; }
    val positions: *Position = grown.ok;
    var i:         usize     = queue.position_capacity;
    for (i < capacity) {
        positions[i].index                 = NOT_QUEUED;
        positions[i].connection_generation = 0;
        positions[i].live                  = false;
        i                                  = i + 1;
    }
    queue.positions         = positions;
    queue.position_capacity = capacity;
    ret true;
}

fun grow_nodes(queue: *Queue) bool {
    val capacity: usize = capacity_covering(queue.node_capacity, queue.len);
    if (capacity == 0) { ret false; }
    var grown: res[*Node, A.Error];
    if (queue.nodes == nil) {
        grown = A.allocate[Node](queue.allocator, capacity);
    }
    or {
        grown = A.reallocate[Node](queue.allocator, queue.nodes,
            queue.node_capacity, capacity);
    }
    if (sel grown.err) { ret false; }
    queue.nodes         = grown.ok;
    queue.node_capacity = capacity;
    ret true;
}

fun before(left: Node, right: Node) bool {
    if (left.timer.deadline_ns != right.timer.deadline_ns) {
        ret left.timer.deadline_ns < right.timer.deadline_ns;
    }
    ret left.connection_slot < right.connection_slot;
}

fun exchange(queue: *Queue, left: usize, right: usize) {
    if (left == right) { ret; }
    val saved: Node = queue.nodes[left];
    queue.nodes[left]                                         = queue.nodes[right];
    queue.nodes[right]                                        = saved;
    queue.positions[queue.nodes[left].connection_slot].index  = left;
    queue.positions[queue.nodes[right].connection_slot].index = right;
}

fun sift_up(queue: *Queue, start: usize) usize {
    var index: usize = start;
    for (index > 0) {
        val parent: usize = (index - 1) / 2;
        if (!before(queue.nodes[index], queue.nodes[parent])) { ret index; }
        exchange(queue, index, parent);
        index = parent;
    }
    ret index;
}

fun sift_down(queue: *Queue, start: usize) usize {
    var index: usize = start;
    for (true) {
        val left: usize = index * 2 + 1;
        if (left >= queue.len) { ret index; }
        var smallest: usize = left;
        val right:    usize = left + 1;
        if (right < queue.len && before(queue.nodes[right], queue.nodes[left])) {
            smallest = right;
        }
        if (!before(queue.nodes[smallest], queue.nodes[index])) { ret index; }
        exchange(queue, index, smallest);
        index = smallest;
    }
    ret index;
}

fun remove_at(queue: *Queue, index: usize) Node {
    val removed: Node = queue.nodes[index];
    queue.positions[removed.connection_slot].index                 = NOT_QUEUED;
    queue.positions[removed.connection_slot].connection_generation = 0;
    queue.positions[removed.connection_slot].live                  = false;
    queue.len                                                      = queue.len - 1;
    if (index < queue.len) {
        queue.nodes[index]                                        = queue.nodes[queue.len];
        queue.positions[queue.nodes[index].connection_slot].index = index;
        val settled: usize = sift_up(queue, index);
        sift_down(queue, settled);
    }
    ret removed;
}

pub fun disarm(queue: *Queue, connection_slot: usize,
    connection_generation: u64) Status {
    if (queue == nil || !queue.initialized || connection_generation == 0) {
        ret TIMER_INVALID;
    }
    # a slot past every position has never been queued
    if (connection_slot >= queue.position_capacity) { ret TIMER_OK; }
    val position: *Position = ?queue.positions[connection_slot];
    if (!position.live) { ret TIMER_OK; }
    if (position.connection_generation != connection_generation) {
        ret TIMER_STALE;
    }
    remove_at(queue, position.index);
    ret TIMER_OK;
}

pub fun refresh(queue: *Queue, connection_slot: usize,
    connection_generation: u64, timer: transport.Timer) Status {
    if (queue == nil || !queue.initialized || connection_generation == 0) {
        ret TIMER_INVALID;
    }
    if (!timer.armed) {
        ret disarm(queue, connection_slot, connection_generation);
    }
    if (timer.source == 0 || timer.generation == 0) { ret TIMER_INVALID; }
    if (connection_slot >= queue.position_capacity
        && !grow_positions(queue, connection_slot)) { ret TIMER_FULL; }
    val position: *Position = ?queue.positions[connection_slot];
    if (position.live) {
        if (position.connection_generation != connection_generation) {
            ret TIMER_STALE;
        }
        val index: usize = position.index;
        queue.nodes[index].timer = timer;
        val settled: usize = sift_up(queue, index);
        sift_down(queue, settled);
        ret TIMER_OK;
    }
    if (queue.len == queue.node_capacity && !grow_nodes(queue)) { ret TIMER_FULL; }
    val index: usize = queue.len;
    queue.len          = queue.len + 1;
    queue.nodes[index] = Node{timer: timer, connection_slot: connection_slot,
        connection_generation: connection_generation};
    position.index                 = index;
    position.connection_generation = connection_generation;
    position.live                  = true;
    sift_up(queue, index);
    ret TIMER_OK;
}

pub fun next_deadline(queue: *Queue, output: *u64) Status {
    if (queue == nil || !queue.initialized || output == nil) {
        ret TIMER_INVALID;
    }
    if (queue.len == 0) { ret TIMER_EMPTY; }
    @output = queue.nodes[0].timer.deadline_ns;
    ret TIMER_OK;
}

pub fun take_due(queue: *Queue, now_ns: u64) Result {
    var result: Result;
    if (queue == nil || !queue.initialized) {
        result.status = TIMER_INVALID;
        ret result;
    }
    if (queue.len == 0) {
        result.status = TIMER_EMPTY;
        ret result;
    }
    if (queue.nodes[0].timer.deadline_ns > now_ns) {
        result.status = TIMER_NOT_DUE;
        ret result;
    }
    result.node   = remove_at(queue, 0);
    result.status = TIMER_OK;
    ret result;
}

fun test_timer(source: u64, deadline: u64, generation: u64)
    transport.Timer {
    ret transport.Timer{source: source, deadline_ns: deadline,
        generation: generation, armed: true};
}

test "hedge.protocol.quic.timers: deadlines are ordered and refreshed in place" {
    var a:     A.Allocator;
    var queue: Queue;
    page.make(?a);
    if (!make(?queue, ?a)) { ret 1; }
    if (refresh(?queue, 0, 1, test_timer(10, 30, 1)) != TIMER_OK
        || refresh(?queue, 1, 1, test_timer(11, 10, 1)) != TIMER_OK
        || refresh(?queue, 2, 1, test_timer(12, 20, 1)) != TIMER_OK) { ret 2; }
    if (refresh(?queue, 0, 1, test_timer(10, 5, 2)) != TIMER_OK
        || queue.len != 3) { ret 3; }
    var deadline: u64 = 0;
    if (next_deadline(?queue, ?deadline) != TIMER_OK || deadline != 5) {
        ret 4;
    }
    val first:  Result = take_due(?queue, 5);
    val second: Result = take_due(?queue, 10);
    val third:  Result = take_due(?queue, 20);
    if (first.status != TIMER_OK || first.node.connection_slot != 0
        || second.status != TIMER_OK || second.node.connection_slot != 1
        || third.status != TIMER_OK || third.node.connection_slot != 2
        || queue.len != 0) { ret 5; }
    ret 0;
}

test "hedge.protocol.quic.timers: early deadlines remain scheduled" {
    var a:     A.Allocator;
    var queue: Queue;
    page.make(?a);
    if (!make(?queue, ?a)) { ret 1; }
    if (refresh(?queue, 0, 4, test_timer(10, 100, 1)) != TIMER_OK) {
        ret 2;
    }
    if (take_due(?queue, 99).status != TIMER_NOT_DUE || queue.len != 1) {
        ret 3;
    }
    if (take_due(?queue, 100).status != TIMER_OK || queue.len != 0) {
        ret 4;
    }
    ret 0;
}

test "hedge.protocol.quic.timers: stale generations cannot alter recycled slots" {
    var a:     A.Allocator;
    var queue: Queue;
    page.make(?a);
    if (!make(?queue, ?a)) { ret 1; }
    if (refresh(?queue, 0, 7, test_timer(10, 100, 1)) != TIMER_OK
        || refresh(?queue, 0, 6, test_timer(10, 50, 2)) != TIMER_STALE
        || disarm(?queue, 0, 6) != TIMER_STALE || queue.len != 1) { ret 2; }
    if (disarm(?queue, 0, 7) != TIMER_OK || queue.len != 0) { ret 3; }
    if (refresh(?queue, 0, 8, test_timer(10, 40, 3)) != TIMER_OK
        || take_due(?queue, 40).node.connection_generation != 8) { ret 4; }
    ret 0;
}

test "hedge.protocol.quic.timers: disarmed timers consume no heap capacity" {
    var a:     A.Allocator;
    var queue: Queue;
    page.make(?a);
    if (!make(?queue, ?a)) { ret 1; }
    var timer: transport.Timer = test_timer(10, 100, 1);
    if (refresh(?queue, 0, 1, timer) != TIMER_OK) { ret 2; }
    timer.armed = false;
    if (refresh(?queue, 0, 1, timer) != TIMER_OK || queue.len != 0
        || next_deadline(?queue, ?timer.deadline_ns) != TIMER_EMPTY) { ret 3; }
    ret 0;
}

# slots are claimed in any order as the connection pool grows, and every heap
# move has to keep each slot's position pointing at its node
test "hedge.protocol.quic.timers: the heap and positions grow past their first size" {
    var a:     A.Allocator;
    var queue: Queue;
    page.make(?a);
    if (!make(?queue, ?a) || queue.node_capacity != 0) { ret 1; }
    if (disarm(?queue, 5000, 1) != TIMER_OK)           { ret 2; }
    val count: usize = 3000;
    var i:     usize = 0;
    for (i < count) {
        val slot: usize = (i * 7919) % count;
        if (refresh(?queue, slot, 1, test_timer(10, (count - i)::u64 * 3, 1)) != TIMER_OK) { ret 3; }
        i = i + 1;
    }
    if (queue.len != count || queue.position_capacity < count) { ret 4; }
    i = 0;
    for (i < count) {
        val position: *Position = ?queue.positions[i];
        if (!position.live || queue.nodes[position.index].connection_slot != i) { ret 5; }
        i = i + 1;
    }
    var last: u64 = 0;
    i = 0;
    for (i < count) {
        val taken: Result = take_due(?queue, 0xffffffffffffffff);
        if (taken.status != TIMER_OK || taken.node.timer.deadline_ns < last
            || queue.positions[taken.node.connection_slot].index != NOT_QUEUED) { ret 6; }
        last = taken.node.timer.deadline_ns;
        i    = i + 1;
    }
    if (queue.len != 0 || !destroy(?queue)) { ret 7; }
    ret 0;
}

test "hedge.protocol.quic.timers: a refused growth is full and keeps what is queued" {
    var t:       allocator_testing.Testing;
    val tracked: err[A.Error] = allocator_testing.make(?t);
    if (sel tracked.err) { ret 1; }
    var queue: Queue;
    if (!make(?queue, allocator_testing.allocator_of(?t))) { ret 2; }
    var i: usize = 0;
    for (i < MIN_CAPACITY) {
        if (refresh(?queue, i, 1, test_timer(10, i::u64, 1)) != TIMER_OK) { ret 3; }
        i = i + 1;
    }
    allocator_testing.fail_at_ordinal(?t, allocator_testing.attempt_count(?t) + 1);
    if (refresh(?queue, MIN_CAPACITY, 1, test_timer(10, 1, 1)) != TIMER_FULL
        || queue.len != MIN_CAPACITY) { ret 4; }
    allocator_testing.clear_failure(?t);
    if (refresh(?queue, 3, 1, test_timer(10, 99, 2)) != TIMER_OK) { ret 5; }
    i = 0;
    for (i < MIN_CAPACITY) {
        if (disarm(?queue, i, 1) != TIMER_OK) { ret 6; }
        i = i + 1;
    }
    if (queue.len != 0 || !destroy(?queue) || allocator_testing.leaked(?t)) { ret 7; }
    ret 0;
}
