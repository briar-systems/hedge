# pending stateless sends: Retries and version negotiations in flight
#
# a pump answers an unknown Initial without a connection, and each answer is a
# send the io runtime completes later. the sends grow on demand up to a
# ceiling, past which the answer is dropped and the client's retransmit is the
# retry. the pending list is what the completion sweep walks, so it costs what
# is in flight. `C` is the owner's completion context, which a send carries and
# this module never reads. a send is pinned while pending, because the io
# completion context lives inside it

use hedge_storage: hedge.storage;
use quic.connection.assembly;
use A: std.allocator;
use std.allocator.page;
use net_types: std.net.async.types;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val NONE: usize = (-1)::usize;

pub rec Send[C] {
    buffer:       [assembly.MAX_UDP_PAYLOAD]u8;
    packet:       net_types.Packet;
    context:      C;
    generation:   u64;
    next_pending: usize;
    prev_pending: usize;
    pending:      bool;
}

pub rec Sends[C] {
    table:   hedge_storage.Table[Send[C]];
    head:    usize;
    live:    usize;
    ceiling: usize;
}

# no sends, and room for `ceiling` of them
pub fun make[C](sends: *Sends[C], backing: *A.Allocator, ceiling: usize) bool {
    if (sends == nil || backing == nil) { ret false; }
    sends.head    = NONE;
    sends.live    = 0;
    sends.ceiling = ceiling;
    ret hedge_storage.make_table[Send[C]](?sends.table, backing);
}

pub fun destroy[C](sends: *Sends[C]) bool {
    sends.head = NONE;
    sends.live = 0;
    ret hedge_storage.destroy_table[Send[C]](?sends.table);
}

pub fun live[C](sends: *Sends[C]) usize {
    ret sends.live;
}

# how many records the table holds room for, so a completion can tell an index
# that was never a send
pub fun capacity[C](sends: *Sends[C]) usize {
    ret hedge_storage.table_capacity[Send[C]](?sends.table);
}

pub fun at[C](sends: *Sends[C], index: usize) *Send[C] {
    ret hedge_storage.table_at[Send[C]](?sends.table, index);
}

# the first send on the pending list, or NONE
pub fun first[C](sends: *Sends[C]) usize {
    ret sends.head;
}

# claims a send and links it onto the pending list. NONE when the ceiling is
# held or the allocator refuses to grow
pub fun claim[C](sends: *Sends[C]) usize {
    if (sends.live >= sends.ceiling) { ret NONE; }
    val index: usize = hedge_storage.table_claim[Send[C]](?sends.table);
    if (index == hedge_storage.NO_INDEX) { ret NONE; }
    val operation: *Send[C] = at[C](sends, index);
    operation.prev_pending = NONE;
    operation.next_pending = sends.head;
    if (sends.head != NONE) { at[C](sends, sends.head).prev_pending = index; }
    sends.head = index;
    sends.live = sends.live + 1;
    ret index;
}

# unlinks a settled send and releases its record
pub fun release[C](sends: *Sends[C], index: usize) {
    val operation: *Send[C] = at[C](sends, index);
    if (operation.prev_pending != NONE) {
        at[C](sends, operation.prev_pending).next_pending = operation.next_pending;
    }
    or { sends.head = operation.next_pending; }
    if (operation.next_pending != NONE) {
        at[C](sends, operation.next_pending).prev_pending = operation.prev_pending;
    }
    operation.pending      = false;
    operation.next_pending = NONE;
    operation.prev_pending = NONE;
    sends.live             = sends.live - 1;
    hedge_storage.table_release[Send[C]](?sends.table, index);
}

#[testing]
var test_backing: A.Allocator;

test sends__pending_list_grows_and_reuses {
    page.make(?test_backing);
    var sends: Sends[u64];
    if (!make[u64](?sends, ?test_backing, 64)) { ret 90; }
    var claimed: [64]usize;
    var i:       usize = 0;
    for (i < 64) {
        claimed[i] = claim[u64](?sends);
        if (claimed[i] != i) { ret 1; }
        at[u64](?sends, claimed[i]).pending = true;
        i                                   = i + 1;
    }
    # the ceiling is the ceiling
    if (claim[u64](?sends) != NONE || live[u64](?sends) != 64
        || hedge_storage.table_live[Send[u64]](?sends.table) != 64) { ret 2; }
    # settle out of order, then every pending send is still reachable
    release[u64](?sends, 0);
    release[u64](?sends, 63);
    release[u64](?sends, 17);
    var seen:  usize = 0;
    var index: usize = first[u64](?sends);
    for (index != NONE) {
        if (index == 0 || index == 63 || index == 17 || !at[u64](?sends, index).pending) { ret 3; }
        seen  = seen + 1;
        index = at[u64](?sends, index).next_pending;
    }
    if (seen != 61 || live[u64](?sends) != 61) { ret 4; }
    # the lowest chunk with room is reused before the table grows
    val reused: usize = claim[u64](?sends);
    if (reused != 0 || hedge_storage.table_chunks[Send[u64]](?sends.table) != 3) { ret 5; }
    release[u64](?sends, reused);
    i = 1;
    for (i < 63) {
        if (i != 17) { release[u64](?sends, i); }
        i = i + 1;
    }
    if (live[u64](?sends) != 0 || first[u64](?sends) != NONE) { ret 6; }
    if (!destroy[u64](?sends))                                { ret 7; }
    ret 0;
}
