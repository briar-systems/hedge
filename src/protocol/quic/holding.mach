# held datagrams: what arrives for a handshake before the worker's turn for it
#
# a datagram for a connection mid-handshake, or for a pending initial still
# waiting for a slot, is held until the worker's turn for handshake work comes:
# delivering it is where the handshake crypto runs, so the receive path copies
# it and reads on. every queue draws its records from one store, and each
# queue has its own ceiling, past which a datagram is dropped and counted and
# the client's retransmit is the retry

use hedge_storage: hedge.storage;
use quic.connection.assembly;
use A:          std.allocator;
use std_memory: std.memory;
use net_types:  std.net.async.types;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val NONE: usize = (-1)::usize;

pub rec Datagram {
    data:                  [assembly.MAX_UDP_PAYLOAD]u8;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    length:                usize;
    interface_index:       u32;
    next:                  usize;
    has_local_destination: bool;
}

# the records every queue draws from, and how many datagrams were dropped
pub rec Store {
    datagrams: hedge_storage.Table[Datagram];
    dropped:   u64;
}

# one owner's held datagrams, oldest first
pub rec Queue {
    head:  usize;
    tail:  usize;
    count: usize;
}

pub fun make(store: *Store, backing: *A.Allocator) bool {
    if (store == nil || backing == nil) { ret false; }
    store.dropped = 0;
    ret hedge_storage.make_table[Datagram](?store.datagrams, backing);
}

pub fun destroy(store: *Store) bool {
    ret hedge_storage.destroy_table[Datagram](?store.datagrams);
}

# how many datagrams every queue holds together
pub fun live(store: *Store) usize {
    ret hedge_storage.table_live[Datagram](?store.datagrams);
}

pub fun reset(queue: *Queue) {
    queue.head  = NONE;
    queue.tail  = NONE;
    queue.count = 0;
}

pub fun at(store: *Store, index: usize) *Datagram {
    ret hedge_storage.table_at[Datagram](?store.datagrams, index);
}

# copies a datagram onto a queue. past the queue's ceiling, or when the store
# cannot grow, it is dropped and counted
pub fun hold(store: *Store, queue: *Queue, ceiling: usize, received: *net_types.Packet) bool {
    if (queue.count >= ceiling) {
        store.dropped = store.dropped + 1;
        ret false;
    }
    val slot: usize = hedge_storage.table_claim[Datagram](?store.datagrams);
    if (slot == hedge_storage.NO_INDEX) {
        store.dropped = store.dropped + 1;
        ret false;
    }
    val held: *Datagram = at(store, slot);
    std_memory.raw_copy(?held.data[0], received.buffer, received.length);
    held.peer                  = received.peer;
    held.local_destination     = received.local_destination;
    held.length                = received.length;
    held.interface_index       = received.interface_index;
    held.has_local_destination = received.has_local_destination;
    held.next                  = NONE;
    if (queue.tail != NONE) { at(store, queue.tail).next = slot; }
    or                      { queue.head = slot; }
    queue.tail  = slot;
    queue.count = queue.count + 1;
    ret true;
}

# the oldest datagram a queue holds, or nil
pub fun oldest(store: *Store, queue: *Queue) *Datagram {
    if (queue.head == NONE) { ret nil; }
    ret at(store, queue.head);
}

# releases the oldest datagram a queue holds, once it has been delivered: a
# release may compact the chunk its data is in
pub fun pop(store: *Store, queue: *Queue) {
    val slot: usize = queue.head;
    if (slot == NONE) { ret; }
    queue.head = at(store, slot).next;
    if (queue.head == NONE) { queue.tail = NONE; }
    queue.count = queue.count - 1;
    hedge_storage.table_release[Datagram](?store.datagrams, slot);
}

# releases everything a queue holds
pub fun release(store: *Store, queue: *Queue) {
    var i: usize = queue.head;
    for (i != NONE) {
        val next: usize = at(store, i).next;
        hedge_storage.table_release[Datagram](?store.datagrams, i);
        i = next;
    }
    reset(queue);
}

# a promoted initial's held datagrams become its connection's, whose queue is
# empty
pub fun move(target: *Queue, source: *Queue) {
    @target = @source;
    reset(source);
}

# a held datagram as the receive path delivered it
pub fun packet(held: *Datagram) net_types.Packet {
    var value: net_types.Packet;
    value.buffer                = ?held.data[0];
    value.capacity              = held.length;
    value.length                = held.length;
    value.peer                  = held.peer;
    value.local_destination     = held.local_destination;
    value.interface_index       = held.interface_index;
    value.has_local_destination = held.has_local_destination;
    value.truncated             = false;
    value.zero_length           = false;
    ret value;
}
