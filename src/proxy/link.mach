# one upstream connection
#
# The upstream leg runs the same HTTP/1 engine the served leg runs, in client
# role, over the same transport adapter and the same completion routing. A link
# is generation-owned and leased for exactly one exchange at a time, so an
# upstream connection is reused without two requests ever sharing one.

use hedge.clock;
use hedge.connection;
use hedge.listener;
use hedge.memory;
use hedge.wake;
use http.core.body;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use http.core.transport;
use engine_h1: http.h1.connection;
use http.h1.parser;
use std.chrono.time;
use io_error: std.io.error;
use std.io.handle;
use io_handle:    std.io.handle;
use io_lifecycle: std.io.lifecycle;
use io_runtime:   std.io.runtime;
use std.memory.buffers;
use net_async: std.net.async;
use std.net.ip;
use std.net.tcp;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

pub val LINK_SLOTS:           usize = 1;
pub val LINK_TRANSPORT_SLOTS: usize = 4;

pub def State: u8;
pub val FREE:       State = 0;
pub val IDLE:       State = 9;
pub val CONNECTING: State = 1;
pub val READY:      State = 2;
pub val SENDING:    State = 3;
pub val AWAITING:   State = 4;
pub val STREAMING:  State = 5;
pub val DONE:       State = 6;
pub val FAILED:     State = 7;
pub val CLOSED:     State = 8;
pub val CLOSING:    State = 10;

pub def Step: u8;
pub val STEP_IDLE:     Step = 1;
pub val STEP_PROGRESS: Step = 2;
pub val STEP_BLOCKED:  Step = 3;
pub val STEP_HEADERS:  Step = 4;
pub val STEP_DONE:     Step = 5;
pub val STEP_ERROR:    Step = 6;

pub rec Link {
    state:             State;
    upstream:          usize;
    generation:        u64;
    leased:            bool;
    reusable:          bool;
    endpoint:          ip.Endpoint;
    stream:            tcp.Stream;
    has_stream:        bool;
    driver:            *net_async.Driver;
    connect_context:   listener.ConnectionContext;
    connect_operation: connection.Operation;
    connect_pending:   bool;
    connect_failed:    bool;
    runtime_stream:    transport.RuntimeStream;
    adapter:           transport.Adapter;
    channel:           transport.Transport;
    channel_slots:     [LINK_TRANSPORT_SLOTS]transport.Slot;
    contexts:          [LINK_TRANSPORT_SLOTS]listener.ConnectionContext;
    operations:        [LINK_TRANSPORT_SLOTS]connection.Operation;
    operation_root:    cancel.Scope;
    control_scope:     cancel.Scope;
    engine_scope:      cancel.Scope;
    scopes_live:       bool;
    engine:            engine_h1.Engine;
    engine_slots:      [LINK_SLOTS]engine_h1.Slot;
    # the link borrows from its worker's pool like a served connection does
    borrower:     memory.Borrower;
    account:      buffers.Account;
    source:       buffers.Source;
    account_live: bool;
    slot:         usize;
    have_headers: bool;
    # held response body already reported, since the engine reports what it
    # holds on every turn until it is taken
    reported_held:      usize;
    body_offset:        usize;
    body_length:        usize;
    body_final:         bool;
    inbound_complete:   bool;
    configured:         engine_h1.Config;
    initialized:        bool;
    close_started:      bool;
    close_failed:       bool;
    engine_close_owned: bool;
}

fun settle(context: ptr, token_context: usize, completion: io_runtime.Completion) {
    val link: *Link = context::*Link;
    if (link == nil || !link.initialized) { ret; }
    var settled: transport.Completion;
    if (!connection.translate(?settled, completion, token_context)) { ret; }
    val was_closing: bool            = link.state == CLOSING;
    val event:       engine_h1.Event = engine_h1.complete_io(?link.engine, ?settled, clock.instant());
    absorb(link, event);
    if (was_closing) { link.state = CLOSING; }
}

fun rejected() res[io_runtime.Token, io_error.Error] {
    ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_SUBMIT)};
}

fun operation_for(link: *Link, token_context: usize) usize {
    var token: transport.Token;
    if (!transport.context_token(token_context, ?token)) { ret LINK_TRANSPORT_SLOTS; }
    val index: usize = token.index::usize;
    if (index >= LINK_TRANSPORT_SLOTS) { ret LINK_TRANSPORT_SLOTS; }
    if (!connection.bind_operation(?link.operations[index], ?link.contexts[index],
        (link)::ptr, settle, token_context)) { ret LINK_TRANSPORT_SLOTS; }
    ret index;
}

fun submit_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val link:  *Link = context::*Link;
    val index: usize = operation_for(link, token_context);
    if (index >= LINK_TRANSPORT_SLOTS) { ret rejected(); }
    ret net_async.submit_read(link.driver, scope, ?link.stream, buffer, length,
        (?link.contexts[index])::usize);
}

fun submit_readable(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val link:  *Link = context::*Link;
    val index: usize = operation_for(link, token_context);
    if (index >= LINK_TRANSPORT_SLOTS) { ret rejected(); }
    ret net_async.submit_readable(link.driver, scope, ?link.stream,
        (?link.contexts[index])::usize);
}

fun submit_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val link:  *Link = context::*Link;
    val index: usize = operation_for(link, token_context);
    if (index >= LINK_TRANSPORT_SLOTS) { ret rejected(); }
    ret net_async.submit_write(link.driver, scope, ?link.stream, buffer, length,
        (?link.contexts[index])::usize);
}

fun submit_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val link:  *Link = context::*Link;
    val index: usize = operation_for(link, token_context);
    if (index >= LINK_TRANSPORT_SLOTS) { ret rejected(); }
    ret net_async.submit_shutdown_write(link.driver, scope, ?link.stream,
        (?link.contexts[index])::usize);
}

fun submit_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) res[io_runtime.Token, io_error.Error] {
    val link:  *Link = context::*Link;
    val index: usize = operation_for(link, token_context);
    if (index >= LINK_TRANSPORT_SLOTS) { ret rejected(); }
    ret net_async.submit_stream_close(link.driver, scope, ?link.stream,
        io_lifecycle.ABORTIVE, (?link.contexts[index])::usize);
}

# the connect completion carries the socket this link owns from then on
fun connect_settled(context: ptr, token_context: usize, completion: io_runtime.Completion) {
    val link: *Link = context::*Link;
    if (link == nil || !link.connect_pending
        || token_context::u64 != link.generation) { ret; }
    link.connect_pending = false;
    if (completion.has_error) {
        link.connect_failed = true;
        if (link.state != CLOSING) { link.state = FAILED; }
        ret;
    }
    var connected: io_runtime.Completion = completion;
    link.stream     = net_async.stream(?connected);
    link.has_stream = true;
    # an upstream stream carries the same transport policy a served one does:
    # this link writes a request head and then its body and then waits for the
    # upstream to answer. the socket is owned before the policy is applied, so a
    # refusal is closed by the ordinary teardown rather than leaked.
    if (!listener.apply_stream_policy(link.stream.handle)) {
        link.connect_failed = true;
        if (link.state != CLOSING) { link.state = FAILED; }
    }
}

# the engine must be configured to the storage this link actually owns: a
# pipeline depth or header bound larger than these buffers would have the engine
# index past them
pub fun link_config(base: engine_h1.Config) engine_h1.Config {
    var configured: engine_h1.Config = base;
    configured.max_pipeline = LINK_SLOTS;
    ret configured;
}

pub fun free(link: *Link) bool {
    ret link != nil && link.state == FREE && !link.leased;
}

# an idle link keeps its connected socket for the next request to the same upstream
pub fun idle_for(link: *Link, upstream_index: usize) bool {
    ret link != nil && link.state == IDLE && !link.leased && link.initialized
        && link.upstream == upstream_index
        && link.engine.state == engine_h1.OPEN;
}

# take an idle connection for one more exchange
pub fun lease(link: *Link) bool {
    if (link == nil || link.state != IDLE || link.leased) { ret false; }
    link.leased           = true;
    link.generation       = link.generation + 1;
    link.reusable         = false;
    link.slot             = engine_h1.NO_SLOT;
    link.have_headers     = false;
    link.reported_held    = 0;
    link.inbound_complete = false;
    link.state            = READY;
    ret true;
}

# hand a finished connection back, keeping it only when both sides agreed it may
# be reused and the engine is still open for another exchange
pub fun release_idle(link: *Link, now: time.Instant) bool {
    if (link == nil || !link.initialized || !link.reusable
        || link.slot == engine_h1.NO_SLOT
        || link.engine.state != engine_h1.OPEN) { ret false; }
    if (!engine_h1.release(?link.engine, link.slot, now)) { ret false; }
    link.leased           = false;
    link.slot             = engine_h1.NO_SLOT;
    link.have_headers     = false;
    link.reported_held    = 0;
    link.inbound_complete = false;
    link.state            = IDLE;
    ret true;
}

# the account is opened under an owner no protocol routes: the pool waking it
# only gives the worker a turn, and every turn drives the links
pub fun make(link: *Link, driver: *net_async.Driver, pool: *memory.Memory,
    budgets: memory.Budgets, upstream: usize, endpoint: ip.Endpoint,
    configured: engine_h1.Config, now: time.Instant) bool {
    if (link == nil || driver == nil || pool == nil) { ret false; }
    link.account_live       = false;
    link.state              = CONNECTING;
    link.upstream           = upstream;
    link.generation         = link.generation + 1;
    link.leased             = true;
    link.reusable           = false;
    link.endpoint           = endpoint;
    link.driver             = driver;
    link.configured         = link_config(configured);
    link.has_stream         = false;
    link.connect_pending    = false;
    link.connect_failed     = false;
    link.scopes_live        = false;
    link.initialized        = false;
    link.close_started      = false;
    link.close_failed       = false;
    link.engine_close_owned = false;
    link.slot               = engine_h1.NO_SLOT;
    link.have_headers       = false;
    link.reported_held      = 0;
    link.body_offset        = 0;
    link.body_length        = 0;
    link.body_final         = false;
    link.inbound_complete   = false;
    if (!connection.bind_operation(?link.connect_operation, ?link.connect_context,
        (link)::ptr, connect_settled, link.generation::usize)) { ret false; }
    if (!operation_ok(cancel.make_root(?link.operation_root, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_root(?link.control_scope, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_child(?link.engine_scope, ?link.operation_root, opt[time.Instant].none{}))) { ret false; }
    link.scopes_live = true;
    memory.borrower(?link.borrower, pool, wake.PLANE_OWNER, 0, budgets);
    if (!memory.open(?link.borrower, ?link.account)) { ret false; }
    link.source       = memory.borrowed_source(?link.borrower);
    link.account_live = true;
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_connect(
        driver, ?link.operation_root, endpoint, (?link.connect_context)::usize);
    if (sel submitted.err) {
        link.state = FAILED;
        ret false;
    }
    link.connect_pending = true;
    ret true;
}

# bind the transport and engine once the socket exists
fun activate(link: *Link, now: time.Instant) bool {
    link.runtime_stream = transport.RuntimeStream{
        runtime: link.driver.runtime,
        context: (link)::ptr,
        submit_read:           submit_read,
        submit_readable:       submit_readable,
        submit_write:          submit_write,
        submit_shutdown_write: submit_shutdown,
        submit_close:          submit_close,
    };
    if (!transport.make_runtime_adapter(?link.adapter, ?link.runtime_stream, transport.PLAINTEXT)) {
        ret false;
    }
    link.channel.initialized = false;
    if (!transport.init(?link.channel, link.adapter, ?link.operation_root,
        ?link.control_scope, ?link.channel_slots[0], LINK_TRANSPORT_SLOTS)) { ret false; }
    link.engine.initialized = false;
    if (!engine_h1.init(?link.engine, engine_h1.CLIENT, ?link.channel, ?link.engine_scope,
        ?link.engine_slots[0], LINK_SLOTS, ?link.source, ?link.account,
        link.configured, now)) { ret false; }
    link.initialized = true;
    link.state       = READY;
    ret true;
}

# publish the outbound request head; the body follows through `offer_body`
pub fun send(link: *Link, request_method: method.Method, request_target: target.Target,
    fields: *field.Fields, now: time.Instant) bool {
    if (link == nil || link.state != READY) { ret false; }
    link.slot = engine_h1.enqueue_request(?link.engine, message.version_h1(1, 1),
        request_method, request_target, fields, nil, now);
    if (link.slot == engine_h1.NO_SLOT) { ret false; }
    link.state = SENDING;
    ret true;
}

fun absorb(link: *Link, event: engine_h1.Event) {
    if (event.kind == engine_h1.EVENT_RESPONSE_HEADERS) {
        link.have_headers = true;
        ret;
    }
    if (event.kind == engine_h1.EVENT_RESPONSE_BODY) {
        ret;
    }
    if (event.kind == engine_h1.EVENT_RESPONSE_COMPLETE) {
        link.inbound_complete = true;
        ret;
    }
    if (event.kind == engine_h1.EVENT_ERROR || event.kind == engine_h1.EVENT_TIMED_OUT
        || event.kind == engine_h1.EVENT_CANCELLED || event.kind == engine_h1.EVENT_CLOSED
        || event.kind == engine_h1.EVENT_PEER_CLOSED) {
        if (!link.inbound_complete) { link.state = FAILED; }
    }
}

pub fun headers_ready(link: *Link) bool {
    ret link != nil && link.have_headers;
}

pub fun failed(link: *Link) bool {
    ret link == nil || link.state == FAILED;
}

pub fun finished(link: *Link) bool {
    ret link != nil && (link.state == DONE || link.inbound_complete);
}

pub fun response(link: *Link) *parser.Parsed {
    if (link == nil || !link.initialized || link.slot == engine_h1.NO_SLOT) { ret nil; }
    ret engine_h1.parsed(?link.engine, link.slot);
}

# drive the upstream leg one step
pub fun step(link: *Link, now: time.Instant) Step {
    if (link == nil) { ret STEP_ERROR; }
    if (link.state == CLOSING) {
        if (close(link))                             { ret STEP_DONE; }
        if (link.close_failed && link.state == FREE) { ret STEP_ERROR; }
        ret STEP_BLOCKED;
    }
    if (link.state == FAILED) { ret STEP_ERROR; }
    if (link.state == CONNECTING) {
        if (link.connect_pending) { ret STEP_BLOCKED; }
        if (link.connect_failed || !link.has_stream) {
            link.state = FAILED;
            ret STEP_ERROR;
        }
        if (!activate(link, now)) {
            link.state = FAILED;
            ret STEP_ERROR;
        }
        ret STEP_PROGRESS;
    }
    if (!link.initialized) { ret STEP_BLOCKED; }
    if (link.state == SENDING) {
        if (link.engine.write_pending) { ret STEP_BLOCKED; }
        if (link.engine.write_length != 0) {
            engine_h1.submit_write(?link.engine);
            ret STEP_PROGRESS;
        }
        if (link.engine_slots[link.slot].outbound_complete) {
            link.state = AWAITING;
            ret STEP_PROGRESS;
        }
        val offered: engine_h1.Offer = engine_h1.offer(?link.engine, link.slot, nil, 0, true);
        if (offered.status == engine_h1.OFFER_ERROR) {
            link.state = FAILED;
            ret STEP_ERROR;
        }
        if (offered.status == engine_h1.OFFER_BLOCKED) { ret STEP_BLOCKED; }
        if (link.engine.write_length != 0)             { engine_h1.submit_write(?link.engine); }
        ret STEP_PROGRESS;
    }
    if (link.state == IDLE) { ret STEP_BLOCKED; }
    if (link.state == AWAITING || link.state == STREAMING) {
        if (link.have_headers && link.state == AWAITING) {
            link.state = STREAMING;
            ret STEP_HEADERS;
        }
        if (link.inbound_complete) {
            link.state = DONE;
            # the engine forbids reuse when the exchange said so, and this only
            # records that the upstream side finished cleanly
            link.reusable = !link.engine_slots[link.slot].close_after;
            ret STEP_DONE;
        }
        val event: engine_h1.Event = engine_h1.process(?link.engine, now);
        if (event.kind == engine_h1.EVENT_NEED_READ) {
            engine_h1.submit_read(?link.engine);
            ret STEP_BLOCKED;
        }
        if (event.kind == engine_h1.EVENT_NONE
            || event.kind == engine_h1.EVENT_MEMORY_BLOCKED) { ret STEP_BLOCKED; }
        absorb(link, event);
        if (link.state == FAILED) { ret STEP_ERROR; }
        if (event.kind == engine_h1.EVENT_RESPONSE_HEADERS) {
            link.state = STREAMING;
            ret STEP_HEADERS;
        }
        if (event.kind == engine_h1.EVENT_RESPONSE_BODY) {
            # the same bytes reported again are backpressure, not progress
            if (link.engine.held_length == link.reported_held) { ret STEP_BLOCKED; }
            link.reported_held = link.engine.held_length;
        }
        ret STEP_PROGRESS;
    }
    if (link.state == DONE) { ret STEP_DONE; }
    ret STEP_BLOCKED;
}

# take whatever response body bytes the engine is holding
pub fun take_body(link: *Link, output: *u8, capacity: usize, produced: *usize,
    complete: *bool) bool {
    if (link == nil || produced == nil || complete == nil) { ret false; }
    @produced = 0;
    @complete = link.inbound_complete;
    if (!link.initialized || link.slot == engine_h1.NO_SLOT) { ret false; }
    if (link.engine.held_slot != link.slot || link.engine.held_length == 0) {
        link.reported_held = 0;
        ret true;
    }
    var count: usize = link.engine.held_length;
    if (count > capacity) { count = capacity; }
    var i: usize = 0;
    for (i < count) {
        output[i] = link.engine.held_body[i];
        i         = i + 1;
    }
    if (!engine_h1.consume_body(?link.engine, link.slot, count)) { ret false; }
    link.reported_held = link.engine.held_length;
    @produced          = count;
    @complete          = link.inbound_complete && link.engine.held_length == 0;
    ret true;
}

pub fun release(link: *Link) bool {
    if (link == nil) { ret false; }
    close(link);
    ret true;
}

pub fun close(link: *Link) bool {
    if (link == nil || link.state == FREE) { ret false; }
    if (!link.close_started) {
        link.close_started = true;
        link.state         = CLOSING;
        if (link.connect_pending) { transition_ok(cancel.cancel(?link.operation_root)); }
        if (link.initialized) {
            link.engine_close_owned = link.engine_close_owned
                || link.engine.state == engine_h1.CLOSED
                || link.engine.close_pending;
            if (!engine_h1.cancel_connection(?link.engine)
                && link.engine.state != engine_h1.CLOSED) {
                link.close_failed = true;
            }
            link.engine_close_owned = link.engine_close_owned
                || link.engine.state == engine_h1.CLOSED
                || link.engine.close_pending;
        }
    }
    if (link.connect_pending) { ret false; }
    if (link.initialized) {
        if (link.slot != engine_h1.NO_SLOT
            && link.engine_slots[link.slot].state != engine_h1.SLOT_FREE
            && !link.engine_slots[link.slot].released) {
            val sequence: u64 = link.engine_slots[link.slot].sequence;
            if (sequence == 0
                || !engine_h1.abandon(?link.engine, link.slot, sequence)) {
                link.close_failed = true;
            }
        }
        if (!engine_h1.destroy(?link.engine)) { ret false; }
        link.initialized = false;
        if (link.engine_close_owned) { link.has_stream = false; }
    }
    if (link.has_stream) {
        val closed: err[io_error.Error] = tcp.stream_close(?link.stream);
        if (sel closed.err) { link.close_failed = true; }
        link.has_stream = false;
    }
    if (link.account_live) {
        if (!memory.close(link.borrower.memory, ?link.account)) { link.close_failed = true; }
        link.account_live = false;
    }
    if (link.scopes_live) {
        if (!operation_ok(cancel.destroy(?link.engine_scope))
            || !operation_ok(cancel.destroy(?link.control_scope))
            || !operation_ok(cancel.destroy(?link.operation_root))) { link.close_failed = true; }
        link.scopes_live = false;
    }
    link.leased = false;
    link.state  = FREE;
    ret !link.close_failed;
}

pub fun closing(link: *Link) bool {
    ret link != nil && link.state == CLOSING;
}

pub fun teardown_failed(link: *Link) bool {
    ret link != nil && link.close_failed;
}
