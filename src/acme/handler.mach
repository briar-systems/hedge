# the route that answers an http-01 challenge
#
# the authority validates a name by fetching a token from the server that
# claims it, so hedge answers with its own listener rather than standing up a
# second one. the handler reads the token table the challenge provider fills
# and nothing else: it holds no key, opens no file, and cannot serve a byte
# that a presentation did not put there.
#
# an unknown token is a plain 404. hedge does not distinguish "no challenge is
# outstanding" from "that is not the token", because the difference is only
# useful to somebody probing for one.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use hedge.config.schema;
use call: hedge.dispatch.call;
use service: hedge.service;
use challenge: hedge.acme.challenge;

pub val CONTENT_TYPE: str = "application/octet-stream";

pub rec Binding {
    table: *challenge.Http01;
    live:  bool;
}

pub fun bind(binding: *Binding, table: *challenge.Http01) bool {
    if (binding == nil || table == nil) { ret false; }
    binding.table = table;
    binding.live = true;
    ret true;
}

fun serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val binding: *Binding = context::*Binding;
    if (binding == nil || !binding.live || active == nil) {
        ret exchange.SERVICE_FAILED;
    }
    val request: *message.Request = call.request(active);
    if (request == nil) { ret exchange.SERVICE_FAILED; }
    if (request.method.kind != method.GET
     && request.method.kind != method.HEAD) {
        ret service.respond(active, 405);
    }
    var token: view.View;
    var answer: view.View;
    if (!challenge.http01_token(request.target.path, ?token)
     || !challenge.http01_answer(binding.table, token, ?answer)) {
        ret service.respond(active, 404);
    }
    val response: *message.Response = call.response(active);
    if (response == nil
     || message.set_status(response, status.OK) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    # rfc 8555 section 8.3: the body is the key authorization and the media
    # type is unconstrained, so it is declared as opaque octets
    if (!service.add_field(active, field.CONTENT_TYPE, CONTENT_TYPE)) {
        ret exchange.SERVICE_FAILED;
    }
    if (request.method.kind == method.HEAD) {
        ret service.commit_bodyless(active, call.BODY_DRAIN);
    }
    ret service.respond_with_bytes(active, answer.data, answer.len);
}

fun build(context: ptr, configured: *schema.Service,
    handler: *service.Handler) bool {
    val binding: *Binding = context::*Binding;
    if (binding == nil || !binding.live || handler == nil) { ret false; }
    @handler = service.Handler{ctx: binding::ptr, serve: serve};
    ret true;
}

# the native service factory a generation resolves an acme challenge route to
pub fun factory(binding: *Binding) service.Factory {
    var value: service.Factory;
    value.ctx = binding::ptr;
    value.build = build;
    ret value;
}
