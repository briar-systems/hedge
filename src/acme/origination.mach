# originating one TLS connection to an ACME authority
#
# hedge terminates TLS for the connections it serves. this is the other
# direction, and the only place hedge is a TLS client: reaching the authority
# that issues its certificates. one connection at a time, because ACME is one
# exchange at a time.
#
# the engine lives in module state rather than in the transport that drives it,
# and that is forced rather than chosen. a mach-tls client holds secret-welded
# storage, so a record containing one cannot be erased to the untyped `ptr`
# that the serving plane hands every subsystem. the transport keeps no engine
# and reaches this module by call; the welded state never crosses a `ptr`.
#
# the lower half is the same shape hedge's listener side uses: mach-tls submits
# reads, writes and closes through a transport descriptor, and the completions
# come back through whatever loop owns the driver.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.err;
use std.chrono.time;
use std.net.tcp;
use std.sync.cancel;
use std.system.os;
use io_error: std.io.error;
use io_runtime: std.io.runtime;
use lifecycle: std.io.lifecycle;
use net_async: std.net.async;
use contracts: crypto.contracts;
use secret: crypto.secret;
use cert: tls.cert;
use tls_client: tls.client;
use tls_config: tls.config;
use tls_engine: tls.engine;
use tls_error: tls.error;
use tls_record: tls.record;
use tls_stream: tls.stream;
use tls_transport: tls.transport;
use tls13: tls.tls13;

pub val WIRE_BYTES: usize = tls_record.HEADER_SIZE + tls_record.MAX_CIPHERTEXT;
pub val HANDSHAKE_INPUT_BYTES: usize = 16384;
pub val HANDSHAKE_OUTPUT_BYTES: usize = 16384;
pub val HELLO_BYTES: usize = 8192;
pub val PEER_PARAMETER_BYTES: usize = 2048;
pub val PEER_CERTIFICATES: usize = 8;
pub val MAX_CHAIN_BYTES: usize = 32768;
pub val MAX_SERVER_NAME: usize = 253;

# the completion tag the lower half submits under. the transport that owns the
# driver routes anything carrying it back here.
pub val COMPLETION_CONTEXT: usize = 5;

pub def Status: u8;
pub val OK:      Status = 1;
pub val PENDING: Status = 2;
pub val FAILED:  Status = 3;
pub val INVALID: Status = 4;

pub def Kind: u8;
pub val NONE:      Kind = 0;
pub val HANDSHAKE: Kind = 1;
pub val READ:      Kind = 2;
pub val WRITE:     Kind = 3;
pub val SHUTDOWN:  Kind = 4;

# the half that is erased to `ptr` for mach-tls's transport descriptor. it
# holds no secret, which is what makes the erasure legal.
rec Channel {
    driver:     *net_async.Driver;
    socket:     *tcp.Stream;
    generation: u32;
    live:       bool;
}

# the half that is never erased
rec Session {
    lower:             tls_transport.Transport;
    configuration:     tls_config.ClientConfig;
    engine:            tls_client.Client;
    stream:            tls_stream.Stream;
    entropy:           secret.Entropy;
    versions:          [1]u16;
    suites:            [3]tls13.CipherSuite;
    groups:            [2]tls13.NamedGroup;
    signatures:        [4]tls13.SignatureScheme;
    alpn:              [1]tls_config.ProtocolName;
    alpn_storage:      [8]u8;
    server_name:       [MAX_SERVER_NAME]u8;
    server_name_len:   usize;
    handshake_input:   [HANDSHAKE_INPUT_BYTES]u8;
    handshake_output:  [HANDSHAKE_OUTPUT_BYTES]u8;
    hello:             [HELLO_BYTES]u8;
    peer_parameters:   [PEER_PARAMETER_BYTES]u8;
    peer_certificates: [PEER_CERTIFICATES]cert.Certificate;
    wire_input:        [WIRE_BYTES]u8;
    wire_output:       [WIRE_BYTES]u8;
    root:              cancel.Scope;
    operation_scope:   cancel.Scope;
    root_live:         bool;
    operation_live:    bool;
    engine_started:    bool;
    stream_started:    bool;
}

var channel: Channel;
var session: Session;
var current: Kind;
var settled_bytes: usize;
var failure_value: tls_error.Error;
var established_flag: bool;
var live_flag: bool;

fun lower_read(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || !value.live || value.driver == nil
     || value.socket == nil) {
        ret err[io_runtime.Token, io_error.Error](
            io_error.from_code(os.EINVAL, io_error.OP_READ));
    }
    ret net_async.submit_read(value.driver, scope, value.socket, buffer,
        length, COMPLETION_CONTEXT);
}

fun lower_write(context: ptr, scope: *cancel.Scope, buffer: *u8, length: usize,
    token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || !value.live || value.driver == nil
     || value.socket == nil) {
        ret err[io_runtime.Token, io_error.Error](
            io_error.from_code(os.EINVAL, io_error.OP_WRITE));
    }
    ret net_async.submit_write(value.driver, scope, value.socket, buffer,
        length, COMPLETION_CONTEXT);
}

fun lower_shutdown(context: ptr, scope: *cancel.Scope,
    token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || !value.live || value.driver == nil
     || value.socket == nil) {
        ret err[io_runtime.Token, io_error.Error](
            io_error.from_code(os.EINVAL, io_error.OP_SHUTDOWN));
    }
    ret net_async.submit_shutdown_write(value.driver, scope, value.socket,
        COMPLETION_CONTEXT);
}

fun lower_close(context: ptr, scope: *cancel.Scope,
    token_context: usize) Result[io_runtime.Token, io_error.Error] {
    val value: *Channel = context::*Channel;
    if (value == nil || !value.live || value.driver == nil
     || value.socket == nil) {
        ret err[io_runtime.Token, io_error.Error](
            io_error.from_code(os.EINVAL, io_error.OP_CLOSE));
    }
    ret net_async.submit_stream_close(value.driver, scope, value.socket,
        lifecycle.EXPLICIT, COMPLETION_CONTEXT);
}

fun overlaps(base: usize, size: usize, data: *u8, len: usize) bool {
    if (base == 0 || size == 0) { ret false; }
    val start: usize = (data)::usize;
    ret start < base + size && base < start + len;
}

# an application buffer that aliased this transport's own state would be
# mutated under the engine, so mach-tls asks and this answers honestly
fun lower_aliases(context: ptr, data: *u8, len: usize) bool {
    val value: *Channel = context::*Channel;
    if (value == nil || data == nil || len == 0) { ret false; }
    if (overlaps((value)::usize, $size_of(Channel), data, len)) { ret true; }
    if (value.socket != nil
     && overlaps((value.socket)::usize, $size_of(tcp.Stream), data, len)) {
        ret true;
    }
    ret value.driver != nil
        && io_runtime.aliases(value.driver.runtime, data, len);
}

fun descriptor() tls_transport.Transport {
    var value: tls_transport.Transport;
    value.runtime = channel.driver.runtime;
    value.context = (?channel)::ptr;
    value.context_size = $size_of(Channel);
    value.aliases_state = lower_aliases;
    value.submit_read = lower_read;
    value.submit_write = lower_write;
    value.submit_shutdown = lower_shutdown;
    value.submit_close = lower_close;
    value.submit_abort = lower_close;
    ret value;
}

fun storage() tls_client.Storage {
    var value: tls_client.Storage;
    value.input = ?session.handshake_input[0];
    value.input_capacity = HANDSHAKE_INPUT_BYTES;
    value.output = ?session.handshake_output[0];
    value.output_capacity = HANDSHAKE_OUTPUT_BYTES;
    value.hello = ?session.hello[0];
    value.hello_capacity = HELLO_BYTES;
    value.certificates = ?session.peer_certificates[0];
    value.certificate_capacity = PEER_CERTIFICATES;
    value.peer_parameters = ?session.peer_parameters[0];
    value.peer_parameters_capacity = PEER_PARAMETER_BYTES;
    ret value;
}

fun stream_storage() tls_stream.Storage {
    var value: tls_stream.Storage;
    value.wire_input = ?session.wire_input[0];
    value.wire_input_capacity = WIRE_BYTES;
    value.wire_output = ?session.wire_output[0];
    value.wire_output_capacity = WIRE_BYTES;
    ret value;
}

fun limits() tls_config.Limits {
    var value: tls_config.Limits = tls_config.production_limits();
    value.max_peer_handshake_bytes = HANDSHAKE_INPUT_BYTES;
    value.max_client_hello_bytes = HELLO_BYTES;
    value.max_client_flight_bytes = HANDSHAKE_OUTPUT_BYTES;
    value.max_server_flight_bytes = HANDSHAKE_INPUT_BYTES;
    value.max_chain_bytes = MAX_CHAIN_BYTES;
    value.max_ticket_bytes = 4096;
    ret value;
}

fun offer_http11() {
    val name: str = "http/1.1";
    var i: usize = 0;
    for (i < 8) {
        session.alpn_storage[i] = name[i];
        i = i + 1;
    }
    session.alpn[0] = tls_config.ProtocolName{
        data: ?session.alpn_storage[0], len: 8};
}

fun configure(trust: *cert.TrustStore) {
    session.versions[0] = tls13.VERSION;
    session.suites[0] = tls13.AES_128_GCM_SHA256;
    session.suites[1] = tls13.AES_256_GCM_SHA384;
    session.suites[2] = tls13.CHACHA20_POLY1305_SHA256;
    session.groups[0] = tls13.X25519;
    session.groups[1] = tls13.SECP256R1;
    session.signatures[0] = tls13.ED25519;
    session.signatures[1] = tls13.ECDSA_SECP256R1_SHA256;
    session.signatures[2] = tls13.RSA_PSS_RSAE_SHA256;
    session.signatures[3] = tls13.RSA_PSS_RSAE_SHA384;
    session.entropy = secret.system_entropy();
    offer_http11();
    var value: tls_config.ClientConfig;
    value.server_name = contracts.Bytes{data: ?session.server_name[0],
        len: session.server_name_len};
    value.alpn = ?session.alpn[0];
    value.alpn_len = 1;
    value.trust = trust;
    value.versions = ?session.versions[0];
    value.version_len = 1;
    value.suites = ?session.suites[0];
    value.suite_len = 3;
    value.groups = ?session.groups[0];
    value.group_len = 2;
    value.signatures = ?session.signatures[0];
    value.signature_len = 4;
    value.client_identity = nil;
    value.entropy = ?session.entropy;
    value.entropy_context_size = 0;
    value.sessions = nil;
    value.limits = limits();
    session.configuration = value;
}

fun next_token() tls_transport.Token {
    var generation: u32 = channel.generation + 1;
    if (generation == 0) { generation = 1; }
    channel.generation = generation;
    ret tls_transport.Token{index: 1, generation: generation};
}

fun renew_operation_scope() bool {
    if (session.operation_live) {
        cancel.destroy(?session.operation_scope);
        session.operation_live = false;
    }
    if (!cancel.make_child(?session.operation_scope, ?session.root, false,
        time.Time{sec: 0, nsec: 0})) { ret false; }
    session.operation_live = true;
    ret true;
}

pub fun active() bool {
    ret live_flag;
}

pub fun established() bool {
    ret live_flag && established_flag;
}

pub fun failure() tls_error.Error {
    ret failure_value;
}

pub fun transferred() usize {
    ret settled_bytes;
}

pub fun negotiated() tls_engine.Snapshot {
    ret tls_stream.negotiated(?session.stream);
}

# begins one TLS connection over a socket the caller has already connected.
# `trust` is the anchor set the authority is verified against; without one
# there is nothing to verify against and the connection is refused.
pub fun begin(driver: *net_async.Driver, socket: *tcp.Stream,
    server_name: view.View, trust: *cert.TrustStore,
    verification_time: i64) Status {
    if (live_flag) { ret INVALID; }
    if (driver == nil || socket == nil || trust == nil || trust.len == 0
     || server_name.data == nil || server_name.len == 0
     || server_name.len > MAX_SERVER_NAME) { ret INVALID; }
    channel.driver = driver;
    channel.socket = socket;
    channel.generation = 0;
    channel.live = true;
    session.root_live = false;
    session.operation_live = false;
    session.engine_started = false;
    session.stream_started = false;
    current = NONE;
    settled_bytes = 0;
    established_flag = false;
    failure_value = tls_error.OK;
    var i: usize = 0;
    for (i < server_name.len) {
        session.server_name[i] = server_name.data[i];
        i = i + 1;
    }
    session.server_name_len = server_name.len;
    configure(trust);
    var extra: tls_client.ExtraExtension;
    extra.kind = 0;
    extra.data = contracts.Bytes{data: nil, len: 0};
    if (!tls_client.init(?session.engine, ?session.configuration, storage(),
        extra, 0)) { ret FAILED; }
    session.engine_started = true;
    if (!cancel.make_root(?session.root, false, time.Time{sec: 0, nsec: 0})) {
        ret FAILED;
    }
    session.root_live = true;
    if (!renew_operation_scope()) { ret FAILED; }
    session.lower = descriptor();
    live_flag = true;
    if (!tls_stream.connect(?session.stream, ?session.engine, stream_storage(),
        ?session.lower, ?session.operation_scope, next_token(),
        verification_time, 0)) {
        failure_value = tls_error.INTERNAL_ERROR;
        ret FAILED;
    }
    session.stream_started = true;
    current = HANDSHAKE;
    ret PENDING;
}

# routes one socket completion into the engine
pub fun accept(completion: *io_runtime.Completion) bool {
    if (!live_flag || !session.stream_started) { ret false; }
    ret tls_stream.accept(?session.stream, completion);
}

# resolves the operation in flight, if it has finished
pub fun poll() Status {
    if (!live_flag) { ret INVALID; }
    if (current == NONE) { ret OK; }
    val snapshot: tls_transport.Snapshot = tls_transport.snapshot(
        ?session.stream.operation);
    if (snapshot.state != tls_transport.OPERATION_TERMINAL) { ret PENDING; }
    val kind: Kind = current;
    current = NONE;
    settled_bytes = snapshot.application_bytes;
    failure_value = snapshot.terminal_error;
    tls_stream.destroy_operation(?session.stream);
    if (snapshot.terminal_error != tls_error.OK) { ret FAILED; }
    if (kind == HANDSHAKE) { established_flag = true; }
    ret OK;
}

fun start(kind: Kind, buffer: *u8, length: usize) Status {
    if (!live_flag || current != NONE) { ret INVALID; }
    if (kind != SHUTDOWN && !established_flag) { ret INVALID; }
    if (!renew_operation_scope()) { ret FAILED; }
    val token: tls_transport.Token = next_token();
    var started: bool = false;
    if (kind == READ) {
        started = tls_stream.read(?session.stream, ?session.operation_scope,
            token, buffer, length, 0);
    } or (kind == WRITE) {
        started = tls_stream.write(?session.stream, ?session.operation_scope,
            token, buffer, length, 0);
    } or {
        started = tls_stream.half_close(?session.stream,
            ?session.operation_scope, token, 0);
    }
    if (!started) {
        failure_value = tls_error.INTERNAL_ERROR;
        ret FAILED;
    }
    current = kind;
    settled_bytes = 0;
    ret PENDING;
}

pub fun start_read(buffer: *u8, length: usize) Status {
    ret start(READ, buffer, length);
}

pub fun start_write(buffer: *u8, length: usize) Status {
    ret start(WRITE, buffer, length);
}

pub fun peer_closed() bool {
    if (!live_flag || !session.stream_started) { ret false; }
    val view: tls_stream.Snapshot = tls_stream.snapshot(?session.stream);
    ret view.peer_closed || view.state == tls_stream.CLOSED;
}

pub fun operating() bool {
    ret live_flag && current != NONE;
}

# releases the engine and every scope it borrowed. the socket belongs to the
# caller and is closed by whoever opened it.
pub fun release() bool {
    if (!live_flag) { ret false; }
    if (session.stream_started) {
        tls_stream.destroy(?session.stream);
        session.stream_started = false;
    }
    if (session.engine_started) {
        tls_client.destroy(?session.engine);
        session.engine_started = false;
    }
    if (session.operation_live) {
        cancel.destroy(?session.operation_scope);
        session.operation_live = false;
    }
    if (session.root_live) {
        cancel.destroy(?session.root);
        session.root_live = false;
    }
    channel.live = false;
    channel.driver = nil;
    channel.socket = nil;
    current = NONE;
    established_flag = false;
    live_flag = false;
    ret true;
}
