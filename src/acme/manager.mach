# the certificate manager: one managed certificate, its account session and
# its schedule
#
# a deployment runs one manager per configured certificate, so each renews on
# its own schedule and one certificate's failure never holds another back.
# this is the part of acme that runs forever. it owns the durable state, the
# renewal schedule, and the issuance run, and it advances all three from the
# serving loop's plane without ever blocking it.
#
# it does not own the tls credentials and cannot: mach-tls's private key type
# is secret-qualified, so a record holding it cannot be erased to the `ptr` a
# plane callback receives. so the direction of the handoff is fixed by the
# language and not by preference. the manager produces a verified chain and
# its key material and reports that an installation is ready; the owner of the
# credential generation, which holds typed pointers to all of it, installs and
# rotates. data flows one way and the welded types stay out of the plane.

use cert: acme.certificate;
use ch:   acme.challenge;
use acme.identifier;
use acme.problem;
use acme.renewal;
use acme.renewal_info;
use acme.storage;
use crypto.contracts;
use hedge.acme.challenge;
use hedge.acme.durable;
use hedge.acme.issue;
use hedge.acme.keys;
use hedge.acme.session;
use hedge.clock;
use hedge.config.schema;
use hedge.outbound;
use hedge.outbound.wire;
use hedge.telemetry;
use hedge.wake;
use http.core.field;
use std.allocator;
use std.allocator.fixed;
use T: std.chrono.time;
use std.crypto.rand;
use fs:        std.filesystem;
use io_error:  std.io.error;
use net_async: std.net.async;
use std.net.ip;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.path.Path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use tls.cert.bundle;

#[testing]
fun present(outcome: res[bool, io_error.Error]) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun wall_now() T.Time {
    val sampled: T.Clock = T.now();
    if (sel sampled.ok) { ret sampled.ok; }
    ret T.Time{sec: 0, nsec: 0};
}

#[testing]
fun fixed_ok(outcome: err[allocator.Error]) bool {
    ret sel outcome.ok;
}

pub val MAX_NAMES:       usize = 8;
pub val MAX_NAME_BYTES:  usize = 256;
pub val MAX_URL_BYTES:   usize = 512;
pub val REQUEST_BYTES:   usize = 8192;
pub val RESPONSE_BYTES:  usize = 65536;
pub val MAX_FIELDS:      usize = 64;
pub val MAX_CHAIN_BYTES: usize = 16384;
# a certificate's label, its configured id
pub val MAX_LABEL_BYTES: usize = 49;

pub def Status: u8;
pub val OK:      Status = 1;
pub val PENDING: Status = 2;
pub val FAILED:  Status = 3;
pub val INVALID: Status = 4;
# a key file in the store group or other can read, named by `refused_key`
pub val EXPOSED: Status = 5;

pub def State: u8;
# nothing is due; the plane costs one comparison per round
pub val IDLE:        State = 0;
pub val DISCOVERING: State = 1;
pub val ISSUING:     State = 2;
# a verified certificate is waiting for its owner to install it
pub val INSTALLING: State = 3;
pub val ADVISING:   State = 4;
pub val STOPPED:    State = 5;

# a certificate's standing as telemetry reads it at scrape time, on a thread
# other than the supervisor's that drives the manager
pub rec Report {
    # a certificate is held, and when it expires, as unix seconds
    held:      bool;
    not_after: u64;
    # issuance attempts by outcome, and failures since the last success
    succeeded:            u64;
    failed:               u64;
    consecutive_failures: u64;
    # when this process last obtained a certificate, zero until it has
    last_issued_unix: u64;
}

pub rec Manager {
    store:    durable.Store;
    session:  session.Session;
    client:   outbound.Client;
    exchange: outbound.Exchange;
    link:     session.Link;
    # the anchors an https authority is verified against, drawn from `heap`
    anchors:        bundle.Loaded;
    anchors_live:   bool;
    heap:           *allocator.Allocator;
    run:            issue.Issue;
    table:          challenge.Http01;
    zone:           challenge.Dns01;
    challenge_kind: u8;
    responder:      challenge.Responder;

    request:  [REQUEST_BYTES]u8;
    response: [RESPONSE_BYTES]u8;
    items:    [MAX_FIELDS]field.Field;

    account:     keys.Key;
    pending_key: keys.Key;
    active_key:  keys.Key;

    # which configured certificate this is, and how reports name it
    index:         usize;
    label:         [MAX_LABEL_BYTES]u8;
    label_len:     usize;
    component:     [MAX_LABEL_BYTES + 6]u8;
    component_len: usize;

    name_bytes: [MAX_NAMES][MAX_NAME_BYTES]u8;
    name_lens:  [MAX_NAMES]usize;
    names:      [MAX_NAMES]identifier.Identifier;
    name_count: usize;

    directory_url:       [MAX_URL_BYTES]u8;
    directory_len:       usize;
    contact:             [MAX_NAME_BYTES]u8;
    contact_len:         usize;
    certificate_url:     [MAX_URL_BYTES]u8;
    certificate_url_len: usize;

    chain:       [MAX_CHAIN_BYTES]u8;
    chain_bytes: usize;
    chain_count: usize;
    not_before:  u64;
    not_after:   u64;

    advice_url: [MAX_URL_BYTES]u8;
    advice_len: usize;
    advice:     renewal_info.Window;

    schedule:         renewal.Schedule;
    storage_key:      view.View;
    generation:       u64;
    have_certificate: bool;
    agree_terms:      bool;

    observability: *telemetry.Runtime;
    issued:        u64;
    failures:      u64;
    last_failure:  problem.Error;
    # failures since the last issuance, and when this process last issued one
    consecutive_failures: u64;
    last_issued_unix:     u64;
    # what telemetry reads from another thread, published under `report_lock`
    report_lock: mutex.Mutex;
    reported:    Report;

    state: State;
    live:  bool;
}

fun random_next(context: ptr) u64 {
    ret rand.u64();
}

# a fleet that renews in lockstep is a fleet that fails in lockstep
fun jitter() renewal.Random {
    var value: renewal.Random;
    value.ctx  = nil;
    value.next = random_next;
    ret value;
}

fun policy(graph: *schema.Graph) renewal.Policy {
    var value: renewal.Policy = renewal.policy_default();
    if (graph.acme.renew_before_seconds != 0) {
        value.renew_before_seconds = graph.acme.renew_before_seconds;
    }
    ret value;
}

fun report(manager: *Manager, operation: str, code: str, message: str) {
    if (manager.observability == nil) { ret; }
    telemetry.error(manager.observability, telemetry.Failure{
        component: (?manager.component[0])::str, operation: operation, code: code,
        message:   message, trace_id: nil
    });
}

# the store's key file an open refused as exposed, nil when none was
pub fun refused_key(manager: *Manager) str {
    if (manager == nil) { ret nil; }
    ret durable.refused_key(?manager.store);
}

pub fun attach_telemetry(manager: *Manager,
    observability: *telemetry.Runtime) bool {
    if (manager == nil || !manager.live) { ret false; }
    manager.observability = observability;
    ret true;
}

fun copy_names(manager: *Manager, certificate: *schema.AcmeCertificate) bool {
    if (certificate.name_count == 0
        || certificate.name_count > MAX_NAMES) { ret false; }
    var i: usize = 0;
    for (i < certificate.name_count) {
        val configured: *schema.Text = ?certificate.names[i];
        if (configured.len == 0 || configured.len >= MAX_NAME_BYTES) {
            ret false;
        }
        var j: usize = 0;
        for (j < configured.len) {
            manager.name_bytes[i][j] = configured.data[j];
            j                        = j + 1;
        }
        manager.name_lens[i] = configured.len;
        manager.names[i]     = identifier.Identifier{kind: identifier.DNS,
            value: view.view(?manager.name_bytes[i][0], configured.len)};
        i = i + 1;
    }
    manager.name_count  = certificate.name_count;
    manager.storage_key = manager.names[0].value;
    ret true;
}

# the label reports carry, and the telemetry component `acme.<label>`
fun set_label(manager: *Manager, certificate: *schema.AcmeCertificate) bool {
    if (certificate.id.len == 0) { ret false; }
    val label:  str   = schema.text(?certificate.id);
    var length: usize = 0;
    for (label[length] != 0) {
        if (length + 1 >= MAX_LABEL_BYTES) { ret false; }
        manager.label[length]         = label[length];
        manager.component[5 + length] = label[length];
        length                        = length + 1;
    }
    val prefix: str   = "acme.";
    var i:      usize = 0;
    for (i < 5) {
        manager.component[i] = prefix[i];
        i                    = i + 1;
    }
    manager.label[length]         = 0;
    manager.label_len             = length;
    manager.component[5 + length] = 0;
    manager.component_len         = 5 + length;
    ret true;
}

# the certificate's label, its configured id
pub fun label(manager: *Manager) str {
    if (manager == nil) { ret nil; }
    ret (?manager.label[0])::str;
}

# `acme.<label>`, which names the certificate in telemetry and health
pub fun component(manager: *Manager) str {
    if (manager == nil) { ret nil; }
    ret (?manager.component[0])::str;
}

# a manager as telemetry sees one, for tests of what is read from it
#[testing]
pub fun test_reported(manager: *Manager, id: str, value: Report) {
    var length: usize = 0;
    for (id[length] != 0 && length + 1 < MAX_LABEL_BYTES) {
        manager.label[length] = id[length];
        length                = length + 1;
    }
    manager.label[length] = 0;
    manager.label_len     = length;
    manager.report_lock   = mutex.make();
    manager.reported      = value;
}

# which configured certificate the manager holds
pub fun certificate_index(manager: *Manager) usize {
    ret manager.index;
}

fun copy_text(target: *u8, capacity: usize, source: *schema.Text,
    length: *usize) bool {
    if (source.len >= capacity) { ret false; }
    var i: usize = 0;
    for (i < source.len) {
        target[i] = source.data[i];
        i         = i + 1;
    }
    @length = source.len;
    ret true;
}

pub val USER_AGENT: str = "hedge-acme/0.1";

# the authority is reached at the address its name resolves to once, here, so
# the supervisor's thread never waits on a resolver afterwards. an authority
# configured with an origin is reached in cleartext through that front end.
fun configure_authority(manager: *Manager, a: *allocator.Allocator,
    graph: *schema.Graph) bool {
    var target: wire.Target;
    if (!wire.split_url(view.view(?manager.directory_url[0],
        manager.directory_len), ?target)) { ret false; }
    if (graph.acme.origin.len == 0) {
        if (!target.secure) { ret false; }
        # a bundle with skipped blocks still loads: the skips are the blocks
        # this build cannot use as anchors, and at least one anchor is required
        val loaded: bundle.Status = bundle.load(a, schema.text(?graph.acme.trust),
            ?manager.anchors);
        # a bundle with no usable anchor still holds its report of what it skipped
        if (loaded == bundle.NO_ANCHORS) { bundle.release(a, ?manager.anchors); }
        if (loaded != bundle.OK)         { ret false; }
        manager.anchors_live = true;
        if (!outbound.set_trust(?manager.client, ?manager.anchors.bundle.store)) {
            ret false;
        }
        var endpoint: ip.Endpoint;
        if (!outbound.resolve_now(target.host, target.port, ?endpoint)) {
            ret false;
        }
        ret outbound.route(?manager.client, target.host,
            outbound.secure_origin(endpoint));
    }
    var text: [64]u8;
    if (graph.acme.origin.len >= 64) { ret false; }
    var i: usize = 0;
    for (i < graph.acme.origin.len) {
        text[i] = graph.acme.origin.data[i];
        i       = i + 1;
    }
    text[graph.acme.origin.len] = 0;
    val parsed: res[ip.Endpoint, ip.ParseError] = ip.endpoint_parse((?text[0])::str);
    if (sel parsed.err) { ret false; }
    ret outbound.route(?manager.client, target.host,
        outbound.cleartext_origin(parsed.ok));
}

# splits a stored chain back into its certificates. the durable record holds
# the der end to end plus a count, and der states its own lengths, so the
# boundaries are recovered rather than stored twice.
pub fun chain_entry(manager: *Manager, index: usize,
    output: *view.View) bool {
    if (manager == nil || output == nil || index >= manager.chain_count) {
        ret false;
    }
    var at:   usize = 0;
    var seen: usize = 0;
    for (seen <= index) {
        if (at + 2 > manager.chain_bytes) { ret false; }
        if (manager.chain[at] != 0x30)    { ret false; }
        val first:  u8    = manager.chain[at + 1];
        var header: usize = 2;
        var length: usize = 0;
        if ((first & 0x80) == 0) {
            length = first::usize;
        }
        or {
            val count: usize = (first & 0x7f)::usize;
            if (count == 0 || count > 4 || at + 2 + count > manager.chain_bytes) {
                ret false;
            }
            var i: usize = 0;
            for (i < count) {
                length = (length << 8) | manager.chain[at + 2 + i]::usize;
                i      = i + 1;
            }
            header = 2 + count;
        }
        if (length == 0 || header + length > manager.chain_bytes - at) {
            ret false;
        }
        if (seen == index) {
            @output = view.view(?manager.chain[at], header + length);
            ret true;
        }
        at   = at + header + length;
        seen = seen + 1;
    }
    ret false;
}

pub fun chain_count(manager: *Manager) usize {
    if (manager == nil) { ret 0; }
    ret manager.chain_count;
}

pub fun certificate_key(manager: *Manager) *keys.Key {
    ret ?manager.active_key;
}

pub fun name(manager: *Manager, index: usize) view.View {
    if (manager == nil || index >= manager.name_count) {
        ret view.view(nil, 0);
    }
    ret manager.names[index].value;
}

pub fun name_count(manager: *Manager) usize {
    if (manager == nil) { ret 0; }
    ret manager.name_count;
}

pub fun not_after(manager: *Manager) u64 {
    ret manager.not_after;
}

pub fun state(manager: *Manager) State {
    if (manager == nil) { ret STOPPED; }
    ret manager.state;
}

pub fun issued_count(manager: *Manager) u64 {
    ret manager.issued;
}

pub fun failure_count(manager: *Manager) u64 {
    ret manager.failures;
}

pub fun last_failure(manager: *Manager) problem.Error {
    ret manager.last_failure;
}

pub fun challenge_table(manager: *Manager) *challenge.Http01 {
    ret ?manager.table;
}

# a certificate is ready to be installed into a credential generation
pub fun installation_ready(manager: *Manager) bool {
    ret manager != nil && manager.live && manager.state == INSTALLING;
}

# a recovered certificate can be installed before the listener accepts.
pub fun certificate_ready(manager: *Manager) bool {
    ret manager != nil && manager.live && manager.have_certificate
        && manager.chain_count != 0 && manager.chain_bytes != 0
        && manager.active_key.live;
}

# the owner acknowledges that it has installed what was ready. the manager
# does not decide when that happened, because it is not what holds the
# credentials.
pub fun installed(manager: *Manager, now: T.Time) bool {
    if (manager == nil || manager.state != INSTALLING) { ret false; }
    manager.state = ADVISING;
    return_to_schedule(manager, now);
    ret true;
}

fun load_certificate(manager: *Manager) Status {
    var snapshot: storage.CertificateSnapshot;
    val found:    durable.Status = durable.certificate_snapshot(?manager.store,
        manager.storage_key, ?snapshot);
    if (found == durable.MISSING) { ret OK; }
    if (found != durable.OK)      { ret FAILED; }
    if (snapshot.current.chain_der.len == 0
        || snapshot.current.chain_der.len > MAX_CHAIN_BYTES) { ret FAILED; }
    var i: usize = 0;
    for (i < snapshot.current.chain_der.len) {
        manager.chain[i] = snapshot.current.chain_der.data[i];
        i                = i + 1;
    }
    manager.chain_bytes = snapshot.current.chain_der.len;
    manager.chain_count = snapshot.current.chain_len;
    manager.not_before  = snapshot.current.not_before_unix;
    manager.not_after   = snapshot.current.not_after_unix;
    manager.generation  = snapshot.current.generation;
    val key: durable.Status = durable.open_certificate_key(?manager.store,
        manager.generation, ?manager.active_key);
    if (key == durable.EXPOSED) { ret EXPOSED; }
    if (key != durable.OK) {
        # the record and its key are written together; a record whose key is
        # gone is unusable and the next renewal replaces both
        report(manager, "load", "key-missing",
            "the stored certificate has no usable private key");
        manager.chain_count = 0;
        ret OK;
    }
    manager.have_certificate = true;
    ret OK;
}

# http-01 is what a server can answer by itself, and it is the only challenge
# a toml deployment can select. dns-01 needs a zone, which hedge does not have
# and will not invent: an embedder supplies the two calls that publish and
# withdraw a record, and gets dns-01 with everything else identical.
# the configured certificate at `index`, or nil past the last
fun configured(graph: *schema.Graph, index: usize) *schema.AcmeCertificate {
    if (graph == nil || index >= graph.acme.certificate_count) { ret nil; }
    ret ?graph.acme.certificates[index];
}

# `index` names the configured certificate the manager holds
pub fun open(manager: *Manager, a: *allocator.Allocator,
    graph: *schema.Graph, index: usize) Status {
    val certificate: *schema.AcmeCertificate = configured(graph, index);
    if (manager == nil || certificate == nil)              { ret INVALID; }
    if (certificate.challenge != schema.CHALLENGE_HTTP_01) { ret INVALID; }
    if (!challenge.answer_http01(?manager.responder,
        challenge.http01_provider(?manager.table))) { ret INVALID; }
    ret open_managed(manager, a, graph, index);
}

pub fun open_with_publisher(manager: *Manager, a: *allocator.Allocator,
    graph: *schema.Graph, index: usize, publisher: challenge.Publisher) Status {
    val certificate: *schema.AcmeCertificate = configured(graph, index);
    if (manager == nil || certificate == nil)             { ret INVALID; }
    if (certificate.challenge != schema.CHALLENGE_DNS_01) { ret INVALID; }
    if (!challenge.dns01_make(?manager.zone, publisher))  { ret INVALID; }
    if (!challenge.answer_dns01(?manager.responder,
        challenge.dns01_provider(?manager.zone))) { ret INVALID; }
    ret open_managed(manager, a, graph, index);
}

pub fun open_with_tls_alpn(manager: *Manager, a: *allocator.Allocator,
    graph: *schema.Graph, index: usize,
    provider: ch.Provider[challenge.Alpn]) Status {
    val certificate: *schema.AcmeCertificate = configured(graph, index);
    if (manager == nil || certificate == nil ||
        certificate.challenge != schema.CHALLENGE_TLS_ALPN_01) { ret INVALID; }
    if (!challenge.answer_tls_alpn(?manager.responder, provider)) {
        ret INVALID;
    }
    ret open_managed(manager, a, graph, index);
}

fun release_anchors(manager: *Manager) {
    if (!manager.anchors_live) { ret; }
    bundle.release(manager.heap, ?manager.anchors);
    manager.anchors_live = false;
}

fun abort_open(manager: *Manager, session_live: bool,
    client_live: bool) {
    if (session_live) { session.release(?manager.session); }
    if (client_live) {
        outbound.destroy_exchange(?manager.exchange);
        outbound.shutdown(?manager.client);
    }
    release_anchors(manager);
    keys.destroy(?manager.account);
    keys.destroy(?manager.pending_key);
    keys.destroy(?manager.active_key);
    manager.state = STOPPED;
    manager.live  = false;
}

fun open_managed(manager: *Manager, a: *allocator.Allocator,
    graph: *schema.Graph, index: usize) Status {
    val certificate: *schema.AcmeCertificate = configured(graph, index);
    if (manager == nil || a == nil || certificate == nil) { ret INVALID; }
    keys.clear(?manager.account);
    keys.clear(?manager.pending_key);
    keys.clear(?manager.active_key);
    manager.live                 = false;
    manager.state                = STOPPED;
    manager.observability        = nil;
    manager.issued               = 0;
    manager.failures             = 0;
    manager.consecutive_failures = 0;
    manager.last_issued_unix     = 0;
    manager.report_lock          = mutex.make();
    manager.last_failure         = problem.none();
    manager.generation           = 0;
    manager.have_certificate     = false;
    manager.chain_bytes          = 0;
    manager.chain_count          = 0;
    manager.not_before           = 0;
    manager.not_after            = 0;
    manager.advice_len           = 0;
    manager.advice               = renewal_info.empty_window();
    manager.certificate_url_len  = 0;
    manager.contact_len          = 0;
    manager.index                = index;
    if (!graph.acme.enabled || !graph.features.acme) { ret INVALID; }
    if (!copy_names(manager, certificate) || !set_label(manager, certificate)) {
        ret INVALID;
    }
    if (!copy_text(?manager.directory_url[0], MAX_URL_BYTES,
        ?graph.acme.directory, ?manager.directory_len)
        || manager.directory_len == 0) { ret INVALID; }
    copy_text(?manager.contact[0], MAX_NAME_BYTES, ?graph.acme.contact,
        ?manager.contact_len);
    manager.agree_terms = graph.acme.terms_agreed;
    challenge.http01_reset(?manager.table);
    manager.challenge_kind = certificate.challenge;
    manager.heap           = a;
    manager.anchors_live   = false;
    bundle.empty(?manager.anchors);
    if (!outbound.make(?manager.client, outbound.literal_addresses())
        || !outbound.set_user_agent(?manager.client, view.view(USER_AGENT, 14))
        || !outbound.make_exchange(?manager.exchange, ?manager.request[0],
        REQUEST_BYTES, ?manager.response[0], RESPONSE_BYTES, ?manager.items[0],
        MAX_FIELDS, session.limits().response_fields)) {
        ret FAILED;
    }
    manager.link = session.Link{client: ?manager.client, exchange: ?manager.exchange};
    if (!configure_authority(manager, a, graph)) {
        abort_open(manager, false, true);
        ret INVALID;
    }
    if (session.make(?manager.session,
        view.view(?manager.directory_url[0], manager.directory_len))
        != session.OK) {
        abort_open(manager, false, true);
        ret FAILED;
    }
    # the account key is the storage root's, and the certificate's documents
    # are in its own directory beneath it
    var storage_path: [512]u8;
    var storage_len:  usize = 0;
    if (!copy_text(?storage_path[0], 512, ?graph.acme.storage, ?storage_len)
        || storage_len == 0) {
        abort_open(manager, true, true);
        ret INVALID;
    }
    storage_path[storage_len] = 0;
    var certificate_path: [512]u8;
    var certificate_len:  usize = 0;
    copy_text(?certificate_path[0], 512, ?graph.acme.storage, ?certificate_len);
    if (certificate_len + 1 + certificate.id.len >= 512) {
        abort_open(manager, true, true);
        ret INVALID;
    }
    certificate_path[certificate_len] = '/';
    var i: usize = 0;
    for (i < certificate.id.len) {
        certificate_path[certificate_len + 1 + i] = certificate.id.data[i];
        i                                         = i + 1;
    }
    certificate_len                   = certificate_len + 1 + certificate.id.len;
    certificate_path[certificate_len] = 0;
    if (durable.open(?manager.store, a, (?storage_path[0])::str,
        (?certificate_path[0])::str) != durable.OK) {
        abort_open(manager, true, true);
        ret FAILED;
    }
    val account: durable.Status = durable.open_account_key(?manager.store, ?manager.account);
    if (account != durable.OK) {
        abort_open(manager, true, true);
        if (account == durable.EXPOSED) { ret EXPOSED; }
        ret FAILED;
    }
    manager.live = true;
    val loaded: Status = load_certificate(manager);
    if (loaded != OK) {
        abort_open(manager, true, true);
        if (loaded == EXPOSED) { ret EXPOSED; }
        ret FAILED;
    }
    var policy_value: renewal.Policy = policy(graph);
    if (manager.have_certificate) {
        if (problem.failed(renewal.begin(?manager.schedule, policy_value,
            manager.storage_key, manager.not_before, manager.not_after))) {
            abort_open(manager, true, true);
            ret FAILED;
        }
        renewal.plan(?manager.schedule, manager.advice, jitter(),
            wall_now().sec::u64, renewal.no_observer());
    }
    or {
        # with nothing to serve, the first order is due now
        if (problem.failed(renewal.begin(?manager.schedule, policy_value,
            manager.storage_key, 0, 1))) {
            abort_open(manager, true, true);
            ret FAILED;
        }
    }
    manager.state = IDLE;
    publish_report(manager);
    ret OK;
}

fun context(manager: *Manager) issue.Context {
    var value: issue.Context;
    value.session         = ?manager.session;
    value.link            = ?manager.link;
    value.account_key     = ?manager.account;
    value.certificate_key = ?manager.pending_key;
    value.provider        = challenge.responder_provider(?manager.responder);
    value.contact         = view.view(nil, 0);
    if (manager.contact_len != 0) {
        value.contact = view.view(?manager.contact[0], manager.contact_len);
    }
    value.agree_terms = manager.agree_terms;
    ret value;
}

# copies the manager's standing where telemetry reads it
fun publish_report(manager: *Manager) {
    mutex.lock(?manager.report_lock);
    manager.reported.held                 = manager.have_certificate && manager.chain_count != 0;
    manager.reported.not_after            = manager.not_after;
    manager.reported.succeeded            = manager.issued;
    manager.reported.failed               = manager.failures;
    manager.reported.consecutive_failures = manager.consecutive_failures;
    manager.reported.last_issued_unix     = manager.last_issued_unix;
    mutex.unlock(?manager.report_lock);
}

# the certificate's standing as last published, safe to read from any thread
pub fun report_of(manager: *Manager, output: *Report) bool {
    if (manager == nil || output == nil) { ret false; }
    mutex.lock(?manager.report_lock);
    @output = manager.reported;
    mutex.unlock(?manager.report_lock);
    ret true;
}

fun record_failure(manager: *Manager, cause: problem.Error, now: T.Time) {
    manager.failures             = manager.failures + 1;
    manager.consecutive_failures = manager.consecutive_failures + 1;
    manager.last_failure         = cause;
    renewal.failed(?manager.schedule, cause, jitter(), now.sec::u64,
        renewal.no_observer());
    report(manager, "issue", "failed", cause.detail);
    manager.state = IDLE;
    publish_report(manager);
}

fun persist(manager: *Manager, now: T.Time) Status {
    val next: u64 = manager.generation + 1;
    if (durable.commit_certificate_key(?manager.store, next,
        ?manager.pending_key) != durable.OK) { ret FAILED; }
    val issued: cert.Chain = issue.chain(?manager.run);
    val bytes:  view.View  = issue.chain_bytes(?manager.run);
    if (bytes.len == 0 || bytes.len > MAX_CHAIN_BYTES) { ret FAILED; }
    var i: usize = 0;
    for (i < bytes.len) {
        manager.chain[i] = bytes.data[i];
        i                = i + 1;
    }
    val parsed: cert.Parsed = issue.leaf(?manager.run);
    val url:    view.View   = issue.certificate_url(?manager.run);
    if (url.len == 0 || url.len > MAX_URL_BYTES) { ret FAILED; }
    i = 0;
    for (i < url.len) {
        manager.certificate_url[i] = url.data[i];
        i                          = i + 1;
    }
    manager.certificate_url_len = url.len;
    var record: storage.CertificateRecord;
    record.storage_key       = manager.storage_key;
    record.certificate_url   = view.view(?manager.certificate_url[0], url.len);
    record.chain_der         = view.view(?manager.chain[0], bytes.len);
    record.chain_len         = issued.len;
    record.private_key_owner = durable.secret_owner(?manager.store);
    record.identifiers       = ?manager.names[0];
    record.identifier_len    = manager.name_count;
    record.not_before_unix   = parsed.not_before_unix;
    record.not_after_unix    = parsed.not_after_unix;
    record.generation        = next;
    if (durable.save_certificate(?manager.store, manager.generation, record)
        != durable.OK) { ret FAILED; }
    val superseded: u64 = manager.generation;
    manager.generation       = next;
    manager.chain_bytes      = bytes.len;
    manager.chain_count      = issued.len;
    manager.not_before       = parsed.not_before_unix;
    manager.not_after        = parsed.not_after_unix;
    manager.have_certificate = true;
    if (!keys.replace(?manager.active_key, ?manager.pending_key)) {
        ret FAILED;
    }
    manager.issued               = manager.issued + 1;
    manager.consecutive_failures = 0;
    manager.last_issued_unix     = now.sec::u64;
    publish_report(manager);
    if (superseded != 0) {
        durable.discard_certificate_key(?manager.store, superseded);
    }
    renewal.succeeded(?manager.schedule, now.sec::u64,
        renewal.no_observer());
    ret OK;
}

fun return_to_schedule(manager: *Manager, now: T.Time) {
    manager.advice = renewal_info.empty_window();
    renewal.begin(?manager.schedule, manager.schedule.policy,
        manager.storage_key, manager.not_before, manager.not_after);
    renewal.plan(?manager.schedule, manager.advice, jitter(), now.sec::u64,
        renewal.no_observer());
    manager.state = IDLE;
}

fun start_run(manager: *Manager, now: T.Time) Status {
    if (!keys.generate(?manager.pending_key)) {
        report(manager, "issue", "keygen", "a certificate key could not be drawn");
        ret FAILED;
    }
    var policy_value: identifier.Policy = identifier.policy_default();
    policy_value.allow_wildcard = false;
    if (!issue.make(?manager.run, ?manager.names[0], manager.name_count,
        policy_value)) {
        report(manager, "issue", "names", "the configured names are not orderable");
        ret FAILED;
    }
    if (issue.begin(?manager.run) != issue.PENDING) { ret FAILED; }
    manager.state = ISSUING;
    ret PENDING;
}

# when the plane next needs driving, as monotonic nanoseconds: the request in
# flight's own deadline, the issuance run's wake while it sleeps between
# polls, or the renewal time when nothing is outstanding. a step that is
# the exchange's deadline while one is in flight, the renewal schedule
# otherwise. the exchange itself completes on the worker's driver and wakes
# the plane, so the deadline is only the bound on an authority that never
# answers.
pub fun deadline(manager: *Manager, at_ns: *u64) bool {
    if (manager == nil || !manager.live || manager.state == STOPPED) { ret false; }
    val now_ns: u64 = clock.to_ns(clock.instant());
    var at:     T.Instant;
    if (outbound.deadline(?manager.exchange, ?at)) {
        @at_ns = clock.to_ns(at);
        ret true;
    }
    if (manager.state == ISSUING && manager.run.live && manager.run.sleeping) {
        @at_ns = clock.to_ns(manager.run.wake_at);
        ret true;
    }
    if (manager.state != IDLE) {
        @at_ns = now_ns;
        ret true;
    }
    if (renewal.terminal(manager.schedule.state) || !manager.schedule.started) { ret false; }
    val now_unix: u64 = clock.wall_seconds()::u64;
    if (manager.schedule.next_run_unix <= now_unix) {
        @at_ns = now_ns;
        ret true;
    }
    @at_ns = clock.after_ns(now_ns,
        (manager.schedule.next_run_unix - now_unix) * 1000000000);
    ret true;
}

# the plane entry point. one step of whatever is outstanding, or one clock
# comparison when nothing is. `now` is wall time and drives only the renewal
# schedule, and every exchange deadline runs on the monotonic clock.
pub fun poll(context_pointer: ptr, now: T.Time) bool {
    val manager: *Manager = context_pointer::*Manager;
    if (manager == nil || !manager.live) { ret false; }
    # between runs the authority is weeks away, so nothing is kept open to it
    if (manager.state == INSTALLING || manager.state == IDLE) {
        outbound.close_kept(?manager.client);
    }
    if (manager.state == INSTALLING) { ret true; }
    if (manager.state == STOPPED)    { ret true; }
    if (manager.state == DISCOVERING) {
        val progress: session.Status = session.poll(?manager.session,
            ?manager.link, ?manager.account, clock.instant());
        if (progress == session.PENDING) { ret true; }
        session.complete(?manager.session, ?manager.link);
        if (progress != session.OK) {
            record_failure(manager, session.failure(?manager.session), now);
            ret true;
        }
        if (start_run(manager, now) != PENDING) {
            record_failure(manager, problem.local(problem.STATE,
                "an issuance run could not start"), now);
        }
        ret true;
    }
    if (manager.state == ISSUING) {
        var active:   issue.Context = context(manager);
        val progress: issue.Status  = issue.poll(?manager.run, ?active,
            clock.instant());
        if (progress == issue.PENDING) { ret true; }
        if (progress != issue.OK) {
            record_failure(manager, issue.failure(?manager.run), now);
            keys.destroy(?manager.pending_key);
            ret true;
        }
        if (persist(manager, now) != OK) {
            record_failure(manager, problem.local(problem.STORAGE,
                "the issued certificate could not be stored"), now);
            keys.destroy(?manager.pending_key);
            ret true;
        }
        manager.state = INSTALLING;
        ret true;
    }
    if (manager.state == ADVISING) {
        # advice is a courtesy: an authority that cannot be asked leaves the
        # schedule on hedge's own policy rather than stalling it
        return_to_schedule(manager, now);
        ret true;
    }
    if (manager.state != IDLE) { ret true; }
    val now_unix: u64 = now.sec::u64;
    if (renewal.clock_moved_back(?manager.schedule, now_unix)) {
        # a clock that jumped backwards is not evidence that a renewal is due
        report(manager, "schedule", "clock-skew",
            "the clock moved backwards further than the tolerated skew");
        return_to_schedule(manager, now);
        ret true;
    }
    if (!renewal.ready(?manager.schedule, now_unix)) { ret true; }
    # the attempt is marked running before anything that can fail, so a
    # failure during discovery backs the schedule off exactly as a failure
    # during the order does
    if (problem.failed(renewal.start(?manager.schedule, now_unix,
        renewal.no_observer()))) { ret true; }
    if (!session.discovered(?manager.session)) {
        if (session.begin_discovery(?manager.session) != session.PENDING) {
            record_failure(manager, problem.local(problem.STATE,
                "discovery could not start"), now);
            ret true;
        }
        manager.state = DISCOVERING;
        ret true;
    }
    if (start_run(manager, now) != PENDING) {
        record_failure(manager, problem.local(problem.STATE,
            "an issuance run could not start"), now);
    }
    ret true;
}

# the driver every exchange runs on and the plane its completions wake. the
# manager opens before the worker's driver exists and is attached once it does.
pub fun attach_driver(manager: *Manager, driver: *net_async.Driver,
    plane: wake.Waker) bool {
    if (manager == nil || !manager.live) { ret false; }
    ret outbound.attach(?manager.client, driver, plane);
}

pub fun attached(manager: *Manager) bool {
    ret manager != nil && manager.live && outbound.attached(?manager.client);
}

# gives up the exchange in flight and releases its socket. PENDING until the
# release's completions have landed, so the caller keeps dispatching them.
pub fun quiesce(manager: *Manager) Status {
    if (manager == nil || !manager.live) { ret INVALID; }
    issue.cancel(?manager.run);
    session.release(?manager.session);
    manager.state = STOPPED;
    if (!outbound.finish(?manager.exchange)) { ret FAILED; }
    outbound.close_kept(?manager.client);
    if (outbound.releasing(?manager.exchange) || !outbound.settled(?manager.client)) {
        ret PENDING;
    }
    ret OK;
}

pub fun close(manager: *Manager) bool {
    if (manager == nil || !manager.live) { ret false; }
    issue.cancel(?manager.run);
    session.release(?manager.session);
    if (!outbound.destroy_exchange(?manager.exchange))     { ret false; }
    if (outbound.shutdown(?manager.client) != outbound.OK) { ret false; }
    release_anchors(manager);
    keys.destroy(?manager.account);
    keys.destroy(?manager.pending_key);
    keys.destroy(?manager.active_key);
    manager.state = STOPPED;
    manager.live  = false;
    ret true;
}

#[testing]
fun test_allocator(a: *allocator.Allocator, state: *fixed.FixedState,
    memory: *u8, capacity: usize) bool {
    ret fixed_ok(fixed.make(a, state, memory, capacity));
}

#[testing]
fun test_graph(graph: *schema.Graph, directory: str, origin: str) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "acme-manager-test");
    graph.features.acme = true;
    graph.acme.enabled  = true;
    schema.set_text(?graph.acme.directory, "https://acme.example/dir");
    schema.set_text(?graph.acme.storage, directory);
    schema.set_text(?graph.acme.origin, origin);
    graph.acme.terms_agreed      = true;
    graph.acme.certificate_count = 1;
    val certificate: *schema.AcmeCertificate = ?graph.acme.certificates[0];
    schema.clear_acme_certificate(certificate);
    schema.set_text(?certificate.id, "managed");
    certificate.challenge  = schema.CHALLENGE_HTTP_01;
    certificate.name_count = 1;
    schema.set_text(?certificate.names[0], "managed.example");
}

# a der certificate this test can store: a SEQUENCE with a known length, which
# is all the chain splitter reads
#[testing]
fun test_chain(buffer: *u8, count: usize) usize {
    var at: usize = 0;
    var i:  usize = 0;
    for (i < count) {
        buffer[at]     = 0x30;
        buffer[at + 1] = 0x40;
        var j: usize = 0;
        for (j < 64) {
            buffer[at + 2 + j] = (i * 64 + j)::u8;
            j                  = j + 1;
        }
        at = at + 66;
        i  = i + 1;
    }
    ret at;
}

#[testing]
fun store_certificate(directory: str, a: *allocator.Allocator,
    not_after: u64) bool {
    # where test_graph's certificate keeps its record
    var own: [256]u8;
    var at:  usize = 0;
    for (directory[at] != 0 && at < 240) {
        own[at] = directory[at];
        at      = at + 1;
    }
    val leaf: str   = "/managed";
    var i:    usize = 0;
    for (leaf[i] != 0) {
        own[at + i] = leaf[i];
        i           = i + 1;
    }
    own[at + i] = 0;
    var store: durable.Store;
    if (durable.open(?store, a, directory, (?own[0])::str) != durable.OK) { ret false; }
    var account: keys.Key;
    if (durable.open_account_key(?store, ?account) != durable.OK) { ret false; }
    var certificate: keys.Key;
    if (!keys.generate(?certificate)) { ret false; }
    if (durable.commit_certificate_key(?store, 1, ?certificate)
        != durable.OK) { ret false; }
    var chain:  [256]u8;
    val length: usize = test_chain(?chain[0], 2);
    var names:  [1]identifier.Identifier;
    names[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("managed.example", 15)};
    var record: storage.CertificateRecord;
    record.storage_key       = view.view("managed.example", 15);
    record.certificate_url   = view.view("https://acme.example/cert/1", 27);
    record.chain_der         = view.view(?chain[0], length);
    record.chain_len         = 2;
    record.private_key_owner = durable.secret_owner(?store);
    record.identifiers       = ?names[0];
    record.identifier_len    = 1;
    record.not_before_unix   = 1;
    record.not_after_unix    = not_after;
    record.generation        = 1;
    val saved: durable.Status = durable.save_certificate(?store, 0, record);
    keys.destroy(?account);
    keys.destroy(?certificate);
    ret saved == durable.OK;
}

test open__recovers_stored_certificate_idle {
    if (!keys.reserve(2)) { ret 99; }
    var memory: [262144]u8;
    var arena:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 262144)) { ret 1; }
    val directory: str = "out/acme-manager-idle";
    fs.remove_all(?a, directory::Path);
    val expiry: u64 = wall_now().sec::u64 + 7776000;
    if (!store_certificate(directory, ?a, expiry)) { ret 2; }
    var graph: schema.Graph;
    test_graph(?graph, directory, "127.0.0.1:1");
    var manager: Manager;
    if (open(?manager, ?a, ?graph, 0) != OK) { ret 3; }
    if (!manager.have_certificate || manager.chain_count != 2
        || manager.not_after != expiry || manager.generation != 1) {
        close(?manager);
        ret 4;
    }
    if (!certificate_ready(?manager)) {
        close(?manager);
        ret 5;
    }
    var first: view.View;
    if (!chain_entry(?manager, 0, ?first) || first.len != 66
        || first.data[2] != 0) {
        close(?manager);
        ret 6;
    }
    var second: view.View;
    if (!chain_entry(?manager, 1, ?second) || second.len != 66
        || second.data[2] != 64) {
        close(?manager);
        ret 7;
    }
    if (chain_entry(?manager, 2, ?second)) {
        close(?manager);
        ret 8;
    }
    # a certificate nowhere near expiry costs the plane a comparison and
    # nothing else: no socket, no order, no state change
    var i: usize = 0;
    for (i < 256) {
        poll((?manager)::ptr, wall_now());
        i = i + 1;
    }
    if (state(?manager) != IDLE || issued_count(?manager) != 0
        || failure_count(?manager) != 0) {
        close(?manager);
        ret 8;
    }
    close(?manager);
    fs.remove_all(?a, directory::Path);
    ret 0;
}

test poll__clock_moved_back_replans {
    if (!keys.reserve(2)) { ret 99; }
    var memory: [262144]u8;
    var arena:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 262144)) { ret 1; }
    val directory: str = "out/acme-manager-skew";
    fs.remove_all(?a, directory::Path);
    val now: T.Time = wall_now();
    # a certificate that is planned but not yet due, so the only thing the
    # backwards jump can change is the plan
    if (!store_certificate(directory, ?a, now.sec::u64 + 7776000)) { ret 2; }
    var graph: schema.Graph;
    test_graph(?graph, directory, "127.0.0.1:1");
    var manager: Manager;
    if (open(?manager, ?a, ?graph, 0) != OK) { ret 3; }
    poll((?manager)::ptr, now);
    val before: u64 = manager.schedule.last_seen_unix;
    if (before == 0) {
        close(?manager);
        ret 4;
    }
    # the clock jumps a day backwards: not evidence that anything is due
    var moved: T.Time = now;
    moved.sec = now.sec - 86400;
    poll((?manager)::ptr, moved);
    if (state(?manager) != IDLE) {
        close(?manager);
        ret 5;
    }
    if (manager.schedule.last_seen_unix > before) {
        close(?manager);
        ret 6;
    }
    if (issued_count(?manager) != 0 || failure_count(?manager) != 0) {
        close(?manager);
        ret 7;
    }
    close(?manager);
    fs.remove_all(?a, directory::Path);
    ret 0;
}

test poll__unreachable_authority_backs_off {
    if (!keys.reserve(2)) { ret 99; }
    var memory: [262144]u8;
    var arena:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 262144)) { ret 1; }
    val directory: str = "out/acme-manager-outage";
    fs.remove_all(?a, directory::Path);
    var graph: schema.Graph;
    # port 1 serves nothing, so every attempt fails at connect
    test_graph(?graph, directory, "127.0.0.1:1");
    var manager: Manager;
    if (open(?manager, ?a, ?graph, 0) != OK) { ret 2; }
    # with nothing stored the first order is due immediately
    var rounds: usize = 0;
    for (rounds < 100000 && failure_count(?manager) == 0) {
        poll((?manager)::ptr, wall_now());
        rounds = rounds + 1;
    }
    if (failure_count(?manager) != 1) {
        close(?manager);
        ret 3;
    }
    if (state(?manager) != IDLE) {
        close(?manager);
        ret 4;
    }
    # the failure moved the schedule into backoff rather than straight back
    # into another attempt
    val next: u64 = manager.schedule.next_run_unix;
    if (next <= wall_now().sec::u64) {
        close(?manager);
        ret 5;
    }
    var i: usize = 0;
    for (i < 4096) {
        poll((?manager)::ptr, wall_now());
        i = i + 1;
    }
    if (failure_count(?manager) != 1) {
        close(?manager);
        ret 6;
    }
    # a prolonged outage produces bounded, widely spaced attempts: after the
    # backoff elapses exactly one more attempt is made
    var later: T.Time = wall_now();
    later.sec = next::i64 + 1;
    rounds    = 0;
    for (rounds < 100000 && failure_count(?manager) == 1) {
        poll((?manager)::ptr, later);
        rounds = rounds + 1;
    }
    if (failure_count(?manager) != 2 || manager.schedule.attempts != 2) {
        close(?manager);
        ret 7;
    }
    if (manager.schedule.next_run_unix <= next) {
        close(?manager);
        ret 8;
    }
    close(?manager);
    fs.remove_all(?a, directory::Path);
    ret 0;
}

test open__certificates_renew_and_fail_on_their_own {
    if (!keys.reserve(2)) { ret 99; }
    var memory: [262144]u8;
    var arena:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 262144)) { ret 1; }
    val directory: str = "out/acme-manager-pair";
    fs.remove_all(?a, directory::Path);
    if (!store_certificate(directory, ?a, wall_now().sec::u64 + 7776000)) { ret 2; }
    var graph: schema.Graph;
    test_graph(?graph, directory, "127.0.0.1:1");
    graph.acme.certificate_count = 2;
    val second: *schema.AcmeCertificate = ?graph.acme.certificates[1];
    schema.clear_acme_certificate(second);
    schema.set_text(?second.id, "second");
    second.name_count = 1;
    schema.set_text(?second.names[0], "second.example");
    var first:  Manager;
    var latter: Manager;
    if (open(?first, ?a, ?graph, 0) != OK) { ret 3; }
    if (open(?latter, ?a, ?graph, 1) != OK) {
        close(?first);
        ret 4;
    }
    # one account: both sign with the key at the storage root, and the second
    # keeps its record in a directory of its own
    var same: bool  = true;
    var i:    usize = 0;
    for (i < keys.POINT_BYTES) {
        if (first.account.point[i] != latter.account.point[i]) { same = false; }
        i = i + 1;
    }
    if (!same || !present(fs.is_dir("out/acme-manager-pair/second"::Path))
        || !view.view_eq_str(view.view(label(?first), 7), "managed")
        || !view.view_eq_str(view.view(component(?latter), 11), "acme.second")
        || !certificate_ready(?first) || certificate_ready(?latter)) {
        close(?first);
        close(?latter);
        ret 5;
    }
    # the second's first order fails against an authority that is not there,
    # and the first, nowhere near renewal, neither notices nor stops being served
    var rounds: usize = 0;
    for (rounds < 100000 && failure_count(?latter) == 0) {
        poll((?first)::ptr, wall_now());
        poll((?latter)::ptr, wall_now());
        rounds = rounds + 1;
    }
    if (failure_count(?latter) != 1 || failure_count(?first) != 0
        || state(?first) != IDLE || !certificate_ready(?first)) {
        close(?first);
        close(?latter);
        ret 6;
    }
    close(?first);
    close(?latter);
    fs.remove_all(?a, directory::Path);
    ret 0;
}

test open__failure_releases_subsystems {
    if (!keys.reserve(2)) { ret 99; }
    var memory: [1048576]u8;
    var state:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?state, ?memory[0], 1048576)) { ret 1; }
    var graph: schema.Graph;
    test_graph(?graph, "out/acme-manager-unwind", "127.0.0.1:14001");
    schema.clear_text(?graph.acme.storage);
    var manager: Manager;
    if (open(?manager, ?a, ?graph, 0) != INVALID) { ret 2; }
    if (manager.live || manager.client.live || manager.session.live
        || manager.account.live || manager.pending_key.live
        || manager.active_key.live) { ret 3; }
    ret 0;
}

test open__refuses_disabled_or_unsupported {
    if (!keys.reserve(2)) { ret 99; }
    var memory: [262144]u8;
    var arena:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 262144)) { ret 1; }
    var graph: schema.Graph;
    test_graph(?graph, "out/acme-manager-off", "127.0.0.1:1");
    graph.acme.enabled = false;
    var manager: Manager;
    if (open(?manager, ?a, ?graph, 0) != INVALID)   { ret 2; }
    if (manager.live || state(?manager) != STOPPED) { ret 3; }
    # a challenge type this build cannot answer is refused at construction
    graph.acme.enabled                   = true;
    graph.acme.certificates[0].challenge = schema.CHALLENGE_DNS_01;
    if (open(?manager, ?a, ?graph, 0) != INVALID)          { ret 4; }
    if (!present(fs.is_dir("out/acme-manager-off"::Path))) { ret 0; }
    ret 5;
}
