# answering an acme challenge from inside the server being validated
#
# mach-acme derives every challenge value from the account key and owns the
# exactly-once presentation rule; a provider only publishes what it is handed
# and withdraws it once. these are hedge's providers.
#
# http-01 is answered by hedge itself: the token table below is what the
# challenge route serves, so the same process that will hold the certificate
# proves it controls the name. dns-01 cannot be answered by a web server, so
# it is a contract a deployment supplies.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use R: std.types.result;
use contracts: crypto.contracts;
use ch: acme.challenge;
use identifier: acme.identifier;
use problem: acme.problem;

# one order at a time, and an order's authorizations are answered one at a
# time, so a small table is a real bound rather than an arbitrary one
pub val MAX_PRESENTATIONS: usize = 4;
pub val MAX_TOKEN_BYTES: usize = ch.MAX_TOKEN_BYTES;
pub val MAX_VALUE_BYTES: usize = ch.MAX_KEY_AUTHORIZATION_BYTES;
pub val MAX_NAME_BYTES: usize = ch.MAX_DNS_NAME_BYTES;
pub val CHALLENGE_PREFIX: str = "/.well-known/acme-challenge/";
pub val CHALLENGE_PREFIX_BYTES: usize = 28;

rec Entry {
    token:     [MAX_TOKEN_BYTES]u8;
    token_len: usize;
    value:     [MAX_VALUE_BYTES]u8;
    value_len: usize;
    live:      bool;
}

# the token table the challenge route reads. it holds no secret: a key
# authorization is derived from the account key but is public by design, since
# the authority fetches it over plain http.
pub rec Http01 {
    entries:   [MAX_PRESENTATIONS]Entry;
    presented: usize;
    withdrawn: usize;
}

pub fun http01_reset(table: *Http01) bool {
    if (table == nil) { ret false; }
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        table.entries[i].live = false;
        table.entries[i].token_len = 0;
        table.entries[i].value_len = 0;
        i = i + 1;
    }
    table.presented = 0;
    table.withdrawn = 0;
    ret true;
}

pub fun http01_live(table: *Http01) usize {
    if (table == nil) { ret 0; }
    var count: usize = 0;
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        if (table.entries[i].live) { count = count + 1; }
        i = i + 1;
    }
    ret count;
}

fun same_bytes(first: *u8, first_len: usize, second: *u8,
    second_len: usize) bool {
    if (first_len != second_len) { ret false; }
    var i: usize = 0;
    for (i < first_len) {
        if (first[i] != second[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# resolves one challenge token to the exact body the authority expects
pub fun http01_answer(table: *Http01, token: view.View,
    output: *view.View) bool {
    if (table == nil || output == nil || token.data == nil
     || token.len == 0) { ret false; }
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        val entry: *Entry = ?table.entries[i];
        if (entry.live && same_bytes(?entry.token[0], entry.token_len,
                token.data, token.len)) {
            @output = view.view(?entry.value[0], entry.value_len);
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# a request target is only a challenge when it is exactly the well-known path
# and one token segment; anything else belongs to the configured routes
pub fun http01_token(path: view.View, output: *view.View) bool {
    if (output == nil || path.data == nil
     || path.len <= CHALLENGE_PREFIX_BYTES) { ret false; }
    var i: usize = 0;
    for (i < CHALLENGE_PREFIX_BYTES) {
        if (path.data[i] != CHALLENGE_PREFIX[i]) { ret false; }
        i = i + 1;
    }
    val length: usize = path.len - CHALLENGE_PREFIX_BYTES;
    if (length > MAX_TOKEN_BYTES) { ret false; }
    val token: view.View = view.view(?path.data[CHALLENGE_PREFIX_BYTES],
        length);
    if (!ch.token_valid(token)) { ret false; }
    @output = token;
    ret true;
}

fun http01_supports(context: ptr, subject: identifier.Identifier,
    kind: u8) bool {
    # rfc 8555 section 7.1.3: a wildcard is only satisfiable by dns-01, and an
    # ip identifier has no http-01 form this server serves
    ret context::usize != 0 && kind == ch.HTTP_01
        && subject.kind == identifier.DNS
        && !identifier.is_wildcard(subject);
}

fun http01_present(context: ptr, subject: identifier.Identifier,
    value: ch.Challenge, key_authorization: view.View)
    R.Result[ch.Presentation, problem.Error] {
    val table: *Http01 = context::*Http01;
    if (table == nil || value.token.data == nil || value.token.len == 0
     || value.token.len > MAX_TOKEN_BYTES
     || key_authorization.data == nil || key_authorization.len == 0
     || key_authorization.len > MAX_VALUE_BYTES) {
        ret R.err[ch.Presentation, problem.Error](problem.local(
            problem.CHALLENGE, "http-01 presentation is out of bounds"));
    }
    var slot: usize = MAX_PRESENTATIONS;
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        if (!table.entries[i].live && slot == MAX_PRESENTATIONS) { slot = i; }
        i = i + 1;
    }
    if (slot == MAX_PRESENTATIONS) {
        ret R.err[ch.Presentation, problem.Error](problem.local(
            problem.CHALLENGE, "http-01 presentation table is full"));
    }
    val entry: *Entry = ?table.entries[slot];
    i = 0;
    for (i < value.token.len) {
        entry.token[i] = value.token.data[i];
        i = i + 1;
    }
    entry.token_len = value.token.len;
    i = 0;
    for (i < key_authorization.len) {
        entry.value[i] = key_authorization.data[i];
        i = i + 1;
    }
    entry.value_len = key_authorization.len;
    entry.live = true;
    table.presented = table.presented + 1;
    ret R.ok[ch.Presentation, problem.Error](
        ch.Presentation{ctx: (slot + 1)::ptr});
}

fun http01_cleanup(context: ptr,
    presentation: ch.Presentation) R.Result[bool, problem.Error] {
    val table: *Http01 = context::*Http01;
    val slot: usize = presentation.ctx::usize;
    if (table == nil || slot == 0 || slot > MAX_PRESENTATIONS) {
        ret R.err[bool, problem.Error](problem.local(problem.CHALLENGE,
            "http-01 cleanup does not name a presentation"));
    }
    val entry: *Entry = ?table.entries[slot - 1];
    entry.live = false;
    entry.token_len = 0;
    entry.value_len = 0;
    table.withdrawn = table.withdrawn + 1;
    ret R.ok[bool, problem.Error](true);
}

pub fun http01_provider(table: *Http01) ch.Provider {
    var value: ch.Provider;
    value.ctx = table::ptr;
    value.supports = http01_supports;
    value.present = http01_present;
    value.cleanup = http01_cleanup;
    ret value;
}

# dns-01 belongs to whatever publishes the zone, which a web server is not.
# the deployment supplies these two calls and hedge supplies everything else,
# including the record name and value, which mach-acme derives.
pub def PublishFun: fun(ptr, view.View, view.View) bool;
pub def WithdrawFun: fun(ptr, view.View, view.View) bool;

pub rec Publisher {
    ctx:      ptr;
    publish:  PublishFun;
    withdraw: WithdrawFun;
}

rec Record {
    name:     [MAX_NAME_BYTES]u8;
    name_len: usize;
    value:    [MAX_VALUE_BYTES]u8;
    value_len: usize;
    live:     bool;
}

pub rec Dns01 {
    publisher: Publisher;
    records:   [MAX_PRESENTATIONS]Record;
    presented: usize;
    withdrawn: usize;
    live:      bool;
}

pub fun dns01_make(state: *Dns01, publisher: Publisher) bool {
    if (state == nil || publisher.publish::usize == 0
     || publisher.withdraw::usize == 0) { ret false; }
    state.publisher = publisher;
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        state.records[i].live = false;
        i = i + 1;
    }
    state.presented = 0;
    state.withdrawn = 0;
    state.live = true;
    ret true;
}

fun dns01_supports(context: ptr, subject: identifier.Identifier,
    kind: u8) bool {
    val state: *Dns01 = context::*Dns01;
    ret state != nil && state.live && kind == ch.DNS_01
        && subject.kind == identifier.DNS;
}

fun dns01_present(context: ptr, subject: identifier.Identifier,
    value: ch.Challenge, key_authorization: view.View)
    R.Result[ch.Presentation, problem.Error] {
    val state: *Dns01 = context::*Dns01;
    if (state == nil || !state.live) {
        ret R.err[ch.Presentation, problem.Error](problem.local(
            problem.CHALLENGE, "dns-01 provider is not configured"));
    }
    var name_storage: [MAX_NAME_BYTES]u8;
    val named: ch.Operation = ch.dns_name(subject,
        contracts.Buffer{data: ?name_storage[0], capacity: MAX_NAME_BYTES});
    if (problem.failed(named.error)) {
        ret R.err[ch.Presentation, problem.Error](named.error);
    }
    var value_storage: [MAX_VALUE_BYTES]u8;
    val digested: ch.Operation = ch.dns_value(key_authorization,
        contracts.Buffer{data: ?value_storage[0], capacity: MAX_VALUE_BYTES});
    if (problem.failed(digested.error)) {
        ret R.err[ch.Presentation, problem.Error](digested.error);
    }
    var slot: usize = MAX_PRESENTATIONS;
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        if (!state.records[i].live && slot == MAX_PRESENTATIONS) { slot = i; }
        i = i + 1;
    }
    if (slot == MAX_PRESENTATIONS) {
        ret R.err[ch.Presentation, problem.Error](problem.local(
            problem.CHALLENGE, "dns-01 presentation table is full"));
    }
    val record: *Record = ?state.records[slot];
    i = 0;
    for (i < named.value.len) {
        record.name[i] = named.value.data[i];
        i = i + 1;
    }
    record.name_len = named.value.len;
    i = 0;
    for (i < digested.value.len) {
        record.value[i] = digested.value.data[i];
        i = i + 1;
    }
    record.value_len = digested.value.len;
    # the record is retained before it is published, so a publisher that fails
    # after writing still has its state withdrawn
    record.live = true;
    state.presented = state.presented + 1;
    if (!state.publisher.publish(state.publisher.ctx,
            view.view(?record.name[0], record.name_len),
            view.view(?record.value[0], record.value_len))) {
        record.live = false;
        ret R.err[ch.Presentation, problem.Error](problem.local(
            problem.CHALLENGE, "dns-01 record could not be published"));
    }
    ret R.ok[ch.Presentation, problem.Error](
        ch.Presentation{ctx: (slot + 1)::ptr});
}

fun dns01_cleanup(context: ptr,
    presentation: ch.Presentation) R.Result[bool, problem.Error] {
    val state: *Dns01 = context::*Dns01;
    val slot: usize = presentation.ctx::usize;
    if (state == nil || !state.live || slot == 0
     || slot > MAX_PRESENTATIONS) {
        ret R.err[bool, problem.Error](problem.local(problem.CHALLENGE,
            "dns-01 cleanup does not name a presentation"));
    }
    val record: *Record = ?state.records[slot - 1];
    val withdrawn: bool = state.publisher.withdraw(state.publisher.ctx,
        view.view(?record.name[0], record.name_len),
        view.view(?record.value[0], record.value_len));
    record.live = false;
    state.withdrawn = state.withdrawn + 1;
    if (!withdrawn) {
        ret R.err[bool, problem.Error](problem.local(problem.CHALLENGE,
            "dns-01 record could not be withdrawn"));
    }
    ret R.ok[bool, problem.Error](true);
}

pub fun dns01_provider(state: *Dns01) ch.Provider {
    var value: ch.Provider;
    value.ctx = state::ptr;
    value.supports = dns01_supports;
    value.present = dns01_present;
    value.cleanup = dns01_cleanup;
    ret value;
}

val TEST_TOKEN: str = "tokenAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
val TEST_AUTHORIZATION: str = "tokenAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA.thumbBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB";

fun test_length(value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) { i = i + 1; }
    ret i;
}

fun test_view(value: str) view.View {
    ret view.view(value, test_length(value));
}

fun test_challenge(kind: u8) ch.Challenge {
    var value: ch.Challenge;
    value.typ = kind;
    value.url = test_view("https://acme.example/challenge/1");
    value.token = test_view(TEST_TOKEN);
    value.status = ch.PENDING;
    value.validated = view.view(nil, 0);
    ret value;
}

fun test_subject() identifier.Identifier {
    ret identifier.Identifier{kind: identifier.DNS,
        value: test_view("hedge.example")};
}

fun test_wildcard() identifier.Identifier {
    ret identifier.Identifier{kind: identifier.DNS,
        value: test_view("*.hedge.example")};
}

test "acme challenge: http-01 presents once and withdraws exactly once" {
    var table: Http01;
    if (!http01_reset(?table)) { ret 1; }
    var attempt: ch.Attempt;
    if (problem.failed(ch.attempt_init(?attempt,
        http01_provider(?table)))) { ret 2; }
    if (problem.failed(ch.begin(?attempt, test_subject(),
        test_challenge(ch.HTTP_01), test_view(TEST_AUTHORIZATION)))) { ret 3; }
    if (attempt.present_calls != 1 || table.presented != 1
     || http01_live(?table) != 1) { ret 4; }
    var answer: view.View;
    if (!http01_answer(?table, test_view(TEST_TOKEN), ?answer)) { ret 5; }
    if (!view.view_eq_str(answer, TEST_AUTHORIZATION)) { ret 6; }
    if (problem.failed(ch.finish(?attempt))) { ret 7; }
    if (attempt.cleanup_calls != 1 || table.withdrawn != 1
     || http01_live(?table) != 0) { ret 8; }
    # the single exit is idempotent: a caller that finishes again on a later
    # path does not reach the provider a second time
    if (problem.failed(ch.finish(?attempt))) { ret 9; }
    if (attempt.cleanup_calls != 1 || table.withdrawn != 1) { ret 10; }
    if (http01_answer(?table, test_view(TEST_TOKEN), ?answer)) { ret 11; }
    ret 0;
}

test "acme challenge: an abandoned presentation still withdraws once" {
    # timeout and cancellation are the same exit as success: the caller stops
    # waiting and finishes the attempt, which retires the provider's state
    var table: Http01;
    http01_reset(?table);
    var timed_out: ch.Attempt;
    ch.attempt_init(?timed_out, http01_provider(?table));
    if (problem.failed(ch.begin(?timed_out, test_subject(),
        test_challenge(ch.HTTP_01), test_view(TEST_AUTHORIZATION)))) { ret 1; }
    var cancelled: ch.Attempt;
    ch.attempt_init(?cancelled, http01_provider(?table));
    if (problem.failed(ch.begin(?cancelled, test_subject(),
        test_challenge(ch.HTTP_01), test_view(TEST_AUTHORIZATION)))) { ret 2; }
    if (http01_live(?table) != 2 || table.presented != 2) { ret 3; }
    ch.finish(?timed_out);
    ch.finish(?cancelled);
    if (timed_out.cleanup_calls != 1 || cancelled.cleanup_calls != 1) { ret 4; }
    if (table.withdrawn != 2 || http01_live(?table) != 0) { ret 5; }
    ret 0;
}

test "acme challenge: a declined challenge is never presented" {
    var table: Http01;
    http01_reset(?table);
    var attempt: ch.Attempt;
    ch.attempt_init(?attempt, http01_provider(?table));
    # a wildcard is dns-01 only, and dns-01 is not this provider's kind
    if (!problem.failed(ch.begin(?attempt, test_wildcard(),
        test_challenge(ch.HTTP_01), test_view(TEST_AUTHORIZATION)))) { ret 1; }
    if (attempt.present_calls != 0 || table.presented != 0) { ret 2; }
    if (problem.failed(ch.finish(?attempt))) { ret 3; }
    if (attempt.cleanup_calls != 0 || table.withdrawn != 0) { ret 4; }
    var other: ch.Attempt;
    ch.attempt_init(?other, http01_provider(?table));
    if (!problem.failed(ch.begin(?other, test_subject(),
        test_challenge(ch.DNS_01), test_view(TEST_AUTHORIZATION)))) { ret 5; }
    if (other.present_calls != 0) { ret 6; }
    ret 0;
}

test "acme challenge: a failed presentation owes no cleanup" {
    var table: Http01;
    http01_reset(?table);
    var held: [MAX_PRESENTATIONS]ch.Attempt;
    var i: usize = 0;
    for (i < MAX_PRESENTATIONS) {
        ch.attempt_init(?held[i], http01_provider(?table));
        if (problem.failed(ch.begin(?held[i], test_subject(),
            test_challenge(ch.HTTP_01), test_view(TEST_AUTHORIZATION)))) {
            ret 1;
        }
        i = i + 1;
    }
    var overflowing: ch.Attempt;
    ch.attempt_init(?overflowing, http01_provider(?table));
    if (!problem.failed(ch.begin(?overflowing, test_subject(),
        test_challenge(ch.HTTP_01), test_view(TEST_AUTHORIZATION)))) { ret 2; }
    if (overflowing.present_calls != 1) { ret 3; }
    ch.finish(?overflowing);
    # the provider never took state for it, so nothing is withdrawn for it
    if (overflowing.cleanup_calls != 0 || table.withdrawn != 0) { ret 4; }
    i = 0;
    for (i < MAX_PRESENTATIONS) {
        ch.finish(?held[i]);
        i = i + 1;
    }
    if (table.withdrawn != MAX_PRESENTATIONS
     || http01_live(?table) != 0) { ret 5; }
    ret 0;
}

test "acme challenge: only the well-known path with a valid token matches" {
    var token: view.View;
    if (!http01_token(test_view(
        "/.well-known/acme-challenge/tokenAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"),
        ?token)) { ret 1; }
    if (!view.view_eq_str(token, TEST_TOKEN)) { ret 2; }
    if (http01_token(test_view("/.well-known/acme-challenge/"), ?token)) { ret 3; }
    if (http01_token(test_view("/.well-known/acme-challenge"), ?token)) { ret 4; }
    if (http01_token(test_view("/index.html"), ?token)) { ret 5; }
    # a token is base64url; a traversal attempt is not a token
    if (http01_token(test_view("/.well-known/acme-challenge/../../etc/passwd"),
        ?token)) { ret 6; }
    ret 0;
}

rec TestZone {
    published:  usize;
    withdrawn:  usize;
    refuse:     bool;
    refuse_withdraw: bool;
    name:       [MAX_NAME_BYTES]u8;
    name_len:   usize;
    value:      [MAX_VALUE_BYTES]u8;
    value_len:  usize;
}

fun zone_publish(context: ptr, name: view.View, value: view.View) bool {
    val zone: *TestZone = context::*TestZone;
    if (zone.refuse) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        zone.name[i] = name.data[i];
        i = i + 1;
    }
    zone.name_len = name.len;
    i = 0;
    for (i < value.len) {
        zone.value[i] = value.data[i];
        i = i + 1;
    }
    zone.value_len = value.len;
    zone.published = zone.published + 1;
    ret true;
}

fun zone_withdraw(context: ptr, name: view.View, value: view.View) bool {
    val zone: *TestZone = context::*TestZone;
    zone.withdrawn = zone.withdrawn + 1;
    ret !zone.refuse_withdraw;
}

fun test_zone(zone: *TestZone) Publisher {
    zone.published = 0;
    zone.withdrawn = 0;
    zone.refuse = false;
    zone.refuse_withdraw = false;
    zone.name_len = 0;
    zone.value_len = 0;
    ret Publisher{ctx: zone::ptr, publish: zone_publish,
        withdraw: zone_withdraw};
}

test "acme challenge: dns-01 publishes the derived record and withdraws once" {
    var zone: TestZone;
    var state: Dns01;
    if (!dns01_make(?state, test_zone(?zone))) { ret 1; }
    var attempt: ch.Attempt;
    ch.attempt_init(?attempt, dns01_provider(?state));
    if (problem.failed(ch.begin(?attempt, test_subject(),
        test_challenge(ch.DNS_01), test_view(TEST_AUTHORIZATION)))) { ret 2; }
    if (zone.published != 1) { ret 3; }
    # the record name is derived by mach-acme, not by the deployment
    if (!view.view_eq_str(view.view(?zone.name[0], zone.name_len),
        "_acme-challenge.hedge.example")) { ret 4; }
    if (zone.value_len != 43) { ret 5; }
    ch.finish(?attempt);
    if (zone.withdrawn != 1 || attempt.cleanup_calls != 1) { ret 6; }
    ch.finish(?attempt);
    if (zone.withdrawn != 1) { ret 7; }
    ret 0;
}

test "acme challenge: dns-01 answers a wildcard against its base name" {
    var zone: TestZone;
    var state: Dns01;
    dns01_make(?state, test_zone(?zone));
    var attempt: ch.Attempt;
    ch.attempt_init(?attempt, dns01_provider(?state));
    if (problem.failed(ch.begin(?attempt, test_wildcard(),
        test_challenge(ch.DNS_01), test_view(TEST_AUTHORIZATION)))) { ret 1; }
    if (!view.view_eq_str(view.view(?zone.name[0], zone.name_len),
        "_acme-challenge.hedge.example")) { ret 2; }
    ch.finish(?attempt);
    ret 0;
}

test "acme challenge: a publisher that refuses owes no withdrawal" {
    var zone: TestZone;
    var state: Dns01;
    dns01_make(?state, test_zone(?zone));
    zone.refuse = true;
    var attempt: ch.Attempt;
    ch.attempt_init(?attempt, dns01_provider(?state));
    if (!problem.failed(ch.begin(?attempt, test_subject(),
        test_challenge(ch.DNS_01), test_view(TEST_AUTHORIZATION)))) { ret 1; }
    ch.finish(?attempt);
    if (zone.withdrawn != 0 || attempt.cleanup_calls != 0) { ret 2; }
    ret 0;
}

test "acme challenge: a withdrawal that fails is reported, never retried" {
    var zone: TestZone;
    var state: Dns01;
    dns01_make(?state, test_zone(?zone));
    var attempt: ch.Attempt;
    ch.attempt_init(?attempt, dns01_provider(?state));
    if (problem.failed(ch.begin(?attempt, test_subject(),
        test_challenge(ch.DNS_01), test_view(TEST_AUTHORIZATION)))) { ret 1; }
    zone.refuse_withdraw = true;
    ch.finish(?attempt);
    if (zone.withdrawn != 1 || attempt.cleanup_calls != 1) { ret 2; }
    ch.finish(?attempt);
    if (zone.withdrawn != 1) { ret 3; }
    ret 0;
}
