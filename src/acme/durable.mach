# durable acme state: the account, the certificate, and the keys for both
#
# mach-acme owns the transactional record store and never writes key material,
# because its storage contract keeps a private key behind an opaque owner
# identity that the application resolves. hedge is that application, so key
# persistence is here.
#
# a certificate is worthless without its key, so the two must survive a crash
# together. the binding is the record's own generation: the key for generation
# n lives at `certificate.<n>.key`, written and flushed before the record that
# names generation n is committed. every crash therefore leaves either a
# committed record whose key file exists, or an orphan key file that no record
# names, which the next successful commit supersedes.
#
# every document is written through mach-acme's file store, so all of them are
# magic-checked, versioned, digest-verified, replaced atomically, and created
# with owner-only permissions.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use std.types.path.Path;
use O: std.types.option;
use std.allocator;
use std.allocator.fixed;
use R: std.types.result;
use identifier: acme.identifier;
use fs: std.filesystem;
use account: acme.account;
use file_store: acme.file_store;
use problem: acme.problem;
use storage: acme.storage;
use keys: hedge.acme.keys;

pub val MAX_PATH_BYTES: usize = 512;
pub val MAX_IDENTIFIERS: usize = 8;

# the directory and every file in it belong to the process owner alone
pub val DIRECTORY_MODE: i32 = 448;
pub val FILE_MODE: i32 = 384;

pub def Status: u8;
pub val OK:       Status = 1;
pub val MISSING:  Status = 2;
pub val CORRUPT:  Status = 3;
pub val CONFLICT: Status = 4;
pub val FAILED:   Status = 5;
pub val INVALID:  Status = 6;

rec PathBuffer {
    data: [MAX_PATH_BYTES]u8;
    len:  usize;
}

pub rec Store {
    backing:  file_store.Store;
    manager:  storage.Manager;
    directory: PathBuffer;
    account_document: PathBuffer;
    certificate_document: PathBuffer;
    account_key: PathBuffer;
    certificate_key: PathBuffer;
    scratch:  [1024]u8;
    buffer:   [1024]u8;
    live:     bool;
}

fun path_reset(target: *PathBuffer) {
    target.len = 0;
    target.data[0] = 0;
}

fun path_put(target: *PathBuffer, value: str, length: usize) bool {
    if (target.len + length + 1 > MAX_PATH_BYTES) { ret false; }
    var i: usize = 0;
    for (i < length) {
        target.data[target.len + i] = value[i];
        i = i + 1;
    }
    target.len = target.len + length;
    target.data[target.len] = 0;
    ret true;
}

fun path_put_number(target: *PathBuffer, value: u64) bool {
    var digits: [20]u8;
    var count: usize = 0;
    var remaining: u64 = value;
    for (true) {
        digits[count] = ('0' + (remaining % 10)::u8);
        count = count + 1;
        remaining = remaining / 10;
        if (remaining == 0) { brk; }
    }
    if (target.len + count + 1 > MAX_PATH_BYTES) { ret false; }
    var i: usize = 0;
    for (i < count) {
        target.data[target.len + i] = digits[count - 1 - i];
        i = i + 1;
    }
    target.len = target.len + count;
    target.data[target.len] = 0;
    ret true;
}

fun path_text(target: *PathBuffer) str {
    ret (?target.data[0])::str;
}

fun string_length(value: str) usize {
    if (value == nil) { ret 0; }
    var i: usize = 0;
    for (value[i] != 0) { i = i + 1; }
    ret i;
}

fun compose(target: *PathBuffer, directory: *PathBuffer, name: str) bool {
    path_reset(target);
    if (!path_put(target, path_text(directory), directory.len)) { ret false; }
    if (!path_put(target, "/", 1)) { ret false; }
    ret path_put(target, name, string_length(name));
}

fun certificate_key_path(store: *Store, generation: u64) bool {
    path_reset(?store.certificate_key);
    if (!path_put(?store.certificate_key, path_text(?store.directory),
        store.directory.len)) { ret false; }
    if (!path_put(?store.certificate_key, "/certificate.", 13)) { ret false; }
    if (!path_put_number(?store.certificate_key, generation)) { ret false; }
    ret path_put(?store.certificate_key, ".key", 4);
}

# opens the directory and every document the last run left behind. a document
# that exists but does not validate is reported, never treated as absent.
pub fun open(store: *Store, a: *allocator.Allocator, directory: str) Status {
    if (store == nil || a == nil || directory == nil) { ret INVALID; }
    store.live = false;
    path_reset(?store.directory);
    val length: usize = string_length(directory);
    if (length == 0 || !path_put(?store.directory, directory, length)) {
        ret INVALID;
    }
    val created: O.Option[str] = fs.create_dir_all(a,
        path_text(?store.directory)::Path, DIRECTORY_MODE);
    if (O.is_some[str](created)) { ret FAILED; }
    if (!compose(?store.account_document, ?store.directory, "account.acme")
     || !compose(?store.certificate_document, ?store.directory,
            "certificate.acme")
     || !compose(?store.account_key, ?store.directory, "account.key")) {
        ret INVALID;
    }
    val opened: problem.Error = file_store.open_store(?store.backing,
        path_text(?store.account_document),
        path_text(?store.certificate_document));
    if (problem.failed(opened)) { ret CORRUPT; }
    val managed: problem.Error = storage.init_manager(?store.manager,
        file_store.descriptor(?store.backing));
    if (problem.failed(managed)) { ret FAILED; }
    store.live = true;
    ret OK;
}

pub fun secret_owner(store: *Store) ptr {
    ret file_store.secret_owner(?store.backing);
}

fun read_key(store: *Store, target: *PathBuffer, key: *keys.Key) Status {
    if (!fs.is_file(path_text(target)::Path)) { ret MISSING; }
    var document: file_store.Document;
    val read: problem.Error = file_store.read_document(path_text(target),
        file_store.DOC_KEY_GENERATION, ?store.buffer[0], 1024, ?document);
    if (problem.failed(read)) { ret CORRUPT; }
    if (document.payload.len != keys.SCALAR_BYTES) { ret CORRUPT; }
    if (!keys.adopt(key, document.payload.data)) { ret CORRUPT; }
    ret OK;
}

fun write_key(store: *Store, target: *PathBuffer, key: *keys.Key) Status {
    val written: problem.Error = file_store.write_document(path_text(target),
        file_store.DOC_KEY_GENERATION, keys.material(key), ?store.scratch[0],
        1024);
    if (problem.failed(written)) { ret FAILED; }
    ret OK;
}

# loads the account key, or creates and persists one on first run. an account
# that cannot prove it holds its key is a new account, so this is the one
# document whose loss changes identity.
pub fun open_account_key(store: *Store, key: *keys.Key) Status {
    if (store == nil || !store.live || key == nil) { ret INVALID; }
    val read: Status = read_key(store, ?store.account_key, key);
    if (read != MISSING) { ret read; }
    if (!keys.generate(key)) { ret FAILED; }
    val written: Status = write_key(store, ?store.account_key, key);
    if (written != OK) {
        keys.destroy(key);
        ret written;
    }
    ret OK;
}

# loads the key belonging to one committed certificate generation
pub fun open_certificate_key(store: *Store, generation: u64,
    key: *keys.Key) Status {
    if (store == nil || !store.live || key == nil || generation == 0) {
        ret INVALID;
    }
    if (!certificate_key_path(store, generation)) { ret INVALID; }
    ret read_key(store, ?store.certificate_key, key);
}

# makes the key for the next certificate generation durable. it is written
# before the record that names that generation is staged, so a committed
# record's key is always already on disk.
pub fun commit_certificate_key(store: *Store, generation: u64,
    key: *keys.Key) Status {
    if (store == nil || !store.live || key == nil || generation == 0) {
        ret INVALID;
    }
    if (!certificate_key_path(store, generation)) { ret INVALID; }
    ret write_key(store, ?store.certificate_key, key);
}

# removes a superseded generation's key. the record naming it is already gone,
# so failure here leaks a file rather than losing one.
pub fun discard_certificate_key(store: *Store, generation: u64) bool {
    if (store == nil || !store.live || generation == 0) { ret false; }
    if (!certificate_key_path(store, generation)) { ret false; }
    if (!fs.is_file(path_text(?store.certificate_key)::Path)) { ret false; }
    ret !O.is_some[str](fs.remove_file(path_text(?store.certificate_key)::Path));
}

fun from_storage(value: storage.Status) Status {
    if (value == storage.SUCCESS) { ret OK; }
    if (value == storage.NOT_FOUND) { ret MISSING; }
    if (value == storage.CONFLICT) { ret CONFLICT; }
    ret FAILED;
}

# the account url is not recovered from storage, it is re-learned: posting
# newAccount with the stored key returns the same account, which is the
# protocol's own answer to a client that restarted. the durable record is then
# reconciled against what the authority said.
pub fun account_snapshot(store: *Store, account_url: view.View,
    output: *storage.Snapshot) Status {
    if (store == nil || !store.live || output == nil) { ret INVALID; }
    output.status = storage.FAILED;
    val recovered: problem.Error = storage.recover(?store.manager,
        account_url, output);
    if (problem.failed(recovered)) { ret FAILED; }
    ret from_storage(output.status);
}

pub fun certificate_snapshot(store: *Store, storage_key: view.View,
    output: *storage.CertificateSnapshot) Status {
    if (store == nil || !store.live || output == nil) { ret INVALID; }
    output.status = storage.FAILED;
    val recovered: problem.Error = storage.recover_certificate(?store.manager,
        storage_key, output);
    if (problem.failed(recovered)) { ret FAILED; }
    ret from_storage(output.status);
}

# stages and commits the account credential in one transaction
pub fun save_account(store: *Store, expected_generation: u64,
    candidate: account.Credentials) Status {
    if (store == nil || !store.live) { ret INVALID; }
    var write: storage.Write = storage.begin_save(?store.manager,
        expected_generation, candidate);
    if (problem.failed(write.error)) { ret FAILED; }
    val committed: problem.Error = storage.commit_write(?store.manager, write);
    if (problem.failed(committed)) {
        storage.abort_write(?store.manager, write);
        ret FAILED;
    }
    ret OK;
}

# stages and commits the certificate record. its key must already be durable
# under the same generation.
pub fun save_certificate(store: *Store, expected_generation: u64,
    record: storage.CertificateRecord) Status {
    if (store == nil || !store.live) { ret INVALID; }
    if (record.generation != expected_generation + 1) { ret INVALID; }
    if (!certificate_key_path(store, record.generation)
     || !fs.is_file(path_text(?store.certificate_key)::Path)) { ret INVALID; }
    var write: storage.Write = storage.begin_replace_certificate(?store.manager,
        expected_generation, record);
    if (problem.failed(write.error)) { ret FAILED; }
    val committed: problem.Error = storage.commit_certificate(?store.manager,
        write);
    if (problem.failed(committed)) {
        storage.abort_certificate(?store.manager, write);
        ret FAILED;
    }
    ret OK;
}

fun text_view(value: str) view.View {
    ret view.view(value, string_length(value));
}

fun test_directory(target: *PathBuffer, name: str) bool {
    path_reset(target);
    if (!path_put(target, "out/acme-store-", 15)) { ret false; }
    ret path_put(target, name, string_length(name));
}

fun test_allocator(a: *allocator.Allocator, state: *fixed.FixedState,
    memory: *u8, capacity: usize) bool {
    ret !O.is_some[*u8](fixed.make(a, state, memory, capacity));
}

fun test_credentials(store: *Store, key: *keys.Key,
    url: view.View) account.Credentials {
    var value: account.Credentials;
    var identity: account.Account;
    identity.url = url;
    identity.status = account.VALID;
    identity.contacts = nil;
    identity.contact_len = 0;
    identity.orders_url = text_view("https://acme.example/account/1/orders");
    identity.terms_of_service_agreed = true;
    value.account = identity;
    value.signer = keys.signer(key);
    value.secret_owner = secret_owner(store);
    value.generation = 1;
    ret value;
}

fun test_record(store: *Store, names: *identifier.Identifier, chain: *u8,
    chain_len: usize, generation: u64) storage.CertificateRecord {
    var value: storage.CertificateRecord;
    value.storage_key = text_view("hedge.example");
    value.certificate_url = text_view("https://acme.example/cert/1");
    value.chain_der = view.view(chain, chain_len);
    value.chain_len = 1;
    value.private_key_owner = secret_owner(store);
    value.identifiers = names;
    value.identifier_len = 1;
    value.not_before_unix = 1000;
    value.not_after_unix = 90000;
    value.generation = generation;
    ret value;
}

fun mode_of(target: *PathBuffer) u32 {
    val metadata: R.Result[fs.Metadata, str] = fs.metadata(path_text(target)::Path);
    if (R.is_err[fs.Metadata, str](metadata)) { ret 0; }
    val value: fs.Metadata = R.unwrap_ok[fs.Metadata, str](metadata);
    ret value.mode & 0x1ff;
}

test "acme store: an account key is created once and reloaded" {
    var memory: [65536]u8;
    var state: fixed.FixedState;
    var a: allocator.Allocator;
    if (!test_allocator(?a, ?state, ?memory[0], 65536)) { ret 1; }
    var directory: PathBuffer;
    if (!test_directory(?directory, "account")) { ret 2; }
    fs.remove_all(?a, path_text(?directory)::Path);
    var store: Store;
    if (open(?store, ?a, path_text(?directory)) != OK) { ret 3; }
    var first: keys.Key;
    if (open_account_key(?store, ?first) != OK) { ret 4; }
    # an account key is the deployment's identity; the file that holds it is
    # readable by nobody else
    if (mode_of(?store.account_key) != 384) { ret 5; }
    if (mode_of(?store.directory) != 448) { ret 6; }
    var second: Store;
    if (open(?second, ?a, path_text(?directory)) != OK) { ret 7; }
    var reloaded: keys.Key;
    if (open_account_key(?second, ?reloaded) != OK) { ret 8; }
    var i: usize = 0;
    for (i < keys.POINT_BYTES) {
        if (first.point[i] != reloaded.point[i]) { ret 9; }
        i = i + 1;
    }
    keys.destroy(?first);
    keys.destroy(?reloaded);
    fs.remove_all(?a, path_text(?directory)::Path);
    ret 0;
}

test "acme store: a certificate survives a restart with its key" {
    var memory: [65536]u8;
    var state: fixed.FixedState;
    var a: allocator.Allocator;
    if (!test_allocator(?a, ?state, ?memory[0], 65536)) { ret 1; }
    var directory: PathBuffer;
    if (!test_directory(?directory, "certificate")) { ret 2; }
    fs.remove_all(?a, path_text(?directory)::Path);
    var store: Store;
    if (open(?store, ?a, path_text(?directory)) != OK) { ret 3; }
    var account_key: keys.Key;
    if (open_account_key(?store, ?account_key) != OK) { ret 4; }
    if (save_account(?store, 0, test_credentials(?store, ?account_key,
        text_view("https://acme.example/account/1"))) != OK) { ret 5; }

    var certificate: keys.Key;
    if (!keys.generate(?certificate)) { ret 6; }
    var chain: [64]u8;
    var i: usize = 0;
    for (i < 64) {
        chain[i] = i::u8;
        i = i + 1;
    }
    var names: [1]identifier.Identifier;
    names[0] = identifier.Identifier{kind: identifier.DNS,
        value: text_view("hedge.example")};
    # the record must not commit before its key is durable
    if (save_certificate(?store, 0, test_record(?store, ?names[0], ?chain[0],
        64, 1)) != INVALID) { ret 7; }
    if (commit_certificate_key(?store, 1, ?certificate) != OK) { ret 8; }
    if (mode_of(?store.certificate_key) != 384) { ret 9; }
    if (save_certificate(?store, 0, test_record(?store, ?names[0], ?chain[0],
        64, 1)) != OK) { ret 10; }

    var restarted: Store;
    if (open(?restarted, ?a, path_text(?directory)) != OK) { ret 11; }
    var snapshot: storage.CertificateSnapshot;
    if (certificate_snapshot(?restarted, text_view("hedge.example"),
        ?snapshot) != OK) { ret 12; }
    if (snapshot.current.generation != 1 || snapshot.has_pending) { ret 13; }
    if (!view.view_eq_str(snapshot.current.storage_key, "hedge.example")) { ret 14; }
    if (snapshot.current.chain_der.len != 64
     || snapshot.current.chain_der.data[7] != 7) { ret 15; }
    if (snapshot.current.not_after_unix != 90000) { ret 16; }
    var recovered: keys.Key;
    if (open_certificate_key(?restarted, 1, ?recovered) != OK) { ret 17; }
    i = 0;
    for (i < keys.POINT_BYTES) {
        if (certificate.point[i] != recovered.point[i]) { ret 18; }
        i = i + 1;
    }
    var account_snapshot_value: storage.Snapshot;
    if (account_snapshot(?restarted,
        text_view("https://acme.example/account/1"),
        ?account_snapshot_value) != OK) { ret 19; }
    if (!view.view_eq_str(account_snapshot_value.current.account.url,
        "https://acme.example/account/1")) { ret 20; }
    keys.destroy(?account_key);
    keys.destroy(?certificate);
    keys.destroy(?recovered);
    fs.remove_all(?a, path_text(?directory)::Path);
    ret 0;
}

test "acme store: a superseded key is discarded only after the record moves" {
    var memory: [65536]u8;
    var state: fixed.FixedState;
    var a: allocator.Allocator;
    if (!test_allocator(?a, ?state, ?memory[0], 65536)) { ret 1; }
    var directory: PathBuffer;
    if (!test_directory(?directory, "rotate")) { ret 2; }
    fs.remove_all(?a, path_text(?directory)::Path);
    var store: Store;
    if (open(?store, ?a, path_text(?directory)) != OK) { ret 3; }
    var first: keys.Key;
    var second: keys.Key;
    if (!keys.generate(?first) || !keys.generate(?second)) { ret 4; }
    var chain: [16]u8;
    var names: [1]identifier.Identifier;
    names[0] = identifier.Identifier{kind: identifier.DNS,
        value: text_view("hedge.example")};
    if (commit_certificate_key(?store, 1, ?first) != OK) { ret 5; }
    if (save_certificate(?store, 0, test_record(?store, ?names[0], ?chain[0],
        16, 1)) != OK) { ret 6; }
    if (commit_certificate_key(?store, 2, ?second) != OK) { ret 7; }
    # both keys exist while the record still names the first
    var held: keys.Key;
    if (open_certificate_key(?store, 1, ?held) != OK) { ret 8; }
    if (save_certificate(?store, 1, test_record(?store, ?names[0], ?chain[0],
        16, 2)) != OK) { ret 9; }
    if (!discard_certificate_key(?store, 1)) { ret 10; }
    if (open_certificate_key(?store, 1, ?held) != MISSING) { ret 11; }
    if (open_certificate_key(?store, 2, ?held) != OK) { ret 12; }
    # a stale generation cannot overwrite a newer record
    if (save_certificate(?store, 0, test_record(?store, ?names[0], ?chain[0],
        16, 1)) == OK) { ret 13; }
    keys.destroy(?first);
    keys.destroy(?second);
    keys.destroy(?held);
    fs.remove_all(?a, path_text(?directory)::Path);
    ret 0;
}

test "acme store: a corrupt key document is reported, not ignored" {
    var memory: [65536]u8;
    var state: fixed.FixedState;
    var a: allocator.Allocator;
    if (!test_allocator(?a, ?state, ?memory[0], 65536)) { ret 1; }
    var directory: PathBuffer;
    if (!test_directory(?directory, "corrupt")) { ret 2; }
    fs.remove_all(?a, path_text(?directory)::Path);
    var store: Store;
    if (open(?store, ?a, path_text(?directory)) != OK) { ret 3; }
    var key: keys.Key;
    if (open_account_key(?store, ?key) != OK) { ret 4; }
    keys.destroy(?key);
    var damaged: [8]u8 = [8]u8{'M', 'A', 'C', 'H', 'A', 'C', 'M', 'E'};
    if (O.is_some[str](fs.write_bytes(path_text(?store.account_key)::Path,
        ?damaged[0], 8, FILE_MODE))) { ret 5; }
    var reopened: Store;
    if (open(?reopened, ?a, path_text(?directory)) != OK) { ret 6; }
    var reloaded: keys.Key;
    if (open_account_key(?reopened, ?reloaded) != CORRUPT) { ret 7; }
    fs.remove_all(?a, path_text(?directory)::Path);
    ret 0;
}
