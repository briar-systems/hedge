# the two p-256 keys certificate management owns
#
# an acme deployment holds an account key, which authenticates every request
# and derives every key authorization, and one certificate key per managed
# name, which the authority never sees. the two are never the same key: an
# authority admits the certificate key for revocation, so sharing them would
# let anyone holding a certificate act as the account.
#
# where the key material lives is decided by the language, not by preference.
# a mach record that transitively contains secret-qualified storage is
# secret-welded and cannot be erased to `ptr`. every seam this subsystem hangs
# from is a `ptr` callback: the serving loop's plane, the service handler, the
# acme challenge provider, and the durable store's callbacks. so a key that any
# of those must reach cannot be held in secret storage at all. it is held as
# public bytes and classified into a secret stack buffer for the exact call
# that consumes it, which the caller then zeroizes. the same crossing is what
# makes the key persistable, because mach-std exposes no secret-aware file
# interface either.
#
# every classification point is one of the `scratch` arguments below. there are
# no others, and no key material is copied anywhere else.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use std.memory;
use std.crypto.rand;
use ct: std.crypto.ct;
use contracts: crypto.contracts;
use p256: crypto.group.p256;
use signature: crypto.signature;
use jose: acme.jose;
use cert: acme.certificate;

pub val SCALAR_BYTES: usize = 32;
pub val POINT_BYTES:  usize = 65;
pub val SPKI_BYTES:   usize = 91;
pub val PKCS8_BYTES:  usize = 138;
pub val MAX_SIGNATURE_BYTES: usize = 72;

val SPKI_PREFIX: usize = 26;
val PKCS8_SCALAR_AT: usize = 36;
val PKCS8_POINT_AT:  usize = 73;

# rfc 5480 subjectPublicKeyInfo for id-ecPublicKey over prime256v1
fun write_spki_prefix(output: *u8) {
    val prefix: [26]u8 = [26]u8{
        0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86,
        0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a,
        0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03,
        0x42, 0x00};
    var i: usize = 0;
    for (i < 26) {
        output[i] = prefix[i];
        i = i + 1;
    }
}

# rfc 5958 privateKeyInfo wrapping the rfc 5915 ecPrivateKey, with the public
# point included so a loader never re-derives it
fun write_pkcs8_frame(output: *u8) {
    val head: [36]u8 = [36]u8{
        0x30, 0x81, 0x87, 0x02, 0x01, 0x00, 0x30, 0x13,
        0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02,
        0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d,
        0x03, 0x01, 0x07, 0x04, 0x6d, 0x30, 0x6b, 0x02,
        0x01, 0x01, 0x04, 0x20};
    var i: usize = 0;
    for (i < 36) {
        output[i] = head[i];
        i = i + 1;
    }
    val tail: [5]u8 = [5]u8{0xa1, 0x44, 0x03, 0x42, 0x00};
    i = 0;
    for (i < 5) {
        output[68 + i] = tail[i];
        i = i + 1;
    }
}

pub rec Key {
    material: [SCALAR_BYTES]u8;
    pkcs8:    [PKCS8_BYTES]u8;
    point:    [POINT_BYTES]u8;
    spki:     [SPKI_BYTES]u8;
    live:     bool;
}

fun derive(key: *Key) bool {
    var scratch: [SCALAR_BYTES]^u8;
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        scratch[i] = key.material[i];
        i = i + 1;
    }
    val derived: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?scratch[0], len: SCALAR_BYTES},
        contracts.Buffer{data: ?key.point[0], capacity: POINT_BYTES});
    ct.zeroize(?scratch[0], SCALAR_BYTES);
    if (derived.error != contracts.OK || derived.written != POINT_BYTES) {
        ret false;
    }
    write_spki_prefix(?key.spki[0]);
    i = 0;
    for (i < POINT_BYTES) {
        key.spki[SPKI_PREFIX + i] = key.point[i];
        i = i + 1;
    }
    write_pkcs8_frame(?key.pkcs8[0]);
    i = 0;
    for (i < SCALAR_BYTES) {
        key.pkcs8[PKCS8_SCALAR_AT + i] = key.material[i];
        i = i + 1;
    }
    i = 0;
    for (i < POINT_BYTES) {
        key.pkcs8[PKCS8_POINT_AT + i] = key.point[i];
        i = i + 1;
    }
    key.live = true;
    ret true;
}

# adopts key material recovered from durable storage
pub fun adopt(key: *Key, material: *u8) bool {
    if (key == nil || material == nil) { ret false; }
    key.live = false;
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        key.material[i] = material[i];
        i = i + 1;
    }
    if (!derive(key)) {
        destroy(key);
        ret false;
    }
    ret true;
}

# draws a new key. a scalar the curve rejects is discarded and drawn again
# rather than clamped, because clamping biases the key.
pub fun generate(key: *Key) bool {
    if (key == nil) { ret false; }
    key.live = false;
    var attempts: usize = 0;
    for (attempts < 8) {
        if (rand.fill(?key.material[0], SCALAR_BYTES) != 0) { ret false; }
        if (derive(key)) { ret true; }
        attempts = attempts + 1;
    }
    destroy(key);
    ret false;
}

pub fun destroy(key: *Key) bool {
    if (key == nil) { ret false; }
    memory.raw_zero((?key.material[0])::ptr, SCALAR_BYTES);
    memory.raw_zero((?key.pkcs8[0])::ptr, PKCS8_BYTES);
    key.live = false;
    ret true;
}

# the durable form. the caller writes these bytes with owner-only permissions
# and zeroizes nothing here, because this is the record's own storage.
pub fun material(key: *Key) view.View {
    ret view.view(?key.material[0], SCALAR_BYTES);
}

# every member is set by name. an unset one would be whatever the frame held,
# and this record is handed to a validator that reads the rsa half for other
# algorithms. see briar-systems/mach#3108.
pub fun public_key(key: *Key) jose.PublicKey {
    var value: jose.PublicKey;
    value.algorithm = jose.ES256;
    value.value = contracts.Bytes{data: ?key.point[0], len: POINT_BYTES};
    value.rsa = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: nil, len: 0},
        exponent: contracts.Bytes{data: nil, len: 0}};
    ret value;
}

pub fun signer(key: *Key) jose.Signer {
    ret jose.signer(public_key(key));
}

# classifies the scalar into the caller's secret buffer for one signing call.
# the caller owns `scratch` for the whole call and zeroizes it after.
pub fun private_key(key: *Key, scratch: *^u8) jose.PrivateKey {
    var value: jose.PrivateKey;
    value.algorithm = jose.ES256;
    value.secret_owner = key::ptr;
    value.value = contracts.SecretBytes{data: scratch, len: SCALAR_BYTES};
    value.rsa = signature.RsaPrivateKey{
        modulus: contracts.Bytes{data: nil, len: 0},
        public_exponent: contracts.Bytes{data: nil, len: 0},
        private_exponent: contracts.SecretBytes{data: nil, len: 0}};
    if (key == nil || scratch == nil) { ret value; }
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        scratch[i] = key.material[i];
        i = i + 1;
    }
    ret value;
}

# classifies the encoded private key so mach-tls can load a served identity
pub fun private_der(key: *Key, scratch: *^u8) contracts.SecretBytes {
    if (key == nil || scratch == nil) {
        ret contracts.SecretBytes{data: scratch, len: 0};
    }
    var i: usize = 0;
    for (i < PKCS8_BYTES) {
        scratch[i] = key.pkcs8[i];
        i = i + 1;
    }
    ret contracts.SecretBytes{data: scratch, len: PKCS8_BYTES};
}

pub fun public_der(key: *Key) view.View {
    ret view.view(?key.spki[0], SPKI_BYTES);
}

fun sign_csr(context: ptr, tbs: *u8, tbs_len: usize, output: *u8,
    capacity: usize) usize {
    val key: *Key = context::*Key;
    if (key == nil || !key.live || tbs == nil || output == nil) { ret 0; }
    var scratch: [SCALAR_BYTES]^u8;
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        scratch[i] = key.material[i];
        i = i + 1;
    }
    val signed: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?scratch[0], len: SCALAR_BYTES},
        contracts.Bytes{data: tbs, len: tbs_len},
        contracts.Buffer{data: output, capacity: capacity});
    ct.zeroize(?scratch[0], SCALAR_BYTES);
    if (signed.error != contracts.OK) { ret 0; }
    ret signed.written;
}

pub fun csr_signer(key: *Key) cert.CsrSigner {
    var value: cert.CsrSigner;
    value.ctx = key::ptr;
    value.sign = sign_csr;
    value.algorithm = cert.ECDSA_P256_SHA256;
    value.public_key_der = view.view(?key.spki[0], SPKI_BYTES);
    ret value;
}

test "acme keys: a generated key derives a valid signer and encodings" {
    var key: Key;
    if (!generate(?key)) { ret 1; }
    if (!key.live || key.point[0] != 4) { ret 2; }
    if (!jose.valid(signer(?key))) { ret 3; }
    var scratch: [SCALAR_BYTES]^u8;
    val private: jose.PrivateKey = private_key(?key, ?scratch[0]);
    if (!jose.key_pair_valid(public_key(?key), private)) { ret 4; }
    ct.zeroize(?scratch[0], SCALAR_BYTES);
    val encoded: view.View = public_der(?key);
    if (encoded.len != SPKI_BYTES || encoded.data[0] != 0x30) { ret 5; }
    var i: usize = 0;
    for (i < POINT_BYTES) {
        if (key.spki[SPKI_PREFIX + i] != key.point[i]
         || key.pkcs8[PKCS8_POINT_AT + i] != key.point[i]) { ret 6; }
        i = i + 1;
    }
    if (!destroy(?key)) { ret 7; }
    ret 0;
}

test "acme keys: adopted material reproduces the same key" {
    var first: Key;
    if (!generate(?first)) { ret 1; }
    var carried: [SCALAR_BYTES]u8;
    val durable: view.View = material(?first);
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        carried[i] = durable.data[i];
        i = i + 1;
    }
    var second: Key;
    if (!adopt(?second, ?carried[0])) { ret 2; }
    i = 0;
    for (i < POINT_BYTES) {
        if (first.point[i] != second.point[i]) { ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < PKCS8_BYTES) {
        if (first.pkcs8[i] != second.pkcs8[i]) { ret 4; }
        i = i + 1;
    }
    destroy(?first);
    destroy(?second);
    ret 0;
}

test "acme keys: the certification signer produces a verifiable signature" {
    var key: Key;
    if (!generate(?key)) { ret 1; }
    val csr: cert.CsrSigner = csr_signer(?key);
    if (csr.algorithm != cert.ECDSA_P256_SHA256
     || csr.public_key_der.len != SPKI_BYTES) { ret 2; }
    var message: [8]u8 = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var produced: [MAX_SIGNATURE_BYTES]u8;
    val written: usize = csr.sign(csr.ctx, ?message[0], 8, ?produced[0],
        MAX_SIGNATURE_BYTES);
    if (written == 0) { ret 3; }
    val verified: contracts.Error = signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?key.point[0], len: POINT_BYTES},
        contracts.Bytes{data: ?message[0], len: 8},
        contracts.Bytes{data: ?produced[0], len: written});
    if (verified != contracts.OK) { ret 4; }
    destroy(?key);
    ret 0;
}

test "acme keys: a destroyed key stops signing and leaves no material" {
    var key: Key;
    if (!generate(?key)) { ret 1; }
    val csr: cert.CsrSigner = csr_signer(?key);
    destroy(?key);
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        if (key.material[i] != 0) { ret 2; }
        i = i + 1;
    }
    var message: [4]u8 = [4]u8{9, 9, 9, 9};
    var produced: [MAX_SIGNATURE_BYTES]u8;
    if (csr.sign(csr.ctx, ?message[0], 4, ?produced[0], MAX_SIGNATURE_BYTES)
        != 0) { ret 3; }
    ret 0;
}

test "acme keys: two generated keys differ" {
    var first: Key;
    var second: Key;
    if (!generate(?first) || !generate(?second)) { ret 1; }
    var same: bool = true;
    var i: usize = 0;
    for (i < POINT_BYTES) {
        if (first.point[i] != second.point[i]) { same = false; }
        i = i + 1;
    }
    destroy(?first);
    destroy(?second);
    if (same) { ret 2; }
    ret 0;
}
