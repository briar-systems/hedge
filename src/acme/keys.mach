# the two p-256 keys certificate management owns
#
# an acme deployment holds an account key, which authenticates every request
# and derives every key authorization, and one certificate key per managed
# name, which the authority never sees. the two are never the same key: an
# authority admits the certificate key for revocation, so sharing them would
# let anyone holding a certificate act as the account.
#
# the scalar and its pkcs#8 encoding are secret-typed for the key's whole life.
# a record holding secret storage is welded and never erases to `ptr`. the
# certification-request signer takes a typed `*Key`, but the manager that owns
# the account and certificate keys is reachable from the worker threads' `*u8`
# start argument, and a welded key would weld it. so the secret half lives
# here, in a ring of secret slots sized from the certificates a deployment
# manages, and a `Key` is the public half plus a handle to its slot. a handle
# names a slot and a generation, is not an address, and unlocks nothing but
# the operations below.
#
# the material is drawn straight into its slot, signed with in place, and
# handed to mach-tls as secret bytes. it becomes public at exactly one `:>`
# site, `publish`, the durable form, because mach-acme's file store encodes
# public bytes. a scalar read back from disk arrives in secret storage and
# `adopt` copies it into its slot.

use cert: acme.certificate;
use acme.jose;
use crypto.contracts;
use crypto.group.p256;
use crypto.signature;
use std.crypto.ct;
use io_error: std.io.error;
use std.memory.secret;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.view;

fun filled(outcome: err[io_error.Error]) bool {
    ret sel outcome.ok;
}

pub val SCALAR_BYTES:        usize = 32;
pub val POINT_BYTES:         usize = 65;
pub val SPKI_BYTES:          usize = 91;
pub val PKCS8_BYTES:         usize = 138;
pub val MAX_SIGNATURE_BYTES: usize = 72;

val SPKI_PREFIX:     usize = 26;
val PKCS8_SCALAR_AT: usize = 36;
val PKCS8_POINT_AT:  usize = 73;

# rfc 5480 subjectPublicKeyInfo for id-ecPublicKey over prime256v1
fun write_spki_prefix(output: *u8) {
    val prefix: [26]u8 = [26]u8{
        0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86,
        0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a,
        0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03,
        0x42, 0x00
    };
    var i: usize = 0;
    for (i < 26) {
        output[i] = prefix[i];
        i         = i + 1;
    }
}

# rfc 5958 privateKeyInfo wrapping the rfc 5915 ecPrivateKey, with the public
# point included so a loader never re-derives it
fun write_pkcs8_frame(output: *^u8) {
    val head: [36]u8 = [36]u8{
        0x30, 0x81, 0x87, 0x02, 0x01, 0x00, 0x30, 0x13,
        0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02,
        0x01, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d,
        0x03, 0x01, 0x07, 0x04, 0x6d, 0x30, 0x6b, 0x02,
        0x01, 0x01, 0x04, 0x20
    };
    var i: usize = 0;
    for (i < 36) {
        output[i] = head[i];
        i         = i + 1;
    }
    val tail: [5]u8 = [5]u8{0xa1, 0x44, 0x03, 0x42, 0x00};
    i = 0;
    for (i < 5) {
        output[68 + i] = tail[i];
        i              = i + 1;
    }
}

# the keys one managed certificate holds at once: the account key its session
# signs with, the pending and active certificate keys, and a tls-alpn-01
# presentation key
pub val KEYS_PER_CERTIFICATE: usize = 4;
# the handle of a key that holds no slot
pub val NO_SLOT: usize = 0xffffffffffffffff;

# a claimed slot belongs to the key that holds it, and a handle holds it only
# while the generations agree
rec Slot {
    material:   ^[SCALAR_BYTES]u8;
    pkcs8:      ^[PKCS8_BYTES]u8;
    claimed:    bool;
    generation: u64;
}

# drawn once in secret storage by `reserve`. slots are claimed and given back
# under `ring_lock`, since keys are drawn on more than one thread. every claim
# takes the next generation the process has issued, so no handle outlives its
# key, even across a ring released and drawn again
var ring:          *Slot;
var ring_capacity: usize;
var ring_lock:     mutex.Mutex;
var generations:   u64;

# sizes the ring for `certificates` managed certificates, once per process.
# every key drawn afterwards takes a slot from it, and none can be drawn before
pub fun reserve(certificates: usize) bool {
    if (certificates == 0 || certificates > NO_SLOT / KEYS_PER_CERTIFICATE) { ret false; }
    val slots: usize = certificates * KEYS_PER_CERTIFICATE;
    mutex.lock(?ring_lock);
    if (ring != nil) {
        mutex.unlock(?ring_lock);
        ret false;
    }
    val drawn: *Slot = secret.allocate_typed[Slot](slots);
    if (drawn == nil) {
        mutex.unlock(?ring_lock);
        ret false;
    }
    ring          = drawn;
    ring_capacity = slots;
    mutex.unlock(?ring_lock);
    ret true;
}

# how many keys the ring holds at once, zero before `reserve`
pub fun capacity() usize {
    ret ring_capacity;
}

# wipes the ring and gives its storage back. refused while any key still holds
# a slot, since that key's handle would then name freed storage
pub fun release_ring() bool {
    mutex.lock(?ring_lock);
    if (ring == nil) {
        mutex.unlock(?ring_lock);
        ret true;
    }
    var i: usize = 0;
    for (i < ring_capacity) {
        if (ring[i].claimed) {
            mutex.unlock(?ring_lock);
            ret false;
        }
        i = i + 1;
    }
    val released: err[io_error.Error] = secret.deallocate_typed[Slot](ring, ring_capacity);
    if (!filled(released)) {
        mutex.unlock(?ring_lock);
        ret false;
    }
    ring          = nil;
    ring_capacity = 0;
    mutex.unlock(?ring_lock);
    ret true;
}

pub rec Key {
    point:      [POINT_BYTES]u8;
    spki:       [SPKI_BYTES]u8;
    slot:       usize;
    generation: u64;
    live:       bool;
}

# marks a key record in storage that was never zeroed as holding nothing. a
# zeroed record already does, since no slot is ever at generation zero.
pub fun clear(key: *Key) {
    if (key == nil) { ret; }
    key.slot       = NO_SLOT;
    key.generation = 0;
    key.live       = false;
}

fun claim(key: *Key) bool {
    mutex.lock(?ring_lock);
    var i: usize = 0;
    for (i < ring_capacity) {
        val slot: *Slot = ?ring[i];
        if (!slot.claimed) {
            generations     = generations + 1;
            slot.claimed    = true;
            slot.generation = generations;
            key.slot        = i;
            key.generation  = slot.generation;
            mutex.unlock(?ring_lock);
            ret true;
        }
        i = i + 1;
    }
    mutex.unlock(?ring_lock);
    ret false;
}

# the slot a key holds, or nil for a key that holds none
fun slot_of(key: *Key) *Slot {
    if (key == nil) { ret nil; }
    mutex.lock(?ring_lock);
    if (key.slot >= ring_capacity) {
        mutex.unlock(?ring_lock);
        ret nil;
    }
    val slot: *Slot = ?ring[key.slot];
    val held: bool  = slot.claimed && slot.generation == key.generation;
    mutex.unlock(?ring_lock);
    if (!held) { ret nil; }
    ret slot;
}

fun release(key: *Key) {
    val slot: *Slot = slot_of(key);
    if (slot != nil) {
        ct.zeroize(?slot.material[0], SCALAR_BYTES);
        ct.zeroize(?slot.pkcs8[0], PKCS8_BYTES);
        mutex.lock(?ring_lock);
        slot.claimed = false;
        mutex.unlock(?ring_lock);
    }
    key.slot       = NO_SLOT;
    key.generation = 0;
}

fun derive(key: *Key, slot: *Slot) bool {
    val derived: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?slot.material[0], len: SCALAR_BYTES},
        contracts.Buffer{data: ?key.point[0], capacity: POINT_BYTES});
    if (derived.error != contracts.OK || derived.written != POINT_BYTES) {
        ret false;
    }
    write_spki_prefix(?key.spki[0]);
    var i: usize = 0;
    for (i < POINT_BYTES) {
        key.spki[SPKI_PREFIX + i] = key.point[i];
        i                         = i + 1;
    }
    write_pkcs8_frame(?slot.pkcs8[0]);
    i = 0;
    for (i < SCALAR_BYTES) {
        slot.pkcs8[PKCS8_SCALAR_AT + i] = slot.material[i];
        i                               = i + 1;
    }
    i = 0;
    for (i < POINT_BYTES) {
        slot.pkcs8[PKCS8_POINT_AT + i] = key.point[i];
        i                              = i + 1;
    }
    key.live = true;
    ret true;
}

# adopts key material recovered from durable storage, replacing whatever `key`
# held. the caller owns and wipes `material`.
pub fun adopt(key: *Key, material: *^u8) bool {
    if (key == nil || material == nil) { ret false; }
    destroy(key);
    if (!claim(key)) { ret false; }
    val slot: *Slot = slot_of(key);
    var i:    usize = 0;
    for (i < SCALAR_BYTES) {
        slot.material[i] = material[i];
        i                = i + 1;
    }
    if (!derive(key, slot)) {
        destroy(key);
        ret false;
    }
    ret true;
}

# draws a new key, replacing whatever `key` held. a scalar the curve rejects is
# discarded and drawn again rather than clamped, because clamping biases the key.
pub fun generate(key: *Key) bool {
    if (key == nil) { ret false; }
    destroy(key);
    if (!claim(key)) { ret false; }
    val slot:     *Slot = slot_of(key);
    var attempts: usize = 0;
    for (attempts < 8) {
        if (!filled(secret.random_fill(?slot.material[0], SCALAR_BYTES))) {
            brk;
        }
        if (derive(key, slot)) { ret true; }
        attempts = attempts + 1;
    }
    destroy(key);
    ret false;
}

# wipes the key's slot and gives it back. a key that holds no slot is only
# marked dead.
pub fun destroy(key: *Key) bool {
    if (key == nil) { ret false; }
    release(key);
    key.live = false;
    ret true;
}

# moves `source` into `target`, destroying what `target` held and leaving
# `source` holding nothing. the secret half never moves.
pub fun replace(target: *Key, source: *Key) bool {
    if (target == nil || source == nil || !source.live
        || slot_of(source) == nil) { ret false; }
    destroy(target);
    @target     = @source;
    source.slot = NO_SLOT;
    source.live = false;
    ret true;
}

# the durable form, written into the caller's `output` of SCALAR_BYTES. the
# caller persists it and wipes it.
pub fun publish(key: *Key, output: *u8) bool {
    if (key == nil || !key.live || output == nil) { ret false; }
    val slot: *Slot = slot_of(key);
    if (slot == nil) { ret false; }
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        # declassify: the scalar is persisted through mach-acme's public file store
        output[i] = slot.material[i]:>u8;
        i         = i + 1;
    }
    ret true;
}

# every member is set by name. an unset one would be whatever the frame held,
# and this record is handed to a validator that reads the rsa half for other
# algorithms. see briar-systems/mach#3108.
pub fun public_key(key: *Key) jose.PublicKey {
    var value: jose.PublicKey;
    value.algorithm = jose.ES256;
    value.value     = contracts.Bytes{data: ?key.point[0], len: POINT_BYTES};
    value.rsa       = signature.RsaPublicKey{
        modulus:  contracts.Bytes{data: nil, len: 0},
        exponent: contracts.Bytes{data: nil, len: 0}
    };
    ret value;
}

pub fun signer(key: *Key) jose.Signer {
    ret jose.signer(public_key(key));
}

# the scalar in its slot, for one signing call. a dead key yields an empty
# scalar, which every signer refuses.
pub fun private_key(key: *Key) jose.PrivateKey {
    var value: jose.PrivateKey;
    value.algorithm    = jose.ES256;
    value.secret_owner = key::ptr;
    value.value        = contracts.SecretBytes{data: nil, len: 0};
    value.rsa          = signature.RsaPrivateKey{
        modulus:          contracts.Bytes{data: nil, len: 0},
        public_exponent:  contracts.Bytes{data: nil, len: 0},
        private_exponent: contracts.SecretBytes{data: nil, len: 0}
    };
    val slot: *Slot = slot_of(key);
    if (slot == nil || !key.live) { ret value; }
    value.value = contracts.SecretBytes{data: ?slot.material[0],
        len: SCALAR_BYTES};
    ret value;
}

# the encoded private key in its slot, so mach-tls can load a served identity
pub fun private_der(key: *Key) contracts.SecretBytes {
    val slot: *Slot = slot_of(key);
    if (slot == nil || !key.live) {
        ret contracts.SecretBytes{data: nil, len: 0};
    }
    ret contracts.SecretBytes{data: ?slot.pkcs8[0], len: PKCS8_BYTES};
}

pub fun public_der(key: *Key) view.View {
    ret view.view(?key.spki[0], SPKI_BYTES);
}

fun sign_csr(key: *Key, tbs: *u8, tbs_len: usize, output: *u8,
    capacity: usize) usize {
    if (key == nil || !key.live || tbs == nil || output == nil) { ret 0; }
    val slot: *Slot = slot_of(key);
    if (slot == nil) { ret 0; }
    val signed: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?slot.material[0], len: SCALAR_BYTES},
        contracts.Bytes{data: tbs, len: tbs_len},
        contracts.Buffer{data: output, capacity: capacity});
    if (signed.error != contracts.OK) { ret 0; }
    ret signed.written;
}

pub fun csr_signer(key: *Key) cert.CsrSigner[Key] {
    var value: cert.CsrSigner[Key];
    value.ctx            = key;
    value.sign           = sign_csr;
    value.algorithm      = cert.ECDSA_P256_SHA256;
    value.public_key_der = view.view(?key.spki[0], SPKI_BYTES);
    ret value;
}

test generate__valid_signer_and_encodings {
    if (!reserve(1)) { ret 99; }
    var key: Key;
    if (!generate(?key))                                           { ret 1; }
    if (!key.live || key.point[0] != 4)                            { ret 2; }
    if (!jose.valid(signer(?key)))                                 { ret 3; }
    if (!jose.key_pair_valid(public_key(?key), private_key(?key))) { ret 4; }
    val encoded: view.View = public_der(?key);
    if (encoded.len != SPKI_BYTES || encoded.data[0] != 0x30) { ret 5; }
    var i: usize = 0;
    for (i < POINT_BYTES) {
        if (key.spki[SPKI_PREFIX + i] != key.point[i]) { ret 6; }
        i = i + 1;
    }
    if (private_der(?key).len != PKCS8_BYTES) { ret 7; }
    if (!destroy(?key))                       { ret 8; }
    ret 0;
}

test adopt__reproduces_the_key {
    if (!reserve(1)) { ret 99; }
    var first: Key;
    if (!generate(?first)) { ret 1; }
    var carried: [SCALAR_BYTES]u8;
    if (!publish(?first, ?carried[0])) { ret 2; }
    var lifted: [SCALAR_BYTES]^u8;
    var j:      usize = 0;
    for (j < SCALAR_BYTES) {
        lifted[j] = carried[j];
        j         = j + 1;
    }
    var second: Key;
    if (!adopt(?second, ?lifted[0])) { ret 3; }
    ct.zeroize(?lifted[0], SCALAR_BYTES);
    if (second.slot == first.slot) { ret 4; }
    var i: usize = 0;
    for (i < POINT_BYTES) {
        if (first.point[i] != second.point[i]) { ret 5; }
        i = i + 1;
    }
    var again: [SCALAR_BYTES]u8;
    if (!publish(?second, ?again[0])) { ret 6; }
    i = 0;
    for (i < SCALAR_BYTES) {
        if (carried[i] != again[i]) { ret 7; }
        i = i + 1;
    }
    destroy(?first);
    destroy(?second);
    ret 0;
}

test replace__moves_the_key {
    if (!reserve(1)) { ret 99; }
    var active:  Key;
    var pending: Key;
    if (!generate(?active) || !generate(?pending)) { ret 1; }
    val moved: usize = pending.slot;
    val freed: usize = active.slot;
    if (!replace(?active, ?pending))                          { ret 2; }
    if (!active.live || pending.live)                         { ret 3; }
    if (active.slot != moved || replace(?active, ?pending))   { ret 4; }
    if (ring[freed].claimed || private_der(?active).len == 0) { ret 5; }
    destroy(?active);
    ret 0;
}

test csr_signer__verifiable_signature {
    if (!reserve(1)) { ret 99; }
    var key: Key;
    if (!generate(?key)) { ret 1; }
    val csr: cert.CsrSigner[Key] = csr_signer(?key);
    if (csr.algorithm != cert.ECDSA_P256_SHA256
        || csr.public_key_der.len != SPKI_BYTES) { ret 2; }
    var message:  [8]u8 = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var produced: [MAX_SIGNATURE_BYTES]u8;
    val written:  usize = csr.sign(csr.ctx, ?message[0], 8, ?produced[0],
        MAX_SIGNATURE_BYTES);
    if (written == 0) { ret 3; }
    val verified: contracts.Error = signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?key.point[0], len: POINT_BYTES},
        contracts.Bytes{data: ?message[0], len: 8},
        contracts.Bytes{data: ?produced[0], len: written});
    if (verified != contracts.OK) { ret 4; }
    destroy(?key);
    ret 0;
}

test destroy__stops_signing_and_zeroes {
    if (!reserve(1)) { ret 99; }
    var key: Key;
    if (!generate(?key)) { ret 1; }
    val held: usize               = key.slot;
    val csr:  cert.CsrSigner[Key] = csr_signer(?key);
    destroy(?key);
    var i: usize = 0;
    for (i < SCALAR_BYTES) {
        # declassify: test assertion that the wipe reached the slot
        if ((ring[held].material[i]:>u8) != 0) { ret 2; }
        i = i + 1;
    }
    var message:  [4]u8 = [4]u8{9, 9, 9, 9};
    var produced: [MAX_SIGNATURE_BYTES]u8;
    if (csr.sign(csr.ctx, ?message[0], 4, ?produced[0], MAX_SIGNATURE_BYTES)
        != 0) { ret 3; }
    var published: [SCALAR_BYTES]u8;
    if (publish(?key, ?published[0]) || private_der(?key).len != 0
        || private_key(?key).value.len != 0) { ret 4; }
    ret 0;
}

test generate__stale_handle_holds_nothing {
    if (!reserve(1)) { ret 99; }
    var first: Key;
    if (!generate(?first)) { ret 1; }
    var stale: Key = first;
    destroy(?first);
    var second: Key;
    if (!generate(?second) || second.slot != stale.slot) { ret 2; }
    if (private_der(?stale).len != 0 || destroy(?stale) == false
        || private_der(?second).len != PKCS8_BYTES) { ret 3; }
    destroy(?second);
    ret 0;
}

test generate__refused_when_the_ring_is_full {
    if (!reserve(1)) { ret 99; }
    # one certificate's worth of slots
    var held: [KEYS_PER_CERTIFICATE]Key;
    var i:    usize = 0;
    for (i < KEYS_PER_CERTIFICATE) {
        if (!generate(?held[i])) { ret 1; }
        i = i + 1;
    }
    var extra: Key;
    if (generate(?extra) || extra.live) { ret 2; }
    destroy(?held[3]);
    if (!generate(?extra) || extra.slot != 3) { ret 3; }
    destroy(?extra);
    # the ring is sized once, and cannot be given back while a key holds a slot
    if (reserve(1) || release_ring()) { ret 4; }
    i = 0;
    for (i < KEYS_PER_CERTIFICATE) {
        destroy(?held[i]);
        i = i + 1;
    }
    if (!release_ring() || capacity() != 0 || generate(?extra)) { ret 5; }
    ret 0;
}

test generate__keys_differ {
    if (!reserve(1)) { ret 99; }
    var first:  Key;
    var second: Key;
    if (!generate(?first) || !generate(?second)) { ret 1; }
    var same: bool  = true;
    var i:    usize = 0;
    for (i < POINT_BYTES) {
        if (first.point[i] != second.point[i]) { same = false; }
        i = i + 1;
    }
    destroy(?first);
    destroy(?second);
    if (same) { ret 2; }
    ret 0;
}
