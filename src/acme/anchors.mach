# the trust anchors an ACME authority is verified against
#
# an authority reached over TLS is only an authority if its certificate chains
# to something the deployment already trusts. that set is configuration, not a
# default: hedge ships no root list, because a root list that arrives with the
# server is a root list nobody chose.
#
# storage is sized from the file rather than fixed, because the two real cases
# differ by two orders of magnitude — a single test root, and a system bundle
# of a hundred and twenty. it is allocated only when an authority is actually
# configured to be reached over TLS.

use crypto.contracts;
use pem_codec: crypto.encoding.pem;
use std.allocator;
use std.allocator.fixed;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.io.file;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.path.Path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use tls.cert;
use tls.cert.x509;

# a bundle larger than this is refused rather than truncated: a truncated
# anchor set is a silently smaller trust decision

fun present(outcome: res[bool, io_error.Error]) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun fixed_ok(outcome: err[allocator.Error]) bool {
    ret sel outcome.ok;
}

fun fs_ok(outcome: err[fs.FsError]) bool {
    ret sel outcome.ok;
}

pub val MAX_BUNDLE_BYTES: usize = 1048576;
pub val MAX_ANCHORS:      usize = 512;

pub def Status: u8;
pub val OK:          Status = 1;
pub val MISSING:     Status = 2;
pub val UNREADABLE:  Status = 3;
pub val UNDECODABLE: Status = 4;
pub val TOO_LARGE:   Status = 5;
pub val INVALID:     Status = 6;

pub rec Anchors {
    certificates: *cert.Certificate;
    der:          *u8;
    der_capacity: usize;
    store:        cert.TrustStore;
    live:         bool;
}

pub fun empty(anchors: *Anchors) bool {
    if (anchors == nil) { ret false; }
    anchors.certificates = nil;
    anchors.der          = nil;
    anchors.der_capacity = 0;
    anchors.store        = cert.TrustStore{anchors: nil, len: 0};
    anchors.live         = false;
    ret true;
}

fun file_size(path: str, output: *usize) Status {
    if (path == nil || path[0] == 0)      { ret INVALID; }
    if (!present(fs.is_file(path::Path))) { ret MISSING; }
    val metadata: res[fs.Metadata, io_error.Error] = fs.metadata(path::Path);
    if (sel metadata.err) { ret UNREADABLE; }
    val value: fs.Metadata = metadata.ok;
    if (value.size == 0)               { ret UNDECODABLE; }
    if (value.size > MAX_BUNDLE_BYTES) { ret TOO_LARGE; }
    @output = value.size;
    ret OK;
}

fun matches(data: *u8, at: usize, length: usize, value: str) bool {
    var i: usize = 0;
    for (value[i] != 0) {
        if (at + i >= length || data[at + i] != value[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

def BlockStatus: u8;
val BLOCK_FOUND:     BlockStatus = 1;
val BLOCK_EOF:       BlockStatus = 2;
val BLOCK_MALFORMED: BlockStatus = 3;

# finds the next certificate block, ignoring everything between blocks.
#
# a ca bundle is not a chain. every distribution writes the subject as a
# comment line above each certificate, and openssl has always ignored text
# outside the delimiters, so a loader that refuses it cannot read the file
# every deployment actually has. mach-tls's `chain_pem` is strict on purpose
# and that strictness is right for a chain; the tolerance belongs here.
fun next_block(data: *u8, length: usize, from: usize, start: *usize,
    finish: *usize) BlockStatus {
    val opening: str   = "-----BEGIN CERTIFICATE-----";
    val closing: str   = "-----END CERTIFICATE-----";
    var at:      usize = from;
    for (at < length && !matches(data, at, length, opening)) { at = at + 1; }
    if (at >= length) { ret BLOCK_EOF; }
    @start = at;
    var cursor: usize = at + 27;
    for (cursor < length && !matches(data, cursor, length, closing)) {
        cursor = cursor + 1;
    }
    if (cursor >= length) { ret BLOCK_MALFORMED; }
    cursor = cursor + 25;
    # the decoder wants the trailing newline inside the block it is given
    if (cursor < length && data[cursor] == 13) { cursor = cursor + 1; }
    if (cursor < length && data[cursor] == 10) { cursor = cursor + 1; }
    @finish = cursor;
    ret BLOCK_FOUND;
}

# loads a PEM bundle into der the caller owns for the life of the store
pub fun load_bundle(anchors: *Anchors, a: *allocator.Allocator,
    path: str) Status {
    if (anchors == nil || a == nil) { ret INVALID; }
    empty(anchors);
    var size:     usize  = 0;
    val measured: Status = file_size(path, ?size);
    if (measured != OK) { ret measured; }
    val pem_memory: res[*u8, allocator.Error] = allocator.allocate[u8](a, size);
    if (sel pem_memory.err) { ret UNREADABLE; }
    val pem:    *u8                          = pem_memory.ok;
    val opened: res[fs.File, io_error.Error] = fs.open(path::Path);
    if (sel opened.err) { ret UNREADABLE; }
    var handle: fs.File                    = opened.ok;
    val read:   res[usize, io_error.Error] = file.read_at(handle, pem, size, 0);
    fs.close(?handle);
    if (sel read.err) { ret UNREADABLE; }
    val length: usize = read.ok;
    if (length != size) { ret UNREADABLE; }

    # der is never longer than the base64 that encoded it, so the source
    # length is a sound bound for the decoded form
    val der_memory:  res[*u8, allocator.Error]               = allocator.allocate[u8](a, length);
    val slot_memory: res[*cert.Certificate, allocator.Error] =
        allocator.allocate[cert.Certificate](a, MAX_ANCHORS);
    if (sel der_memory.err)  { ret UNREADABLE; }
    if (sel slot_memory.err) { ret UNREADABLE; }
    val der_storage:         *u8               = der_memory.ok;
    val certificate_storage: *cert.Certificate =
        slot_memory.ok;
    var found:   usize = 0;
    var written: usize = 0;
    var at:      usize = 0;
    for (at < length) {
        var start:   usize       = 0;
        var finish:  usize       = 0;
        val scanned: BlockStatus = next_block(pem, length, at, ?start,
            ?finish);
        if (scanned == BLOCK_EOF)   { brk; }
        if (scanned != BLOCK_FOUND) { ret UNDECODABLE; }
        at = finish;
        if (found >= MAX_ANCHORS) { ret TOO_LARGE; }
        var block:   pem_codec.Block;
        val decoded: contracts.Error = pem_codec.decode(
            contracts.Bytes{data: ?pem[start], len: finish - start},
            contracts.Buffer{data: ?der_storage[written],
            capacity: length - written},
            ?block);
        # malformed pem is not an anchor and refuses the bundle
        if (decoded != contracts.OK) { ret UNDECODABLE; }
        # parsed as an anchor, not as a chain member. nobody ever verifies a
        # root's own signature — it is trusted because it was configured — so a
        # self-signature this build cannot verify must not disqualify the root.
        # parsing these as chain certificates rejected 50 of the 121 roots in a
        # stock system bundle, every ecdsa-with-SHA384 root among them.
        var parsed:        x509.Certificate;
        val parsed_status: contracts.Error = x509.parse_trust_anchor(
            block.der, ?parsed);
        # system bundles include algorithms this verifier cannot represent.
        # only usable anchors enter the store, and at least one is required.
        if (parsed_status == contracts.OK) {
            certificate_storage[found].der     = block.der.data;
            certificate_storage[found].der_len = block.der.len;
            written                            = written + block.der.len;
            found                              = found + 1;
        }
    }
    if (found == 0) { ret UNDECODABLE; }
    anchors.der          = der_storage;
    anchors.der_capacity = length;
    anchors.certificates = certificate_storage;
    anchors.store        = cert.TrustStore{anchors: anchors.certificates, len: found};
    anchors.live         = true;
    ret OK;
}

pub fun count(anchors: *Anchors) usize {
    if (anchors == nil || !anchors.live) { ret 0; }
    ret anchors.store.len;
}

pub fun store(anchors: *Anchors) *cert.TrustStore {
    if (anchors == nil || !anchors.live) { ret nil; }
    ret ?anchors.store;
}

fun test_allocator(a: *allocator.Allocator, arena: *fixed.FixedState,
    memory: *u8, capacity: usize) bool {
    ret fixed_ok(fixed.make(a, arena, memory, capacity));
}

fun put(target: *u8, at: usize, value: str) usize {
    var i: usize = 0;
    for (value[i] != 0) {
        target[at + i] = value[i];
        i              = i + 1;
    }
    ret at + i;
}

test "acme anchors: blocks are found through the text a bundle carries" {
    # every distribution writes the subject as a comment above each
    # certificate, so a scanner that cannot step over text cannot read the
    # file the deployment actually has
    var document: [1024]u8;
    var at:       usize = put(?document[0], 0, "# issuer one\n");
    at = put(?document[0], at, "-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n");
    val first_end: usize = at;
    at = put(?document[0], at, "\n# issuer two\n");
    val second_start: usize = at;
    at = put(?document[0], at, "-----BEGIN CERTIFICATE-----\nBBBB\n-----END CERTIFICATE-----\n");

    var start:  usize = 0;
    var finish: usize = 0;
    if (next_block(?document[0], at, 0, ?start, ?finish)
        != BLOCK_FOUND) { ret 1; }
    if (start != 13 || finish != first_end)                   { ret 2; }
    if (document[start] != '-' || document[finish - 1] != 10) { ret 3; }
    if (next_block(?document[0], at, finish, ?start, ?finish)
        != BLOCK_FOUND) { ret 4; }
    if (start != second_start || finish != at) { ret 5; }
    # and nothing is found past the last block
    if (next_block(?document[0], at, finish, ?start, ?finish)
        != BLOCK_EOF) { ret 6; }
    # a block that never ends is not a block
    val truncated: usize = put(?document[0], 0,
        "-----BEGIN CERTIFICATE-----\nAAAA\n");
    if (next_block(?document[0], truncated, 0, ?start, ?finish)
        != BLOCK_MALFORMED) { ret 7; }
    ret 0;
}

test "acme anchors: a valid prefix cannot hide a truncated trailing block" {
    val valid:    str   = "test/interop/fixtures/root.pem";
    var document: [4096]u8;
    var length:   usize = 0;
    if (file_size(valid, ?length) != OK || length >= 4000) { ret 1; }
    val opened: res[fs.File, io_error.Error] = fs.open(valid::Path);
    if (sel opened.err) { ret 2; }
    var handle: fs.File                    = opened.ok;
    val read:   res[usize, io_error.Error] = file.read_at(handle,
        ?document[0], length, 0);
    fs.close(?handle);
    if (sel read.err)      { ret 3; }
    if (read.ok != length) { ret 3; }
    val directory: str = "out/acme-anchors-truncated";
    val path:      str = "out/acme-anchors-truncated/bundle.pem";
    var memory:    [262144]u8;
    var arena:     fixed.FixedState;
    var a:         allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 262144)) { ret 4; }
    fs.create_dir_all(?a, directory::Path, 448);
    if (!fs_ok(fs.write_bytes(path::Path, ?document[0], length,
        384))) { ret 5; }
    var anchors: Anchors;
    if (load_bundle(?anchors, ?a, path) != OK || count(?anchors) != 1) {
        ret 6;
    }

    length = put(?document[0], length,
        "# malformed tail\n-----BEGIN CERTIFICATE-----\nAAAA\n");
    if (!fs_ok(fs.write_bytes(path::Path, ?document[0], length,
        384))) { ret 7; }
    if (load_bundle(?anchors, ?a, path) != UNDECODABLE) { ret 8; }
    if (anchors.live || anchors.certificates != nil || anchors.der != nil
        || anchors.der_capacity != 0 || count(?anchors) != 0
        || store(?anchors) != nil) { ret 9; }
    fs.remove_all(?a, directory::Path);
    ret 0;
}

test "acme anchors: a missing or undecodable bundle is refused, not empty" {
    var memory: [65536]u8;
    var arena:  fixed.FixedState;
    var a:      allocator.Allocator;
    if (!test_allocator(?a, ?arena, ?memory[0], 65536)) { ret 1; }
    var anchors: Anchors;
    if (load_bundle(?anchors, ?a, "out/acme-anchors/absent.pem") != MISSING) {
        ret 2;
    }
    if (anchors.live || count(?anchors) != 0 || store(?anchors) != nil) { ret 3; }
    val directory: str = "out/acme-anchors-bad";
    fs.create_dir_all(?a, directory::Path, 448);
    val path:    str   = "out/acme-anchors-bad/bundle.pem";
    var garbage: [64]u8;
    var i:       usize = 0;
    for (i < 64) {
        garbage[i] = 'x';
        i          = i + 1;
    }
    if (!fs_ok(fs.write_bytes(path::Path, ?garbage[0], 64, 384))) {
        ret 4;
    }
    if (load_bundle(?anchors, ?a, path) != UNDECODABLE) { ret 5; }
    if (anchors.live || store(?anchors) != nil)         { ret 6; }
    if (load_bundle(?anchors, ?a, nil) != INVALID)      { ret 7; }
    fs.remove_all(?a, directory::Path);
    ret 0;
}
