# the serving runtime: listeners, a bounded connection pool, and one sealed plan
#
# this module owns the loop that turns accepted connections into served requests.
# it is the only place that knows both the listener plane and the connection
# plane, and it hands each connection the same immutable plan for its lifetime.

use process_admission: hedge.admission;
use hedge.allowance;
use hedge.budget;
use hedge.clock;
use hedge.config.lanes;
use hedge.config.schema;
use hedge.connection;
use hedge.dispatch.plan;
use hedge.lifecycle;
use hedge.listener;
use hedge_memory: hedge.memory;
use hedge.operation;
use h3_session: hedge.protocol.h3.session;
use hedge.protocol.prologue;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge_tls:    hedge.protocol.tls;
use hedge.spread;
use hedge_storage: hedge.storage;
use hedge.telemetry;
use telemetry_health: hedge.telemetry.health;
use hedge_timer:      hedge.timer;
use hedge_wake:       hedge.wake;
use http.core.message;
use A: std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.net.ip;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

fun receive_buffer_or_default(configured: *schema.Listener) usize {
    if (sel configured.receive_buffer_bytes.some) {
        ret configured.receive_buffer_bytes.some;
    }
    ret schema.DEFAULT_QUIC_RECEIVE_BUFFER;
}

fun retry_replay_limit(configured: *schema.Listener) usize {
    if (sel configured.max_retry_replay.some) { ret configured.max_retry_replay.some; }
    ret schema.DEFAULT_QUIC_RETRY_REPLAY;
}

# a Retry token outlives the longest wait admission can hand a client and the
# retransmit that follows a drop: a client accepts one Retry per attempt, so a
# token that expires while its Initial waits, or before the client's PTO brings
# it back (1, 2, 4, 8, 16 s), strands that attempt
val QUIC_RETRY_MAX_AGE_NS:   u64 = 30000000000;
val QUIC_ADDRESS_MAX_AGE_NS: u64 = 600000000000;

pub def State: u8;
pub val NEW:      State = 1;
pub val READY:    State = 2;
pub val DRAINING: State = 3;
pub val STOPPED:  State = 4;

pub val NO_SLOT: usize = (-1)::usize;

pub rec Slot {
    live:     bool;
    retiring: bool;
    # asked to finish and close, whether by a reload or the shutdown sequence
    signalled: bool;
    # queued to be driven or retired on this worker's next pass
    ready:      bool;
    ready_next: usize;
    # the wheel entry for the connection's earliest deadline, claimed when the
    # slot is taken and released when it is returned so a receding pool frees it
    timer:      hedge_timer.Handle;
    timer_live: bool;
    # accepted and holding a place in its budget's queue, not yet being served
    waiting:   bool;
    token:     listener.ConnectionToken;
    budgets:   *budget.Set;
    charge:    budget.Charge;
    prev_live: usize;
    next_live: usize;
    # the connection lives in its slot: both are claimed and released together,
    # and the slot is held until every completion into the record has landed
    connection: connection.Connection;
}

# the live slots of one service generation, in admission order. a slot is on
# the current list while its connection's generation is the runtime's and on
# the previous list after a reload moved every live slot there at once, so the
# superseded count and the generation drain never look at a slot they do not
# need to (#182)
rec LiveList {
    head:  usize;
    tail:  usize;
    count: usize;
}

fun empty_list() LiveList {
    ret LiveList{head: NO_SLOT, tail: NO_SLOT, count: 0};
}

rec BudgetGeneration {
    set:     budget.Set;
    storage: [schema.MAX_BUDGETS]budget.Budget;
}

fun timeout_nanoseconds(milliseconds: u64, output: *u64) bool {
    if (output == nil || milliseconds > schema.MAX_TIMEOUT_MS) { ret false; }
    @output = milliseconds * 1000000;
    ret true;
}

# a service plane the serving loop must drive alongside connections. the time it
# is handed is monotonic, the clock every deadline is scheduled on
pub def PlaneFun: fun(ptr, time.Instant) bool;

pub def PlaneQuiesceStatus: u8;
pub val PLANE_QUIESCED: PlaneQuiesceStatus = 1;
pub val PLANE_PENDING:  PlaneQuiesceStatus = 2;
pub val PLANE_FAILED:   PlaneQuiesceStatus = 3;
pub def PlaneQuiesceFun: fun(ptr, time.Instant) PlaneQuiesceStatus;
# the plane's earliest time-based need as a monotonic deadline in ns, or false
# when it has none. the serving loop arms it on the wheel so the poll wait
# ends when the plane is due rather than on a fixed interval (#182)
pub def PlaneDeadlineFun: fun(ptr, *u64) bool;

# in debug builds the audit runs once every AUDIT_POLLS turns. it is counted in
# turns and never armed on a timer, so it cannot end a wait itself and hide a
# wake that went missing (#182)
val AUDIT_POLLS: u64 = 64;

# in debug builds no wait outlasts this, and a turn in which nothing happened is
# audited at once. a wake that went missing leaves a wait nothing ends, so
# without the bound no turn would end for the audit to run in (#273)
val AUDIT_WAIT_MS: i32 = 1000;

# how many fired timer owners one wheel advance hands back at a time
val FIRE_BATCH: usize = 64;

pub rec Runtime {
    # the worker this runtime serves for
    worker: usize;
    # whether this runtime takes the process-wide duties (signals, SIGPIPE),
    # which a supervisor holds instead of any of its workers
    owns_process: bool;
    # the caps this worker shares with every other, or none held alone
    caps: Caps;
    # whether the listeners this worker binds share their addresses with other
    # workers', and the addresses the first worker resolved, or nil
    reuse_port: bool;
    endpoints:  *ip.Endpoint;
    storage:    connection.Storage;
    # the worker's buffer pool. every connection this worker serves, over any
    # transport, opens its account here, and its wakes land in `wakes`
    memory: hedge_memory.Memory;
    # connections admission turned away because the pool could not fund them
    refused_memory: u64;
    # every deadline this worker decides, whichever protocol owns it
    timers: hedge_timer.Wheel;
    # every owner something outside its own io has made runnable again
    wakes: hedge_wake.Queue;
    # the TCP slots with work, in the order they got it
    ready_head:     usize;
    ready_tail:     usize;
    state:          State;
    plane_ctx:      ptr;
    plane:          PlaneFun;
    plane_quiesce:  PlaneQuiesceFun;
    plane_deadline: PlaneDeadlineFun;
    generation:     u64;
    owner:          listener.Owner;
    # the slot directory grows and a record never moves, so a completion
    # context or a body reader may hold a pointer into one for its life
    slots:    hedge_storage.Table[Slot];
    live:     usize;
    current:  LiveList;
    previous: LiveList;
    # slots whose connection is in teardown: spoken for but about to be free
    retiring: usize;
    # the wheel entry that ends the previous generation's drain (#182)
    drain_timer: hedge_timer.Handle;
    # the wheel entry that ends a wait at the shutdown's drain deadline, so the
    # sequence cancels when it is due rather than on some later event (#273)
    shutdown_timer: hedge_timer.Handle;
    # the wheel entry the plane's own deadline is armed on, and whether the
    # plane asked to be driven before the next wait
    plane_timer:   hedge_timer.Handle;
    plane_due:     bool;
    next_id:       u64;
    plan:          *plan.Plan;
    graph:         *schema.Graph;
    configured:    connection.Config;
    limits:        message.Limits;
    observability: *telemetry.Runtime;
    recorder:      *telemetry.Recorder;
    served:        u64;
    accepted:      u64;
    # why the most recently retired connection ended, which outlives the record
    # now that the record goes back to the pool
    last_refusal:     prologue.Refusal;
    rejected:         u64;
    shutdown:         lifecycle.State;
    drain_timeout_ns: u64;
    # how long a stop waits with no connection closing before it gives up
    stop_timeout_ns: u64;
    # a fallible teardown call that failed. a return nobody reads is a check
    # that does not exist, which is how a total teardown failure stayed
    # invisible until the shutdown sequence started reporting its outcome.
    teardown_failures:  u64;
    budget_generations: [2]BudgetGeneration;
    active_budgets:     *budget.Set;
    queued:             u64;
    expired:            u64;
    # connection turns taken, which an idle connection must not add to
    drives: u64;
    # poll turns taken and audits run, which debug builds use to pace the audit
    polls:            u64;
    audits:           u64;
    quic:             *quic_runtime.Runtime;
    quic_storages:    *quic_runtime.PumpStorage;
    quic_handles:     [schema.MAX_LISTENERS]quic_runtime.PumpHandle;
    quic_handle_live: [schema.MAX_LISTENERS]bool;
    quic_count:       usize;
    quic_released:    bool;
}

pub fun refused_memory(runtime: *Runtime) u64 {
    if (runtime == nil) { ret 0; }
    ret runtime.refused_memory;
}

pub fun drives(runtime: *Runtime) u64 {
    if (runtime == nil) { ret 0; }
    ret runtime.drives;
}

fun live_count(runtime: *Runtime) usize {
    if (runtime == nil) { ret 0; }
    var count: usize = runtime.live;
    if (runtime.quic != nil && !runtime.quic_released) {
        val quic_live: usize = quic_runtime.live(runtime.quic);
        if (count > (-1)::usize - quic_live) { ret (-1)::usize; }
        count = count + quic_live;
    }
    ret count;
}

fun configure_budgets(target: *BudgetGeneration, graph: *schema.Graph) bool {
    if (target == nil || graph == nil || !budget.make(?target.set,
        ?target.storage[0], schema.MAX_BUDGETS)) { ret false; }
    var i: usize = 0;
    for (i < graph.budget_count) {
        val configured: *schema.Budget = ?graph.budgets[i];
        var timeout_ns: u64            = 0;
        if (!timeout_nanoseconds(configured.timeout_ms, ?timeout_ns)) { ret false; }
        if (budget.define(?target.set, schema.text(?configured.name),
            configured.concurrency, configured.queue,
            timeout_ns,
            configured.memory_bytes) == budget.NO_BUDGET) { ret false; }
        i = i + 1;
    }
    ret true;
}

# charge a generation's budgets against the pools every worker shares for it.
# a runtime holding its caps alone keeps each budget's own
fun share_budgets(runtime: *Runtime, target: *BudgetGeneration, generation: u64) bool {
    if (runtime.caps.budgets == nil) { ret true; }
    var pools: *allowance.BudgetPools = nil;
    var slot:  usize                  = 0;
    for (slot < 2) {
        if (runtime.caps.budgets[slot].generation == generation) {
            pools = ?runtime.caps.budgets[slot];
        }
        slot = slot + 1;
    }
    if (pools == nil || pools.count != target.set.count) { ret false; }
    var i: usize = 0;
    for (i < target.set.count) {
        if (!budget.share(?target.set, i, ?pools.items[i], runtime.worker)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `worker` is the index of the worker this runtime serves for, which every
# connection it makes carries down to its per-worker state
pub fun make(
    runtime: *Runtime,
    worker: usize,
    active_plan: *plan.Plan,
    graph: *schema.Graph,
    a: *A.Allocator,
) bool {
    if (runtime == nil || a == nil
        || active_plan == nil || !plan.sealed(active_plan) || graph == nil
        || !connection.make_storage(?runtime.storage, a, worker)
        || !hedge_timer.make(?runtime.timers, a, clock.monotonic_ns())
        || !hedge_wake.make(?runtime.wakes, a)
        || !hedge_memory.make(?runtime.memory, lanes.memory_bytes(?graph.limits), a)
        || !hedge_storage.make_table[Slot](?runtime.slots, a)) {
        ret false;
    }
    runtime.worker         = worker;
    runtime.owns_process   = true;
    runtime.caps           = no_caps();
    runtime.reuse_port     = false;
    runtime.endpoints      = nil;
    runtime.state          = NEW;
    runtime.generation     = 0;
    runtime.live           = 0;
    runtime.next_id        = 1;
    runtime.plan           = active_plan;
    runtime.graph          = graph;
    runtime.configured     = connection.config_from(graph);
    runtime.limits         = connection.message_limits(graph, runtime.configured);
    runtime.observability  = nil;
    runtime.recorder       = nil;
    runtime.plane_ctx      = nil;
    runtime.plane          = (0::usize)::PlaneFun;
    runtime.plane_quiesce  = (0::usize)::PlaneQuiesceFun;
    runtime.served         = 0;
    runtime.accepted       = 0;
    runtime.last_refusal   = prologue.REFUSED_NONE;
    runtime.rejected       = 0;
    runtime.refused_memory = 0;
    runtime.shutdown       = lifecycle.make();
    if (!timeout_nanoseconds(graph.timeouts.drain_ms,
        ?runtime.drain_timeout_ns)
        || !timeout_nanoseconds(graph.timeouts.stop_ms,
        ?runtime.stop_timeout_ns)) { ret false; }
    runtime.queued            = 0;
    runtime.expired           = 0;
    runtime.polls             = 0;
    runtime.audits            = 0;
    runtime.teardown_failures = 0;
    runtime.quic              = nil;
    runtime.quic_storages     = nil;
    runtime.quic_count        = 0;
    runtime.quic_released     = false;
    if (!configure_budgets(?runtime.budget_generations[0], graph)
        || !budget.make(?runtime.budget_generations[1].set,
        ?runtime.budget_generations[1].storage[0], schema.MAX_BUDGETS)) { ret false; }
    runtime.active_budgets = ?runtime.budget_generations[0].set;
    runtime.current        = empty_list();
    runtime.previous       = empty_list();
    runtime.retiring       = 0;
    # each entry is claimed at the first deadline it holds, so an idle worker
    # holds no wheel storage until a plane has one, a reload or a shutdown lands
    runtime.drain_timer    = hedge_timer.no_handle();
    runtime.shutdown_timer = hedge_timer.no_handle();
    runtime.plane_timer    = hedge_timer.no_handle();
    runtime.plane_due      = true;
    runtime.ready_head     = NO_SLOT;
    runtime.ready_tail     = NO_SLOT;
    var i: usize = 0;
    for (i < schema.MAX_LISTENERS) {
        runtime.quic_handle_live[i] = false;
        i                           = i + 1;
    }
    ret true;
}

# the caps every worker of a process shares. each is nil when this runtime
# holds the configured cap alone, which one worker and the tests do
pub rec Caps {
    # max_connections and max_connections_per_peer, across TCP and QUIC
    connections: *process_admission.Shared;
    # each address's share of QUIC handshakes admitted, and those in flight
    handshakes:      *process_admission.Shared;
    handshake_slots: *allowance.Pool;
    # each named budget's concurrency and memory, by generation
    budgets: *allowance.BudgetPools;
    # where a worker waiting for a cap is woken
    wakers: *allowance.Wakers;
}

pub fun no_caps() Caps {
    ret Caps{connections: nil, handshakes: nil, handshake_slots: nil, budgets: nil,
        wakers: nil};
}

# share the process's caps with this runtime, before it starts
pub fun share_caps(runtime: *Runtime, caps: Caps) bool {
    if (runtime == nil || runtime.state != NEW) { ret false; }
    runtime.caps = caps;
    ret true;
}

# bind this worker's listeners beside other workers': with SO_REUSEPORT, and at
# `endpoints`, the addresses the first worker's listeners resolved, when given
pub fun place(runtime: *Runtime, reuse_port: bool, endpoints: *ip.Endpoint) bool {
    if (runtime == nil || runtime.state != NEW) { ret false; }
    runtime.reuse_port = reuse_port;
    runtime.endpoints  = endpoints;
    ret true;
}

# a supervisor takes the process-wide duties, so this runtime leaves them alone
pub fun leave_process(runtime: *Runtime) bool {
    if (runtime == nil || runtime.state != NEW) { ret false; }
    runtime.owns_process = false;
    ret true;
}

pub fun attach_quic(runtime: *Runtime, quic: *quic_runtime.Runtime,
    storages: *quic_runtime.PumpStorage) bool {
    if (runtime == nil || quic == nil || storages == nil
        || runtime.state != NEW || runtime.quic != nil) { ret false; }
    runtime.quic          = quic;
    runtime.quic_storages = storages;
    runtime.quic_released = false;
    ret true;
}

# a plane without a deadline function runs on every turn and never wakes one
pub fun attach_plane(runtime: *Runtime, context: ptr, plane: PlaneFun) bool {
    if (runtime == nil || plane::usize == 0) { ret false; }
    runtime.plane_ctx      = context;
    runtime.plane          = plane;
    runtime.plane_quiesce  = (0::usize)::PlaneQuiesceFun;
    runtime.plane_deadline = (0::usize)::PlaneDeadlineFun;
    runtime.plane_due      = true;
    ret true;
}

pub fun attach_plane_lifecycle(runtime: *Runtime, context: ptr, plane: PlaneFun,
    quiesce: PlaneQuiesceFun, deadline: PlaneDeadlineFun) bool {
    if (runtime == nil || plane::usize == 0 || quiesce::usize == 0
        || deadline::usize == 0) { ret false; }
    runtime.plane_ctx      = context;
    runtime.plane          = plane;
    runtime.plane_quiesce  = quiesce;
    runtime.plane_deadline = deadline;
    runtime.plane_due      = true;
    ret true;
}

# something outside the serving loop changed what the plane has to do, so it
# runs before the next wait rather than at its armed deadline
pub fun wake_plane(runtime: *Runtime) {
    if (runtime == nil) { ret; }
    runtime.plane_due = true;
}

# the recorder this worker's metrics go to, and through it the process's
# telemetry, whose readiness, drain and flush this runtime drives only when it
# takes the process duties
pub fun attach_telemetry(runtime: *Runtime, recorder: *telemetry.Recorder) bool {
    if (runtime == nil || recorder == nil || recorder.runtime == nil
        || runtime.state != NEW) { ret false; }
    runtime.observability = recorder.runtime;
    runtime.recorder      = recorder;
    ret true;
}

fun pattern(name: str) bool {
    var i: usize = 0;
    for (name[i] != 0) {
        if (name[i] == '*') { ret true; }
        i = i + 1;
    }
    ret false;
}

fun hosts_servable(runtime: *Runtime, graph: *schema.Graph,
    owned: *listener.OwnedListener, policy: usize,
    diagnostics: *schema.Diagnostics) bool {
    var i: usize = 0;
    for (i < graph.host_count) {
        val host: *schema.Host = ?graph.hosts[i];
        if (!schema.text_equals(?host.listener, schema.text(?owned.name))) {
            i = i + 1;
            cnt;
        }
        var j: usize = 0;
        for (j < host.server_name_count) {
            val name: str = schema.text(?host.server_names[j]);
            # a wildcard host is a pattern, not a name a client can send, so
            # whether a certificate covers it cannot be decided by asking for it
            if (host.server_names[j].len != 0 && !pattern(name)
                && !hedge_tls.servable(policy, name)) {
                schema.add_diagnostic(diagnostics, schema.ERROR,
                    schema.UNRESOLVED_REFERENCE, "runtime", name,
                    "no configured certificate serves this virtual host");
                ret false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun quic_config(runtime: *Runtime, graph: *schema.Graph, index: usize,
    generation: u64, active_plan: *plan.Plan, budgets: *budget.Set,
    output: *quic_runtime.PumpConfig) bool {
    if (runtime == nil || graph == nil || index >= graph.listener_count
        || generation == 0 || active_plan == nil || budgets == nil
        || output == nil) { ret false; }
    val configured: *schema.Listener = ?graph.listeners[index];
    if (configured.transport != schema.TRANSPORT_QUIC
        || configured.protocols != schema.PROTOCOL_HTTP3
        || configured.tls_policy.len == 0) { ret false; }
    val policy_index: usize             = hedge_tls.find(schema.text(?configured.name));
    val policy:       *hedge_tls.Policy = hedge_tls.policy_at(policy_index);
    if (policy == nil) { ret false; }
    var named_budget: usize = budget.NO_BUDGET;
    if (configured.budget.len != 0) {
        named_budget = budget.find(budgets,
            schema.text(?configured.budget));
    }
    val connection_config: connection.Config = connection.config_from(graph);
    # HTTP/3 borrows more per request than HTTP/2, so its advertised concurrency
    # is capped against its own funded count, not the HTTP/2 figure above
    var max_requests: usize = graph.limits.max_pipeline_depth;
    if (max_requests > h3_session.MAX_STREAMS) {
        max_requests = h3_session.MAX_STREAMS;
    }
    val h3_split:  hedge_memory.Budgets = lanes.budgets(?graph.limits);
    val h3_funded: usize                = hedge_memory.request_capacity(h3_split, h3_session.set_bytes());
    if (max_requests > h3_funded) { max_requests = h3_funded; }
    @output = quic_runtime.PumpConfig{
        admission_generation:     generation,
        connection_limit:         graph.limits.max_connections,
        max_connections_per_peer: graph.limits.max_connections_per_peer,
        max_handshakes:           graph.limits.max_handshakes,
        max_handshakes_per_peer:  graph.limits.max_handshakes_per_peer,
        receive_buffer_bytes:     receive_buffer_or_default(configured),
        require_retry:            true,
        retry_max_age_ns:         QUIC_RETRY_MAX_AGE_NS,
        address_max_age_ns:       QUIC_ADDRESS_MAX_AGE_NS,
        max_replay:               retry_replay_limit(configured),
        tls_policy:               policy,
        tls_policy_index:         policy_index,
        plan:                     active_plan,
        budgets:                  budgets,
        listener_budget:          named_budget,
        limits:                   connection.message_limits(graph, connection_config),
        max_requests:             max_requests,
        call_memory_bytes:        connection_config.call_memory_bytes,
        memory_budgets:           connection_config.memory_budgets,
        memory_wait_ns:           connection_config.memory_wait_ns,
        listener_name:            schema.text(?configured.name),
        handshake_timeout_ns:     graph.timeouts.handshake_ms * 1000000,
        request_timeout_ns:       graph.timeouts.request_ms * 1000000,
        idle_timeout_ms:          graph.timeouts.keep_alive_ms,
        drain_timeout_ns:         quic_runtime.CONNECTION_DRAIN_NS,
    };
    ret true;
}

fun release_quic(controls: *quic_runtime.ControlView, runtime: *Runtime) bool {
    if (runtime.quic == nil || runtime.quic_released) { ret true; }
    var success:  bool                = quic_runtime.cancel_all(controls, runtime.quic) == quic_runtime.OK;
    var released: quic_runtime.Status = quic_runtime.release(controls, runtime.quic);
    # a release that stays blocked for the stop deadline fails, rather than
    # holding the stop in this loop forever (#273)
    val deadline: u64 = clock.after_ns(clock.monotonic_ns(), runtime.stop_timeout_ns);
    for (released == quic_runtime.BLOCKED) {
        if (wait_before(deadline) == 0)        { ret false; }
        if (!listener.poll(?runtime.owner, 1)) { ret false; }
        fire_timers(controls, runtime, clock.monotonic_ns());
        if (quic_runtime.advance(controls, runtime.quic, clock.monotonic_ns())
            == quic_runtime.FAILED) { ret false; }
        released = quic_runtime.release(controls, runtime.quic);
    }
    if (released != quic_runtime.OK) { ret false; }
    runtime.quic_released = true;
    runtime.quic_count    = 0;
    var i: usize = 0;
    for (i < schema.MAX_LISTENERS) {
        runtime.quic_handle_live[i] = false;
        i                           = i + 1;
    }
    ret success;
}

fun fail_start(controls: *quic_runtime.ControlView, runtime: *Runtime) bool {
    val released: bool = release_quic(controls, runtime);
    if (!runtime.quic_released) {
        runtime.state = DRAINING;
        listener.begin_drain(?runtime.owner);
        ret false;
    }
    runtime.state = DRAINING;
    val stopped: bool = listener.stop(?runtime.owner);
    if (stopped) { runtime.state = STOPPED; }
    ret released && stopped;
}

# a QUIC listener this worker binds and serves
fun quic_served(runtime: *Runtime, configured: *schema.Listener) bool {
    ret configured.transport == schema.TRANSPORT_QUIC
        && spread.binds(configured, runtime.worker);
}

fun start_quic(controls: *quic_runtime.ControlView, runtime: *Runtime, generation: u64,
    graph: *schema.Graph) bool {
    var required: usize = 0;
    var i:        usize = 0;
    for (i < graph.listener_count) {
        if (quic_served(runtime, ?graph.listeners[i])) { required = required + 1; }
        i = i + 1;
    }
    if (required == 0)                                       { ret true; }
    if (runtime.quic == nil || runtime.quic_storages == nil) { ret false; }
    i = 0;
    for (i < graph.listener_count) {
        val configured: *schema.Listener = ?graph.listeners[i];
        if (!quic_served(runtime, configured)) {
            i = i + 1;
            cnt;
        }
        val owned: *listener.OwnedListener = listener.active_listener(
            ?runtime.owner, i);
        var config: quic_runtime.PumpConfig;
        if (owned == nil || !owned.has_udp_socket || !owned.has_bound_endpoint
            || !quic_config(runtime, graph, i, generation, runtime.plan,
            runtime.active_budgets, ?config)) {
            fail_start(controls, runtime);
            ret false;
        }
        val attached: quic_runtime.Status = quic_runtime.attach(controls, runtime.quic,
            ?runtime.owner.network, ?owned.udp_socket, ?runtime.owner.root_scope,
            owned.bound_endpoint, config, ?runtime.quic_storages[i],
            ?runtime.quic_handles[i]);
        if (attached != quic_runtime.OK) {
            fail_start(controls, runtime);
            ret false;
        }
        runtime.quic_handle_live[i] = true;
        runtime.quic_count          = runtime.quic_count + 1;
        if (quic_runtime.start(controls, runtime.quic, runtime.quic_handles[i])
            != quic_runtime.OK) {
            fail_start(controls, runtime);
            ret false;
        }
        i = i + 1;
    }
    ret runtime.quic_count == required;
}

pub fun start(controls: *quic_runtime.ControlView, runtime: *Runtime, generation: u64, graph: *schema.Graph,
    diagnostics: *schema.Diagnostics) bool {
    if (runtime == nil || runtime.state != NEW)                              { ret false; }
    if (!share_budgets(runtime, ?runtime.budget_generations[0], generation)) { ret false; }
    if (!listener.start_with(?runtime.owner, generation, graph, diagnostics,
        listener.StartOptions{owns_process: runtime.owns_process,
        admission: runtime.caps.connections, worker: runtime.worker,
        wakers:    runtime.caps.wakers, reuse_port: runtime.reuse_port,
        endpoints: runtime.endpoints})) { ret false; }
    if (runtime.quic != nil && !quic_runtime.bind_admission(runtime.quic,
        listener.admission_manager(?runtime.owner))) {
        fail_start(controls, runtime);
        ret false;
    }
    if (runtime.quic != nil && !quic_runtime.bind_read_on(runtime.quic,
        read_on, (runtime)::ptr)) {
        fail_start(controls, runtime);
        ret false;
    }
    if (!listener.attach_connections(?runtime.owner, nil, operation.complete)) {
        fail_start(controls, runtime);
        ret false;
    }
    # a TLS listener whose policy did not load, or whose virtual hosts have no
    # certificate, must not become ready and then refuse the clients it accepts
    var i: usize = 0;
    for (i < schema.MAX_LISTENERS) {
        val owned: *listener.OwnedListener = listener.active_listener(?runtime.owner, i);
        if (owned == nil || !owned.policy.secure) {
            i = i + 1;
            cnt;
        }
        val policy: usize = hedge_tls.find(schema.text(?owned.name));
        if (policy == hedge_tls.NO_POLICY) {
            schema.add_diagnostic(diagnostics, schema.ERROR, schema.UNRESOLVED_REFERENCE,
                "runtime", schema.text(?owned.name), "listener TLS policy was not published");
            fail_start(controls, runtime);
            ret false;
        }
        if (!hosts_servable(runtime, graph, owned, policy, diagnostics)) {
            fail_start(controls, runtime);
            ret false;
        }
        i = i + 1;
    }
    if (!start_quic(controls, runtime, generation, graph)) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.SOURCE_ERROR,
            "runtime", "quic", "QUIC listener pumps did not become ready");
        if (runtime.state != STOPPED) { fail_start(controls, runtime); }
        ret false;
    }
    runtime.generation = generation;
    runtime.state      = READY;
    if (runtime.owns_process && runtime.observability != nil
        && !telemetry.begin_ready(runtime.observability)) {
        fail_start(controls, runtime);
        ret false;
    }
    ret true;
}

# what this worker holds of the shared budget caps goes back for the others
fun release_budgets(runtime: *Runtime) bool {
    budget.leave(?runtime.budget_generations[0].set);
    budget.leave(?runtime.budget_generations[1].set);
    ret true;
}

# every slot must have been retired first, which is what `stop` waits for
fun release_pool(runtime: *Runtime) bool {
    val ok: bool = hedge_storage.destroy_table[Slot](?runtime.slots);
    runtime.current  = empty_list();
    runtime.previous = empty_list();
    ret ok;
}

# the connection record a live slot holds, or nil when the slot is free
pub fun slot_connection(runtime: *Runtime, index: usize) *connection.Connection {
    if (runtime == nil) { ret nil; }
    val slot: *Slot = slot_at(runtime, index);
    if (slot == nil || !slot.live) { ret nil; }
    ret ?slot.connection;
}

pub fun last_refusal(runtime: *Runtime) prologue.Refusal {
    if (runtime == nil) { ret prologue.REFUSED_NONE; }
    ret runtime.last_refusal;
}

# a claimed slot, so a caller can observe its lifecycle without owning the pool
pub fun slot_at(runtime: *Runtime, index: usize) *Slot {
    ret hedge_storage.table_at[Slot](?runtime.slots, index);
}

# the size the slot directory has grown to, which recedes as connections leave
pub fun slot_capacity(runtime: *Runtime) usize {
    if (runtime == nil) { ret 0; }
    ret hedge_storage.table_capacity[Slot](?runtime.slots);
}

# whether a slot holds a live connection. an index whose chunk a compaction has
# released reads as not live rather than faulting, so a caller can query a slot
# whose pool has since receded
pub fun slot_live(runtime: *Runtime, index: usize) bool {
    val slot: *Slot = slot_at(runtime, index);
    ret slot != nil && slot.live;
}

# the list a live slot belongs to is decided by its connection's generation
fun list_of(runtime: *Runtime, slot: *Slot) *LiveList {
    if (slot.connection.generation != runtime.generation) {
        ret ?runtime.previous;
    }
    ret ?runtime.current;
}

fun link_live(runtime: *Runtime, list: *LiveList, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    slot.prev_live = NO_SLOT;
    slot.next_live = list.head;
    if (list.head != NO_SLOT) { slot_at(runtime, list.head).prev_live = index; }
    or                        { list.tail = index; }
    list.head  = index;
    list.count = list.count + 1;
}

fun unlink_live(runtime: *Runtime, list: *LiveList, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    if (slot.prev_live != NO_SLOT) {
        slot_at(runtime, slot.prev_live).next_live = slot.next_live;
    }
    or (list.head == index) {
        list.head = slot.next_live;
    }
    if (slot.next_live != NO_SLOT) {
        slot_at(runtime, slot.next_live).prev_live = slot.prev_live;
    }
    or (list.tail == index) {
        list.tail = slot.prev_live;
    }
    slot.prev_live = NO_SLOT;
    slot.next_live = NO_SLOT;
    if (list.count != 0) { list.count = list.count - 1; }
}

# every current slot becomes a previous one in constant time: the current list
# is spliced in front of the previous one and the generation bump does the rest
fun supersede_live(runtime: *Runtime) {
    if (runtime.current.head == NO_SLOT) { ret; }
    if (runtime.previous.head != NO_SLOT) {
        slot_at(runtime, runtime.current.tail).next_live  = runtime.previous.head;
        slot_at(runtime, runtime.previous.head).prev_live = runtime.current.tail;
    }
    or { runtime.previous.tail = runtime.current.tail; }
    runtime.previous.head  = runtime.current.head;
    runtime.previous.count = runtime.previous.count + runtime.current.count;
    runtime.current        = empty_list();
}

# a released slot is reused before the directory grows. storage the allocator
# refuses is the only reason a claim fails, and that is a refusal like a full
# pool was, not a crash
fun free_slot(runtime: *Runtime) usize {
    val index: usize = hedge_storage.table_claim[Slot](?runtime.slots);
    if (index == NO_SLOT) { ret NO_SLOT; }
    # the slab may hand back a reused slot with stale contents or a freshly grown
    # zeroed one, so every field a claim relies on is set here rather than trusted
    val slot: *Slot = slot_at(runtime, index);
    slot.prev_live  = NO_SLOT;
    slot.next_live  = NO_SLOT;
    slot.charge     = budget.no_charge();
    slot.ready      = false;
    slot.ready_next = NO_SLOT;
    slot.timer      = hedge_timer.claim(?runtime.timers, tcp_owner(index));
    slot.timer_live = slot.timer.index != hedge_timer.NONE;
    ret index;
}

fun return_slot(runtime: *Runtime, index: usize) {
    if (index >= hedge_storage.table_capacity[Slot](?runtime.slots)) { ret; }
    val slot: *Slot = slot_at(runtime, index);
    # release the wheel entry before the slab can drop this slot's chunk, so a
    # compaction never strands a timer bound to a slot that no longer exists
    if (slot.timer_live) {
        hedge_timer.release(?runtime.timers, slot.timer);
        slot.timer_live = false;
    }
    hedge_storage.table_release[Slot](?runtime.slots, index);
}

# admit every queued connection the pool can hold and refuse the rest at once
fun admit(runtime: *Runtime, now: time.Instant) usize {
    var admitted: usize = 0;
    for (true) {
        val index: usize = free_slot(runtime);
        if (index == NO_SLOT) {
            # a pool full of live connections is a refusal, but one holding a
            # slot open for a teardown is not: that arrival waits a turn instead
            # of being destroyed for a slot that is already spent
            if (runtime.retiring != 0) { brk; }
            var refused: listener.ConnectionToken;
            if (!listener.take_connection(?runtime.owner, ?refused)) { brk; }
            runtime.rejected = runtime.rejected + 1;
            if (!listener.close_connection(?runtime.owner, refused)) {
                runtime.teardown_failures = runtime.teardown_failures + 1;
            }
            cnt;
        }
        var token: listener.ConnectionToken;
        if (!listener.take_connection(?runtime.owner, ?token)) {
            return_slot(runtime, index);
            brk;
        }
        val source: *listener.Connection = listener.inspect_connection(?runtime.owner, token);
        if (source == nil) {
            runtime.rejected = runtime.rejected + 1;
            if (!listener.close_connection(?runtime.owner, token)) {
                runtime.teardown_failures = runtime.teardown_failures + 1;
            }
            return_slot(runtime, index);
            cnt;
        }
        val slot:  *Slot                   = slot_at(runtime, index);
        val owned: *listener.OwnedListener = listener.active_listener(?runtime.owner,
            source.listener_index);
        var policy: usize = hedge_tls.NO_POLICY;
        if (owned != nil && owned.policy.secure) {
            policy = hedge_tls.find(schema.text(?owned.name));
        }
        if (owned == nil || !connection.make(?slot.connection, runtime.next_id, runtime.generation,
            token, source, ?runtime.owner.network, runtime.plan, runtime.active_budgets,
            runtime.configured, runtime.limits, owned, policy,
            ?runtime.storage, ?runtime.memory,
            hedge_wake.waker(?runtime.wakes, tcp_owner(index)), now)) {
            runtime.rejected = runtime.rejected + 1;
            if (connection.refused_memory(?slot.connection)) {
                runtime.refused_memory = runtime.refused_memory + 1;
            }
            if (!listener.close_connection(?runtime.owner, token)) {
                runtime.teardown_failures = runtime.teardown_failures + 1;
            }
            return_slot(runtime, index);
            cnt;
        }
        slot.live      = true;
        slot.retiring  = false;
        slot.signalled = false;
        slot.waiting   = false;
        slot.budgets   = runtime.active_budgets;
        slot.token     = token;
        link_live(runtime, ?runtime.current, index);
        runtime.next_id  = runtime.next_id + 1;
        runtime.live     = runtime.live + 1;
        runtime.accepted = runtime.accepted + 1;
        admitted         = admitted + 1;
        # the budget is charged after the connection exists but before it is
        # driven, which is the last point at which refusing it costs nothing
        val allowance: usize          = listener_budget(runtime, source.listener_index);
        val outcome:   budget.Outcome = budget.charge(slot.budgets, allowance,
            $size_of(connection.Connection), now, ?slot.charge,
            hedge_wake.waker(?runtime.wakes, tcp_owner(index)));
        if (outcome == budget.QUEUED) {
            slot.waiting   = true;
            runtime.queued = runtime.queued + 1;
            arm_waiting(runtime, index);
        }
        or (outcome != budget.ADMITTED) {
            runtime.rejected = runtime.rejected + 1;
            retire(runtime, index);
        }
        or { mark_ready(runtime, index); }
    }
    ret admitted;
}

fun listener_budget(runtime: *Runtime, index: usize) usize {
    if (runtime.graph == nil || index >= runtime.graph.listener_count) {
        ret budget.NO_BUDGET;
    }
    val configured: *schema.Listener = ?runtime.graph.listeners[index];
    if (configured.budget.len == 0) { ret budget.NO_BUDGET; }
    ret budget.find(runtime.active_budgets, schema.text(?configured.budget));
}

# a connection holding a place in its budget's queue learns where it stands.
# a release admits it and wakes it, and its wheel entry ends the wait when the
# budget's timeout passes
fun admit_waiting(runtime: *Runtime, index: usize, now: time.Instant) bool {
    val slot:    *Slot          = slot_at(runtime, index);
    val outcome: budget.Outcome = budget.retry(slot.budgets, ?slot.charge, now);
    if (outcome == budget.ADMITTED) {
        slot.waiting = false;
        ret true;
    }
    if (outcome == budget.QUEUED) {
        arm_waiting(runtime, index);
        ret false;
    }
    runtime.expired = runtime.expired + 1;
    retire(runtime, index);
    ret false;
}

fun arm_waiting(runtime: *Runtime, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    if (!slot.timer_live) {
        runtime.teardown_failures = runtime.teardown_failures + 1;
        ret;
    }
    var deadline: time.Instant;
    var armed:    hedge_timer.Status = hedge_timer.OK;
    if (budget.deadline(?slot.charge, ?deadline)) {
        armed = hedge_timer.arm(?runtime.timers, slot.timer, clock.to_ns(deadline));
    }
    or { armed = hedge_timer.disarm(?runtime.timers, slot.timer); }
    if (armed != hedge_timer.OK) {
        runtime.teardown_failures = runtime.teardown_failures + 1;
    }
}

fun retire(runtime: *Runtime, index: usize) {
    if (index >= hedge_storage.table_capacity[Slot](?runtime.slots)) { ret; }
    val slot: *Slot = slot_at(runtime, index);
    if (!slot.live) { ret; }
    if (!slot.retiring) {
        slot.retiring    = true;
        slot.waiting     = false;
        runtime.retiring = runtime.retiring + 1;
    }
    # an H2 body or transport cancellation may need a later completion. the
    # listener token and pool slot stay owned until that close phase settles.
    if (!connection.close(?slot.connection)) {
        if (connection.close_waiting(?slot.connection)) { ret; }
        runtime.teardown_failures = runtime.teardown_failures + 1;
    }
    if (slot.charge.live) { budget.release(slot.budgets, ?slot.charge); }
    slot.budgets         = nil;
    runtime.last_refusal = slot.connection.refusal;
    runtime.served       = runtime.served + slot.connection.requests;
    var returned: bool = false;
    if (connection.stream_released(?slot.connection)) {
        returned = listener.release_connection(?runtime.owner, slot.token);
    }
    or {
        returned = listener.close_connection(?runtime.owner, slot.token);
    }
    if (!returned) {
        runtime.teardown_failures = runtime.teardown_failures + 1;
    }
    slot.live     = false;
    slot.retiring = false;
    if (runtime.retiring != 0) { runtime.retiring = runtime.retiring - 1; }
    if (slot.timer_live)       { hedge_timer.disarm(?runtime.timers, slot.timer); }
    val list: *LiveList = list_of(runtime, slot);
    unlink_live(runtime, list, index);
    # the last superseded connection gone means nothing is left for the
    # generation's drain deadline to cut
    if (list == ?runtime.previous && list.count == 0
        && runtime.drain_timer.index != hedge_timer.NONE) {
        hedge_timer.disarm(?runtime.timers, runtime.drain_timer);
    }
    return_slot(runtime, index);
    if (runtime.live > 0) { runtime.live = runtime.live - 1; }
}

val TCP_TAG:  u64 = 0x5443000000000000;
val TAG_MASK: u64 = 0xffff000000000000;
# the wheel entry the runtime itself owns for the previous generation's drain;
# the plane's entry is owned by hedge_wake.PLANE_OWNER, the owner its wakes use
val DRAIN_OWNER: u64 = 0x5244000000000000;
# the wheel entry for the shutdown's drain deadline. firing it only ends the
# wait: the turn's advance_shutdown steps the sequence past the deadline
val SHUTDOWN_OWNER: u64 = 0x5344000000000000;
# how many woken owners one routing pass takes at a time
val WAKE_BATCH: usize = 64;

fun tcp_owner(index: usize) u64 {
    ret TCP_TAG | index::u64;
}

fun owns_tcp(owner: u64) bool {
    ret (owner & TAG_MASK) == TCP_TAG;
}

fun mark_ready(runtime: *Runtime, index: usize) {
    if (index >= hedge_storage.table_capacity[Slot](?runtime.slots)) { ret; }
    val slot: *Slot = slot_at(runtime, index);
    if (!slot.live || slot.ready) { ret; }
    slot.ready      = true;
    slot.ready_next = NO_SLOT;
    if (runtime.ready_tail != NO_SLOT) {
        slot_at(runtime, runtime.ready_tail).ready_next = index;
    }
    or { runtime.ready_head = index; }
    runtime.ready_tail = index;
}

fun take_ready(runtime: *Runtime) usize {
    val index: usize = runtime.ready_head;
    if (index == NO_SLOT) { ret NO_SLOT; }
    val slot: *Slot = slot_at(runtime, index);
    runtime.ready_head = slot.ready_next;
    if (runtime.ready_head == NO_SLOT) { runtime.ready_tail = NO_SLOT; }
    slot.ready      = false;
    slot.ready_next = NO_SLOT;
    ret index;
}

# a waker for the plane, held by whatever completes on the worker's driver
# outside a connection
pub fun plane_waker(runtime: *Runtime) hedge_wake.Waker {
    ret hedge_wake.waker(?runtime.wakes, hedge_wake.PLANE_OWNER);
}

fun has_ready(runtime: *Runtime) bool {
    ret runtime.ready_head != NO_SLOT || runtime.plane_due
        || hedge_wake.pending(?runtime.wakes)
        || hedge_memory.has_woken(?runtime.memory);
}

# a wake that names a call is also handed to the connection, which re-enters
# that call's parked service on its next step and no other (#131)
fun route_owner(controls: *quic_runtime.ControlView, runtime: *Runtime, owner: u64,
    woken_call: u32) {
    if (owns_tcp(owner)) {
        val index: usize = (owner & ~TAG_MASK)::usize;
        if (woken_call != hedge_wake.NO_CALL
            && index < hedge_storage.table_capacity[Slot](?runtime.slots)) {
            val slot: *Slot = slot_at(runtime, index);
            if (slot.live) { connection.stir(?slot.connection, woken_call); }
        }
        mark_ready(runtime, index);
    }
    or (owner == hedge_wake.PLANE_OWNER) { runtime.plane_due = true; }
    or (quic_runtime.owns(owner) && runtime.quic != nil && !runtime.quic_released) {
        quic_runtime.wake(controls, runtime.quic, owner, woken_call);
    }
}

# the buffer pool funded this owner's account again. what it parked for memory
# is retried as well as queued: a TLS lane through `stream.resume`, a QUIC
# record through `transport.storage_ready`. either is load-bearing, since a
# refused operation is retried by nothing else (#195)
fun route_funded(controls: *quic_runtime.ControlView, runtime: *Runtime, owner: u64) {
    if (owns_tcp(owner)) {
        val index: usize = (owner & ~TAG_MASK)::usize;
        if (index >= hedge_storage.table_capacity[Slot](?runtime.slots)) { ret; }
        val slot: *Slot = slot_at(runtime, index);
        if (!slot.live) { ret; }
        connection.funded(?slot.connection);
        mark_ready(runtime, index);
    }
    or (quic_runtime.owns(owner) && runtime.quic != nil && !runtime.quic_released) {
        quic_runtime.funded(controls, runtime.quic, owner);
    }
    or { route_owner(controls, runtime, owner, hedge_wake.NO_CALL); }
}

# hand every woken owner to the protocol that owns it, whether a waiter woke it
# or the buffer pool funded its account again
fun route_wakes(controls: *quic_runtime.ControlView, runtime: *Runtime) {
    var owners: [WAKE_BATCH]u64;
    for {
        val funded: usize = hedge_memory.woken(?runtime.memory, ?owners[0], WAKE_BATCH);
        var f:      usize = 0;
        for (f < funded) {
            route_funded(controls, runtime, owners[f]);
            f = f + 1;
        }
        if (funded < WAKE_BATCH) { brk; }
    }
    var wakes: [WAKE_BATCH]hedge_wake.Wake;
    for {
        val taken: usize = hedge_wake.take(?runtime.wakes, ?wakes[0], WAKE_BATCH);
        var i:     usize = 0;
        for (i < taken) {
            route_owner(controls, runtime, wakes[i].owner, wakes[i].call);
            i = i + 1;
        }
        if (taken < WAKE_BATCH) { brk; }
    }
}

# the slot's wheel entry follows its connection's earliest deadline
fun arm_slot(runtime: *Runtime, index: usize) {
    val slot: *Slot = slot_at(runtime, index);
    if (!slot.timer_live) {
        runtime.teardown_failures = runtime.teardown_failures + 1;
        ret;
    }
    var deadline: u64                = 0;
    var armed:    hedge_timer.Status = hedge_timer.OK;
    if (connection.next_deadline(?slot.connection, ?deadline)) {
        armed = hedge_timer.arm(?runtime.timers, slot.timer, deadline);
    }
    or { armed = hedge_timer.disarm(?runtime.timers, slot.timer); }
    if (armed != hedge_timer.OK) {
        runtime.teardown_failures = runtime.teardown_failures + 1;
    }
}

# drive one connection until it blocks on I/O or finishes, then wait on its
# earliest deadline. one that is still moving yields and runs again next turn
fun drive(runtime: *Runtime, index: usize, now: time.Instant) bool {
    val slot: *Slot = slot_at(runtime, index);
    runtime.drives = runtime.drives + 1;
    # a connection of a superseded generation learns it on its own next turn:
    # it finishes what it is doing and closes, and nobody walked to tell it
    if (!slot.signalled && slot.connection.generation != runtime.generation) {
        slot.signalled = true;
        if (!connection.begin_graceful(?slot.connection)) {
            runtime.teardown_failures = runtime.teardown_failures + 1;
        }
    }
    connection.expire(?slot.connection, clock.to_ns(now));
    val progress: connection.Step = connection.advance(?slot.connection, now);
    if (progress == connection.STEP_DONE || progress == connection.STEP_ERROR) {
        retire(runtime, index);
        ret true;
    }
    if (progress == connection.STEP_PROGRESS) { mark_ready(runtime, index); }
    arm_slot(runtime, index);
    ret false;
}

# drive or retire the connections that have work. what they queue while this
# runs waits for the next pass, which then does not wait on the network
fun run_ready(controls: *quic_runtime.ControlView, runtime: *Runtime, now: time.Instant) {
    route_wakes(controls, runtime);
    var tail: usize = runtime.ready_tail;
    for (tail != NO_SLOT) {
        val index: usize = take_ready(runtime);
        if (index == NO_SLOT) { brk; }
        val slot: *Slot = slot_at(runtime, index);
        # a connection still waiting for its budget is not driven, which is what
        # makes the queue a queue rather than a label
        if (slot.live && slot.retiring) { retire(runtime, index); }
        or (slot.live && (!slot.waiting || admit_waiting(runtime, index, now))) {
            drive(runtime, index, now);
        }
        if (index == tail) { brk; }
    }
}

# hand every entry now due to the protocol that armed it. returns how many fired
fun fire_timers(controls: *quic_runtime.ControlView, runtime: *Runtime, now_ns: u64) usize {
    var owners: [FIRE_BATCH]u64;
    var total:  usize = 0;
    for {
        val fired: usize = hedge_timer.advance(?runtime.timers, now_ns,
            ?owners[0], FIRE_BATCH);
        var i: usize = 0;
        for (i < fired) {
            if (owns_tcp(owners[i])) {
                mark_ready(runtime, (owners[i] & ~TAG_MASK)::usize);
            }
            or (quic_runtime.owns(owners[i]) && runtime.quic != nil
                && !runtime.quic_released) {
                quic_runtime.fire(controls, runtime.quic, owners[i], now_ns);
            }
            or (owners[i] == DRAIN_OWNER)            { cancel_previous(runtime); }
            or (owners[i] == hedge_wake.PLANE_OWNER) { runtime.plane_due = true; }
            i = i + 1;
        }
        total = total + fired;
        if (fired < FIRE_BATCH) { brk; }
    }
    ret total;
}

# the plane runs when its deadline fired, a link or a memory wake named it, or
# a caller asked, and afterwards its next deadline is armed on the wheel. a
# plane without a deadline function runs every turn, as before
fun drive_plane(runtime: *Runtime, now: time.Instant) {
    # only a plane with a deadline has a due state to wait on
    if (runtime.plane::usize == 0 || runtime.plane_deadline::usize == 0) {
        runtime.plane_due = false;
        if (runtime.plane::usize != 0) { runtime.plane(runtime.plane_ctx, now); }
        ret;
    }
    if (!runtime.plane_due) { ret; }
    runtime.plane_due = false;
    runtime.plane(runtime.plane_ctx, now);
    var deadline: u64                = 0;
    var armed:    hedge_timer.Status = hedge_timer.OK;
    if (runtime.plane_deadline(runtime.plane_ctx, ?deadline)) {
        # the entry is claimed at the first deadline there is to hold
        if (runtime.plane_timer.index == hedge_timer.NONE) {
            runtime.plane_timer = hedge_timer.claim(?runtime.timers, hedge_wake.PLANE_OWNER);
        }
        armed = hedge_timer.STALE;
        if (runtime.plane_timer.index != hedge_timer.NONE) {
            armed = hedge_timer.arm(?runtime.timers, runtime.plane_timer, deadline);
        }
    }
    or (runtime.plane_timer.index != hedge_timer.NONE) {
        armed = hedge_timer.disarm(?runtime.timers, runtime.plane_timer);
    }
    if (armed != hedge_timer.OK) {
        runtime.teardown_failures = runtime.teardown_failures + 1;
    }
}

# the quic runtime's socket read between units of crypto
fun read_on(ctx: ptr) bool {
    val runtime: *Runtime = ctx::*Runtime;
    if (runtime == nil) { ret false; }
    ret listener.read_on(?runtime.owner);
}

pub fun poll(controls: *quic_runtime.ControlView, runtime: *Runtime, timeout_ms: i32) bool {
    if (runtime == nil || runtime.state == NEW || runtime.state == STOPPED) { ret false; }
    var bounded_timeout: i32          = timeout_ms;
    val poll_started_at: time.Instant = clock.instant();
    var deadline:        u64          = 0;
    if (hedge_timer.next_deadline(?runtime.timers, ?deadline)) {
        val current: u64 = clock.to_ns(poll_started_at);
        var wait_ms: u64 = 0;
        if (deadline > current) {
            val remaining: u64 = deadline - current;
            wait_ms = remaining / 1000000;
            if (remaining % 1000000 != 0) { wait_ms = wait_ms + 1; }
        }
        if (wait_ms > 2147483647) { wait_ms = 2147483647; }
        if (bounded_timeout < 0 || wait_ms < bounded_timeout::u64) {
            bounded_timeout = wait_ms::i32;
        }
    }
    # work a previous turn left marked is done now rather than after a wait
    if (has_ready(runtime) || (runtime.quic != nil && !runtime.quic_released
        && quic_runtime.has_ready(runtime.quic))) {
        bounded_timeout = 0;
    }
    $if ($mach.build.mode == $mach.mode.debug) {
        bounded_timeout = audit_wait(bounded_timeout);
    }
    val dispatched: u64          = listener.dispatched(?runtime.owner);
    val polled:     bool         = listener.poll(?runtime.owner, bounded_timeout);
    val now:        time.Instant = clock.instant();
    var quic_ok:    bool         = true;
    val fired:      usize        = fire_timers(controls, runtime, clock.monotonic_ns());
    # nothing completed and nothing came due: whatever holds work now was left
    # there by a wake that never came
    val idle: bool = fired == 0 && listener.dispatched(?runtime.owner) == dispatched;
    if (runtime.quic != nil && !runtime.quic_released
        && quic_runtime.advance(controls, runtime.quic, clock.monotonic_ns())
        == quic_runtime.FAILED) {
        quic_ok = false;
    }
    # another worker's release may have made room in a budget this one's
    # waiters share, and the wake that ended this wait was for them
    if (runtime.caps.budgets != nil) {
        budget.resume(?runtime.budget_generations[0].set);
        budget.resume(?runtime.budget_generations[1].set);
    }
    # the completions just settled may have finished a connection, and a finished
    # connection holds its pool slot until it is retired. admitting before that
    # refuses an arrival for a slot that this turn already freed
    run_ready(controls, runtime, now);
    if (lifecycle.serving(?runtime.shutdown)) { admit(runtime, now); }
    drive_plane(runtime, now);
    run_ready(controls, runtime, now);
    # plane and tcp progress can release shared budget capacity for quic
    val settled: time.Instant = clock.instant();
    if (runtime.quic != nil && !runtime.quic_released
        && quic_runtime.advance(controls, runtime.quic, clock.monotonic_ns())
        == quic_runtime.FAILED) {
        quic_ok = false;
    }
    if (runtime.quic != nil && runtime.recorder != nil) {
        telemetry.quic_replay_full(runtime.recorder,
            quic_runtime.replay_full(runtime.quic));
        telemetry.quic_handshakes(runtime.recorder,
            quic_runtime.admission_report(runtime.quic));
    }
    if (runtime.recorder != nil) {
        telemetry.memory(runtime.recorder, hedge_memory.snapshot(?runtime.memory),
            runtime.refused_memory);
    }
    run_ready(controls, runtime, settled);
    if (lifecycle.serving(?runtime.shutdown)) {
        listener.resume_admission(?runtime.owner);
    }
    # a stop the operating system asked for enters the same sequence a
    # programmatic one does, so there is one ordering rather than two
    if (runtime.owner.state == listener.OWNER_DRAINING
        && lifecycle.serving(?runtime.shutdown)) {
        begin_shutdown(controls, runtime, now);
    }
    advance_shutdown(controls, runtime, now, false);
    if (!quic_ok) {
        release_quic(controls, runtime);
    }
    $if ($mach.build.mode == $mach.mode.debug) { audit_turn(controls, runtime, idle); }
    ret polled;
}

# a wait bounded to the audit interval, which debug builds take in place of
# `timeout_ms` so every wait ends in a turn the audit can run in
fun audit_wait(timeout_ms: i32) i32 {
    if (timeout_ms < 0 || timeout_ms > AUDIT_WAIT_MS) { ret AUDIT_WAIT_MS; }
    ret timeout_ms;
}

# the sweep that survives only as an assertion (#182). every live slot that is
# not queued and not waiting on its budget must hold no work its next step would
# do, a retiring one none its waiting close would do (#261), and the quic
# runtime answers the same for its records.
# the worker's wakes are routed first, so an owner that was woken counts as
# queued. returns how many hold work nothing will run at `now`
pub fun audit(controls: *quic_runtime.ControlView, runtime: *Runtime,
    now: time.Instant) usize {
    if (runtime == nil || runtime.state == NEW || runtime.state == STOPPED) { ret 0; }
    route_wakes(controls, runtime);
    runtime.audits = runtime.audits + 1;
    var found: usize = audit_list(runtime, ?runtime.current)
        + audit_list(runtime, ?runtime.previous);
    if (runtime.quic != nil && !runtime.quic_released) {
        found = found + quic_runtime.audit(controls, runtime.quic, now);
    }
    ret found;
}

fun audit_list(runtime: *Runtime, list: *LiveList) usize {
    var found: usize = 0;
    var i:     usize = list.head;
    for (i != NO_SLOT) {
        val slot: *Slot = slot_at(runtime, i);
        if (slot.live && !slot.ready && !slot.waiting) {
            if (slot.retiring && connection.close_work(?slot.connection)) { found = found + 1; }
            or (!slot.retiring && connection.pending_work(?slot.connection)) {
                found = found + 1;
            }
        }
        i = slot.next_live;
    }
    ret found;
}

pub fun audits(runtime: *Runtime) u64 {
    if (runtime == nil) { ret 0; }
    ret runtime.audits;
}

# an idle turn is audited at once rather than counted toward AUDIT_POLLS, so a
# missed wake fails within one audit interval instead of blocking (#273)
fun audit_turn(controls: *quic_runtime.ControlView, runtime: *Runtime, idle: bool) {
    runtime.polls = runtime.polls + 1;
    if (!idle && runtime.polls % AUDIT_POLLS != 0) { ret; }
    # sampled here, since the turn's own instant predates the quic advance
    # and a transport asked about a time before its last call answers false
    if (audit(controls, runtime, clock.instant()) != 0) {
        panic.panic("hedge: a connection holds work and nothing queues it (#182)\n");
    }
}

# --- the shutdown sequence ---
#
# ARCHITECTURE.md's seven steps, in order, executed once each. `lifecycle` owns
# the ordering and the clock; this owns what each step means to a serving
# runtime.

# step 1 readiness false, step 2 stop accepting, step 3 protocol-specific signals
fun run_signal(controls: *quic_runtime.ControlView, runtime: *Runtime) bool {
    var ok: bool = true;
    if (runtime.owns_process && runtime.observability != nil
        && !telemetry.begin_drain(runtime.observability)) { ok = false; }
    if (!listener.begin_drain(?runtime.owner)) { ok = false; }
    if (runtime.quic != nil && !runtime.quic_released
        && quic_runtime.graceful_all(controls, runtime.quic, clock.monotonic_ns())
        != quic_runtime.OK) { ok = false; }
    runtime.state = DRAINING;
    if (!signal_list(runtime, ?runtime.current))  { ok = false; }
    if (!signal_list(runtime, ?runtime.previous)) { ok = false; }
    ret ok;
}

# HTTP/2 sends GOAWAY, HTTP/1 marks its responses for close and stops
# reading. the engine decides which; the runtime only asks.
fun signal_list(runtime: *Runtime, list: *LiveList) bool {
    var ok: bool  = true;
    var i:  usize = list.head;
    for (i != NO_SLOT) {
        val slot: *Slot = slot_at(runtime, i);
        if (slot.live && !slot.signalled) {
            slot.signalled = true;
            if (!connection.begin_graceful(?slot.connection)) { ok = false; }
            mark_ready(runtime, i);
        }
        i = slot.next_live;
    }
    ret ok;
}

fun cancel_list(runtime: *Runtime, list: *LiveList) {
    var i: usize = list.head;
    for (i != NO_SLOT) {
        val slot: *Slot = slot_at(runtime, i);
        val next: usize = slot.next_live;
        if (slot.live) { retire(runtime, i); }
        i = next;
    }
}

# the previous generation's drain deadline passed: what it still holds is cut
fun cancel_previous(runtime: *Runtime) {
    cancel_list(runtime, ?runtime.previous);
}

# step 5 cancel whatever the deadline did not let finish
fun run_cancel(controls: *quic_runtime.ControlView, runtime: *Runtime) bool {
    val failures: u64  = runtime.teardown_failures;
    var quic_ok:  bool = true;
    if (runtime.quic != nil && !runtime.quic_released
        && quic_runtime.cancel_all(controls, runtime.quic) != quic_runtime.OK) {
        quic_ok = false;
    }
    cancel_list(runtime, ?runtime.current);
    cancel_list(runtime, ?runtime.previous);
    ret quic_ok && runtime.teardown_failures == failures;
}

fun run_action(controls: *quic_runtime.ControlView, runtime: *Runtime, action: lifecycle.Action) {
    if (action == lifecycle.NOTHING) { ret; }
    var ok: bool = true;
    if (action == lifecycle.SIGNAL) { ok = run_signal(controls, runtime); }
    or (action == lifecycle.CANCEL) { ok = run_cancel(controls, runtime); }
    or (action == lifecycle.FLUSH) {
        if (runtime.owns_process && runtime.observability != nil) {
            ok = telemetry.shutdown(runtime.observability);
        }
    }
    or {
        ok = release_quic(controls, runtime);
        if (runtime.quic == nil || runtime.quic_released) {
            if (listener.stop(?runtime.owner)) {
                runtime.state = STOPPED;
            }
            or {
                runtime.state = DRAINING;
                ok            = false;
            }
        }
    }
    if (!ok) { lifecycle.fail(?runtime.shutdown, action); }
}

# step 4: let the sequence advance as far as the clock and the live count allow
#
# `close` is false while polling. the final step tears down the io runtime, the
# network driver and the listener sockets, and doing that from inside a poll of
# that same runtime is a use of what it is destroying. releasing resources is
# the process's last act, so the sequence parks at FLUSHING and the owner
# performs the close.
fun advance_shutdown(controls: *quic_runtime.ControlView, runtime: *Runtime, now: time.Instant, close: bool) {
    var guard: usize = 0;
    for (guard < 8) {
        if (!close && lifecycle.awaiting_close(?runtime.shutdown)) { ret; }
        val action: lifecycle.Action = lifecycle.step(?runtime.shutdown,
            live_count(runtime), now);
        if (action == lifecycle.NOTHING) { ret; }
        run_action(controls, runtime, action);
        guard = guard + 1;
    }
}

# begin the sequence and let active exchanges finish within the drain deadline
pub fun begin_shutdown(controls: *quic_runtime.ControlView, runtime: *Runtime, now: time.Instant) bool {
    if (runtime == nil || runtime.state == NEW || runtime.state == STOPPED) {
        ret false;
    }
    val action: lifecycle.Action = lifecycle.begin(?runtime.shutdown, now,
        runtime.drain_timeout_ns);
    if (action == lifecycle.SIGNAL && runtime.drain_timeout_ns != 0) {
        runtime.shutdown_timer = hedge_timer.claim(?runtime.timers, SHUTDOWN_OWNER);
        if (runtime.shutdown_timer.index == hedge_timer.NONE
            || hedge_timer.arm(?runtime.timers, runtime.shutdown_timer,
            clock.after_ns(clock.to_ns(now), runtime.drain_timeout_ns))
            != hedge_timer.OK) {
            runtime.teardown_failures = runtime.teardown_failures + 1;
        }
    }
    run_action(controls, runtime, action);
    advance_shutdown(controls, runtime, now, false);
    ret true;
}

# --- reload ---
#
# a connection captures its plan and its generation when it is accepted and
# keeps both for its whole life, so a reload does not reach into work already in
# flight. what reload does is publish new listeners and a new plan for the
# connections that come next, and ask the ones that came before to finish.
#
# the superseded generation stays alive until its last connection is gone, which
# is what `superseded` reports. releasing its plan before that would pull the
# route graph out from under a request that is still being served.
# the budget set a reload would rebuild: whichever the active set is not
fun spare_budgets(runtime: *Runtime) *BudgetGeneration {
    if (runtime.active_budgets == ?runtime.budget_generations[0].set) {
        ret ?runtime.budget_generations[1];
    }
    ret ?runtime.budget_generations[0];
}

# the QUIC pump updates a reload to `generation` would apply, written to
# `updates`. false when a pump's configuration cannot be derived
fun quic_updates(runtime: *Runtime, graph: *schema.Graph, generation: u64,
    active_plan: *plan.Plan, budgets: *budget.Set, updates: *quic_runtime.PumpUpdate,
    count: *usize) bool {
    @count = 0;
    var i: usize = 0;
    for (i < graph.listener_count) {
        if (runtime.quic_handle_live[i]) {
            var config: quic_runtime.PumpConfig;
            if (!quic_config(runtime, graph, i, generation, active_plan,
                budgets, ?config)) { ret false; }
            updates[@count] = quic_runtime.PumpUpdate{
                handle: runtime.quic_handles[i], config: config
            };
            @count = @count + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether `reload` would publish this generation, asked without changing
# anything, so a reload spread over several workers refuses before any of them
# publishes. what `reload` can still refuse after this answers true is only the
# allocator or a pump's staging
pub fun check_reload(controls: *quic_runtime.ControlView, runtime: *Runtime, generation: u64,
    active_plan: *plan.Plan, graph: *schema.Graph, diagnostics: *schema.Diagnostics) bool {
    if (runtime == nil || active_plan == nil || graph == nil || diagnostics == nil
        || runtime.state != READY || !plan.sealed(active_plan)
        || active_plan.generation != generation
        || generation <= runtime.generation) { ret false; }
    # a reload during shutdown would publish listeners the sequence has already
    # decided to stop accepting on
    if (!lifecycle.serving(?runtime.shutdown)) { ret false; }
    if (listeners_changed(runtime, graph)) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.CONFLICT,
            "runtime", "reload",
            "listener changes require a process restart");
        ret false;
    }
    var drain_timeout_ns: u64 = 0;
    var stop_timeout_ns:  u64 = 0;
    if (!timeout_nanoseconds(graph.timeouts.drain_ms, ?drain_timeout_ns)
        || !timeout_nanoseconds(graph.timeouts.stop_ms, ?stop_timeout_ns)) {
        ret false;
    }
    val next: *BudgetGeneration = spare_budgets(runtime);
    # only a connection two reloads old can still hold the set about to be
    # rebuilt, and every such connection is on the previous list
    var i: usize = runtime.previous.head;
    for (i != NO_SLOT) {
        val slot: *Slot = slot_at(runtime, i);
        if (slot.live
            && slot.budgets == ?next.set) { ret false; }
        i = slot.next_live;
    }
    if (runtime.quic_count != 0) {
        if (quic_runtime.budgets_in_use(controls, runtime.quic, ?next.set)) { ret false; }
        var updates:      [schema.MAX_LISTENERS]quic_runtime.PumpUpdate;
        var update_count: usize = 0;
        if (!quic_updates(runtime, graph, generation, active_plan, ?next.set,
            ?updates[0], ?update_count)
            || quic_runtime.check_all(controls, runtime.quic, ?updates[0], update_count)
            != quic_runtime.OK) { ret false; }
    }
    ret true;
}

pub fun reload(controls: *quic_runtime.ControlView, runtime: *Runtime, generation: u64, active_plan: *plan.Plan,
    graph: *schema.Graph, diagnostics: *schema.Diagnostics) bool {
    if (!check_reload(controls, runtime, generation, active_plan, graph, diagnostics)) {
        ret false;
    }
    var drain_timeout_ns: u64 = 0;
    var stop_timeout_ns:  u64 = 0;
    timeout_nanoseconds(graph.timeouts.drain_ms, ?drain_timeout_ns);
    timeout_nanoseconds(graph.timeouts.stop_ms, ?stop_timeout_ns);
    val next: *BudgetGeneration = spare_budgets(runtime);
    # the set being rebuilt is two generations old, so nothing is charged to it
    budget.leave(?next.set);
    if (!configure_budgets(next, graph) || !share_budgets(runtime, next, generation)) {
        ret false;
    }
    var quic_result: quic_runtime.UpdateResult = quic_runtime.UpdateResult{
        status: quic_runtime.OK, committed: false, rollback_failed: false
    };
    if (runtime.quic_count != 0) {
        var updates:      [schema.MAX_LISTENERS]quic_runtime.PumpUpdate;
        var update_count: usize = 0;
        if (!quic_updates(runtime, graph, generation, active_plan, ?next.set,
            ?updates[0], ?update_count)) { ret false; }
        quic_result = quic_runtime.update_all(controls, runtime.quic,
            ?updates[0], update_count);
        if (!quic_result.committed) {
            if (quic_result.rollback_failed) {
                begin_shutdown(controls, runtime, clock.instant());
            }
            ret false;
        }
    }
    # every live connection is now of an older generation. it finishes what it
    # is doing and closes on its own next event, and the generation's drain
    # deadline cuts whatever is still open when it passes. a reload while the
    # previous generation is still draining restarts that deadline.
    supersede_live(runtime);
    runtime.plan             = active_plan;
    runtime.graph            = graph;
    runtime.generation       = generation;
    runtime.active_budgets   = ?next.set;
    runtime.configured       = connection.config_from(graph);
    runtime.limits           = connection.message_limits(graph, runtime.configured);
    runtime.drain_timeout_ns = drain_timeout_ns;
    runtime.stop_timeout_ns  = stop_timeout_ns;
    var armed: bool = true;
    if (runtime.previous.count != 0 && drain_timeout_ns != 0) {
        if (runtime.drain_timer.index == hedge_timer.NONE) {
            runtime.drain_timer = hedge_timer.claim(?runtime.timers, DRAIN_OWNER);
        }
        armed = runtime.drain_timer.index != hedge_timer.NONE
            && hedge_timer.arm(?runtime.timers, runtime.drain_timer,
            clock.monotonic_ns() + drain_timeout_ns) == hedge_timer.OK;
    }
    # publication already happened, so a failure here cannot be reported as a
    # rejected reload. enter the ordered shutdown path and surface it there.
    if (!armed || (quic_result.committed
        && quic_result.status != quic_runtime.OK)) {
        begin_shutdown(controls, runtime, clock.instant());
    }
    ret true;
}

# whether the candidate names a different set of listeners than the active one
fun listeners_changed(runtime: *Runtime, graph: *schema.Graph) bool {
    if (runtime.graph == nil
        || runtime.graph.listener_count != graph.listener_count) { ret true; }
    var i: usize = 0;
    for (i < graph.listener_count) {
        val configured: *schema.Listener = ?graph.listeners[i];
        val active:     *schema.Listener = ?runtime.graph.listeners[i];
        if (!schema.text_equals(?active.name, schema.text(?configured.name))
            || !schema.text_equals(?active.address,
            schema.text(?configured.address))
            || active.transport != configured.transport
            || active.protocols != configured.protocols
            || !schema.text_equals(?active.tls_policy,
            schema.text(?configured.tls_policy))
            || active.backlog != configured.backlog
            || active.accept_depth != configured.accept_depth
            || active.proxy_protocol != configured.proxy_protocol
            || active.trusted_peer_count != configured.trusted_peer_count) {
            ret true;
        }
        var peer: usize = 0;
        for (peer < active.trusted_peer_count) {
            if (!schema.text_equals(?active.trusted_peers[peer],
                schema.text(?configured.trusted_peers[peer]))) { ret true; }
            peer = peer + 1;
        }
        i = i + 1;
    }
    ret false;
}

# live connections still belonging to a superseded generation
pub fun superseded(controls: *quic_runtime.ControlView, runtime: *Runtime) usize {
    if (runtime == nil) { ret 0; }
    var count: usize = runtime.previous.count;
    if (runtime.quic != nil && !runtime.quic_released) {
        val quic_count: usize = quic_runtime.superseded(controls, runtime.quic);
        if (count > (-1)::usize - quic_count) { ret (-1)::usize; }
        count = count + quic_count;
    }
    ret count;
}

pub fun draining(runtime: *Runtime) bool {
    ret runtime != nil && lifecycle.draining(?runtime.shutdown);
}

pub fun idle(runtime: *Runtime) bool {
    ret runtime != nil && live_count(runtime) == 0;
}

# the drain deadline passed and the remainder was cancelled. waiting for those
# closes is `stop`'s, which bounds it by the stop deadline (#273)
pub fun cancelling(runtime: *Runtime) bool {
    ret runtime != nil && lifecycle.cancelling(?runtime.shutdown);
}

# the sequence has run to its end, resources included
pub fun finished(runtime: *Runtime) bool {
    ret runtime != nil && lifecycle.closed(?runtime.shutdown);
}

# every step but the resource close has run, which is the point at which a
# serving loop has nothing left to poll for
pub fun drained(runtime: *Runtime) bool {
    ret runtime != nil && (lifecycle.awaiting_close(?runtime.shutdown)
        || lifecycle.closed(?runtime.shutdown));
}

pub fun shutdown_reason(runtime: *Runtime) lifecycle.Reason {
    if (runtime == nil) { ret lifecycle.FAILED; }
    ret lifecycle.reason(?runtime.shutdown);
}

pub fun shutdown_cancelled(runtime: *Runtime) usize {
    if (runtime == nil) { ret 0; }
    ret lifecycle.cancelled(?runtime.shutdown);
}

# fallible teardown calls that failed, which would otherwise be invisible
pub fun teardown_failures(runtime: *Runtime) u64 {
    if (runtime == nil) { ret 0; }
    ret runtime.teardown_failures;
}

pub fun shutdown_failed_step(runtime: *Runtime) lifecycle.Action {
    if (runtime == nil) { ret lifecycle.NOTHING; }
    ret lifecycle.failed_step(?runtime.shutdown);
}

# stop without waiting
#
# every caller of this wants the process or the test to end now, so it enters
# the sequence with no deadline: signal, cancel, flush, close. the outcome is
# reported as IMMEDIATE rather than as a clean drain, because it is not one.
# calling it after a graceful drain has already begun finishes that sequence
# instead of restarting it, so a stop is idempotent.
pub fun stop(controls: *quic_runtime.ControlView, runtime: *Runtime) bool {
    if (runtime == nil || runtime.state == NEW) { ret false; }
    if (lifecycle.closed(?runtime.shutdown)) {
        if (runtime.state != STOPPED) {
            val quic_ok: bool = release_quic(controls, runtime);
            if (runtime.quic == nil || runtime.quic_released) {
                if (!listener.stop(?runtime.owner)) {
                    runtime.teardown_failures = runtime.teardown_failures + 1;
                }
                or {
                    runtime.state = STOPPED;
                    if (!connection.destroy_storage(?runtime.storage)
                        || !release_budgets(runtime)
                        || !release_pool(runtime)
                        || !hedge_timer.destroy(?runtime.timers)
                        || !hedge_memory.destroy(?runtime.memory)
                        || !hedge_wake.destroy(?runtime.wakes)) {
                        runtime.teardown_failures = runtime.teardown_failures + 1;
                    }
                }
            }
            if (!quic_ok) {
                runtime.teardown_failures = runtime.teardown_failures + 1;
            }
        }
        ret runtime.state == STOPPED
            && runtime.teardown_failures == 0
            && lifecycle.reason(?runtime.shutdown) != lifecycle.FAILED;
    }
    val now: time.Instant = clock.instant();
    if (lifecycle.serving(?runtime.shutdown)) {
        run_action(controls, runtime, lifecycle.begin(?runtime.shutdown, now, 0));
    }
    # a synchronous stop owns cancellation until every retained transport and
    # body completion has crossed the ordinary listener completion path.
    lifecycle.cancel_now(?runtime.shutdown, live_count(runtime));
    run_action(controls, runtime, lifecycle.CANCEL);
    # the drain gives up once stop_timeout_ns passes with no connection closing,
    # rather than waiting forever on a close nothing will finish (#273). what is
    # left open stays for `stalled` to name
    var live:     usize = live_count(runtime);
    var deadline: u64   = clock.after_ns(clock.monotonic_ns(), runtime.stop_timeout_ns);
    for (live != 0) {
        val left: i32 = wait_before(deadline);
        if (left == 0) {
            lifecycle.fail(?runtime.shutdown, lifecycle.CANCEL);
            ret false;
        }
        if (!poll(controls, runtime, left)) {
            lifecycle.fail(?runtime.shutdown, lifecycle.CANCEL);
            ret false;
        }
        if (live_count(runtime) != live) {
            live     = live_count(runtime);
            deadline = clock.after_ns(clock.monotonic_ns(), runtime.stop_timeout_ns);
        }
    }
    if (runtime.plane_quiesce::usize != 0) {
        var status: PlaneQuiesceStatus = runtime.plane_quiesce(
            runtime.plane_ctx, clock.instant());
        deadline = clock.after_ns(clock.monotonic_ns(), runtime.stop_timeout_ns);
        for (status == PLANE_PENDING) {
            var left: i32 = wait_before(deadline);
            if (left == 0) {
                lifecycle.fail(?runtime.shutdown, lifecycle.CLOSE);
                ret false;
            }
            $if ($mach.build.mode == $mach.mode.debug) { left = audit_wait(left); }
            val dispatched: u64 = listener.dispatched(?runtime.owner);
            if (!listener.poll(?runtime.owner, left)) {
                lifecycle.fail(?runtime.shutdown, lifecycle.CLOSE);
                ret false;
            }
            val idle: bool = listener.dispatched(?runtime.owner) == dispatched;
            if (!idle) { deadline = clock.after_ns(clock.monotonic_ns(), runtime.stop_timeout_ns); }
            val settled: time.Instant = clock.instant();
            if (runtime.plane::usize != 0) {
                runtime.plane(runtime.plane_ctx, settled);
            }
            status = runtime.plane_quiesce(runtime.plane_ctx, settled);
            $if ($mach.build.mode == $mach.mode.debug) { audit_turn(controls, runtime, idle); }
        }
        if (status != PLANE_QUIESCED) {
            lifecycle.fail(?runtime.shutdown, lifecycle.CLOSE);
            ret false;
        }
    }
    advance_shutdown(controls, runtime, clock.instant(), true);
    ret lifecycle.closed(?runtime.shutdown)
        && lifecycle.reason(?runtime.shutdown) != lifecycle.FAILED
        && runtime.teardown_failures == 0;
}

# the milliseconds a wait may take before the monotonic `deadline`, rounded up so
# a wait never ends short of it, or 0 once it has passed
fun wait_before(deadline: u64) i32 {
    val now: u64 = clock.monotonic_ns();
    if (now >= deadline) { ret 0; }
    var left: u64 = (deadline - now + 999999) / 1000000;
    if (left > 2147483647) { left = 2147483647; }
    ret left::i32;
}

# a connection a stop left open, and what its close waits on
pub rec Stalled {
    id:       u64;
    waits_on: str;
}

# the TCP connections still live, which after a stop that gave up are the ones
# it could not close. writes at most `capacity` of them to `output` and returns
# how many there are
pub fun stalled(runtime: *Runtime, output: *Stalled, capacity: usize) usize {
    if (runtime == nil) { ret 0; }
    ret stalled_list(runtime, ?runtime.current, output, capacity, 0)
        + stalled_list(runtime, ?runtime.previous, output, capacity,
        runtime.current.count);
}

fun stalled_list(runtime: *Runtime, list: *LiveList, output: *Stalled,
    capacity: usize, at: usize) usize {
    var count: usize = 0;
    var i:     usize = list.head;
    for (i != NO_SLOT) {
        val slot: *Slot = slot_at(runtime, i);
        if (slot.live) {
            if (output != nil && at + count < capacity) {
                output[at + count] = Stalled{id: slot.connection.id, waits_on: stall_reason(slot)};
            }
            count = count + 1;
        }
        i = slot.next_live;
    }
    ret count;
}

fun stall_reason(slot: *Slot) str {
    val wait: connection.CloseWait = connection.close_wait(?slot.connection);
    if (wait != connection.CLOSE_READY) { ret connection.close_wait_text(wait); }
    if (slot.retiring)                  { ret "its retirement, queued and not yet run"; }
    if (slot.waiting)                   { ret "a place in its budget's queue"; }
    ret "its next step, not yet asked to close";
}

# the QUIC connections still live, which the QUIC runtime counts but does not
# name
pub fun stalled_quic(runtime: *Runtime) usize {
    if (runtime == nil || runtime.quic == nil || runtime.quic_released) { ret 0; }
    ret quic_runtime.live(runtime.quic);
}

# zero sizes for a listener with no QUIC socket
pub fun socket_buffers(runtime: *Runtime, index: usize) listener.SocketBuffers {
    var none:  listener.SocketBuffers;
    val owned: *listener.OwnedListener = listener.active_listener(?runtime.owner, index);
    if (owned == nil || !owned.has_udp_socket) { ret none; }
    ret owned.socket_buffers;
}

pub fun bound_endpoint_text(runtime: *Runtime, index: usize, output: *u8, capacity: usize) usize {
    val owned: *listener.OwnedListener = listener.active_listener(?runtime.owner, index);
    if (owned == nil || !owned.has_bound_endpoint) { ret 0; }
    ret endpoint_text(owned, output, capacity);
}

fun endpoint_text(owned: *listener.OwnedListener, output: *u8, capacity: usize) usize {
    ret ip.endpoint_format(owned.bound_endpoint, output, capacity);
}

test "serve: the live lists hold exactly the live connection slots, by generation" {
    var a: A.Allocator;
    page.make(?a);
    var runtime: Runtime;
    if (!hedge_storage.make_table[Slot](?runtime.slots, ?a)) { ret 1; }
    runtime.current  = empty_list();
    runtime.previous = empty_list();

    val first:  usize = free_slot(?runtime);
    val second: usize = free_slot(?runtime);
    val third:  usize = free_slot(?runtime);
    if (first != 0 || second != 1 || third != 2) { ret 2; }
    # a fourth claim is where a three-slot pool refused
    val fourth: usize = free_slot(?runtime);
    if (fourth != 3 || hedge_storage.table_live[Slot](?runtime.slots) != 4) { ret 3; }
    return_slot(?runtime, fourth);

    link_live(?runtime, ?runtime.current, first);
    link_live(?runtime, ?runtime.current, second);
    if (runtime.current.head != second || runtime.current.tail != first
        || runtime.current.count != 2
        || slot_at(?runtime, second).next_live != first
        || slot_at(?runtime, first).prev_live != second
        || slot_at(?runtime, first).next_live != NO_SLOT) { ret 4; }

    # a reload moves every current slot to the previous list in one splice
    supersede_live(?runtime);
    if (runtime.current.head != NO_SLOT || runtime.current.count != 0
        || runtime.previous.head != second || runtime.previous.tail != first
        || runtime.previous.count != 2) { ret 5; }
    link_live(?runtime, ?runtime.current, third);
    if (runtime.current.count != 1 || runtime.previous.count != 2) { ret 6; }

    # a second reload before the first drained splices in front of the rest
    supersede_live(?runtime);
    if (runtime.previous.head != third || runtime.previous.tail != first
        || runtime.previous.count != 3
        || slot_at(?runtime, third).next_live != second
        || slot_at(?runtime, second).prev_live != third) { ret 7; }

    unlink_live(?runtime, ?runtime.previous, second);
    if (runtime.previous.head != third || runtime.previous.count != 2
        || slot_at(?runtime, third).next_live != first
        || slot_at(?runtime, first).prev_live != third) { ret 8; }
    unlink_live(?runtime, ?runtime.previous, first);
    if (runtime.previous.tail != third || runtime.previous.count != 1) { ret 9; }

    return_slot(?runtime, second);
    if (free_slot(?runtime) != second) { ret 10; }

    unlink_live(?runtime, ?runtime.previous, third);
    if (runtime.previous.head != NO_SLOT || runtime.previous.tail != NO_SLOT
        || runtime.previous.count != 0) { ret 11; }
    ret 0;
}

# the connection record is the slot's, so connections leaving hand back the
# slot chunks they sat in, and a survivor's record never moves (#235)
test "serve: a slot carries its connection and departures recede the slot table" {
    var a: A.Allocator;
    page.make(?a);
    var runtime: Runtime;
    if (!hedge_storage.make_table[Slot](?runtime.slots, ?a)) { ret 1; }
    runtime.current  = empty_list();
    runtime.previous = empty_list();
    val count: usize = 400;
    var i:     usize = 0;
    for (i < count) {
        val index: usize = free_slot(?runtime);
        if (index != i) { ret 2; }
        # a claimed slot that is not yet live holds no connection a caller may see
        if (slot_connection(?runtime, index) != nil) { ret 3; }
        slot_at(?runtime, index).live = true;
        if (slot_connection(?runtime, index) != ?slot_at(?runtime, index).connection) { ret 4; }
        i = i + 1;
    }
    val full: usize = hedge_storage.table_chunks[Slot](?runtime.slots);
    if (full < 3) { ret 5; }
    val kept: *connection.Connection = slot_connection(?runtime, 0);
    kept.requests = 9;
    i             = count;
    for (i > 1) {
        i                         = i - 1;
        slot_at(?runtime, i).live = false;
        return_slot(?runtime, i);
        if (slot_connection(?runtime, i) != nil) { ret 6; }
    }
    # every chunk above the survivor's is released with the records it held
    if (hedge_storage.table_chunks[Slot](?runtime.slots) != 1
        || slot_capacity(?runtime) != hedge_storage.FIRST_CHUNK) { ret 7; }
    if (slot_connection(?runtime, 0) != kept || kept.requests != 9) { ret 8; }
    slot_at(?runtime, 0).live = false;
    return_slot(?runtime, 0);
    if (slot_capacity(?runtime) != 0 || slot_connection(?runtime, 0) != nil) { ret 9; }
    if (!hedge_storage.destroy_table[Slot](?runtime.slots))                  { ret 10; }
    ret 0;
}
