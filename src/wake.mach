# a worker's wake queue, where every parked owner is made runnable again
#
# whatever a connection waits on that is not its own i/o (an upstream link, a
# budget, a service of its own) holds a waker for it. waking pushes the owner's
# tagged id here, and the worker routes each id to the protocol that owns it on
# its next turn. owners are tagged the way timer owners are, so one queue and one
# wheel serve every protocol a worker runs. the queue belongs to one worker and
# is touched only from it, so it takes no lock.
#
# a wake is a hint, never a transfer of work: waking an owner that has nothing
# to do, or one that has since gone, costs one wasted step and nothing else.
#
# a wake may also name one call its owner serves, the request a service parked
# on the wake. the owner then re-enters that call's service and no other, so a
# wake meant for one stream never re-enters its neighbours (#131). the call is
# the owner's own index for it, and a stale one costs one wasted re-entry.

use A: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

pub rec Queue {
    wakes:       vector.Vector[Wake];
    initialized: bool;
}

# one wake as the worker takes it: the owner to run, and the call of that owner
# whose service it is for, or NO_CALL when it is for the owner itself
pub rec Wake {
    owner: u64;
    call:  u32;
}

pub val NO_CALL: u32 = 0xffffffff;

# a handle a waiter keeps, naming who to wake and on which worker
pub rec Waker {
    queue: *Queue;
    owner: u64;
    call:  u32;
}

# an owner no protocol routes. waking it only gives the worker a turn, which
# is all a plane that is driven every turn needs
pub val PLANE_OWNER: u64 = 0x504c000000000000;

pub fun no_waker() Waker {
    ret Waker{queue: nil, owner: 0, call: NO_CALL};
}

pub fun make(queue: *Queue, a: *A.Allocator) bool {
    if (queue == nil || a == nil || queue.initialized) { ret false; }
    queue.wakes       = vector.init[Wake](a);
    queue.initialized = true;
    ret true;
}

pub fun destroy(queue: *Queue) bool {
    if (queue == nil || !queue.initialized) { ret false; }
    val released: err[A.Error] = vector.dnit[Wake](?queue.wakes);
    queue.initialized = false;
    ret sel released.ok;
}

pub fun waker(queue: *Queue, owner: u64) Waker {
    ret Waker{queue: queue, owner: owner, call: NO_CALL};
}

# the waker a call hands to what its service waits on: its owner's, naming the
# call by the owner's index for it
pub fun for_call(base: Waker, call: u32) Waker {
    ret Waker{queue: base.queue, owner: base.owner, call: call};
}

pub fun valid(value: *Waker) bool {
    ret value != nil && value.queue != nil && value.queue.initialized;
}

# false only when the queue could not grow, which the caller must treat as a
# waiter that will never run again
pub fun wake(value: *Waker) bool {
    if (!valid(value)) { ret false; }
    val pushed: res[usize, A.Error] = vector.push[Wake](?value.queue.wakes,
        Wake{owner: value.owner, call: value.call});
    ret sel pushed.ok;
}

pub fun pending(queue: *Queue) bool {
    ret queue != nil && queue.initialized && queue.wakes.len != 0;
}

# take up to `capacity` wakes in the order they were made. wakes made while the
# caller routes these wait for the next take
pub fun take(queue: *Queue, output: *Wake, capacity: usize) usize {
    if (queue == nil || !queue.initialized || output == nil) { ret 0; }
    var count: usize = queue.wakes.len;
    if (count > capacity) { count = capacity; }
    var i: usize = 0;
    for (i < count) {
        output[i] = queue.wakes.data[i];
        i         = i + 1;
    }
    val rest: usize = queue.wakes.len - count;
    var j:    usize = 0;
    for (j < rest) {
        queue.wakes.data[j] = queue.wakes.data[count + j];
        j                   = j + 1;
    }
    queue.wakes.len = rest;
    ret count;
}

test "wake: owners come back in the order they were woken" {
    var pages: A.Allocator;
    page.make(?pages);
    var queue: Queue;
    if (!make(?queue, ?pages)) { ret 1; }
    var first:  Waker = waker(?queue, 7);
    var second: Waker = waker(?queue, 9);
    if (!wake(?second) || !wake(?first) || !pending(?queue)) { ret 2; }
    var taken: [4]Wake;
    if (take(?queue, ?taken[0], 1) != 1 || taken[0].owner != 9) { ret 3; }
    if (take(?queue, ?taken[0], 4) != 1 || taken[0].owner != 7) { ret 4; }
    if (pending(?queue))                                        { ret 5; }
    if (!destroy(?queue))                                       { ret 6; }
    ret 0;
}

test "wake: a call's waker names its call, and its owner's names none" {
    var pages: A.Allocator;
    page.make(?pages);
    var queue: Queue;
    if (!make(?queue, ?pages)) { ret 1; }
    var owner:  Waker = waker(?queue, 7);
    var second: Waker = for_call(owner, 2);
    if (!wake(?second) || !wake(?owner)) { ret 2; }
    var taken: [4]Wake;
    if (take(?queue, ?taken[0], 4) != 2
        || taken[0].owner != 7 || taken[0].call != 2
        || taken[1].owner != 7 || taken[1].call != NO_CALL) { ret 3; }
    if (!destroy(?queue)) { ret 4; }
    ret 0;
}

test "wake: a waker with no queue refuses" {
    var none: Waker = no_waker();
    if (wake(?none)) { ret 1; }
    ret 0;
}
