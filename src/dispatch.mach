# virtual-host and route dispatch over an immutable per-generation plan
#
# a protocol engine calls into this module after it has translated its connection
# state into the common service exchange. dispatch never learns which protocol
# delivered the request, so protocol selection can grow without reaching in here.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use std.chrono.time;
use std.sync.cancel;
use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.method;
use http.core.target;
use hedge.config.schema;
use std.types.string.str_equals;
use telemetry_trace: hedge.telemetry.trace;
use http.core.message;
use http.core.status;
use http.router.router;
use hedge.service;
use hedge.dispatch.call;
use hedge.dispatch.plan;
use hedge.dispatch.middleware;

fwd call.Disposition;
fwd call.BODY_UNRESOLVED;
fwd call.BODY_DELIVER;
fwd call.BODY_DRAIN;
fwd call.BODY_REJECT;
fwd call.BODY_CLOSE;
fwd call.Call;
fwd call.Memory;
fwd call.Route;
fwd call.make_memory;
fwd call.bind;
fwd plan.Plan;
fwd plan.Entry;
fwd plan.Storage;
fwd plan.Report;
fwd plan.make_storage;
fwd plan.compile;
fwd plan.PLAN_OK;
fwd middleware.Middleware;
fwd middleware.Chain;
fwd middleware.Chains;
fwd middleware.make_chains;
fwd middleware.add_chain;
fwd middleware.CONTINUE;
fwd middleware.RESPOND;
fwd middleware.FAIL;

pub def Outcome: u8;
pub val SERVED: Outcome = 1;
pub val NOT_FOUND: Outcome = 2;
pub val MISDIRECTED: Outcome = 4;
pub val REJECTED: Outcome = 5;
pub val PENDING: Outcome = 6;
pub val FAILED: Outcome = 7;

pub rec Result {
    outcome: Outcome;
    route: usize;
    status: exchange.ServiceStatus;
}

fun result(code: Outcome, route: usize, served: exchange.ServiceStatus) Result {
    ret Result{outcome: code, route: route, status: served};
}

fun refuse(active: *call.Call, code: status.Status, outcome: Outcome) Result {
    if (service.respond(active, code) != exchange.SERVICE_COMPLETE) {
        ret result(FAILED, plan.NO_INDEX, exchange.SERVICE_FAILED);
    }
    ret result(outcome, plan.NO_INDEX, exchange.SERVICE_COMPLETE);
}

# the router reports why no route matched; each reason has one product response
fun outcome_for(dispatched: router.DispatchStatus) Outcome {
    if (dispatched == router.DISPATCH_NOT_FOUND) { ret NOT_FOUND; }
    if (dispatched == router.DISPATCH_HOST) { ret MISDIRECTED; }
    if (dispatched == router.DISPATCH_CAPTURE_CAPACITY) { ret FAILED; }
    ret REJECTED;
}

fun refusal_status(outcome: Outcome) status.Status {
    if (outcome == NOT_FOUND) { ret status.NOT_FOUND; }
    if (outcome == MISDIRECTED) { ret status.MISDIRECTED_REQUEST; }
    ret status.BAD_REQUEST;
}

# serve one bound call against one sealed plan
#
# the exchange, the request arena, the telemetry context, and the resolved body
# disposition are established by the caller and cross into the service here once.
# every value the service needs is already in the call; nothing is fetched again.
pub fun serve(active_plan: *plan.Plan, active: *call.Call, captures: *router.Capture,
    capture_capacity: usize) Result {
    if (active_plan == nil || !plan.sealed(active_plan) || active == nil || !active.bound) {
        ret result(FAILED, plan.NO_INDEX, exchange.SERVICE_FAILED);
    }
    if (active.generation != active_plan.generation) {
        ret result(FAILED, plan.NO_INDEX, exchange.SERVICE_FAILED);
    }
    if (call.cancelled(active)) {
        ret result(REJECTED, plan.NO_INDEX, exchange.SERVICE_FAILED);
    }
    val matched: router.Dispatch = plan.match(active_plan, call.request(active), captures, capture_capacity);
    if (matched.status != router.DISPATCH_MATCH) {
        val outcome: Outcome = outcome_for(matched.status);
        if (outcome == FAILED) { ret result(FAILED, plan.NO_INDEX, exchange.SERVICE_FAILED); }
        ret refuse(active, refusal_status(outcome), outcome);
    }
    val selected: *plan.Entry = plan.entry(active_plan, matched.source_index);
    if (selected == nil) {
        ret result(FAILED, plan.NO_INDEX, exchange.SERVICE_FAILED);
    }
    if (!call.enter(active, call.Route{
        index: matched.source_index,
        name: selected.name,
        host: selected.host,
        service: selected.service,
    })) {
        ret result(FAILED, matched.source_index, exchange.SERVICE_FAILED);
    }
    val handler: service.Handler = plan.handler_for(active_plan, selected);
    if (!service.has_handler(handler)) {
        ret result(FAILED, matched.source_index, exchange.SERVICE_FAILED);
    }
    var ran: usize = 0;
    val decision: middleware.Decision = middleware.run_before(
        active_plan.storage.middleware, selected.middleware_start, selected.middleware_count, active, ?ran);
    if (decision == middleware.RESPOND) {
        middleware.run_after(active_plan.storage.middleware, selected.middleware_start, ran, active);
        ret result(SERVED, matched.source_index, exchange.SERVICE_COMPLETE);
    }
    if (decision != middleware.CONTINUE) {
        middleware.run_error(active_plan.storage.middleware, selected.middleware_start, ran, active, exchange.SERVICE_FAILED);
        ret result(FAILED, matched.source_index, exchange.SERVICE_FAILED);
    }
    val served: exchange.ServiceStatus = handler.serve(handler.ctx, active);
    if (served == exchange.SERVICE_FAILED) {
        middleware.run_error(active_plan.storage.middleware, selected.middleware_start, ran, active, served);
        ret result(FAILED, matched.source_index, served);
    }
    middleware.run_after(active_plan.storage.middleware, selected.middleware_start, ran, active);
    if (served == exchange.SERVICE_PENDING) {
        ret result(PENDING, matched.source_index, served);
    }
    ret result(SERVED, matched.source_index, served);
}

# re-enter a service that reported itself pending
#
# the boundary is not crossed again: the route was selected once, and the
# deadline, cancellation, arena, telemetry context, and body disposition were
# established once. this only gives the same service another turn.
pub fun resume(active_plan: *plan.Plan, active: *call.Call) Result {
    if (active_plan == nil || !plan.sealed(active_plan) || active == nil
     || !active.bound || !call.entered(active)) {
        ret result(FAILED, plan.NO_INDEX, exchange.SERVICE_FAILED);
    }
    val selected: *plan.Entry = plan.entry(active_plan, active.route.index);
    if (selected == nil) { ret result(FAILED, active.route.index, exchange.SERVICE_FAILED); }
    val handler: service.Handler = plan.handler_for(active_plan, selected);
    if (!service.has_handler(handler)) {
        ret result(FAILED, active.route.index, exchange.SERVICE_FAILED);
    }
    val served: exchange.ServiceStatus = handler.serve(handler.ctx, active);
    if (served == exchange.SERVICE_FAILED) {
        middleware.run_error(active_plan.storage.middleware, selected.middleware_start,
            selected.middleware_count, active, served);
        ret result(FAILED, active.route.index, served);
    }
    if (served == exchange.SERVICE_PENDING) {
        ret result(PENDING, active.route.index, served);
    }
    middleware.run_after(active_plan.storage.middleware, selected.middleware_start,
        selected.middleware_count, active);
    ret result(SERVED, active.route.index, served);
}


# --- test scaffolding: one complete exchange over caller-owned storage ---

rec Fixture {
    scope: cancel.Scope;
    reader: body.Reader;
    request: message.Request;
    response: message.Response;
    request_fields: [8]field.Field;
    request_trailers: [4]field.Field;
    response_fields: [16]field.Field;
    response_trailers: [4]field.Field;
    informationals: [2]message.Informational;
    exchange: exchange.Exchange;
    arena: [4096]u8;
    memory: call.Memory;
    trace: telemetry_trace.Context;
    call: call.Call;
}

fun make_fixture(fixture: *Fixture, generation: u64, path: str, host: str) bool {
    val configured: message.Limits = message.limits_default();
    if (!cancel.make_root(?fixture.scope, false, time.Time{sec: 0, nsec: 0})) { ret false; }
    fixture.reader = body.empty_reader(generation);
    var fields: field.Fields = field.init(?fixture.request_fields[0], 8, configured.request_fields);
    if (field.append(?fields, field.Field{
        name: service.text_view("host"),
        value: service.text_view(host),
        sensitive: false,
    }) != field.ADD_OK) { ret false; }
    val trailers: field.Fields = field.init(?fixture.request_trailers[0], 4, configured.request_trailers);
    val metadata: message.Metadata = message.Metadata{
        version: message.version_h1(1, 1),
        secure: false,
        early_data: false,
        peer: message.endpoint(message.ENDPOINT_IP, service.text_view("127.0.0.1"), 40000),
        local: message.endpoint(message.ENDPOINT_IP, service.text_view("127.0.0.1"), 8080),
        received_at: time.Time{sec: 1, nsec: 0},
        has_deadline: false,
        deadline: time.Time{sec: 0, nsec: 0},
        request_index: 1,
    };
    if (!message.init_request(?fixture.request, method.from_kind(method.GET),
        target.origin(service.text_view(path), service.text_view(path), view.view(nil, 0)),
        metadata, fields, trailers, ?fixture.reader, generation, configured)) { ret false; }
    if (!message.init_response(?fixture.response, ?fixture.response_fields[0], 16,
        ?fixture.response_trailers[0], 4, generation, configured)) { ret false; }
    if (!exchange.init(?fixture.exchange, ?fixture.request, ?fixture.response,
        ?fixture.informationals[0], 2, ?fixture.scope, generation, configured)) { ret false; }
    if (!exchange.begin(?fixture.exchange)) { ret false; }
    if (!call.make_memory(?fixture.memory, ?fixture.arena[0], 4096)) { ret false; }
    if (!telemetry_trace.make_root(?fixture.trace, false)) { ret false; }
    ret call.bind(?fixture.call, ?fixture.exchange, ?fixture.memory, ?fixture.trace, generation, "test");
}

rec PlanFixture {
    routes: [8]router.CompiledRoute;
    segments: [64]router.Segment;
    specs: [8]router.Route;
    entries: [8]plan.Entry;
    services: [8]service.Descriptor;
    middleware: [8]middleware.Middleware;
    text: [2048]u8;
    storage: plan.Storage;
    plan: plan.Plan;
    graph: schema.Graph;
    diagnostics: schema.Diagnostics;
}

fun make_plan(fixture: *PlanFixture, generation: u64, graph: *schema.Graph,
    resolver: *service.Resolver, chains: *middleware.Chains) plan.Report {
    plan.make_storage(?fixture.storage,
        ?fixture.routes[0], 8,
        ?fixture.segments[0], 64,
        ?fixture.specs[0], 8,
        ?fixture.entries[0], 8,
        ?fixture.services[0], 8,
        ?fixture.middleware[0], 8,
        ?fixture.text[0], 2048);
    ret plan.compile(?fixture.plan, generation, graph, fixture.storage, resolver, chains);
}

fun sample_graph(graph: *schema.Graph) {
    schema.reset_graph(graph);
    schema.set_text(?graph.server_name, "test");
    graph.host_count = 1;
    schema.set_text(?graph.hosts[0].name, "site");
    schema.set_text(?graph.hosts[0].listener, "public");
    graph.hosts[0].server_name_count = 1;
    schema.set_text(?graph.hosts[0].server_names[0], "example.test");
    graph.service_count = 1;
    schema.set_text(?graph.services[0].name, "greeting");
    graph.services[0].kind = schema.SERVICE_FIXED;
    schema.set_text(?graph.services[0].target, "hello");
    schema.set_text(?graph.services[0].content_type, "text/plain");
    graph.services[0].status = 200;
    graph.route_count = 1;
    schema.set_text(?graph.routes[0].name, "root");
    schema.set_text(?graph.routes[0].host, "site");
    schema.set_text(?graph.routes[0].path, "/greet");
    schema.set_text(?graph.routes[0].service, "greeting");
}

test "dispatch: a sealed plan serves a route and crosses the service boundary once" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    var resolver: service.Resolver = service.no_resolver();
    val built: plan.Report = make_plan(?planned, 7, ?planned.graph, ?resolver, nil);
    if (built.status != plan.PLAN_OK) { ret 1; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 7, "/greet", "example.test")) { ret 2; }
    var captures: [4]router.Capture;
    val served: Result = serve(?planned.plan, ?fixture.call, ?captures[0], 4);
    if (served.outcome != SERVED || served.route != 0) { ret 3; }
    if (!call.entered(?fixture.call) || call.disposition(?fixture.call) != call.BODY_DRAIN) { ret 4; }
    if (fixture.response.status != 200 || !fixture.response.committed) { ret 5; }
    if (!str_equals(fixture.call.route.name, "root") || !str_equals(fixture.call.route.service, "greeting")) { ret 6; }
    if (fixture.response.body_kind != message.BODY_READER) { ret 7; }
    val media: *field.Field = field.find_first(?fixture.response.fields, service.text_view("content-type"));
    if (media == nil || !view.view_eq_str(media.value, "text/plain")) { ret 8; }
    var output: [16]u8;
    val first: body.Progress = body.read(fixture.response.body_reader, ?output[0], 16);
    if (first.status != body.DATA || first.count != 5) { ret 9; }
    if (output[0] != 'h' || output[1] != 'e' || output[2] != 'l' || output[3] != 'l' || output[4] != 'o') { ret 10; }
    val last: body.Progress = body.read(fixture.response.body_reader, ?output[0], 16);
    if (last.status != body.COMPLETE) { ret 11; }
    if (exchange.finish(?fixture.exchange) != exchange.FINISH_OK) { ret 12; }
    if (fixture.exchange.completion.bytes_out != 5) { ret 13; }
    # the boundary admits exactly one crossing
    if (call.enter(?fixture.call, call.Route{index: 0, name: nil, host: nil, service: nil})) { ret 14; }
    if (call.resolve_body(?fixture.call, call.BODY_CLOSE)) { ret 15; }
    # the arena is reusable only once disposition and the exchange have both settled
    if (!call.releasable(?fixture.call) || !call.release(?fixture.call)) { ret 16; }
    if (call.release(?fixture.call)) { ret 17; }
    ret 0;
}

test "dispatch: an unmatched path is refused without entering a service" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    var resolver: service.Resolver = service.no_resolver();
    if (make_plan(?planned, 3, ?planned.graph, ?resolver, nil).status != plan.PLAN_OK) { ret 1; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 3, "/absent", "example.test")) { ret 2; }
    var captures: [4]router.Capture;
    val served: Result = serve(?planned.plan, ?fixture.call, ?captures[0], 4);
    if (served.outcome != NOT_FOUND) { ret 3; }
    if (call.entered(?fixture.call)) { ret 4; }
    if (fixture.response.status != status.NOT_FOUND) { ret 5; }
    ret 0;
}

test "dispatch: a host outside the route graph matches nothing" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    var resolver: service.Resolver = service.no_resolver();
    if (make_plan(?planned, 4, ?planned.graph, ?resolver, nil).status != plan.PLAN_OK) { ret 1; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 4, "/greet", "other.test")) { ret 2; }
    var captures: [4]router.Capture;
    val served: Result = serve(?planned.plan, ?fixture.call, ?captures[0], 4);
    if (served.outcome != NOT_FOUND || call.entered(?fixture.call)) { ret 3; }
    ret 0;
}

test "dispatch: a call bound to another generation never reaches a service" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    var resolver: service.Resolver = service.no_resolver();
    if (make_plan(?planned, 9, ?planned.graph, ?resolver, nil).status != plan.PLAN_OK) { ret 1; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 8, "/greet", "example.test")) { ret 2; }
    var captures: [4]router.Capture;
    if (serve(?planned.plan, ?fixture.call, ?captures[0], 4).outcome != FAILED) { ret 3; }
    if (call.entered(?fixture.call)) { ret 4; }
    ret 0;
}

test "dispatch: a cancelled scope is rejected before route selection" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    var resolver: service.Resolver = service.no_resolver();
    if (make_plan(?planned, 5, ?planned.graph, ?resolver, nil).status != plan.PLAN_OK) { ret 1; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 5, "/greet", "example.test")) { ret 2; }
    cancel.cancel(?fixture.scope);
    var captures: [4]router.Capture;
    if (serve(?planned.plan, ?fixture.call, ?captures[0], 4).outcome != REJECTED) { ret 3; }
    if (call.entered(?fixture.call)) { ret 4; }
    ret 0;
}


rec Recorder {
    calls: usize;
    saw_route: bool;
    saw_deadline: bool;
    decision: middleware.Decision;
}

# an application handler sees only the common exchange and the values hedge owns
fun application_handler(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val state: *Recorder = context::*Recorder;
    state.calls = state.calls + 1;
    state.saw_route = str_equals(active.route.name, "root");
    var when: time.Time;
    state.saw_deadline = call.deadline(active, ?when);
    if (call.cancelled(active)) { ret exchange.SERVICE_FAILED; }
    if (message.set_status(call.response(active), status.ACCEPTED) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.commit_bodyless(active, call.BODY_REJECT);
}

fun blocking_before(context: ptr, active: *call.Call) middleware.Decision {
    val state: *Recorder = context::*Recorder;
    state.calls = state.calls + 1;
    if (state.decision == middleware.RESPOND) {
        if (message.set_status(call.response(active), status.FORBIDDEN) != message.RESPONSE_OK) {
            ret middleware.FAIL;
        }
        if (service.commit_bodyless(active, call.BODY_REJECT) != exchange.SERVICE_COMPLETE) {
            ret middleware.FAIL;
        }
    }
    ret state.decision;
}

test "dispatch: a registered application is reached through the same service boundary" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    planned.graph.services[0].kind = schema.SERVICE_LAUREL;
    schema.set_text(?planned.graph.services[0].target, "site");
    var observed: Recorder = Recorder{calls: 0, saw_route: false, saw_deadline: false, decision: middleware.CONTINUE};
    var slots: [2]service.Application;
    var registry: service.Applications;
    if (!service.make_applications(?registry, ?slots[0], 2)) { ret 1; }
    if (!service.register_application(?registry, "site", service.Handler{
        ctx: (?observed)::ptr,
        serve: application_handler,
    })) { ret 2; }
    var resolver: service.Resolver = service.no_resolver();
    resolver.applications = ?registry;
    if (make_plan(?planned, 11, ?planned.graph, ?resolver, nil).status != plan.PLAN_OK) { ret 3; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 11, "/greet", "example.test")) { ret 4; }
    var captures: [4]router.Capture;
    val served: Result = serve(?planned.plan, ?fixture.call, ?captures[0], 4);
    if (served.outcome != SERVED || observed.calls != 1 || !observed.saw_route) { ret 5; }
    if (fixture.response.status != status.ACCEPTED) { ret 6; }
    if (call.disposition(?fixture.call) != call.BODY_REJECT) { ret 7; }
    ret 0;
}

test "dispatch: middleware short circuits before the service is entered" {
    var planned: PlanFixture;
    sample_graph(?planned.graph);
    var resolver: service.Resolver = service.no_resolver();
    var guard: Recorder = Recorder{calls: 0, saw_route: false, saw_deadline: false, decision: middleware.RESPOND};
    var items: [1]middleware.Middleware;
    items[0] = middleware.Middleware{
        ctx: (?guard)::ptr,
        before: blocking_before,
        after: (0::usize)::middleware.AfterFun,
        on_error: (0::usize)::middleware.ErrorFun,
    };
    var chain_storage: [1]middleware.Chain;
    var chains: middleware.Chains;
    if (!middleware.make_chains(?chains, ?chain_storage[0], 1)) { ret 1; }
    if (!middleware.add_chain(?chains, middleware.ANY_ROUTE, ?items[0], 1)) { ret 2; }
    if (make_plan(?planned, 12, ?planned.graph, ?resolver, ?chains).status != plan.PLAN_OK) { ret 3; }
    if (planned.plan.middleware_count != 1 || planned.entries[0].middleware_count != 1) { ret 4; }
    var fixture: Fixture;
    if (!make_fixture(?fixture, 12, "/greet", "example.test")) { ret 5; }
    var captures: [4]router.Capture;
    val served: Result = serve(?planned.plan, ?fixture.call, ?captures[0], 4);
    if (served.outcome != SERVED || guard.calls != 1) { ret 6; }
    if (fixture.response.status != status.FORBIDDEN || fixture.response.body_kind != message.BODY_NONE) { ret 7; }
    ret 0;
}
