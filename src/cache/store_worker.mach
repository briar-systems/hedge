# the thread that owns the cache's disk (#286)
#
# every disk request the cache makes (a body read or write, a file removal, the
# startup purge) runs here, so no serving worker ever waits on the disk. a
# serving worker submits a request and parks on it: the request is queued, this
# thread runs it, and its completion reaches the submitting worker through that
# worker's wake queue, which ends its wait. a request with no waker is
# published here, and its submitter finds it done when it next looks.
#
# the queue is bounded by admission. a stream of requests (one body read or
# written in pieces) is admitted before its first request, so a full queue is a
# refused admission the caller handles, and a request of an admitted stream is
# never refused. removals and the purge draw on a reserve of their own.
#
# stop drains the queue. it gives up once its timeout passes with no request
# completing, and `outstanding` then names what is still queued or running.
#
# the worker keeps time on a clock of its own: stop's timeout and a slow disk's
# delay are both measured on it. in service that is the monotonic clock, and a
# test hands it a manual one it moves itself, so no scheduling delay can reach
# a deadline the test depends on.

use hedge.cache.disk;
use hedge.clock;
use hedge.wake;
use A: std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.filesystem;
use io_error:   std.io.error;
use io_runtime: std.io.runtime;
use std.sync.atomic;
use std.sync.condition;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# the clock a worker keeps time on: `now` reads it, and `advance` lets `ns`
# pass on it, returning once they have
pub rec Clock {
    ctx:     ptr;
    now:     fun(ptr) time.Instant;
    advance: fun(ptr, u64);
}

# a clock only its owner moves, for tests. it reads zero until advanced
pub rec ManualClock {
    now_ns: i64;
}

# the monotonic clock, on which advancing sleeps
pub fun monotonic() Clock {
    ret Clock{ctx: nil, now: monotonic_now, advance: monotonic_advance};
}

fun monotonic_now(context: ptr) time.Instant {
    ret clock.instant();
}

fun monotonic_advance(context: ptr, ns: u64) {
    val deadline: time.Instant = clock.after(clock.instant(), ns);
    var left:     u64          = ns;
    for (left != 0) {
        os.sleep(left::i64);
        left = clock.between_ns(clock.instant(), deadline);
    }
}

pub fun manual_clock() ManualClock {
    ret ManualClock{now_ns: 0};
}

# `source` as a worker's clock, which advancing moves at once
pub fun manual(source: *ManualClock) Clock {
    ret Clock{ctx: (source)::ptr, now: manual_now, advance: manual_advance};
}

pub fun manual_ns(source: *ManualClock) u64 {
    ret atomic.load(?source.now_ns)::u64;
}

fun manual_now(context: ptr) time.Instant {
    ret clock.from_ns(manual_ns(context::*ManualClock));
}

fun manual_advance(context: ptr, ns: u64) {
    atomic.fetch_add(?(context::*ManualClock).now_ns, ns::i64);
}

# a request stop could not drain, and whether it was running or still queued
pub rec Outstanding {
    op:          disk.Op;
    name:        [disk.NAME_BYTES]u8;
    name_length: usize;
    running:     bool;
}

pub rec Worker {
    target:        *disk.Disk;
    lock:          mutex.Mutex;
    work:          condition.Condition;
    settled:       condition.Condition;
    head:          *disk.Request;
    tail:          *disk.Request;
    queued:        usize;
    capacity:      usize;
    streams:       usize;
    stream_limit:  usize;
    running:       bool;
    running_op:    disk.Op;
    running_name:  [disk.NAME_BYTES]u8;
    running_bytes: usize;
    completed:     u64;
    unwoken:       u64;
    stopping:      bool;
    exited:        bool;
    clock:         Clock;
    # fault injection for tests: a paused worker runs nothing until resumed,
    # and a delay passes on its clock before every request it runs
    paused:   bool;
    delay_ns: u64;
    thread:   thread.Thread;
    live:     bool;
}

pub fun idle() Worker {
    var worker: Worker;
    worker.target       = nil;
    worker.head         = nil;
    worker.tail         = nil;
    worker.queued       = 0;
    worker.capacity     = 0;
    worker.streams      = 0;
    worker.stream_limit = 0;
    worker.running      = false;
    worker.completed    = 0;
    worker.unwoken      = 0;
    worker.stopping     = false;
    worker.exited       = false;
    worker.clock        = monotonic();
    worker.paused       = false;
    worker.delay_ns     = 0;
    worker.live         = false;
    ret worker;
}

# start the thread that runs `target`'s requests. `streams` bounds the admitted
# streams, and `reserve` the requests outside any stream (removals, the purge)
# that may be queued beside them
pub fun start(worker: *Worker, target: *disk.Disk, streams: usize, reserve: usize) bool {
    if (worker == nil || worker.live || target == nil || streams == 0) { ret false; }
    @worker             = idle();
    worker.target       = target;
    worker.lock         = mutex.make();
    worker.work         = condition.make();
    worker.settled      = condition.make();
    worker.stream_limit = streams;
    worker.capacity     = streams + reserve;
    var config: thread.Config;
    thread.config_default(?config);
    config.name = "hedge-store";
    val spawned: thread.Operation = thread.spawn_with_config(run_worker, (worker)::*u8,
        ?config, ?worker.thread);
    if (sel spawned.err) { ret false; }
    worker.live = true;
    ret true;
}

# the executor that queues requests on this worker
pub fun executor(worker: *Worker) disk.Executor {
    ret disk.Executor{ctx: (worker)::ptr, submit: submit_queued, admit: admit_stream,
        leave: leave_stream};
}

fun submit_queued(context: ptr, request: *disk.Request) disk.Submitted {
    val worker: *Worker = context::*Worker;
    mutex.lock(?worker.lock);
    if (worker.exited || worker.queued >= worker.capacity) {
        mutex.unlock(?worker.lock);
        ret disk.SUBMIT_REFUSED;
    }
    request.next = nil;
    if (worker.tail == nil) { worker.head = request; }
    or                      { worker.tail.next = request; }
    worker.tail   = request;
    worker.queued = worker.queued + 1;
    condition.signal(?worker.work);
    mutex.unlock(?worker.lock);
    ret disk.SUBMIT_QUEUED;
}

fun admit_stream(context: ptr) bool {
    val worker: *Worker = context::*Worker;
    mutex.lock(?worker.lock);
    val admitted: bool = !worker.stopping && worker.streams < worker.stream_limit;
    if (admitted) { worker.streams = worker.streams + 1; }
    mutex.unlock(?worker.lock);
    ret admitted;
}

fun leave_stream(context: ptr) {
    val worker: *Worker = context::*Worker;
    mutex.lock(?worker.lock);
    if (worker.streams != 0) { worker.streams = worker.streams - 1; }
    mutex.unlock(?worker.lock);
}

fun copy_name(request: *disk.Request, output: *u8) usize {
    var i: usize = 0;
    for (i < request.name_length && i + 1 < disk.NAME_BYTES) {
        output[i] = request.name[i];
        i         = i + 1;
    }
    output[i] = 0;
    ret i;
}

fun run_worker(argument: *u8) {
    val worker: *Worker = argument::*Worker;
    mutex.lock(?worker.lock);
    for (true) {
        for ((worker.head == nil && !worker.stopping) || (worker.head != nil && worker.paused)) {
            condition.wait(?worker.work, ?worker.lock);
        }
        if (worker.head == nil) { brk; }
        val request: *disk.Request = worker.head;
        worker.head = request.next;
        if (worker.head == nil) { worker.tail = nil; }
        request.next         = nil;
        worker.queued        = worker.queued - 1;
        worker.running       = true;
        worker.running_op    = request.op;
        worker.running_bytes = copy_name(request, ?worker.running_name[0]);
        val delay_ns: u64   = worker.delay_ns;
        val keeper:   Clock = worker.clock;
        mutex.unlock(?worker.lock);
        if (delay_ns != 0) { keeper.advance(keeper.ctx, delay_ns); }
        disk.run(worker.target, request);
        # the request is its submitter's once this returns, so nothing here
        # reads it afterwards
        val reached: bool = disk.complete(request);
        mutex.lock(?worker.lock);
        if (!reached) { worker.unwoken = worker.unwoken + 1; }
        worker.running   = false;
        worker.completed = worker.completed + 1;
        condition.broadcast(?worker.settled);
    }
    worker.exited = true;
    condition.broadcast(?worker.settled);
    mutex.unlock(?worker.lock);
}

# admit no more streams, drain what is queued and join the thread. false once
# `timeout_ns` passes on the worker's clock with no request completing: the
# thread is left running what it holds, and `outstanding` names it
pub fun stop(worker: *Worker, timeout_ns: u64) bool {
    if (worker == nil || !worker.live) { ret true; }
    mutex.lock(?worker.lock);
    worker.stopping = true;
    condition.broadcast(?worker.work);
    val keeper:   Clock        = worker.clock;
    var seen:     u64          = worker.completed;
    var deadline: time.Instant = clock.after(keeper.now(keeper.ctx), timeout_ns);
    for (!worker.exited) {
        # with nothing left the thread is on its way out, which no timeout cuts
        if (worker.head == nil && !worker.running) {
            condition.wait(?worker.settled, ?worker.lock);
        }
        or {
            # the wait sleeps on the monotonic clock for what the worker's
            # clock has left, and the deadline is judged on the worker's
            val left: u64 = clock.between_ns(keeper.now(keeper.ctx), deadline);
            condition.wait_until(?worker.settled, ?worker.lock, clock.after(clock.instant(), left));
        }
        if (worker.completed != seen) {
            seen     = worker.completed;
            deadline = clock.after(keeper.now(keeper.ctx), timeout_ns);
        }
        or (!worker.exited && clock.between_ns(keeper.now(keeper.ctx), deadline) == 0) {
            mutex.unlock(?worker.lock);
            ret false;
        }
    }
    mutex.unlock(?worker.lock);
    val joined: thread.Operation = thread.join(?worker.thread);
    if (sel joined.err) { ret false; }
    worker.live = false;
    ret true;
}

# the requests still queued or running, at most `capacity` of them written to
# `output`. returns how many there are
pub fun outstanding(worker: *Worker, output: *Outstanding, capacity: usize) usize {
    if (worker == nil || !worker.live) { ret 0; }
    mutex.lock(?worker.lock);
    var count: usize = 0;
    if (worker.running) {
        if (output != nil && count < capacity) {
            output[count].op          = worker.running_op;
            output[count].running     = true;
            output[count].name_length = worker.running_bytes;
            var i: usize = 0;
            for (i <= worker.running_bytes && i < disk.NAME_BYTES) {
                output[count].name[i] = worker.running_name[i];
                i                     = i + 1;
            }
        }
        count = count + 1;
    }
    var request: *disk.Request = worker.head;
    for (request != nil) {
        if (output != nil && count < capacity) {
            output[count].op          = request.op;
            output[count].running     = false;
            output[count].name_length = copy_name(request, ?output[count].name[0]);
        }
        count   = count + 1;
        request = request.next;
    }
    mutex.unlock(?worker.lock);
    ret count;
}

# how many completions could not reach their submitter's thread and were
# published without waking it
pub fun unwoken(worker: *Worker) u64 {
    if (worker == nil || !worker.live) { ret 0; }
    mutex.lock(?worker.lock);
    val count: u64 = worker.unwoken;
    mutex.unlock(?worker.lock);
    ret count;
}

pub fun op_text(op: disk.Op) str {
    if (op == disk.READ)   { ret "read"; }
    if (op == disk.WRITE)  { ret "write"; }
    if (op == disk.UNLINK) { ret "unlink"; }
    if (op == disk.PURGE)  { ret "purge"; }
    ret "unknown";
}

# hold every request until `resume`, for tests of a disk that does not answer
pub fun pause(worker: *Worker) {
    if (worker == nil || !worker.live) { ret; }
    mutex.lock(?worker.lock);
    worker.paused = true;
    mutex.unlock(?worker.lock);
}

pub fun resume(worker: *Worker) {
    if (worker == nil || !worker.live) { ret; }
    mutex.lock(?worker.lock);
    worker.paused = false;
    condition.broadcast(?worker.work);
    mutex.unlock(?worker.lock);
}

# keep the worker's time on `source`, for tests that move time themselves.
# set before anything is submitted or stopped
pub fun keep_time(worker: *Worker, source: Clock) {
    if (worker == nil || !worker.live) { ret; }
    mutex.lock(?worker.lock);
    worker.clock = source;
    mutex.unlock(?worker.lock);
}

# let `delay_ns` pass on the worker's clock before every request, for tests of
# a slow disk
pub fun slow_down(worker: *Worker, delay_ns: u64) {
    if (worker == nil || !worker.live) { ret; }
    mutex.lock(?worker.lock);
    worker.delay_ns = delay_ns;
    mutex.unlock(?worker.lock);
}

fun ensure_dir(path: str) bool {
    val found: res[bool, io_error.Error] = filesystem.is_dir(path);
    if ((sel found.ok) && found.ok) { ret true; }
    val made: err[io_error.Error] = filesystem.create_dir(path, 493);
    ret sel made.ok;
}

fun open_disk(target: *disk.Disk, root: str, pages: *A.Allocator) bool {
    page.make(pages);
    @target = disk.closed();
    if (!ensure_dir("out") || !ensure_dir(root)) { ret false; }
    ret disk.open(target, root, pages);
}

fun request_for(op: disk.Op, name: str, data: *u8, length: usize) disk.Request {
    var request: disk.Request = disk.idle();
    request.op       = op;
    request.data     = data;
    request.length   = length;
    request.truncate = op == disk.WRITE;
    var count: usize = 0;
    for (name[count] != 0) { count = count + 1; }
    disk.set_name(?request, name::*u8, count);
    ret request;
}

test "store worker: requests run in order and each wakes its submitter on its own thread" {
    var pages:  A.Allocator;
    var target: disk.Disk;
    if (!open_disk(?target, "out/store-worker-order", ?pages)) { ret 1; }
    var runtime: io_runtime.Runtime;
    val made:    err[io_error.Error] = io_runtime.make(?runtime, ?pages, 8);
    if (sel made.err) { ret 2; }
    var queue: wake.Queue;
    if (!wake.make(?queue, ?pages) || !wake.attach_runtime(?queue, ?runtime)) { ret 3; }
    var worker: Worker = idle();
    if (!start(?worker, ?target, 2, 1) || !disk.use_executor(?target, executor(?worker))) { ret 4; }
    if (!disk.admit(?target))                                                             { ret 5; }
    var written: disk.Request = request_for(disk.WRITE, "order", "hello"::*u8, 5);
    var buffer:  [8]u8;
    var read:    disk.Request = request_for(disk.READ, "order", ?buffer[0], 5);
    written.waker = wake.waker(?queue, 1);
    read.waker    = wake.waker(?queue, 2);
    if (disk.submit(?target, ?written) != disk.SUBMIT_QUEUED
        || disk.submit(?target, ?read) != disk.SUBMIT_QUEUED) { ret 6; }
    var owners:      [4]u64;
    var seen:        usize = 0;
    var rounds:      usize = 0;
    var completions: [8]io_runtime.Completion;
    for (seen < 2 && rounds < 200) {
        # a completion is published on this thread only, when its wake is received
        if (disk.done(?read)) { ret 7; }
        val waited: res[usize, io_error.Error] = io_runtime.wait(?runtime, ?completions[0], 8, 50);
        if (sel waited.err)        { ret 8; }
        if (!wake.receive(?queue)) { ret 12; }
        var taken: [4]wake.Wake;
        val count: usize = wake.take(?queue, ?taken[0], 4);
        var i:     usize = 0;
        for (i < count && seen < 4) {
            owners[seen] = taken[i].owner;
            seen         = seen + 1;
            i            = i + 1;
        }
        rounds = rounds + 1;
    }
    if (seen != 2 || owners[0] != 1 || owners[1] != 2) { ret 9; }
    if (!disk.done(?written) || !written.ok || !disk.done(?read) || !read.ok
        || read.produced != 5 || buffer[0] != 'h' || buffer[4] != 'o') { ret 10; }
    disk.leave(?target);
    if (!stop(?worker, 1000000000)) { ret 11; }
    wake.detach_runtime(?queue);
    wake.destroy(?queue);
    io_runtime.destroy(?runtime);
    disk.close(?target);
    ret 0;
}

test "store worker: a full queue refuses a stream, and a queued request is never lost" {
    var pages:  A.Allocator;
    var target: disk.Disk;
    if (!open_disk(?target, "out/store-worker-full", ?pages)) { ret 1; }
    var worker: Worker = idle();
    if (!start(?worker, ?target, 1, 0) || !disk.use_executor(?target, executor(?worker))) { ret 2; }
    if (!disk.admit(?target))                                                             { ret 3; }
    # the only stream is taken, so the next is refused until it leaves
    if (disk.admit(?target)) { ret 4; }
    disk.leave(?target);
    if (!disk.admit(?target)) { ret 5; }
    pause(?worker);
    var first:  disk.Request = request_for(disk.WRITE, "full", "a"::*u8, 1);
    var second: disk.Request = request_for(disk.WRITE, "full", "b"::*u8, 1);
    if (disk.submit(?target, ?first) != disk.SUBMIT_QUEUED) { ret 6; }
    # past the bound a request is refused and left idle, for its caller to reuse
    if (disk.submit(?target, ?second) != disk.SUBMIT_REFUSED || disk.in_flight(?second)) { ret 7; }
    resume(?worker);
    disk.leave(?target);
    if (!stop(?worker, 1000000000))      { ret 8; }
    if (!disk.done(?first) || !first.ok) { ret 9; }
    disk.close(?target);
    ret 0;
}

test "store worker: stop drains a slow queue and names what a paused one holds" {
    var pages:  A.Allocator;
    var target: disk.Disk;
    if (!open_disk(?target, "out/store-worker-stop", ?pages)) { ret 1; }
    var worker: Worker = idle();
    if (!start(?worker, ?target, 4, 4) || !disk.use_executor(?target, executor(?worker))) { ret 2; }
    # each request takes 150 ms on the worker's clock, which moves only when a
    # request does, so the margin under the timeout is exact whatever the load
    var ticks: ManualClock = manual_clock();
    keep_time(?worker, manual(?ticks));
    slow_down(?worker, 150000000);
    var writes: [3]disk.Request;
    writes[0] = request_for(disk.WRITE, "slow-0", "x"::*u8, 1);
    writes[1] = request_for(disk.WRITE, "slow-1", "x"::*u8, 1);
    writes[2] = request_for(disk.WRITE, "slow-2", "x"::*u8, 1);
    var i: usize = 0;
    for (i < 3) {
        if (disk.submit(?target, ?writes[i]) != disk.SUBMIT_QUEUED) { ret 3; }
        i = i + 1;
    }
    # each request completes inside the timeout, so the whole queue drains
    # though together they take longer than it
    if (!stop(?worker, 200000000)) { ret 4; }
    i = 0;
    for (i < 3) {
        if (!disk.done(?writes[i]) || !writes[i].ok) { ret 5; }
        i = i + 1;
    }
    if (manual_ns(?ticks) != 450000000) { ret 14; }
    var held: Worker = idle();
    if (!start(?held, ?target, 4, 4) || !disk.use_executor(?target, executor(?held))) { ret 6; }
    pause(?held);
    var buffer: [4]u8;
    var read:   disk.Request = request_for(disk.READ, "slow-0", ?buffer[0], 1);
    var remove: disk.Request = request_for(disk.UNLINK, "slow-1", nil, 0);
    if (disk.submit(?target, ?read) != disk.SUBMIT_QUEUED
        || disk.submit(?target, ?remove) != disk.SUBMIT_QUEUED) { ret 7; }
    if (stop(?held, 20000000)) { ret 8; }
    # a stopping worker admits no new stream
    if (disk.admit(?target)) { ret 9; }
    var named: [4]Outstanding;
    if (outstanding(?held, ?named[0], 4) != 2) { ret 10; }
    if (named[0].op != disk.READ || named[0].running || named[0].name_length != 6
        || named[0].name[5] != '0' || named[1].op != disk.UNLINK || named[1].name[5] != '1') { ret 11; }
    resume(?held);
    if (!stop(?held, 1000000000))                                                               { ret 12; }
    if (!disk.done(?read) || !read.ok || buffer[0] != 'x' || !disk.done(?remove) || !remove.ok) { ret 13; }
    disk.close(?target);
    ret 0;
}
