# cache keys and selected representation dimensions
#
# A key names one target. The `Vary` dimensions name which representation of that
# target a stored response is, and a stored response answers a request only when
# every dimension matches. Comparing the key alone is representation confusion:
# the next client would be served a representation negotiated for someone else.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;
use http.core.field;
use http.core.message;
use http.core.method;

pub val MAX_KEY_BYTES: usize = 512;
pub val MAX_DIMENSIONS: usize = 8;
pub val MAX_DIMENSION_NAME: usize = 64;
pub val MAX_DIMENSION_VALUE: usize = 256;

pub rec Key {
    bytes: [MAX_KEY_BYTES]u8;
    length: usize;
    valid: bool;
}

# one selecting header field name and the value the stored representation was
# negotiated for
pub rec Dimension {
    name: [MAX_DIMENSION_NAME]u8;
    name_length: usize;
    value: [MAX_DIMENSION_VALUE]u8;
    value_length: usize;
    absent: bool;
}

pub rec Dimensions {
    items: [MAX_DIMENSIONS]Dimension;
    len: usize;
    any: bool;
    valid: bool;
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun push(output: *Key, c: u8) bool {
    if (output.length >= MAX_KEY_BYTES) {
        output.valid = false;
        ret false;
    }
    output.bytes[output.length] = c;
    output.length = output.length + 1;
    ret true;
}

fun push_view(output: *Key, value: view.View) bool {
    var i: usize = 0;
    for (i < value.len) {
        if (!push(output, value.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun push_text(output: *Key, value: str) bool {
    var i: usize = 0;
    for (value[i] != 0) {
        if (!push(output, value[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun request_authority(request: *message.Request) view.View {
    if (request.target.authority.len != 0) { ret request.target.authority; }
    val host: *field.Field = field.find_first(?request.fields, view.view("host", 4));
    if (host == nil) { ret view.view(nil, 0); }
    ret host.value;
}

# `<method> <scheme>://<authority><path>?<query>`
#
# invalidation needs the keys a GET and a HEAD would have used, even though the
# request doing the invalidating is neither, so the method is a parameter rather
# than being read off the request.
pub fun make_with_method(request: *message.Request, secure: bool, kind_value: method.Kind,
    output: *Key) bool {
    if (request == nil || output == nil) { ret false; }
    output.length = 0;
    output.valid = true;
    val authority: view.View = request_authority(request);
    if (authority.len == 0) {
        output.valid = false;
        ret false;
    }
    var kind: str = "GET";
    if (kind_value == method.HEAD) { kind = "HEAD"; }
    or (kind_value != method.GET) {
        output.valid = false;
        ret false;
    }
    if (!push_text(output, kind) || !push(output, ' ')) { ret false; }
    if (secure) {
        if (!push_text(output, "https://")) { ret false; }
    } or {
        if (!push_text(output, "http://")) { ret false; }
    }
    var i: usize = 0;
    for (i < authority.len) {
        if (!push(output, lower(authority.data[i]))) { ret false; }
        i = i + 1;
    }
    if (!push_view(output, request.target.path)) { ret false; }
    if (request.target.query.len != 0) {
        if (!push(output, '?') || !push_view(output, request.target.query)) { ret false; }
    }
    ret output.valid;
}

# the key this request's own method would store under
pub fun make(request: *message.Request, secure: bool, output: *Key) bool {
    if (request == nil) { ret false; }
    ret make_with_method(request, secure, request.method.kind, output);
}

pub fun equal(a: *Key, b: *Key) bool {
    if (a == nil || b == nil || !a.valid || !b.valid || a.length != b.length) { ret false; }
    var i: usize = 0;
    for (i < a.length) {
        if (a.bytes[i] != b.bytes[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun set_name(item: *Dimension, source: view.View, start: usize, end: usize) bool {
    if (end - start == 0 || end - start > MAX_DIMENSION_NAME) { ret false; }
    var i: usize = 0;
    for (start + i < end) {
        item.name[i] = lower(source.data[start + i]);
        i = i + 1;
    }
    item.name_length = end - start;
    ret true;
}

fun set_value(item: *Dimension, value: view.View) bool {
    if (value.len > MAX_DIMENSION_VALUE) { ret false; }
    item.absent = value.data == nil;
    item.value_length = value.len;
    var i: usize = 0;
    for (i < value.len) {
        item.value[i] = value.data[i];
        i = i + 1;
    }
    ret true;
}

fun request_field(request: *message.Request, item: *Dimension) view.View {
    var name: view.View = view.view(?item.name[0], item.name_length);
    val found: *field.Field = field.find_first(?request.fields, name);
    if (found == nil) { ret view.view(nil, 0); }
    ret found.value;
}

fun already_present(output: *Dimensions, source: view.View, start: usize, end: usize) bool {
    var i: usize = 0;
    for (i < output.len) {
        val item: *Dimension = ?output.items[i];
        if (item.name_length == end - start) {
            var matched: bool = true;
            var j: usize = 0;
            for (j < item.name_length) {
                if (item.name[j] != lower(source.data[start + j])) { matched = false; }
                j = j + 1;
            }
            if (matched) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# read the response's `Vary` and capture the request values it selects on
pub fun select(request: *message.Request, response_fields: *field.Fields,
    output: *Dimensions) bool {
    if (request == nil || output == nil) { ret false; }
    output.len = 0;
    output.any = false;
    output.valid = true;
    if (response_fields == nil || response_fields.items == nil) { ret true; }
    var f: usize = 0;
    for (f < response_fields.len) {
        val item: *field.Field = ?response_fields.items[f];
        var is_vary: bool = item.name.len == 4;
        if (is_vary) {
            val expected: str = "vary";
            var j: usize = 0;
            for (j < 4) {
                if (lower(item.name.data[j]) != expected[j]) { is_vary = false; }
                j = j + 1;
            }
        }
        if (is_vary) {
            val list: view.View = item.value;
            var start: usize = 0;
            var i: usize = 0;
            for (i <= list.len) {
                if (i == list.len || list.data[i] == ',') {
                    var from: usize = start;
                    var to: usize = i;
                    for (from < to && (list.data[from] == ' ' || list.data[from] == '\t')) {
                        from = from + 1;
                    }
                    for (to > from && (list.data[to - 1] == ' ' || list.data[to - 1] == '\t')) {
                        to = to - 1;
                    }
                    if (to > from) {
                        if (to - from == 1 && list.data[from] == '*') {
                            output.any = true;
                            output.valid = false;
                            ret true;
                        }
                        if (!already_present(output, list, from, to)) {
                            if (output.len >= MAX_DIMENSIONS) {
                                output.valid = false;
                                ret true;
                            }
                            val slot: *Dimension = ?output.items[output.len];
                            if (!set_name(slot, list, from, to)) {
                                output.valid = false;
                                ret true;
                            }
                            if (!set_value(slot, request_field(request, slot))) {
                                output.valid = false;
                                ret true;
                            }
                            output.len = output.len + 1;
                        }
                    }
                    start = i + 1;
                }
                i = i + 1;
            }
        }
        f = f + 1;
    }
    ret true;
}

# do two stored representations select on the same fields with the same values
#
# a new response replaces a stored one only when it is the same representation of
# the same target, so the comparison is over both the names and the values.
pub fun dimensions_equal(a: *Dimensions, b: *Dimensions) bool {
    if (a == nil || b == nil || !a.valid || !b.valid || a.any || b.any) { ret false; }
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        val left: *Dimension = ?a.items[i];
        var found: bool = false;
        var j: usize = 0;
        for (j < b.len) {
            val right: *Dimension = ?b.items[j];
            if (right.name_length == left.name_length) {
                var same_name: bool = true;
                var k: usize = 0;
                for (k < left.name_length) {
                    if (left.name[k] != right.name[k]) { same_name = false; }
                    k = k + 1;
                }
                if (same_name) {
                    if (right.absent != left.absent
                     || right.value_length != left.value_length) { ret false; }
                    var v: usize = 0;
                    for (v < left.value_length) {
                        if (left.value[v] != right.value[v]) { ret false; }
                        v = v + 1;
                    }
                    found = true;
                }
            }
            j = j + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

# does this request negotiate to the same representation the stored one did
pub fun matches(stored: *Dimensions, request: *message.Request) bool {
    if (stored == nil || request == nil || !stored.valid || stored.any) { ret false; }
    var i: usize = 0;
    for (i < stored.len) {
        val item: *Dimension = ?stored.items[i];
        val current: view.View = request_field(request, item);
        if ((current.data == nil) != item.absent) { ret false; }
        if (current.len != item.value_length) { ret false; }
        var j: usize = 0;
        for (j < current.len) {
            if (current.data[j] != item.value[j]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun test_request(request: *message.Request, items: *field.Field, capacity: usize,
    path: str, host: str) {
    request.method = method.from_kind(method.GET);
    request.fields = field.init(items, capacity, field.limits(capacity, 1024, 64, 256));
    field.append(?request.fields, field.Field{
        name: view.view("host", 4),
        value: view.view(host, str_len(host)),
        sensitive: false,
    });
    request.target.path = view.view(path, str_len(path));
    request.target.query = view.view(nil, 0);
    request.target.authority = view.view(nil, 0);
}

fun add(fields: *field.Fields, name: str, value: str) {
    field.append(fields, field.Field{
        name: view.view(name, str_len(name)),
        value: view.view(value, str_len(value)),
        sensitive: false,
    });
}

test "cache key: the key covers method, scheme, authority, path, and query" {
    var items: [4]field.Field;
    var request: message.Request;
    test_request(?request, ?items[0], 4, "/a", "Example.Test");
    var key: Key;
    if (!make(?request, false, ?key)) { ret 1; }
    if (!view.view_eq_str(view.view(?key.bytes[0], key.length), "GET http://example.test/a")) { ret 2; }
    # the scheme is part of the key, so a secure request cannot read a cleartext entry
    var secure_key: Key;
    if (!make(?request, true, ?secure_key) || equal(?key, ?secure_key)) { ret 3; }
    request.target.query = view.view("b=1", 3);
    var query_key: Key;
    if (!make(?request, false, ?query_key) || equal(?key, ?query_key)) { ret 4; }
    if (!view.view_eq_str(view.view(?query_key.bytes[0], query_key.length),
        "GET http://example.test/a?b=1")) { ret 5; }
    ret 0;
}

test "cache key: a method the cache does not store has no key" {
    var items: [4]field.Field;
    var request: message.Request;
    test_request(?request, ?items[0], 4, "/a", "example.test");
    request.method = method.from_kind(method.POST);
    var key: Key;
    if (make(?request, false, ?key) || key.valid) { ret 1; }
    # HEAD keys separately from GET, because their stored representations differ
    request.method = method.from_kind(method.HEAD);
    var head_key: Key;
    if (!make(?request, false, ?head_key)) { ret 2; }
    request.method = method.from_kind(method.GET);
    var get_key: Key;
    if (!make(?request, false, ?get_key) || equal(?head_key, ?get_key)) { ret 3; }
    ret 0;
}

test "cache key: a request with no authority has no key" {
    var items: [1]field.Field;
    var request: message.Request;
    request.method = method.from_kind(method.GET);
    request.fields = field.init(?items[0], 1, field.limits(1, 128, 32, 64));
    request.target.path = view.view("/a", 2);
    request.target.query = view.view(nil, 0);
    request.target.authority = view.view(nil, 0);
    var key: Key;
    if (make(?request, false, ?key) || key.valid) { ret 1; }
    ret 0;
}

test "cache key: an oversized target is refused rather than truncated" {
    var items: [2]field.Field;
    var request: message.Request;
    test_request(?request, ?items[0], 2, "/a", "example.test");
    var long_path: [MAX_KEY_BYTES + 64]u8;
    var i: usize = 0;
    for (i < MAX_KEY_BYTES + 63) { long_path[i] = 'x'; i = i + 1; }
    long_path[0] = '/';
    request.target.path = view.view(?long_path[0], MAX_KEY_BYTES + 63);
    var key: Key;
    if (make(?request, false, ?key) || key.valid) { ret 1; }
    ret 0;
}

test "cache dimensions: a stored representation only answers a matching negotiation" {
    var request_items: [4]field.Field;
    var request: message.Request;
    test_request(?request, ?request_items[0], 4, "/a", "example.test");
    add(?request.fields, "accept-encoding", "gzip");
    var response_items: [2]field.Field;
    var response_fields: field.Fields = field.init(?response_items[0], 2,
        field.limits(2, 512, 64, 256));
    add(?response_fields, "vary", "Accept-Encoding");
    var stored: Dimensions;
    if (!select(?request, ?response_fields, ?stored) || !stored.valid) { ret 1; }
    if (stored.len != 1 || stored.items[0].name_length != 15) { ret 2; }
    if (!matches(?stored, ?request)) { ret 3; }
    # a client that negotiates differently must not receive this representation
    var other_items: [4]field.Field;
    var other: message.Request;
    test_request(?other, ?other_items[0], 4, "/a", "example.test");
    add(?other.fields, "accept-encoding", "br");
    if (matches(?stored, ?other)) { ret 4; }
    # nor may a client that sends no such header at all
    var bare_items: [4]field.Field;
    var bare: message.Request;
    test_request(?bare, ?bare_items[0], 4, "/a", "example.test");
    if (matches(?stored, ?bare)) { ret 5; }
    ret 0;
}

test "cache dimensions: an absent selecting field is itself a dimension value" {
    var request_items: [2]field.Field;
    var request: message.Request;
    test_request(?request, ?request_items[0], 2, "/a", "example.test");
    var response_items: [1]field.Field;
    var response_fields: field.Fields = field.init(?response_items[0], 1,
        field.limits(1, 512, 64, 256));
    add(?response_fields, "vary", "accept-language");
    var stored: Dimensions;
    if (!select(?request, ?response_fields, ?stored)) { ret 1; }
    if (stored.len != 1 || !stored.items[0].absent) { ret 2; }
    if (!matches(?stored, ?request)) { ret 3; }
    var present_items: [3]field.Field;
    var with_value: message.Request;
    test_request(?with_value, ?present_items[0], 3, "/a", "example.test");
    add(?with_value.fields, "accept-language", "en");
    if (matches(?stored, ?with_value)) { ret 4; }
    ret 0;
}

test "cache dimensions: Vary any never matches anything" {
    var request_items: [2]field.Field;
    var request: message.Request;
    test_request(?request, ?request_items[0], 2, "/a", "example.test");
    var response_items: [1]field.Field;
    var response_fields: field.Fields = field.init(?response_items[0], 1,
        field.limits(1, 512, 64, 256));
    add(?response_fields, "vary", "*");
    var stored: Dimensions;
    select(?request, ?response_fields, ?stored);
    if (!stored.any || stored.valid) { ret 1; }
    if (matches(?stored, ?request)) { ret 2; }
    ret 0;
}

test "cache dimensions: more dimensions than the bound leaves the entry unusable" {
    var request_items: [12]field.Field;
    var request: message.Request;
    test_request(?request, ?request_items[0], 12, "/a", "example.test");
    var response_items: [1]field.Field;
    var response_fields: field.Fields = field.init(?response_items[0], 1,
        field.limits(1, 512, 64, 512));
    add(?response_fields, "vary", "a,b,c,d,e,f,g,h,i,j");
    var stored: Dimensions;
    select(?request, ?response_fields, ?stored);
    if (stored.valid) { ret 1; }
    if (matches(?stored, ?request)) { ret 2; }
    ret 0;
}
