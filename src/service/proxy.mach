# the reverse proxy service
#
# Policy lives here: which upstream answers, whether an attempt may be replayed,
# how much of the request deadline one attempt may spend, and what crosses the
# hop. The transport is one upstream link running the same HTTP/1 engine the
# served side runs.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.view;
use std.allocator;
use std.chrono.time;
use std.sync.cancel;
use std.net.ip;
use net_async: std.net.async;
use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use engine_h1: http.h1.connection;
use http.h1.parser;
use hedge.config.schema;
use hedge.service;
use call: hedge.dispatch.call;
use upstream: hedge.proxy.upstream;
use forward: hedge.proxy.forward;
use link: hedge.proxy.link;

pub val MAX_LINKS: usize = 8;
pub val MAX_ROUTES: usize = 16;
pub val OUTBOUND_FIELDS: usize = 64;
pub val STAGE_BYTES: usize = 8192;

# an attempt never receives the whole request deadline: the remainder has to
# cover the retry, the response, and writing it back to the client
pub val ATTEMPT_NUMERATOR: u64 = 1;
pub val ATTEMPT_DENOMINATOR: u64 = 2;
pub val MIN_ATTEMPT_NS: u64 = 100000000;

pub def Phase: u8;
pub val PHASE_SELECT: Phase = 1;
pub val PHASE_CONNECT: Phase = 2;
pub val PHASE_SEND: Phase = 3;
pub val PHASE_STREAM: Phase = 4;
pub val PHASE_SETTLED: Phase = 5;

# per-request proxy state, leased from the generation's bounded pool
pub rec Attempt {
    live: bool;
    phase: Phase;
    route: *Route;
    selection: upstream.Selection;
    link: *link.Link;
    attempts: usize;
    replay: forward.Replay;
    has_deadline: bool;
    attempt_deadline: time.Time;
    attempt_scope: cancel.Scope;
    scope_live: bool;
    outbound: field.Fields;
    outbound_items: [OUTBOUND_FIELDS]field.Field;
    forwarded: [forward.MAX_FORWARDED_BYTES]u8;
    via: [64]u8;
    authority: [128]u8;
    stage: [STAGE_BYTES]u8;
    stage_length: usize;
    stage_offset: usize;
    complete: bool;
    body: ResponseBody;
    owner: *Runtime;
    registry: *Registry;
    owner_call: *call.Call;
    owner_generation: u64;
}

# a response body reader that pulls from the upstream link
rec ResponseBody {
    attempt: *Attempt;
    reader: body.Reader;
    pending_token: u64;
    next_token: u64;
}

pub rec Route {
    name: str;
    pool: upstream.Pool;
    items: [upstream.MAX_UPSTREAMS]upstream.Upstream;
    authorities: [upstream.MAX_UPSTREAMS][64]u8;
    max_attempts: usize;
    live: bool;
}

# route state owned by one service generation
pub rec Registry {
    routes: [MAX_ROUTES]Route;
    len: usize;
    generation: u64;
}

pub rec Runtime {
    driver: *net_async.Driver;
    pseudonym: str;
    links: [MAX_LINKS]link.Link;
    link_registries: [MAX_LINKS]*Registry;
    attempts: [MAX_LINKS]Attempt;
    engine: engine_h1.Config;
    limits: upstream.Limits;
    total_attempts: u64;
    total_failures: u64;
    total_served: u64;
    total_reused: u64;
    live: bool;
}

pub fun make_runtime(runtime: *Runtime, driver: *net_async.Driver, pseudonym: str,
    engine: engine_h1.Config, limits: upstream.Limits) bool {
    if (runtime == nil || pseudonym == nil) { ret false; }
    runtime.driver = driver;
    runtime.pseudonym = pseudonym;
    runtime.engine = engine;
    runtime.limits = limits;
    runtime.total_attempts = 0;
    runtime.total_failures = 0;
    runtime.total_served = 0;
    runtime.total_reused = 0;
    var i: usize = 0;
    for (i < MAX_LINKS) {
        runtime.links[i].state = link.FREE;
        runtime.links[i].leased = false;
        runtime.links[i].generation = 0;
        runtime.link_registries[i] = nil;
        runtime.attempts[i].live = false;
        runtime.attempts[i].registry = nil;
        i = i + 1;
    }
    runtime.live = true;
    ret true;
}

# the network driver belongs to the listener plane and only exists once listeners
# are ready, so it is attached after the plan is sealed rather than during it
pub fun attach_driver(runtime: *Runtime, driver: *net_async.Driver) bool {
    if (runtime == nil || driver == nil) { ret false; }
    runtime.driver = driver;
    ret true;
}

pub fun close_runtime(runtime: *Runtime) bool {
    if (runtime == nil) { ret false; }
    var i: usize = 0;
    for (i < MAX_LINKS) {
        if (runtime.links[i].state != link.FREE) { link.close(?runtime.links[i]); }
        runtime.link_registries[i] = nil;
        runtime.attempts[i].live = false;
        runtime.attempts[i].registry = nil;
        i = i + 1;
    }
    runtime.live = false;
    ret true;
}

pub fun make_registry(registry: *Registry, generation: u64) bool {
    if (registry == nil || generation == 0) { ret false; }
    registry.len = 0;
    registry.generation = generation;
    ret true;
}

pub fun close_registry(runtime: *Runtime, registry: *Registry) bool {
    if (runtime == nil || registry == nil || registry.generation == 0) { ret false; }
    var i: usize = 0;
    for (i < MAX_LINKS) {
        if (runtime.attempts[i].live && runtime.attempts[i].registry == registry) {
            ret false;
        }
        if (runtime.link_registries[i] == registry
         && runtime.links[i].state != link.FREE
         && runtime.links[i].state != link.IDLE) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < MAX_LINKS) {
        if (runtime.link_registries[i] == registry) {
            if (runtime.links[i].state != link.FREE) { link.close(?runtime.links[i]); }
            runtime.link_registries[i] = nil;
        }
        i = i + 1;
    }
    registry.len = 0;
    registry.generation = 0;
    ret true;
}

pub fun route_count(registry: *Registry) usize {
    if (registry == nil || registry.generation == 0) { ret 0; }
    ret registry.len;
}

# the proxy owns its links, so they are driven every round rather than only while
# a served request happens to be waiting on one. a response body still needs the
# upstream pumped long after the response head was committed.
pub fun poll(context: ptr, now: time.Time) bool {
    val runtime: *Runtime = context::*Runtime;
    if (runtime == nil || !runtime.live) { ret false; }
    var progressed: bool = false;
    var i: usize = 0;
    for (i < MAX_LINKS) {
        val current: *link.Link = ?runtime.links[i];
        if (current.state == link.FREE) { i = i + 1; cnt; }
        var steps: usize = 0;
        for (steps < 16) {
            val progress: link.Step = link.step(current, now);
            if (progress != link.STEP_PROGRESS && progress != link.STEP_HEADERS) { brk; }
            progressed = true;
            steps = steps + 1;
        }
        i = i + 1;
    }
    # an attempt whose response body has finished releases its link and its slot
    i = 0;
    for (i < MAX_LINKS) {
        val attempt: *Attempt = ?runtime.attempts[i];
        if (attempt.live && attempt.phase == PHASE_STREAM && attempt.link != nil
         && body.reader_terminal_state(?attempt.body.reader)) {
            if (!link.release_idle(attempt.link, now)) { link.close(attempt.link); }
            attempt.link = nil;
            attempt.live = false;
            progressed = true;
        }
        i = i + 1;
    }
    ret progressed;
}

fun free_attempt(runtime: *Runtime) *Attempt {
    var i: usize = 0;
    for (i < MAX_LINKS) {
        if (!runtime.attempts[i].live) { ret ?runtime.attempts[i]; }
        i = i + 1;
    }
    ret nil;
}

# prefer an idle connection to the chosen upstream before opening a new one
fun acquire_link(runtime: *Runtime, registry: *Registry, upstream_index: usize) *link.Link {
    var i: usize = 0;
    for (i < MAX_LINKS) {
        if (runtime.link_registries[i] == registry
         && link.idle_for(?runtime.links[i], upstream_index)
         && link.lease(?runtime.links[i])) {
            runtime.total_reused = runtime.total_reused + 1;
            ret ?runtime.links[i];
        }
        i = i + 1;
    }
    i = 0;
    for (i < MAX_LINKS) {
        if (link.free(?runtime.links[i])) {
            runtime.link_registries[i] = registry;
            ret ?runtime.links[i];
        }
        i = i + 1;
    }
    # every slot is busy or held idle for another upstream; retire one idle slot
    i = 0;
    for (i < MAX_LINKS) {
        if (runtime.links[i].state == link.IDLE && !runtime.links[i].leased) {
            link.close(?runtime.links[i]);
            runtime.link_registries[i] = registry;
            ret ?runtime.links[i];
        }
        i = i + 1;
    }
    ret nil;
}

# --- response body over the upstream link ---

fun upstream_read(context: ptr, output: *u8, capacity: usize, trailers: *field.Fields) body.Progress {
    val state: *ResponseBody = context::*ResponseBody;
    if (state == nil || state.attempt == nil || state.attempt.link == nil) {
        ret body.failed("proxy response body has no upstream", body.REUSE_FORBIDDEN);
    }
    var produced: usize = 0;
    var complete: bool = false;
    if (!link.take_body(state.attempt.link, output, capacity, ?produced, ?complete)) {
        ret body.failed("upstream body could not be consumed", body.REUSE_FORBIDDEN);
    }
    if (produced != 0) { ret body.data(produced); }
    if (complete) { ret body.complete(body.REUSE_ALLOWED); }
    if (state.attempt.link.state == link.FAILED) {
        ret body.failed("upstream ended before its declared length", body.REUSE_FORBIDDEN);
    }
    state.next_token = state.next_token + 1;
    state.pending_token = state.next_token;
    ret body.pending(state.pending_token);
}

fun upstream_finish(context: ptr, mode: body.Mode, trailers: *field.Fields) body.Progress {
    val state: *ResponseBody = context::*ResponseBody;
    if (state == nil) { ret body.failed("proxy response body has no state", body.REUSE_FORBIDDEN); }
    if (mode == body.CANCEL) { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT) { ret body.rejected(body.REUSE_FORBIDDEN); }
    ret body.complete(body.REUSE_ALLOWED);
}

fun upstream_complete(context: ptr, token: u64, trailers: *field.Fields) body.Progress {
    val state: *ResponseBody = context::*ResponseBody;
    if (state == nil || token != state.pending_token) {
        ret body.failed("unknown proxy body completion", body.REUSE_FORBIDDEN);
    }
    state.pending_token = 0;
    ret upstream_read(context, nil, 0, trailers);
}

fun upstream_release(context: ptr) {
}

# --- deadlines ---

fun add_ns(base: time.Time, nanos: u64) time.Time {
    var result: time.Time = base;
    result.sec = base.sec + (nanos / 1000000000)::i64;
    result.nsec = base.nsec + (nanos % 1000000000)::i64;
    if (result.nsec >= 1000000000) {
        result.nsec = result.nsec - 1000000000;
        result.sec = result.sec + 1;
    }
    ret result;
}

fun remaining_ns(now: time.Time, deadline: time.Time) u64 {
    if (deadline.sec < now.sec || (deadline.sec == now.sec && deadline.nsec <= now.nsec)) {
        ret 0;
    }
    val seconds: i64 = deadline.sec - now.sec;
    if (seconds > 9223372035) { ret 0xffffffffffffffff; }
    ret (seconds * 1000000000 + (deadline.nsec - now.nsec))::u64;
}

# one attempt gets a child of the request deadline, never a fresh full one
pub fun attempt_deadline(now: time.Time, has_request_deadline: bool,
    request_deadline: time.Time, output: *time.Time) bool {
    if (output == nil) { ret false; }
    if (!has_request_deadline) { ret false; }
    val remaining: u64 = remaining_ns(now, request_deadline);
    if (remaining == 0) { ret false; }
    var share: u64 = remaining / ATTEMPT_DENOMINATOR * ATTEMPT_NUMERATOR;
    if (share < MIN_ATTEMPT_NS) { share = remaining; }
    if (share > remaining) { share = remaining; }
    @output = add_ns(now, share);
    ret true;
}

# --- the handler ---

fun bad_gateway(active: *call.Call, code: status.Status) exchange.ServiceStatus {
    ret service.respond(active, code);
}

fun peer_text(active: *call.Call) view.View {
    ret call.request(active).metadata.peer.address;
}

fun host_text(active: *call.Call) view.View {
    val found: *field.Field = field.find_first(?call.request(active).fields,
        view.view("host", 4));
    if (found == nil) { ret view.view(nil, 0); }
    ret found.value;
}

fun build_outbound(attempt: *Attempt, active: *call.Call, runtime: *Runtime,
    authority: str) bool {
    val request: *message.Request = call.request(active);
    val configured: message.Limits = call.limits(active);
    attempt.outbound = field.init(?attempt.outbound_items[0], OUTBOUND_FIELDS,
        configured.request_fields);
    if (!attempt.outbound.valid) { ret false; }
    # the next hop's authority is this proxy's decision, not the client's header
    if (field.append(?attempt.outbound, field.Field{
        name: view.view("host", 4),
        value: view.view(authority, str_len(authority)),
        sensitive: false,
    }) != field.ADD_OK) { ret false; }
    if (!forward.copy_fields(?request.fields, ?attempt.outbound)) { ret false; }
    val peer: forward.Peer = forward.Peer{
        address: peer_text(active),
        secure: request.metadata.secure,
        host: host_text(active),
    };
    val forwarded: usize = forward.format_forwarded(peer, ?attempt.forwarded[0],
        forward.MAX_FORWARDED_BYTES);
    if (forwarded != 0) {
        if (field.append(?attempt.outbound, field.Field{
            name: view.view("forwarded", 9),
            value: view.view(?attempt.forwarded[0], forwarded),
            sensitive: false,
        }) != field.ADD_OK) { ret false; }
    }
    val via: usize = forward.format_via(request.metadata.version, runtime.pseudonym,
        ?attempt.via[0], 64);
    if (via != 0) {
        if (field.append(?attempt.outbound, field.Field{
            name: view.view("via", 3),
            value: view.view(?attempt.via[0], via),
            sensitive: false,
        }) != field.ADD_OK) { ret false; }
    }
    ret true;
}

fun begin_attempt(attempt: *Attempt, active: *call.Call, runtime: *Runtime,
    now: time.Time) exchange.ServiceStatus {
    val selection: upstream.Selection = upstream.select(?attempt.route.pool, now);
    if (selection.admission == upstream.ROUTE_SATURATED) {
        ret bad_gateway(active, status.SERVICE_UNAVAILABLE);
    }
    if (selection.admission != upstream.ADMITTED) {
        ret bad_gateway(active, status.BAD_GATEWAY);
    }
    attempt.selection = selection;
    attempt.attempts = attempt.attempts + 1;
    runtime.total_attempts = runtime.total_attempts + 1;
    val chosen: *upstream.Upstream = ?attempt.route.pool.items[selection.index];
    attempt.link = acquire_link(runtime, attempt.registry, selection.index);
    if (attempt.link == nil) {
        upstream.release(?attempt.route.pool, selection.index, upstream.FAILURE, now);
        ret bad_gateway(active, status.SERVICE_UNAVAILABLE);
    }
    if (!build_outbound(attempt, active, runtime, chosen.authority)) {
        upstream.release(?attempt.route.pool, selection.index, upstream.FAILURE, now);
        attempt.link = nil;
        ret bad_gateway(active, status.BAD_GATEWAY);
    }
    if (attempt.link.state != link.READY
     && !link.make(attempt.link, runtime.driver, selection.index, chosen.endpoint,
        runtime.engine, now)) {
        link.close(attempt.link);
        attempt.link = nil;
        upstream.release(?attempt.route.pool, selection.index, upstream.FAILURE, now);
        ret bad_gateway(active, status.BAD_GATEWAY);
    }
    attempt.phase = PHASE_CONNECT;
    ret exchange.SERVICE_PENDING;
}

fun settle_attempt(attempt: *Attempt, outcome: upstream.Outcome, now: time.Time) {
    if (outcome != upstream.SUCCESS && attempt.owner != nil) {
        attempt.owner.total_failures = attempt.owner.total_failures + 1;
    }
    if (attempt.selection.admission == upstream.ADMITTED) {
        upstream.release(?attempt.route.pool, attempt.selection.index, outcome, now);
        attempt.selection.admission = upstream.NO_UPSTREAM;
    }
    if (attempt.link != nil) {
        link.close(attempt.link);
        attempt.link = nil;
    }
}

fun commit_response(attempt: *Attempt, active: *call.Call) exchange.ServiceStatus {
    val parsed: *parser.Parsed = link.response(attempt.link);
    val response: *message.Response = call.response(active);
    val configured: message.Limits = call.limits(active);
    if (parsed == nil || response == nil) { ret exchange.SERVICE_FAILED; }
    if (message.set_status(response, parsed.status) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    var i: usize = 0;
    for (i < parsed.fields.len) {
        val item: *field.Field = ?parsed.fields.items[i];
        if (forward.forwardable(?parsed.fields, item.name)) {
            if (message.add_field(response, @item) != field.ADD_OK) {
                ret exchange.SERVICE_FAILED;
            }
        }
        i = i + 1;
    }
    if (!call.resolve_body(active, call.BODY_DRAIN)) { ret exchange.SERVICE_FAILED; }
    if (!status.permits_content(call.request(active).method.kind, parsed.status)) {
        if (service.commit(active) != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
        ret exchange.SERVICE_COMPLETE;
    }
    val declared: bool = parsed.plan.mode == 2;
    var length: u64 = 0;
    if (declared) { length = parsed.plan.length; }
    if (declared) {
        val measured: str = service.arena_number(active, length);
        if (measured == nil || !service.add_field(active, field.CONTENT_LENGTH, measured)) {
            ret exchange.SERVICE_FAILED;
        }
    }
    attempt.body.attempt = attempt;
    attempt.body.pending_token = 0;
    attempt.body.next_token = 0;
    attempt.body.reader = body.init_reader(
        (?attempt.body)::ptr,
        upstream_read,
        upstream_finish,
        upstream_complete,
        upstream_release,
        body.OWNER_APPLICATION,
        response.generation,
        declared,
        length,
        configured.response_body,
        nil,
        call.scope(active),
    );
    if (!attempt.body.reader.valid) { ret exchange.SERVICE_FAILED; }
    if (message.set_body_reader(response, ?attempt.body.reader, configured) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    if (service.commit(active) != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
    ret exchange.SERVICE_COMPLETE;
}

# a transport failure before any response byte is replayable only when the
# request itself is, because this proxy never buffers a body to replay it
fun may_replay(attempt: *Attempt, active: *call.Call) bool {
    if (attempt.attempts >= attempt.route.max_attempts) { ret false; }
    if (attempt.replay != forward.REPLAY_SAFE) { ret false; }
    ret upstream.healthy_count(?attempt.route.pool, time.now()) != 0;
}

pub fun serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val binding: *Binding = context::*Binding;
    if (binding == nil || binding.runtime == nil || !binding.runtime.live) {
        ret bad_gateway(active, status.INTERNAL_SERVER_ERROR);
    }
    val runtime: *Runtime = binding.runtime;
    if (runtime.driver == nil) { ret bad_gateway(active, status.INTERNAL_SERVER_ERROR); }
    val now: time.Time = time.now();
    var attempt: *Attempt = find_attempt(runtime, active);
    if (attempt == nil) {
        attempt = free_attempt(runtime);
        if (attempt == nil) { ret bad_gateway(active, status.SERVICE_UNAVAILABLE); }
        attempt.live = true;
        attempt.owner = runtime;
        attempt.registry = binding.registry;
        attempt.route = binding.route;
        attempt.phase = PHASE_SELECT;
        attempt.attempts = 0;
        attempt.link = nil;
        attempt.selection = upstream.Selection{
            admission: upstream.NO_UPSTREAM, index: upstream.MAX_UPSTREAMS,
        };
        attempt.replay = forward.classify_replay(call.request(active));
        attempt.has_deadline = attempt_deadline(now,
            call.request(active).metadata.has_deadline,
            call.request(active).metadata.deadline, ?attempt.attempt_deadline);
        attempt.owner_call = active;
        attempt.owner_generation = active.exchange.generation;
        ret begin_attempt(attempt, active, runtime, now);
    }
    ret advance(attempt, active, runtime, now);
}

# drive one attempt toward a committed response
#
# every decision below reads link state rather than a transition, because the
# proxy runtime also drives links: an edge-triggered handoff would be consumed by
# whichever driver happened to run first.
fun advance(attempt: *Attempt, active: *call.Call, runtime: *Runtime,
    now: time.Time) exchange.ServiceStatus {
    if (attempt.phase == PHASE_STREAM || attempt.phase == PHASE_SETTLED) {
        ret exchange.SERVICE_COMPLETE;
    }
    if (attempt.has_deadline && remaining_ns(now, attempt.attempt_deadline) == 0) {
        settle_attempt(attempt, upstream.TIMEOUT, now);
        attempt.phase = PHASE_SETTLED;
        attempt.live = false;
        ret bad_gateway(active, status.GATEWAY_TIMEOUT);
    }
    var steps: usize = 0;
    for (steps < 32) {
        if (link.headers_ready(attempt.link)) {
            val committed: exchange.ServiceStatus = commit_response(attempt, active);
            if (committed != exchange.SERVICE_COMPLETE) {
                settle_attempt(attempt, upstream.FAILURE, now);
                attempt.phase = PHASE_SETTLED;
                attempt.live = false;
                ret exchange.SERVICE_FAILED;
            }
            upstream.release(?attempt.route.pool, attempt.selection.index,
                upstream.SUCCESS, now);
            attempt.selection.admission = upstream.NO_UPSTREAM;
            attempt.owner.total_served = attempt.owner.total_served + 1;
            # the head is committed, but the link still has a body to deliver, so
            # the attempt stays live until that body reaches a terminal state
            attempt.phase = PHASE_STREAM;
            ret exchange.SERVICE_COMPLETE;
        }
        if (link.failed(attempt.link) || link.finished(attempt.link)) {
            settle_attempt(attempt, upstream.FAILURE, now);
            if (may_replay(attempt, active)) {
                attempt.phase = PHASE_SELECT;
                ret begin_attempt(attempt, active, runtime, now);
            }
            attempt.phase = PHASE_SETTLED;
            attempt.live = false;
            ret bad_gateway(active, status.BAD_GATEWAY);
        }
        # a connected link is only useful once this request has been written to
        # it, and only this function knows the request
        if (attempt.phase == PHASE_CONNECT && attempt.link.state == link.READY) {
            if (!link.send(attempt.link, call.request(active).method,
                outbound_target(active), ?attempt.outbound, now)) {
                settle_attempt(attempt, upstream.FAILURE, now);
                attempt.phase = PHASE_SETTLED;
                attempt.live = false;
                ret bad_gateway(active, status.BAD_GATEWAY);
            }
            attempt.phase = PHASE_SEND;
        }
        val progress: link.Step = link.step(attempt.link, now);
        if (progress == link.STEP_BLOCKED) { ret exchange.SERVICE_PENDING; }
        steps = steps + 1;
    }
    ret exchange.SERVICE_PENDING;
}

fun outbound_target(active: *call.Call) target.Target {
    val request: *message.Request = call.request(active);
    ret target.origin(request.target.raw, request.target.path, request.target.query);
}

# a connection reuses its call storage, so the call pointer alone would match a
# previous request's attempt. the exchange generation distinguishes them.
fun find_attempt(runtime: *Runtime, active: *call.Call) *Attempt {
    if (active == nil || active.exchange == nil) { ret nil; }
    val generation: u64 = active.exchange.generation;
    var i: usize = 0;
    for (i < MAX_LINKS) {
        if (runtime.attempts[i].live && runtime.attempts[i].owner_call == active
         && runtime.attempts[i].owner_generation == generation) {
            ret ?runtime.attempts[i];
        }
        i = i + 1;
    }
    ret nil;
}

# the operational view of the proxy runtime, for tests and telemetry alike
pub rec Snapshot {
    live_attempts: usize;
    live_links: usize;
    phase: Phase;
    link_state: link.State;
    attempts: usize;
    route_inflight: usize;
    route_refusals: u64;
    unhealthy_refusals: u64;
    connect_pending: bool;
    connect_failed: bool;
    has_stream: bool;
    link_initialized: bool;
    total_attempts: u64;
    total_failures: u64;
    total_served: u64;
    total_reused: u64;
    idle_links: usize;
}

pub fun snapshot(runtime: *Runtime, registry: *Registry) Snapshot {
    var view: Snapshot = Snapshot{
        live_attempts: 0, live_links: 0, phase: PHASE_SETTLED, link_state: link.FREE,
        attempts: 0, route_inflight: 0, route_refusals: 0, unhealthy_refusals: 0,
        connect_pending: false, connect_failed: false, has_stream: false,
        link_initialized: false, total_attempts: 0, total_failures: 0, total_served: 0,
        total_reused: 0, idle_links: 0,
    };
    if (runtime == nil) { ret view; }
    var i: usize = 0;
    for (i < MAX_LINKS) {
        if (runtime.attempts[i].live) {
            view.live_attempts = view.live_attempts + 1;
            view.phase = runtime.attempts[i].phase;
            view.attempts = runtime.attempts[i].attempts;
            if (runtime.attempts[i].link != nil) {
                view.link_state = runtime.attempts[i].link.state;
                view.connect_pending = runtime.attempts[i].link.connect_pending;
                view.connect_failed = runtime.attempts[i].link.connect_failed;
                view.has_stream = runtime.attempts[i].link.has_stream;
                view.link_initialized = runtime.attempts[i].link.initialized;
            }
        }
        if (runtime.links[i].state != link.FREE) { view.live_links = view.live_links + 1; }
        if (runtime.links[i].state == link.IDLE) { view.idle_links = view.idle_links + 1; }
        i = i + 1;
    }
    view.total_attempts = runtime.total_attempts;
    view.total_failures = runtime.total_failures;
    view.total_served = runtime.total_served;
    view.total_reused = runtime.total_reused;
    if (registry != nil && registry.len != 0) {
        view.route_inflight = registry.routes[0].pool.inflight;
        view.route_refusals = registry.routes[0].pool.route_refusals;
        view.unhealthy_refusals = registry.routes[0].pool.unhealthy_refusals;
    }
    ret view;
}

# one configured proxy service: a route's upstream pool bound to the runtime
pub rec Binding {
    runtime: *Runtime;
    registry: *Registry;
    route: *Route;
}

pub rec Bindings {
    items: *Binding;
    capacity: usize;
    len: usize;
    runtime: *Runtime;
    registry: *Registry;
}

pub fun make_bindings(bindings: *Bindings, items: *Binding, capacity: usize,
    runtime: *Runtime, registry: *Registry) bool {
    if (bindings == nil || (capacity != 0 && items == nil) || runtime == nil
     || registry == nil || registry.generation == 0) { ret false; }
    bindings.items = items;
    bindings.capacity = capacity;
    bindings.len = 0;
    bindings.runtime = runtime;
    bindings.registry = registry;
    ret true;
}

# `upstream = "127.0.0.1:8081, 127.0.0.1:8082"` names one or more upstreams
#
# every member must parse into a literal endpoint. a name that needs resolution is
# refused here rather than resolved later, so a configuration that this build
# cannot reach fails before any listener is ready.
fun add_configured_upstreams(route: *Route, configured: str) bool {
    if (configured == nil) { ret false; }
    val length: usize = str_len(configured);
    var start: usize = 0;
    var i: usize = 0;
    for (i <= length) {
        if (i == length || configured[i] == ',') {
            var from: usize = start;
            var to: usize = i;
            for (from < to && configured[from] == ' ') { from = from + 1; }
            for (to > from && configured[to - 1] == ' ') { to = to - 1; }
            if (to > from) {
                if (route.pool.len >= upstream.MAX_UPSTREAMS || to - from >= 64) { ret false; }
                val slot: usize = route.pool.len;
                var j: usize = 0;
                for (j < to - from) {
                    route.authorities[slot][j] = configured[from + j];
                    j = j + 1;
                }
                route.authorities[slot][to - from] = 0;
                val authority: str = (?route.authorities[slot][0])::str;
                val parsed: Result[ip.Endpoint, str] = ip.endpoint_parse(authority);
                if (is_err[ip.Endpoint, str](parsed)) { ret false; }
                if (!upstream.add_upstream(?route.pool, authority, authority,
                    unwrap_ok[ip.Endpoint, str](parsed), true)) { ret false; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun factory(context: ptr, configured: *schema.Service, handler: *service.Handler) bool {
    val bindings: *Bindings = context::*Bindings;
    if (bindings == nil || configured == nil || handler == nil
     || bindings.len >= bindings.capacity) { ret false; }
    val runtime: *Runtime = bindings.runtime;
    val registry: *Registry = bindings.registry;
    if (runtime == nil || registry == nil || registry.generation == 0
     || registry.len >= MAX_ROUTES) { ret false; }
    val route: *Route = ?registry.routes[registry.len];
    route.name = schema.text(?configured.name);
    route.max_attempts = 2;
    route.live = true;
    if (!upstream.make_pool(?route.pool, ?route.items[0], upstream.MAX_UPSTREAMS,
        upstream.ROUND_ROBIN, runtime.limits)) { ret false; }
    if (!add_configured_upstreams(route, schema.text(?configured.target))) { ret false; }
    if (route.pool.len == 0) { ret false; }
    registry.len = registry.len + 1;
    val binding: *Binding = ?bindings.items[bindings.len];
    bindings.len = bindings.len + 1;
    binding.runtime = runtime;
    binding.registry = registry;
    binding.route = route;
    @handler = service.Handler{ctx: (binding)::ptr, serve: serve};
    ret true;
}

fun configured_proxy(graph: *schema.Graph, target: str) *schema.Service {
    schema.reset_graph(graph);
    graph.service_count = 1;
    val configured: *schema.Service = ?graph.services[0];
    schema.set_text(?configured.name, "backend");
    schema.set_text(?configured.target, target);
    configured.kind = schema.SERVICE_PROXY;
    configured.cache = false;
    ret configured;
}

test "proxy: route registries are reclaimed only after their generation drains" {
    var runtime: Runtime;
    if (!make_runtime(?runtime, nil, "hedge-test", engine_h1.config_default(),
        upstream.default_limits())) { ret 1; }
    var first: Registry;
    var second: Registry;
    if (!make_registry(?first, 1) || !make_registry(?second, 2)) { ret 2; }
    var first_bindings: Bindings;
    var second_bindings: Bindings;
    var first_storage: [2]Binding;
    var second_storage: [2]Binding;
    if (!make_bindings(?first_bindings, ?first_storage[0], 2, ?runtime, ?first)
     || !make_bindings(?second_bindings, ?second_storage[0], 2, ?runtime, ?second)) {
        ret 3;
    }
    var graph: schema.Graph;
    var first_handler: service.Handler;
    if (!factory((?first_bindings)::ptr,
        configured_proxy(?graph, "127.0.0.1:8001"), ?first_handler)) { ret 4; }
    var second_handler: service.Handler;
    if (!factory((?second_bindings)::ptr,
        configured_proxy(?graph, "127.0.0.1:8002"), ?second_handler)) { ret 5; }
    if (route_count(?first) != 1 || route_count(?second) != 1
     || first_handler.ctx == second_handler.ctx) { ret 6; }

    runtime.attempts[0].live = true;
    runtime.attempts[0].registry = ?first;
    if (close_registry(?runtime, ?first) || route_count(?first) != 1) { ret 7; }
    runtime.attempts[0].live = false;
    runtime.attempts[0].registry = nil;
    if (!close_registry(?runtime, ?first) || route_count(?first) != 0) { ret 8; }

    var generation: u64 = 3;
    for (generation < 35) {
        if (!make_registry(?first, generation)
         || !make_bindings(?first_bindings, ?first_storage[0], 2, ?runtime, ?first)
         || !factory((?first_bindings)::ptr,
            configured_proxy(?graph, "127.0.0.1:8001"), ?first_handler)
         || route_count(?first) != 1
         || !close_registry(?runtime, ?first)) { ret 9; }
        generation = generation + 1;
    }
    if (route_count(?second) != 1) { ret 10; }
    ret 0;
}

test "proxy: idle upstream links are scoped to their service registry" {
    var runtime: Runtime;
    if (!make_runtime(?runtime, nil, "hedge-test", engine_h1.config_default(),
        upstream.default_limits())) { ret 1; }
    var first: Registry;
    var second: Registry;
    if (!make_registry(?first, 1) || !make_registry(?second, 2)) { ret 2; }
    runtime.links[0].state = link.IDLE;
    runtime.links[0].leased = false;
    runtime.links[0].initialized = true;
    runtime.links[0].upstream = 0;
    runtime.links[0].engine.state = engine_h1.OPEN;
    runtime.link_registries[0] = ?first;
    val selected: *link.Link = acquire_link(?runtime, ?second, 0);
    if (selected != ?runtime.links[1] || runtime.link_registries[0] != ?first
     || runtime.link_registries[1] != ?second) { ret 3; }
    ret 0;
}
