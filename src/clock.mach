# the two clocks hedge reads
#
# a deadline is built from and compared against monotonic time only: cancel
# scopes, io timers, protocol engines, budgets, the drain sequence and proxy
# attempts all schedule on it. wall time is calendar time, for dates, certificate
# validity, cache freshness and durations measured from a request's receipt, and
# is never handed to anything that schedules.

use std.chrono.time;

# the monotonic clock, or zero when it cannot be read
pub fun monotonic() time.Time {
    val sampled: time.Clock = time.monotonic();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Time{sec: 0, nsec: 0};
}

# the wall clock, or zero when it cannot be read
pub fun wall() time.Time {
    val sampled: time.Clock = time.now();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Time{sec: 0, nsec: 0};
}

# the monotonic clock as nanoseconds, never zero
pub fun monotonic_ns() u64 {
    val value: i64 = time.time_unix_nsec(monotonic());
    if (value <= 0) { ret 1; }
    ret value::u64;
}

# a monotonic nanosecond count as a time
pub fun from_ns(value: u64) time.Time {
    ret time.Time{sec: (value / 1000000000)::i64, nsec: (value % 1000000000)::i64};
}

# the instant timeout_ns after now, saturating rather than wrapping
pub fun after(now: time.Time, timeout_ns: u64) time.Time {
    var deadline: time.Time = now;
    val seconds:  u64       = timeout_ns / 1000000000;
    if (seconds > 0x7fffffffffffffff::u64 - now.sec::u64) {
        ret time.Time{sec: 0x7fffffffffffffff, nsec: 999999999};
    }
    deadline.sec  = now.sec + seconds::i64;
    deadline.nsec = now.nsec + (timeout_ns % 1000000000)::i64;
    if (deadline.nsec >= 1000000000) {
        deadline.nsec = deadline.nsec - 1000000000;
        deadline.sec  = deadline.sec + 1;
    }
    ret deadline;
}

test "clock: the monotonic clock is not the wall clock" {
    val mono: time.Time = monotonic();
    val real: time.Time = wall();
    if (mono.sec == 0 && mono.nsec == 0) { ret 1; }
    # a wall-clock reading used as a deadline is the bug this module exists to
    # prevent, so the test pins that the two readings differ by more than a day
    val gap: i64 = real.sec - mono.sec;
    if (gap < 86400 && gap > -86400) { ret 2; }
    ret 0;
}

test "clock: after carries nanoseconds and saturates" {
    val base:  time.Time = time.Time{sec: 10, nsec: 900000000};
    val later: time.Time = after(base, 1200000000);
    if (later.sec != 12 || later.nsec != 100000000) { ret 1; }
    val capped: time.Time = after(time.Time{sec: 0x7ffffffffffffff0, nsec: 0}, 0xffffffffffffffff);
    if (capped.sec != 0x7fffffffffffffff)                                         { ret 2; }
    if (from_ns(12100000000).sec != 12 || from_ns(12100000000).nsec != 100000000) { ret 3; }
    ret 0;
}
