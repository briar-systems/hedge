# the two clocks hedge reads
#
# a deadline is a monotonic `time.Instant`, built and compared on that clock
# only: cancel scopes, io timers, protocol engines, budgets, the drain sequence
# and proxy attempts all schedule on it. wall time is calendar time, for dates, certificate
# validity, cache freshness and durations measured from a request's receipt, and
# is never handed to anything that schedules.
#
# TLS reads both clocks itself, through the clock source on its policy: wall
# time for certificate validity and ticket windows, monotonic time for its own
# deadlines. hedge hands it no time at all.

use std.chrono.time;
use std.types.option.opt;

# the monotonic clock, or zero when it cannot be read
pub fun instant() time.Instant {
    val sampled: time.InstantClock = time.instant();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Instant{sec: 0, nsec: 0};
}

# the wall clock, or zero when it cannot be read
pub fun wall() time.Time {
    val sampled: time.Clock = time.now();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Time{sec: 0, nsec: 0};
}

# the wall clock as unix seconds, the timebase every TLS time is in
pub fun wall_seconds() i64 {
    ret time.time_unix_sec(wall());
}

# the monotonic clock as nanoseconds, never zero
pub fun monotonic_ns() u64 {
    val value: u64 = to_ns(instant());
    if (value == 0) { ret 1; }
    ret value;
}

# a monotonic instant as nanoseconds
pub fun to_ns(value: time.Instant) u64 {
    if (value.sec < 0 || value.nsec < 0)                      { ret 0; }
    if (value.sec::u64 > 0xffffffffffffffff / 1000000000 - 1) { ret 0xffffffffffffffff; }
    ret value.sec::u64 * 1000000000 + value.nsec::u64;
}

# `timeout_ns` after `now_ns`, saturating rather than wrapping
pub fun after_ns(now_ns: u64, timeout_ns: u64) u64 {
    if (timeout_ns > 0xffffffffffffffff - now_ns) { ret 0xffffffffffffffff; }
    ret now_ns + timeout_ns;
}

# a scope deadline from a monotonic nanosecond count, where zero is none
pub fun deadline(value_ns: u64) opt[time.Instant] {
    if (value_ns == 0) { ret opt[time.Instant].none{}; }
    ret opt[time.Instant].some{from_ns(value_ns)};
}

# a monotonic nanosecond count as an instant
pub fun from_ns(value: u64) time.Instant {
    ret time.Instant{sec: (value / 1000000000)::i64, nsec: (value % 1000000000)::i64};
}

# the instant timeout_ns after now, saturating rather than wrapping
pub fun after(now: time.Instant, timeout_ns: u64) time.Instant {
    var deadline: time.Instant = now;
    val seconds:  u64          = timeout_ns / 1000000000;
    if (seconds > 0x7fffffffffffffff::u64 - now.sec::u64) {
        ret time.Instant{sec: 0x7fffffffffffffff, nsec: 999999999};
    }
    deadline.sec  = now.sec + seconds::i64;
    deadline.nsec = now.nsec + (timeout_ns % 1000000000)::i64;
    if (deadline.nsec >= 1000000000) {
        deadline.nsec = deadline.nsec - 1000000000;
        deadline.sec  = deadline.sec + 1;
    }
    ret deadline;
}

# nanoseconds from `earlier` to `later`, zero when `later` is not after it
pub fun between_ns(earlier: time.Instant, later: time.Instant) u64 {
    val span: i64 = time.instant_sub(later, earlier);
    if (span <= 0) { ret 0; }
    ret span::u64;
}

test "clock: the monotonic clock reads" {
    val mono: time.Instant = instant();
    if (mono.sec == 0 && mono.nsec == 0) { ret 1; }
    if (monotonic_ns() == 0)             { ret 2; }
    ret 0;
}

test "clock: after carries nanoseconds and saturates" {
    val base:  time.Instant = time.Instant{sec: 10, nsec: 900000000};
    val later: time.Instant = after(base, 1200000000);
    if (later.sec != 12 || later.nsec != 100000000) { ret 1; }
    val capped: time.Instant = after(time.Instant{sec: 0x7ffffffffffffff0, nsec: 0}, 0xffffffffffffffff);
    if (capped.sec != 0x7fffffffffffffff)                                         { ret 2; }
    if (from_ns(12100000000).sec != 12 || from_ns(12100000000).nsec != 100000000) { ret 3; }
    if (to_ns(from_ns(12100000000)) != 12100000000)                               { ret 4; }
    if (between_ns(later, base) != 0 || between_ns(base, later) != 1200000000)    { ret 5; }
    ret 0;
}
