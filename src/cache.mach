# the optional cache layer
#
# The layer sits between dispatch and one service. When it is absent the route
# holds a nil pointer and no code here runs at all: no store, no arena, no file,
# no counter. That is the reason every entry point begins by asking whether the
# layer exists rather than whether it is switched on.
#
# The layer's store is shared by every worker and locked per shard. What a
# worker records belongs to that worker: its `Recorders` hold the recordings in
# flight on it, and a recorded entry reaches the shared store only when it is
# published whole. Nothing here holds a shard lock across disk I/O or past the
# return of the function that took it.
#
# No serving worker touches the disk either. The layer's store worker runs every
# disk request, and its completion wakes the worker's plane, which settles it
# and wakes the call that waits on it (#286).

use hedge.cache.disk;
use hedge.cache.key;
use hedge.cache.policy;
use hedge.cache.store;
use hedge.cache.store_worker;
use hedge.config.schema;
use hedge.dispatch.call;
use directives: hedge.http.cache_control;
use http_date:  hedge.http.date;
use hedge.http.range;
use hedge.http.validator;
use hedge.proxy.forward;
use hedge.service;
use hedge.wake;
use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use std.allocator;
use std.chrono.time;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

fun wall_now() time.Time {
    val sampled: time.Clock = time.now();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Time{sec: 0, nsec: 0};
}

pub val MAX_RECORDERS: usize = 16;
# the bytes one recording stages for its disk writes
pub val STAGE_BYTES: usize = 32768;
# the stored bodies one worker reads off the disk at once, and the bytes each
# reads ahead of its response
pub val MAX_READS:  usize = 16;
pub val READ_BYTES: usize = 16384;
# the body streams the store worker admits at once across every worker. a
# stream refused for want of room is a hit served from the origin or a
# response not stored
pub val STORE_STREAMS: usize = 64;

pub rec Layer {
    backing: store.Store;
    limits:  policy.Limits;
    worker:  store_worker.Worker;
    live:    bool;
}

# the recordings one worker has in flight. a worker records into its own set,
# so a recording is only ever touched by the worker that owns it
pub rec Recorders {
    layer:   *Layer;
    slots:   [MAX_RECORDERS]Recording;
    reads:   [MAX_READS]ReadSlot;
    staging: *u8;
    source:  *allocator.Allocator;
    waker:   wake.Waker;
    live:    bool;
}

# one stored body being read off the disk
#
# it belongs to the worker, not to the call that reads it, so the request and
# the bytes it reads into outlive a call that ends while the store worker still
# runs its read: the slot is then `orphaned`, and the plane frees it once the
# read settles. it holds the entry's pin and one admitted stream for as long as
# it is busy
rec ReadSlot {
    recorders: *Recorders;
    busy:      bool;
    orphaned:  bool;
    # a read was queued and its completion not yet taken by the reader or
    # relayed to it
    awaiting: bool;
    failed:   bool;
    pin:      store.Pin;
    request:  disk.Request;
    buffer:   *u8;
    filled:   usize;
    consumed: usize;
    # the next offset read off the disk, and where the body the reader wants ends
    at:     usize;
    limit:  usize;
    waiter: wake.Waker;
}

# what one in-flight response is teeing into the store
#
# a disk-bound body is staged here and written by the writer's request, so the
# bytes a write names stay the recording's until the write settles. a recording
# whose response ended with a write still in flight is `closing`: it keeps its
# slot until that write settles and the entry is published or dropped
rec Recording {
    layer:               *Layer;
    recorders:           *Recorders;
    active:              bool;
    closing:             bool;
    keep:                bool;
    owner:               *call.Call;
    generation:          u64;
    requested_at:        time.Time;
    writer:              store.Writer;
    declared:            usize;
    written:             usize;
    revalidating_index:  usize;
    revalidation:        store.Pin;
    conditioned:         bool;
    request_field_len:   usize;
    request_field_bytes: usize;
    condition_name:      view.View;
    condition_value:     view.View;
    stage:               *u8;
    stage_filled:        usize;
    stage_inflight:      usize;
}

rec RefreshedFields {
    names:         [store.MAX_STORED_FIELDS]usize;
    name_lengths:  [store.MAX_STORED_FIELDS]usize;
    values:        [store.MAX_STORED_FIELDS]usize;
    value_lengths: [store.MAX_STORED_FIELDS]usize;
    count:         usize;
    bytes:         [store.MAX_FIELD_BYTES]u8;
    length:        usize;
}

# the body reader that serves a hit out of the store
# `offset` and `limit` are absolute positions in the stored representation, so a
# range response reads a window of the same entry rather than a copy of it. the
# entry is pinned for as long as the reader lives: by `pin` for a body in
# memory, and by its read slot for one on disk. a disk read that is queued
# answers pending, and the call's waker brings the reader back to complete it
# into the output the pending read was given
rec StoredBody {
    layer:    *Layer;
    pin:      store.Pin;
    slot:     *ReadSlot;
    offset:   usize;
    limit:    usize;
    token:    u64;
    waiting:  *u8;
    capacity: usize;
    reader:   body.Reader;
}

# the stored fields of an entry or of a snapshot of one, read the same way
rec Stored {
    names:         *usize;
    name_lengths:  *usize;
    values:        *usize;
    value_lengths: *usize;
    count:         usize;
    bytes:         *u8;
}

fun entry_fields(entry: *store.Entry) Stored {
    ret Stored{names: ?entry.field_names[0], name_lengths: ?entry.field_name_lengths[0],
        values: ?entry.field_values[0], value_lengths: ?entry.field_value_lengths[0],
        count:  entry.field_count, bytes: ?entry.field_bytes[0]};
}

fun snapshot_fields(snap: *store.Snapshot) Stored {
    ret Stored{names: ?snap.field_names[0], name_lengths: ?snap.field_name_lengths[0],
        values: ?snap.field_values[0], value_lengths: ?snap.field_value_lengths[0],
        count:  snap.field_count, bytes: snap.field_bytes};
}

fun scope_key(identity: *key.Key, generation: u64) bool {
    val prefix: usize = 9;
    if (identity == nil || !identity.valid || generation == 0
        || identity.length + prefix > key.MAX_KEY_BYTES) { ret false; }
    var i: usize = identity.length;
    for (i > 0) {
        i                          = i - 1;
        identity.bytes[i + prefix] = identity.bytes[i];
    }
    i = 0;
    for (i < 8) {
        identity.bytes[i] = (generation >> ((7 - i) * 8))::u8;
        i                 = i + 1;
    }
    identity.bytes[8] = 0;
    identity.length   = identity.length + prefix;
    ret true;
}

test "cache: service generations have disjoint key namespaces" {
    var first: key.Key;
    first.length   = 3;
    first.valid    = true;
    first.bytes[0] = 'G';
    first.bytes[1] = 'E';
    first.bytes[2] = 'T';
    var second: key.Key = first;
    if (!scope_key(?first, 1) || !scope_key(?second, 2)) { ret 1; }
    if (key.equal(?first, ?second) || first.length != 12 || second.length != 12) {
        ret 2;
    }
    var i: usize = 9;
    for (i < first.length) {
        if (first.bytes[i] != second.bytes[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

# `shards` divides the store between locks. one is the unsharded store
pub fun make(layer: *Layer, entries: *store.Entry, capacity: usize, body_storage: *u8,
    body_capacity: usize, limits: store.Limits, freshness: policy.Limits,
    shards: usize) bool {
    if (layer == nil) { ret false; }
    layer.limits = freshness;
    layer.worker = store_worker.idle();
    if (!store.make(?layer.backing, entries, capacity, body_storage, body_capacity, limits,
        shards)) {
        layer.live = false;
        ret false;
    }
    layer.live = true;
    ret true;
}

# give the layer a disk root, whose requests its store worker runs. removals and
# the startup purge draw on a reserve beside the admitted streams: one removal
# per entry at most, and the purge
pub fun attach_disk(layer: *Layer, root_path: str, scratch: *allocator.Allocator) bool {
    if (layer == nil || !layer.live) { ret false; }
    if (!store_worker.start(?layer.worker, ?layer.backing.disk, STORE_STREAMS,
        layer.backing.capacity + 1)) { ret false; }
    if (!store.attach_disk(?layer.backing, root_path, scratch,
        store_worker.executor(?layer.worker))) {
        store_worker.stop(?layer.worker, 0);
        ret false;
    }
    ret true;
}

# close the store and stop its worker. the worker drains its queue first, and
# gives up once `timeout_ns` passes with nothing completing: the close then
# fails and `stalled` names what the disk still holds
pub fun close(layer: *Layer, timeout_ns: u64) bool {
    if (layer == nil || !layer.live) { ret false; }
    # a close refused for removals in flight is finished once the worker has
    # run them
    var closed: bool = store.close(?layer.backing);
    if (!store_worker.stop(?layer.worker, timeout_ns)) { ret false; }
    if (!closed)                                       { closed = store.close(?layer.backing); }
    layer.live = false;
    ret closed;
}

# the disk requests the store worker still holds, at most `capacity` of them
# written to `output`. returns how many there are
pub fun stalled(layer: *Layer, output: *store_worker.Outstanding, capacity: usize) usize {
    if (layer == nil) { ret 0; }
    ret store_worker.outstanding(?layer.worker, output, capacity);
}

pub fun enabled(layer: *Layer) bool {
    ret layer != nil && layer.live;
}

pub rec Report {
    hits:             u64;
    misses:           u64;
    stores:           u64;
    evictions:        u64;
    rejections:       u64;
    partial_discards: u64;
    entries:          usize;
    memory_bytes:     usize;
    disk_bytes:       usize;
}

pub fun report(layer: *Layer) Report {
    if (!enabled(layer)) {
        ret Report{hits: 0, misses: 0, stores: 0, evictions: 0, rejections: 0,
            partial_discards: 0, entries: 0, memory_bytes: 0, disk_bytes: 0};
    }
    val summed: store.Totals = store.totals(?layer.backing);
    ret Report{
        hits:             summed.hits,
        misses:           summed.misses,
        stores:           summed.stores,
        evictions:        summed.evictions,
        rejections:       summed.rejections,
        partial_discards: summed.partial_discards,
        entries:          summed.entries,
        memory_bytes:     summed.memory_bytes,
        disk_bytes:       summed.disk_bytes,
    };
}

# --- a worker's recordings ---

# give a worker its recording set. staging for disk writes is drawn from
# `source` only when the layer has a disk root, so a memory cache stages nothing
pub fun make_recorders(recorders: *Recorders, layer: *Layer, source: *allocator.Allocator) bool {
    if (recorders == nil || !enabled(layer)) { ret false; }
    recorders.layer   = layer;
    recorders.staging = nil;
    recorders.source  = nil;
    recorders.waker   = wake.no_waker();
    if (layer.backing.has_root) {
        if (source == nil) { ret false; }
        val allocated: res[*u8, allocator.Error] = allocator.allocate[u8](source,
            staging_bytes());
        if (sel allocated.err) { ret false; }
        recorders.staging = allocated.ok;
        recorders.source  = source;
    }
    var r: usize = 0;
    for (r < MAX_READS) {
        val slot: *ReadSlot = ?recorders.reads[r];
        slot.recorders = recorders;
        slot.busy      = false;
        slot.orphaned  = false;
        slot.awaiting  = false;
        slot.failed    = false;
        slot.pin       = store.no_pin();
        slot.request   = disk.idle();
        slot.buffer    = nil;
        if (recorders.staging != nil) {
            slot.buffer = ?recorders.staging[MAX_RECORDERS * STAGE_BYTES + r * READ_BYTES];
        }
        slot.filled   = 0;
        slot.consumed = 0;
        slot.at       = 0;
        slot.limit    = 0;
        slot.waiter   = wake.no_waker();
        r             = r + 1;
    }
    var i: usize = 0;
    for (i < MAX_RECORDERS) {
        val state: *Recording = ?recorders.slots[i];
        state.layer              = layer;
        state.recorders          = recorders;
        state.active             = false;
        state.closing            = false;
        state.owner              = nil;
        state.revalidation       = store.no_pin();
        state.revalidating_index = store.NO_ENTRY;
        state.stage              = nil;
        if (recorders.staging != nil) { state.stage = ?recorders.staging[i * STAGE_BYTES]; }
        state.stage_filled   = 0;
        state.stage_inflight = 0;
        i                    = i + 1;
    }
    recorders.live = true;
    ret true;
}

# a worker's disk staging: its recordings' writes, then its reads
fun staging_bytes() usize {
    ret MAX_RECORDERS * STAGE_BYTES + MAX_READS * READ_BYTES;
}

# the waker a queued disk request wakes: the worker's plane, which drives `drive`
pub fun attach_waker(recorders: *Recorders, waker: wake.Waker) bool {
    if (recorders == nil || !recorders.live) { ret false; }
    recorders.waker = waker;
    ret true;
}

# settle what recordings that already ended still have in flight, publishing or
# dropping each entry once its last write settles, and hand each settled read
# to the call that waits on it, or free it when that call has gone
pub fun drive(recorders: *Recorders) bool {
    if (recorders == nil || !recorders.live) { ret true; }
    var advanced: bool  = true;
    var i:        usize = 0;
    for (i < MAX_RECORDERS) {
        val state: *Recording = ?recorders.slots[i];
        if (state.closing) { advance_closing(state); }
        i = i + 1;
    }
    i = 0;
    for (i < MAX_READS) {
        val slot: *ReadSlot = ?recorders.reads[i];
        if (slot_settled(slot)) {
            settle_slot(slot);
            if (slot.orphaned)            { free_slot(slot); }
            or (!wake.wake(?slot.waiter)) { advanced = false; }
        }
        i = i + 1;
    }
    ret advanced;
}

# whether a recording that ended still waits on a disk write, or a read on its
# disk read
pub fun settling(recorders: *Recorders) bool {
    if (recorders == nil || !recorders.live) { ret false; }
    var i: usize = 0;
    for (i < MAX_RECORDERS) {
        if (recorders.slots[i].closing) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < MAX_READS) {
        if (recorders.reads[i].busy && recorders.reads[i].awaiting) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether `drive` has work: a disk request that settled and was not yet taken
# up. the debug audit asks this of a plane that is not due, since such work
# waits on a wake that already came
pub fun pending_work(recorders: *Recorders) bool {
    if (recorders == nil || !recorders.live) { ret false; }
    var i: usize = 0;
    for (i < MAX_RECORDERS) {
        val state: *Recording = ?recorders.slots[i];
        if (state.closing && store.write_pending(?state.writer)
            && !disk.in_flight(?state.writer.request)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < MAX_READS) {
        if (slot_settled(?recorders.reads[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun slot_settled(slot: *ReadSlot) bool {
    ret slot.busy && slot.awaiting && !disk.in_flight(?slot.request);
}

# --- reading a stored body off the disk ---

# a slot for one stored body, holding the pin taken over from `held` and one
# admitted stream. nil when the worker has no free slot or the store worker no
# room for another stream: a refusal the caller answers without the disk
fun open_slot(recorders: *Recorders, held: *store.Pin, first: usize, limit: usize,
    waiter: wake.Waker) *ReadSlot {
    if (recorders == nil || !recorders.live || recorders.staging == nil || held == nil
        || !held.held) { ret nil; }
    var found: *ReadSlot = nil;
    var i:     usize     = 0;
    for (i < MAX_READS && found == nil) {
        if (!recorders.reads[i].busy) { found = ?recorders.reads[i]; }
        i = i + 1;
    }
    if (found == nil || !disk.admit(?recorders.layer.backing.disk)) { ret nil; }
    found.busy     = true;
    found.orphaned = false;
    found.awaiting = false;
    found.failed   = false;
    found.pin      = @held;
    held.held      = false;
    found.request  = disk.idle();
    found.filled   = 0;
    found.consumed = 0;
    found.at       = first;
    found.limit    = limit;
    found.waiter   = waiter;
    ret found;
}

fun free_slot(slot: *ReadSlot) {
    store.unpin(?slot.pin);
    disk.leave(?slot.recorders.layer.backing.disk);
    slot.busy     = false;
    slot.orphaned = false;
    slot.awaiting = false;
    slot.waiter   = wake.no_waker();
}

# the reader is done with the slot. a read the store worker still holds names
# the slot's buffer, so the slot is left to the plane until it settles
fun release_slot(slot: *ReadSlot) {
    if (slot == nil || !slot.busy) { ret; }
    if (slot.awaiting) {
        slot.orphaned = true;
        slot.waiter   = wake.no_waker();
        ret;
    }
    free_slot(slot);
}

# read the next piece of the body into the slot, which holds nothing unread
fun fill_slot(slot: *ReadSlot) store.ReadStatus {
    if (slot.failed)           { ret store.READ_FAILED; }
    if (slot.at >= slot.limit) { ret store.READ_DONE; }
    var room: usize = slot.limit - slot.at;
    if (room > READ_BYTES) { room = READ_BYTES; }
    var produced: usize            = 0;
    val status:   store.ReadStatus = store.read_body(?slot.pin, slot.at, slot.buffer, room,
        ?slot.request, slot.recorders.waker, ?produced);
    if (status == store.READ_PENDING) {
        slot.awaiting = true;
        ret status;
    }
    ret took(slot, status, produced);
}

fun took(slot: *ReadSlot, status: store.ReadStatus, produced: usize) store.ReadStatus {
    if (status != store.READ_DONE || produced == 0) {
        slot.failed = true;
        ret store.READ_FAILED;
    }
    slot.filled   = produced;
    slot.consumed = 0;
    slot.at       = slot.at + produced;
    ret store.READ_DONE;
}

# whether the slot holds bytes to hand out, reading more when it holds none
fun ready_slot(slot: *ReadSlot) store.ReadStatus {
    if (slot.consumed < slot.filled) { ret store.READ_DONE; }
    if (slot.failed)                 { ret store.READ_FAILED; }
    if (slot.awaiting) {
        if (disk.in_flight(?slot.request)) { ret store.READ_PENDING; }
        ret settle_slot(slot);
    }
    ret fill_slot(slot);
}

# take a queued read's result into the slot once it has settled
fun settle_slot(slot: *ReadSlot) store.ReadStatus {
    slot.awaiting = false;
    var produced: usize            = 0;
    val status:   store.ReadStatus = store.read_settled(?slot.request, ?produced);
    ret took(slot, status, produced);
}

# hand out up to `capacity` of the slot's bytes. once it is empty the next
# piece is read ahead while the response writes these
fun drain_slot(slot: *ReadSlot, output: *u8, capacity: usize) usize {
    var count: usize = slot.filled - slot.consumed;
    if (count > capacity) { count = capacity; }
    memory.raw_copy(output::ptr, (?slot.buffer[slot.consumed])::ptr, count);
    slot.consumed = slot.consumed + count;
    if (slot.consumed == slot.filled && slot.at < slot.limit) {
        slot.filled   = 0;
        slot.consumed = 0;
        fill_slot(slot);
    }
    ret count;
}

# refused while a write is still in flight, since its staged bytes are the
# executor's until it settles
pub fun close_recorders(recorders: *Recorders) bool {
    if (recorders == nil || !recorders.live) { ret false; }
    drive(recorders);
    if (settling(recorders)) { ret false; }
    var i: usize = 0;
    for (i < MAX_RECORDERS) {
        val state: *Recording = ?recorders.slots[i];
        if (state.active) { stop_recording(state, false); }
        state.owner = nil;
        i           = i + 1;
    }
    if (settling(recorders)) { ret false; }
    # a read slot a reader still holds is a response still in flight
    i = 0;
    for (i < MAX_READS) {
        if (recorders.reads[i].busy) { ret false; }
        i = i + 1;
    }
    if (recorders.staging != nil) {
        allocator.deallocate[u8](recorders.source, recorders.staging, staging_bytes());
        recorders.staging = nil;
    }
    recorders.live = false;
    ret true;
}

# --- serving a stored representation ---

fun stored_progress(state: *StoredBody, status: store.ReadStatus, produced: usize) body.Progress {
    if (status == store.READ_PENDING) {
        state.token = state.token + 1;
        ret body.pending(state.token);
    }
    if (status != store.READ_DONE) {
        ret body.failed("stored body could not be read", body.REUSE_FORBIDDEN);
    }
    if (produced == 0) { ret body.failed("stored body ended early", body.REUSE_FORBIDDEN); }
    state.offset = state.offset + produced;
    ret body.data(produced);
}

# hand out what the slot holds into `output`, or answer pending with the output
# remembered for the completion
fun slot_progress(state: *StoredBody, status: store.ReadStatus, output: *u8,
    capacity: usize) body.Progress {
    if (status == store.READ_PENDING) {
        state.waiting  = output;
        state.capacity = capacity;
    }
    var produced: usize = 0;
    if (status == store.READ_DONE) {
        var room: usize = state.limit - state.offset;
        if (room > capacity) { room = capacity; }
        produced = drain_slot(state.slot, output, room);
    }
    ret stored_progress(state, status, produced);
}

fun stored_read(context: ptr, output: *u8, capacity: usize, trailers: *field.Fields) body.Progress {
    val state: *StoredBody = context::*StoredBody;
    if (state == nil)                { ret body.failed("stored body has no state", body.REUSE_FORBIDDEN); }
    if (state.offset >= state.limit) { ret body.complete(body.REUSE_ALLOWED); }
    if (state.slot != nil) {
        ret slot_progress(state, ready_slot(state.slot), output, capacity);
    }
    var produced: usize = 0;
    var room:     usize = state.limit - state.offset;
    if (room > capacity) { room = capacity; }
    val status: store.ReadStatus = store.read_body(?state.pin, state.offset, output, room,
        nil, wake.no_waker(), ?produced);
    ret stored_progress(state, status, produced);
}

fun stored_finish(context: ptr, mode: body.Mode, trailers: *field.Fields) body.Progress {
    val state: *StoredBody = context::*StoredBody;
    if (state == nil)         { ret body.failed("stored body has no state", body.REUSE_FORBIDDEN); }
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT)  { ret body.rejected(body.REUSE_ALLOWED); }
    state.offset = state.limit;
    ret body.complete(body.REUSE_ALLOWED);
}

# a queued disk read has completed, or the wake was early and it still waits
fun stored_complete(context: ptr, token: u64, trailers: *field.Fields) body.Progress {
    val state: *StoredBody = context::*StoredBody;
    if (state == nil || token != state.token) {
        ret body.failed("stored body completion is not its own", body.REUSE_FORBIDDEN);
    }
    if (state.slot == nil || state.waiting == nil) {
        ret body.failed("stored body has no read in flight", body.REUSE_FORBIDDEN);
    }
    val status: store.ReadStatus = ready_slot(state.slot);
    if (status == store.READ_PENDING) { ret body.pending(state.token); }
    val output: *u8 = state.waiting;
    state.waiting = nil;
    ret slot_progress(state, status, output, state.capacity);
}

fun stored_release(context: ptr) {
    val state: *StoredBody = context::*StoredBody;
    if (state == nil) { ret; }
    if (state.slot != nil) {
        release_slot(state.slot);
        state.slot = nil;
    }
    store.unpin(?state.pin);
}

fun field_name(fields: Stored, index: usize) view.View {
    ret view.view(?fields.bytes[fields.names[index]], fields.name_lengths[index]);
}

fun field_value(fields: Stored, index: usize) view.View {
    ret view.view(?fields.bytes[fields.values[index]], fields.value_lengths[index]);
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun name_is(name: view.View, expected: str) bool {
    val length: usize = str_len(expected);
    if (name.len != length || name.data == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (lower(name.data[i]) != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun stored_field(fields: Stored, name: str) view.View {
    var i: usize = 0;
    for (i < fields.count) {
        if (name_is(field_name(fields, i), name)) { ret field_value(fields, i); }
        i = i + 1;
    }
    ret view.view(nil, 0);
}

# the validators the stored representation carries, so a conditional request can
# be answered from the store instead of from the origin
fun stored_validators(fields: Stored) validator.Validators {
    var current: validator.Validators = validator.none();
    current.etag = stored_field(fields, field.ETAG);
    val modified: view.View = stored_field(fields, field.LAST_MODIFIED);
    if (modified.data != nil && modified.len != 0) {
        current.has_modified = http_date.parse(modified, ?current.modified);
    }
    ret current;
}

fun response_validators(fields: *field.Fields) validator.Validators {
    var current: validator.Validators = validator.none();
    val etag:    *field.Field         = field.find_first(fields,
        view.view(field.ETAG, 4));
    if (etag != nil) { current.etag = etag.value; }
    val modified: *field.Field = field.find_first(fields,
        view.view(field.LAST_MODIFIED, 13));
    if (modified != nil) {
        current.has_modified = http_date.parse(modified.value,
            ?current.modified);
    }
    ret current;
}

fun weak_etag(value: view.View) bool {
    ret value.data != nil && value.len >= 2
        && value.data[0] == 'W' && value.data[1] == '/';
}

fun initially_selectable(candidate: *store.Entry, selected: *store.Entry,
    request: *message.Request) bool {
    ret candidate != nil && selected != nil && request != nil
        && key.equal(?candidate.identity, ?selected.identity)
        && key.matches(?candidate.dimensions, request);
}

fun response_time(entry: *store.Entry) time.Time {
    if (entry.metadata.has_date) { ret entry.metadata.date; }
    ret entry.metadata.received_at;
}

# every entry a validation response refreshes, found with the shard held
fun refresh_targets(shard: *store.Shard, selected: *store.Entry,
    request: *message.Request, response: *message.Response,
    targets: *usize) usize {
    if (shard == nil || selected == nil || request == nil
        || response == nil || targets == nil) { ret 0; }
    val received:            validator.Validators = response_validators(?response.fields);
    val selected_validators: validator.Validators = stored_validators(entry_fields(selected));
    var count:               usize                = 0;
    var i:                   usize                = 0;
    if (received.etag.data != nil && received.etag.len != 0
        && !weak_etag(received.etag)) {
        var includes_selected: bool = false;
        for (i < shard.capacity) {
            val candidate: *store.Entry = store.entry_at(shard, i);
            var matches:   bool         = false;
            if (initially_selectable(candidate, selected, request)) {
                val stored: validator.Validators = stored_validators(entry_fields(candidate));
                matches = validator.strong_match(received.etag, stored.etag);
            }
            if (matches) {
                targets[count] = i;
                count          = count + 1;
                if (candidate == selected) { includes_selected = true; }
            }
            i = i + 1;
        }
        if (!includes_selected) { ret 0; }
        ret count;
    }
    if ((received.etag.data != nil && received.etag.len != 0)
        || received.has_modified) {
        var chosen:          usize     = store.NO_ENTRY;
        var newest_time:     time.Time = time.Time{sec: 0, nsec: 0};
        var newest_sequence: u64       = 0;
        for (i < shard.capacity) {
            val candidate: *store.Entry = store.entry_at(shard, i);
            if (initially_selectable(candidate, selected, request)) {
                val stored:  validator.Validators = stored_validators(entry_fields(candidate));
                var matches: bool                 = false;
                if (received.etag.data != nil && received.etag.len != 0) {
                    matches = validator.weak_match(received.etag, stored.etag);
                }
                or {
                    matches = stored.has_modified
                        && time.time_equal(stored.modified, received.modified);
                }
                val candidate_time: time.Time = response_time(candidate);
                if (matches && (chosen == store.NO_ENTRY
                    || time.time_after(candidate_time, newest_time)
                    || (time.time_equal(candidate_time, newest_time)
                    && candidate.stored_at > newest_sequence))) {
                    chosen          = i;
                    newest_time     = candidate_time;
                    newest_sequence = candidate.stored_at;
                }
            }
            i = i + 1;
        }
        if (chosen == store.NO_ENTRY
            || store.entry_at(shard, chosen) != selected) { ret 0; }
        targets[0] = chosen;
        ret 1;
    }
    if (selected_validators.etag.data != nil || selected_validators.has_modified) {
        ret 0;
    }
    var selected_count: usize = 0;
    for (i < shard.capacity) {
        if (initially_selectable(store.entry_at(shard, i),
            selected, request)) {
            selected_count = selected_count + 1;
        }
        i = i + 1;
    }
    if (selected_count != 1) { ret 0; }
    for (i < shard.capacity) {
        if (store.entry_at(shard, i) == selected) {
            targets[0] = i;
            ret 1;
        }
        i = i + 1;
    }
    ret 0;
}

# RFC 9110 section 15.4.5: a 304 carries the metadata a cache would have updated,
# and nothing that describes a body it is not sending
fun metadata_field(name: view.View) bool {
    ret name_is(name, field.CACHE_CONTROL)
        || name_is(name, "content-location")
        || name_is(name, field.DATE)
        || name_is(name, field.ETAG)
        || name_is(name, "expires")
        || name_is(name, field.LAST_MODIFIED)
        || name_is(name, field.VARY);
}

fun add_refreshed(fields: *RefreshedFields, name: view.View, value: view.View) bool {
    if (fields.count >= store.MAX_STORED_FIELDS
        || name.len > store.MAX_FIELD_BYTES
        || value.len > store.MAX_FIELD_BYTES - name.len
        || fields.length > store.MAX_FIELD_BYTES - name.len - value.len) { ret false; }
    fields.names[fields.count]        = fields.length;
    fields.name_lengths[fields.count] = name.len;
    var i: usize = 0;
    for (i < name.len) {
        fields.bytes[fields.length + i] = name.data[i];
        i                               = i + 1;
    }
    fields.length                      = fields.length + name.len;
    fields.values[fields.count]        = fields.length;
    fields.value_lengths[fields.count] = value.len;
    i                                  = 0;
    for (i < value.len) {
        fields.bytes[fields.length + i] = value.data[i];
        i                               = i + 1;
    }
    fields.length = fields.length + value.len;
    fields.count  = fields.count + 1;
    ret true;
}

fun refresh_candidate(fields: *field.Fields, item: *field.Field) bool {
    ret item != nil && !name_is(item.name, field.CONTENT_LENGTH)
        && forward.forwardable(fields, item.name);
}

fun response_replaces(fields: *field.Fields, name: view.View) bool {
    var i: usize = 0;
    for (i < fields.len) {
        val item: *field.Field = ?fields.items[i];
        if (refresh_candidate(fields, item) && field.name_equal(item.name, name)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun merge_refreshed(entry: *store.Entry, response_fields: *field.Fields,
    response_directives: directives.Directives, output: *RefreshedFields) bool {
    output.count  = 0;
    output.length = 0;
    val stored: Stored = entry_fields(entry);
    var i:      usize  = 0;
    for (i < stored.count) {
        val name: view.View = field_name(stored, i);
        if (!response_replaces(response_fields, name)
            && !policy.excluded_field(response_directives, name)
            && !add_refreshed(output, name, field_value(stored, i))) {
            ret false;
        }
        i = i + 1;
    }
    i = 0;
    for (i < response_fields.len) {
        val item: *field.Field = ?response_fields.items[i];
        if (refresh_candidate(response_fields, item)
            && !policy.excluded_field(response_directives, item.name)
            && !add_refreshed(output, item.name, item.value)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun refreshed_fields(merged: *RefreshedFields, items: *field.Field) field.Fields {
    var fields: field.Fields = field.init(items, store.MAX_STORED_FIELDS,
        field.limits(store.MAX_STORED_FIELDS, store.MAX_FIELD_BYTES,
        store.MAX_FIELD_BYTES, store.MAX_FIELD_BYTES));
    var i: usize = 0;
    for (i < merged.count) {
        field.append(?fields, field.Field{
            name:      view.view(?merged.bytes[merged.names[i]], merged.name_lengths[i]),
            value:     view.view(?merged.bytes[merged.values[i]], merged.value_lengths[i]),
            sensitive: false,
        });
        i = i + 1;
    }
    ret fields;
}

def RefreshStatus: u8;
val REFRESH_UPDATED:     RefreshStatus = 1;
val REFRESH_INVALIDATED: RefreshStatus = 2;
val REFRESH_FAILED:      RefreshStatus = 3;

fun invalidate_refreshed(state: *Recording, shard: *store.Shard, index: usize) RefreshStatus {
    if (!store.discard_entry(shard, index)) {
        ret REFRESH_FAILED;
    }
    if (index == state.revalidating_index) {
        state.revalidating_index = store.NO_ENTRY;
    }
    ret REFRESH_INVALIDATED;
}

# refresh one stored entry from a validation response, with its shard held
fun refresh_entry(state: *Recording, shard: *store.Shard, active: *call.Call,
    now: time.Time, index: usize, apply: bool) RefreshStatus {
    val entry:    *store.Entry      = store.entry_at(shard, index);
    val response: *message.Response = call.response(active);
    val request:  *message.Request  = call.request(active);
    if (entry == nil || response == nil || request == nil) { ret REFRESH_FAILED; }
    val refresh_directives: directives.Directives = directives.parse(?response.fields);
    if (policy.set_cookie_unsafe(?response.fields, refresh_directives)) {
        if (!apply) { ret REFRESH_INVALIDATED; }
        ret invalidate_refreshed(state, shard, index);
    }
    var merged: RefreshedFields;
    if (!merge_refreshed(entry, ?response.fields, refresh_directives, ?merged)) {
        ret REFRESH_FAILED;
    }
    var items:  [store.MAX_STORED_FIELDS]field.Field;
    var fields: field.Fields = refreshed_fields(?merged, ?items[0]);
    if (!field.validate(?fields, fields.limits, false)) { ret REFRESH_FAILED; }
    val response_directives: directives.Directives = directives.parse(?fields);
    val request_directives:  directives.Directives = directives.parse(?request.fields);
    if (policy.storable(request, ?fields, entry.status, request_directives,
        response_directives, state.layer.limits) != policy.STORE) {
        if (!apply) { ret REFRESH_INVALIDATED; }
        ret invalidate_refreshed(state, shard, index);
    }
    var dimensions: key.Dimensions;
    if (!key.select(request, ?fields, ?dimensions) || !dimensions.valid) {
        ret REFRESH_FAILED;
    }
    val metadata: policy.Metadata = policy.describe(?fields, entry.status,
        response_directives, state.requested_at, now, state.layer.limits);
    if (!apply) { ret REFRESH_UPDATED; }
    var i: usize = 0;
    for (i < merged.count) {
        entry.field_names[i]         = merged.names[i];
        entry.field_name_lengths[i]  = merged.name_lengths[i];
        entry.field_values[i]        = merged.values[i];
        entry.field_value_lengths[i] = merged.value_lengths[i];
        i                            = i + 1;
    }
    i = 0;
    for (i < merged.length) {
        entry.field_bytes[i] = merged.bytes[i];
        i                    = i + 1;
    }
    entry.field_count  = merged.count;
    entry.field_length = merged.length;
    entry.dimensions   = dimensions;
    entry.metadata     = metadata;
    if (!store.mark_refreshed(shard, index)) {
        ret REFRESH_FAILED;
    }
    ret REFRESH_UPDATED;
}

fun copy_stored_fields(snap: *store.Snapshot, response: *message.Response,
    only_metadata: bool, skip_length: bool) bool {
    val stored: Stored = snapshot_fields(snap);
    var i:      usize  = 0;
    for (i < stored.count) {
        val name:   view.View = field_name(stored, i);
        var wanted: bool      = true;
        if (only_metadata)                                      { wanted = metadata_field(name); }
        if (name_is(name, "age"))                               { wanted = false; }
        if (skip_length && name_is(name, field.CONTENT_LENGTH)) { wanted = false; }
        if (wanted && message.add_field(response, field.Field{
            name:      name,
            value:     field_value(stored, i),
            sensitive: false,
        }) != field.ADD_OK) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun add_age(layer: *Layer, active: *call.Call, snap: *store.Snapshot, now: time.Time) bool {
    val age_seconds: u64 = policy.current_age(snap.metadata, now) / 1000000000;
    val age_text:    str = service.arena_number(active, age_seconds);
    if (age_text == nil) { ret false; }
    ret service.add_field(active, "age", age_text);
}

fun request_header(request: *message.Request, name: str, length: usize) view.View {
    val found: *field.Field = field.find_first(?request.fields, view.view(name, length));
    if (found == nil) { ret view.view(nil, 0); }
    ret found.value;
}

# select an entry to answer from, with its shard held: touch it, count the hit,
# copy what the response needs into the call's arena and pin it for its body.
# with `defer_disk` a hit that may have to read its body off the disk is left
# uncounted, since a refused read makes it a miss (`counts_later`)
fun take_hit(shard: *store.Shard, active: *call.Call, index: usize, snap: *store.Snapshot,
    held: *store.Pin, defer_disk: bool) bool {
    val entry: *store.Entry = store.entry_at(shard, index);
    if (entry == nil) { ret false; }
    var fields: *u8 = nil;
    if (entry.field_length != 0) {
        fields = service.arena_bytes(active, entry.field_length);
        if (fields == nil) { ret false; }
    }
    if (!store.snapshot(entry, fields, snap)) { ret false; }
    @held = store.pin(shard, index);
    if (!held.held) { ret false; }
    store.touch(shard, index);
    if (!defer_disk || !counts_later(snap)) { store.record_hit(shard); }
    ret true;
}

fun counts_later(snap: *store.Snapshot) bool {
    ret snap.placement == store.ON_DISK && snap.body_length != 0;
}

# count a lookup whose outcome was settled after its shard was let go
fun count_lookup(shard: *store.Shard, hit: bool) {
    store.lock(shard);
    if (hit) { store.record_hit(shard); }
    or       { store.record_miss(shard); }
    store.release(shard);
}

# a read slot on its way to a body reader. whoever holds a lease with a slot in
# it releases the slot, and a reader that takes the slot over empties the lease
rec Lease {
    slot: *ReadSlot;
}

fun no_lease() Lease {
    ret Lease{slot: nil};
}

fun end_lease(lease: *Lease) {
    if (lease.slot == nil) { ret; }
    release_slot(lease.slot);
    lease.slot = nil;
}

# attach a reader over `[first, last]` of the stored representation. the reader
# takes the pin, or the read slot of a body on disk, over and lets it go when it
# is released
fun attach_stored_body(layer: *Layer, active: *call.Call, held: *store.Pin, lease: *Lease,
    first: usize, last_exclusive: usize) bool {
    val a: *allocator.Allocator = call.allocator_of(active);
    if (a == nil) { ret false; }
    val allocated: res[*StoredBody, allocator.Error] = allocator.allocate[StoredBody](a, 1);
    if (sel allocated.err) { ret false; }
    val state: *StoredBody = allocated.ok;
    state.layer    = layer;
    state.pin      = store.no_pin();
    state.slot     = nil;
    state.offset   = first;
    state.limit    = last_exclusive;
    state.token    = 0;
    state.waiting  = nil;
    state.capacity = 0;
    val response:   *message.Response = call.response(active);
    val configured: message.Limits    = call.limits(active);
    val count:      usize             = last_exclusive - first;
    val measured:   str               = service.arena_number(active, count::u64);
    if (measured == nil)                                            { ret false; }
    if (!service.add_field(active, field.CONTENT_LENGTH, measured)) { ret false; }
    state.reader = body.init_reader(
        (state)::ptr,
        stored_read,
        stored_finish,
        stored_complete,
        stored_release,
        body.OWNER_APPLICATION,
        response.generation,
        true,
        count::u64,
        configured.response_body,
        nil,
        call.scope(active),
    );
    if (!state.reader.valid) { ret false; }
    if (message.set_body_reader(response, ?state.reader, configured) != message.RESPONSE_OK) {
        ret false;
    }
    if (lease.slot != nil) {
        state.slot = lease.slot;
        lease.slot = nil;
    }
    or {
        state.pin = @held;
        held.held = false;
    }
    ret true;
}

# emit a stored representation, including the Age it has accumulated
#
# a hit is answered here in full: the preconditions the client sent are evaluated
# against the stored validators, and a byte range is served out of the stored
# bytes. Going to the origin for either would make a cache hit cost an origin
# request, which is the one thing a cache exists to avoid.
fun prepare_bodyless(active: *call.Call) bool {
    val response: *message.Response = call.response(active);
    val request:  *message.Request  = call.request(active);
    if (response == nil || request == nil) { ret false; }
    if (status.permits_content(request.method.kind, response.status)
        && field.find_first(?response.fields, service.text_view(field.CONTENT_LENGTH)) == nil
        && !service.add_field(active, field.CONTENT_LENGTH, "0")) { ret false; }
    ret true;
}

# what a stored representation answers a request with, decided before any of it
# is written into the response, so a hit whose body has to come off the disk
# can still go to the origin when the disk refuses it
def Answer: u8;
val ANSWER_PRECONDITION_FAILED: Answer = 1;
val ANSWER_NOT_MODIFIED:        Answer = 2;
val ANSWER_UNSATISFIABLE:       Answer = 3;
val ANSWER_BODYLESS:            Answer = 4;
val ANSWER_BODY:                Answer = 5;

rec Plan {
    answer:  Answer;
    span:    range.Span;
    partial: bool;
    # the window of the stored body an ANSWER_BODY sends
    first:          usize;
    last_exclusive: usize;
}

fun plan_snapshot(request: *message.Request, snap: *store.Snapshot) Plan {
    var plan: Plan = Plan{answer: ANSWER_BODYLESS,
        span:    range.Span{outcome: range.NO_RANGE, first: 0, last: 0, length: 0},
        partial: false, first: 0, last_exclusive: 0};
    val current:      validator.Validators = stored_validators(snapshot_fields(snap));
    val precondition: validator.Outcome    = validator.evaluate(request, current);
    if (precondition == validator.PRECONDITION_FAILED) {
        plan.answer = ANSWER_PRECONDITION_FAILED;
        ret plan;
    }
    if (precondition == validator.NOT_MODIFIED) {
        plan.answer = ANSWER_NOT_MODIFIED;
        ret plan;
    }
    val bodyless: bool = !status.permits_content(request.method.kind, snap.status)
        || snap.body_length == 0;
    if (!bodyless && snap.status == status.OK) {
        val asked: view.View = request_header(request, field.RANGE, 5);
        if (asked.data != nil && asked.len != 0 && validator.range_allowed(request, current)) {
            plan.span = range.resolve(asked, snap.body_length::u64);
        }
    }
    if (plan.span.outcome == range.UNSATISFIABLE) {
        plan.answer = ANSWER_UNSATISFIABLE;
        ret plan;
    }
    plan.partial = plan.span.outcome == range.SATISFIABLE;
    if (bodyless) { ret plan; }
    plan.answer         = ANSWER_BODY;
    plan.last_exclusive = snap.body_length;
    if (plan.partial) {
        plan.first          = plan.span.first::usize;
        plan.last_exclusive = (plan.span.last + 1)::usize;
    }
    ret plan;
}

# whether answering with `plan` reads the body off the disk
fun reads_disk(snap: *store.Snapshot, plan: *Plan) bool {
    ret plan.answer == ANSWER_BODY && snap.placement == store.ON_DISK;
}

# answer from a snapshot, taking the pin and the lease over: a body reader keeps
# what it reads through, and every other outcome lets both go before returning
fun prepare_stored(layer: *Layer, active: *call.Call, snap: *store.Snapshot, held: *store.Pin,
    lease: *Lease, plan: *Plan, now: time.Time) bool {
    val prepared: bool = emit_snapshot(layer, active, snap, held, lease, plan, now);
    if (held.held) { store.unpin(held); }
    end_lease(lease);
    ret prepared;
}

fun add_content_range(active: *call.Call, text: *u8, length: usize) bool {
    if (length == 0) { ret false; }
    val stored_text: *u8 = service.arena_bytes(active, length);
    if (stored_text == nil) { ret false; }
    memory.raw_copy(stored_text::ptr, text::ptr, length);
    ret message.add_field(call.response(active), field.Field{
        name:      view.view("content-range", 13),
        value:     view.view(stored_text, length),
        sensitive: false,
    }) == field.ADD_OK;
}

fun emit_snapshot(layer: *Layer, active: *call.Call, snap: *store.Snapshot,
    held: *store.Pin, lease: *Lease, plan: *Plan, now: time.Time) bool {
    val response: *message.Response = call.response(active);
    val request:  *message.Request  = call.request(active);
    if (response == nil || request == nil) { ret false; }

    if (plan.answer == ANSWER_PRECONDITION_FAILED) {
        if (message.set_status(response, status.PRECONDITION_FAILED)
            != message.RESPONSE_OK) { ret false; }
        ret prepare_bodyless(active);
    }
    if (plan.answer == ANSWER_NOT_MODIFIED) {
        if (message.set_status(response, status.NOT_MODIFIED) != message.RESPONSE_OK) {
            ret false;
        }
        if (!copy_stored_fields(snap, response, true, true)) { ret false; }
        if (!add_age(layer, active, snap, now))              { ret false; }
        ret prepare_bodyless(active);
    }
    if (plan.answer == ANSWER_UNSATISFIABLE) {
        var text:   [range.CONTENT_RANGE_CAPACITY]u8;
        val length: usize = range.format_unsatisfied(snap.body_length::u64, ?text[0],
            range.CONTENT_RANGE_CAPACITY);
        if (message.set_status(response, status.RANGE_NOT_SATISFIABLE) != message.RESPONSE_OK) {
            ret false;
        }
        if (!add_content_range(active, ?text[0], length)) { ret false; }
        ret prepare_bodyless(active);
    }

    var code: status.Status = snap.status;
    if (plan.partial) { code = status.PARTIAL_CONTENT; }
    if (message.set_status(response, code) != message.RESPONSE_OK) {
        ret false;
    }
    if (!copy_stored_fields(snap, response, false, true)) { ret false; }
    if (!add_age(layer, active, snap, now))               { ret false; }
    if (plan.partial) {
        var text:   [range.CONTENT_RANGE_CAPACITY]u8;
        val length: usize = range.format_content_range(plan.span, snap.body_length::u64,
            ?text[0], range.CONTENT_RANGE_CAPACITY);
        if (!add_content_range(active, ?text[0], length)) { ret false; }
    }
    if (plan.answer == ANSWER_BODYLESS) {
        if (!service.add_field(active, field.CONTENT_LENGTH,
            service.arena_number(active, snap.body_length::u64))) {
            ret false;
        }
        ret prepare_bodyless(active);
    }
    ret attach_stored_body(layer, active, held, lease, plan.first, plan.last_exclusive);
}

# a hit whose body comes off the disk, parked on its first read. it lives in the
# call's arena behind the call's finalizer, and holds the read slot until the
# read settles and the answer is written, or the call ends first
rec PendingHit {
    layer: *Layer;
    snap:  store.Snapshot;
    plan:  Plan;
    lease: Lease;
    shard: *store.Shard;
}

fun hit_finalize(context: ptr, active: *call.Call) bool {
    val pending: *PendingHit = context::*PendingHit;
    if (pending != nil) { end_lease(?pending.lease); }
    ret true;
}

fun commit_stored(layer: *Layer, active: *call.Call, snap: *store.Snapshot, held: *store.Pin,
    lease: *Lease, plan: *Plan, now: time.Time) exchange.ServiceStatus {
    if (!prepare_stored(layer, active, snap, held, lease, plan, now)) {
        ret exchange.SERVICE_FAILED;
    }
    if (!call.resolve_body(active, call.BODY_DRAIN))   { ret exchange.SERVICE_FAILED; }
    if (service.commit(active) != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
    ret exchange.SERVICE_COMPLETE;
}

# answer a hit selected with `shard` held, letting the lock go first
#
# a body on disk is read before anything is written into the response: its
# first read is issued here, so a refused one (no free read slot, no room on the
# store worker, a failed read) is a miss served from the origin rather than a
# response that fails part way through its body
fun serve_stored(binding: *Binding, shard: *store.Shard, active: *call.Call, index: usize,
    now: time.Time) exchange.ServiceStatus {
    val layer: *Layer    = binding.layer;
    var snap:  store.Snapshot;
    var held:  store.Pin = store.no_pin();
    val taken: bool      = take_hit(shard, active, index, ?snap, ?held, true);
    store.release(shard);
    if (!taken) {
        if (held.held) { store.unpin(?held); }
        ret exchange.SERVICE_FAILED;
    }
    var plan:  Plan  = plan_snapshot(call.request(active), ?snap);
    var lease: Lease = no_lease();
    if (!reads_disk(?snap, ?plan)) {
        if (counts_later(?snap)) { count_lookup(shard, true); }
        ret commit_stored(layer, active, ?snap, ?held, ?lease, ?plan, now);
    }
    lease.slot = open_slot(binding.recorders, ?held, plan.first, plan.last_exclusive,
        call.waker(active));
    if (lease.slot == nil) {
        store.unpin(?held);
        count_lookup(shard, false);
        ret pass(binding, active);
    }
    val first: store.ReadStatus = fill_slot(lease.slot);
    if (first == store.READ_DONE) {
        count_lookup(shard, true);
        ret commit_stored(layer, active, ?snap, ?held, ?lease, ?plan, now);
    }
    if (first == store.READ_FAILED) {
        end_lease(?lease);
        count_lookup(shard, false);
        ret pass(binding, active);
    }
    val a: *allocator.Allocator = call.allocator_of(active);
    if (a == nil) {
        end_lease(?lease);
        ret exchange.SERVICE_FAILED;
    }
    val allocated: res[*PendingHit, allocator.Error] = allocator.allocate[PendingHit](a, 1);
    if (sel allocated.err) {
        end_lease(?lease);
        ret exchange.SERVICE_FAILED;
    }
    val pending: *PendingHit = allocated.ok;
    pending.layer = layer;
    pending.snap  = snap;
    pending.plan  = plan;
    pending.lease = lease;
    pending.shard = shard;
    if (!call.attach_finalizer(active, call.Finalizer{ctx: (pending)::ptr,
        finish: hit_finalize})) {
        end_lease(?pending.lease);
        ret exchange.SERVICE_FAILED;
    }
    ret call.park(active, call.WAIT_WAKE, 0);
}

# a hit parked on its first disk read is entered again: it parks again until the
# read settles, then answers from the store, or from the origin when it failed
fun resume_hit(binding: *Binding, active: *call.Call,
    pending: *PendingHit) exchange.ServiceStatus {
    val first: store.ReadStatus = ready_slot(pending.lease.slot);
    if (first == store.READ_PENDING) { ret call.park(active, call.WAIT_WAKE, 0); }
    if (!call.detach_finalizer(active, hit_finalize)) {
        end_lease(?pending.lease);
        ret exchange.SERVICE_FAILED;
    }
    if (first == store.READ_FAILED) {
        end_lease(?pending.lease);
        count_lookup(pending.shard, false);
        ret pass(binding, active);
    }
    count_lookup(pending.shard, true);
    var held: store.Pin = store.no_pin();
    ret commit_stored(pending.layer, active, ?pending.snap, ?held, ?pending.lease,
        ?pending.plan, wall_now());
}

# --- recording a response into the store ---

fun free_recording(recorders: *Recorders) *Recording {
    var i: usize = 0;
    for (i < MAX_RECORDERS) {
        val state: *Recording = ?recorders.slots[i];
        if (state.owner == nil && !state.closing) { ret state; }
        i = i + 1;
    }
    ret nil;
}

fun restore_request_fields(state: *Recording) bool {
    if (!state.conditioned) { ret true; }
    val request:         *message.Request = call.request(state.owner);
    val condition_bytes: usize            = state.condition_name.len + state.condition_value.len;
    if (request == nil || request.fields.len <= state.request_field_len
        || request.fields.bytes < state.request_field_bytes + condition_bytes) {
        ret false;
    }
    var found: usize = store.NO_ENTRY;
    var i:     usize = state.request_field_len;
    for (i < request.fields.len) {
        val item: *field.Field = ?request.fields.items[i];
        if (item.name.data == state.condition_name.data
            && item.name.len == state.condition_name.len
            && item.value.data == state.condition_value.data
            && item.value.len == state.condition_value.len) {
            found = i;
            i     = request.fields.len;
        }
        or { i = i + 1; }
    }
    if (found == store.NO_ENTRY) { ret false; }
    i = found;
    for (i + 1 < request.fields.len) {
        request.fields.items[i] = request.fields.items[i + 1];
        i                       = i + 1;
    }
    request.fields.len   = request.fields.len - 1;
    request.fields.bytes = request.fields.bytes - condition_bytes;
    state.conditioned    = false;
    ret true;
}

fun has_client_precondition(request: *message.Request) bool {
    ret request_header(request, field.IF_MATCH, 8).data != nil
        || request_header(request, "if-unmodified-since", 19).data != nil
        || request_header(request, field.IF_NONE_MATCH, 13).data != nil
        || request_header(request, field.IF_MODIFIED_SINCE, 17).data != nil;
}

fun has_origin_precondition(request: *message.Request) bool {
    ret request_header(request, field.IF_MATCH, 8).data != nil
        || request_header(request, "if-unmodified-since", 19).data != nil;
}

# the validator a revalidation sends the origin, copied out of the entry with its
# shard held, so the request never points into a stored entry
rec Condition {
    name:  view.View;
    value: view.View;
}

fun no_condition() Condition {
    ret Condition{name: view.view(nil, 0), value: view.view(nil, 0)};
}

fun take_condition(entry: *store.Entry, active: *call.Call) Condition {
    val request: *message.Request = call.request(active);
    if (request == nil || has_client_precondition(request)) { ret no_condition(); }
    val stored: Stored    = entry_fields(entry);
    var name:   view.View = view.view(nil, 0);
    var value:  view.View = stored_field(stored, field.ETAG);
    if (value.data != nil && value.len != 0) {
        name = view.view(field.IF_NONE_MATCH, 13);
    }
    or {
        value = stored_field(stored, field.LAST_MODIFIED);
        if (value.data == nil || value.len == 0) { ret no_condition(); }
        name = view.view(field.IF_MODIFIED_SINCE, 17);
    }
    val copied: *u8 = service.arena_bytes(active, value.len);
    if (copied == nil) { ret no_condition(); }
    memory.raw_copy(copied::ptr, value.data::ptr, value.len);
    ret Condition{name: name, value: view.view(copied, value.len)};
}

fun condition_request(state: *Recording, condition: Condition) bool {
    val request: *message.Request = call.request(state.owner);
    if (request == nil || condition.name.data == nil) { ret false; }
    state.request_field_len   = request.fields.len;
    state.request_field_bytes = request.fields.bytes;
    if (field.append(?request.fields, field.Field{
        name:      condition.name,
        value:     condition.value,
        sensitive: false,
    }) != field.ADD_OK) { ret false; }
    state.condition_name  = condition.name;
    state.condition_value = condition.value;
    state.conditioned     = true;
    ret true;
}

fun disk_bound(state: *Recording) bool {
    ret state.writer.active && state.writer.placement == store.ON_DISK;
}

# settle the staged write in flight, if any, and give its bytes back to staging
fun settle_stage(state: *Recording) store.Written {
    if (state.stage_inflight == 0) { ret store.WRITE_DONE; }
    val settled: store.Written = store.settle_write(?state.writer);
    if (settled != store.WRITE_DONE) { ret settled; }
    val rest: usize = state.stage_filled - state.stage_inflight;
    if (rest != 0) {
        memory.raw_move(state.stage::ptr, (?state.stage[state.stage_inflight])::ptr, rest);
    }
    state.stage_filled   = rest;
    state.stage_inflight = 0;
    ret store.WRITE_DONE;
}

# write what is staged, unless a write is already in flight
fun submit_stage(state: *Recording) store.Written {
    if (state.stage_inflight != 0 || state.stage_filled == 0) { ret store.WRITE_DONE; }
    state.stage_inflight = state.stage_filled;
    val submitted: store.Written = store.write_body(?state.writer, state.stage,
        state.stage_filled, state.recorders.waker);
    if (submitted == store.WRITE_FAILED) {
        state.stage_inflight = 0;
        ret store.WRITE_FAILED;
    }
    if (submitted == store.WRITE_PENDING) { ret store.WRITE_PENDING; }
    state.stage_filled   = 0;
    state.stage_inflight = 0;
    ret store.WRITE_DONE;
}

# stage body bytes for the disk. while a write is in flight the next bytes wait
# in staging, and bytes that do not fit drop the recording rather than block
fun stage_body(state: *Recording, data: *u8, length: usize) bool {
    if (state.stage == nil) { ret false; }
    var at: usize = 0;
    for (at < length) {
        if (settle_stage(state) == store.WRITE_FAILED) { ret false; }
        var take: usize = STAGE_BYTES - state.stage_filled;
        if (take == 0)          { ret false; }
        if (take > length - at) { take = length - at; }
        memory.raw_copy((?state.stage[state.stage_filled])::ptr, (?data[at])::ptr, take);
        state.stage_filled = state.stage_filled + take;
        at                 = at + take;
        if (submit_stage(state) == store.WRITE_FAILED) { ret false; }
    }
    ret true;
}

# finish a recording whose response has ended: once nothing is in flight the
# entry is published, when it is whole and wanted, or dropped
fun advance_closing(state: *Recording) bool {
    if (disk_bound(state)) {
        var settled: bool = false;
        for (!settled) {
            val step: store.Written = settle_stage(state);
            if (step == store.WRITE_PENDING) { ret false; }
            if (step == store.WRITE_FAILED) {
                state.keep           = false;
                state.stage_inflight = 0;
            }
            if (state.keep && state.stage_filled != 0) {
                val submitted: store.Written = submit_stage(state);
                if (submitted == store.WRITE_PENDING) { ret false; }
                if (submitted == store.WRITE_FAILED)  { state.keep = false; }
            }
            or { settled = true; }
        }
    }
    if (state.writer.active) {
        if (state.keep && state.written == state.declared) { store.commit(?state.writer); }
        or                                                 { store.abandon(?state.writer); }
    }
    state.stage_filled   = 0;
    state.stage_inflight = 0;
    state.closing        = false;
    ret true;
}

fun stop_recording(state: *Recording, keep: bool) {
    if (!state.active) { ret; }
    restore_request_fields(state);
    if (state.revalidation.held) { store.end_revalidation(?state.revalidation); }
    state.revalidating_index = store.NO_ENTRY;
    state.active             = false;
    state.keep               = keep;
    state.closing            = true;
    advance_closing(state);
}

fun release_recording(state: *Recording, keep: bool) {
    if (state == nil) { ret; }
    stop_recording(state, keep);
    state.owner = nil;
}

fun fail_interception(state: *Recording) call.Interception {
    stop_recording(state, false);
    ret call.INTERCEPT_FAILED;
}

# refresh or replace a response to a revalidation, with the shard held. answers
# the interception, or INTERCEPT_FAILED with nothing left to undo
fun intercept_locked(state: *Recording, shard: *store.Shard, active: *call.Call,
    internal_condition: bool, snap: *store.Snapshot, held: *store.Pin,
    stop: *bool) call.Interception {
    val response: *message.Response = call.response(active);
    val entry:    *store.Entry      = store.entry_at(shard, state.revalidating_index);
    if (response == nil || entry == nil) { ret call.INTERCEPT_FAILED; }
    val now: time.Time = wall_now();
    # a 304 belongs to the party that supplied its condition. cache conditions
    # are consumed here, client conditions are forwarded, and no-condition 304s
    # fail closed rather than changing an unconditional request's semantics.
    val client_condition: bool = has_client_precondition(call.request(active));
    if (response.status == status.NOT_MODIFIED
        && !internal_condition && !client_condition) {
        ret call.INTERCEPT_FAILED;
    }
    val client_matches: bool = client_condition
        && validator.evaluate(call.request(active), stored_validators(entry_fields(entry)))
        == validator.NOT_MODIFIED;
    val refresh: bool = response.status == status.NOT_MODIFIED
        && (internal_condition || client_matches);
    if (refresh) {
        var targets:      [store.MAX_ENTRIES]usize;
        val target_count: usize = refresh_targets(shard, entry,
            call.request(active), response, ?targets[0]);
        if (target_count == 0) { ret call.INTERCEPT_FAILED; }
        var selected_result: RefreshStatus = REFRESH_FAILED;
        var i:               usize         = 0;
        for (i < target_count) {
            val selected_target: bool          = targets[i] == state.revalidating_index;
            val planned:         RefreshStatus = refresh_entry(state, shard, active, now,
                targets[i], false);
            if (planned == REFRESH_FAILED) { ret call.INTERCEPT_FAILED; }
            if (selected_target)           { selected_result = planned; }
            i = i + 1;
        }
        i = 0;
        for (i < target_count) {
            val applied: RefreshStatus = refresh_entry(state, shard, active, now,
                targets[i], true);
            if (applied == REFRESH_FAILED) { ret call.INTERCEPT_FAILED; }
            i = i + 1;
        }
        # the client's condition still earned this 304 even when its metadata
        # makes the matching stored response unusable. only a synthetic cache
        # condition must consume the 304 rather than forwarding it.
        if (selected_result == REFRESH_INVALIDATED && client_condition) {
            @stop = true;
            ret call.INTERCEPT_CONTINUE;
        }
        if (selected_result != REFRESH_UPDATED) { ret call.INTERCEPT_FAILED; }
        if (client_condition) {
            @stop = true;
            ret call.INTERCEPT_CONTINUE;
        }
    }
    var replace: bool = internal_condition && response.status == status.NOT_MODIFIED;
    if (!replace && policy.revalidation_failure(response.status)
        && policy.servable_on_error(entry.metadata, now)) { replace = true; }
    # a response the origin answered in full is recorded, so the recording stays
    # live for it
    if (!replace) { ret call.INTERCEPT_CONTINUE; }
    if (!take_hit(shard, active, state.revalidating_index, snap, held, false)) {
        ret call.INTERCEPT_FAILED;
    }
    ret call.INTERCEPT_REPLACED;
}

fun intercept(context: ptr, active: *call.Call) call.Interception {
    val state: *Recording = context::*Recording;
    if (state == nil || !state.active || state.owner != active
        || state.revalidating_index == store.NO_ENTRY
        || !state.revalidation.held) { ret call.INTERCEPT_FAILED; }
    val internal_condition: bool = state.conditioned;
    if (!restore_request_fields(state)) { ret fail_interception(state); }
    val shard: *store.Shard = state.revalidation.shard;
    var snap:  store.Snapshot;
    var held:  store.Pin    = store.no_pin();
    var stop:  bool         = false;
    store.lock(shard);
    val outcome: call.Interception = intercept_locked(state, shard, active,
        internal_condition, ?snap, ?held, ?stop);
    store.release(shard);
    if (outcome == call.INTERCEPT_FAILED) {
        if (held.held) { store.unpin(?held); }
        ret fail_interception(state);
    }
    if (outcome == call.INTERCEPT_CONTINUE) {
        # a 304 forwarded to the client that conditioned it records nothing
        if (stop) { stop_recording(state, false); }
        ret call.INTERCEPT_CONTINUE;
    }
    stop_recording(state, false);
    # the origin has answered, so a stored body the disk refuses cannot go back
    # to it: the exchange fails before anything of the stored answer is sent
    var plan:  Plan  = plan_snapshot(call.request(active), ?snap);
    var lease: Lease = no_lease();
    if (reads_disk(?snap, ?plan)) {
        lease.slot = open_slot(state.recorders, ?held, plan.first, plan.last_exclusive,
            call.waker(active));
        if (lease.slot == nil || fill_slot(lease.slot) == store.READ_FAILED) {
            end_lease(?lease);
            if (held.held) { store.unpin(?held); }
            ret call.INTERCEPT_FAILED;
        }
    }
    if (!call.reset_response_for_interceptor(active)
        || !prepare_stored(state.layer, active, ?snap, ?held, ?lease, ?plan, wall_now())) {
        if (held.held) { store.unpin(?held); }
        end_lease(?lease);
        ret call.INTERCEPT_FAILED;
    }
    ret call.INTERCEPT_REPLACED;
}

fun on_head(context: ptr, active: *call.Call) bool {
    val state: *Recording = context::*Recording;
    if (state == nil || !state.active) { ret false; }
    val layer:    *Layer            = state.layer;
    val request:  *message.Request  = call.request(active);
    val response: *message.Response = call.response(active);
    if (request == nil || response == nil) { ret false; }
    val response_directives: directives.Directives = directives.parse(?response.fields);
    val request_directives:  directives.Directives = directives.parse(?request.fields);
    if (policy.storable(request, ?response.fields, response.status, request_directives,
        response_directives, layer.limits) != policy.STORE) { ret false; }
    if (response.body_kind == message.BODY_READER && !response.body_reader.has_length) {
        ret false;
    }
    var declared: u64 = 0;
    if (response.body_kind == message.BODY_READER) {
        declared = response.body_reader.declared_length;
    }
    var identity: key.Key;
    if (!key.make(request, active.secure, ?identity)
        || !scope_key(?identity, state.generation)) { ret false; }
    var dimensions: key.Dimensions;
    if (!key.select(request, ?response.fields, ?dimensions) || !dimensions.valid) { ret false; }
    val now:      time.Time       = wall_now();
    val metadata: policy.Metadata = policy.describe(?response.fields, response.status,
        response_directives, now, now, layer.limits);
    # a disk entry is written through staging, which a worker without it lacks
    var placement: store.Placement = store.IN_MEMORY;
    if (state.stage != nil && declared::usize > layer.backing.limits.memory_bytes / 4) {
        placement = store.ON_DISK;
    }
    state.writer = store.begin(?layer.backing, ?identity, ?dimensions, metadata,
        response.status, declared::usize, placement);
    if (!state.writer.active) { ret false; }
    state.declared       = declared::usize;
    state.written        = 0;
    state.stage_filled   = 0;
    state.stage_inflight = 0;
    var i: usize = 0;
    for (i < response.fields.len) {
        val item: *field.Field = ?response.fields.items[i];
        # hop-by-hop fields belong to the connection that carried them, not to the
        # representation, so a stored entry must not replay them at the next client,
        # and a field the origin named as one user's own is dropped with them
        if (forward.forwardable(?response.fields, item.name)
            && !policy.excluded_field(response_directives, item.name)) {
            if (!store.add_field(?state.writer, item.name, item.value)) {
                store.abandon(?state.writer);
                ret false;
            }
        }
        i = i + 1;
    }
    ret true;
}

fun on_body(context: ptr, data: *u8, length: usize) bool {
    val state: *Recording = context::*Recording;
    if (state == nil || !state.active || !state.writer.active) { ret false; }
    if (state.written + length > state.declared)               { ret false; }
    if (disk_bound(state)) {
        if (!stage_body(state, data, length)) { ret false; }
    }
    or (store.write_body(?state.writer, data, length, state.recorders.waker)
        != store.WRITE_DONE) {
        ret false;
    }
    state.written = state.written + length;
    ret true;
}

fun on_end(context: ptr, complete: bool) {
    val state: *Recording = context::*Recording;
    if (state == nil) { ret; }
    release_recording(state, complete);
}

# --- the handler ---

pub rec Binding {
    layer:      *Layer;
    recorders:  *Recorders;
    inner:      service.Handler;
    generation: u64;
}

fun forward_to_inner(binding: *Binding, active: *call.Call) exchange.ServiceStatus {
    ret binding.inner.serve(binding.inner.ctx, active);
}

# the head of the recorder that marks a call this cache sent to its inner
# service without recording it. it records nothing
fun pass_head(context: ptr, active: *call.Call) bool {
    ret false;
}

# whether this cache already sent the call to its inner service, recording it
# or not. such a call is entered again only because its inner service parked,
# and goes straight back to it. the head alone names the binding because a call
# meets at most one: `plan.compile_service` wraps each service once, and no
# service a plan builds serves another handler on the same call
fun passed(active: *call.Call) bool {
    ret call.recorded_by(active, on_head) || call.recorded_by(active, pass_head);
}

# send the call to the inner service, marked so that entering it again resumes
# the inner service rather than looking the key up a second time. a call that
# cannot be marked fails, since unmarked it could be answered from the store
# while the inner service still holds it
fun pass(binding: *Binding, active: *call.Call) exchange.ServiceStatus {
    if (!passed(active) && !call.attach_recorder(active, call.Recorder{
        ctx:     nil,
        on_head: pass_head,
        on_body: (0::usize)::call.RecordBodyFun,
        on_end: (0::usize)::call.RecordEndFun,
    })) { ret exchange.SERVICE_FAILED; }
    ret forward_to_inner(binding, active);
}

fun forward_miss(binding: *Binding, shard: *store.Shard,
    active: *call.Call) exchange.ServiceStatus {
    store.record_miss(shard);
    store.release(shard);
    ret pass(binding, active);
}

pub fun serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val binding: *Binding = context::*Binding;
    if (binding == nil || !service.has_handler(binding.inner)) {
        ret service.respond(active, status.INTERNAL_SERVER_ERROR);
    }
    val layer:     *Layer     = binding.layer;
    val recorders: *Recorders = binding.recorders;
    # a route with no cache runs the service and nothing else
    if (!enabled(layer) || recorders == nil || !recorders.live) {
        ret forward_to_inner(binding, active);
    }
    # a hit parked on its first disk read resumes where it parked
    val pending: *PendingHit = call.finalizer_state(active, hit_finalize)::*PendingHit;
    if (pending != nil) { ret resume_hit(binding, active, pending); }
    # a call this cache already sent to the inner service keeps that choice, so
    # entering it again resumes the inner service and nothing else
    if (passed(active)) { ret forward_to_inner(binding, active); }
    val request: *message.Request = call.request(active);
    if (request == nil) { ret pass(binding, active); }
    val now:      time.Time = wall_now();
    var identity: key.Key;
    val keyed:    bool      = key.make(request, active.secure, ?identity)
        && scope_key(?identity, binding.generation);
    val request_directives: directives.Directives = directives.parse(?request.fields);

    # an unsafe method invalidates what this cache holds for the target, under
    # every method key a stored representation could be filed against
    if (policy.invalidates(request.method.kind, status.OK)) {
        var target_key: key.Key;
        if (key.make_with_method(request, active.secure, method.GET, ?target_key)
            && scope_key(?target_key, binding.generation)) {
            store.invalidate(?layer.backing, ?target_key);
        }
        if (key.make_with_method(request, active.secure, method.HEAD, ?target_key)
            && scope_key(?target_key, binding.generation)) {
            store.invalidate(?layer.backing, ?target_key);
        }
        ret pass(binding, active);
    }
    if (!keyed) { ret pass(binding, active); }

    val shard: *store.Shard = store.acquire(?layer.backing, ?identity);
    if (shard == nil) { ret pass(binding, active); }
    # one key may hold several representations of the same target, so every entry
    # filed under it is a candidate and the selecting values decide which answers.
    # taking the first match instead would serve a representation negotiated for
    # somebody else, and would leave every other variant permanently unreachable.
    var index:           usize     = store.NO_ENTRY;
    var newest_time:     time.Time = time.Time{sec: 0, nsec: 0};
    var newest_sequence: u64       = 0;
    var candidate:       usize     = store.find_from(shard, ?identity, 0);
    for (candidate != store.NO_ENTRY) {
        val held: *store.Entry = store.entry_at(shard, candidate);
        if (held != nil && key.matches(?held.dimensions, request)) {
            val held_time: time.Time = response_time(held);
            if (index == store.NO_ENTRY
                || time.time_after(held_time, newest_time)
                || (time.time_equal(held_time, newest_time)
                && held.stored_at > newest_sequence)) {
                index           = candidate;
                newest_time     = held_time;
                newest_sequence = held.stored_at;
            }
        }
        candidate = store.find_from(shard, ?identity, candidate + 1);
    }
    var revalidation: store.Pin = store.no_pin();
    var condition:    Condition = no_condition();
    if (index != store.NO_ENTRY) {
        val entry: *store.Entry = store.entry_at(shard, index);
        # a shared cache is not the origin authority for state-changing
        # preconditions, even when it has a fresh representation.
        if (has_origin_precondition(request)) { ret forward_miss(binding, shard, active); }
        val decision: policy.Reuse = policy.reuse(entry.metadata, request_directives, now);
        if (decision == policy.FRESH || decision == policy.STALE_SERVABLE) {
            ret serve_stored(binding, shard, active, index, now);
        }
        if (decision == policy.REVALIDATE) {
            if (entry.revalidating) {
                if (policy.servable_on_error(entry.metadata, now)) {
                    ret serve_stored(binding, shard, active, index, now);
                }
                ret forward_miss(binding, shard, active);
            }
            # the revalidation pins what it revalidates, so the slot it names
            # cannot be reused by another entry while the origin answers
            revalidation = store.pin(shard, index);
            if (revalidation.held) {
                entry.revalidating = true;
                condition          = take_condition(entry, active);
            }
        }
    }
    store.record_miss(shard);
    store.release(shard);
    val state: *Recording = free_recording(recorders);
    if (state == nil) {
        if (revalidation.held) { store.end_revalidation(?revalidation); }
        ret pass(binding, active);
    }
    state.layer              = layer;
    state.active             = true;
    state.closing            = false;
    state.keep               = false;
    state.owner              = active;
    state.generation         = binding.generation;
    state.requested_at       = now;
    state.declared           = 0;
    state.written            = 0;
    state.revalidation       = revalidation;
    state.revalidating_index = store.NO_ENTRY;
    if (revalidation.held) { state.revalidating_index = revalidation.index; }
    state.conditioned         = false;
    state.request_field_len   = 0;
    state.request_field_bytes = 0;
    state.condition_name      = view.view(nil, 0);
    state.condition_value     = view.view(nil, 0);
    state.stage_filled        = 0;
    state.stage_inflight      = 0;
    state.writer              = store.Writer{store: nil, shard: nil, index: store.NO_ENTRY,
        active:  false, placement: store.IN_MEMORY, reserved: 0, written: 0, pending: false,
        request: disk.idle()};
    if (!call.attach_recorder(active, call.Recorder{
        ctx: (state)::ptr,
        on_head: on_head,
        on_body: on_body,
        on_end:  on_end,
    })) {
        release_recording(state, false);
    }
    or (revalidation.held) {
        if (!call.attach_interceptor(active, call.Interceptor{
            ctx: (state)::ptr,
            intercept: intercept,
        })) {
            stop_recording(state, false);
        }
        or {
            condition_request(state, condition);
        }
    }
    ret pass(binding, active);
}

# wrap one service handler in this layer; a disabled layer returns the handler
# unchanged, so a route with caching off does not even hold a binding
pub fun wrap(binding: *Binding, layer: *Layer, recorders: *Recorders, inner: service.Handler,
    generation: u64) service.Handler {
    if (binding == nil || !service.has_handler(inner)) { ret service.no_handler(); }
    if (!enabled(layer))                               { ret inner; }
    binding.layer      = layer;
    binding.recorders  = recorders;
    binding.inner      = inner;
    binding.generation = generation;
    ret service.Handler{ctx: (binding)::ptr, serve: serve};
}

# the generation-owned bindings a plan draws from while it is being constructed.
# they name the recordings of the worker that serves the plan, while the layer
# they name is shared by every worker
pub rec Bindings {
    items:      *Binding;
    capacity:   usize;
    len:        usize;
    layer:      *Layer;
    recorders:  *Recorders;
    generation: u64;
}

pub fun make_bindings(bindings: *Bindings, items: *Binding, capacity: usize,
    layer: *Layer, recorders: *Recorders, generation: u64) bool {
    if (bindings == nil || (capacity != 0 && items == nil) || generation == 0) {
        ret false;
    }
    bindings.items      = items;
    bindings.capacity   = capacity;
    bindings.len        = 0;
    bindings.layer      = layer;
    bindings.recorders  = recorders;
    bindings.generation = generation;
    ret true;
}

pub fun release_bindings(bindings: *Bindings) bool {
    if (bindings == nil || bindings.generation == 0) { ret false; }
    bindings.len        = 0;
    bindings.generation = 0;
    ret true;
}

# the wrapper the service resolver installs
#
# a service that did not ask to be cached is returned untouched, so the layer
# costs it nothing at all: not a binding, not a pointer, not a branch per request.
pub fun wrapper(context: ptr, configured: *schema.Service, inner: service.Handler,
    output: *service.Handler) bool {
    val bindings: *Bindings = context::*Bindings;
    if (bindings == nil || configured == nil || output == nil) { ret false; }
    if (!configured.cache || !enabled(bindings.layer)) {
        @output = inner;
        ret true;
    }
    if (bindings.len >= bindings.capacity) { ret false; }
    val binding: *Binding        = ?bindings.items[bindings.len];
    val wrapped: service.Handler = wrap(binding, bindings.layer, bindings.recorders, inner,
        bindings.generation);
    if (!service.has_handler(wrapped)) { ret false; }
    bindings.len = bindings.len + 1;
    @output      = wrapped;
    ret true;
}

# build a layer from configuration; a configuration with caching off constructs
# nothing and reports that plainly
pub fun from_config(layer: *Layer, configured: *schema.Cache, entries: *store.Entry,
    capacity: usize, body_storage: *u8, body_capacity: usize, shards: usize,
    scratch: *allocator.Allocator) bool {
    if (layer == nil || configured == nil) { ret false; }
    if (!configured.enabled) {
        layer.live    = false;
        layer.backing = store.disabled();
        ret false;
    }
    var limits: store.Limits = store.default_limits();
    limits.memory_bytes    = configured.memory_bytes;
    limits.disk_bytes      = configured.disk_bytes;
    limits.max_entry_bytes = configured.max_entry_bytes;
    limits.entries         = configured.entries;
    if (limits.memory_bytes > body_capacity) { limits.memory_bytes = body_capacity; }
    var freshness: policy.Limits = policy.default_limits();
    freshness.heuristic_percent = configured.heuristic_percent;
    if (!make(layer, entries, capacity, body_storage, body_capacity, limits, freshness, shards)) {
        ret false;
    }
    if (configured.disk_bytes != 0 && configured.disk_root.len != 0) {
        if (!attach_disk(layer, schema.text(?configured.disk_root), scratch)) {
            close(layer, 0);
            ret false;
        }
    }
    ret true;
}
