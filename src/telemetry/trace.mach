# strict bounded W3C trace propagation

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use crypto_rand: std.crypto.rand;
use io_error: std.io.error;
use std.types.error.err;

pub val TRACEPARENT_LENGTH: usize = 55;
pub val TRACESTATE_CAPACITY: usize = 512;
pub val TRACESTATE_MEMBERS: usize = 32;

pub rec Context {
    version: u8;
    trace_id: [16]u8;
    parent_id: [8]u8;
    flags: u8;
    tracestate: [513]u8;
    tracestate_len: usize;
    tracestate_valid: bool;
    remote: bool;
    propagate: bool;
}

fun hex_value(byte: u8, output: *u8) bool {
    if (byte >= '0' && byte <= '9') { @output = byte - '0'; ret true; }
    if (byte >= 'a' && byte <= 'f') { @output = byte - 'a' + 10; ret true; }
    ret false;
}

fun parse_hex(text: str, start: usize, output: *u8, length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        var high: u8 = 0;
        var low: u8 = 0;
        if (!hex_value(text[start + i * 2], ?high) || !hex_value(text[start + i * 2 + 1], ?low)) { ret false; }
        output[i] = (high << 4) | low;
        i = i + 1;
    }
    ret true;
}

fun all_zero(data: *u8, length: usize) bool {
    var value: u8 = 0;
    var i: usize = 0;
    for (i < length) { value = value | data[i]; i = i + 1; }
    ret value == 0;
}

fun lowercase(byte: u8) bool {
    ret byte >= 'a' && byte <= 'z';
}

fun base_key_char(byte: u8) bool {
    ret lowercase(byte) || (byte >= '0' && byte <= '9') || byte == '_' || byte == '-' || byte == '*' || byte == '/';
}

fun valid_key(value: str, start: usize, length: usize) bool {
    if (length == 0 || length > 256) { ret false; }
    var at: usize = length;
    var i: usize = 0;
    for (i < length) {
        val byte: u8 = value[start + i];
        if (byte == '@') {
            if (at != length) { ret false; }
            at = i;
        } or (byte == '=') {
            ret false;
        } or (!base_key_char(byte)) {
            ret false;
        }
        i = i + 1;
    }
    if (at == length) { ret lowercase(value[start]); }
    val tenant_length: usize = at;
    val system_length: usize = length - at - 1;
    if (tenant_length == 0 || tenant_length > 241 || system_length == 0 || system_length > 14) { ret false; }
    val tenant_first: u8 = value[start];
    if (!lowercase(tenant_first) && !(tenant_first >= '0' && tenant_first <= '9')) { ret false; }
    ret lowercase(value[start + at + 1]);
}

fun key_equals(value: str, left_start: usize, left_len: usize, right_start: usize, right_len: usize) bool {
    if (left_len != right_len) { ret false; }
    var i: usize = 0;
    for (i < left_len) {
        if (value[left_start + i] != value[right_start + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun valid_tracestate(value: str, output: *Context, capacity: usize) bool {
    if (capacity == 0 || capacity > TRACESTATE_CAPACITY) { ret false; }
    if (value == nil) {
        output.tracestate_len = 0;
        output.tracestate[0] = 0;
        output.tracestate_valid = true;
        ret true;
    }
    val length: usize = str_len(value);
    if (length > capacity) { ret false; }
    var key_starts: [32]usize;
    var key_lengths: [32]usize;
    var key_count: usize = 0;
    var member_count: usize = 0;
    var cursor: usize = 0;
    for (cursor <= length) {
        if (member_count >= TRACESTATE_MEMBERS) { ret false; }
        var end: usize = cursor;
        for (end < length && value[end] != ',') {
            val byte: u8 = value[end];
            if ((byte < 0x20 || byte > 0x7e) && byte != '\t') { ret false; }
            end = end + 1;
        }
        var first: usize = cursor;
        for (first < end && (value[first] == ' ' || value[first] == '\t')) { first = first + 1; }
        var last: usize = end;
        for (last > first && (value[last - 1] == ' ' || value[last - 1] == '\t')) { last = last - 1; }
        if (first < last) {
            var equals: usize = first;
            for (equals < last && value[equals] != '=') { equals = equals + 1; }
            val key_length: usize = equals - first;
            if (equals == last || !valid_key(value, first, key_length)) { ret false; }
            val value_start: usize = equals + 1;
            val value_length: usize = last - value_start;
            if (value_length == 0 || value_length > 256 || value[last - 1] == ' ') { ret false; }
            var i: usize = value_start;
            for (i < last) {
                val byte: u8 = value[i];
                if (byte < 0x20 || byte > 0x7e || byte == ',' || byte == '=') { ret false; }
                i = i + 1;
            }
            i = 0;
            for (i < key_count) {
                if (key_equals(value, key_starts[i], key_lengths[i], first, key_length)) { ret false; }
                i = i + 1;
            }
            key_starts[key_count] = first;
            key_lengths[key_count] = key_length;
            key_count = key_count + 1;
        }
        member_count = member_count + 1;
        if (end == length) { cursor = length + 1; }
        or { cursor = end + 1; }
    }
    var i: usize = 0;
    for (i < length) { output.tracestate[i] = value[i]; i = i + 1; }
    output.tracestate[length] = 0;
    output.tracestate_len = length;
    output.tracestate_valid = true;
    ret true;
}

pub fun parse_bounded(traceparent: str, tracestate: str, tracestate_capacity: usize, output: *Context) bool {
    if (traceparent == nil || output == nil || str_len(traceparent) != TRACEPARENT_LENGTH
        || traceparent[2] != '-' || traceparent[35] != '-' || traceparent[52] != '-') {
        ret false;
    }
    var version: u8 = 0;
    if (!parse_hex(traceparent, 0, ?version, 1) || version != 0) { ret false; }
    if (!parse_hex(traceparent, 3, ?output.trace_id[0], 16) || all_zero(?output.trace_id[0], 16)) { ret false; }
    if (!parse_hex(traceparent, 36, ?output.parent_id[0], 8) || all_zero(?output.parent_id[0], 8)) { ret false; }
    if (!parse_hex(traceparent, 53, ?output.flags, 1)) { ret false; }
    output.flags = output.flags & 1;
    output.version = version;
    output.remote = true;
    output.propagate = true;
    if (!valid_tracestate(tracestate, output, tracestate_capacity)) {
        output.tracestate[0] = 0;
        output.tracestate_len = 0;
        output.tracestate_valid = false;
    }
    ret true;
}

pub fun parse(traceparent: str, tracestate: str, output: *Context) bool {
    ret parse_bounded(traceparent, tracestate, TRACESTATE_CAPACITY, output);
}

fun fill_nonzero(data: *u8, length: usize) bool {
    var attempts: usize = 0;
    for (attempts < 4) {
        val filled: err[io_error.Error] = crypto_rand.fill(data, length);
        if (sel filled.err) { ret false; }
        if (!all_zero(data, length)) { ret true; }
        attempts = attempts + 1;
    }
    ret false;
}

pub fun make_root(context: *Context, sampled: bool) bool {
    if (context == nil || !fill_nonzero(?context.trace_id[0], 16) || !fill_nonzero(?context.parent_id[0], 8)) { ret false; }
    context.version = 0;
    context.flags = 0;
    if (sampled) { context.flags = 1; }
    context.tracestate_len = 0;
    context.tracestate[0] = 0;
    context.tracestate_valid = true;
    context.remote = false;
    context.propagate = false;
    ret true;
}

pub fun make_child(parent: *Context, child: *Context) bool {
    if (parent == nil || child == nil || all_zero(?parent.trace_id[0], 16) || !fill_nonzero(?child.parent_id[0], 8)) { ret false; }
    child.version = 0;
    child.trace_id = parent.trace_id;
    child.flags = parent.flags;
    child.tracestate_len = parent.tracestate_len;
    child.tracestate_valid = parent.tracestate_valid;
    var i: usize = 0;
    for (i <= parent.tracestate_len) { child.tracestate[i] = parent.tracestate[i]; i = i + 1; }
    child.remote = false;
    child.propagate = parent.propagate;
    ret true;
}

fun hex_digit(value: u8) u8 {
    if (value < 10) { ret '0' + value; }
    ret 'a' + value - 10;
}

fun write_hex(data: *u8, length: usize, output: *u8, offset: usize) {
    var i: usize = 0;
    for (i < length) {
        output[offset + i * 2] = hex_digit(data[i] >> 4);
        output[offset + i * 2 + 1] = hex_digit(data[i] & 15);
        i = i + 1;
    }
}

pub fun format(context: *Context, output: *u8, capacity: usize) usize {
    if (context == nil || output == nil || capacity <= TRACEPARENT_LENGTH || context.version != 0
        || all_zero(?context.trace_id[0], 16) || all_zero(?context.parent_id[0], 8)) {
        ret 0;
    }
    output[0] = '0';
    output[1] = '0';
    output[2] = '-';
    write_hex(?context.trace_id[0], 16, output, 3);
    output[35] = '-';
    write_hex(?context.parent_id[0], 8, output, 36);
    output[52] = '-';
    output[53] = hex_digit(context.flags >> 4);
    output[54] = hex_digit(context.flags & 15);
    output[55] = 0;
    ret TRACEPARENT_LENGTH;
}

pub fun format_id(context: *Context, output: *u8, capacity: usize) usize {
    if (context == nil || output == nil || capacity < 33
     || all_zero(?context.trace_id[0], 16)) { ret 0; }
    write_hex(?context.trace_id[0], 16, output, 0);
    output[32] = 0;
    ret 32;
}

test "telemetry trace: strict remote context round trips" {
    val header: str = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
    var context: Context;
    if (!parse(header, "vendor=value,other=state", ?context) || !context.remote || context.flags != 1 || context.tracestate_len != 24) { ret 1; }
    var output: [56]u8;
    if (format(?context, ?output[0], 56) != 55) { ret 2; }
    var roundtrip: Context;
    if (!parse((?output[0])::str, nil, ?roundtrip)) { ret 3; }
    var i: usize = 0;
    for (i < 16) { if (roundtrip.trace_id[i] != context.trace_id[i]) { ret 4; } i = i + 1; }
    ret 0;
}

test "telemetry trace: malformed parents reject and invalid state is discarded" {
    var context: Context;
    if (parse("00-00000000000000000000000000000000-00f067aa0ba902b7-01", nil, ?context)) { ret 1; }
    if (parse("00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01", nil, ?context)) { ret 2; }
    if (parse("ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", nil, ?context)) { ret 3; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "vendor=ok\ninjected=yes", ?context) || context.tracestate_valid || context.tracestate_len != 0) { ret 4; }
    if (parse("00-4BF92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", nil, ?context)) { ret 5; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "Vendor=value", ?context) || context.tracestate_valid) { ret 6; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "vendor=first,vendor=second", ?context) || context.tracestate_valid) { ret 7; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "vendor=value=invalid", ?context) || context.tracestate_valid) { ret 8; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", " vendor= leading , ,other=value\t", ?context) || !context.tracestate_valid) { ret 9; }
    if (!parse_bounded("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "vendor=value", 8, ?context) || context.tracestate_valid) { ret 10; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "7tenant@system=value", ?context) || !context.tracestate_valid) { ret 11; }
    if (!parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "tenant@7system=value", ?context) || context.tracestate_valid) { ret 12; }
    ret 0;
}

test "telemetry trace: local roots and children use fresh nonzero identifiers" {
    var root: Context;
    if (!make_root(?root, true) || root.remote || root.flags != 1) { ret 1; }
    var child: Context;
    if (!make_child(?root, ?child) || child.remote || child.flags != root.flags) { ret 2; }
    var i: usize = 0;
    var trace_difference: u8 = 0;
    var span_difference: u8 = 0;
    for (i < 16) { trace_difference = trace_difference | (root.trace_id[i] ^ child.trace_id[i]); i = i + 1; }
    i = 0;
    for (i < 8) { span_difference = span_difference | (root.parent_id[i] ^ child.parent_id[i]); i = i + 1; }
    if (trace_difference != 0 || span_difference == 0) { ret 3; }
    var rendered: [33]u8;
    if (format_id(?root, ?rendered[0], 33) != 32 || rendered[32] != 0) { ret 4; }
    ret 0;
}
