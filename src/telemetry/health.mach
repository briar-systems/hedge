# bounded liveness and readiness ownership

use std.sync.atomic;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub val NAME_CAPACITY: usize = 64;

pub rec Name {
    data: [64]u8;
    len:  usize;
}

pub rec Token {
    index:      u32;
    generation: u32;
}

pub rec Check {
    active:     bool;
    generation: u32;
    required:   bool;
    name:       Name;
    ready:      i64;
}

pub rec Health {
    storage:     *Check;
    capacity:    usize;
    count:       usize;
    accepting:   i64;
    fatal:       i64;
    draining:    i64;
    initialized: bool;
    lock:        mutex.Mutex;
}

pub rec Snapshot {
    live:              bool;
    ready:             bool;
    accepting:         bool;
    draining:          bool;
    required:          usize;
    unavailable:       usize;
    first_unavailable: Name;
}

fun copy_name(output: *Name, value: str) bool {
    if (output == nil || value == nil) { ret false; }
    val length: usize = str_len(value);
    if (length == 0 || length >= NAME_CAPACITY) { ret false; }
    var i: usize = 0;
    for (i < length) {
        val byte: u8 = value[i];
        if (byte < 0x21 || byte > 0x7e) { ret false; }
        output.data[i] = byte;
        i              = i + 1;
    }
    output.data[length] = 0;
    output.len          = length;
    ret true;
}

fun name_equals(name: *Name, value: str) bool {
    if (name == nil || value == nil || name.len != str_len(value)) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] != value[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun check_for(health: *Health, token: Token) *Check {
    if (health == nil || !health.initialized || token.index::usize >= health.capacity || token.generation == 0) { ret nil; }
    val check: *Check = ?health.storage[token.index::usize];
    if (!check.active || check.generation != token.generation) { ret nil; }
    ret check;
}

pub fun make(health: *Health, storage: *Check, capacity: usize) bool {
    if (health == nil || storage == nil || capacity == 0 || capacity > 0xffffffff) { ret false; }
    health.storage  = storage;
    health.capacity = capacity;
    health.count    = 0;
    atomic.store(?health.accepting, 0);
    atomic.store(?health.fatal, 0);
    atomic.store(?health.draining, 0);
    health.initialized = true;
    health.lock        = mutex.make();
    var i: usize = 0;
    for (i < capacity) {
        storage[i].active     = false;
        storage[i].generation = 0;
        i                     = i + 1;
    }
    ret true;
}

pub fun register(health: *Health, name: str, required: bool, initially_ready: bool, output: *Token) bool {
    if (health == nil || !health.initialized || output == nil) { ret false; }
    var checked: Name;
    if (!copy_name(?checked, name)) { ret false; }
    mutex.lock(?health.lock);
    var i: usize = 0;
    for (i < health.count) {
        if (name_equals(?health.storage[i].name, name)) {
            mutex.unlock(?health.lock);
            ret false;
        }
        i = i + 1;
    }
    if (health.count >= health.capacity) {
        mutex.unlock(?health.lock);
        ret false;
    }
    val index:      usize  = health.count;
    val check:      *Check = ?health.storage[index];
    var generation: u32    = check.generation + 1;
    if (generation == 0) { generation = 1; }
    check.generation = generation;
    check.name       = checked;
    check.required   = required;
    atomic.store(?check.ready, initially_ready::i64);
    check.active      = true;
    health.count      = health.count + 1;
    output.index      = index::u32;
    output.generation = generation;
    mutex.unlock(?health.lock);
    ret true;
}

pub fun set_ready(health: *Health, token: Token, ready: bool) bool {
    val check: *Check = check_for(health, token);
    if (check == nil) { ret false; }
    atomic.store(?check.ready, ready::i64);
    ret true;
}

pub fun begin_accepting(health: *Health) bool {
    if (health == nil || !health.initialized || atomic.load(?health.fatal) != 0 || atomic.load(?health.draining) != 0) { ret false; }
    atomic.store(?health.accepting, 1);
    ret true;
}

pub fun begin_drain(health: *Health) bool {
    if (health == nil || !health.initialized) { ret false; }
    val first: bool = atomic.load(?health.draining) == 0;
    atomic.store(?health.accepting, 0);
    atomic.store(?health.draining, 1);
    ret first;
}

pub fun fail(health: *Health) bool {
    if (health == nil || !health.initialized) { ret false; }
    val first: bool = atomic.load(?health.fatal) == 0;
    atomic.store(?health.accepting, 0);
    atomic.store(?health.fatal, 1);
    ret first;
}

pub fun snapshot(health: *Health) Snapshot {
    var result: Snapshot;
    if (health == nil || !health.initialized) { ret result; }
    result.live                  = atomic.load(?health.fatal) == 0;
    result.accepting             = atomic.load(?health.accepting) != 0;
    result.draining              = atomic.load(?health.draining) != 0;
    result.ready                 = result.live && result.accepting && !result.draining;
    result.required              = 0;
    result.unavailable           = 0;
    result.first_unavailable.len = 0;
    mutex.lock(?health.lock);
    var i: usize = 0;
    for (i < health.count) {
        val check: *Check = ?health.storage[i];
        if (check.active && check.required) {
            result.required = result.required + 1;
            if (atomic.load(?check.ready) == 0) {
                if (result.unavailable == 0) { result.first_unavailable = check.name; }
                result.unavailable = result.unavailable + 1;
                result.ready       = false;
            }
        }
        i = i + 1;
    }
    mutex.unlock(?health.lock);
    ret result;
}

test "telemetry health: liveness and readiness are distinct" {
    var storage: [2]Check;
    var health:  Health;
    if (!make(?health, ?storage[0], 2)) { ret 1; }
    var config:   Token;
    var optional: Token;
    if (!register(?health, "config", true, false, ?config) || !register(?health, "tracing", false, false, ?optional)) { ret 2; }
    if (!begin_accepting(?health))                                                                                    { ret 3; }
    var state: Snapshot = snapshot(?health);
    if (!state.live || state.ready || state.unavailable != 1) { ret 4; }
    if (!set_ready(?health, config, true))                    { ret 5; }
    state = snapshot(?health);
    if (!state.live || !state.ready || state.unavailable != 0) { ret 6; }
    if (!begin_drain(?health) || begin_drain(?health))         { ret 7; }
    state = snapshot(?health);
    if (!state.live || state.ready || state.accepting || !state.draining) { ret 8; }
    ret 0;
}

test "telemetry health: fatal failure never reports ready" {
    var storage: [1]Check;
    var health:  Health;
    make(?health, ?storage[0], 1);
    begin_accepting(?health);
    if (!fail(?health) || fail(?health)) { ret 1; }
    val state: Snapshot = snapshot(?health);
    if (state.live || state.ready || state.accepting) { ret 2; }
    ret 0;
}
