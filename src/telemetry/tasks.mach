# background task reports as metric series
#
# every task registered in the facility is rendered from its `task.report` at
# each render, labelled `task` with its name. the tasks are a bounded set fixed
# at registration, so the series are too, and the last success's age is as old
# as the render says rather than as old as the last report pushed

use hedge.clock;
use hedge.service;
use hedge.task;
use telemetry_metrics: hedge.telemetry.metrics;
use std.chrono.time;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

# the facility's tasks, rendered at every render of the runtime it is added to
pub fun collector(tasks: *task.Tasks) telemetry_metrics.Collector {
    ret telemetry_metrics.Collector{ctx: tasks::ptr, collect: collect};
}

fun collect(context: ptr, writer: *telemetry_metrics.Writer) {
    write(context::*task.Tasks, writer, clock.monotonic_ns());
}

fun flag(value: bool) i64 {
    if (value) { ret 1; }
    ret 0;
}

fun gauge_ns(value: u64) i64 {
    if (value > 0x7fffffffffffffff) { ret 0x7fffffffffffffff; }
    ret value::i64;
}

fun write_outcome(writer: *telemetry_metrics.Writer, name: str, outcome: str, value: u64) {
    var labels: [2]telemetry_metrics.LabelView = [2]telemetry_metrics.LabelView{
        telemetry_metrics.LabelView{key: "outcome", value: outcome},
        telemetry_metrics.LabelView{key: "task", value: name}
    };
    telemetry_metrics.write_counter(writer, "hedge_task_runs_total", ?labels[0], 2, value);
}

fun write_task(writer: *telemetry_metrics.Writer, name: view.View, report: *task.Report,
    now_ns: u64) {
    var text: [task.MAX_NAME_BYTES + 1]u8;
    if (name.len == 0 || name.len > task.MAX_NAME_BYTES) { ret; }
    var i: usize = 0;
    for (i < name.len) {
        text[i] = name.data[i];
        i       = i + 1;
    }
    text[name.len] = 0;
    val label: str = (?text[0])::str;
    write_outcome(writer, label, "completed", report.completed);
    write_outcome(writer, label, "failed", report.failed);
    write_outcome(writer, label, "abandoned", report.abandoned);
    var labels: [1]telemetry_metrics.LabelView = [1]telemetry_metrics.LabelView{
        telemetry_metrics.LabelView{key: "task", value: label}
    };
    telemetry_metrics.write_counter(writer, "hedge_task_coalesced_total", ?labels[0], 1,
        report.coalesced);
    telemetry_metrics.write_gauge(writer, "hedge_task_running", ?labels[0], 1,
        flag(report.running));
    telemetry_metrics.write_gauge(writer, "hedge_task_queued", ?labels[0], 1,
        flag(report.queued));
    telemetry_metrics.write_gauge(writer, "hedge_task_last_duration_ns", ?labels[0], 1,
        gauge_ns(report.last_duration_ns));
    telemetry_metrics.write_gauge(writer, "hedge_task_max_duration_ns", ?labels[0], 1,
        gauge_ns(report.max_duration_ns));
    val age: opt[u64] = task.success_age_ns(report, now_ns);
    if (sel age.some) {
        telemetry_metrics.write_gauge(writer, "hedge_task_last_success_age_ns", ?labels[0], 1,
            gauge_ns(age.some));
    }
    telemetry_metrics.write_counter(writer, "hedge_task_snapshots_published_total",
        ?labels[0], 1, report.published);
}

# every registered task's series at monotonic `now_ns`
pub fun write(tasks: *task.Tasks, writer: *telemetry_metrics.Writer, now_ns: u64) {
    if (tasks == nil || writer == nil) { ret; }
    var slot: usize = 0;
    for (slot < task.MAX_TASKS) {
        var report: task.Report;
        var name:   view.View;
        if (task.report_at(tasks, slot, ?report, ?name) == task.STATUS_OK) {
            write_task(writer, name, ?report, now_ns);
        }
        slot = slot + 1;
    }
}

#[testing]
fun done_step(context: ptr, run: *task.Run) service.Step {
    ret service.Step{status: service.STEP_DONE, detail: view.view(nil, 0)};
}

#[testing]
fun rendered(tasks: *task.Tasks, now_ns: u64, output: *u8, capacity: usize) usize {
    var writer: telemetry_metrics.Writer = telemetry_metrics.Writer{output: output,
        capacity: capacity, length: 0};
    write(tasks, ?writer, now_ns);
    if (writer.length > capacity) { ret 0; }
    ret writer.length;
}

#[testing]
fun contains(data: *u8, length: usize, needle: str) bool {
    var size: usize = 0;
    for (needle[size] != 0) { size = size + 1; }
    var i: usize = 0;
    for (i + size <= length) {
        var j: usize = 0;
        for (j < size && data[i + j] == needle[j]) { j = j + 1; }
        if (j == size) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a task's series carry its name, and its last success's age appears once it
# has one, measured at the render
test write__series_per_task {
    var tasks: task.Tasks;
    if (!task.make(?tasks, task.default_options())) { ret 1; }
    var spec: task.Spec = task.Spec{name: view.view("refresh", 7), state: nil,
        step:       done_step, period_ns: 0, timeout_ns: 0, slots: nil, slot_bytes: 0,
        slot_count: 0};
    var handle: task.Handle;
    if (task.register(?tasks, ?spec, ?handle) != task.STATUS_OK) { ret 2; }
    var text:   [2048]u8;
    var length: usize = rendered(?tasks, 1, ?text[0], 2048);
    if (length == 0
        || !contains(?text[0], length, "hedge_task_runs_total{outcome=\"completed\",task=\"refresh\"} 0\n")
        || !contains(?text[0], length, "hedge_task_snapshots_published_total{task=\"refresh\"} 0\n")
        || contains(?text[0], length, "hedge_task_last_success_age_ns")) { ret 3; }
    val started: time.Instant = time.Instant{sec: 1, nsec: 0};
    if (task.trigger(?tasks, handle) != task.STATUS_OK || task.poll(?tasks, started) != 1) {
        ret 4;
    }
    length = rendered(?tasks, clock.to_ns(started) + 3000000000, ?text[0], 2048);
    if (length == 0
        || !contains(?text[0], length, "hedge_task_runs_total{outcome=\"completed\",task=\"refresh\"} 1\n")
        || !contains(?text[0], length, "hedge_task_runs_total{outcome=\"failed\",task=\"refresh\"} 0\n")
        || !contains(?text[0], length, "hedge_task_running{task=\"refresh\"} 0\n")
        || !contains(?text[0], length, "hedge_task_last_success_age_ns{task=\"refresh\"} 3000000000\n")) {
        ret 5;
    }
    if (task.drain(?tasks, started).status != task.DRAIN_DONE || task.stop(?tasks) != task.STATUS_OK
        || !task.close(?tasks, 0)) { ret 6; }
    # a stopped facility renders nothing
    var writer: telemetry_metrics.Writer = telemetry_metrics.Writer{output: ?text[0],
        capacity: 2048, length: 0};
    write(?tasks, ?writer, 1);
    if (writer.length != 0) { ret 7; }
    ret 0;
}
