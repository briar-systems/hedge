# isolated authenticated administration handler

use hedge.dispatch.call;
use hedge.service;
use hedge.telemetry.health;
use http.core.exchange;
use http.core.field;
use http.core.message;
use std.allocator;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view;

pub def AuthenticateFun: fun(ptr, str) bool;
pub def RenderFun:       fun(ptr, *u8, usize) usize;

pub val MAX_METHOD_BYTES:        usize = 16;
pub val MAX_PATH_BYTES:          usize = 64;
pub val MAX_AUTHORIZATION_BYTES: usize = 1024;

pub rec Policy {
    listener:           str;
    auth_context:       ptr;
    authenticate:       AuthenticateFun;
    metrics_context:    ptr;
    render_metrics:     RenderFun;
    state_context:      ptr;
    render_state:       RenderFun;
    max_response_bytes: usize;
}

pub rec Handler {
    policy:       Policy;
    health:       *health.Health;
    requests:     i64;
    unauthorized: i64;
    not_found:    i64;
    failed:       i64;
    initialized:  bool;
}

pub rec Request {
    listener:      str;
    method:        str;
    path:          str;
    authorization: str;
}

pub rec Response {
    status:       u16;
    content_type: str;
    length:       usize;
}

pub rec Stats {
    requests:     u64;
    unauthorized: u64;
    not_found:    u64;
    failed:       u64;
}

pub rec Credential {
    data: *u8;
    len:  usize;
}

pub fun authenticate_bearer(context: ptr, authorization: str) bool {
    val credential: *Credential = context::*Credential;
    if (credential == nil || credential.data == nil || credential.len == 0
        || authorization == nil) { ret false; }
    val expected: usize = credential.len + 7;
    var length:   usize = 0;
    for (length <= expected && authorization[length] != 0) {
        length = length + 1;
    }
    var difference: u8    = (length != expected)::u8;
    var i:          usize = 0;
    for (i < expected) {
        var wanted: u8 = 0;
        if (i == 0) { wanted = 'B'; }
        or (i == 1) { wanted = 'e'; }
        or (i == 2) { wanted = 'a'; }
        or (i == 3) { wanted = 'r'; }
        or (i == 4) { wanted = 'e'; }
        or (i == 5) { wanted = 'r'; }
        or (i == 6) { wanted = ' '; }
        or          { wanted = credential.data[i - 7]; }
        var actual: u8 = 0;
        if (i < length) { actual = authorization[i]; }
        difference = difference | (wanted ^ actual);
        i          = i + 1;
    }
    ret difference == 0;
}

fun write_text(output: *u8, capacity: usize, value: str) usize {
    if (output == nil || value == nil) { ret 0; }
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    if (length > capacity) { ret 0; }
    var i: usize = 0;
    for (i < length) {
        output[i] = value[i];
        i         = i + 1;
    }
    ret length;
}

pub fun make(handler: *Handler, policy: Policy, health_state: *health.Health) bool {
    if (handler == nil || health_state == nil || policy.listener == nil || policy.listener[0] == 0
        || policy.authenticate::usize == 0 || policy.max_response_bytes == 0) {
        ret false;
    }
    handler.policy       = policy;
    handler.health       = health_state;
    handler.requests     = 0;
    handler.unauthorized = 0;
    handler.not_found    = 0;
    handler.failed       = 0;
    handler.initialized  = true;
    ret true;
}

fun fixed(response: *Response, output: *u8, capacity: usize, status: u16, body: str) bool {
    val length: usize = write_text(output, capacity, body);
    if (length == 0 && body[0] != 0) { ret false; }
    response.status       = status;
    response.content_type = "application/json";
    response.length       = length;
    ret true;
}

pub fun handle(handler: *Handler, request: Request, output: *u8, capacity: usize, response: *Response) bool {
    if (handler == nil || !handler.initialized || output == nil || response == nil || capacity == 0) { ret false; }
    atomic.fetch_add(?handler.requests, 1);
    var limit: usize = handler.policy.max_response_bytes;
    if (capacity < handler.policy.max_response_bytes) { limit = capacity; }
    if (!str_equals(request.listener, handler.policy.listener)) {
        atomic.fetch_add(?handler.not_found, 1);
        ret fixed(response, output, limit, 404, "{\"error\":\"not_found\"}\n");
    }
    if (!handler.policy.authenticate(handler.policy.auth_context, request.authorization)) {
        atomic.fetch_add(?handler.unauthorized, 1);
        ret fixed(response, output, limit, 401, "{\"error\":\"unauthorized\"}\n");
    }
    if (!str_equals(request.method, "GET")) {
        ret fixed(response, output, limit, 405, "{\"error\":\"method_not_allowed\"}\n");
    }
    if (str_equals(request.path, "/live")) {
        val live_state: health.Snapshot = health.snapshot(handler.health);
        if (live_state.live) { ret fixed(response, output, limit, 200, "{\"live\":true}\n"); }
        ret fixed(response, output, limit, 503, "{\"live\":false}\n");
    }
    if (str_equals(request.path, "/ready")) {
        val ready_state: health.Snapshot = health.snapshot(handler.health);
        if (ready_state.ready) { ret fixed(response, output, limit, 200, "{\"ready\":true}\n"); }
        ret fixed(response, output, limit, 503, "{\"ready\":false}\n");
    }
    if (str_equals(request.path, "/metrics") && handler.policy.render_metrics::usize != 0) {
        val metrics_length: usize = handler.policy.render_metrics(handler.policy.metrics_context, output, limit);
        if (metrics_length == 0 || metrics_length > limit) {
            atomic.fetch_add(?handler.failed, 1);
            ret fixed(response, output, limit, 503, "{\"error\":\"metrics_unavailable\"}\n");
        }
        response.status       = 200;
        response.content_type = "text/plain; version=0.0.4";
        response.length       = metrics_length;
        ret true;
    }
    if (str_equals(request.path, "/state") && handler.policy.render_state::usize != 0) {
        val state_length: usize = handler.policy.render_state(handler.policy.state_context, output, limit);
        if (state_length == 0 || state_length > limit) {
            atomic.fetch_add(?handler.failed, 1);
            ret fixed(response, output, limit, 503, "{\"error\":\"state_unavailable\"}\n");
        }
        response.status       = 200;
        response.content_type = "application/json";
        response.length       = state_length;
        ret true;
    }
    atomic.fetch_add(?handler.not_found, 1);
    ret fixed(response, output, limit, 404, "{\"error\":\"not_found\"}\n");
}

pub fun stats(handler: *Handler) Stats {
    var result: Stats;
    if (handler == nil || !handler.initialized) { ret result; }
    result.requests     = atomic.load(?handler.requests)::u64;
    result.unauthorized = atomic.load(?handler.unauthorized)::u64;
    result.not_found    = atomic.load(?handler.not_found)::u64;
    result.failed       = atomic.load(?handler.failed)::u64;
    ret result;
}

fun arena_text(active: *call.Call, value: view.View, maximum: usize) str {
    val a: *allocator.Allocator = call.allocator_of(active);
    if (a == nil || (value.len != 0 && value.data == nil)) { ret nil; }
    if (value.len > maximum)                               { ret ""; }
    val allocated: res[*u8, allocator.Error] = allocator.allocate[u8](a, value.len + 1);
    if (sel allocated.err) { ret nil; }
    val output: *u8   = allocated.ok;
    var i:      usize = 0;
    for (i < value.len) {
        output[i] = value.data[i];
        i         = i + 1;
    }
    output[value.len] = 0;
    ret output::str;
}

fun authorization(request: *message.Request) view.View {
    var result: view.View = view.view(nil, 0);
    var found:  bool      = false;
    var i:      usize     = 0;
    for (i < request.fields.len) {
        val item: *field.Field = ?request.fields.items[i];
        if (field.name_equal(item.name, view.view(field.AUTHORIZATION, 13))) {
            if (found) { ret view.view(nil, 0); }
            result = item.value;
            found  = true;
        }
        i = i + 1;
    }
    ret result;
}

pub fun serve(context: ptr, active: *call.Call) exchange.ServiceStatus {
    val handler:  *Handler             = context::*Handler;
    val request:  *message.Request     = call.request(active);
    val response: *message.Response    = call.response(active);
    val a:        *allocator.Allocator = call.allocator_of(active);
    if (handler == nil || request == nil || response == nil || a == nil
        || !call.entered(active)) { ret exchange.SERVICE_FAILED; }
    val method: str = arena_text(active, request.method.token, MAX_METHOD_BYTES);
    val path:   str = arena_text(active, request.target.path, MAX_PATH_BYTES);
    val auth:   str = arena_text(active, authorization(request),
        MAX_AUTHORIZATION_BYTES);
    val listener: str = active.listener;
    if (method == nil || path == nil || auth == nil || listener == nil) {
        ret exchange.SERVICE_FAILED;
    }
    val allocated: res[*u8, allocator.Error] = allocator.allocate[u8](a,
        handler.policy.max_response_bytes);
    if (sel allocated.err) { ret exchange.SERVICE_FAILED; }
    val output:   *u8 = allocated.ok;
    var rendered: Response;
    if (!handle(handler, Request{listener: listener, method: method, path: path,
        authorization: auth}, output, handler.policy.max_response_bytes,
        ?rendered)
        || message.set_status(response, rendered.status)
        != message.RESPONSE_OK
        || !service.add_field(active, field.CONTENT_TYPE, rendered.content_type)) {
        ret exchange.SERVICE_FAILED;
    }
    if (rendered.status == 401
        && !service.add_field(active, field.WWW_AUTHENTICATE, "Bearer")) {
        ret exchange.SERVICE_FAILED;
    }
    ret service.respond_with_bytes(active, output, rendered.length);
}

pub fun bound_service(handler: *Handler) service.Handler {
    if (handler == nil || !handler.initialized) { ret service.no_handler(); }
    ret service.Handler{ctx: handler::ptr, serve: serve};
}

fun test_authenticate(context: ptr, authorization: str) bool {
    ret str_equals(authorization, "Bearer valid");
}

fun test_render(context: ptr, output: *u8, capacity: usize) usize {
    ret write_text(output, capacity, "hedge_requests 1\n");
}

test "telemetry admin: listener isolation and authentication precede routing" {
    var checks:       [1]health.Check;
    var health_state: health.Health;
    health.make(?health_state, ?checks[0], 1);
    health.begin_accepting(?health_state);
    val policy: Policy = Policy{
        listener:           "admin",
        auth_context:       nil,
        authenticate:       test_authenticate,
        metrics_context:    nil,
        render_metrics:     test_render,
        state_context:      nil,
        render_state:       test_render,
        max_response_bytes: 128,
    };
    var handler: Handler;
    if (!make(?handler, policy, ?health_state)) { ret 1; }
    var output:   [128]u8;
    var response: Response;
    if (!handle(?handler, Request{listener: "public", method: "GET", path: "/ready", authorization: "Bearer valid"}, ?output[0], 128, ?response) || response.status != 404) { ret 2; }
    if (!handle(?handler, Request{listener: "admin", method: "GET", path: "/ready", authorization: "Bearer wrong"}, ?output[0], 128, ?response) || response.status != 401)  { ret 3; }
    if (!handle(?handler, Request{listener: "admin", method: "GET", path: "/ready", authorization: "Bearer valid"}, ?output[0], 128, ?response) || response.status != 200)  { ret 4; }
    val state: Stats = stats(?handler);
    if (state.requests != 3 || state.unauthorized != 1 || state.not_found != 1) { ret 5; }
    ret 0;
}

test "telemetry admin: response limits fail closed" {
    var checks:       [1]health.Check;
    var health_state: health.Health;
    health.make(?health_state, ?checks[0], 1);
    val policy: Policy = Policy{
        listener:        "admin",
        auth_context:    nil,
        authenticate:    test_authenticate,
        metrics_context: nil,
        render_metrics:  test_render,
        state_context:   nil,
        render_state: (0::usize)::RenderFun,
        max_response_bytes: 8,
    };
    var handler: Handler;
    make(?handler, policy, ?health_state);
    var output:   [8]u8;
    var response: Response;
    if (handle(?handler, Request{listener: "admin", method: "GET", path: "/metrics", authorization: "Bearer valid"}, ?output[0], 8, ?response)) { ret 1; }
    ret 0;
}
