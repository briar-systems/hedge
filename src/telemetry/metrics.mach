# caller-bounded metrics and label cardinality

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.sync.atomic;
use std.sync.mutex;

pub val NAME_CAPACITY: usize = 64;
pub val VALUE_CAPACITY: usize = 96;
pub val MAX_LABELS: usize = 8;
pub val MAX_BUCKETS: usize = 15;
pub val MAX_RENDER_BYTES: usize = 8192;

pub def Kind: u8;
pub val COUNTER: Kind = 1;
pub val GAUGE: Kind = 2;
pub val HISTOGRAM: Kind = 3;

pub rec Name {
    data: [64]u8;
    len: usize;
}

pub rec Label {
    key: Name;
    value: [96]u8;
    value_len: usize;
}

pub rec LabelView {
    key: str;
    value: str;
}

pub rec Token {
    index: u32;
    generation: u32;
}

pub rec Series {
    active: bool;
    generation: u32;
    kind: Kind;
    name: Name;
    label_count: usize;
    labels: [8]Label;
    value: i64;
    bucket_count: usize;
    bounds: [15]u64;
    buckets: [16]i64;
    sum: i64;
    lock: mutex.Mutex;
}

pub rec Registry {
    storage: *Series;
    capacity: usize;
    count: usize;
    rejected_series: i64;
    rejected_updates: i64;
    initialized: bool;
    lock: mutex.Mutex;
}

pub rec Sample {
    kind: Kind;
    name: Name;
    label_count: usize;
    labels: [8]Label;
    value: u64;
    signed_value: i64;
    bucket_count: usize;
    bounds: [15]u64;
    buckets: [16]u64;
    sum: u64;
}

pub rec Stats {
    series: usize;
    capacity: usize;
    rejected_series: u64;
    rejected_updates: u64;
}

pub rec Rendered {
    ok: bool;
    len: usize;
    required: usize;
}

rec Cursor {
    output: *u8;
    capacity: usize;
    length: usize;
}

fun name_char(byte: u8, first: bool, allow_colon: bool) bool {
    if ((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || byte == '_') { ret true; }
    if (allow_colon && byte == ':') { ret true; }
    ret !first && byte >= '0' && byte <= '9';
}

fun copy_name(output: *Name, value: str, allow_colon: bool) bool {
    if (output == nil || value == nil) { ret false; }
    val length: usize = str_len(value);
    if (length == 0 || length >= NAME_CAPACITY) { ret false; }
    var i: usize = 0;
    for (i < length) {
        val byte: u8 = value[i];
        if (!name_char(byte, i == 0, allow_colon)) { ret false; }
        output.data[i] = byte;
        i = i + 1;
    }
    output.data[length] = 0;
    output.len = length;
    ret true;
}

fun copy_value(output: *Label, value: str) bool {
    if (output == nil || value == nil) { ret false; }
    val length: usize = str_len(value);
    if (length >= VALUE_CAPACITY) { ret false; }
    var i: usize = 0;
    for (i < length) {
        output.value[i] = value[i];
        i = i + 1;
    }
    output.value[length] = 0;
    output.value_len = length;
    ret true;
}

fun name_equals(name: *Name, value: str) bool {
    if (name == nil || value == nil || name.len != str_len(value)) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] != value[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun label_equals(label: *Label, view: *LabelView) bool {
    if (!name_equals(?label.key, view.key) || label.value_len != str_len(view.value)) { ret false; }
    var i: usize = 0;
    for (i < label.value_len) {
        if (label.value[i] != view.value[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun descriptor_equals(series: *Series, kind: Kind, name: str, labels: *LabelView, label_count: usize) bool {
    if (series.kind != kind || !name_equals(?series.name, name) || series.label_count != label_count) { ret false; }
    var i: usize = 0;
    for (i < label_count) {
        if (!label_equals(?series.labels[i], ?labels[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun series_for(registry: *Registry, token: Token) *Series {
    if (registry == nil || !registry.initialized || token.index::usize >= registry.capacity || token.generation == 0) { ret nil; }
    val series: *Series = ?registry.storage[token.index::usize];
    if (!series.active || series.generation != token.generation) { ret nil; }
    ret series;
}

pub fun make(registry: *Registry, storage: *Series, capacity: usize) bool {
    if (registry == nil || storage == nil || capacity == 0 || capacity > 0xffffffff) { ret false; }
    registry.storage = storage;
    registry.capacity = capacity;
    registry.count = 0;
    registry.rejected_series = 0;
    registry.rejected_updates = 0;
    registry.initialized = true;
    registry.lock = mutex.make();
    var i: usize = 0;
    for (i < capacity) {
        storage[i].active = false;
        storage[i].generation = 0;
        i = i + 1;
    }
    ret true;
}

pub fun register(
    registry: *Registry,
    kind: Kind,
    name: str,
    labels: *LabelView,
    label_count: usize,
    bounds: *u64,
    bucket_count: usize,
    output: *Token,
) bool {
    if (registry == nil || !registry.initialized || output == nil || kind < COUNTER || kind > HISTOGRAM
        || label_count > MAX_LABELS || (label_count > 0 && labels == nil)
        || bucket_count > MAX_BUCKETS || (bucket_count > 0 && bounds == nil)
        || (kind != HISTOGRAM && bucket_count != 0)) {
        ret false;
    }
    var checked_name: Name;
    if (!copy_name(?checked_name, name, true)) { ret false; }
    var i: usize = 1;
    for (i < label_count) {
        if (str_len(labels[i - 1].key) == 0 || str_len(labels[i].key) == 0) { ret false; }
        var left: usize = 0;
        val left_len: usize = str_len(labels[i - 1].key);
        val right_len: usize = str_len(labels[i].key);
        var common: usize = right_len;
        if (left_len < right_len) { common = left_len; }
        for (left < common && labels[i - 1].key[left] == labels[i].key[left]) { left = left + 1; }
        if (left == common && left_len >= right_len) { ret false; }
        if (left < common && labels[i - 1].key[left] >= labels[i].key[left]) { ret false; }
        i = i + 1;
    }
    i = 1;
    for (i < bucket_count) {
        if (bounds[i - 1] >= bounds[i] || bounds[i] > 0x7fffffffffffffff) { ret false; }
        i = i + 1;
    }
    if (bucket_count > 0 && bounds[0] > 0x7fffffffffffffff) { ret false; }
    var checked_labels: [8]Label;
    i = 0;
    for (i < label_count) {
        if (!copy_name(?checked_labels[i].key, labels[i].key, false) || !copy_value(?checked_labels[i], labels[i].value)) { ret false; }
        i = i + 1;
    }

    mutex.lock(?registry.lock);
    i = 0;
    for (i < registry.count) {
        val existing: *Series = ?registry.storage[i];
        if (descriptor_equals(existing, kind, name, labels, label_count)) {
            if (kind == HISTOGRAM) {
                if (existing.bucket_count != bucket_count) { mutex.unlock(?registry.lock); ret false; }
                var bound_index: usize = 0;
                for (bound_index < bucket_count) {
                    if (existing.bounds[bound_index] != bounds[bound_index]) { mutex.unlock(?registry.lock); ret false; }
                    bound_index = bound_index + 1;
                }
            }
            output.index = i::u32;
            output.generation = existing.generation;
            mutex.unlock(?registry.lock);
            ret true;
        }
        i = i + 1;
    }
    if (registry.count >= registry.capacity) {
        atomic.fetch_add(?registry.rejected_series, 1);
        mutex.unlock(?registry.lock);
        ret false;
    }
    val index: usize = registry.count;
    val series: *Series = ?registry.storage[index];
    series.active = false;
    var generation: u32 = series.generation + 1;
    if (generation == 0) { generation = 1; }
    series.generation = generation;
    series.kind = kind;
    series.name = checked_name;
    series.label_count = label_count;
    i = 0;
    for (i < label_count) { series.labels[i] = checked_labels[i]; i = i + 1; }
    series.value = 0;
    series.sum = 0;
    series.bucket_count = bucket_count;
    series.lock = mutex.make();
    i = 0;
    for (i < bucket_count) { series.bounds[i] = bounds[i]; i = i + 1; }
    i = 0;
    for (i < bucket_count + 1) { series.buckets[i] = 0; i = i + 1; }
    series.active = true;
    registry.count = registry.count + 1;
    output.index = index::u32;
    output.generation = generation;
    mutex.unlock(?registry.lock);
    ret true;
}

fun add_positive(value: *i64, amount: u64) bool {
    if (amount > 0x7fffffffffffffff) { ret false; }
    var current: i64 = atomic.load(value);
    for (true) {
        if (current < 0 || current::u64 > 0x7fffffffffffffff - amount) { ret false; }
        var expected: i64 = current;
        if (atomic.cas(value, ?expected, current + amount::i64)) { ret true; }
        current = expected;
    }
    ret false;
}

pub fun counter_add(registry: *Registry, token: Token, amount: u64) bool {
    val series: *Series = series_for(registry, token);
    if (series == nil || series.kind != COUNTER || !add_positive(?series.value, amount)) {
        if (registry != nil && registry.initialized) { atomic.fetch_add(?registry.rejected_updates, 1); }
        ret false;
    }
    ret true;
}

pub fun gauge_set(registry: *Registry, token: Token, value: i64) bool {
    val series: *Series = series_for(registry, token);
    if (series == nil || series.kind != GAUGE) {
        if (registry != nil && registry.initialized) { atomic.fetch_add(?registry.rejected_updates, 1); }
        ret false;
    }
    atomic.store(?series.value, value);
    ret true;
}

pub fun observe(registry: *Registry, token: Token, value: u64) bool {
    val series: *Series = series_for(registry, token);
    if (series == nil || series.kind != HISTOGRAM || value > 0x7fffffffffffffff) {
        if (registry != nil && registry.initialized) { atomic.fetch_add(?registry.rejected_updates, 1); }
        ret false;
    }
    var bucket: usize = 0;
    for (bucket < series.bucket_count && value > series.bounds[bucket]) { bucket = bucket + 1; }
    mutex.lock(?series.lock);
    val bucket_value: i64 = atomic.load(?series.buckets[bucket]);
    val count_value: i64 = atomic.load(?series.value);
    val sum_value: i64 = atomic.load(?series.sum);
    if (bucket_value < 0 || bucket_value == 0x7fffffffffffffff || count_value < 0 || count_value == 0x7fffffffffffffff
        || sum_value < 0 || sum_value::u64 > 0x7fffffffffffffff - value) {
        mutex.unlock(?series.lock);
        if (registry != nil && registry.initialized) { atomic.fetch_add(?registry.rejected_updates, 1); }
        ret false;
    }
    atomic.store(?series.buckets[bucket], bucket_value + 1);
    atomic.store(?series.value, count_value + 1);
    atomic.store(?series.sum, sum_value + value::i64);
    mutex.unlock(?series.lock);
    ret true;
}

pub fun sample(registry: *Registry, token: Token, output: *Sample) bool {
    val series: *Series = series_for(registry, token);
    if (series == nil || output == nil) { ret false; }
    output.kind = series.kind;
    output.name = series.name;
    output.label_count = series.label_count;
    var i: usize = 0;
    for (i < series.label_count) { output.labels[i] = series.labels[i]; i = i + 1; }
    if (series.kind == HISTOGRAM) { mutex.lock(?series.lock); }
    output.value = atomic.load(?series.value)::u64;
    output.signed_value = atomic.load(?series.value);
    output.bucket_count = series.bucket_count;
    i = 0;
    for (i < series.bucket_count) { output.bounds[i] = series.bounds[i]; i = i + 1; }
    i = 0;
    for (i < series.bucket_count + 1) { output.buckets[i] = atomic.load(?series.buckets[i])::u64; i = i + 1; }
    output.sum = atomic.load(?series.sum)::u64;
    if (series.kind == HISTOGRAM) { mutex.unlock(?series.lock); }
    ret true;
}

pub fun stats(registry: *Registry) Stats {
    var result: Stats;
    if (registry == nil || !registry.initialized) { ret result; }
    mutex.lock(?registry.lock);
    result.series = registry.count;
    result.capacity = registry.capacity;
    mutex.unlock(?registry.lock);
    result.rejected_series = atomic.load(?registry.rejected_series)::u64;
    result.rejected_updates = atomic.load(?registry.rejected_updates)::u64;
    ret result;
}

fun put_byte(cursor: *Cursor, byte: u8) {
    if (cursor.output != nil && cursor.length < cursor.capacity) { cursor.output[cursor.length] = byte; }
    cursor.length = cursor.length + 1;
}

fun put_text(cursor: *Cursor, value: str) {
    var i: usize = 0;
    for (value != nil && value[i] != 0) { put_byte(cursor, value[i]); i = i + 1; }
}

fun put_name(cursor: *Cursor, name: *Name) {
    var i: usize = 0;
    for (i < name.len) { put_byte(cursor, name.data[i]); i = i + 1; }
}

fun put_u64(cursor: *Cursor, value: u64) {
    var digits: [20]u8;
    var count: usize = 0;
    var remaining: u64 = value;
    if (remaining == 0) { put_byte(cursor, '0'); ret; }
    for (remaining > 0) {
        digits[count] = '0' + (remaining % 10)::u8;
        remaining = remaining / 10;
        count = count + 1;
    }
    for (count > 0) { count = count - 1; put_byte(cursor, digits[count]); }
}

fun put_i64(cursor: *Cursor, value: i64) {
    if (value >= 0) { put_u64(cursor, value::u64); ret; }
    put_byte(cursor, '-');
    val magnitude: u64 = (-(value + 1))::u64 + 1;
    put_u64(cursor, magnitude);
}

fun put_label_value(cursor: *Cursor, value: *u8, length: usize) {
    var i: usize = 0;
    for (i < length) {
        val byte: u8 = value[i];
        if (byte == '\\' || byte == '"') { put_byte(cursor, '\\'); put_byte(cursor, byte); }
        or (byte == '\n') { put_text(cursor, "\\n"); }
        or { put_byte(cursor, byte); }
        i = i + 1;
    }
}

fun put_labels(cursor: *Cursor, sample: *Sample, has_extra: bool, extra: str) {
    if (sample.label_count == 0 && !has_extra) { ret; }
    put_byte(cursor, '{');
    var i: usize = 0;
    for (i < sample.label_count) {
        if (i > 0) { put_byte(cursor, ','); }
        put_name(cursor, ?sample.labels[i].key);
        put_text(cursor, "=\"");
        put_label_value(cursor, ?sample.labels[i].value[0], sample.labels[i].value_len);
        put_byte(cursor, '"');
        i = i + 1;
    }
    if (has_extra) {
        if (sample.label_count > 0) { put_byte(cursor, ','); }
        put_text(cursor, "le=\"");
        put_text(cursor, extra);
        put_byte(cursor, '"');
    }
    put_byte(cursor, '}');
}

fun put_bound(cursor: *Cursor, value: u64) {
    put_u64(cursor, value);
}

fun render_sample(cursor: *Cursor, sample: *Sample) {
    if (sample.kind == COUNTER || sample.kind == GAUGE) {
        put_name(cursor, ?sample.name);
        put_labels(cursor, sample, false, nil);
        put_byte(cursor, ' ');
        if (sample.kind == GAUGE) { put_i64(cursor, sample.signed_value); }
        or { put_u64(cursor, sample.value); }
        put_byte(cursor, '\n');
        ret;
    }
    var cumulative: u64 = 0;
    var i: usize = 0;
    for (i < sample.bucket_count) {
        cumulative = cumulative + sample.buckets[i];
        put_name(cursor, ?sample.name);
        put_text(cursor, "_bucket");
        if (sample.label_count == 0) {
            put_text(cursor, "{le=\"");
        } or {
            put_byte(cursor, '{');
            var label_index: usize = 0;
            for (label_index < sample.label_count) {
                if (label_index > 0) { put_byte(cursor, ','); }
                put_name(cursor, ?sample.labels[label_index].key);
                put_text(cursor, "=\"");
                put_label_value(cursor, ?sample.labels[label_index].value[0], sample.labels[label_index].value_len);
                put_byte(cursor, '"');
                label_index = label_index + 1;
            }
            put_byte(cursor, ',');
            put_text(cursor, "le=\"");
        }
        put_bound(cursor, sample.bounds[i]);
        put_text(cursor, "\"} ");
        put_u64(cursor, cumulative);
        put_byte(cursor, '\n');
        i = i + 1;
    }
    cumulative = cumulative + sample.buckets[sample.bucket_count];
    put_name(cursor, ?sample.name);
    put_text(cursor, "_bucket");
    put_labels(cursor, sample, true, "+Inf");
    put_byte(cursor, ' ');
    put_u64(cursor, cumulative);
    put_byte(cursor, '\n');
    put_name(cursor, ?sample.name);
    put_text(cursor, "_sum");
    put_labels(cursor, sample, false, nil);
    put_byte(cursor, ' ');
    put_u64(cursor, sample.sum);
    put_byte(cursor, '\n');
    put_name(cursor, ?sample.name);
    put_text(cursor, "_count");
    put_labels(cursor, sample, false, nil);
    put_byte(cursor, ' ');
    put_u64(cursor, sample.value);
    put_byte(cursor, '\n');
}

fun render_pass(registry: *Registry, output: *u8, capacity: usize) usize {
    var cursor: Cursor = Cursor{output: output, capacity: capacity, length: 0};
    mutex.lock(?registry.lock);
    val count: usize = registry.count;
    mutex.unlock(?registry.lock);
    var i: usize = 0;
    for (i < count) {
        val series: *Series = ?registry.storage[i];
        val token: Token = Token{index: i::u32, generation: series.generation};
        var current: Sample;
        if (sample(registry, token, ?current)) { render_sample(?cursor, ?current); }
        i = i + 1;
    }
    ret cursor.length;
}

pub fun render(registry: *Registry, output: *u8, capacity: usize) Rendered {
    var result: Rendered = Rendered{ok: false, len: 0, required: 0};
    if (registry == nil || !registry.initialized || (capacity > 0 && output == nil)) { ret result; }
    var staging: [8192]u8;
    result.required = render_pass(registry, ?staging[0], MAX_RENDER_BYTES);
    if (result.required > MAX_RENDER_BYTES || result.required > capacity) { ret result; }
    var i: usize = 0;
    for (i < result.required) { output[i] = staging[i]; i = i + 1; }
    result.len = result.required;
    result.ok = true;
    ret result;
}

test "telemetry metrics: cardinality and labels are caller bounded" {
    var storage: [2]Series;
    var registry: Registry;
    if (!make(?registry, ?storage[0], 2)) { ret 1; }
    var first_labels: [1]LabelView = [1]LabelView{LabelView{key: "method", value: "GET"}};
    var second_labels: [1]LabelView = [1]LabelView{LabelView{key: "method", value: "POST"}};
    var invalid_labels: [1]LabelView = [1]LabelView{LabelView{key: "1method", value: "GET"}};
    var first: Token;
    var second: Token;
    var rejected: Token;
    if (register(?registry, COUNTER, "1invalid", nil, 0, nil, 0, ?rejected)
        || register(?registry, COUNTER, "http_requests", ?invalid_labels[0], 1, nil, 0, ?rejected)) { ret 2; }
    if (!register(?registry, COUNTER, "http_requests", ?first_labels[0], 1, nil, 0, ?first)) { ret 3; }
    if (!register(?registry, COUNTER, "http_requests", ?second_labels[0], 1, nil, 0, ?second)) { ret 4; }
    if (register(?registry, COUNTER, "http_requests", nil, 0, nil, 0, ?rejected)) { ret 5; }
    if (!counter_add(?registry, first, 3) || !counter_add(?registry, second, 2)) { ret 6; }
    var value: Sample;
    if (!sample(?registry, first, ?value) || value.value != 3) { ret 7; }
    val state: Stats = stats(?registry);
    if (state.series != 2 || state.capacity != 2 || state.rejected_series != 1) { ret 8; }
    var output: [256]u8;
    val rendered: Rendered = render(?registry, ?output[0], 255);
    if (!rendered.ok) { ret 9; }
    output[rendered.len] = 0;
    if (!str_equals((?output[0])::str, "http_requests{method=\"GET\"} 3\nhttp_requests{method=\"POST\"} 2\n")) { ret 10; }
    ret 0;
}

test "telemetry metrics: histograms retain exact bounded buckets" {
    var storage: [1]Series;
    var registry: Registry;
    make(?registry, ?storage[0], 1);
    var bounds: [3]u64 = [3]u64{10, 100, 1000};
    var token: Token;
    if (!register(?registry, HISTOGRAM, "request_ms", nil, 0, ?bounds[0], 3, ?token)) { ret 1; }
    observe(?registry, token, 5);
    observe(?registry, token, 10);
    observe(?registry, token, 11);
    observe(?registry, token, 101);
    observe(?registry, token, 1001);
    var value: Sample;
    if (!sample(?registry, token, ?value)) { ret 2; }
    if (value.value != 5 || value.sum != 1128 || value.buckets[0] != 2 || value.buckets[1] != 1 || value.buckets[2] != 1 || value.buckets[3] != 1) { ret 3; }
    var output: [512]u8;
    val rendered: Rendered = render(?registry, ?output[0], 512);
    if (!rendered.ok || rendered.len == 0) { ret 4; }
    output[rendered.len] = 0;
    val expected: str = "request_ms_bucket{le=\"10\"} 2\nrequest_ms_bucket{le=\"100\"} 3\nrequest_ms_bucket{le=\"1000\"} 4\nrequest_ms_bucket{le=\"+Inf\"} 5\nrequest_ms_sum 1128\nrequest_ms_count 5\n";
    if (!str_equals((?output[0])::str, expected)) { ret 5; }
    var too_small: [1]u8;
    too_small[0] = 0xaa;
    val rejected: Rendered = render(?registry, ?too_small[0], 1);
    if (rejected.ok || rejected.required != rendered.required || too_small[0] != 0xaa) { ret 6; }
    ret 0;
}
