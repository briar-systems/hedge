fwd worker.controls_view;
fwd worker.quic_required;

pub val CACHE_ENTRIES: usize = 128;

pub def Event: u8;
pub val CACHE_BINDINGS_READY: Event = 1;
pub val CACHE_WRAPPER_READY:  Event = 2;
pub val PLAN_READY:           Event = 3;
pub val SERVE_STOPPED:        Event = 4;
pub val ACME_CLOSED:          Event = 5;
pub val TLS_DESTROYED:        Event = 6;
pub val PROXY_CLOSED:         Event = 7;
pub val CACHE_CLOSED:         Event = 8;
pub val STATIC_CLOSED:        Event = 9;
pub val TELEMETRY_CLOSED:     Event = 10;

# applications is the caller's registry, resolved at start and at every reload,
# so it and every handler in it stay live and unchanged until stop returns
pub rec Options {
    native:       service.Factory;
    applications: *service.Applications;
    pseudonym:    str;
    telemetry:    telemetry_production.Options;
}

pub fun default_options() Options {
    ret Options{native: service.no_factory(), applications: nil,
        pseudonym: "hedge", telemetry: telemetry_production.default_options()};
}

pub rec Runtime {
    heap:               *allocator.Allocator;
    graph:              *schema.Graph;
    caching:            *http_cache.Layer;
    certificates:       *acme.Manager;
    challenge_binding:  handler.Binding;
    alpn_challenge:     tlsalpn.Alpn;
    certificate_policy: usize;
    observability:      telemetry_production.Production;
    options:            Options;
    # every worker, allocated at start and owned for the process lifetime
    workers:             *worker.Worker;
    worker_count:        usize;
    cache_live:          bool;
    acme_live:           bool;
    alpn_challenge_live: bool;
    tls_live:            bool;
    telemetry_live:      bool;
    events:              [16]Event;
    event_count:         usize;
}

fun event(runtime: *Runtime, value: Event) {
    if (runtime.event_count < 16) {
        runtime.events[runtime.event_count] = value;
        runtime.event_count                 = runtime.event_count + 1;
    }
}

pub fun event_at(runtime: *Runtime, index: usize) Event {
    if (runtime == nil || index >= runtime.event_count) { ret 0; }
    ret runtime.events[index];
}

# the worker at `index`, or nil past the last
pub fun worker_at(runtime: *Runtime, index: usize) *worker.Worker {
    if (runtime == nil || runtime.workers == nil || index >= runtime.worker_count) { ret nil; }
    ret ?runtime.workers[index];
}

# what the process hands a worker for each service generation it builds
fun inputs(runtime: *Runtime, configured: *schema.Graph) worker.Inputs {
    var value: worker.Inputs;
    value.caching                = nil;
    value.applications           = runtime.options.applications;
    value.native                 = runtime.options.native;
    value.observability          = ?runtime.observability.runtime;
    value.listener_services      = ?runtime.observability.listener_services[0];
    value.listener_service_count = runtime.observability.listener_service_count;
    value.challenge              = nil;
    if (runtime.cache_live) { value.caching = runtime.caching; }
    if (runtime.acme_live && configured.acme.challenge == schema.CHALLENGE_HTTP_01) {
        value.challenge = ?runtime.challenge_binding;
    }
    ret value;
}

fun build(runtime: *Runtime, slot: usize, configured: *schema.Graph,
    generation_id: u64, record_events: bool) worker.StartReport {
    var given: worker.Inputs = inputs(runtime, configured);
    var i:     usize         = 0;
    for (i < runtime.worker_count) {
        val built: worker.StartReport = worker.build_service_generation(
            ?runtime.workers[i], slot, configured, generation_id, ?given);
        if (built.status != worker.START_OK) {
            var j: usize = 0;
            for (j < i) {
                worker.close_service_generation(?runtime.workers[j], slot);
                j = j + 1;
            }
            ret built;
        }
        i = i + 1;
    }
    if (record_events) {
        if (given.caching != nil) {
            event(runtime, CACHE_BINDINGS_READY);
            event(runtime, CACHE_WRAPPER_READY);
        }
        event(runtime, PLAN_READY);
    }
    ret worker.ok();
}

fun clean(runtime: *Runtime, controls: *worker.Controls) worker.StopReport {
    var report: worker.StopReport = worker.StopReport{stopped: true,
        reason:           lifecycle.IMMEDIATE, abandoned: 0, serve_failures: 0,
        cleanup_failures: 0};
    var i:      usize = 0;
    var served: bool  = false;
    for (i < runtime.worker_count) {
        val current:  *worker.Worker = ?runtime.workers[i];
        val was_live: bool           = current.serve_live;
        if (!worker.stop_serving(current, controls, ?report)) { ret report; }
        if (was_live)                                         { served = true; }
        i = i + 1;
    }
    if (served) { event(runtime, SERVE_STOPPED); }
    if (runtime.telemetry_live) {
        if (!telemetry_production.close(?runtime.observability)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.telemetry_live = false;
        event(runtime, TELEMETRY_CLOSED);
    }
    if (runtime.acme_live) {
        if (!acme.close(runtime.certificates)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.acme_live = false;
        event(runtime, ACME_CLOSED);
    }
    if (runtime.alpn_challenge_live) {
        if (!tlsalpn.destroy(?runtime.alpn_challenge)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.alpn_challenge_live = false;
    }
    if (runtime.tls_live) {
        if (!hedge_tls.destroy()) { report.cleanup_failures = report.cleanup_failures + 1; }
        runtime.tls_live = false;
        event(runtime, TLS_DESTROYED);
    }
    var proxied: bool = false;
    i = 0;
    for (i < runtime.worker_count) {
        if (worker.close_proxy(?runtime.workers[i], ?report)) { proxied = true; }
        i = i + 1;
    }
    if (proxied) { event(runtime, PROXY_CLOSED); }
    if (runtime.cache_live) {
        if (!http_cache.close(runtime.caching)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.cache_live = false;
        event(runtime, CACHE_CLOSED);
    }
    i = 0;
    for (i < runtime.worker_count) {
        worker.close_cache_bindings(?runtime.workers[i], ?report);
        i = i + 1;
    }
    var had_static: bool = false;
    i = 0;
    for (i < runtime.worker_count) {
        if (worker.close_static(?runtime.workers[i], ?report)) { had_static = true; }
        i = i + 1;
    }
    if (had_static) { event(runtime, STATIC_CLOSED); }
    ret report;
}

fun fail(runtime: *Runtime, controls: *worker.Controls, status: worker.StartStatus,
    detail: str) worker.StartReport {
    clean(runtime, controls);
    ret worker.failed(status, detail);
}

# the number of workers this process runs. until the listeners take
# SO_REUSEPORT (#287) only one worker can bind a configured address
fun worker_count(configured: *schema.Graph) usize {
    ret 1;
}

pub fun start(runtime: *Runtime, controls: *worker.Controls,
    heap: *allocator.Allocator, configured: *schema.Graph,
    generation_id: u64, diagnostics: *schema.Diagnostics,
    options: Options) worker.StartReport {
    if (runtime == nil || heap == nil || configured == nil || diagnostics == nil) {
        ret worker.failed(worker.START_RUNTIME, "composition input is invalid");
    }
    runtime.heap                = heap;
    runtime.graph               = configured;
    runtime.caching             = nil;
    runtime.certificates        = nil;
    runtime.options             = options;
    runtime.cache_live          = false;
    runtime.acme_live           = false;
    runtime.alpn_challenge_live = false;
    runtime.tls_live            = false;
    runtime.telemetry_live      = false;
    runtime.event_count         = 0;
    runtime.certificate_policy  = hedge_tls.NO_POLICY;
    runtime.workers             = nil;
    runtime.worker_count        = 0;

    val count:         usize                                = worker_count(configured);
    val worker_memory: res[*worker.Worker, allocator.Error] =
        allocator.allocate[worker.Worker](heap, count);
    if (sel worker_memory.err) {
        ret worker.failed(worker.START_RUNTIME, "worker allocation failed");
    }
    runtime.workers = worker_memory.ok;
    var i: usize = 0;
    for (i < count) {
        if (!worker.make(?runtime.workers[i], i, options.pseudonym)) {
            ret fail(runtime, controls, worker.START_RUNTIME,
                "proxy runtime could not be constructed");
        }
        runtime.worker_count = i + 1;
        i                    = i + 1;
    }

    if (configured.cache.enabled) {
        val layer_memory: res[*http_cache.Layer, allocator.Error] =
            allocator.allocate[http_cache.Layer](heap, 1);
        val entry_memory: res[*cache_store.Entry, allocator.Error] =
            allocator.allocate[cache_store.Entry](heap, CACHE_ENTRIES);
        val body_memory: res[*u8, allocator.Error] =
            allocator.allocate[u8](heap, configured.cache.memory_bytes);
        if (sel layer_memory.err) { ret fail(runtime, controls, worker.START_RUNTIME, "cache allocation failed"); }
        if (sel entry_memory.err) { ret fail(runtime, controls, worker.START_RUNTIME, "cache allocation failed"); }
        if (sel body_memory.err)  { ret fail(runtime, controls, worker.START_RUNTIME, "cache allocation failed"); }
        runtime.caching = layer_memory.ok;
        if (!http_cache.from_config(runtime.caching, ?configured.cache,
            entry_memory.ok, CACHE_ENTRIES,
            body_memory.ok, configured.cache.memory_bytes, heap)) {
            ret fail(runtime, controls, worker.START_CONFIG, "cache could not be constructed");
        }
        runtime.cache_live = true;
    }

    if (configured.acme.enabled) {
        val manager_memory: res[*acme.Manager, allocator.Error] =
            allocator.allocate[acme.Manager](heap, 1);
        if (sel manager_memory.err) {
            ret fail(runtime, controls, worker.START_RUNTIME, "certificate manager allocation failed");
        }
        runtime.certificates = manager_memory.ok;
        var opened: acme.Status = acme.INVALID;
        if (configured.acme.challenge == schema.CHALLENGE_TLS_ALPN_01) {
            if (!tlsalpn.make(?runtime.alpn_challenge)) {
                ret fail(runtime, controls, worker.START_RUNTIME,
                    "TLS-ALPN challenge state could not be constructed");
            }
            runtime.alpn_challenge_live = true;
            opened                      = acme.open_with_tls_alpn(runtime.certificates, heap,
                configured, tlsalpn.provider(?runtime.alpn_challenge));
        }
        or {
            opened = acme.open(runtime.certificates, heap, configured);
        }
        if (opened != acme.OK) {
            ret fail(runtime, controls, worker.START_CONFIG, "certificate manager could not open its state");
        }
        runtime.acme_live = true;
        if (configured.acme.challenge == schema.CHALLENGE_HTTP_01 &&
            !handler.bind(?runtime.challenge_binding,
            acme.challenge_table(runtime.certificates))) {
            ret fail(runtime, controls, worker.START_RUNTIME,
                "challenge route could not be bound");
        }
    }

    if (!telemetry_production.make(?runtime.observability, heap, configured,
        options.telemetry)) {
        ret fail(runtime, controls, worker.START_CONFIG, "telemetry could not be constructed");
    }
    runtime.telemetry_live = true;

    val services_built: worker.StartReport = build(runtime, 0, configured,
        generation_id, true);
    if (services_built.status != worker.START_OK) {
        ret fail(runtime, controls, services_built.status, services_built.detail);
    }

    hedge_tls.reset();
    runtime.tls_live = true;
    var listener_index: usize = 0;
    for (listener_index < configured.listener_count) {
        val selected: *schema.Listener = ?configured.listeners[listener_index];
        listener_index = listener_index + 1;
        if (selected.tls_policy.len == 0) { cnt; }
        val policy: *schema.TlsPolicy = schema.find_tls_policy(configured,
            schema.text(?selected.tls_policy));
        if (policy == nil) {
            ret fail(runtime, controls, worker.START_CONFIG, "listener references an unknown TLS policy");
        }
        var tls_options: hedge_tls.PublishOptions = hedge_tls.publish_options();
        tls_options.tls_alpn_challenge = configured.acme.enabled &&
            configured.acme.challenge == schema.CHALLENGE_TLS_ALPN_01 &&
            schema.text_equals(?selected.name,
            schema.text(?configured.acme.listener));
        if (hedge_tls.publish_with_options(schema.text(?selected.name), policy,
            selected.protocols, tls_options) != hedge_tls.OK) {
            ret fail(runtime, controls, worker.START_CONFIG, "TLS policy could not be published");
        }
    }
    if (runtime.acme_live) {
        runtime.certificate_policy = hedge_tls.find(
            schema.text(?configured.acme.listener));
        if (runtime.certificate_policy == hedge_tls.NO_POLICY) {
            ret fail(runtime, controls, worker.START_CONFIG,
                "ACME listener has no published TLS policy");
        }
        if (runtime.alpn_challenge_live &&
            !tlsalpn.bind_listener(?runtime.alpn_challenge,
            runtime.certificate_policy)) {
            ret fail(runtime, controls, worker.START_CONFIG,
                "TLS-ALPN challenge could not bind its listener");
        }
        if (acme.certificate_ready(runtime.certificates) &&
            hedge_tls.install_acme(runtime.certificate_policy,
            runtime.certificates) != hedge_tls.OK) {
            ret fail(runtime, controls, worker.START_CONFIG,
                "stored ACME certificate could not be installed");
        }
    }

    i = 0;
    for (i < runtime.worker_count) {
        # ACME is driven on the first worker's planes
        var certificates: *acme.Manager = nil;
        if (i == 0 && runtime.acme_live) { certificates = runtime.certificates; }
        val started: worker.StartReport = worker.start(?runtime.workers[i], controls,
            heap, configured, generation_id, ?runtime.observability.runtime,
            certificates, diagnostics);
        if (started.status != worker.START_OK) {
            ret fail(runtime, controls, started.status, started.detail);
        }
        i = i + 1;
    }
    ret worker.ok();
}

pub fun stop(runtime: *Runtime, controls: *worker.Controls) worker.StopReport {
    if (runtime == nil) {
        ret worker.StopReport{stopped: false, reason: lifecycle.FAILED, abandoned: 0,
            serve_failures: 0, cleanup_failures: 0};
    }
    ret clean(runtime, controls);
}

pub fun install_certificate(runtime: *Runtime, now: time.Time)
    hedge_tls.Status {
    if (runtime == nil || !runtime.acme_live || !runtime.tls_live ||
        runtime.certificate_policy == hedge_tls.NO_POLICY ||
        !acme.installation_ready(runtime.certificates)) { ret hedge_tls.INVALID; }
    val installed: hedge_tls.Status = hedge_tls.install_acme(
        runtime.certificate_policy, runtime.certificates);
    if (installed == hedge_tls.OK) {
        acme.installed(runtime.certificates, now);
    }
    ret installed;
}

pub fun service_snapshot(runtime: *Runtime, slot: usize) worker.ServiceSnapshot {
    ret worker.service_snapshot(worker_at(runtime, 0), slot);
}

pub fun active_service_generation(runtime: *Runtime) usize {
    val first: *worker.Worker = worker_at(runtime, 0);
    if (first == nil) { ret 0; }
    ret first.active_generation;
}

# live connections still on a superseded generation, across every worker
pub fun superseded(runtime: *Runtime, controls: *worker.Controls) usize {
    var quic_controls: quic_runtime.ControlView;
    worker.controls_view(controls, ?quic_controls);
    if (runtime == nil) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < runtime.worker_count) {
        count = count + serve.superseded(?quic_controls, ?runtime.workers[i].serving);
        i     = i + 1;
    }
    ret count;
}

pub fun reclaim_superseded(runtime: *Runtime, controls: *worker.Controls) bool {
    if (runtime == nil || runtime.worker_count == 0) { ret false; }
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < runtime.worker_count) {
        if (!worker.reclaim_superseded(?runtime.workers[i], controls)) { ok = false; }
        i = i + 1;
    }
    ret ok;
}

pub fun reload(runtime: *Runtime, controls: *worker.Controls,
    configured: *schema.Graph, generation_id: u64,
    diagnostics: *schema.Diagnostics) worker.StartReport {
    val first: *worker.Worker = worker_at(runtime, 0);
    if (first == nil || configured == nil || generation_id == 0
        || diagnostics == nil || !first.serve_live
        || generation_id <= first.service_generations[first.active_generation].generation
        || superseded(runtime, controls) != 0) {
        ret worker.failed(worker.START_RUNTIME, "service generation is not reclaimable");
    }
    if (!plan.reload_compatible(runtime.graph, configured)) {
        ret worker.failed(worker.START_CONFIG,
            "startup-owned configuration changed; restart required");
    }
    if (!reclaim_superseded(runtime, controls)) {
        ret worker.failed(worker.START_RUNTIME,
            "superseded service generation could not be released");
    }
    val target: usize              = 1 - first.active_generation;
    val built:  worker.StartReport = build(runtime, target, configured,
        generation_id, false);
    if (built.status != worker.START_OK) { ret built; }
    var i: usize = 0;
    for (i < runtime.worker_count) {
        val published: worker.StartReport = worker.publish(?runtime.workers[i],
            controls, configured, generation_id, diagnostics);
        if (published.status != worker.START_OK) { ret published; }
        i = i + 1;
    }
    runtime.graph = configured;
    ret worker.ok();
}

pub fun cache(runtime: *Runtime) *http_cache.Layer {
    if (runtime == nil || !runtime.cache_live) { ret nil; }
    ret runtime.caching;
}
