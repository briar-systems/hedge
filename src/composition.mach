# production object wiring and lifetime ownership
#
# the process owns what every worker reads: the configuration generations, the
# cache, ACME, the TLS policies, telemetry production and the application
# registry. each worker owns its serving runtime, QUIC runtime, proxy runtime,
# service generations and plans (`hedge.worker`). this module builds both and
# tears them down in one order.

use hedge.acme.handler;
use hedge.acme.keys;
use acme: hedge.acme.manager;
use hedge.acme.tlsalpn;
use process_admission: hedge.admission;
use hedge.allowance;
use http_cache:  hedge.cache;
use cache_store: hedge.cache.store;
use hedge.cache.store_worker;
use hedge.clock;
use hedge.config.schema;
use hedge.dispatch.plan;
use hedge.handoff;
use hedge.lifecycle;
use hedge.listener;
use hedge.observe;
use hedge.protocol.quic.keyfile;
use quic_keys:    hedge.protocol.quic.keys;
use quic_runtime: hedge.protocol.quic.runtime;
use hedge.protocol.quic.steering;
use hedge_tls: hedge.protocol.tls;
use hedge.secret;
use hedge.secret_file;
use hedge.serve;
use hedge.service;
use hedge.settings;
use hedge.task;
use hedge.telemetry;
use telemetry_production: hedge.telemetry.production;
use telemetry_tasks:      hedge.telemetry.tasks;
use hedge.worker;
use std.allocator;
use std.chrono.time;
use std.crypto.hash.siphash;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

fwd worker.PlanStorage;
fwd worker.StartStatus;
fwd worker.START_OK;
fwd worker.START_CONFIG;
