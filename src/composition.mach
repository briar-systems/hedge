pub val CACHE_ENTRIES: usize = 128;

pub val ENTROPY_UNAVAILABLE: str =
    "the operating system entropy source is unavailable, so peer-keyed tables cannot be keyed";

pub def Event: u8;
pub val CACHE_BINDINGS_READY: Event = 1;
pub val CACHE_WRAPPER_READY:  Event = 2;
pub val PLAN_READY:           Event = 3;
pub val SERVE_STOPPED:        Event = 4;
pub val ACME_CLOSED:          Event = 5;
pub val TLS_DESTROYED:        Event = 6;
pub val PROXY_CLOSED:         Event = 7;
pub val CACHE_CLOSED:         Event = 8;
pub val STATIC_CLOSED:        Event = 9;
pub val TELEMETRY_CLOSED:     Event = 10;

# applications is the caller's registry, resolved at start and at every reload,
# so it and every handler in it stay live and unchanged until stop returns
pub rec Options {
    native:       service.Factory;
    applications: *service.Applications;
    # the background task facility the supervisor runs, or nil for none
    tasks: *task.Tasks;
    # the provider the `os` and `application` secrets resolve through: the ones
    # granted to hosted applications, and the administration credential
    providers: secret.Providers;
    pseudonym: str;
    telemetry: telemetry_production.Options;
    # where the process key comes from: the operating system entropy source
    entropy: fun() opt[siphash.Key];
}

pub fun default_options() Options {
    ret Options{native: service.no_factory(), applications: nil, tasks: nil,
        providers: secret.no_providers(), pseudonym: "hedge", telemetry: telemetry_production.default_options(),
        entropy:   siphash.random_key};
}

# one listener as the process bound it. a TCP or QUIC listener's `address` is
# its socket's own, so a configured port of 0 reads as the port the system
# chose. a local listener has no IP address, and `local` is its configured
# endpoint. listeners never change without a restart, so neither does this
pub rec Bound {
    name:      schema.Text;
    transport: u8;
    protocols: u8;
    secure:    bool;
    address:   ip.Endpoint;
    local:     schema.Text;
}

pub rec Runtime {
    heap:  *allocator.Allocator;
    graph: *schema.Graph;
    # the generation the process serves, which every worker builds from
    generation_id: u64;
    caching:       *http_cache.Layer;
    # one manager per configured certificate, `certificate_count` of them, and
    # beside each the tls-alpn-01 presentation it answers through and the
    # listener policy it is installed into
    certificates:         *acme.Manager;
    alpn_challenges:      *tlsalpn.Alpn;
    certificate_policies: [schema.MAX_ACME_CERTIFICATES]usize;
    certificate_count:    usize;
    # how many managers opened, which is how many close
    certificates_opened: usize;
    challenge_binding:   handler.Binding;
    observability:       telemetry_production.Production;
    options:             Options;
    # the secret the process's peer-keyed tables are placed by, drawn once at
    # start. a peer who could guess it could aim collisions at one bucket
    key: siphash.Key;
    # the caps every worker shares, and where a worker waiting for one is woken
    wakers: allowance.Wakers;
    board:  handoff.Board;
    # the board datagrams cross workers on, and whether the process keyed its
    # QUIC listeners (hedge.protocol.quic.keys), made only when one is configured
    steering:   steering.Board;
    quic_keyed: bool;
    # why the last reload kept each filed QUIC listener's keys, nil where it
    # took its key file
    quic_keys_kept:  [schema.MAX_LISTENERS]str;
    connections:     process_admission.Shared;
    handshakes:      process_admission.Shared;
    handshake_slots: allowance.Pool;
    # each named budget's caps, one bank per generation alternating as plans do
    budget_pools: [2]allowance.BudgetPools;
    caps_live:    bool;
    # the address each listener's first worker bound, which the other workers
    # bind again beside it
    endpoints: [schema.MAX_LISTENERS]ip.Endpoint;
    # every listener as the first worker bound it, recorded once it serves
    bound:       [schema.MAX_LISTENERS]Bound;
    bound_count: usize;
    # every worker, allocated at start and owned for the process lifetime
    workers:        *worker.Worker;
    worker_count:   usize;
    cache_live:     bool;
    acme_live:      bool;
    key_ring_live:  bool;
    tls_live:       bool;
    telemetry_live: bool;
    hosted_live:    bool;
    events:         [16]Event;
    event_count:    usize;
}

fun event(runtime: *Runtime, value: Event) {
    if (runtime.event_count < 16) {
        runtime.events[runtime.event_count] = value;
        runtime.event_count                 = runtime.event_count + 1;
    }
}

pub fun event_at(runtime: *Runtime, index: usize) Event {
    if (runtime == nil || index >= runtime.event_count) { ret 0; }
    ret runtime.events[index];
}

# the worker at `index`, or nil past the last
pub fun worker_at(runtime: *Runtime, index: usize) *worker.Worker {
    if (runtime == nil || runtime.workers == nil || index >= runtime.worker_count) { ret nil; }
    ret ?runtime.workers[index];
}

# what the process hands a worker for each service generation it builds
fun inputs(runtime: *Runtime, current: *worker.Worker,
    configured: *schema.Graph) worker.Inputs {
    var value: worker.Inputs;
    value.caching                = nil;
    value.applications           = runtime.options.applications;
    value.native                 = runtime.options.native;
    value.observability          = ?current.recorder;
    value.listener_services      = ?runtime.observability.listener_services[0];
    value.listener_service_count = runtime.observability.listener_service_count;
    value.challenge              = nil;
    value.recording              = current.recording;
    if (runtime.cache_live) { value.caching = runtime.caching; }
    if (runtime.acme_live && schema.acme_uses(configured, schema.CHALLENGE_HTTP_01)) {
        value.challenge = ?runtime.challenge_binding;
    }
    ret value;
}

# the process's caps, which every worker's admission, QUIC handshakes and
# budgets draw their allowances from
fun make_caps(runtime: *Runtime, configured: *schema.Graph, generation_id: u64,
    workers: usize) bool {
    val limits: *schema.Limits = ?configured.limits;
    if (!allowance.make_wakers(?runtime.wakers, workers)
        || !handoff.make_board(?runtime.board, runtime.heap, ?runtime.wakers, workers)) { ret false; }
    if (!process_admission.make_shared(?runtime.connections, runtime.heap, runtime.key,
        limits.max_connections, limits.max_connections_per_peer, workers,
        ?runtime.wakers)) {
        handoff.destroy_board(?runtime.board);
        ret false;
    }
    if (!process_admission.make_shared(?runtime.handshakes, runtime.heap, runtime.key,
        opt[usize].none{}, limits.max_handshakes_per_peer, workers, ?runtime.wakers)) {
        process_admission.destroy_shared(?runtime.connections);
        handoff.destroy_board(?runtime.board);
        ret false;
    }
    if (!allowance.make_pool(?runtime.handshake_slots,
        opt[usize].some{limits.max_handshakes},
        allowance.batch_for(limits.max_handshakes, workers, allowance.MAX_BATCH),
        ?runtime.wakers)
        || !allowance.make_budget_pools(?runtime.budget_pools[0], configured,
        generation_id, workers, ?runtime.wakers)) {
        process_admission.destroy_shared(?runtime.connections);
        process_admission.destroy_shared(?runtime.handshakes);
        handoff.destroy_board(?runtime.board);
        ret false;
    }
    runtime.budget_pools[1].generation = 0;
    runtime.budget_pools[1].count      = 0;
    if (!make_quic_caps(runtime, configured, workers)) {
        process_admission.destroy_shared(?runtime.connections);
        process_admission.destroy_shared(?runtime.handshakes);
        handoff.destroy_board(?runtime.board);
        ret false;
    }
    runtime.caps_live = true;
    ret true;
}

# a board for `workers` workers that forwards nothing when there is one, and
# keys for every listener index, which only QUIC listeners use
fun make_quic_caps(runtime: *Runtime, configured: *schema.Graph, workers: usize) bool {
    runtime.quic_keyed = false;
    if (!steering.make_board(?runtime.steering, nil, nil, 1)) { ret false; }
    if (!worker.quic_required(configured))                    { ret true; }
    if (!quic_keys.make(configured.listener_count))           { ret false; }
    if (!steering.make_board(?runtime.steering, runtime.heap, ?runtime.wakers, workers)) {
        quic_keys.destroy();
        ret false;
    }
    runtime.quic_keyed = true;
    ret true;
}

# every QUIC listener that names a key file takes its keys from it. a refusal
# is diagnosed against the listener
fun file_quic_keys(runtime: *Runtime, configured: *schema.Graph,
    diagnostics: *schema.Diagnostics) bool {
    var i: usize = 0;
    for (i < schema.MAX_LISTENERS) {
        runtime.quic_keys_kept[i] = nil;
        i                         = i + 1;
    }
    if (!runtime.quic_keyed) { ret true; }
    val now_ns: u64  = clock.monotonic_ns();
    var ok:     bool = true;
    i = 0;
    for (i < configured.listener_count) {
        val listener: *schema.Listener = ?configured.listeners[i];
        if (listener.transport == schema.TRANSPORT_QUIC && listener.quic_keys.len > 0) {
            var file:   quic_keys.File;
            var reason: str            = nil;
            val read:   keyfile.Status = keyfile.read(schema.text(?listener.quic_keys), ?file);
            if (read != keyfile.OK) { reason = keyfile.message(read); }
            or {
                var host: u32 = 0;
                if (sel listener.quic_host_id.some) { host = listener.quic_host_id.some::u32; }
                val filed: quic_keys.Status = quic_keys.start_filed(
                    quic_keys.listener_at(i), host, ?file, now_ns);
                if (filed != quic_keys.KEYED) { reason = quic_keys.message(filed); }
            }
            quic_keys.wipe_file(?file);
            if (reason != nil) {
                schema.add_diagnostic(diagnostics, schema.ERROR, schema.INVALID_VALUE,
                    schema.text(?listener.quic_keys), schema.text(?listener.name), reason);
                ok = false;
            }
        }
        i = i + 1;
    }
    ret ok;
}

# what worker `index` shares with the others
fun caps(runtime: *Runtime) serve.Caps {
    ret serve.Caps{connections: ?runtime.connections, handshakes: ?runtime.handshakes,
        handshake_slots: ?runtime.handshake_slots, budgets: ?runtime.budget_pools[0],
        wakers:          ?runtime.wakers, board: ?runtime.board,
        steering:        ?runtime.steering};
}

fun built_events(runtime: *Runtime, given: *worker.Inputs) {
    if (given.caching != nil) {
        event(runtime, CACHE_BINDINGS_READY);
        event(runtime, CACHE_WRAPPER_READY);
    }
    event(runtime, PLAN_READY);
}

fun clean(runtime: *Runtime, controls: *worker.Controls) worker.StopReport {
    var report: worker.StopReport = worker.StopReport{stopped: true,
        reason:           lifecycle.IMMEDIATE, abandoned: 0, applications_abandoned: 0,
        tasks_abandoned:  0, serve_failures: 0,
        cleanup_failures: 0};
    var i: usize = 0;
    for (i < runtime.worker_count) {
        if (!stop_worker(runtime, i, controls, ?report)) { ret report; }
        i = i + 1;
    }
    close_process(runtime, ?report);
    ret report;
}

fun close_process(runtime: *Runtime, report: *worker.StopReport) {
    var i: usize = 0;
    if (runtime.hosted_live) {
        secret.close_store();
        settings.close_store();
        runtime.hosted_live = false;
    }
    if (runtime.telemetry_live) {
        observe.close();
        if (!telemetry_production.close(?runtime.observability)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.telemetry_live = false;
        event(runtime, TELEMETRY_CLOSED);
    }
    if (runtime.certificates_opened != 0) {
        i = 0;
        for (i < runtime.certificates_opened) {
            if (!acme.close(?runtime.certificates[i])) {
                report.cleanup_failures = report.cleanup_failures + 1;
            }
            i = i + 1;
        }
        runtime.certificates_opened = 0;
        runtime.acme_live           = false;
        event(runtime, ACME_CLOSED);
    }
    if (runtime.alpn_challenges != nil) {
        i = 0;
        for (i < runtime.certificate_count) {
            val presentation: *tlsalpn.Alpn = ?runtime.alpn_challenges[i];
            if (presentation.live && !tlsalpn.destroy(presentation)) {
                report.cleanup_failures = report.cleanup_failures + 1;
            }
            i = i + 1;
        }
    }
    # every key the managers and presentations drew is destroyed by now
    if (runtime.key_ring_live) {
        if (!keys.release_ring()) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.key_ring_live = false;
    }
    if (runtime.tls_live) {
        if (!hedge_tls.destroy()) { report.cleanup_failures = report.cleanup_failures + 1; }
        runtime.tls_live = false;
        event(runtime, TLS_DESTROYED);
    }
    var proxied: bool = false;
    i = 0;
    for (i < runtime.worker_count) {
        if (worker.close_proxy(?runtime.workers[i], report)) { proxied = true; }
        i = i + 1;
    }
    if (proxied) { event(runtime, PROXY_CLOSED); }
    if (runtime.cache_live) {
        i = 0;
        for (i < runtime.worker_count) {
            val recording: *http_cache.Recorders = runtime.workers[i].recording;
            if (recording != nil && !http_cache.close_recorders(recording)) {
                report.cleanup_failures = report.cleanup_failures + 1;
            }
            i = i + 1;
        }
        # the store worker drains its disk queue within the stop timeout (#286)
        if (!http_cache.close(runtime.caching, runtime.graph.timeouts.stop_ms * 1000000)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        runtime.cache_live = false;
        event(runtime, CACHE_CLOSED);
    }
    i = 0;
    for (i < runtime.worker_count) {
        worker.close_cache_bindings(?runtime.workers[i], report);
        i = i + 1;
    }
    var had_static: bool = false;
    i = 0;
    for (i < runtime.worker_count) {
        if (worker.close_static(?runtime.workers[i], report)) { had_static = true; }
        i = i + 1;
    }
    if (had_static) { event(runtime, STATIC_CLOSED); }
    if (runtime.caps_live) {
        if (!process_admission.destroy_shared(?runtime.connections)
            || !process_admission.destroy_shared(?runtime.handshakes)) {
            report.cleanup_failures = report.cleanup_failures + 1;
        }
        handoff.destroy_board(?runtime.board);
        steering.destroy_board(?runtime.steering);
        if (runtime.quic_keyed) {
            quic_keys.destroy();
            runtime.quic_keyed = false;
        }
        runtime.caps_live = false;
    }
}

fun fail(runtime: *Runtime, controls: *worker.Controls, status: worker.StartStatus,
    detail: str) worker.StartReport {
    clean(runtime, controls);
    ret worker.failed(status, detail);
}

pub fun start(runtime: *Runtime, controls: *worker.Controls,
    heap: *allocator.Allocator, configured: *schema.Graph,
    generation_id: u64, diagnostics: *schema.Diagnostics,
    options: Options) worker.StartReport {
    val process: worker.StartReport = start_process(runtime, heap, configured,
        generation_id, diagnostics, options, 1);
    if (process.status != worker.START_OK) { ret process; }
    val started: worker.StartReport = start_worker(runtime, 0, controls, false,
        diagnostics);
    if (started.status != worker.START_OK) {
        clean(runtime, controls);
    }
    ret started;
}

# whether a managed certificate that `challenge` validates is served by the
# listener named `listener`
fun validates_through(configured: *schema.Graph, listener: str, challenge: u8) bool {
    if (!configured.acme.enabled) { ret false; }
    var i: usize = 0;
    for (i < configured.acme.certificate_count) {
        val certificate: *schema.AcmeCertificate = ?configured.acme.certificates[i];
        if (certificate.challenge == challenge
            && schema.text_equals(?certificate.listener, listener)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# one manager per configured certificate, over a key ring sized for them all.
# a certificate whose stored state cannot be opened refuses the start, since
# its key files are the ones the exposure check guards
fun open_certificates(runtime: *Runtime, heap: *allocator.Allocator,
    configured: *schema.Graph, diagnostics: *schema.Diagnostics) worker.StartReport {
    val count:          usize                               = configured.acme.certificate_count;
    val manager_memory: res[*acme.Manager, allocator.Error] =
        allocator.allocate[acme.Manager](heap, count);
    val alpn_memory: res[*tlsalpn.Alpn, allocator.Error] =
        allocator.allocate[tlsalpn.Alpn](heap, count);
    if (sel manager_memory.err) {
        ret fail(runtime, nil, worker.START_RUNTIME, "certificate manager allocation failed");
    }
    if (sel alpn_memory.err) {
        ret fail(runtime, nil, worker.START_RUNTIME, "certificate manager allocation failed");
    }
    runtime.certificates      = manager_memory.ok;
    runtime.alpn_challenges   = alpn_memory.ok;
    runtime.certificate_count = count;
    var i: usize = 0;
    for (i < count) {
        runtime.alpn_challenges[i].live = false;
        runtime.certificate_policies[i] = hedge_tls.NO_POLICY;
        i                               = i + 1;
    }
    if (!keys.reserve(count)) {
        ret fail(runtime, nil, worker.START_RUNTIME, "the certificate key ring could not be reserved");
    }
    runtime.key_ring_live = true;
    i                     = 0;
    for (i < count) {
        val manager:     *acme.Manager           = ?runtime.certificates[i];
        val certificate: *schema.AcmeCertificate = ?configured.acme.certificates[i];
        var opened:      acme.Status             = acme.INVALID;
        if (certificate.challenge == schema.CHALLENGE_TLS_ALPN_01) {
            val presentation: *tlsalpn.Alpn = ?runtime.alpn_challenges[i];
            if (!tlsalpn.make(presentation)) {
                ret fail(runtime, nil, worker.START_RUNTIME,
                    "TLS-ALPN challenge state could not be constructed");
            }
            opened = acme.open_with_tls_alpn(manager, heap, configured, i,
                tlsalpn.provider(presentation));
        }
        or {
            opened = acme.open(manager, heap, configured, i);
        }
        if (opened == acme.EXPOSED) {
            val refusal: str = secret_file.message(secret_file.EXPOSED);
            schema.add_diagnostic(diagnostics, schema.ERROR, schema.INVALID_VALUE,
                acme.refused_key(manager), "acme.storage", refusal);
            ret fail(runtime, nil, worker.START_CONFIG, refusal);
        }
        if (opened != acme.OK) {
            ret fail(runtime, nil, worker.START_CONFIG, "certificate manager could not open its state");
        }
        runtime.certificates_opened = i + 1;
        if (certificate.challenge == schema.CHALLENGE_HTTP_01 &&
            !handler.bind(?runtime.challenge_binding, acme.challenge_table(manager))) {
            ret fail(runtime, nil, worker.START_RUNTIME,
                "challenge route could not be bound");
        }
        i = i + 1;
    }
    runtime.acme_live = true;
    ret worker.ok();
}

# each certificate into the policy of the listener it names: a tls-alpn-01
# presentation claims its slot there, and a certificate recovered from storage
# is installed before the listener accepts
fun place_certificates(runtime: *Runtime, configured: *schema.Graph) worker.StartReport {
    var i: usize = 0;
    for (i < runtime.certificate_count) {
        val manager: *acme.Manager = ?runtime.certificates[i];
        val policy:  usize         = hedge_tls.find(
            schema.text(?configured.acme.certificates[i].listener));
        if (policy == hedge_tls.NO_POLICY) {
            ret fail(runtime, nil, worker.START_CONFIG,
                "ACME listener has no published TLS policy");
        }
        runtime.certificate_policies[i] = policy;
        if (runtime.alpn_challenges[i].live &&
            !tlsalpn.bind_listener(?runtime.alpn_challenges[i], policy)) {
            ret fail(runtime, nil, worker.START_CONFIG,
                "TLS-ALPN challenge could not bind its listener");
        }
        if (acme.certificate_ready(manager) &&
            hedge_tls.install_acme(policy, manager) != hedge_tls.OK) {
            ret fail(runtime, nil, worker.START_CONFIG,
                "stored ACME certificate could not be installed");
        }
        i = i + 1;
    }
    ret worker.ok();
}

# the manager of configured certificate `index`, or nil past the last
pub fun certificate(runtime: *Runtime, index: usize) *acme.Manager {
    if (runtime == nil || !runtime.acme_live || index >= runtime.certificate_count) {
        ret nil;
    }
    ret ?runtime.certificates[index];
}

# what the process owns, and `workers` workers that own nothing yet. each
# worker is brought up by `start_worker`, on whichever thread will run it
pub fun start_process(runtime: *Runtime, heap: *allocator.Allocator,
    configured: *schema.Graph, generation_id: u64, diagnostics: *schema.Diagnostics,
    options: Options, workers: usize) worker.StartReport {
    if (runtime == nil || heap == nil || configured == nil || diagnostics == nil
        || generation_id == 0 || workers == 0) {
        ret worker.failed(worker.START_RUNTIME, "composition input is invalid");
    }
    runtime.heap                = heap;
    runtime.graph               = configured;
    runtime.generation_id       = generation_id;
    runtime.caching             = nil;
    runtime.certificates        = nil;
    runtime.alpn_challenges     = nil;
    runtime.certificate_count   = 0;
    runtime.certificates_opened = 0;
    runtime.key_ring_live       = false;
    runtime.options             = options;
    runtime.cache_live          = false;
    runtime.acme_live           = false;
    runtime.tls_live            = false;
    runtime.telemetry_live      = false;
    runtime.hosted_live         = false;
    runtime.event_count         = 0;
    handler.reset(?runtime.challenge_binding);
    runtime.workers      = nil;
    runtime.worker_count = 0;
    runtime.bound_count  = 0;
    # no fallback: a table placed by a guessable key is one a peer can flood
    val key: opt[siphash.Key] = options.entropy();
    if (!(sel key.some)) {
        ret worker.failed(worker.START_RUNTIME, ENTROPY_UNAVAILABLE);
    }
    runtime.key = key.some;

    val worker_memory: res[*worker.Worker, allocator.Error] =
        allocator.allocate[worker.Worker](heap, workers);
    if (sel worker_memory.err) {
        ret worker.failed(worker.START_RUNTIME, "worker allocation failed");
    }
    runtime.workers   = worker_memory.ok;
    runtime.caps_live = false;
    if (!make_caps(runtime, configured, generation_id, workers)) {
        ret worker.failed(worker.START_CONFIG, "admission caps could not be constructed");
    }
    if (!file_quic_keys(runtime, configured, diagnostics)) {
        ret fail(runtime, nil, worker.START_CONFIG, "a QUIC listener's key file was refused");
    }
    var i: usize = 0;
    for (i < workers) {
        if (!worker.make(?runtime.workers[i], i, options.pseudonym)) {
            ret fail(runtime, nil, worker.START_RUNTIME,
                "proxy runtime could not be constructed");
        }
        runtime.worker_count = i + 1;
        i                    = i + 1;
    }

    if (configured.cache.enabled) {
        val layer_memory: res[*http_cache.Layer, allocator.Error] =
            allocator.allocate[http_cache.Layer](heap, 1);
        val entry_memory: res[*cache_store.Entry, allocator.Error] =
            allocator.allocate[cache_store.Entry](heap, CACHE_ENTRIES);
        val body_memory: res[*u8, allocator.Error] =
            allocator.allocate[u8](heap, configured.cache.memory_bytes);
        if (sel layer_memory.err) { ret fail(runtime, nil, worker.START_RUNTIME, "cache allocation failed"); }
        if (sel entry_memory.err) { ret fail(runtime, nil, worker.START_RUNTIME, "cache allocation failed"); }
        if (sel body_memory.err)  { ret fail(runtime, nil, worker.START_RUNTIME, "cache allocation failed"); }
        runtime.caching = layer_memory.ok;
        if (!http_cache.from_config(runtime.caching, ?configured.cache,
            entry_memory.ok, CACHE_ENTRIES,
            body_memory.ok, configured.cache.memory_bytes, workers, runtime.key, heap)) {
            ret fail(runtime, nil, worker.START_CONFIG, "cache could not be constructed");
        }
        runtime.cache_live = true;
    }

    if (configured.acme.enabled) {
        val opened: worker.StartReport = open_certificates(runtime, heap, configured,
            diagnostics);
        if (opened.status != worker.START_OK) { ret opened; }
    }

    val secrets: str = secret.open_store(configured, options.applications,
        generation_id, options.providers);
    if (secrets != nil) { ret fail(runtime, nil, worker.START_CONFIG, secrets); }
    runtime.hosted_live = true;
    if (!settings.open_store(configured, generation_id)) {
        ret fail(runtime, nil, worker.START_RUNTIME, "application settings could not be opened");
    }

    if (!telemetry_production.make(?runtime.observability, heap, configured, workers,
        options.providers, options.telemetry, diagnostics)) {
        ret fail(runtime, nil, worker.START_CONFIG, "telemetry could not be constructed");
    }
    runtime.telemetry_live = true;
    if (!observe.open(?runtime.observability.runtime)) {
        ret fail(runtime, nil, worker.START_RUNTIME, "hosted telemetry could not be opened");
    }
    if (options.tasks != nil && runtime.observability.runtime.metrics_enabled
        && !telemetry.add_collector(?runtime.observability.runtime,
        telemetry_tasks.collector(options.tasks))) {
        ret fail(runtime, nil, worker.START_RUNTIME, "task metrics could not be collected");
    }

    hedge_tls.reset();
    runtime.tls_live = true;
    var listener_index: usize = 0;
    for (listener_index < configured.listener_count) {
        val selected: *schema.Listener = ?configured.listeners[listener_index];
        listener_index = listener_index + 1;
        if (selected.tls_policy.len == 0) { cnt; }
        val policy: *schema.TlsPolicy = schema.find_tls_policy(configured,
            schema.text(?selected.tls_policy));
        if (policy == nil) {
            ret fail(runtime, nil, worker.START_CONFIG, "listener references an unknown TLS policy");
        }
        var tls_options: hedge_tls.PublishOptions = hedge_tls.publish_options();
        tls_options.tls_alpn_challenge = validates_through(configured,
            schema.text(?selected.name), schema.CHALLENGE_TLS_ALPN_01);
        val published: hedge_tls.Status = hedge_tls.publish_with_options(
            schema.text(?selected.name), policy, selected.protocols, tls_options);
        if (published == hedge_tls.EXPOSED) {
            val refusal: str = secret_file.message(secret_file.EXPOSED);
            schema.add_diagnostic(diagnostics, schema.ERROR, schema.INVALID_VALUE,
                hedge_tls.refused_key(), schema.text(?policy.name), refusal);
            ret fail(runtime, nil, worker.START_CONFIG, refusal);
        }
        if (published != hedge_tls.OK) {
            ret fail(runtime, nil, worker.START_CONFIG, "TLS policy could not be published");
        }
    }
    if (runtime.acme_live) {
        val installed: worker.StartReport = place_certificates(runtime, configured);
        if (installed.status != worker.START_OK) { ret installed; }
    }
    ret worker.ok();
}

# build worker `index`'s first service generation and bring its serving runtime
# up, on the thread that will run it. a supervised worker leaves the process
# duties to its supervisor. on failure what the worker started is left for
# `stop_worker` to tear down
pub fun start_worker(runtime: *Runtime, index: usize, controls: *worker.Controls,
    supervised: bool, diagnostics: *schema.Diagnostics) worker.StartReport {
    val current: *worker.Worker = worker_at(runtime, index);
    if (current == nil || diagnostics == nil) {
        ret worker.failed(worker.START_RUNTIME, "worker input is invalid");
    }
    if (!current.recorder.live && !telemetry.make_recorder(?current.recorder,
        ?runtime.observability.runtime, index, runtime.heap)) {
        ret worker.failed(worker.START_RUNTIME,
            "the worker's telemetry recorder could not be made");
    }
    # the first worker resolves every address, and the rest bind what it bound
    var placed: *ip.Endpoint = nil;
    if (index != 0) { placed = ?runtime.endpoints[0]; }
    # the worker's recordings belong to it, beside the store every worker shares
    if (runtime.cache_live && current.recording == nil) {
        if (!http_cache.make_recorders(?current.cache_recorders, runtime.caching,
            runtime.heap)) {
            ret worker.failed(worker.START_RUNTIME, "cache recorders could not be constructed");
        }
        current.recording = ?current.cache_recorders;
    }
    var given: worker.Inputs      = inputs(runtime, current, runtime.graph);
    val built: worker.StartReport = worker.build_service_generation(current, 0,
        runtime.graph, runtime.generation_id, ?given);
    if (built.status != worker.START_OK) { ret built; }
    if (index == 0)                      { built_events(runtime, ?given); }
    val started: worker.StartReport = worker.start(current, controls, runtime.heap,
        runtime.graph, runtime.generation_id, caps(runtime), runtime.worker_count > 1,
        placed, supervised, diagnostics);
    if (started.status != worker.START_OK || index != 0) { ret started; }
    if (!record_bound(runtime, current)) {
        ret worker.failed(worker.START_RUNTIME,
            "a listener's bound address could not be read");
    }
    ret started;
}

# record what the first worker's listeners bound, on its own thread once it
# serves and before any other worker starts, which binds the same addresses.
# false when an IP listener's socket could not say where it is bound
fun record_bound(runtime: *Runtime, first: *worker.Worker) bool {
    runtime.bound_count = 0;
    var i: usize = 0;
    for (i < runtime.graph.listener_count) {
        val configured: *schema.Listener = ?runtime.graph.listeners[i];
        val entry:      *Bound           = ?runtime.bound[i];
        var unbound:    ip.Endpoint;
        entry.name      = configured.name;
        entry.transport = configured.transport;
        entry.protocols = configured.protocols;
        entry.secure    = configured.tls_policy.len != 0;
        entry.address   = unbound;
        schema.clear_text(?entry.local);
        if (configured.transport == schema.TRANSPORT_LOCAL) {
            entry.local = configured.address;
        }
        or {
            val owned: *listener.OwnedListener = listener.active_listener(
                ?first.serving.owner, i);
            if (owned == nil || !owned.has_bound_endpoint) { ret false; }
            entry.address        = owned.bound_endpoint;
            runtime.endpoints[i] = owned.bound_endpoint;
        }
        i = i + 1;
    }
    runtime.bound_count = runtime.graph.listener_count;
    ret true;
}

# how many listeners `bound` reports: every configured one once the first
# worker serves, and none before
pub fun bound_count(runtime: *Runtime) usize {
    if (runtime == nil) { ret 0; }
    ret runtime.bound_count;
}

# the listener at `index` as the process bound it, or nil past the last
pub fun bound(runtime: *Runtime, index: usize) *Bound {
    if (runtime == nil || index >= runtime.bound_count) { ret nil; }
    ret ?runtime.bound[index];
}

# stop worker `index` serving, on the thread that runs it, and release its QUIC
# runtime. false when it could not stop, which leaves it for a later retry
pub fun stop_worker(runtime: *Runtime, index: usize, controls: *worker.Controls,
    report: *worker.StopReport) bool {
    val current: *worker.Worker = worker_at(runtime, index);
    if (current == nil || report == nil) { ret false; }
    val was_live: bool = current.serve_live;
    if (!worker.stop_serving(current, controls, report)) { ret false; }
    # the event log is the first worker's, so workers stopping on threads of
    # their own never write it together
    if (was_live && index == 0) { event(runtime, SERVE_STOPPED); }
    ret true;
}

# what the process owns, torn down once every worker has stopped serving
pub fun close(runtime: *Runtime, report: *worker.StopReport) {
    close_process(runtime, report);
}

# stop every worker and tear the process down, for a process whose workers run
# on the calling thread
pub fun stop(runtime: *Runtime, controls: *worker.Controls) worker.StopReport {
    if (runtime == nil) {
        ret worker.StopReport{stopped: false, reason: lifecycle.FAILED, abandoned: 0,
            applications_abandoned: 0, tasks_abandoned: 0, serve_failures: 0,
            cleanup_failures:       0};
    }
    ret clean(runtime, controls);
}

# installs what certificate `index` finished issuing into its listener
pub fun install_certificate(runtime: *Runtime, index: usize, now: time.Time)
    hedge_tls.Status {
    val manager: *acme.Manager = certificate(runtime, index);
    if (manager == nil || !runtime.tls_live ||
        runtime.certificate_policies[index] == hedge_tls.NO_POLICY ||
        !acme.installation_ready(manager)) { ret hedge_tls.INVALID; }
    val installed: hedge_tls.Status = hedge_tls.install_acme(
        runtime.certificate_policies[index], manager);
    if (installed == hedge_tls.OK) {
        acme.installed(manager, now);
    }
    ret installed;
}

pub fun service_snapshot(runtime: *Runtime, slot: usize) worker.ServiceSnapshot {
    ret worker.service_snapshot(worker_at(runtime, 0), slot);
}

pub fun active_service_generation(runtime: *Runtime) usize {
    val first: *worker.Worker = worker_at(runtime, 0);
    if (first == nil) { ret 0; }
    ret first.active_generation;
}

# live connections still on a superseded generation, across every worker
pub fun superseded(runtime: *Runtime, controls: *worker.Controls) usize {
    var quic_controls: quic_runtime.ControlView;
    worker.controls_view(controls, ?quic_controls);
    if (runtime == nil) { ret 0; }
    var count: usize = 0;
    var i:     usize = 0;
    for (i < runtime.worker_count) {
        count = count + serve.superseded(?quic_controls, ?runtime.workers[i].serving);
        i     = i + 1;
    }
    ret count;
}

pub fun reclaim_superseded(runtime: *Runtime, controls: *worker.Controls) bool {
    if (runtime == nil || runtime.worker_count == 0) { ret false; }
    var ok: bool  = true;
    var i:  usize = 0;
    for (i < runtime.worker_count) {
        if (!worker.reclaim_superseded(?runtime.workers[i], controls)) { ok = false; }
        i = i + 1;
    }
    ret ok;
}

# whether the process may take a reload to `configured` at all: what startup
# owns is unchanged. the workers' own checks come in `prepare_reload`
pub fun reload_compatible(runtime: *Runtime, configured: *schema.Graph) bool {
    ret runtime != nil && configured != nil && plan.reload_compatible(runtime.graph, configured);
}

# what the process builds for a candidate once every worker has prepared it: the
# pools its budgets share, in the bank the serving generation does not use.
# preparing gave back every share of the bank's old pools
pub fun stage_reload(runtime: *Runtime, configured: *schema.Graph,
    generation_id: u64) bool {
    if (runtime == nil || configured == nil || !runtime.caps_live) { ret false; }
    var slot: usize = 0;
    if (runtime.budget_pools[0].generation == runtime.generation_id) { slot = 1; }
    if (!allowance.make_budget_pools(?runtime.budget_pools[slot], configured,
        generation_id, runtime.worker_count, ?runtime.wakers)) { ret false; }
    rotate_quic_keys(runtime, configured);
    ret true;
}

# what a candidate hands hosted applications, beside what they read now: the
# secrets it grants, resolved, and its settings. nil, or why it could not
pub fun stage_hosted(runtime: *Runtime, configured: *schema.Graph,
    generation_id: u64) str {
    if (runtime == nil || !runtime.hosted_live) { ret "hosted application state is not open"; }
    val secrets: str = secret.stage_store(configured, runtime.options.applications,
        generation_id);
    if (secrets != nil) { ret secrets; }
    if (!settings.stage_store(configured, generation_id)) {
        secret.discard_store();
        ret "application settings could not be staged";
    }
    ret nil;
}

# drops what `stage_hosted` took for a reload that was not published
pub fun discard_hosted(runtime: *Runtime) {
    if (runtime != nil && runtime.hosted_live) {
        secret.discard_store();
        settings.discard_store();
    }
}

# every reload moves each QUIC listener's connection IDs and tokens onto fresh
# keys, or onto what its key file now holds. live connections move off the old
# codepoint as their clients retire the IDs minted under it, and it decodes on
# until nothing can carry it: no live connection holds an ID under it, and a
# Retry minted under it has outlived its token and the handshake that could
# follow. a rotation that
# finds no free codepoint leaves the current keys and is counted, and a key file
# that is refused leaves them too, and says why in `quic_keys_kept`
fun rotate_quic_keys(runtime: *Runtime, configured: *schema.Graph) {
    if (!runtime.quic_keyed) { ret; }
    val grace_ns: u64 = serve.QUIC_RETRY_MAX_AGE_NS
        + configured.timeouts.handshake_ms * 1000000;
    val now_ns: u64   = clock.monotonic_ns();
    var i:      usize = 0;
    for (i < configured.listener_count) {
        val listener: *schema.Listener    = ?configured.listeners[i];
        val keys:     *quic_keys.Listener = quic_keys.listener_at(i);
        runtime.quic_keys_kept[i] = nil;
        if (listener.transport == schema.TRANSPORT_QUIC && keys.filed) {
            var file: quic_keys.File;
            val read: keyfile.Status = keyfile.read(schema.text(?listener.quic_keys), ?file);
            if (read != keyfile.OK) { runtime.quic_keys_kept[i] = keyfile.message(read); }
            or {
                val adopted: quic_keys.Status = quic_keys.adopt(keys, ?file, now_ns,
                    grace_ns, runtime.worker_count);
                if (adopted != quic_keys.KEYED) {
                    runtime.quic_keys_kept[i] = quic_keys.message(adopted);
                }
            }
            quic_keys.wipe_file(?file);
        }
        or (listener.transport == schema.TRANSPORT_QUIC) {
            quic_keys.rotate(keys, now_ns, grace_ns, runtime.worker_count);
        }
        i = i + 1;
    }
}

# why the last reload kept listener `index`'s key file keys rather than take its
# file, or nil when it took it or has none
pub fun quic_keys_kept(runtime: *Runtime, index: usize) str {
    if (runtime == nil || index >= schema.MAX_LISTENERS) { ret nil; }
    ret runtime.quic_keys_kept[index];
}

# the first step of a reload, on worker `index`'s thread: build the candidate's
# service generation into the spare slot and ask the serving runtime whether it
# would publish it. a refusal leaves the worker as it was
pub fun prepare_reload(runtime: *Runtime, index: usize, controls: *worker.Controls,
    configured: *schema.Graph, generation_id: u64,
    diagnostics: *schema.Diagnostics) worker.StartReport {
    var quic_controls: quic_runtime.ControlView;
    worker.controls_view(controls, ?quic_controls);
    val current: *worker.Worker = worker_at(runtime, index);
    if (current == nil || configured == nil || generation_id == 0
        || diagnostics == nil || !current.serve_live
        || generation_id <= current.service_generations[current.active_generation].generation
        || serve.superseded(?quic_controls, ?current.serving) != 0) {
        ret worker.failed(worker.START_RUNTIME, "service generation is not reclaimable");
    }
    if (!worker.reclaim_superseded(current, controls)) {
        ret worker.failed(worker.START_RUNTIME,
            "superseded service generation could not be released");
    }
    serve.leave_spare_budgets(?current.serving);
    val target: usize              = 1 - current.active_generation;
    var given:  worker.Inputs      = inputs(runtime, current, configured);
    val built:  worker.StartReport = worker.build_service_generation(current, target,
        configured, generation_id, ?given);
    if (built.status != worker.START_OK) { ret built; }
    if (!serve.check_reload(?quic_controls, ?current.serving, generation_id,
        ?current.plans[target], configured, diagnostics)) {
        worker.close_service_generation(current, target);
        ret worker.failed(worker.START_RUNTIME, "listeners would not republish");
    }
    ret worker.ok();
}

# the second step: publish what `prepare_reload` built
pub fun commit_reload(runtime: *Runtime, index: usize, controls: *worker.Controls,
    configured: *schema.Graph, generation_id: u64,
    diagnostics: *schema.Diagnostics) worker.StartReport {
    val current: *worker.Worker = worker_at(runtime, index);
    if (current == nil) { ret worker.failed(worker.START_RUNTIME, "worker input is invalid"); }
    ret worker.publish(current, controls, configured, generation_id, diagnostics);
}

# another worker refused: drop what `prepare_reload` built
pub fun abort_reload(runtime: *Runtime, index: usize) bool {
    val current: *worker.Worker = worker_at(runtime, index);
    if (current == nil) { ret false; }
    ret worker.close_service_generation(current, 1 - current.active_generation);
}

# a reload the process now serves: what every later worker builds from
pub fun reloaded(runtime: *Runtime, configured: *schema.Graph, generation_id: u64) {
    runtime.graph         = configured;
    runtime.generation_id = generation_id;
    if (runtime.hosted_live) {
        secret.publish_store(generation_id);
        settings.publish_store(generation_id);
    }
    # the handshake caps move once for every worker. the connection caps are
    # startup-owned
    if (runtime.caps_live) {
        allowance.retune(?runtime.handshake_slots, configured.limits.max_handshakes);
        process_admission.retune_shared(?runtime.handshakes, opt[usize].none{},
            configured.limits.max_handshakes_per_peer);
    }
}

# a whole reload of a process whose workers run on the calling thread
pub fun reload(runtime: *Runtime, controls: *worker.Controls,
    configured: *schema.Graph, generation_id: u64,
    diagnostics: *schema.Diagnostics) worker.StartReport {
    if (runtime == nil || configured == nil || superseded(runtime, controls) != 0) {
        ret worker.failed(worker.START_RUNTIME, "service generation is not reclaimable");
    }
    if (!reload_compatible(runtime, configured)) {
        ret worker.failed(worker.START_CONFIG,
            "startup-owned configuration changed; restart required");
    }
    val staged: str = stage_hosted(runtime, configured, generation_id);
    if (staged != nil) { ret worker.failed(worker.START_CONFIG, staged); }
    var i: usize = 0;
    for (i < runtime.worker_count) {
        val prepared: worker.StartReport = prepare_reload(runtime, i, controls,
            configured, generation_id, diagnostics);
        if (prepared.status != worker.START_OK) {
            var j: usize = 0;
            for (j < i) {
                abort_reload(runtime, j);
                j = j + 1;
            }
            discard_hosted(runtime);
            ret prepared;
        }
        i = i + 1;
    }
    # the budget caps are rebuilt once every worker has given back what it
    # held of the ones they replace
    if (!stage_reload(runtime, configured, generation_id)) {
        i = 0;
        for (i < runtime.worker_count) {
            abort_reload(runtime, i);
            i = i + 1;
        }
        discard_hosted(runtime);
        ret worker.failed(worker.START_RUNTIME, "budget caps could not be constructed");
    }
    i = 0;
    for (i < runtime.worker_count) {
        val published: worker.StartReport = commit_reload(runtime, i, controls,
            configured, generation_id, diagnostics);
        if (published.status != worker.START_OK) {
            discard_hosted(runtime);
            ret published;
        }
        i = i + 1;
    }
    reloaded(runtime, configured, generation_id);
    ret worker.ok();
}

# the disk requests the cache's store worker still holds, which outlive a close
# that timed out, so a stop can name them (#286)
pub fun cache_stalled(runtime: *Runtime, output: *store_worker.Outstanding,
    capacity: usize) usize {
    if (runtime == nil) { ret 0; }
    ret http_cache.stalled(runtime.caching, output, capacity);
}

pub fun cache(runtime: *Runtime) *http_cache.Layer {
    if (runtime == nil || !runtime.cache_live) { ret nil; }
    ret runtime.caching;
}
