# production object wiring and lifetime ownership

use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.allocator;
use std.chrono.time;
use hedge.config.schema;
use hedge.generation;
use hedge.service;
use static_files: hedge.service.static;
use proxy: hedge.service.proxy;
use http_cache: hedge.cache;
use cache_store: hedge.cache.store;
use upstream: hedge.proxy.upstream;
use engine_h1: http.h1.connection;
use acme: hedge.acme.manager;
use handler: hedge.acme.handler;
use hedge_tls: hedge.protocol.tls;
use lifecycle: hedge.lifecycle;
use hedge.serve;
use hedge.connection;
use plan: hedge.dispatch.plan;
use middleware: hedge.dispatch.middleware;
use router: http.router.router;
use telemetry: hedge.telemetry;
use telemetry_production: hedge.telemetry.production;

pub val MAX_ROUTES: usize = 64;
pub val MAX_SEGMENTS: usize = 512;
pub val MAX_SERVICES: usize = 32;
pub val MAX_MIDDLEWARE: usize = 16;
pub val MAX_STATIC_ROOTS: usize = 16;
pub val CACHE_ENTRIES: usize = 128;
pub val PLAN_TEXT_BYTES: usize = 16384;
pub val DEFAULT_CONNECTIONS: usize = 64;

pub rec PlanStorage {
    routes: [MAX_ROUTES]router.CompiledRoute;
    segments: [MAX_SEGMENTS]router.Segment;
    specs: [MAX_ROUTES]router.Route;
    entries: [MAX_ROUTES]plan.Entry;
    services: [MAX_SERVICES]service.Descriptor;
    middleware: [MAX_MIDDLEWARE]middleware.Middleware;
    text: [PLAN_TEXT_BYTES]u8;
}

pub def StartStatus: u8;
pub val START_OK: StartStatus = 1;
pub val START_CONFIG: StartStatus = 2;
pub val START_RUNTIME: StartStatus = 3;

pub rec StartReport {
    status: StartStatus;
    detail: str;
}

pub def Event: u8;
pub val CACHE_BINDINGS_READY: Event = 1;
pub val CACHE_WRAPPER_READY: Event = 2;
pub val PLAN_READY: Event = 3;
pub val SERVE_STOPPED: Event = 4;
pub val ACME_CLOSED: Event = 5;
pub val TLS_DESTROYED: Event = 6;
pub val PROXY_CLOSED: Event = 7;
pub val CACHE_CLOSED: Event = 8;
pub val STATIC_CLOSED: Event = 9;
pub val TELEMETRY_CLOSED: Event = 10;

rec Planes {
    proxying: *proxy.Runtime;
    certificates: *acme.Manager;
}

# one service bank retained by every connection on its plan
pub rec ServiceGeneration {
    static_registry: static_files.Registry;
    static_sites: [MAX_STATIC_ROOTS]static_files.Site;
    proxy_registry: proxy.Registry;
    proxy_bindings: proxy.Bindings;
    proxy_binding_storage: [MAX_SERVICES]proxy.Binding;
    cache_bindings: http_cache.Bindings;
    cache_binding_storage: [MAX_SERVICES]http_cache.Binding;
    services: service.Resolver;
    generation: u64;
    static_live: bool;
    proxy_live: bool;
    cache_live: bool;
    live: bool;
}

pub rec Options {
    native: service.Factory;
    pseudonym: str;
    telemetry: telemetry_production.Options;
}

pub fun default_options() Options {
    ret Options{native: service.no_factory(), pseudonym: "hedge",
        telemetry: telemetry_production.default_options()};
}

pub rec Runtime {
    heap: *allocator.Allocator;
    graph: *schema.Graph;
    applications: service.Applications;
    application_slots: [service.MAX_APPLICATIONS]service.Application;
    proxying: proxy.Runtime;
    caching: *http_cache.Layer;
    certificates: *acme.Manager;
    challenge_binding: handler.Binding;
    service_generations: [2]ServiceGeneration;
    plans: [2]plan.Plan;
    observability: telemetry_production.Production;
    serving: serve.Runtime;
    slots: *serve.Slot;
    connections: *connection.Connection;
    planes: Planes;
    options: Options;
    active_generation: usize;
    proxy_live: bool;
    cache_live: bool;
    acme_live: bool;
    tls_live: bool;
    telemetry_live: bool;
    serve_live: bool;
    events: [16]Event;
    event_count: usize;
}

pub rec StopReport {
    stopped: bool;
    reason: lifecycle.Reason;
    abandoned: usize;
    serve_failures: u64;
    cleanup_failures: u64;
}

fun event(runtime: *Runtime, value: Event) {
    if (runtime.event_count < 16) {
        runtime.events[runtime.event_count] = value;
        runtime.event_count = runtime.event_count + 1;
    }
}

pub fun event_at(runtime: *Runtime, index: usize) Event {
    if (runtime == nil || index >= runtime.event_count) { ret 0; }
    ret runtime.events[index];
}

pub fun make_storage(storage: *plan.Storage, backing: *PlanStorage) bool {
    if (storage == nil || backing == nil) { ret false; }
    ret plan.make_storage(storage,
        ?backing.routes[0], MAX_ROUTES,
        ?backing.segments[0], MAX_SEGMENTS,
        ?backing.specs[0], MAX_ROUTES,
        ?backing.entries[0], MAX_ROUTES,
        ?backing.services[0], MAX_SERVICES,
        ?backing.middleware[0], MAX_MIDDLEWARE,
        ?backing.text[0], PLAN_TEXT_BYTES);
}

fun drive_planes(context: ptr, now: time.Time) bool {
    val planes: *Planes = context::*Planes;
    if (planes == nil) { ret false; }
    var advanced: bool = true;
    if (planes.proxying != nil) {
        advanced = proxy.poll((planes.proxying)::ptr, now) && advanced;
    }
    if (planes.certificates != nil) {
        advanced = acme.poll((planes.certificates)::ptr, now) && advanced;
    }
    ret advanced;
}

fun close_proxy_generation(runtime: *Runtime, slot: usize) bool {
    val services: *ServiceGeneration = ?runtime.service_generations[slot];
    if (!services.proxy_live) { ret true; }
    if (!proxy.close_registry(?runtime.proxying, ?services.proxy_registry)) {
        ret false;
    }
    services.proxy_live = false;
    ret true;
}

fun close_cache_generation(runtime: *Runtime, slot: usize) bool {
    val services: *ServiceGeneration = ?runtime.service_generations[slot];
    if (!services.cache_live) { ret true; }
    if (!http_cache.release_bindings(?services.cache_bindings)) { ret false; }
    services.cache_live = false;
    ret true;
}

fun close_static_generation(runtime: *Runtime, slot: usize) bool {
    val services: *ServiceGeneration = ?runtime.service_generations[slot];
    if (!services.static_live) { ret true; }
    if (!static_files.close_registry(?services.static_registry)) { ret false; }
    services.static_live = false;
    ret true;
}

fun close_service_generation(runtime: *Runtime, slot: usize) bool {
    var ok: bool = close_proxy_generation(runtime, slot);
    ok = close_cache_generation(runtime, slot) && ok;
    ok = close_static_generation(runtime, slot) && ok;
    if (ok) {
        runtime.service_generations[slot].generation = 0;
        runtime.service_generations[slot].live = false;
    }
    ret ok;
}

fun clean(runtime: *Runtime) StopReport {
    var stopped: bool = true;
    var reason: lifecycle.Reason = lifecycle.IMMEDIATE;
    var abandoned: usize = 0;
    var serve_failures: u64 = 0;
    var cleanup_failures: u64 = 0;
    if (runtime.serve_live) {
        stopped = serve.stop(?runtime.serving);
        reason = serve.shutdown_reason(?runtime.serving);
        abandoned = serve.shutdown_cancelled(?runtime.serving);
        serve_failures = serve.teardown_failures(?runtime.serving);
        runtime.serve_live = false;
        event(runtime, SERVE_STOPPED);
    }
    if (runtime.telemetry_live) {
        if (!telemetry_production.close(?runtime.observability)) {
            cleanup_failures = cleanup_failures + 1;
        }
        runtime.telemetry_live = false;
        event(runtime, TELEMETRY_CLOSED);
    }
    if (runtime.acme_live) {
        if (!acme.close(runtime.certificates)) { cleanup_failures = cleanup_failures + 1; }
        runtime.acme_live = false;
        event(runtime, ACME_CLOSED);
    }
    if (runtime.tls_live) {
        if (!hedge_tls.destroy()) { cleanup_failures = cleanup_failures + 1; }
        runtime.tls_live = false;
        event(runtime, TLS_DESTROYED);
    }
    if (runtime.proxy_live) {
        if (!proxy.close_runtime(?runtime.proxying)) { cleanup_failures = cleanup_failures + 1; }
        var i: usize = 0;
        for (i < 2) {
            if (!close_proxy_generation(runtime, i)) {
                cleanup_failures = cleanup_failures + 1;
            }
            i = i + 1;
        }
        runtime.proxy_live = false;
        event(runtime, PROXY_CLOSED);
    }
    if (runtime.cache_live) {
        if (!http_cache.close(runtime.caching)) { cleanup_failures = cleanup_failures + 1; }
        runtime.cache_live = false;
        event(runtime, CACHE_CLOSED);
    }
    var i: usize = 0;
    for (i < 2) {
        if (!close_cache_generation(runtime, i)) {
            cleanup_failures = cleanup_failures + 1;
        }
        i = i + 1;
    }
    var had_static: bool = false;
    i = 0;
    for (i < 2) {
        if (runtime.service_generations[i].static_live) { had_static = true; }
        if (!close_static_generation(runtime, i)) {
            cleanup_failures = cleanup_failures + 1;
        }
        runtime.service_generations[i].generation = 0;
        runtime.service_generations[i].live = false;
        i = i + 1;
    }
    if (had_static) {
        event(runtime, STATIC_CLOSED);
    }
    ret StopReport{
        stopped: stopped,
        reason: reason,
        abandoned: abandoned,
        serve_failures: serve_failures,
        cleanup_failures: cleanup_failures,
    };
}

fun fail(runtime: *Runtime, status: StartStatus, detail: str) StartReport {
    clean(runtime);
    ret StartReport{status: status, detail: detail};
}

fun build_service_generation(runtime: *Runtime, slot: usize,
    configured: *schema.Graph, generation_id: u64, storage: *PlanStorage,
    record_events: bool) StartReport {
    if (runtime == nil || configured == nil || generation_id == 0 || storage == nil
     || slot >= 2) {
        ret StartReport{status: START_RUNTIME, detail: "service generation input is invalid"};
    }
    val current: *ServiceGeneration = ?runtime.service_generations[slot];
    current.generation = generation_id;
    current.static_live = false;
    current.proxy_live = false;
    current.cache_live = false;
    current.live = false;
    if (!static_files.make_registry(?current.static_registry, ?current.static_sites[0],
        MAX_STATIC_ROOTS, generation_id, static_files.default_options())) {
        ret StartReport{status: START_RUNTIME,
            detail: "static registry could not be constructed"};
    }
    current.static_live = true;
    if (!proxy.make_registry(?current.proxy_registry, generation_id)) {
        close_service_generation(runtime, slot);
        ret StartReport{status: START_RUNTIME,
            detail: "proxy registry could not be constructed"};
    }
    current.proxy_live = true;
    if (!proxy.make_bindings(?current.proxy_bindings,
        ?current.proxy_binding_storage[0], MAX_SERVICES, ?runtime.proxying,
        ?current.proxy_registry)) {
        close_service_generation(runtime, slot);
        ret StartReport{status: START_RUNTIME,
            detail: "proxy bindings could not be constructed"};
    }
    if (runtime.cache_live) {
        if (!http_cache.make_bindings(?current.cache_bindings,
            ?current.cache_binding_storage[0], MAX_SERVICES, runtime.caching,
            generation_id)) {
            close_service_generation(runtime, slot);
            ret StartReport{status: START_RUNTIME,
                detail: "cache bindings could not be constructed"};
        }
        current.cache_live = true;
        if (record_events) { event(runtime, CACHE_BINDINGS_READY); }
    }

    current.services = service.no_resolver();
    current.services.applications = ?runtime.applications;
    current.services.observer = telemetry.observer(?runtime.observability.runtime);
    current.services.listener_services = ?runtime.observability.listener_services[0];
    current.services.listener_service_count =
        runtime.observability.listener_service_count;
    current.services.static_files = service.Factory{
        ctx: (?current.static_registry)::ptr,
        build: static_files.factory,
    };
    current.services.proxy = service.Factory{
        ctx: (?current.proxy_bindings)::ptr,
        build: proxy.factory,
    };
    current.services.native = runtime.options.native;
    if (current.cache_live) {
        current.services.caching = service.Wrapper{
            ctx: (?current.cache_bindings)::ptr,
            wrap: http_cache.wrapper,
        };
        if (record_events) { event(runtime, CACHE_WRAPPER_READY); }
    }
    if (runtime.acme_live) {
        current.services.native = handler.factory(?runtime.challenge_binding);
    }

    var layout: plan.Storage;
    if (!make_storage(?layout, storage)) {
        close_service_generation(runtime, slot);
        ret StartReport{status: START_RUNTIME, detail: "plan storage layout is invalid"};
    }
    val built: plan.Report = plan.compile(?runtime.plans[slot], generation_id,
        configured, layout, ?current.services, nil);
    if (built.status != plan.PLAN_OK) {
        close_service_generation(runtime, slot);
        ret StartReport{status: START_CONFIG, detail: built.detail};
    }
    current.live = true;
    if (record_events) { event(runtime, PLAN_READY); }
    ret StartReport{status: START_OK, detail: nil};
}

pub fun start(runtime: *Runtime, heap: *allocator.Allocator, configured: *schema.Graph,
    generation_id: u64, storage: *PlanStorage, diagnostics: *schema.Diagnostics,
    options: Options) StartReport {
    if (runtime == nil || heap == nil || configured == nil || storage == nil
     || diagnostics == nil) {
        ret StartReport{status: START_RUNTIME, detail: "composition input is invalid"};
    }
    runtime.heap = heap;
    runtime.graph = configured;
    runtime.caching = nil;
    runtime.certificates = nil;
    runtime.slots = nil;
    runtime.connections = nil;
    runtime.options = options;
    runtime.active_generation = 0;
    runtime.proxy_live = false;
    runtime.cache_live = false;
    runtime.acme_live = false;
    runtime.tls_live = false;
    runtime.telemetry_live = false;
    runtime.serve_live = false;
    runtime.event_count = 0;
    var generation_slot: usize = 0;
    for (generation_slot < 2) {
        runtime.service_generations[generation_slot].generation = 0;
        runtime.service_generations[generation_slot].static_live = false;
        runtime.service_generations[generation_slot].proxy_live = false;
        runtime.service_generations[generation_slot].cache_live = false;
        runtime.service_generations[generation_slot].live = false;
        generation_slot = generation_slot + 1;
    }

    if (!service.make_applications(?runtime.applications,
        ?runtime.application_slots[0], service.MAX_APPLICATIONS)) {
        ret fail(runtime, START_RUNTIME, "application registry could not be constructed");
    }
    if (!proxy.make_runtime(?runtime.proxying, nil, options.pseudonym,
        engine_h1.config_default(), upstream.default_limits())) {
        ret fail(runtime, START_RUNTIME, "proxy runtime could not be constructed");
    }
    runtime.proxy_live = true;

    if (configured.cache.enabled) {
        val layer_memory: Result[*http_cache.Layer, *u8] =
            allocator.allocate[http_cache.Layer](heap, 1);
        val entry_memory: Result[*cache_store.Entry, *u8] =
            allocator.allocate[cache_store.Entry](heap, CACHE_ENTRIES);
        val body_memory: Result[*u8, *u8] =
            allocator.allocate[u8](heap, configured.cache.memory_bytes);
        if (is_err[*http_cache.Layer, *u8](layer_memory)
         || is_err[*cache_store.Entry, *u8](entry_memory)
         || is_err[*u8, *u8](body_memory)) {
            ret fail(runtime, START_RUNTIME, "cache allocation failed");
        }
        runtime.caching = unwrap_ok[*http_cache.Layer, *u8](layer_memory);
        if (!http_cache.from_config(runtime.caching, ?configured.cache,
            unwrap_ok[*cache_store.Entry, *u8](entry_memory), CACHE_ENTRIES,
            unwrap_ok[*u8, *u8](body_memory), configured.cache.memory_bytes, heap)) {
            ret fail(runtime, START_CONFIG, "cache could not be constructed");
        }
        runtime.cache_live = true;
    }

    if (configured.acme.enabled) {
        val manager_memory: Result[*acme.Manager, *u8] =
            allocator.allocate[acme.Manager](heap, 1);
        if (is_err[*acme.Manager, *u8](manager_memory)) {
            ret fail(runtime, START_RUNTIME, "certificate manager allocation failed");
        }
        runtime.certificates = unwrap_ok[*acme.Manager, *u8](manager_memory);
        if (acme.open(runtime.certificates, heap, configured) != acme.OK) {
            ret fail(runtime, START_CONFIG, "certificate manager could not open its state");
        }
        runtime.acme_live = true;
        if (!handler.bind(?runtime.challenge_binding,
            acme.challenge_table(runtime.certificates))) {
            ret fail(runtime, START_RUNTIME, "challenge route could not be bound");
        }
    }

    if (!telemetry_production.make(?runtime.observability, heap, configured,
        options.telemetry)) {
        ret fail(runtime, START_CONFIG, "telemetry could not be constructed");
    }
    runtime.telemetry_live = true;

    val services_built: StartReport = build_service_generation(runtime, 0,
        configured, generation_id, storage, true);
    if (services_built.status != START_OK) {
        ret fail(runtime, services_built.status, services_built.detail);
    }

    hedge_tls.reset();
    runtime.tls_live = true;
    var listener_index: usize = 0;
    for (listener_index < configured.listener_count) {
        val selected: *schema.Listener = ?configured.listeners[listener_index];
        listener_index = listener_index + 1;
        if (selected.tls_policy.len == 0) { cnt; }
        val policy: *schema.TlsPolicy = schema.find_tls_policy(configured,
            schema.text(?selected.tls_policy));
        if (policy == nil) {
            ret fail(runtime, START_CONFIG, "listener references an unknown TLS policy");
        }
        if (hedge_tls.publish(schema.text(?selected.name), policy,
            selected.protocols) != hedge_tls.OK) {
            ret fail(runtime, START_CONFIG, "TLS policy could not be published");
        }
    }

    var pool_size: usize = configured.limits.max_connections;
    if (pool_size > DEFAULT_CONNECTIONS) { pool_size = DEFAULT_CONNECTIONS; }
    if (pool_size == 0) { pool_size = 1; }
    val slots_memory: Result[*serve.Slot, *u8] = allocator.allocate[serve.Slot](heap, pool_size);
    val connection_memory: Result[*connection.Connection, *u8] =
        allocator.allocate[connection.Connection](heap, pool_size);
    if (is_err[*serve.Slot, *u8](slots_memory)
     || is_err[*connection.Connection, *u8](connection_memory)) {
        ret fail(runtime, START_RUNTIME, "connection pool allocation failed");
    }
    runtime.slots = unwrap_ok[*serve.Slot, *u8](slots_memory);
    runtime.connections = unwrap_ok[*connection.Connection, *u8](connection_memory);
    if (!serve.make(?runtime.serving, runtime.slots, runtime.connections, pool_size,
        ?runtime.plans[0], configured)) {
        ret fail(runtime, START_RUNTIME, "serving runtime initialization failed");
    }
    if (!serve.attach_telemetry(?runtime.serving,
        ?runtime.observability.runtime)) {
        ret fail(runtime, START_RUNTIME, "telemetry runtime could not be attached");
    }
    schema.reset_diagnostics(diagnostics);
    if (!serve.start(?runtime.serving, generation_id, configured, diagnostics)) {
        ret fail(runtime, START_RUNTIME, "listeners did not become ready");
    }
    runtime.serve_live = true;
    if (!proxy.attach_driver(?runtime.proxying, ?runtime.serving.owner.network)) {
        ret fail(runtime, START_RUNTIME, "proxy driver could not be attached");
    }
    runtime.planes.proxying = ?runtime.proxying;
    runtime.planes.certificates = runtime.certificates;
    if (!serve.attach_plane(?runtime.serving, (?runtime.planes)::ptr, drive_planes)) {
        ret fail(runtime, START_RUNTIME, "service planes could not be attached");
    }
    if (runtime.acme_live) {
        acme.attach_telemetry(runtime.certificates, runtime.serving.observability);
    }
    ret StartReport{status: START_OK, detail: nil};
}

pub fun stop(runtime: *Runtime) StopReport {
    if (runtime == nil) {
        ret StopReport{stopped: false, reason: lifecycle.FAILED, abandoned: 0,
            serve_failures: 0, cleanup_failures: 0};
    }
    ret clean(runtime);
}

pub rec ServiceSnapshot {
    generation: u64;
    live: bool;
    proxy_routes: usize;
    static_roots: usize;
    cache_bindings: usize;
}

pub fun service_snapshot(runtime: *Runtime, slot: usize) ServiceSnapshot {
    if (runtime == nil || slot >= 2) {
        ret ServiceSnapshot{generation: 0, live: false, proxy_routes: 0,
            static_roots: 0, cache_bindings: 0};
    }
    val current: *ServiceGeneration = ?runtime.service_generations[slot];
    var cache_count: usize = 0;
    if (current.cache_live) { cache_count = current.cache_bindings.len; }
    ret ServiceSnapshot{
        generation: current.generation,
        live: current.live,
        proxy_routes: proxy.route_count(?current.proxy_registry),
        static_roots: static_files.root_count(?current.static_registry),
        cache_bindings: cache_count,
    };
}

pub fun active_service_generation(runtime: *Runtime) usize {
    if (runtime == nil) { ret 0; }
    ret runtime.active_generation;
}

pub fun reclaim_superseded(runtime: *Runtime) bool {
    if (runtime == nil || !runtime.serve_live || serve.superseded(?runtime.serving) != 0) {
        ret false;
    }
    val retired: usize = 1 - runtime.active_generation;
    if (!runtime.service_generations[retired].live) { ret true; }
    ret close_service_generation(runtime, retired);
}

pub fun reload(runtime: *Runtime, configured: *schema.Graph, generation_id: u64,
    storage: *PlanStorage, diagnostics: *schema.Diagnostics) StartReport {
    if (runtime == nil || configured == nil || generation_id == 0 || storage == nil
     || diagnostics == nil || !runtime.serve_live
     || generation_id <= runtime.service_generations[runtime.active_generation].generation
     || serve.superseded(?runtime.serving) != 0) {
        ret StartReport{status: START_RUNTIME, detail: "service generation is not reclaimable"};
    }
    if (!plan.reload_compatible(runtime.graph, configured)) {
        ret StartReport{status: START_CONFIG,
            detail: "startup-owned configuration changed; restart required"};
    }
    if (!reclaim_superseded(runtime)) {
        ret StartReport{status: START_RUNTIME,
            detail: "superseded service generation could not be released"};
    }
    val target: usize = 1 - runtime.active_generation;
    val built: StartReport = build_service_generation(runtime, target, configured,
        generation_id, storage, false);
    if (built.status != START_OK) { ret built; }
    if (!serve.reload(?runtime.serving, generation_id, ?runtime.plans[target],
        configured, diagnostics)) {
        close_service_generation(runtime, target);
        ret StartReport{status: START_RUNTIME, detail: "listeners did not republish"};
    }
    runtime.graph = configured;
    runtime.active_generation = target;
    ret StartReport{status: START_OK, detail: nil};
}

pub fun cache(runtime: *Runtime) *http_cache.Layer {
    if (runtime == nil || !runtime.cache_live) { ret nil; }
    ret runtime.caching;
}
