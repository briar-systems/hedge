# helpers only tests build

use std.allocator;
use std.allocator.page;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# `count` zeroed values of T on fresh pages, or nil. a test's stack holds what
# is too large for it here instead, and the test process never gives it back
#[testing]
pub fun heap[T](count: usize) *T {
    var pages: allocator.Allocator;
    val made:  err[allocator.Error] = page.make(?pages);
    if (sel made.err) { ret nil; }
    val value: res[*T, allocator.Error] = allocator.allocate[T](?pages, count);
    if (sel value.err) { ret nil; }
    ret value.ok;
}
