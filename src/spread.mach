# how accepted connections reach the workers
#
# a listener spreads its connections in one of three ways, chosen by what the
# platform can do rather than by its name wherever std can say:
#
# - every worker binds its own socket with SO_REUSEPORT and the kernel spreads
#   connections across them. this needs a platform whose reuseport balances,
#   which measured (hedge#287) is Linux alone: darwin and FreeBSD without
#   SO_REUSEPORT_LB send everything to the last socket bound, and Windows has
#   no SO_REUSEPORT at all.
# - one worker accepts and hands each stream to the least-loaded worker. a
#   local listener can do nothing else, and neither can a platform whose
#   reuseport does not balance. std detaches the stream from the acceptor's
#   driver and the target adopts it (`hedge.handoff`).
# - one worker serves the listener alone. QUIC is served this way until
#   connection IDs route datagrams across workers (hedge#174).

use hedge.config.schema;
use io_error: std.io.error;
use std.sync.thread;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

pub def Spread: u8;
pub val EVERY_WORKER: Spread = 1;
pub val HANDOFF:      Spread = 2;
pub val ONE_WORKER:   Spread = 3;

# whether several sockets bound to one address with SO_REUSEPORT share its
# connections. std does not say yet (mach-std#895), so this is the measured
# answer: only Linux balances. when std answers, this asks it instead
pub fun reuse_port_balances() bool {
    if (os.SO_REUSEPORT == os.SO_UNSUPPORTED) { ret false; }
    ret $mach.build.os == $mach.os.linux;
}

pub fun of(configured: *schema.Listener) Spread {
    if (configured.transport == schema.TRANSPORT_QUIC)  { ret ONE_WORKER; }
    if (configured.transport == schema.TRANSPORT_LOCAL) { ret HANDOFF; }
    if (reuse_port_balances())                          { ret EVERY_WORKER; }
    ret HANDOFF;
}

# whether worker `index` binds the listener at all
pub fun binds(configured: *schema.Listener, index: usize) bool {
    ret index == 0 || of(configured) == EVERY_WORKER;
}

# the workers the configuration asks for: its count, or one per CPU this
# process may run on
fun wanted(graph: *schema.Graph) usize {
    if (graph.workers != 0) { ret graph.workers; }
    var cpus:  [schema.MAX_WORKERS]usize;
    var count: usize               = 0;
    val found: err[io_error.Error] = thread.allowed_cpus(?cpus[0], schema.MAX_WORKERS, ?count);
    if ((sel found.ok) && count != 0) { ret count; }
    val online: i64 = os.cpu_count();
    if (online < 1)                         { ret 1; }
    if (online::usize > schema.MAX_WORKERS) { ret schema.MAX_WORKERS; }
    ret online::usize;
}

# how many workers serve `graph`, and when it is fewer than asked, why
pub rec Count {
    workers: usize;
    wanted:  usize;
    reason:  str;
}

pub fun count(graph: *schema.Graph) Count {
    var result: Count = Count{workers: 1, wanted: wanted(graph), reason: nil};
    if (result.wanted > schema.MAX_WORKERS) { result.wanted = schema.MAX_WORKERS; }
    if (result.wanted <= 1) {
        result.workers = result.wanted;
        if (result.workers == 0) { result.workers = 1; }
        ret result;
    }
    # the cache store is not yet shared between threads (hedge#285, hedge#286)
    if (graph.cache.enabled) {
        result.reason = "the cache is served by one worker until its store is shared (hedge#285)";
        ret result;
    }
    result.workers = result.wanted;
    ret result;
}
