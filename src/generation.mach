# sealed configuration generations with atomic publication

use hedge.config.loader;
use hedge.config.schema;
use std.allocator;
use std.allocator.fixed;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
pub def State: i64;
pub val CANDIDATE: State = 1;
pub val SEALED:    State = 2;
pub val ACTIVE:    State = 3;
pub val DRAINING:  State = 4;
pub val RETIRED:   State = 5;

pub def ConstructFun: fun(ptr, *schema.Graph, *schema.Diagnostics) bool;

pub rec Generation {
    id:          u64;
    active_refs: i64;
    state:       i64;
    graph:       schema.Graph;
}

pub rec Store {
    active:            i64;
    readers:           i64;
    attempts:          i64;
    failures:          i64;
    last_candidate:    i64;
    last_failure_code: i64;
}

pub rec Snapshot {
    active_id:         u64;
    attempts:          u64;
    failures:          u64;
    last_candidate:    u64;
    last_failure_code: schema.DiagnosticCode;
}

pub rec ReloadResult {
    published: bool;
    previous:  *Generation;
}

pub rec Publication {
    published: bool;
    previous:  *Generation;
}

pub fun make_candidate(generation: *Generation, id: u64) bool {
    if (generation == nil || id == 0) { ret false; }
    generation.id          = id;
    generation.active_refs = 0;
    generation.state       = CANDIDATE;
    schema.reset_graph(?generation.graph);
    ret true;
}

pub fun seal(
    generation: *Generation,
    diagnostics: *schema.Diagnostics,
    context: ptr,
    construct: ConstructFun,
) bool {
    if (generation == nil || diagnostics == nil || atomic.load(?generation.state) != CANDIDATE || diagnostics.error_count != 0) {
        ret false;
    }
    if (construct::usize != 0 && !construct(context, ?generation.graph, diagnostics)) {
        if (diagnostics.error_count == 0) {
            schema.add_diagnostic(diagnostics, schema.ERROR, schema.SOURCE_ERROR, "construction", "generation", "candidate resource construction failed");
        }
        ret false;
    }
    if (diagnostics.error_count != 0) { ret false; }
    atomic.store(?generation.state, SEALED);
    ret true;
}

pub fun make_store(store: *Store, initial: *Generation) bool {
    if (store == nil || initial == nil || atomic.load(?initial.state) != SEALED) { ret false; }
    atomic.store(?initial.state, ACTIVE);
    store.active            = initial::usize::i64;
    store.readers           = 0;
    store.attempts          = 0;
    store.failures          = 0;
    store.last_candidate    = initial.id::i64;
    store.last_failure_code = 0;
    ret true;
}

fun first_error(diagnostics: *schema.Diagnostics) schema.DiagnosticCode {
    if (diagnostics == nil) { ret schema.SOURCE_ERROR; }
    var i: usize = 0;
    for (i < diagnostics.count) {
        if (diagnostics.items[i].severity == schema.ERROR) { ret diagnostics.items[i].code; }
        i = i + 1;
    }
    ret schema.SOURCE_ERROR;
}

pub fun reject(store: *Store, candidate_id: u64, diagnostics: *schema.Diagnostics) bool {
    if (store == nil || candidate_id == 0) { ret false; }
    atomic.fetch_add(?store.attempts, 1);
    atomic.fetch_add(?store.failures, 1);
    atomic.store(?store.last_candidate, candidate_id::i64);
    atomic.store(?store.last_failure_code, first_error(diagnostics)::i64);
    ret true;
}

# publication transfers store ownership to the candidate and starts old-generation drain
pub fun publish(store: *Store, candidate: *Generation) Publication {
    var result: Publication = Publication{published: false, previous: nil};
    if (store == nil || candidate == nil || atomic.load(?candidate.state) != SEALED) { ret result; }
    val previous_bits: i64         = atomic.load(?store.active);
    val previous:      *Generation = previous_bits::usize::*Generation;
    if (previous == nil || candidate.id <= previous.id) { ret result; }
    atomic.store(?candidate.state, ACTIVE);
    var expected: i64 = previous_bits;
    if (!atomic.cas(?store.active, ?expected, candidate::usize::i64)) {
        atomic.store(?candidate.state, SEALED);
        ret result;
    }
    atomic.fetch_add(?store.attempts, 1);
    atomic.store(?store.last_candidate, candidate.id::i64);
    atomic.store(?store.last_failure_code, 0);
    atomic.store(?previous.state, DRAINING);
    result.published = true;
    result.previous  = previous;
    ret result;
}

pub fun reload(
    store: *Store,
    candidate: *Generation,
    candidate_id: u64,
    diagnostics: *schema.Diagnostics,
    a: *allocator.Allocator,
    source_name: str,
    source: str,
    resolver: *loader.Resolver,
    capabilities: loader.Capabilities,
    construct_context: ptr,
    construct: ConstructFun,
) ReloadResult {
    var result: ReloadResult = ReloadResult{published: false, previous: nil};
    if (store == nil || candidate == nil || diagnostics == nil || !make_candidate(candidate, candidate_id)) { ret result; }
    if (!loader.build(?candidate.graph, diagnostics, a, source_name, source, resolver, capabilities)) {
        reject(store, candidate_id, diagnostics);
        ret result;
    }
    if (!seal(candidate, diagnostics, construct_context, construct)) {
        reject(store, candidate_id, diagnostics);
        ret result;
    }
    val publication: Publication = publish(store, candidate);
    if (!publication.published) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.CONFLICT, "publication", "generation", "candidate is stale or lost a concurrent publication race");
        reject(store, candidate_id, diagnostics);
        ret result;
    }
    result.previous  = publication.previous;
    result.published = publication.published;
    ret result;
}

# readers enter a short publication gate before retaining the selected generation
pub fun acquire(store: *Store) *Generation {
    if (store == nil) { ret nil; }
    atomic.fetch_add(?store.readers, 1);
    val bits:       i64         = atomic.load(?store.active);
    val generation: *Generation = bits::usize::*Generation;
    if (generation != nil) { atomic.fetch_add(?generation.active_refs, 1); }
    atomic.fetch_sub(?store.readers, 1);
    ret generation;
}

pub fun release(generation: *Generation) bool {
    if (generation == nil) { ret false; }
    val previous: i64 = atomic.fetch_sub(?generation.active_refs, 1);
    if (previous <= 0) {
        atomic.fetch_add(?generation.active_refs, 1);
        ret false;
    }
    ret true;
}

# callers may destroy an old generation only after this succeeds
pub fun retire(store: *Store, generation: *Generation) bool {
    if (store == nil || generation == nil || atomic.load(?generation.state) != DRAINING) { ret false; }
    if (atomic.load(?store.readers) != 0 || atomic.load(?generation.active_refs) != 0)   { ret false; }
    atomic.store(?generation.state, RETIRED);
    ret true;
}

pub fun is_draining(generation: *Generation) bool {
    if (generation == nil) { ret false; }
    ret atomic.load(?generation.state) == DRAINING;
}

pub fun snapshot(store: *Store) Snapshot {
    var result: Snapshot;
    result.active_id = 0;
    if (store == nil) { ret result; }
    atomic.fetch_add(?store.readers, 1);
    val generation: *Generation = atomic.load(?store.active)::usize::*Generation;
    if (generation != nil) { result.active_id = generation.id; }
    atomic.fetch_sub(?store.readers, 1);
    result.attempts          = atomic.load(?store.attempts)::u64;
    result.failures          = atomic.load(?store.failures)::u64;
    result.last_candidate    = atomic.load(?store.last_candidate)::u64;
    result.last_failure_code = atomic.load(?store.last_failure_code)::schema.DiagnosticCode;
    ret result;
}

fun construct_ok(context: ptr, graph: *schema.Graph, diagnostics: *schema.Diagnostics) bool {
    ret graph.server_name.len > 0;
}

fun construct_fail(context: ptr, graph: *schema.Graph, diagnostics: *schema.Diagnostics) bool {
    schema.add_diagnostic(diagnostics, schema.ERROR, schema.UNSUPPORTED, "construction", "listener", "socket option is unavailable");
    ret false;
}

test "generation: sealed candidate publishes atomically and drains predecessor" {
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var first: Generation;
    if (!make_candidate(?first, 1)) { ret 1; }
    schema.set_text(?first.graph.server_name, "one");
    if (!seal(?first, ?diagnostics, nil, construct_ok)) { ret 2; }
    var store: Store;
    if (!make_store(?store, ?first)) { ret 3; }
    var second: Generation;
    if (!make_candidate(?second, 2)) { ret 4; }
    schema.set_text(?second.graph.server_name, "two");
    if (!seal(?second, ?diagnostics, nil, construct_ok)) { ret 5; }
    val publication: Publication = publish(?store, ?second);
    val old:         *Generation = publication.previous;
    if (!publication.published || old != ?first || !is_draining(old)) { ret 6; }
    val active: *Generation = acquire(?store);
    if (active != ?second || active.id != 2) { ret 7; }
    if (!release(active))                    { ret 8; }
    if (!retire(?store, old))                { ret 9; }
    ret 0;
}

test "generation: failed construction leaves active generation observable" {
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var active: Generation;
    make_candidate(?active, 10);
    schema.set_text(?active.graph.server_name, "active");
    if (!seal(?active, ?diagnostics, nil, construct_ok)) { ret 1; }
    var store: Store;
    if (!make_store(?store, ?active)) { ret 2; }
    var candidate: Generation;
    make_candidate(?candidate, 11);
    schema.set_text(?candidate.graph.server_name, "candidate");
    if (seal(?candidate, ?diagnostics, nil, construct_fail)) { ret 3; }
    reject(?store, candidate.id, ?diagnostics);
    val observed: *Generation = acquire(?store);
    if (observed != ?active || observed.id != 10) { ret 4; }
    release(observed);
    val state: Snapshot = snapshot(?store);
    if (state.active_id != 10 || state.failures != 1 || state.last_candidate != 11 || state.last_failure_code != schema.UNSUPPORTED) { ret 5; }
    ret 0;
}

test "generation: invalid reload never mutates the active pointer" {
    var diagnostics: schema.Diagnostics;
    schema.reset_diagnostics(?diagnostics);
    var active: Generation;
    make_candidate(?active, 20);
    schema.set_text(?active.graph.server_name, "active");
    if (!seal(?active, ?diagnostics, nil, construct_ok)) { ret 1; }
    var store: Store;
    if (!make_store(?store, ?active)) { ret 2; }
    var memory:      [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a:           allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var candidate:    Generation;
    val capabilities: loader.Capabilities = loader.Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    val attempted:    ReloadResult        = reload(?store, ?candidate, 21, ?diagnostics, ?a, "bad.toml", "[server]\nunknown = true\n", nil, capabilities, nil, construct_ok);
    if (attempted.published) { ret 3; }
    val observed: *Generation = acquire(?store);
    if (observed != ?active || observed.id != 20) { ret 4; }
    release(observed);
    val state: Snapshot = snapshot(?store);
    if (state.failures != 1 || state.last_candidate != 21) { ret 5; }
    ret 0;
}
