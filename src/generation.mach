# immutable runtime generation identity

use std.types.size.usize;

pub rec Generation {
    id:          u64;
    active_refs: usize;
    draining:    u8;
}

pub fun is_draining(g: *Generation) u8 {
    ret g.draining;
}

test "generation: draining state is explicit" {
    var g: Generation = Generation{id: 1, active_refs: 0, draining: 1};
    if (is_draining(?g) != 1) { ret 1; }
    ret 0;
}
