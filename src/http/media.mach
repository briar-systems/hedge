# content types for served file extensions
#
# The table is deliberately small and closed. An unknown extension gets the
# generic binary type rather than a guess, because a wrong content type is a
# cross-site scripting vector, not a cosmetic error.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub val DEFAULT_TYPE: str = "application/octet-stream";

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun extension_is(path: view.View, dot: usize, name: str) bool {
    var i: usize = 0;
    for (name[i] != 0) {
        if (dot + 1 + i >= path.len || lower(path.data[dot + 1 + i]) != name[i]) { ret false; }
        i = i + 1;
    }
    ret dot + 1 + i == path.len;
}

# the extension is what follows the final dot in the final segment
fun extension_start(path: view.View) usize {
    var i: usize = path.len;
    for (i > 0) {
        i = i - 1;
        if (path.data[i] == '/') { ret path.len; }
        if (path.data[i] == '.') {
            if (i == 0 || path.data[i - 1] == '/') { ret path.len; }
            ret i;
        }
    }
    ret path.len;
}

pub fun for_path(path: view.View) str {
    if (path.data == nil || path.len == 0) { ret DEFAULT_TYPE; }
    val dot: usize = extension_start(path);
    if (dot >= path.len)                                                   { ret DEFAULT_TYPE; }
    if (extension_is(path, dot, "html") || extension_is(path, dot, "htm")) { ret "text/html; charset=utf-8"; }
    if (extension_is(path, dot, "css"))                                    { ret "text/css; charset=utf-8"; }
    if (extension_is(path, dot, "js") || extension_is(path, dot, "mjs"))   { ret "text/javascript; charset=utf-8"; }
    if (extension_is(path, dot, "json"))                                   { ret "application/json"; }
    if (extension_is(path, dot, "txt") || extension_is(path, dot, "md"))   { ret "text/plain; charset=utf-8"; }
    if (extension_is(path, dot, "xml"))                                    { ret "application/xml"; }
    if (extension_is(path, dot, "svg"))                                    { ret "image/svg+xml"; }
    if (extension_is(path, dot, "png"))                                    { ret "image/png"; }
    if (extension_is(path, dot, "jpg") || extension_is(path, dot, "jpeg")) { ret "image/jpeg"; }
    if (extension_is(path, dot, "gif"))                                    { ret "image/gif"; }
    if (extension_is(path, dot, "webp"))                                   { ret "image/webp"; }
    if (extension_is(path, dot, "ico"))                                    { ret "image/x-icon"; }
    if (extension_is(path, dot, "woff2"))                                  { ret "font/woff2"; }
    if (extension_is(path, dot, "woff"))                                   { ret "font/woff"; }
    if (extension_is(path, dot, "ttf"))                                    { ret "font/ttf"; }
    if (extension_is(path, dot, "wasm"))                                   { ret "application/wasm"; }
    if (extension_is(path, dot, "pdf"))                                    { ret "application/pdf"; }
    if (extension_is(path, dot, "zip"))                                    { ret "application/zip"; }
    if (extension_is(path, dot, "gz"))                                     { ret "application/gzip"; }
    ret DEFAULT_TYPE;
}

test "http media: known extensions map to their type and unknown ones do not guess" {
    if (!view.view_eq_str(view.view(for_path(view.view("a/b.html", 8)), 24), "text/html; charset=utf-8")) { ret 1; }
    if (!view.view_eq_str(view.view(for_path(view.view("a/b.PNG", 7)), 9), "image/png"))                  { ret 2; }
    if (!view.view_eq_str(view.view(for_path(view.view("a/b.unknown", 11)), 24), DEFAULT_TYPE))           { ret 3; }
    if (!view.view_eq_str(view.view(for_path(view.view("noextension", 11)), 24), DEFAULT_TYPE))           { ret 4; }
    ret 0;
}

test "http media: a dotfile has no extension and a dot in a directory is not one" {
    if (!view.view_eq_str(view.view(for_path(view.view(".html", 5)), 24), DEFAULT_TYPE))   { ret 1; }
    if (!view.view_eq_str(view.view(for_path(view.view("a/.html", 7)), 24), DEFAULT_TYPE)) { ret 2; }
    if (!view.view_eq_str(view.view(for_path(view.view("a.b/c", 5)), 24), DEFAULT_TYPE))   { ret 3; }
    ret 0;
}
