# HTTP-date handling
#
# RFC 9110 requires the IMF-fixdate form on generation and requires recipients to
# accept the two obsolete forms as well. Only whole seconds are representable, so
# a comparison against a filesystem timestamp truncates that timestamp first.

use std.chrono.date;
use std.chrono.time;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub val IMF_LENGTH: usize = 29;

val DAY_NAMES:   str = "SunMonTueWedThuFriSat";
val MONTH_NAMES: str = "JanFebMarAprMayJunJulAugSepOctNovDec";

fun two(output: *u8, offset: usize, value: i64) {
    output[offset]     = ('0' + (value / 10)::u8);
    output[offset + 1] = ('0' + (value % 10)::u8);
}

fun four(output: *u8, offset: usize, value: i64) {
    output[offset]     = ('0' + (value / 1000 % 10)::u8);
    output[offset + 1] = ('0' + (value / 100 % 10)::u8);
    output[offset + 2] = ('0' + (value / 10 % 10)::u8);
    output[offset + 3] = ('0' + (value % 10)::u8);
}

fun weekday(sec: i64) i64 {
    var days: i64 = sec / 86400;
    if (sec < 0 && sec % 86400 != 0) { days = days - 1; }
    var day: i64 = (days + 4) % 7;
    if (day < 0) { day = day + 7; }
    ret day;
}

# write one IMF-fixdate, always exactly IMF_LENGTH bytes plus a terminator
pub fun format(value: time.Time, output: *u8, capacity: usize) usize {
    if (output == nil || capacity <= IMF_LENGTH) { ret 0; }
    val moment: date.Datetime = date.datetime_from_time(time.unix(value.sec, 0));
    if (moment.year < 1000 || moment.year > 9999) { ret 0; }
    val day: i64   = weekday(value.sec);
    var i:   usize = 0;
    for (i < 3) {
        output[i] = DAY_NAMES[day::usize * 3 + i];
        i         = i + 1;
    }
    output[3] = ',';
    output[4] = ' ';
    two(output, 5, moment.day);
    output[7] = ' ';
    i         = 0;
    for (i < 3) {
        output[8 + i] = MONTH_NAMES[(moment.month - 1)::usize * 3 + i];
        i             = i + 1;
    }
    output[11] = ' ';
    four(output, 12, moment.year);
    output[16] = ' ';
    two(output, 17, moment.hour);
    output[19] = ':';
    two(output, 20, moment.minute);
    output[22] = ':';
    two(output, 23, moment.second);
    output[25] = ' ';
    output[26] = 'G';
    output[27] = 'M';
    output[28] = 'T';
    output[29] = 0;
    ret IMF_LENGTH;
}

fun digit(c: u8) i64 {
    if (c < '0' || c > '9') { ret -1; }
    ret (c - '0')::i64;
}

fun number(value: view.View, offset: usize, length: usize) i64 {
    if (offset + length > value.len) { ret -1; }
    var total: i64   = 0;
    var i:     usize = 0;
    for (i < length) {
        val d: i64 = digit(value.data[offset + i]);
        if (d < 0) { ret -1; }
        total = total * 10 + d;
        i     = i + 1;
    }
    ret total;
}

fun month_of(value: view.View, offset: usize) i64 {
    if (offset + 3 > value.len) { ret -1; }
    var m: usize = 0;
    for (m < 12) {
        if (value.data[offset] == MONTH_NAMES[m * 3]
            && value.data[offset + 1] == MONTH_NAMES[m * 3 + 1]
            && value.data[offset + 2] == MONTH_NAMES[m * 3 + 2]) { ret (m + 1)::i64; }
        m = m + 1;
    }
    ret -1;
}

fun clock(value: view.View, offset: usize, output: *date.Datetime) bool {
    val hour:   i64 = number(value, offset, 2);
    val minute: i64 = number(value, offset + 3, 2);
    val second: i64 = number(value, offset + 6, 2);
    if (hour < 0 || minute < 0 || second < 0 || hour > 23 || minute > 59 || second > 60) { ret false; }
    if (value.data[offset + 2] != ':' || value.data[offset + 5] != ':')                  { ret false; }
    output.hour   = hour;
    output.minute = minute;
    if (second == 60) { output.second = 59; }
    or                { output.second = second; }
    ret true;
}

fun valid_day(moment: date.Datetime) bool {
    ret moment.day >= 1 && moment.day <= date.days_in_month(moment.year, moment.month);
}

# `Sun, 06 Nov 1994 08:49:37 GMT`
fun parse_imf(value: view.View, output: *time.Time) bool {
    if (value.len != IMF_LENGTH || value.data[3] != ',' || value.data[4] != ' ') { ret false; }
    var moment: date.Datetime = date.Datetime{
        year: 0, month: 0, day: 0, hour: 0, minute: 0, second: 0, nsec: 0, offset: 0,
    };
    moment.day   = number(value, 5, 2);
    moment.month = month_of(value, 8);
    moment.year  = number(value, 12, 4);
    if (moment.day < 0 || moment.month < 0 || moment.year < 0)                   { ret false; }
    if (!clock(value, 17, ?moment) || !valid_day(moment))                        { ret false; }
    if (value.data[26] != 'G' || value.data[27] != 'M' || value.data[28] != 'T') { ret false; }
    @output = date.datetime_to_time(moment);
    ret true;
}

# `Sunday, 06-Nov-94 08:49:37 GMT`
fun parse_rfc850(value: view.View, output: *time.Time) bool {
    var comma: usize = 0;
    for (comma < value.len && value.data[comma] != ',') { comma = comma + 1; }
    if (comma >= value.len || comma + 24 != value.len || value.data[comma + 1] != ' ') { ret false; }
    val start:  usize         = comma + 2;
    var moment: date.Datetime = date.Datetime{
        year: 0, month: 0, day: 0, hour: 0, minute: 0, second: 0, nsec: 0, offset: 0,
    };
    if (value.data[start + 2] != '-' || value.data[start + 6] != '-') { ret false; }
    moment.day   = number(value, start, 2);
    moment.month = month_of(value, start + 3);
    val two_digit: i64 = number(value, start + 7, 2);
    if (moment.day < 0 || moment.month < 0 || two_digit < 0) { ret false; }
    # RFC 9110 requires a two-digit year more than fifty years ahead to be past
    if (two_digit >= 70)                                          { moment.year = 1900 + two_digit; }
    or                                                            { moment.year = 2000 + two_digit; }
    if (!clock(value, start + 10, ?moment) || !valid_day(moment)) { ret false; }
    if (value.data[value.len - 3] != 'G' || value.data[value.len - 2] != 'M'
        || value.data[value.len - 1] != 'T') { ret false; }
    @output = date.datetime_to_time(moment);
    ret true;
}

# `Sun Nov  6 08:49:37 1994`
fun parse_asctime(value: view.View, output: *time.Time) bool {
    if (value.len != 24 || value.data[3] != ' ' || value.data[7] != ' ') { ret false; }
    var moment: date.Datetime = date.Datetime{
        year: 0, month: 0, day: 0, hour: 0, minute: 0, second: 0, nsec: 0, offset: 0,
    };
    moment.month = month_of(value, 4);
    if (value.data[8] == ' ') { moment.day = number(value, 9, 1); }
    or                        { moment.day = number(value, 8, 2); }
    moment.year = number(value, 20, 4);
    if (moment.month < 0 || moment.day < 0 || moment.year < 0) { ret false; }
    if (!clock(value, 11, ?moment) || !valid_day(moment))      { ret false; }
    @output = date.datetime_to_time(moment);
    ret true;
}

# recipients must accept all three historical forms
pub fun parse(value: view.View, output: *time.Time) bool {
    if (value.data == nil || output == nil || value.len < 24) { ret false; }
    if (parse_imf(value, output))                             { ret true; }
    if (parse_rfc850(value, output))                          { ret true; }
    ret parse_asctime(value, output);
}

# HTTP dates carry whole seconds, so a finer timestamp must be truncated before
# it is compared with one
pub fun truncate(value: time.Time) time.Time {
    ret time.unix(value.sec, 0);
}

pub fun not_after(a: time.Time, b: time.Time) bool {
    ret a.sec <= b.sec;
}

test "http date: an IMF-fixdate round trips through generation and parsing" {
    var output: [40]u8;
    val moment: time.Time = time.unix(784111777, 0);
    if (format(moment, ?output[0], 40) != IMF_LENGTH)                                          { ret 1; }
    if (!view.view_eq_str(view.view(?output[0], IMF_LENGTH), "Sun, 06 Nov 1994 08:49:37 GMT")) { ret 2; }
    var parsed: time.Time;
    if (!parse(view.view(?output[0], IMF_LENGTH), ?parsed) || parsed.sec != 784111777) { ret 3; }
    ret 0;
}

test "http date: the two obsolete forms parse to the same instant" {
    var parsed: time.Time;
    if (!parse(view.view("Sunday, 06-Nov-94 08:49:37 GMT", 30), ?parsed)
        || parsed.sec != 784111777) { ret 1; }
    if (!parse(view.view("Sun Nov  6 08:49:37 1994", 24), ?parsed)
        || parsed.sec != 784111777) { ret 2; }
    ret 0;
}

test "http date: malformed input is rejected rather than guessed" {
    var parsed: time.Time;
    if (parse(view.view("Sun, 06 Nov 1994 08:49:37 UTC", 29), ?parsed)) { ret 1; }
    if (parse(view.view("Sun, 32 Nov 1994 08:49:37 GMT", 29), ?parsed)) { ret 2; }
    if (parse(view.view("Sun, 29 Feb 1994 08:49:37 GMT", 29), ?parsed)) { ret 3; }
    if (parse(view.view("Sun, 06 Xyz 1994 08:49:37 GMT", 29), ?parsed)) { ret 4; }
    if (parse(view.view("nonsense", 8), ?parsed))                       { ret 5; }
    ret 0;
}

test "http date: a leap second folds into the last representable second" {
    var parsed: time.Time;
    if (!parse(view.view("Sat, 31 Dec 2016 23:59:60 GMT", 29), ?parsed)) { ret 1; }
    var expected: time.Time;
    if (!parse(view.view("Sat, 31 Dec 2016 23:59:59 GMT", 29), ?expected)) { ret 2; }
    if (parsed.sec != expected.sec)                                        { ret 3; }
    ret 0;
}
