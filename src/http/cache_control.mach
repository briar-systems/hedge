# Cache-Control directive parsing
#
# RFC 9111 section 5.2. A directive this parser does not recognise is ignored,
# which is required: an unknown extension must not change how the known ones are
# applied. A malformed argument makes its own directive inert rather than
# invalidating the whole field, because a cache that failed open on a bad
# `no-store` would store what it was told not to.

use http.core.field;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

pub val NO_DELTA: u64 = 0xffffffffffffffff;

pub rec Directives {
    present:                bool;
    no_store:               bool;
    no_cache:               bool;
    no_cache_qualified:     bool;
    private_response:       bool;
    private_qualified:      bool;
    public_response:        bool;
    must_revalidate:        bool;
    proxy_revalidate:       bool;
    must_understand:        bool;
    immutable_response:     bool;
    only_if_cached:         bool;
    no_transform:           bool;
    max_age:                u64;
    s_maxage:               u64;
    max_stale:              u64;
    max_stale_present:      bool;
    min_fresh:              u64;
    stale_while_revalidate: u64;
    stale_if_error:         u64;
    # the field names a qualified `no-cache="a, b"` or `private="a, b"` argument
    # listed, as a view into the message that carried them
    no_cache_fields: view.View;
    private_fields:  view.View;
}

pub fun none() Directives {
    ret Directives{
        present:                false,
        no_store:               false,
        no_cache:               false,
        no_cache_qualified:     false,
        private_response:       false,
        private_qualified:      false,
        public_response:        false,
        must_revalidate:        false,
        proxy_revalidate:       false,
        must_understand:        false,
        immutable_response:     false,
        only_if_cached:         false,
        no_transform:           false,
        max_age:                NO_DELTA,
        s_maxage:               NO_DELTA,
        max_stale:              NO_DELTA,
        max_stale_present:      false,
        min_fresh:              NO_DELTA,
        stale_while_revalidate: NO_DELTA,
        stale_if_error:         NO_DELTA,
        no_cache_fields:        view.view(nil, 0),
        private_fields:         view.view(nil, 0),
    };
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun matches(value: view.View, start: usize, end: usize, name: str) bool {
    val length: usize = str_len(name);
    if (end - start != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (lower(value.data[start + i]) != name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a delta-seconds argument; anything that is not a plain number leaves the
# directive without a value rather than defaulting it to zero
fun delta(value: view.View, start: usize, end: usize, output: *u64) bool {
    var from: usize = start;
    var to:   usize = end;
    if (from < to && value.data[from] == '"')   { from = from + 1; }
    if (to > from && value.data[to - 1] == '"') { to = to - 1; }
    if (from >= to)                             { ret false; }
    var total: u64   = 0;
    var i:     usize = from;
    for (i < to) {
        val c: u8 = value.data[i];
        if (c < '0' || c > '9') { ret false; }
        val digit: u64 = (c - '0')::u64;
        # a delta that cannot be represented is treated as the largest one
        if (total > (NO_DELTA - 1 - digit) / 10) {
            @output = NO_DELTA - 1;
            ret true;
        }
        total = total * 10 + digit;
        i     = i + 1;
    }
    @output = total;
    ret true;
}

# the argument text with any surrounding quotes removed
fun argument(value: view.View, start: usize, end: usize) view.View {
    var from: usize = start;
    var to:   usize = end;
    if (from < to && value.data[from] == '"')   { from = from + 1; }
    if (to > from && value.data[to - 1] == '"') { to = to - 1; }
    if (to <= from)                             { ret view.view(nil, 0); }
    ret view.view(?value.data[from], to - from);
}

# is this field name a member of a quoted directive argument list
#
# a qualified `no-cache` or `private` names the fields it applies to, and a cache
# that ignored the list would store or replay exactly the field the origin
# singled out as unsafe to share.
pub fun lists_field(list: view.View, name: view.View) bool {
    if (list.data == nil || list.len == 0 || name.data == nil || name.len == 0) { ret false; }
    var start: usize = 0;
    var i:     usize = 0;
    for (i <= list.len) {
        if (i == list.len || list.data[i] == ',') {
            var from: usize = start;
            var to:   usize = i;
            for (from < to && (list.data[from] == ' ' || list.data[from] == '\t')) {
                from = from + 1;
            }
            for (to > from && (list.data[to - 1] == ' ' || list.data[to - 1] == '\t')) {
                to = to - 1;
            }
            if (to - from == name.len) {
                var matched: bool  = true;
                var j:       usize = 0;
                for (j < name.len) {
                    if (lower(list.data[from + j]) != lower(name.data[j])) { matched = false; }
                    j = j + 1;
                }
                if (matched) { ret true; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun apply(output: *Directives, value: view.View, name_start: usize, name_end: usize,
    argument_start: usize, argument_end: usize, has_argument: bool) {
    if (matches(value, name_start, name_end, "no-store")) {
        output.no_store = true;
        ret;
    }
    if (matches(value, name_start, name_end, "no-cache")) {
        output.no_cache = true;
        # a qualified `no-cache="field"` only forbids reusing those fields
        if (has_argument) {
            output.no_cache_qualified = true;
            output.no_cache_fields    = argument(value, argument_start, argument_end);
        }
        ret;
    }
    if (matches(value, name_start, name_end, "private")) {
        output.private_response = true;
        if (has_argument) {
            output.private_qualified = true;
            output.private_fields    = argument(value, argument_start, argument_end);
        }
        ret;
    }
    if (matches(value, name_start, name_end, "public")) {
        output.public_response = true;
        ret;
    }
    if (matches(value, name_start, name_end, "must-revalidate")) {
        output.must_revalidate = true;
        ret;
    }
    if (matches(value, name_start, name_end, "proxy-revalidate")) {
        output.proxy_revalidate = true;
        ret;
    }
    if (matches(value, name_start, name_end, "must-understand")) {
        output.must_understand = true;
        ret;
    }
    if (matches(value, name_start, name_end, "immutable")) {
        output.immutable_response = true;
        ret;
    }
    if (matches(value, name_start, name_end, "only-if-cached")) {
        output.only_if_cached = true;
        ret;
    }
    if (matches(value, name_start, name_end, "no-transform")) {
        output.no_transform = true;
        ret;
    }
    if (matches(value, name_start, name_end, "max-age")) {
        if (has_argument) { delta(value, argument_start, argument_end, ?output.max_age); }
        ret;
    }
    if (matches(value, name_start, name_end, "s-maxage")) {
        if (has_argument) { delta(value, argument_start, argument_end, ?output.s_maxage); }
        ret;
    }
    if (matches(value, name_start, name_end, "max-stale")) {
        output.max_stale_present = true;
        if (has_argument) { delta(value, argument_start, argument_end, ?output.max_stale); }
        ret;
    }
    if (matches(value, name_start, name_end, "min-fresh")) {
        if (has_argument) { delta(value, argument_start, argument_end, ?output.min_fresh); }
        ret;
    }
    if (matches(value, name_start, name_end, "stale-while-revalidate")) {
        if (has_argument) { delta(value, argument_start, argument_end, ?output.stale_while_revalidate); }
        ret;
    }
    if (matches(value, name_start, name_end, "stale-if-error")) {
        if (has_argument) { delta(value, argument_start, argument_end, ?output.stale_if_error); }
        ret;
    }
}

fun parse_value(output: *Directives, value: view.View) {
    if (value.data == nil || value.len == 0) { ret; }
    output.present = true;
    var offset: usize = 0;
    for (offset < value.len) {
        for (offset < value.len && (value.data[offset] == ' ' || value.data[offset] == '\t'
            || value.data[offset] == ',')) { offset = offset + 1; }
        if (offset >= value.len) { brk; }
        val name_start: usize = offset;
        for (offset < value.len && value.data[offset] != '=' && value.data[offset] != ','
            && value.data[offset] != ' ' && value.data[offset] != '\t') { offset = offset + 1; }
        val name_end:       usize = offset;
        var argument_start: usize = offset;
        var argument_end:   usize = offset;
        var has_argument:   bool  = false;
        for (offset < value.len && (value.data[offset] == ' ' || value.data[offset] == '\t')) {
            offset = offset + 1;
        }
        if (offset < value.len && value.data[offset] == '=') {
            offset = offset + 1;
            for (offset < value.len && (value.data[offset] == ' ' || value.data[offset] == '\t')) {
                offset = offset + 1;
            }
            has_argument   = true;
            argument_start = offset;
            if (offset < value.len && value.data[offset] == '"') {
                offset = offset + 1;
                for (offset < value.len && value.data[offset] != '"') { offset = offset + 1; }
                if (offset < value.len) { offset = offset + 1; }
            }
            or {
                for (offset < value.len && value.data[offset] != ',') { offset = offset + 1; }
            }
            argument_end = offset;
            for (argument_end > argument_start
                && (value.data[argument_end - 1] == ' ' || value.data[argument_end - 1] == '\t')) {
                argument_end = argument_end - 1;
            }
        }
        if (name_end > name_start) {
            apply(output, value, name_start, name_end, argument_start, argument_end, has_argument);
        }
    }
}

# every `Cache-Control` field in a collection contributes, because the field is
# list-valued and a sender may split it across lines
pub fun parse(fields: *field.Fields) Directives {
    var result: Directives = none();
    if (fields == nil || fields.items == nil) { ret result; }
    var i: usize = 0;
    for (i < fields.len) {
        val item: *field.Field = ?fields.items[i];
        if (item.name.len == 13) {
            var name_matches: bool  = true;
            var j:            usize = 0;
            val expected:     str   = "cache-control";
            for (j < 13) {
                if (lower(item.name.data[j]) != expected[j]) { name_matches = false; }
                j = j + 1;
            }
            if (name_matches) { parse_value(?result, item.value); }
        }
        i = i + 1;
    }
    ret result;
}

fun parsed(text: str) Directives {
    var result: Directives = none();
    parse_value(?result, view.view(text, str_len(text)));
    ret result;
}

test "cache control: the common response directives parse" {
    val value: Directives = parsed("public, max-age=600, s-maxage=1200, must-revalidate");
    if (!value.present || !value.public_response || !value.must_revalidate) { ret 1; }
    if (value.max_age != 600 || value.s_maxage != 1200)                     { ret 2; }
    if (value.no_store || value.no_cache || value.private_response)         { ret 3; }
    ret 0;
}

test "cache control: names and quoted arguments are case and quote tolerant" {
    val value: Directives = parsed("No-Store, MAX-AGE=\"30\", stale-while-revalidate=5");
    if (!value.no_store || value.max_age != 30 || value.stale_while_revalidate != 5) { ret 1; }
    ret 0;
}

test "cache control: a qualified directive is distinguished from a bare one" {
    val bare: Directives = parsed("no-cache");
    if (!bare.no_cache || bare.no_cache_qualified) { ret 1; }
    val qualified: Directives = parsed("no-cache=\"set-cookie\"");
    if (!qualified.no_cache || !qualified.no_cache_qualified) { ret 2; }
    val bare_private: Directives = parsed("private");
    if (!bare_private.private_response || bare_private.private_qualified) { ret 3; }
    ret 0;
}

test "cache control: a malformed argument leaves its own directive without a value" {
    val value: Directives = parsed("max-age=abc, no-store");
    # the bad argument must not become a zero lifetime, and must not disarm no-store
    if (value.max_age != NO_DELTA) { ret 1; }
    if (!value.no_store)           { ret 2; }
    val overflowing: Directives = parsed("max-age=99999999999999999999999");
    if (overflowing.max_age != NO_DELTA - 1) { ret 3; }
    ret 0;
}

test "cache control: an unrecognised directive changes nothing" {
    val value: Directives = parsed("x-vendor-thing=7, max-age=10");
    if (value.max_age != 10 || value.no_store || value.no_cache) { ret 1; }
    ret 0;
}

test "cache control: an absent field yields no directives at all" {
    val value: Directives = none();
    if (value.present || value.max_age != NO_DELTA || value.no_store) { ret 1; }
    ret 0;
}

test "cache control: every cache-control field in the message contributes" {
    var items:  [3]field.Field;
    var fields: field.Fields = field.init(?items[0], 3, field.limits(3, 256, 64, 128));
    field.append(?fields, field.Field{name: view.view("cache-control", 13),
        value: view.view("max-age=60", 10), sensitive: false});
    field.append(?fields, field.Field{name: view.view("x-other", 7),
        value: view.view("no-store", 8), sensitive: false});
    field.append(?fields, field.Field{name: view.view("Cache-Control", 13),
        value: view.view("no-store", 8), sensitive: false});
    val value: Directives = parse(?fields);
    if (value.max_age != 60 || !value.no_store) { ret 1; }
    ret 0;
}

test "cache control: a qualified argument names the fields it applies to" {
    val qualified: Directives = parsed("private=\"set-cookie, x-user\", max-age=60");
    if (!qualified.private_qualified || qualified.max_age != 60)             { ret 1; }
    if (!lists_field(qualified.private_fields, view.view("Set-Cookie", 10))) { ret 2; }
    if (!lists_field(qualified.private_fields, view.view("x-user", 6)))      { ret 3; }
    if (lists_field(qualified.private_fields, view.view("etag", 4)))         { ret 4; }
    val no_cache: Directives = parsed("no-cache=\"Set-Cookie\"");
    if (!lists_field(no_cache.no_cache_fields, view.view("set-cookie", 10))) { ret 5; }
    # a bare directive names nothing, so nothing is excluded by name
    val bare: Directives = parsed("private");
    if (lists_field(bare.private_fields, view.view("set-cookie", 10))) { ret 6; }
    ret 0;
}
