# byte-range requests
#
# RFC 9110 section 14. A recipient may ignore a Range header it does not wish to
# honour, so anything this module cannot serve exactly is reported as ignorable
# rather than as an error. Only a range that is syntactically valid and entirely
# unsatisfiable produces 416.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub def Outcome: u8;
pub val NO_RANGE: Outcome = 1;
pub val SATISFIABLE: Outcome = 2;
pub val UNSATISFIABLE: Outcome = 3;
pub val IGNORED: Outcome = 4;

pub rec Span {
    outcome: Outcome;
    first: u64;
    last: u64;
    length: u64;
}

fun ignored() Span {
    ret Span{outcome: IGNORED, first: 0, last: 0, length: 0};
}

fun absent() Span {
    ret Span{outcome: NO_RANGE, first: 0, last: 0, length: 0};
}

fun unsatisfiable() Span {
    ret Span{outcome: UNSATISFIABLE, first: 0, last: 0, length: 0};
}

fun skip_spaces(value: view.View, offset: *usize) {
    for (@offset < value.len && (value.data[@offset] == ' ' || value.data[@offset] == '\t')) {
        @offset = @offset + 1;
    }
}

# an unbounded accumulation would wrap, so a value that cannot fit is refused
fun digits(value: view.View, offset: *usize, output: *u64) bool {
    var seen: bool = false;
    var total: u64 = 0;
    for (@offset < value.len && value.data[@offset] >= '0' && value.data[@offset] <= '9') {
        val d: u64 = (value.data[@offset] - '0')::u64;
        if (total > (0xffffffffffffffff - d) / 10) { ret false; }
        total = total * 10 + d;
        seen = true;
        @offset = @offset + 1;
    }
    if (!seen) { ret false; }
    @output = total;
    ret true;
}

# resolve one `Range` field value against a known representation length
#
# only a single byte range is honoured. a multi-range request is reported as
# ignorable so the caller answers with the whole representation, which is a
# permitted response and avoids emitting multipart/byteranges.
pub fun resolve(value: view.View, length: u64) Span {
    if (value.data == nil || value.len == 0) { ret absent(); }
    var offset: usize = 0;
    skip_spaces(value, ?offset);
    if (offset + 6 > value.len) { ret ignored(); }
    if (value.data[offset] != 'b' || value.data[offset + 1] != 'y' || value.data[offset + 2] != 't'
     || value.data[offset + 3] != 'e' || value.data[offset + 4] != 's'
     || value.data[offset + 5] != '=') { ret ignored(); }
    offset = offset + 6;
    skip_spaces(value, ?offset);
    var first: u64 = 0;
    var last: u64 = 0;
    var suffix: bool = false;
    if (offset < value.len && value.data[offset] == '-') {
        suffix = true;
        offset = offset + 1;
        if (!digits(value, ?offset, ?last)) { ret ignored(); }
    } or {
        if (!digits(value, ?offset, ?first)) { ret ignored(); }
        if (offset >= value.len || value.data[offset] != '-') { ret ignored(); }
        offset = offset + 1;
        if (offset < value.len && value.data[offset] >= '0' && value.data[offset] <= '9') {
            if (!digits(value, ?offset, ?last)) { ret ignored(); }
        } or {
            last = 0xffffffffffffffff;
        }
    }
    skip_spaces(value, ?offset);
    # a further range makes this a multi-range request, which is not honoured here
    if (offset != value.len) { ret ignored(); }
    if (suffix) {
        if (last == 0) { ret unsatisfiable(); }
        if (length == 0) { ret unsatisfiable(); }
        if (last >= length) { ret Span{outcome: SATISFIABLE, first: 0, last: length - 1, length: length}; }
        ret Span{outcome: SATISFIABLE, first: length - last, last: length - 1, length: last};
    }
    if (length == 0 || first >= length) { ret unsatisfiable(); }
    var end: u64 = last;
    if (end >= length) { end = length - 1; }
    if (end < first) { ret unsatisfiable(); }
    ret Span{outcome: SATISFIABLE, first: first, last: end, length: end - first + 1};
}

pub val CONTENT_RANGE_CAPACITY: usize = 80;

fun write_u64(output: *u8, offset: usize, value: u64) usize {
    var digit_count: usize = 1;
    var scale: u64 = value;
    for (scale >= 10) { scale = scale / 10; digit_count = digit_count + 1; }
    var i: usize = digit_count;
    var remaining: u64 = value;
    for (i > 0) {
        i = i - 1;
        output[offset + i] = ('0' + (remaining % 10)::u8);
        remaining = remaining / 10;
    }
    ret offset + digit_count;
}

fun write_text(output: *u8, offset: usize, text: str) usize {
    var i: usize = 0;
    for (text[i] != 0) {
        output[offset + i] = text[i];
        i = i + 1;
    }
    ret offset + i;
}

# `bytes <first>-<last>/<length>`
pub fun format_content_range(span: Span, complete: u64, output: *u8, capacity: usize) usize {
    if (output == nil || capacity < CONTENT_RANGE_CAPACITY || span.outcome != SATISFIABLE) { ret 0; }
    var offset: usize = write_text(output, 0, "bytes ");
    offset = write_u64(output, offset, span.first);
    output[offset] = '-';
    offset = write_u64(output, offset + 1, span.last);
    output[offset] = '/';
    offset = write_u64(output, offset + 1, complete);
    output[offset] = 0;
    ret offset;
}

# `bytes */<length>`, the required form on 416
pub fun format_unsatisfied(complete: u64, output: *u8, capacity: usize) usize {
    if (output == nil || capacity < CONTENT_RANGE_CAPACITY) { ret 0; }
    var offset: usize = write_text(output, 0, "bytes */");
    offset = write_u64(output, offset, complete);
    output[offset] = 0;
    ret offset;
}

test "http range: a bounded range resolves to an inclusive span" {
    val span: Span = resolve(view.view("bytes=0-4", 9), 100);
    if (span.outcome != SATISFIABLE || span.first != 0 || span.last != 4 || span.length != 5) { ret 1; }
    val open: Span = resolve(view.view("bytes=90-", 9), 100);
    if (open.outcome != SATISFIABLE || open.first != 90 || open.last != 99 || open.length != 10) { ret 2; }
    val clamped: Span = resolve(view.view("bytes=95-1000", 13), 100);
    if (clamped.outcome != SATISFIABLE || clamped.last != 99 || clamped.length != 5) { ret 3; }
    ret 0;
}

test "http range: a suffix range counts back from the end" {
    val span: Span = resolve(view.view("bytes=-10", 9), 100);
    if (span.outcome != SATISFIABLE || span.first != 90 || span.last != 99 || span.length != 10) { ret 1; }
    val oversized: Span = resolve(view.view("bytes=-500", 10), 100);
    if (oversized.outcome != SATISFIABLE || oversized.first != 0 || oversized.last != 99) { ret 2; }
    if (resolve(view.view("bytes=-0", 8), 100).outcome != UNSATISFIABLE) { ret 3; }
    ret 0;
}

test "http range: a range past the representation is unsatisfiable" {
    if (resolve(view.view("bytes=100-200", 13), 100).outcome != UNSATISFIABLE) { ret 1; }
    if (resolve(view.view("bytes=0-0", 9), 0).outcome != UNSATISFIABLE) { ret 2; }
    ret 0;
}

test "http range: unsupported and malformed forms are ignored, never refused" {
    if (resolve(view.view("bytes=0-1,5-6", 13), 100).outcome != IGNORED) { ret 1; }
    if (resolve(view.view("items=0-1", 9), 100).outcome != IGNORED) { ret 2; }
    if (resolve(view.view("bytes=x-y", 9), 100).outcome != IGNORED) { ret 3; }
    if (resolve(view.view("bytes=5", 7), 100).outcome != IGNORED) { ret 4; }
    if (resolve(view.view("bytes=99999999999999999999999-", 29), 100).outcome != IGNORED) { ret 5; }
    if (resolve(view.view(nil, 0), 100).outcome != NO_RANGE) { ret 6; }
    ret 0;
}

test "http range: content-range renders both the served span and the refusal" {
    var output: [CONTENT_RANGE_CAPACITY]u8;
    val span: Span = resolve(view.view("bytes=10-19", 11), 100);
    val served: usize = format_content_range(span, 100, ?output[0], CONTENT_RANGE_CAPACITY);
    if (served == 0 || !view.view_eq_str(view.view(?output[0], served), "bytes 10-19/100")) { ret 1; }
    val refused: usize = format_unsatisfied(100, ?output[0], CONTENT_RANGE_CAPACITY);
    if (refused == 0 || !view.view_eq_str(view.view(?output[0], refused), "bytes */100")) { ret 2; }
    ret 0;
}
