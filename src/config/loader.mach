# strict toml loading, reference resolution, and graph validation

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.allocator;
use std.allocator.fixed;
use std.data.toml;
use hedge.config.schema;
pub val MAX_INCLUDE_DEPTH: usize = 16;
pub val MAX_SOURCE_BYTES: usize = 65536;

pub def ResolveFun: fun(ptr, str, *u8, usize) i64;

pub rec Resolver {
    context: ptr;
    include: ResolveFun;
    environment: ResolveFun;
}

pub rec Capabilities {
    quic: bool;
    local_transport: bool;
    environment_secrets: bool;
    file_secrets: bool;
    os_secrets: bool;
    application_secrets: bool;
}

rec Workspace {
    depth: usize;
    stack: [MAX_INCLUDE_DEPTH]schema.Text;
    source: [MAX_SOURCE_BYTES]u8;
}

fun has_include_resolver(resolver: *Resolver) bool {
    if (resolver == nil) { ret false; }
    ret resolver.include::usize != 0;
}

fun has_environment_resolver(resolver: *Resolver) bool {
    if (resolver == nil) { ret false; }
    ret resolver.environment::usize != 0;
}

fun diagnose(diagnostics: *schema.Diagnostics, code: schema.DiagnosticCode, source: str, path: str, message: str) {
    schema.add_diagnostic(diagnostics, schema.ERROR, code, source, path, message);
}

fun key_allowed(key: str, a: str, b: str, c: str, d: str, e: str, f: str, g: str, h: str) bool {
    ret str_equals(key, a) || str_equals(key, b) || str_equals(key, c) || str_equals(key, d)
        || str_equals(key, e) || str_equals(key, f) || str_equals(key, g) || str_equals(key, h);
}

fun validate_fields(table: *toml.Table, diagnostics: *schema.Diagnostics, source: str, allowed: *str, count: usize) {
    var i: usize = 0;
    for (i < toml.table_len(table)) {
        val key: str = toml.table_key(table, i);
        var found: bool = false;
        var j: usize = 0;
        for (j < count) {
            if (str_equals(key, allowed[j])) { found = true; }
            j = j + 1;
        }
        if (!found) { diagnose(diagnostics, schema.UNKNOWN_FIELD, source, key, "unknown configuration field"); }
        i = i + 1;
    }
}

fun value(table: *toml.Table, key: str) *toml.Value {
    ret toml.get(table, key);
}

fun optional_table(table: *toml.Table, key: str, diagnostics: *schema.Diagnostics, source: str) *toml.Table {
    val item: *toml.Value = value(table, key);
    if (item == nil) { ret nil; }
    if (item.tag != toml.TYPE_TABLE) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, key, "field must be a table");
        ret nil;
    }
    ret ?item.data.table;
}

fun required_string(table: *toml.Table, key: str, diagnostics: *schema.Diagnostics, source: str) str {
    val item: *toml.Value = value(table, key);
    if (item == nil) {
        diagnose(diagnostics, schema.MISSING_FIELD, source, key, "required string field is missing");
        ret nil;
    }
    if (item.tag != toml.TYPE_STRING) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, key, "field must be a string");
        ret nil;
    }
    ret item.data.string;
}

fun optional_string(table: *toml.Table, key: str, diagnostics: *schema.Diagnostics, source: str) str {
    val item: *toml.Value = value(table, key);
    if (item == nil) { ret nil; }
    if (item.tag != toml.TYPE_STRING) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, key, "field must be a string");
        ret nil;
    }
    ret item.data.string;
}

fun optional_bool(table: *toml.Table, key: str, fallback: bool, diagnostics: *schema.Diagnostics, source: str) bool {
    val item: *toml.Value = value(table, key);
    if (item == nil) { ret fallback; }
    if (item.tag != toml.TYPE_BOOL) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, key, "field must be a boolean");
        ret fallback;
    }
    ret item.data.boolean;
}

fun optional_usize(table: *toml.Table, key: str, fallback: usize, allow_zero: bool, diagnostics: *schema.Diagnostics, source: str) usize {
    val item: *toml.Value = value(table, key);
    if (item == nil) { ret fallback; }
    if (item.tag != toml.TYPE_INTEGER) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, key, "field must be an integer");
        ret fallback;
    }
    if (item.data.integer < 0 || (!allow_zero && item.data.integer == 0)) {
        diagnose(diagnostics, schema.INVALID_VALUE, source, key, "integer is outside the accepted range");
        ret fallback;
    }
    ret item.data.integer::usize;
}

fun optional_u64(table: *toml.Table, key: str, fallback: u64, allow_zero: bool, diagnostics: *schema.Diagnostics, source: str) u64 {
    val parsed: usize = optional_usize(table, key, fallback::usize, allow_zero, diagnostics, source);
    ret parsed::u64;
}

fun resolve_text(
    output: *schema.Text,
    raw: str,
    resolver: *Resolver,
    diagnostics: *schema.Diagnostics,
    source: str,
    path: str,
) bool {
    schema.clear_text(output);
    if (raw == nil) { ret true; }
    val n: usize = str_len(raw);
    if (n >= 8 && raw[0] == '$' && raw[1] == '{' && raw[2] == 'E' && raw[3] == 'N' && raw[4] == 'V' && raw[5] == ':' && raw[n - 1] == '}') {
        if (!has_environment_resolver(resolver)) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, source, path, "environment reference has no resolver");
            ret false;
        }
        var name: [schema.TEXT_CAP]u8;
        val name_len: usize = n - 7;
        if (name_len == 0 || name_len >= schema.TEXT_CAP) {
            diagnose(diagnostics, schema.INVALID_VALUE, source, path, "environment reference name is invalid");
            ret false;
        }
        var i: usize = 0;
        for (i < name_len) {
            name[i] = raw[i + 6];
            i = i + 1;
        }
        name[name_len] = 0;
        val resolved: i64 = resolver.environment(resolver.context, (?name[0])::str, ?output.data[0], schema.TEXT_CAP);
        if (resolved < 0) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, source, path, "environment reference was not found");
            ret false;
        }
        if (resolved::usize >= schema.TEXT_CAP) {
            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, path, "resolved environment value exceeds the configured bound");
            ret false;
        }
        output.data[resolved::usize] = 0;
        output.len = resolved::usize;
        ret true;
    }
    if (!schema.set_text(output, raw)) {
        diagnose(diagnostics, schema.RESOURCE_LIMIT, source, path, "string exceeds the configured bound");
        ret false;
    }
    ret true;
}

fun parse_server(graph: *schema.Graph, table: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    var allowed: [5]str = [5]str{"name", "limits", "timeouts", "features", "workers"};
    validate_fields(table, diagnostics, source, ?allowed[0], 5);
    val workers: *toml.Value = value(table, "workers");
    if (workers != nil) {
        schema.add_diagnostic(diagnostics, schema.WARNING, schema.DEPRECATED_FIELD, source, "server.workers", "server.workers is deprecated because execution sizing belongs to budgets");
    }
    resolve_text(?graph.server_name, required_string(table, "name", diagnostics, source), resolver, diagnostics, source, "server.name");

    val limits: *toml.Table = optional_table(table, "limits", diagnostics, source);
    if (limits != nil) {
        var limit_fields: [6]str = [6]str{"max_connections", "max_connections_per_peer", "max_header_bytes", "max_header_count", "max_body_bytes", "max_pipeline_depth"};
        validate_fields(limits, diagnostics, source, ?limit_fields[0], 6);
        graph.limits.max_connections = optional_usize(limits, "max_connections", graph.limits.max_connections, false, diagnostics, source);
        graph.limits.max_connections_per_peer = optional_usize(limits, "max_connections_per_peer", graph.limits.max_connections_per_peer, false, diagnostics, source);
        graph.limits.max_header_bytes = optional_usize(limits, "max_header_bytes", graph.limits.max_header_bytes, false, diagnostics, source);
        graph.limits.max_header_count = optional_usize(limits, "max_header_count", graph.limits.max_header_count, false, diagnostics, source);
        graph.limits.max_body_bytes = optional_usize(limits, "max_body_bytes", graph.limits.max_body_bytes, true, diagnostics, source);
        graph.limits.max_pipeline_depth = optional_usize(limits, "max_pipeline_depth", graph.limits.max_pipeline_depth, false, diagnostics, source);
    }

    val timeouts: *toml.Table = optional_table(table, "timeouts", diagnostics, source);
    if (timeouts != nil) {
        var timeout_fields: [6]str = [6]str{"handshake_ms", "header_ms", "request_ms", "write_ms", "keep_alive_ms", "drain_ms"};
        validate_fields(timeouts, diagnostics, source, ?timeout_fields[0], 6);
        graph.timeouts.handshake_ms = optional_u64(timeouts, "handshake_ms", graph.timeouts.handshake_ms, false, diagnostics, source);
        graph.timeouts.header_ms = optional_u64(timeouts, "header_ms", graph.timeouts.header_ms, false, diagnostics, source);
        graph.timeouts.request_ms = optional_u64(timeouts, "request_ms", graph.timeouts.request_ms, false, diagnostics, source);
        graph.timeouts.write_ms = optional_u64(timeouts, "write_ms", graph.timeouts.write_ms, false, diagnostics, source);
        graph.timeouts.keep_alive_ms = optional_u64(timeouts, "keep_alive_ms", graph.timeouts.keep_alive_ms, false, diagnostics, source);
        graph.timeouts.drain_ms = optional_u64(timeouts, "drain_ms", graph.timeouts.drain_ms, false, diagnostics, source);
    }

    val features: *toml.Table = optional_table(table, "features", diagnostics, source);
    if (features != nil) {
        var feature_fields: [7]str = [7]str{"http1", "http2", "http3", "tls", "acme", "proxy", "cache"};
        validate_fields(features, diagnostics, source, ?feature_fields[0], 7);
        graph.features.http1 = optional_bool(features, "http1", graph.features.http1, diagnostics, source);
        graph.features.http2 = optional_bool(features, "http2", graph.features.http2, diagnostics, source);
        graph.features.http3 = optional_bool(features, "http3", graph.features.http3, diagnostics, source);
        graph.features.tls = optional_bool(features, "tls", graph.features.tls, diagnostics, source);
        graph.features.acme = optional_bool(features, "acme", graph.features.acme, diagnostics, source);
        graph.features.proxy = optional_bool(features, "proxy", graph.features.proxy, diagnostics, source);
        graph.features.cache = optional_bool(features, "cache", graph.features.cache, diagnostics, source);
    }
}

fun parse_protocols(listener: *schema.Listener, item: *toml.Value, diagnostics: *schema.Diagnostics, source: str) {
    listener.protocols = 0;
    if (item == nil) {
        diagnose(diagnostics, schema.MISSING_FIELD, source, "listener.protocols", "listener protocols must be a non-empty string array");
        ret;
    }
    if (item.tag != toml.TYPE_ARRAY) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, "listener.protocols", "listener protocols must be a non-empty string array");
        ret;
    }
    var i: usize = 0;
    for (i < toml.array_len(?item.data.array)) {
        val protocol: *toml.Value = toml.array_get(?item.data.array, i);
        if (protocol == nil || protocol.tag != toml.TYPE_STRING) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, "listener.protocols", "protocol entries must be strings");
        } or (str_equals(protocol.data.string, "http/1.1")) {
            listener.protocols = listener.protocols | schema.PROTOCOL_HTTP1;
        } or (str_equals(protocol.data.string, "h2")) {
            listener.protocols = listener.protocols | schema.PROTOCOL_HTTP2;
        } or (str_equals(protocol.data.string, "h3")) {
            listener.protocols = listener.protocols | schema.PROTOCOL_HTTP3;
        } or {
            diagnose(diagnostics, schema.INVALID_VALUE, source, "listener.protocols", "unsupported application protocol identifier");
        }
        i = i + 1;
    }
    if (listener.protocols == 0) {
        diagnose(diagnostics, schema.INVALID_VALUE, source, "listener.protocols", "at least one application protocol is required");
    }
}

fun parse_listener(graph: *schema.Graph, table: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (graph.listener_count >= schema.MAX_LISTENERS) {
        diagnose(diagnostics, schema.RESOURCE_LIMIT, source, "listener", "listener count exceeds the configured bound");
        ret;
    }
    var allowed: [6]str = [6]str{"name", "address", "transport", "protocols", "tls", "budget"};
    validate_fields(table, diagnostics, source, ?allowed[0], 6);
    val listener: *schema.Listener = ?graph.listeners[graph.listener_count];
    graph.listener_count = graph.listener_count + 1;
    resolve_text(?listener.name, required_string(table, "name", diagnostics, source), resolver, diagnostics, source, "listener.name");
    resolve_text(?listener.address, required_string(table, "address", diagnostics, source), resolver, diagnostics, source, "listener.address");
    schema.clear_text(?listener.tls_policy);
    schema.clear_text(?listener.budget);
    resolve_text(?listener.tls_policy, optional_string(table, "tls", diagnostics, source), resolver, diagnostics, source, "listener.tls");
    resolve_text(?listener.budget, optional_string(table, "budget", diagnostics, source), resolver, diagnostics, source, "listener.budget");
    val transport: str = optional_string(table, "transport", diagnostics, source);
    listener.transport = schema.TRANSPORT_TCP;
    if (transport != nil && str_equals(transport, "quic")) { listener.transport = schema.TRANSPORT_QUIC; }
    or (transport != nil && str_equals(transport, "local")) { listener.transport = schema.TRANSPORT_LOCAL; }
    or (transport != nil && !str_equals(transport, "tcp")) {
        diagnose(diagnostics, schema.INVALID_VALUE, source, "listener.transport", "transport must be tcp, quic, or local");
    }
    parse_protocols(listener, value(table, "protocols"), diagnostics, source);
}

fun parse_listener_section(graph: *schema.Graph, item: *toml.Value, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (item == nil) { ret; }
    if (item.tag != toml.TYPE_ARRAY) {
        diagnose(diagnostics, schema.WRONG_TYPE, source, "listener", "listener must be an array of tables");
        ret;
    }
    var i: usize = 0;
    for (i < toml.array_len(?item.data.array)) {
        val entry: *toml.Value = toml.array_get(?item.data.array, i);
        if (entry == nil || entry.tag != toml.TYPE_TABLE) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, "listener", "listener entry must be a table");
        } or {
            parse_listener(graph, ?entry.data.table, resolver, diagnostics, source);
        }
        i = i + 1;
    }
}

fun parse_tls(graph: *schema.Graph, section: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (section == nil) { ret; }
    var i: usize = 0;
    for (i < toml.table_len(section)) {
        val name: str = toml.table_key(section, i);
        val item: *toml.Value = toml.table_value(section, i);
        if (item == nil || item.tag != toml.TYPE_TABLE) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, name, "TLS policy must be a table");
        } or (graph.tls_policy_count >= schema.MAX_TLS_POLICIES) {
            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, name, "TLS policy count exceeds the configured bound");
        } or {
            var allowed: [2]str = [2]str{"certificate", "client_auth"};
            validate_fields(?item.data.table, diagnostics, source, ?allowed[0], 2);
            val policy: *schema.TlsPolicy = ?graph.tls_policies[graph.tls_policy_count];
            graph.tls_policy_count = graph.tls_policy_count + 1;
            resolve_text(?policy.name, name, resolver, diagnostics, source, "tls.name");
            resolve_text(?policy.certificate, required_string(?item.data.table, "certificate", diagnostics, source), resolver, diagnostics, source, "tls.certificate");
            policy.client_auth = optional_bool(?item.data.table, "client_auth", false, diagnostics, source);
        }
        i = i + 1;
    }
}

fun parse_hosts(graph: *schema.Graph, section: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (section == nil) { ret; }
    var i: usize = 0;
    for (i < toml.table_len(section)) {
        val name: str = toml.table_key(section, i);
        val item: *toml.Value = toml.table_value(section, i);
        if (item == nil || item.tag != toml.TYPE_TABLE) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, name, "host must be a table");
        } or (graph.host_count >= schema.MAX_HOSTS) {
            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, name, "host count exceeds the configured bound");
        } or {
            var allowed: [3]str = [3]str{"listener", "server_name", "names"};
            validate_fields(?item.data.table, diagnostics, source, ?allowed[0], 3);
            val host: *schema.Host = ?graph.hosts[graph.host_count];
            graph.host_count = graph.host_count + 1;
            resolve_text(?host.name, name, resolver, diagnostics, source, "host.name");
            resolve_text(?host.listener, required_string(?item.data.table, "listener", diagnostics, source), resolver, diagnostics, source, "host.listener");
            host.server_name_count = 0;
            val server_name: str = optional_string(?item.data.table, "server_name", diagnostics, source);
            val names: *toml.Value = value(?item.data.table, "names");
            if (server_name != nil && names != nil) {
                diagnose(diagnostics, schema.CONFLICT, source, "host.names", "server_name and names cannot both be configured");
            }
            if (server_name != nil) {
                resolve_text(?host.server_names[0], server_name, resolver, diagnostics, source, "host.server_name");
                host.server_name_count = 1;
            } or (names != nil) {
                if (names.tag != toml.TYPE_ARRAY || toml.array_len(?names.data.array) == 0) {
                    diagnose(diagnostics, schema.WRONG_TYPE, source, "host.names", "host names must be a non-empty string array");
                } or {
                    var j: usize = 0;
                    for (j < toml.array_len(?names.data.array)) {
                        val host_name: *toml.Value = toml.array_get(?names.data.array, j);
                        if (host.server_name_count >= schema.MAX_HOST_NAMES) {
                            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, "host.names", "host name count exceeds the configured bound");
                        } or (host_name == nil || host_name.tag != toml.TYPE_STRING) {
                            diagnose(diagnostics, schema.WRONG_TYPE, source, "host.names", "host name entries must be strings");
                        } or {
                            resolve_text(?host.server_names[host.server_name_count], host_name.data.string, resolver, diagnostics, source, "host.names");
                            host.server_name_count = host.server_name_count + 1;
                        }
                        j = j + 1;
                    }
                }
            } or {
                resolve_text(?host.server_names[0], name, resolver, diagnostics, source, "host.name");
                host.server_name_count = 1;
            }
        }
        i = i + 1;
    }
}

fun parse_route(graph: *schema.Graph, table: *toml.Table, default_name: str, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (graph.route_count >= schema.MAX_ROUTES) {
        diagnose(diagnostics, schema.RESOURCE_LIMIT, source, "route", "route count exceeds the configured bound");
        ret;
    }
    var allowed: [6]str = [6]str{"name", "host", "path", "service", "budget", "priority"};
    validate_fields(table, diagnostics, source, ?allowed[0], 6);
    val route: *schema.Route = ?graph.routes[graph.route_count];
    graph.route_count = graph.route_count + 1;
    val path: str = required_string(table, "path", diagnostics, source);
    var name: str = optional_string(table, "name", diagnostics, source);
    if (name == nil) { name = path; }
    if (name == nil) { name = default_name; }
    resolve_text(?route.name, name, resolver, diagnostics, source, "route.name");
    resolve_text(?route.host, required_string(table, "host", diagnostics, source), resolver, diagnostics, source, "route.host");
    resolve_text(?route.path, path, resolver, diagnostics, source, "route.path");
    resolve_text(?route.service, required_string(table, "service", diagnostics, source), resolver, diagnostics, source, "route.service");
    resolve_text(?route.budget, optional_string(table, "budget", diagnostics, source), resolver, diagnostics, source, "route.budget");
}

fun parse_routes(graph: *schema.Graph, root: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    val direct: *toml.Value = value(root, "route");
    if (direct != nil) {
        if (direct.tag != toml.TYPE_ARRAY) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, "route", "route must be an array of tables");
        } or {
            var i: usize = 0;
            for (i < toml.array_len(?direct.data.array)) {
                val entry: *toml.Value = toml.array_get(?direct.data.array, i);
                if (entry == nil || entry.tag != toml.TYPE_TABLE) {
                    diagnose(diagnostics, schema.WRONG_TYPE, source, "route", "route entry must be a table");
                } or {
                    parse_route(graph, ?entry.data.table, "route", resolver, diagnostics, source);
                }
                i = i + 1;
            }
        }
    }
    val groups: *toml.Table = optional_table(root, "routes", diagnostics, source);
    if (groups == nil) { ret; }
    var i: usize = 0;
    for (i < toml.table_len(groups)) {
        val group: str = toml.table_key(groups, i);
        val item: *toml.Value = toml.table_value(groups, i);
        if (item == nil || item.tag != toml.TYPE_ARRAY) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, group, "route group must be an array of tables");
        } or {
            var j: usize = 0;
            for (j < toml.array_len(?item.data.array)) {
                val entry: *toml.Value = toml.array_get(?item.data.array, j);
                if (entry == nil || entry.tag != toml.TYPE_TABLE) {
                    diagnose(diagnostics, schema.WRONG_TYPE, source, group, "route group entry must be a table");
                } or {
                    parse_route(graph, ?entry.data.table, group, resolver, diagnostics, source);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

fun service_kind(kind: str) u8 {
    if (str_equals(kind, "static")) { ret schema.SERVICE_STATIC; }
    if (str_equals(kind, "proxy")) { ret schema.SERVICE_PROXY; }
    if (str_equals(kind, "laurel")) { ret schema.SERVICE_LAUREL; }
    if (str_equals(kind, "fixed")) { ret schema.SERVICE_FIXED; }
    if (str_equals(kind, "redirect")) { ret schema.SERVICE_REDIRECT; }
    if (str_equals(kind, "native")) { ret schema.SERVICE_NATIVE; }
    ret 0;
}

fun parse_services(graph: *schema.Graph, section: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (section == nil) { ret; }
    var i: usize = 0;
    for (i < toml.table_len(section)) {
        val name: str = toml.table_key(section, i);
        val item: *toml.Value = toml.table_value(section, i);
        if (item == nil || item.tag != toml.TYPE_TABLE) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, name, "service must be a table");
        } or (graph.service_count >= schema.MAX_SERVICES) {
            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, name, "service count exceeds the configured bound");
        } or {
            var allowed: [8]str = [8]str{"kind", "target", "root", "application", "upstream", "body", "budget", "secret"};
            validate_fields(?item.data.table, diagnostics, source, ?allowed[0], 8);
            val service: *schema.Service = ?graph.services[graph.service_count];
            graph.service_count = graph.service_count + 1;
            resolve_text(?service.name, name, resolver, diagnostics, source, "service.name");
            val kind: str = required_string(?item.data.table, "kind", diagnostics, source);
            service.kind = service_kind(kind);
            if (service.kind == 0) { diagnose(diagnostics, schema.INVALID_VALUE, source, "service.kind", "unknown service kind"); }
            var target: str = optional_string(?item.data.table, "target", diagnostics, source);
            if (target == nil) { target = optional_string(?item.data.table, "root", diagnostics, source); }
            if (target == nil) { target = optional_string(?item.data.table, "application", diagnostics, source); }
            if (target == nil) { target = optional_string(?item.data.table, "upstream", diagnostics, source); }
            if (target == nil) { target = optional_string(?item.data.table, "body", diagnostics, source); }
            resolve_text(?service.target, target, resolver, diagnostics, source, "service.target");
            resolve_text(?service.budget, optional_string(?item.data.table, "budget", diagnostics, source), resolver, diagnostics, source, "service.budget");
            resolve_text(?service.secret, optional_string(?item.data.table, "secret", diagnostics, source), resolver, diagnostics, source, "service.secret");
        }
        i = i + 1;
    }
}

fun parse_budgets(graph: *schema.Graph, section: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (section == nil) { ret; }
    var i: usize = 0;
    for (i < toml.table_len(section)) {
        val name: str = toml.table_key(section, i);
        val item: *toml.Value = toml.table_value(section, i);
        if (item == nil || item.tag != toml.TYPE_TABLE) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, name, "budget must be a table");
        } or (graph.budget_count >= schema.MAX_BUDGETS) {
            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, name, "budget count exceeds the configured bound");
        } or {
            var allowed: [4]str = [4]str{"concurrency", "queue", "timeout_ms", "memory_bytes"};
            validate_fields(?item.data.table, diagnostics, source, ?allowed[0], 4);
            val budget: *schema.Budget = ?graph.budgets[graph.budget_count];
            graph.budget_count = graph.budget_count + 1;
            resolve_text(?budget.name, name, resolver, diagnostics, source, "budget.name");
            budget.concurrency = optional_usize(?item.data.table, "concurrency", 1, false, diagnostics, source);
            budget.queue = optional_usize(?item.data.table, "queue", 0, true, diagnostics, source);
            budget.timeout_ms = optional_u64(?item.data.table, "timeout_ms", graph.timeouts.request_ms, false, diagnostics, source);
            budget.memory_bytes = optional_usize(?item.data.table, "memory_bytes", 1048576, false, diagnostics, source);
        }
        i = i + 1;
    }
}

fun parse_secrets(graph: *schema.Graph, section: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (section == nil) { ret; }
    var i: usize = 0;
    for (i < toml.table_len(section)) {
        val name: str = toml.table_key(section, i);
        val item: *toml.Value = toml.table_value(section, i);
        if (item == nil || item.tag != toml.TYPE_TABLE) {
            diagnose(diagnostics, schema.WRONG_TYPE, source, name, "secret must be a table");
        } or (graph.secret_count >= schema.MAX_SECRETS) {
            diagnose(diagnostics, schema.RESOURCE_LIMIT, source, name, "secret count exceeds the configured bound");
        } or {
            var allowed: [2]str = [2]str{"provider", "key"};
            validate_fields(?item.data.table, diagnostics, source, ?allowed[0], 2);
            val secret: *schema.Secret = ?graph.secrets[graph.secret_count];
            graph.secret_count = graph.secret_count + 1;
            resolve_text(?secret.name, name, resolver, diagnostics, source, "secret.name");
            resolve_text(?secret.provider, required_string(?item.data.table, "provider", diagnostics, source), resolver, diagnostics, source, "secret.provider");
            resolve_text(?secret.key, required_string(?item.data.table, "key", diagnostics, source), resolver, diagnostics, source, "secret.key");
        }
        i = i + 1;
    }
}

fun parse_telemetry(graph: *schema.Graph, section: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    if (section == nil) { ret; }
    var allowed: [4]str = [4]str{"logs", "metrics", "traces", "endpoint"};
    validate_fields(section, diagnostics, source, ?allowed[0], 4);
    graph.telemetry.logs = optional_bool(section, "logs", graph.telemetry.logs, diagnostics, source);
    graph.telemetry.metrics = optional_bool(section, "metrics", graph.telemetry.metrics, diagnostics, source);
    graph.telemetry.traces = optional_bool(section, "traces", graph.telemetry.traces, diagnostics, source);
    resolve_text(?graph.telemetry.endpoint, optional_string(section, "endpoint", diagnostics, source), resolver, diagnostics, source, "telemetry.endpoint");
}

fun parse_table(graph: *schema.Graph, table: *toml.Table, resolver: *Resolver, diagnostics: *schema.Diagnostics, source: str) {
    var i: usize = 0;
    for (i < toml.table_len(table)) {
        val key: str = toml.table_key(table, i);
        if (!key_allowed(key, "include", "server", "listener", "tls", "host", "route", "routes", "service")
            && !key_allowed(key, "budget", "secret", "telemetry", "", "", "", "", "")) {
            diagnose(diagnostics, schema.UNKNOWN_FIELD, source, key, "unknown top-level configuration field");
        }
        i = i + 1;
    }
    val server: *toml.Table = optional_table(table, "server", diagnostics, source);
    if (server != nil) { parse_server(graph, server, resolver, diagnostics, source); }
    parse_listener_section(graph, value(table, "listener"), resolver, diagnostics, source);
    parse_tls(graph, optional_table(table, "tls", diagnostics, source), resolver, diagnostics, source);
    parse_hosts(graph, optional_table(table, "host", diagnostics, source), resolver, diagnostics, source);
    parse_routes(graph, table, resolver, diagnostics, source);
    parse_services(graph, optional_table(table, "service", diagnostics, source), resolver, diagnostics, source);
    parse_budgets(graph, optional_table(table, "budget", diagnostics, source), resolver, diagnostics, source);
    parse_secrets(graph, optional_table(table, "secret", diagnostics, source), resolver, diagnostics, source);
    parse_telemetry(graph, optional_table(table, "telemetry", diagnostics, source), resolver, diagnostics, source);
}

fun stack_contains(workspace: *Workspace, name: str) bool {
    var i: usize = 0;
    for (i < workspace.depth) {
        if (schema.text_equals(?workspace.stack[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun process_source(
    graph: *schema.Graph,
    diagnostics: *schema.Diagnostics,
    a: *allocator.Allocator,
    source_name: str,
    source: str,
    resolver: *Resolver,
    workspace: *Workspace,
) bool {
    if (workspace.depth >= MAX_INCLUDE_DEPTH) {
        diagnose(diagnostics, schema.RESOURCE_LIMIT, source_name, "include", "include depth exceeds the configured bound");
        ret false;
    }
    if (stack_contains(workspace, source_name)) {
        diagnose(diagnostics, schema.INCLUDE_CYCLE, source_name, "include", "configuration include cycle detected");
        ret false;
    }
    if (!schema.set_text(?workspace.stack[workspace.depth], source_name)) {
        diagnose(diagnostics, schema.RESOURCE_LIMIT, source_name, "include", "source name exceeds the configured bound");
        ret false;
    }
    workspace.depth = workspace.depth + 1;
    val parsed: Result[toml.Table, str] = toml.parse(a, source);
    if (is_err[toml.Table, str](parsed)) {
        diagnose(diagnostics, schema.SOURCE_ERROR, source_name, "", unwrap_err[toml.Table, str](parsed));
        workspace.depth = workspace.depth - 1;
        ret false;
    }
    var table: toml.Table = unwrap_ok[toml.Table, str](parsed);
    val includes: *toml.Value = value(?table, "include");
    if (includes != nil) {
        if (includes.tag != toml.TYPE_ARRAY) {
            diagnose(diagnostics, schema.WRONG_TYPE, source_name, "include", "include must be a string array");
        } or {
            var i: usize = 0;
            for (i < toml.array_len(?includes.data.array)) {
                val include: *toml.Value = toml.array_get(?includes.data.array, i);
                if (include == nil || include.tag != toml.TYPE_STRING) {
                    diagnose(diagnostics, schema.WRONG_TYPE, source_name, "include", "include entries must be strings");
                } or (!has_include_resolver(resolver)) {
                    diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, source_name, "include", "include has no source resolver");
                } or {
                    val bytes: i64 = resolver.include(resolver.context, include.data.string, ?workspace.source[0], MAX_SOURCE_BYTES);
                    if (bytes < 0) {
                        diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, source_name, include.data.string, "included source was not found");
                    } or (bytes::usize >= MAX_SOURCE_BYTES) {
                        diagnose(diagnostics, schema.RESOURCE_LIMIT, source_name, include.data.string, "included source exceeds the configured bound");
                    } or {
                        workspace.source[bytes::usize] = 0;
                        process_source(graph, diagnostics, a, include.data.string, (?workspace.source[0])::str, resolver, workspace);
                    }
                }
                i = i + 1;
            }
        }
    }
    parse_table(graph, ?table, resolver, diagnostics, source_name);
    toml.dnit(a, ?table);
    workspace.depth = workspace.depth - 1;
    ret true;
}

fun duplicate_names(graph: *schema.Graph, diagnostics: *schema.Diagnostics) {
    var i: usize = 0;
    var j: usize = 0;
    for (i < graph.listener_count) {
        j = i + 1;
        for (j < graph.listener_count) {
            if (schema.text_equals(?graph.listeners[i].name, schema.text(?graph.listeners[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.listeners[j].name), "duplicate listener name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.host_count) {
        j = i + 1;
        for (j < graph.host_count) {
            if (schema.text_equals(?graph.hosts[i].name, schema.text(?graph.hosts[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.hosts[j].name), "duplicate host name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.service_count) {
        j = i + 1;
        for (j < graph.service_count) {
            if (schema.text_equals(?graph.services[i].name, schema.text(?graph.services[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.services[j].name), "duplicate service name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.tls_policy_count) {
        j = i + 1;
        for (j < graph.tls_policy_count) {
            if (schema.text_equals(?graph.tls_policies[i].name, schema.text(?graph.tls_policies[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.tls_policies[j].name), "duplicate TLS policy name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.budget_count) {
        j = i + 1;
        for (j < graph.budget_count) {
            if (schema.text_equals(?graph.budgets[i].name, schema.text(?graph.budgets[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.budgets[j].name), "duplicate budget name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.secret_count) {
        j = i + 1;
        for (j < graph.secret_count) {
            if (schema.text_equals(?graph.secrets[i].name, schema.text(?graph.secrets[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.secrets[j].name), "duplicate secret name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.route_count) {
        j = i + 1;
        for (j < graph.route_count) {
            if (schema.text_equals(?graph.routes[i].host, schema.text(?graph.routes[j].host))
                && schema.text_equals(?graph.routes[i].name, schema.text(?graph.routes[j].name))) {
                diagnose(diagnostics, schema.DUPLICATE_NAME, "validation", schema.text(?graph.routes[j].name), "duplicate route name for host");
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

pub fun validate(graph: *schema.Graph, capabilities: Capabilities, diagnostics: *schema.Diagnostics) bool {
    duplicate_names(graph, diagnostics);
    if (graph.server_name.len == 0) {
        diagnose(diagnostics, schema.MISSING_FIELD, "validation", "server.name", "server name is required");
    }
    if (graph.limits.max_connections_per_peer > graph.limits.max_connections) {
        diagnose(diagnostics, schema.CONFLICT, "validation", "server.limits", "per-peer connection limit exceeds the global limit");
    }
    if (graph.timeouts.header_ms > graph.timeouts.request_ms || graph.timeouts.write_ms > graph.timeouts.request_ms) {
        diagnose(diagnostics, schema.CONFLICT, "validation", "server.timeouts", "phase timeout exceeds the request timeout");
    }
    var i: usize = 0;
    var j: usize = 0;
    for (i < graph.listener_count) {
        val listener: *schema.Listener = ?graph.listeners[i];
        if (listener.transport == schema.TRANSPORT_QUIC && !capabilities.quic) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?listener.name), "QUIC is unavailable in this build");
        }
        if (listener.transport == schema.TRANSPORT_LOCAL && !capabilities.local_transport) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?listener.name), "local transport is unavailable on this target");
        }
        if ((listener.protocols & schema.PROTOCOL_HTTP3) != 0 && listener.transport != schema.TRANSPORT_QUIC) {
            diagnose(diagnostics, schema.CONFLICT, "validation", schema.text(?listener.name), "HTTP/3 requires a QUIC listener");
        }
        if (listener.transport == schema.TRANSPORT_QUIC && (listener.protocols & (schema.PROTOCOL_HTTP1 | schema.PROTOCOL_HTTP2)) != 0) {
            diagnose(diagnostics, schema.CONFLICT, "validation", schema.text(?listener.name), "QUIC listeners may only select HTTP/3");
        }
        if (listener.tls_policy.len > 0 && schema.find_tls_policy(graph, schema.text(?listener.tls_policy)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?listener.tls_policy), "listener references an unknown TLS policy");
        }
        if (listener.transport == schema.TRANSPORT_QUIC && listener.tls_policy.len == 0) {
            diagnose(diagnostics, schema.MISSING_FIELD, "validation", schema.text(?listener.name), "QUIC listener requires a TLS policy");
        }
        if (listener.budget.len > 0 && schema.find_budget(graph, schema.text(?listener.budget)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?listener.budget), "listener references an unknown budget");
        }
        j = i + 1;
        for (j < graph.listener_count) {
            val other: *schema.Listener = ?graph.listeners[j];
            if (listener.transport == other.transport && schema.text_equals(?listener.address, schema.text(?other.address))) {
                diagnose(diagnostics, schema.CONFLICT, "validation", schema.text(?other.address), "listener address and transport conflict");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.host_count) {
        val host: *schema.Host = ?graph.hosts[i];
        if (schema.find_listener(graph, schema.text(?host.listener)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?host.listener), "host references an unknown listener");
        }
        var name_index: usize = 0;
        for (name_index < host.server_name_count) {
            j = 0;
            for (j < i) {
                val prior_host: *schema.Host = ?graph.hosts[j];
                if (schema.text_equals(?prior_host.listener, schema.text(?host.listener))) {
                    var prior_name_index: usize = 0;
                    for (prior_name_index < prior_host.server_name_count) {
                        if (schema.text_equals(?prior_host.server_names[prior_name_index], schema.text(?host.server_names[name_index]))) {
                            diagnose(diagnostics, schema.CONFLICT, "validation", schema.text(?host.server_names[name_index]), "server name is assigned twice on one listener");
                        }
                        prior_name_index = prior_name_index + 1;
                    }
                }
                j = j + 1;
            }
            name_index = name_index + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.route_count) {
        val route: *schema.Route = ?graph.routes[i];
        if (schema.find_host(graph, schema.text(?route.host)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?route.host), "route references an unknown host");
        }
        if (schema.find_service(graph, schema.text(?route.service)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?route.service), "route references an unknown service");
        }
        if (route.budget.len > 0 && schema.find_budget(graph, schema.text(?route.budget)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?route.budget), "route references an unknown budget");
        }
        j = 0;
        for (j < i) {
            val prior: *schema.Route = ?graph.routes[j];
            if (schema.text_equals(?prior.host, schema.text(?route.host))
                && (schema.text_equals(?prior.path, schema.text(?route.path)) || schema.text_equals(?prior.path, "/**"))) {
                diagnose(diagnostics, schema.UNREACHABLE, "validation", schema.text(?route.path), "route is shadowed by an earlier route");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.service_count) {
        val service: *schema.Service = ?graph.services[i];
        if (service.target.len == 0) {
            diagnose(diagnostics, schema.MISSING_FIELD, "validation", schema.text(?service.name), "service target is required");
        }
        if (service.kind == schema.SERVICE_PROXY && !graph.features.proxy) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?service.name), "proxy service requires server.features.proxy");
        }
        if (service.budget.len > 0 && schema.find_budget(graph, schema.text(?service.budget)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?service.budget), "service references an unknown budget");
        }
        if (service.secret.len > 0 && schema.find_secret(graph, schema.text(?service.secret)) == nil) {
            diagnose(diagnostics, schema.UNRESOLVED_REFERENCE, "validation", schema.text(?service.secret), "service references an unknown secret");
        }
        i = i + 1;
    }
    i = 0;
    for (i < graph.secret_count) {
        val secret: *schema.Secret = ?graph.secrets[i];
        val provider: str = schema.text(?secret.provider);
        if (str_equals(provider, "env") && !capabilities.environment_secrets) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?secret.name), "environment secret provider is unavailable");
        } or (str_equals(provider, "file") && !capabilities.file_secrets) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?secret.name), "file secret provider is unavailable");
        } or (str_equals(provider, "os") && !capabilities.os_secrets) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?secret.name), "operating-system secret provider is unavailable");
        } or (str_equals(provider, "application") && !capabilities.application_secrets) {
            diagnose(diagnostics, schema.UNSUPPORTED, "validation", schema.text(?secret.name), "application secret provider is unavailable");
        } or (!str_equals(provider, "env") && !str_equals(provider, "file") && !str_equals(provider, "os") && !str_equals(provider, "application")) {
            diagnose(diagnostics, schema.INVALID_VALUE, "validation", schema.text(?secret.name), "unknown secret provider");
        }
        i = i + 1;
    }
    if ((graph.telemetry.metrics || graph.telemetry.traces) && graph.telemetry.endpoint.len == 0) {
        diagnose(diagnostics, schema.MISSING_FIELD, "validation", "telemetry.endpoint", "enabled remote telemetry requires an endpoint");
    }
    ret diagnostics.error_count == 0;
}

pub fun build(
    graph: *schema.Graph,
    diagnostics: *schema.Diagnostics,
    a: *allocator.Allocator,
    source_name: str,
    source: str,
    resolver: *Resolver,
    capabilities: Capabilities,
) bool {
    if (graph == nil || diagnostics == nil || a == nil || source == nil) { ret false; }
    schema.reset_graph(graph);
    schema.reset_diagnostics(diagnostics);
    var workspace: Workspace;
    workspace.depth = 0;
    process_source(graph, diagnostics, a, source_name, source, resolver, ?workspace);
    ret validate(graph, capabilities, diagnostics);
}

fun test_resolve(context: ptr, name: str, output: *u8, capacity: usize) i64 {
    if (!str_equals(name, "HOST")) { ret -1; }
    val value: str = "example.com";
    val n: usize = str_len(value);
    if (capacity > n) {
        var i: usize = 0;
        for (i < n) { output[i] = value[i]; i = i + 1; }
        output[n] = 0;
    }
    ret n::i64;
}

fun test_include(context: ptr, name: str, output: *u8, capacity: usize) i64 {
    if (!str_equals(name, "base.toml")) { ret -1; }
    val content: str = "[server]\nname = \"included\"\n\n[[listener]]\nname = \"local\"\naddress = \":8080\"\nprotocols = [\"http/1.1\"]\n\n[host.local]\nlistener = \"local\"\n\n[service.health]\nkind = \"fixed\"\nbody = \"ok\"\n\n[[route]]\nname = \"health\"\nhost = \"local\"\npath = \"/health\"\nservice = \"health\"\n";
    val n: usize = str_len(content);
    if (capacity > n) {
        var i: usize = 0;
        for (i < n) { output[i] = content[i]; i = i + 1; }
        output[n] = 0;
    }
    ret n::i64;
}

test "config loader: complete graph is parsed and resolved" {
    var memory: [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph: schema.Graph;
    var diagnostics: schema.Diagnostics;
    var resolver: Resolver = Resolver{context: nil, include: (0::usize)::ResolveFun, environment: test_resolve};
    val source: str = "[server]\nname = \"site\"\n\n[[listener]]\nname = \"public\"\naddress = \"[::]:443\"\ntransport = \"tcp\"\nprotocols = [\"http/1.1\", \"h2\"]\ntls = \"public\"\n\n[tls.public]\ncertificate = \"secret:cert\"\n\n[host.site]\nlistener = \"public\"\nserver_name = \"${ENV:HOST}\"\n\n[[route]]\nname = \"root\"\nhost = \"site\"\npath = \"/**\"\nservice = \"app\"\n\n[service.app]\nkind = \"laurel\"\napplication = \"site\"\n";
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    if (!build(?graph, ?diagnostics, ?a, "hedge.toml", source, ?resolver, capabilities)) { ret 1; }
    if (graph.listener_count != 1 || graph.host_count != 1 || graph.route_count != 1 || graph.service_count != 1) { ret 2; }
    if (graph.hosts[0].server_name_count != 1 || !schema.text_equals(?graph.hosts[0].server_names[0], "example.com")) { ret 3; }
    ret 0;
}

test "config loader: unknown and unreachable configuration is rejected" {
    var memory: [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph: schema.Graph;
    var diagnostics: schema.Diagnostics;
    val source: str = "[server]\nname = \"site\"\nlegacy = true\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.app]\nkind = \"fixed\"\nbody = \"ok\"\n\n[[route]]\nname = \"all\"\nhost = \"site\"\npath = \"/**\"\nservice = \"app\"\n\n[[route]]\nname = \"shadowed\"\nhost = \"site\"\npath = \"/admin\"\nservice = \"app\"\n";
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    if (build(?graph, ?diagnostics, ?a, "bad.toml", source, nil, capabilities)) { ret 1; }
    var saw_unknown: bool = false;
    var saw_unreachable: bool = false;
    var i: usize = 0;
    for (i < diagnostics.count) {
        if (diagnostics.items[i].code == schema.UNKNOWN_FIELD) { saw_unknown = true; }
        if (diagnostics.items[i].code == schema.UNREACHABLE) { saw_unreachable = true; }
        i = i + 1;
    }
    if (!saw_unknown || !saw_unreachable) { ret 2; }
    ret 0;
}

test "config loader: includes resolve before validation" {
    var memory: [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph: schema.Graph;
    var diagnostics: schema.Diagnostics;
    var resolver: Resolver = Resolver{context: nil, include: test_include, environment: (0::usize)::ResolveFun};
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    if (!build(?graph, ?diagnostics, ?a, "root.toml", "include = [\"base.toml\"]\n", ?resolver, capabilities)) { ret 1; }
    if (!schema.text_equals(?graph.server_name, "included") || graph.route_count != 1) { ret 2; }
    ret 0;
}

test "config loader: section type errors are explicit" {
    var memory: [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a: allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph: schema.Graph;
    var diagnostics: schema.Diagnostics;
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    if (build(?graph, ?diagnostics, ?a, "wrong.toml", "server = \"wrong\"\n", nil, capabilities)) { ret 1; }
    var i: usize = 0;
    for (i < diagnostics.count) {
        if (diagnostics.items[i].code == schema.WRONG_TYPE) { ret 0; }
        i = i + 1;
    }
    ret 2;
}
