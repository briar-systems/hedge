        local_transport: true, environment_secrets: true, file_secrets: true,
        os_secrets:      true, application_secrets: true};
    val source: str = "[server]\nname = \"trace-propagation\"\n\n[telemetry]\nlogs = false\ntraces = true\ntrace_state_bytes = 512\n";
    if (!build(?graph, ?diagnostics, ?a, "trace-propagation.toml", source,
        nil, capabilities)
        || !graph.telemetry.traces || diagnostics.error_count != 0) { ret 1; }
