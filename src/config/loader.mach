}

test "config loader: timeouts must fit the runtime nanosecond clock" {
    var memory:      [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a:           allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph:        schema.Graph;
    var diagnostics:  schema.Diagnostics;
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    val source:       str          = "[server]\nname = \"timeout-bounds\"\n\n[server.timeouts]\ndrain_ms = 9223372036855\n\n[budget.api]\ntimeout_ms = 9223372036855\n";
    if (build(?graph, ?diagnostics, ?a, "timeouts.toml", source, nil,
        capabilities)) { ret 1; }
    var resource_errors: usize = 0;
    var i:               usize = 0;
    for (i < diagnostics.count) {
        if (diagnostics.items[i].code == schema.RESOURCE_LIMIT) {
            resource_errors = resource_errors + 1;
        }
        i = i + 1;
    }
    if (resource_errors != 2) { ret 2; }
    ret 0;
}

fun saw_code(diagnostics: *schema.Diagnostics, code: schema.DiagnosticCode) bool {
    var i: usize = 0;
    for (i < diagnostics.count) {
        if (diagnostics.items[i].code == code) { ret true; }
        i = i + 1;
    }
    ret false;
}

val ACME_VALID: str = "[server]\nname = \"site\"\n\n[server.features]\nacme = true\n\n[[listener]]\nname = \"public\"\naddress = \":443\"\nprotocols = [\"http/1.1\"]\ntls = \"public\"\n\n[tls.public]\nidentity = [{ server_name = \"site.example\", certificate = \"site.pem\", key = \"site.key\" }]\ndefault = \"site.example\"\n\n[host.site]\nlistener = \"public\"\n\n[service.challenge]\nkind = \"native\"\ntarget = \"acme-challenge\"\n\n[[route]]\nname = \"acme\"\nhost = \"site\"\npath = \"/.well-known/acme-challenge/**\"\nservice = \"challenge\"\n\n[acme]\ndirectory = \"https://acme.example/dir\"\ntrust = \"/etc/ssl/certs/ca-certificates.crt\"\nstorage = \"/var/lib/hedge/acme\"\nlistener = \"public\"\ncontact = \"mailto:ops@example.com\"\nterms_agreed = true\nchallenge = \"http-01\"\nnames = [\"site.example\", \"www.site.example\"]\n";

test "config loader: an acme section is parsed and bounded" {
    var memory:      [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a:           allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph:        schema.Graph;
    var diagnostics:  schema.Diagnostics;
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    if (!build(?graph, ?diagnostics, ?a, "hedge.toml", ACME_VALID, nil, capabilities)) { ret 1; }
    if (!graph.acme.enabled || !graph.features.acme)                                   { ret 2; }
    if (!schema.text_equals(?graph.acme.directory, "https://acme.example/dir"))        { ret 3; }
    if (!schema.text_equals(?graph.acme.storage, "/var/lib/hedge/acme"))               { ret 4; }
    if (!schema.text_equals(?graph.acme.trust,
        "/etc/ssl/certs/ca-certificates.crt")) { ret 5; }
    if (!schema.text_equals(?graph.acme.listener, "public")) { ret 6; }
    if (graph.acme.challenge != schema.CHALLENGE_HTTP_01)    { ret 7; }
    if (!graph.acme.terms_agreed)                            { ret 8; }
    if (graph.acme.name_count != 2
        || !schema.text_equals(?graph.acme.names[0], "site.example")
        || !schema.text_equals(?graph.acme.names[1], "www.site.example")) { ret 9; }
    if (graph.acme.renew_before_seconds != 2592000) { ret 10; }
    schema.reset_diagnostics(?diagnostics);
    graph.acme.challenge = parse_challenge("tls-alpn-01", ?diagnostics,
        "hedge.toml");
    if (graph.acme.challenge != schema.CHALLENGE_TLS_ALPN_01
        || !validate(?graph, capabilities, ?diagnostics)) { ret 11; }
    schema.set_text(?graph.acme.origin, "127.0.0.1:14001");
    schema.reset_diagnostics(?diagnostics);
    if (validate(?graph, capabilities, ?diagnostics)
        || !saw_code(?diagnostics, schema.CONFLICT)) { ret 12; }
    ret 0;
}

test "config loader: acme that cannot obtain a certificate fails to load" {
    var memory:      [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a:           allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph:        schema.Graph;
    var diagnostics:  schema.Diagnostics;
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    # a cleartext directory is refused: rfc 8555 urls are https
    val cleartext: str = "[server]\nname = \"site\"\n\n[server.features]\nacme = true\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.challenge]\nkind = \"native\"\ntarget = \"acme-challenge\"\n\n[[route]]\nname = \"acme\"\nhost = \"site\"\npath = \"/**\"\nservice = \"challenge\"\n\n[acme]\ndirectory = \"http://acme.example/dir\"\nstorage = \"/tmp/acme\"\nnames = [\"site.example\"]\n";
    if (build(?graph, ?diagnostics, ?a, "bad.toml", cleartext, nil, capabilities)) { ret 1; }
    if (!saw_code(?diagnostics, schema.INVALID_VALUE))                             { ret 2; }

    # http-01 with nothing configured to answer it is unreachable
    val unanswerable: str = "[server]\nname = \"site\"\n\n[server.features]\nacme = true\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.app]\nkind = \"fixed\"\nbody = \"ok\"\n\n[[route]]\nname = \"all\"\nhost = \"site\"\npath = \"/**\"\nservice = \"app\"\n\n[acme]\ndirectory = \"https://acme.example/dir\"\nstorage = \"/tmp/acme\"\nnames = [\"site.example\"]\n";
    if (build(?graph, ?diagnostics, ?a, "bad.toml", unanswerable, nil, capabilities)) { ret 3; }
    if (!saw_code(?diagnostics, schema.UNREACHABLE))                                  { ret 4; }
    if (!saw_code(?diagnostics, schema.MISSING_FIELD))                                { ret 13; }

    # a challenge type this build cannot answer is refused before listeners
    val unsupported: str = "[server]\nname = \"site\"\n\n[server.features]\nacme = true\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.challenge]\nkind = \"native\"\ntarget = \"acme-challenge\"\n\n[[route]]\nname = \"acme\"\nhost = \"site\"\npath = \"/**\"\nservice = \"challenge\"\n\n[acme]\ndirectory = \"https://acme.example/dir\"\nstorage = \"/tmp/acme\"\nchallenge = \"dns-01\"\nnames = [\"site.example\"]\n";
    if (build(?graph, ?diagnostics, ?a, "bad.toml", unsupported, nil, capabilities)) { ret 5; }
    if (!saw_code(?diagnostics, schema.UNSUPPORTED))                                 { ret 6; }

    # the feature flag and the section must agree in both directions
    val featureless: str = "[server]\nname = \"site\"\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.challenge]\nkind = \"native\"\ntarget = \"acme-challenge\"\n\n[[route]]\nname = \"acme\"\nhost = \"site\"\npath = \"/**\"\nservice = \"challenge\"\n\n[acme]\ndirectory = \"https://acme.example/dir\"\nstorage = \"/tmp/acme\"\nnames = [\"site.example\"]\n";
    if (build(?graph, ?diagnostics, ?a, "bad.toml", featureless, nil, capabilities)) { ret 7; }
    if (!saw_code(?diagnostics, schema.UNSUPPORTED))                                 { ret 8; }

    # an enabled feature with no section is a configuration that silently
    # renews nothing
    val sectionless: str = "[server]\nname = \"site\"\n\n[server.features]\nacme = true\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.app]\nkind = \"fixed\"\nbody = \"ok\"\n\n[[route]]\nname = \"all\"\nhost = \"site\"\npath = \"/**\"\nservice = \"app\"\n";
    if (build(?graph, ?diagnostics, ?a, "bad.toml", sectionless, nil, capabilities)) { ret 9; }
    if (!saw_code(?diagnostics, schema.CONFLICT))                                    { ret 10; }

    # a renewal lead the scheduler would refuse is refused at load
    val lead: str = "[server]\nname = \"site\"\n\n[server.features]\nacme = true\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\n\n[service.challenge]\nkind = \"native\"\ntarget = \"acme-challenge\"\n\n[[route]]\nname = \"acme\"\nhost = \"site\"\npath = \"/**\"\nservice = \"challenge\"\n\n[acme]\ndirectory = \"https://acme.example/dir\"\nstorage = \"/tmp/acme\"\nrenew_before = 99999999\nnames = [\"site.example\"]\n";
    if (build(?graph, ?diagnostics, ?a, "bad.toml", lead, nil, capabilities)) { ret 11; }
    if (!saw_code(?diagnostics, schema.INVALID_VALUE))                        { ret 12; }
    ret 0;
}

test "config loader: a host names itself once, several times, or by its own key" {
    var memory:      [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a:           allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph:        schema.Graph;
    var diagnostics:  schema.Diagnostics;
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    val source:       str          = "[server]\nname = \"site\"\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.many]\nlistener = \"public\"\nnames = [\"a.example.com\", \"b.example.com\", \"*.c.example.com\"]\n\n[host.one]\nlistener = \"public\"\nserver_name = \"single.example.com\"\n\n[host.implied]\nlistener = \"public\"\n\n[service.app]\nkind = \"fixed\"\nbody = \"ok\"\n\n[[route]]\nname = \"a\"\nhost = \"many\"\npath = \"/**\"\nservice = \"app\"\n\n[[route]]\nname = \"b\"\nhost = \"one\"\npath = \"/**\"\nservice = \"app\"\n\n[[route]]\nname = \"c\"\nhost = \"implied\"\npath = \"/**\"\nservice = \"app\"\n";
    if (!build(?graph, ?diagnostics, ?a, "hosts.toml", source, nil, capabilities)) { ret 1; }
    if (graph.host_count != 3)                                                     { ret 2; }
    # the array form keeps every name, in the order written, which is the form
    # dispatch expands into one routing pattern each
    if (graph.hosts[0].server_name_count != 3) { ret 3; }
    if (!schema.text_equals(?graph.hosts[0].server_names[0], "a.example.com")
        || !schema.text_equals(?graph.hosts[0].server_names[1], "b.example.com")
        || !schema.text_equals(?graph.hosts[0].server_names[2], "*.c.example.com")) { ret 4; }
    if (graph.hosts[1].server_name_count != 1
        || !schema.text_equals(?graph.hosts[1].server_names[0], "single.example.com")) { ret 5; }
    # a host that names itself neither way answers to its own block key
    if (graph.hosts[2].server_name_count != 1
        || !schema.text_equals(?graph.hosts[2].server_names[0], "implied")) { ret 6; }
    ret 0;
}

test "config loader: a host cannot name itself both ways at once" {
    var memory:      [1048576]u8;
    var fixed_state: fixed.FixedState;
    var a:           allocator.Allocator;
    fixed.make(?a, ?fixed_state, ?memory[0], 1048576);
    var graph:        schema.Graph;
    var diagnostics:  schema.Diagnostics;
    val capabilities: Capabilities = Capabilities{quic: true, local_transport: true, environment_secrets: true, file_secrets: true, os_secrets: true, application_secrets: true};
    val source:       str          = "[server]\nname = \"site\"\n\n[[listener]]\nname = \"public\"\naddress = \":80\"\nprotocols = [\"http/1.1\"]\n\n[host.site]\nlistener = \"public\"\nserver_name = \"a.example.com\"\nnames = [\"b.example.com\"]\n\n[service.app]\nkind = \"fixed\"\nbody = \"ok\"\n\n[[route]]\nname = \"root\"\nhost = \"site\"\npath = \"/**\"\nservice = \"app\"\n";
    if (build(?graph, ?diagnostics, ?a, "hosts.toml", source, nil, capabilities)) { ret 1; }
    var saw_conflict: bool  = false;
    var i:            usize = 0;
    for (i < diagnostics.count) {
        if (diagnostics.items[i].code == schema.CONFLICT) { saw_conflict = true; }
        i = i + 1;
    }
    if (!saw_conflict) { ret 2; }
    ret 0;
}
