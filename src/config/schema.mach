# bounded typed configuration graph and diagnostics

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

pub val TEXT_CAP:        usize = 256;
pub val MAX_DIAGNOSTICS: usize = 64;
pub val MAX_LISTENERS:   usize = 16;
# a QUIC socket asks for these when its listener does not say. the kernel
# default overflows under a handshake burst.
pub val DEFAULT_QUIC_RECEIVE_BUFFER: usize = 4194304;
pub val DEFAULT_QUIC_SEND_BUFFER:    usize = 1048576;
# the Retry nonces a QUIC listener remembers to refuse a replayed token. each
# costs a slot, an index entry and an expiry entry in mach-quic's store, and a
# nonce lives for the Retry token age, so this bounds both the store's memory
# and the Retry rate it can prove unreplayed
pub val DEFAULT_QUIC_RETRY_REPLAY: usize = 65536;
# socket buffer sizes are a native int
pub val MAX_SOCKET_BUFFER: usize = 2147483647;
# a listener carries at most one policy, so the policy table never needs to be
# wider than the listener table
pub val MAX_TLS_POLICIES:   usize = 16;
pub val MAX_TLS_IDENTITIES: usize = 8;
pub val MAX_TRUSTED_PEERS:  usize = 4;
pub val MAX_ACME_NAMES:     usize = 8;
pub val MAX_HOSTS:          usize = 64;
pub val MAX_HOST_NAMES:     usize = 16;
pub val MAX_ROUTES:         usize = 256;
pub val MAX_SERVICES:       usize = 64;
pub val MAX_BUDGETS:        usize = 64;
pub val MAX_SECRETS:        usize = 64;
pub val MIN_METRIC_SERIES:  usize = 38;
# work that names no budget is unbudgeted, not budgeted at zero
pub val NO_BUDGET_INDEX: usize = 0xffffffffffffffff;

pub def Severity: u8;
pub val WARNING: Severity = 1;
pub val ERROR:   Severity = 2;

pub def DiagnosticCode: u16;
pub val UNKNOWN_FIELD:        DiagnosticCode = 1;
pub val DEPRECATED_FIELD:     DiagnosticCode = 2;
pub val MISSING_FIELD:        DiagnosticCode = 3;
pub val WRONG_TYPE:           DiagnosticCode = 4;
pub val INVALID_VALUE:        DiagnosticCode = 5;
pub val DUPLICATE_NAME:       DiagnosticCode = 6;
pub val CONFLICT:             DiagnosticCode = 7;
pub val UNREACHABLE:          DiagnosticCode = 8;
pub val UNSUPPORTED:          DiagnosticCode = 9;
pub val UNRESOLVED_REFERENCE: DiagnosticCode = 10;
pub val RESOURCE_LIMIT:       DiagnosticCode = 11;
pub val INCLUDE_CYCLE:        DiagnosticCode = 12;
pub val SOURCE_ERROR:         DiagnosticCode = 13;

pub rec Text {
    data: [TEXT_CAP]u8;
    len:  usize;
}

pub fun clear_text(text: *Text) {
    text.len     = 0;
    text.data[0] = 0;
}

pub fun set_text(text: *Text, value: str) bool {
    if (text == nil) { ret false; }
    val n: usize = str_len(value);
    if (n >= TEXT_CAP) {
        clear_text(text);
        ret false;
    }
    var i: usize = 0;
    for (i < n) {
        text.data[i] = value[i];
        i            = i + 1;
    }
    text.data[n] = 0;
    text.len     = n;
    ret true;
}

pub fun text(text: *Text) str {
    if (text == nil) { ret nil; }
    ret (?text.data[0])::str;
}

pub fun text_equals(a: *Text, b: str) bool {
    if (a == nil) { ret b == nil || b[0] == 0; }
    ret str_equals(text(a), b);
}

pub rec Diagnostic {
    severity: Severity;
    code:     DiagnosticCode;
    source:   Text;
    path:     Text;
    message:  Text;
}

pub rec Diagnostics {
    count:       usize;
    error_count: usize;
    truncated:   bool;
    items:       [MAX_DIAGNOSTICS]Diagnostic;
}

pub fun reset_diagnostics(diagnostics: *Diagnostics) {
    diagnostics.count       = 0;
    diagnostics.error_count = 0;
    diagnostics.truncated   = false;
}

pub fun add_diagnostic(
    diagnostics: *Diagnostics,
    severity: Severity,
    code: DiagnosticCode,
    source: str,
    path: str,
    message: str,
) bool {
    if (diagnostics == nil) { ret false; }
    if (severity == ERROR)  { diagnostics.error_count = diagnostics.error_count + 1; }
    if (diagnostics.count >= MAX_DIAGNOSTICS) {
        diagnostics.truncated = true;
        ret false;
    }
    val item: *Diagnostic = ?diagnostics.items[diagnostics.count];
    diagnostics.count = diagnostics.count + 1;
    item.severity     = severity;
    item.code         = code;
    set_text(?item.source, source);
    set_text(?item.path, path);
    set_text(?item.message, message);
    ret true;
}

pub val PROTOCOL_HTTP1: u8 = 1;
pub val PROTOCOL_HTTP2: u8 = 2;
pub val PROTOCOL_HTTP3: u8 = 4;

pub val PROXY_OFF:      u8 = 0;
pub val PROXY_OPTIONAL: u8 = 1;
pub val PROXY_REQUIRED: u8 = 2;

pub val TRANSPORT_TCP:   u8 = 1;
pub val TRANSPORT_QUIC:  u8 = 2;
pub val TRANSPORT_LOCAL: u8 = 3;

pub val SERVICE_STATIC:   u8 = 1;
pub val SERVICE_PROXY:    u8 = 2;
pub val SERVICE_LAUREL:   u8 = 3;
pub val SERVICE_FIXED:    u8 = 4;
pub val SERVICE_REDIRECT: u8 = 5;
pub val SERVICE_NATIVE:   u8 = 6;

# an absent connection limit is no cap: connection storage grows with what is
# connected, on every transport
pub rec Limits {
    max_connections:          opt[usize];
    max_connections_per_peer: opt[usize];
    # QUIC connections admitted but not yet established, past which a token
    # Initial waits in the pending queue. always set: a fixed default, never
    # a value measured on the machine at startup
    max_handshakes:          usize;
    max_handshakes_per_peer: opt[usize];
    max_header_bytes:        usize;
    max_header_count:        usize;
    max_body_bytes:          usize;
    max_pipeline_depth:      usize;
    call_memory_bytes:       usize;
    # zero until the loader derives it (hedge.config.lanes)
    memory_bytes:            usize;
    connection_memory_bytes: usize;
}

# a request's memory is claimed in chunks of at least this size, so a smaller
# bound could never admit one. hedge.storage.MIN_CHUNK must equal it.
pub val DEFAULT_MAX_HANDSHAKES: usize = 256;

pub val MIN_CALL_MEMORY_BYTES:     usize = 16384;
pub val MAX_CALL_MEMORY_BYTES:     usize = 268435456;
pub val DEFAULT_CALL_MEMORY_BYTES: usize = 32768;

# fixed HTTP/1 connection storage has one slot per admitted pipeline member
pub val MAX_PIPELINE_DEPTH: usize = 2;

pub rec Timeouts {
    handshake_ms:  u64;
    header_ms:     u64;
    request_ms:    u64;
    write_ms:      u64;
    keep_alive_ms: u64;
    drain_ms:      u64;
    # how long a stop waits with no connection closing before it gives up and
    # names the ones still open (#273)
    stop_ms: u64;
}

# a stop gives up after this long with no connection closing. cancellation
# closes a connection in milliseconds, so this is far past any close that will
# finish
pub val DEFAULT_STOP_MS: u64 = 10000;

# the largest millisecond value that can be represented as signed nanoseconds
pub val MAX_TIMEOUT_MS: u64 = 9223372036854;

pub rec Features {
    http1: bool;
    http2: bool;
    http3: bool;
    tls:   bool;
    acme:  bool;
    proxy: bool;
    cache: bool;
}

pub rec Listener {
    name:               Text;
    address:            Text;
    transport:          u8;
    protocols:          u8;
    tls_policy:         Text;
    budget:             Text;
    backlog:            usize;
    accept_depth:       usize;
    proxy_protocol:     u8;
    trusted_peer_count: usize;
    trusted_peers:      [MAX_TRUSTED_PEERS]Text;
    # QUIC listeners only. absent asks for the DEFAULT_QUIC_ buffer sizes
    receive_buffer_bytes: opt[usize];
    send_buffer_bytes:    opt[usize];
    # QUIC listeners only. absent means DEFAULT_QUIC_RETRY_REPLAY
    max_retry_replay: opt[usize];
}

# one certificate and key served under one server name. an empty server name is
# the identity a client that sent no SNI reaches.
pub rec TlsIdentity {
    server_name: Text;
    certificate: Text;
    key:         Text;
}

pub def TlsReplayPolicy: u8;
pub val TLS_REPLAY_PERMISSIVE:           TlsReplayPolicy = 1;
pub val TLS_REPLAY_SINGLE_USE:           TlsReplayPolicy = 2;
pub val TLS_MAX_TICKET_LIFETIME_SECONDS: usize           = 604800;
pub val TLS_MAX_TICKETS_PER_CONNECTION:  usize           = 4;

pub rec TlsResumption {
    enabled:                    bool;
    key_lifetime_seconds:       u32;
    retirement_overlap_seconds: u32;
    ticket_lifetime_seconds:    u32;
    replay_policy:              TlsReplayPolicy;
    tickets_per_connection:     u8;
}

pub rec TlsPolicy {
    name:           Text;
    identity_count: usize;
    identities:     [MAX_TLS_IDENTITIES]TlsIdentity;
    # empty means an unmatched server name is refused rather than served
    # somebody else's certificate
    default_name: Text;
    has_default:  bool;
    client_auth:  bool;
    client_trust: Text;
    resumption:   TlsResumption;
}

pub fun find_identity(policy: *TlsPolicy, name: str) *TlsIdentity {
    if (policy == nil) { ret nil; }
    var i: usize = 0;
    for (i < policy.identity_count) {
        if (text_equals(?policy.identities[i].server_name, name)) {
            ret ?policy.identities[i];
        }
        i = i + 1;
    }
    ret nil;
}

pub rec Host {
    name:              Text;
    listener:          Text;
    budget:            Text;
    server_name_count: usize;
    server_names:      [MAX_HOST_NAMES]Text;
}

pub rec Route {
    name:    Text;
    host:    Text;
    path:    Text;
    service: Text;
    budget:  Text;
}

pub rec Service {
    name:          Text;
    kind:          u8;
    target:        Text;
    budget:        Text;
    status:        u16;
    content_type:  Text;
    index:         Text;
    precompressed: bool;
    cache:         bool;
    # zero inherits the application's declared bound, then the server's
    memory_bytes: usize;
}

pub rec Budget {
    name:         Text;
    concurrency:  usize;
    queue:        usize;
    timeout_ms:   u64;
    memory_bytes: usize;
}

pub rec Secret {
    name:     Text;
    provider: Text;
    key:      Text;
}

pub rec Telemetry {
    logs:              bool;
    metrics:           bool;
    traces:            bool;
    log_record_bytes:  usize;
    log_queue_depth:   usize;
    metric_series:     usize;
    trace_state_bytes: usize;
}

pub rec Cache {
    enabled:           bool;
    memory_bytes:      usize;
    disk_bytes:        usize;
    disk_root:         Text;
    max_entry_bytes:   usize;
    entries:           usize;
    heuristic_percent: u64;
}

# the native service family. a native service names its member in its target,
# so a second one is a new name rather than a new kind.
pub val NATIVE_ACME_CHALLENGE: str = "acme-challenge";

# rfc 8555 challenge types, as a deployment selects them
pub val CHALLENGE_HTTP_01:     u8 = 1;
pub val CHALLENGE_DNS_01:      u8 = 2;
pub val CHALLENGE_TLS_ALPN_01: u8 = 3;

# automatic certificate management for one set of names. one account and one
# certificate covering every configured name is the whole of it: a second
# independent certificate needs its own durable record, which is a bound the
# durable format states rather than one this record hides.
pub rec Acme {
    enabled:              bool;
    directory:            Text;
    contact:              Text;
    storage:              Text;
    origin:               Text;
    trust:                Text;
    listener:             Text;
    terms_agreed:         bool;
    challenge:            u8;
    renew_before_seconds: u64;
    name_count:           usize;
    names:                [MAX_ACME_NAMES]Text;
}

pub rec Admin {
    enabled:            bool;
    listener:           Text;
    auth_secret:        Text;
    max_response_bytes: usize;
}

pub rec Graph {
    server_name:      Text;
    limits:           Limits;
    timeouts:         Timeouts;
    features:         Features;
    listener_count:   usize;
    listeners:        [MAX_LISTENERS]Listener;
    tls_policy_count: usize;
    tls_policies:     [MAX_TLS_POLICIES]TlsPolicy;
    host_count:       usize;
    hosts:            [MAX_HOSTS]Host;
    route_count:      usize;
    routes:           [MAX_ROUTES]Route;
    service_count:    usize;
    services:         [MAX_SERVICES]Service;
    budget_count:     usize;
    budgets:          [MAX_BUDGETS]Budget;
    secret_count:     usize;
    secrets:          [MAX_SECRETS]Secret;
    telemetry:        Telemetry;
    cache:            Cache;
    acme:             Acme;
    admin:            Admin;
}

pub fun reset_graph(graph: *Graph) {
    clear_text(?graph.server_name);
    graph.limits.max_connections          = opt[usize].none{};
    graph.limits.max_connections_per_peer = opt[usize].some{100};
    graph.limits.max_handshakes           = DEFAULT_MAX_HANDSHAKES;
    graph.limits.max_handshakes_per_peer  = opt[usize].none{};
    graph.limits.max_header_bytes         = 32768;
    graph.limits.max_header_count         = 128;
    graph.limits.max_body_bytes           = 16777216;
    graph.limits.max_pipeline_depth       = MAX_PIPELINE_DEPTH;
    graph.limits.call_memory_bytes        = DEFAULT_CALL_MEMORY_BYTES;
    graph.limits.memory_bytes             = 0;
    graph.limits.connection_memory_bytes  = 0;
    graph.timeouts.handshake_ms           = 10000;
    graph.timeouts.header_ms              = 10000;
    graph.timeouts.request_ms             = 30000;
    graph.timeouts.write_ms               = 30000;
    graph.timeouts.keep_alive_ms          = 75000;
    graph.timeouts.drain_ms               = 30000;
    graph.timeouts.stop_ms                = DEFAULT_STOP_MS;
    graph.features.http1                  = true;
    graph.features.http2                  = true;
    graph.features.http3                  = true;
    graph.features.tls                    = true;
    graph.features.acme                   = false;
    graph.features.proxy                  = false;
    graph.features.cache                  = false;
    graph.listener_count                  = 0;
    graph.tls_policy_count                = 0;
    graph.host_count                      = 0;
    graph.route_count                     = 0;
    graph.service_count                   = 0;
    graph.budget_count                    = 0;
    graph.secret_count                    = 0;
    graph.telemetry.logs                  = true;
    graph.telemetry.metrics               = false;
    graph.telemetry.traces                = false;
    graph.telemetry.log_record_bytes      = 2048;
    graph.telemetry.log_queue_depth       = 256;
    graph.telemetry.metric_series         = 1024;
    graph.telemetry.trace_state_bytes     = 512;
    graph.cache.enabled                   = false;
    graph.cache.memory_bytes              = 8388608;
    graph.cache.disk_bytes                = 0;
    clear_text(?graph.cache.disk_root);
    graph.cache.max_entry_bytes   = 1048576;
    graph.cache.entries           = 256;
    graph.cache.heuristic_percent = 0;
    graph.acme.enabled            = false;
    clear_text(?graph.acme.directory);
    clear_text(?graph.acme.contact);
    clear_text(?graph.acme.storage);
    clear_text(?graph.acme.origin);
    clear_text(?graph.acme.trust);
    clear_text(?graph.acme.listener);
    graph.acme.terms_agreed = false;
    graph.acme.challenge    = CHALLENGE_HTTP_01;
    # thirty days, matching the renewal policy a ninety-day certificate wants
    graph.acme.renew_before_seconds = 2592000;
    graph.acme.name_count           = 0;
    var acme_index: usize = 0;
    for (acme_index < MAX_ACME_NAMES) {
        clear_text(?graph.acme.names[acme_index]);
        acme_index = acme_index + 1;
    }
    graph.admin.enabled = false;
    clear_text(?graph.admin.listener);
    clear_text(?graph.admin.auth_secret);
    graph.admin.max_response_bytes = 8192;
}

pub fun find_listener(graph: *Graph, name: str) *Listener {
    var i: usize = 0;
    for (i < graph.listener_count) {
        if (text_equals(?graph.listeners[i].name, name)) { ret ?graph.listeners[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_tls_policy(graph: *Graph, name: str) *TlsPolicy {
    var i: usize = 0;
    for (i < graph.tls_policy_count) {
        if (text_equals(?graph.tls_policies[i].name, name)) { ret ?graph.tls_policies[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_host(graph: *Graph, name: str) *Host {
    var i: usize = 0;
    for (i < graph.host_count) {
        if (text_equals(?graph.hosts[i].name, name)) { ret ?graph.hosts[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_service(graph: *Graph, name: str) *Service {
    var i: usize = 0;
    for (i < graph.service_count) {
        if (text_equals(?graph.services[i].name, name)) { ret ?graph.services[i]; }
        i = i + 1;
    }
    ret nil;
}

# the index a budget occupies in the graph, which is the index the runtime's
# accounting set gives it. names are resolved once at compile and charged by
# index thereafter.
pub fun budget_index(graph: *Graph, name: str) usize {
    if (graph == nil || name == nil || name[0] == 0) { ret NO_BUDGET_INDEX; }
    var i: usize = 0;
    for (i < graph.budget_count) {
        if (text_equals(?graph.budgets[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret NO_BUDGET_INDEX;
}

pub fun find_budget(graph: *Graph, name: str) *Budget {
    var i: usize = 0;
    for (i < graph.budget_count) {
        if (text_equals(?graph.budgets[i].name, name)) { ret ?graph.budgets[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_secret(graph: *Graph, name: str) *Secret {
    var i: usize = 0;
    for (i < graph.secret_count) {
        if (text_equals(?graph.secrets[i].name, name)) { ret ?graph.secrets[i]; }
        i = i + 1;
    }
    ret nil;
}

test "config schema: text is bounded and terminated" {
    var value: Text;
    if (!set_text(?value, "public"))                      { ret 1; }
    if (value.len != 6 || !text_equals(?value, "public")) { ret 2; }
    ret 0;
}

test "config schema: diagnostics preserve structured cause" {
    var diagnostics: Diagnostics;
    reset_diagnostics(?diagnostics);
    add_diagnostic(?diagnostics, ERROR, UNKNOWN_FIELD, "hedge.toml", "server.legacy", "unknown field");
    if (diagnostics.count != 1 || diagnostics.error_count != 1)    { ret 1; }
    if (diagnostics.items[0].code != UNKNOWN_FIELD)                { ret 2; }
    if (!text_equals(?diagnostics.items[0].path, "server.legacy")) { ret 3; }
    ret 0;
}
