# the lane rule: how a connection's memory budget divides between its lanes
#
# the loader validates against it and the connection planes size their engines
# from it, so the two can never disagree about what one request set costs.

use hedge.config.schema;
use hedge.memory;
use hedge.protocol.h2;
use h3: hedge.protocol.h3.session;
use http.core.field;
use http.h1.parser;
use std.types.bool.bool;
use std.types.size.usize;

# hedge's own HTTP/1 parser bounds beside the configured ones
pub val LINE_BYTES:     usize = 4096;
pub val TRAILER_FIELDS: usize = 16;
pub val TRAILER_BYTES:  usize = 8192;
# a serialized response head
pub val SCRATCH_BYTES: usize = 16384;
# the read and write buffers of every engine a connection can run
pub val IO_BUDGET: usize = 65536;
# what an admitted connection must be able to hold to make any progress: one
# read and one write buffer
pub val RESERVE: usize = 16384;
# how many connections the global budget funds when no connection limit says
pub val DEFAULT_CONNECTIONS: usize = 256;

pub fun h1_limits(limits: *schema.Limits) parser.Limits {
    var parsing: parser.Limits = parser.limits_default();
    parsing.max_header_bytes  = limits.max_header_bytes;
    parsing.max_headers       = limits.max_header_count;
    parsing.max_body_bytes    = limits.max_body_bytes::u64;
    parsing.max_start_line    = LINE_BYTES;
    parsing.max_header_line   = LINE_BYTES;
    parsing.max_chunk_line    = LINE_BYTES;
    parsing.max_trailers      = TRAILER_FIELDS;
    parsing.max_trailer_bytes = TRAILER_BYTES;
    ret parsing;
}

# parsed target, field and trailer bytes of one request
pub fun h1_storage_bytes(parsing: parser.Limits) usize {
    ret parsing.max_target_bytes + parsing.max_header_bytes + parsing.max_trailer_bytes;
}

# what one HTTP/1 request slot borrows, all or nothing
pub fun h1_set_bytes(limits: *schema.Limits) usize {
    val parsing: parser.Limits = h1_limits(limits);
    ret LINE_BYTES + h1_storage_bytes(parsing)
        + (parsing.max_headers + parsing.max_trailers) * $size_of(field.Field)
        + SCRATCH_BYTES;
}

pub fun fixed_bytes() usize {
    ret memory.TLS_BUDGET + IO_BUDGET;
}

# the effective budgets, derived where the loader left them unset
pub fun connection_bytes(limits: *schema.Limits) usize {
    if (limits.connection_memory_bytes != 0) { ret limits.connection_memory_bytes; }
    ret default_connection_bytes(limits);
}

pub fun memory_bytes(limits: *schema.Limits) usize {
    if (limits.memory_bytes != 0) { ret limits.memory_bytes; }
    ret default_memory_bytes(limits);
}

pub fun budgets(limits: *schema.Limits) memory.Budgets {
    ret memory.connection_budgets(connection_bytes(limits), memory.TLS_BUDGET,
        IO_BUDGET, 0, 0, RESERVE);
}

# the largest per-stream on-demand footprint across every protocol hedge serves.
# a connection runs one protocol, and its request lane must fund max_pipeline_depth
# streams of whichever that is, so the budget is derived from the maximum footprint,
# never tuned. it moves whenever any protocol's set_bytes moves.
pub fun per_stream_bytes(limits: *schema.Limits) usize {
    var most:     usize = h1_set_bytes(limits);
    val h2_bytes: usize = h2.set_bytes();
    val h3_bytes: usize = h3.set_bytes();
    if (h2_bytes > most) { most = h2_bytes; }
    if (h3_bytes > most) { most = h3_bytes; }
    ret most;
}

pub fun default_connection_bytes(limits: *schema.Limits) usize {
    ret fixed_bytes() + limits.max_pipeline_depth * per_stream_bytes(limits);
}

pub fun default_memory_bytes(limits: *schema.Limits) usize {
    var connections: usize = DEFAULT_CONNECTIONS;
    if (sel limits.max_connections.some) { connections = limits.max_connections.some; }
    ret connections * connection_bytes(limits);
}

# whether one connection's budget funds its fixed lanes and a request set
pub fun funds_request(limits: *schema.Limits) bool {
    val fixed: usize = fixed_bytes();
    val total: usize = connection_bytes(limits);
    ret total >= fixed && total - fixed >= per_stream_bytes(limits);
}

test "lanes: the default connection budget funds every pipelined request" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    graph.limits.connection_memory_bytes = default_connection_bytes(?graph.limits);
    if (!funds_request(?graph.limits)) { ret 1; }
    val split: memory.Budgets = budgets(?graph.limits);
    if (memory.request_capacity(split, per_stream_bytes(?graph.limits))
        != graph.limits.max_pipeline_depth) { ret 2; }
    graph.limits.connection_memory_bytes = fixed_bytes();
    if (funds_request(?graph.limits)) { ret 3; }
    ret 0;
}

# the request-lane budget is derived, not tuned: it is max_pipeline_depth times
# the largest per-stream footprint across every protocol, so it can never
# advertise concurrency the request lane cannot fund.
test "lanes: the request-lane budget tracks the largest protocol footprint" {
    var graph: schema.Graph;
    schema.reset_graph(?graph);
    val h1_bytes: usize = h1_set_bytes(?graph.limits);
    val h2_bytes: usize = h2.set_bytes();
    val h3_bytes: usize = h3.set_bytes();
    val most:     usize = per_stream_bytes(?graph.limits);
    # the derived footprint funds each protocol on its own
    if (most < h1_bytes || most < h2_bytes || most < h3_bytes) { ret 1; }
    # and is exactly the maximum of them, never an independent number
    if (most != h1_bytes && most != h2_bytes && most != h3_bytes) { ret 2; }
    # HTTP/3 borrows the most on demand, so it is the binding footprint
    if (most != h3_bytes) { ret 3; }
    # the derived request lane is exactly max_pipeline_depth of that footprint
    graph.limits.connection_memory_bytes = default_connection_bytes(?graph.limits);
    val split: memory.Budgets = budgets(?graph.limits);
    if (split.lanes[memory.LANE_REQUEST::usize]
        != graph.limits.max_pipeline_depth * most) { ret 4; }
    ret 0;
}
