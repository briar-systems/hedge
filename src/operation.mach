# the routing contract between the listener plane and whatever submits on the
# worker's driver outside the listener's own accepts: a served connection, an
# upstream link, an acme exchange. each in-flight operation is bound to its
# owner and a settle callback, the listener routes the completion here by its
# context kind, and the owner settles its own transport. the listener stays
# ignorant of what any of them do.

use hedge.listener;
use io_error:   std.io.error;
use io_runtime: std.io.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

# each in-flight transport operation carries the owner it belongs to and the
# transport token that owner must settle when the completion arrives. the owner is
# not always a served connection: an upstream connection uses the same routing.
pub def SettleFun: fun(ptr, usize, io_runtime.Completion);

pub rec Operation {
    owner:         ptr;
    settle:        SettleFun;
    token_context: usize;
}

pub fun bind_operation(operation: *Operation, context: *listener.ConnectionContext,
    owner: ptr, settle: SettleFun, token_context: usize) bool {
    if (operation == nil || context == nil || owner == nil || settle::usize == 0) { ret false; }
    operation.owner         = owner;
    operation.settle        = settle;
    operation.token_context = token_context;
    ret listener.make_connection_context(context, (operation)::usize);
}

# the listener plane routes every connection-plane completion through here, and
# each owner settles its own transport
pub fun complete(context: ptr, owner_context: usize, completion: io_runtime.Completion) {
    val operation: *Operation = owner_context::*Operation;
    if (operation == nil || operation.settle::usize == 0) { ret; }
    operation.settle(operation.owner, operation.token_context, completion);
}

# routes one completion whose context is a bound connection context. a harness
# that owns a runtime without the listener plane dispatches through here.
pub fun deliver(completion: io_runtime.Completion) bool {
    if (completion.context == 0) { ret false; }
    val context: *listener.ConnectionContext = completion.context::*listener.ConnectionContext;
    if (!listener.is_connection_context(context)) { ret false; }
    complete(nil, context.owner_context, completion);
    ret true;
}

# one wait on a harness runtime, every completion delivered to its owner
pub fun pump(runtime: *io_runtime.Runtime, timeout_ms: i32) usize {
    var completions: [8]io_runtime.Completion;
    val waited:      res[usize, io_error.Error] = io_runtime.wait(runtime,
        ?completions[0], 8, timeout_ms);
    if (sel waited.err) { ret 0; }
    var i: usize = 0;
    for (i < waited.ok) {
        deliver(completions[i]);
        i = i + 1;
    }
    ret waited.ok;
}
