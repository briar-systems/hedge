# named resource budgets, charged before the work they pay for
#
# a budget in configuration carries four numbers: how much may run at once, how
# much may wait for a turn, how long a waiter may wait, and how many bytes the
# work may hold. Until now only the first meant anything, and only for
# listeners, so `queue`, `timeout_ms` and `memory_bytes` were validated and then
# ignored. This is the accounting layer that gives all four one meaning, in one
# place, so every seam that charges a budget charges it the same way.
#
# a charge is taken before the expensive allocation it authorises, and released
# exactly once. that ordering is the point: admitting work and then discovering
# there is no room for it is how a bounded system becomes an unbounded one.

use hedge.clock;
use hedge_wake: hedge.wake;
use A:          std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub val NO_BUDGET: usize = 0xffffffffffffffff;

pub def Outcome: u8;
# the work may start now
pub val ADMITTED: Outcome = 1;
# no room to run, but room to wait
pub val QUEUED: Outcome = 2;
# no room to run and no room to wait
pub val REFUSED: Outcome = 3;
# a queued charge waited longer than the budget allows
pub val EXPIRED: Outcome = 4;

pub rec Budget {
    # borrowed from the generation that defined it, which outlives every charge
    name: str;
    # zero means unbounded, which is what an unconfigured dimension means
    concurrency:  usize;
    queue:        usize;
    timeout_ns:   u64;
    memory_bytes: usize;
    active:       usize;
    waiting:      usize;
    memory_used:  usize;
    admitted:     u64;
    queued:       u64;
    refused:      u64;
    expired:      u64;
    live:         bool;
    # the queued charges in arrival order. a release admits from the head while
    # there is room, so a waiter never has to ask again to be let in
    head: *Charge;
    tail: *Charge;
}

pub rec Set {
    items:    *Budget;
    capacity: usize;
    count:    usize;
}

# what one charge holds. the holder returns this and nothing else, so a release
# cannot return more than was taken or credit the wrong budget.
#
# a queued charge is linked into its budget's queue, so it must not move or be
# copied until it is admitted, expires or is released
pub rec Charge {
    index:        usize;
    bytes:        usize;
    outcome:      Outcome;
    has_deadline: bool;
    deadline:     time.Instant;
    live:         bool;
    # woken when a release admits this charge. a holder that polls may leave it
    # empty and find the admission on its next retry
    waker: hedge_wake.Waker;
    next:  *Charge;
    prev:  *Charge;
}

# assigned by name: an empty record literal does not reliably clear its
# members. see briar-systems/mach#3108.
pub fun no_charge() Charge {
    var value: Charge;
    value.index        = NO_BUDGET;
    value.bytes        = 0;
    value.outcome      = REFUSED;
    value.has_deadline = false;
    value.deadline     = time.Instant{sec: 0, nsec: 0};
    value.live         = false;
    value.waker        = hedge_wake.no_waker();
    value.next         = nil;
    value.prev         = nil;
    ret value;
}

pub fun make(set: *Set, items: *Budget, capacity: usize) bool {
    if (set == nil || (capacity != 0 && items == nil)) { ret false; }
    set.items    = items;
    set.capacity = capacity;
    set.count    = 0;
    var i: usize = 0;
    for (i < capacity) {
        items[i].live = false;
        i             = i + 1;
    }
    ret true;
}

pub fun define(set: *Set, name: str, concurrency: usize, queue: usize,
    timeout_ns: u64, memory_bytes: usize) usize {
    if (set == nil || set.count >= set.capacity || name == nil) { ret NO_BUDGET; }
    val index: usize   = set.count;
    val value: *Budget = ?set.items[index];
    value.name         = name;
    value.concurrency  = concurrency;
    value.queue        = queue;
    value.timeout_ns   = timeout_ns;
    value.memory_bytes = memory_bytes;
    value.active       = 0;
    value.waiting      = 0;
    value.memory_used  = 0;
    value.admitted     = 0;
    value.queued       = 0;
    value.refused      = 0;
    value.expired      = 0;
    value.live         = true;
    value.head         = nil;
    value.tail         = nil;
    set.count          = index + 1;
    ret index;
}

pub fun find(set: *Set, name: str) usize {
    if (set == nil || name == nil || name[0] == 0) { ret NO_BUDGET; }
    var i: usize = 0;
    for (i < set.count) {
        if (set.items[i].live && str_equals(set.items[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret NO_BUDGET;
}

pub fun at(set: *Set, index: usize) *Budget {
    if (set == nil || index >= set.count || !set.items[index].live) { ret nil; }
    ret ?set.items[index];
}

fun room_to_run(value: *Budget, bytes: usize) bool {
    if (value.concurrency != 0 && value.active >= value.concurrency) { ret false; }
    if (value.memory_bytes == 0)                                     { ret true; }
    # a charge larger than the whole budget can never be admitted, and saying so
    # here is what stops it waiting for room that will never appear
    if (bytes > value.memory_bytes)             { ret false; }
    if (value.memory_used > value.memory_bytes) { ret false; }
    ret bytes <= value.memory_bytes - value.memory_used;
}

fun enqueue(value: *Budget, output: *Charge) {
    output.next = nil;
    output.prev = value.tail;
    if (value.tail != nil) { value.tail.next = output; }
    or                     { value.head = output; }
    value.tail = output;
}

fun dequeue(value: *Budget, output: *Charge) {
    if (output.prev != nil) { output.prev.next = output.next; }
    or                      { value.head = output.next; }
    if (output.next != nil) { output.next.prev = output.prev; }
    or                      { value.tail = output.prev; }
    output.next = nil;
    output.prev = nil;
    if (value.waiting > 0) { value.waiting = value.waiting - 1; }
}

# admit waiters in arrival order while there is room. the head that does not fit
# holds everyone behind it, so a small late charge cannot starve a large early one
fun admit_waiters(value: *Budget) {
    for (value.head != nil && room_to_run(value, value.head.bytes)) {
        val waiter: *Charge = value.head;
        dequeue(value, waiter);
        start(value, waiter, waiter.index, waiter.bytes);
        if (hedge_wake.valid(?waiter.waker)) { hedge_wake.wake(?waiter.waker); }
    }
}

fun start(value: *Budget, output: *Charge, index: usize, bytes: usize) Outcome {
    value.active        = value.active + 1;
    value.memory_used   = value.memory_used + bytes;
    value.admitted      = value.admitted + 1;
    output.index        = index;
    output.bytes        = bytes;
    output.outcome      = ADMITTED;
    output.has_deadline = false;
    output.live         = true;
    ret ADMITTED;
}

# take a charge against one budget
#
# an index of NO_BUDGET is unbudgeted work, which is admitted without accounting
# rather than refused: a seam with no budget configured is not a seam with a
# budget of zero.
pub fun charge(set: *Set, index: usize, bytes: usize, now: time.Instant,
    output: *Charge, waker: hedge_wake.Waker) Outcome {
    # a live charge may be linked into a queue, and overwriting it would corrupt
    # that queue
    if (output == nil || output.live) { ret REFUSED; }
    @output = no_charge();
    if (index == NO_BUDGET) {
        output.outcome = ADMITTED;
        output.live    = false;
        ret ADMITTED;
    }
    val value: *Budget = at(set, index);
    if (value == nil) { ret REFUSED; }
    if (value.head == nil && room_to_run(value, bytes)) {
        ret start(value, output, index, bytes);
    }
    # no room to run. a budget that permits waiting lets the caller hold a place
    # rather than refusing work that would have run a moment later.
    val oversized: bool = value.memory_bytes != 0 && bytes > value.memory_bytes;
    if (value.queue == 0 || value.waiting >= value.queue || oversized) {
        value.refused  = value.refused + 1;
        output.outcome = REFUSED;
        ret REFUSED;
    }
    value.waiting       = value.waiting + 1;
    value.queued        = value.queued + 1;
    output.index        = index;
    output.bytes        = bytes;
    output.outcome      = QUEUED;
    output.live         = true;
    output.has_deadline = value.timeout_ns != 0;
    output.waker        = waker;
    if (output.has_deadline) {
        output.deadline = clock.after(now, value.timeout_ns);
    }
    enqueue(value, output);
    ret QUEUED;
}

# where a queued charge stands now
#
# admission happens on release, so this only reports it. a waiter that has run
# out of time is refused rather than left in the queue, because a queue that
# never expires is a queue that grows.
pub fun retry(set: *Set, output: *Charge, now: time.Instant) Outcome {
    if (output == nil || !output.live) { ret REFUSED; }
    if (output.outcome == ADMITTED)    { ret ADMITTED; }
    if (output.outcome != QUEUED)      { ret REFUSED; }
    val value: *Budget = at(set, output.index);
    if (value == nil) { ret REFUSED; }
    if (output.has_deadline && !time.instant_before(now, output.deadline)) {
        dequeue(value, output);
        value.expired  = value.expired + 1;
        output.outcome = EXPIRED;
        output.live    = false;
        # an expiring head may have been all that held smaller waiters back
        admit_waiters(value);
        ret EXPIRED;
    }
    ret QUEUED;
}

# move a charge to storage that will not move, keeping its place in its queue.
# a charge is copied only this way, because a plain copy of a queued charge
# leaves the queue pointing at the old storage
pub fun relocate(set: *Set, target: *Charge, source: *Charge) {
    if (target == nil || source == nil || target == source) { ret; }
    @target     = @source;
    source.live = false;
    source.next = nil;
    source.prev = nil;
    if (!target.live || target.outcome != QUEUED) { ret; }
    val value: *Budget = at(set, target.index);
    if (value == nil)       { ret; }
    if (target.prev != nil) { target.prev.next = target; }
    or                      { value.head = target; }
    if (target.next != nil) { target.next.prev = target; }
    or                      { value.tail = target; }
}

pub fun deadline(charge: *Charge, output: *time.Instant) bool {
    if (charge == nil || output == nil || !charge.live
        || charge.outcome != QUEUED || !charge.has_deadline) { ret false; }
    @output = charge.deadline;
    ret true;
}

# return whatever the charge holds, exactly once
pub fun release(set: *Set, output: *Charge) bool {
    if (output == nil || !output.live) { ret false; }
    val value: *Budget = at(set, output.index);
    if (value == nil) { ret false; }
    if (output.outcome == QUEUED) {
        if (value.waiting == 0) { ret false; }
        dequeue(value, output);
        output.live = false;
        # a large head leaving can let smaller waiters behind it in
        admit_waiters(value);
        ret true;
    }
    if (output.outcome != ADMITTED || value.active == 0
        || value.memory_used < output.bytes) { ret false; }
    value.active      = value.active - 1;
    value.memory_used = value.memory_used - output.bytes;
    output.live       = false;
    admit_waiters(value);
    ret true;
}

pub rec Snapshot {
    active:      usize;
    waiting:     usize;
    memory_used: usize;
    admitted:    u64;
    queued:      u64;
    refused:     u64;
    expired:     u64;
}

pub fun snapshot(set: *Set, index: usize) Snapshot {
    var value: Snapshot;
    value.active      = 0;
    value.waiting     = 0;
    value.memory_used = 0;
    value.admitted    = 0;
    value.queued      = 0;
    value.refused     = 0;
    value.expired     = 0;
    val entry: *Budget = at(set, index);
    if (entry == nil) { ret value; }
    value.active      = entry.active;
    value.waiting     = entry.waiting;
    value.memory_used = entry.memory_used;
    value.admitted    = entry.admitted;
    value.queued      = entry.queued;
    value.refused     = entry.refused;
    value.expired     = entry.expired;
    ret value;
}

fun at_time(sec: i64) time.Instant {
    ret time.Instant{sec: sec, nsec: 0};
}

test "budget: work with no budget configured is admitted without accounting" {
    var items: [2]Budget;
    var set:   Set;
    if (!make(?set, ?items[0], 2)) { ret 1; }
    var held: Charge;
    if (charge(?set, NO_BUDGET, 4096, at_time(0), ?held, hedge_wake.no_waker()) != ADMITTED) { ret 2; }
    # nothing was charged, so nothing has to be returned
    if (held.live)            { ret 3; }
    if (release(?set, ?held)) { ret 4; }
    # an unconfigured seam is not a seam with a budget of zero
    if (set.count != 0) { ret 5; }
    ret 0;
}

test "budget: concurrency admits up to its bound and refuses past it" {
    var items: [2]Budget;
    var set:   Set;
    make(?set, ?items[0], 2);
    val index: usize = define(?set, "api", 2, 0, 0, 0);
    if (index == NO_BUDGET) { ret 1; }
    var first:  Charge;
    var second: Charge;
    var third:  Charge;
    if (charge(?set, index, 0, at_time(0), ?first, hedge_wake.no_waker()) != ADMITTED)  { ret 2; }
    if (charge(?set, index, 0, at_time(0), ?second, hedge_wake.no_waker()) != ADMITTED) { ret 3; }
    # no queue is configured, so the third is refused rather than made to wait
    if (charge(?set, index, 0, at_time(0), ?third, hedge_wake.no_waker()) != REFUSED) { ret 4; }
    if (snapshot(?set, index).active != 2)                                            { ret 5; }
    if (snapshot(?set, index).refused != 1)                                           { ret 6; }
    # releasing one makes room for exactly one more
    if (!release(?set, ?first))                                                        { ret 7; }
    if (charge(?set, index, 0, at_time(0), ?third, hedge_wake.no_waker()) != ADMITTED) { ret 8; }
    if (snapshot(?set, index).active != 2)                                             { ret 9; }
    # a charge cannot be returned twice
    if (release(?set, ?first))             { ret 10; }
    if (snapshot(?set, index).active != 2) { ret 11; }
    ret 0;
}

test "budget: a queue holds a place and the timeout ends the wait" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:   usize = define(?set, "app", 1, 1, 5000000000, 0);
    var running: Charge;
    var waiter:  Charge;
    var refused: Charge;
    if (charge(?set, index, 0, at_time(0), ?running, hedge_wake.no_waker()) != ADMITTED) { ret 1; }
    # no room to run, but room to wait
    if (charge(?set, index, 0, at_time(0), ?waiter, hedge_wake.no_waker()) != QUEUED) { ret 2; }
    if (!waiter.has_deadline)                                                         { ret 3; }
    var observed: time.Instant;
    if (!deadline(?waiter, ?observed)
        || !time.instant_equal(observed, at_time(5))) { ret 3; }
    # the queue is one deep, so the next is refused outright
    if (charge(?set, index, 0, at_time(0), ?refused, hedge_wake.no_waker()) != REFUSED) { ret 4; }
    if (snapshot(?set, index).waiting != 1)                                             { ret 5; }
    # still waiting, and still inside its deadline
    if (retry(?set, ?waiter, at_time(4)) != QUEUED) { ret 6; }
    # the running charge finishes, so the waiter runs
    release(?set, ?running);
    if (retry(?set, ?waiter, at_time(4)) != ADMITTED) { ret 7; }
    if (snapshot(?set, index).waiting != 0 || snapshot(?set, index).active != 1) {
        ret 8;
    }
    ret 0;
}

test "budget: a waiter that runs out of time is refused, not left queued" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:   usize = define(?set, "app", 1, 4, 3000000000, 0);
    var running: Charge;
    var waiter:  Charge;
    charge(?set, index, 0, at_time(0), ?running, hedge_wake.no_waker());
    if (charge(?set, index, 0, at_time(0), ?waiter, hedge_wake.no_waker()) != QUEUED) { ret 1; }
    if (retry(?set, ?waiter, at_time(2)) != QUEUED)                                   { ret 2; }
    # the deadline is 3; reaching it ends the wait
    if (retry(?set, ?waiter, at_time(3)) != EXPIRED) { ret 3; }
    # the place in the queue was given back, so the queue does not grow
    if (snapshot(?set, index).waiting != 0) { ret 4; }
    if (snapshot(?set, index).expired != 1) { ret 5; }
    # an expired charge holds nothing and cannot be retried into existence
    if (waiter.live)                                 { ret 6; }
    if (retry(?set, ?waiter, at_time(3)) != REFUSED) { ret 7; }
    ret 0;
}

test "budget: memory is charged before the work and returned exactly" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:  usize = define(?set, "cache", 0, 0, 0, 1000);
    var first:  Charge;
    var second: Charge;
    var third:  Charge;
    if (charge(?set, index, 600, at_time(0), ?first, hedge_wake.no_waker()) != ADMITTED)  { ret 1; }
    if (charge(?set, index, 400, at_time(0), ?second, hedge_wake.no_waker()) != ADMITTED) { ret 2; }
    if (snapshot(?set, index).memory_used != 1000)                                        { ret 3; }
    # the budget is exhausted by bytes even though concurrency is unbounded
    if (charge(?set, index, 1, at_time(0), ?third, hedge_wake.no_waker()) != REFUSED) { ret 4; }
    release(?set, ?second);
    if (snapshot(?set, index).memory_used != 600)                                        { ret 5; }
    if (charge(?set, index, 400, at_time(0), ?third, hedge_wake.no_waker()) != ADMITTED) { ret 6; }
    if (snapshot(?set, index).memory_used != 1000)                                       { ret 7; }
    ret 0;
}

test "budget: a charge larger than the whole budget never waits for room" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    # a generous queue, which must not be used to wait for room that cannot
    # appear however much else finishes
    val index:     usize = define(?set, "cache", 0, 8, 5000000000, 1000);
    var oversized: Charge;
    if (charge(?set, index, 1001, at_time(0), ?oversized, hedge_wake.no_waker()) != REFUSED) { ret 1; }
    if (snapshot(?set, index).waiting != 0)                                                  { ret 2; }
    if (snapshot(?set, index).queued != 0)                                                   { ret 3; }
    if (snapshot(?set, index).refused != 1)                                                  { ret 4; }
    ret 0;
}

test "budget: budgets are found by name and unknown names charge nothing" {
    var items: [2]Budget;
    var set:   Set;
    make(?set, ?items[0], 2);
    val api: usize = define(?set, "api", 1, 0, 0, 0);
    val app: usize = define(?set, "app", 1, 0, 0, 0);
    if (api == app)                                           { ret 1; }
    if (find(?set, "api") != api || find(?set, "app") != app) { ret 2; }
    if (find(?set, "absent") != NO_BUDGET)                    { ret 3; }
    if (find(?set, "") != NO_BUDGET)                          { ret 4; }
    # the table is bounded, and defining past it fails rather than overwriting
    if (define(?set, "third", 1, 0, 0, 0) != NO_BUDGET) { ret 5; }
    if (set.count != 2)                                 { ret 6; }
    ret 0;
}

test "budget: a queue wider than the bound cannot admit more than the bound" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    # concurrency one, queue two: three charges may exist, one running and two
    # waiting, and never a fourth
    val index:   usize = define(?set, "api", 1, 2, 0, 0);
    var running: Charge;
    var first:   Charge;
    var second:  Charge;
    var refused: Charge;
    if (charge(?set, index, 0, at_time(0), ?running, hedge_wake.no_waker()) != ADMITTED) { ret 1; }
    if (charge(?set, index, 0, at_time(0), ?first, hedge_wake.no_waker()) != QUEUED)     { ret 2; }
    if (charge(?set, index, 0, at_time(0), ?second, hedge_wake.no_waker()) != QUEUED)    { ret 3; }
    if (charge(?set, index, 0, at_time(0), ?refused, hedge_wake.no_waker()) != REFUSED)  { ret 4; }
    if (snapshot(?set, index).waiting != 2)                                              { ret 5; }
    # releasing the runner promotes exactly one waiter, not both
    release(?set, ?running);
    if (retry(?set, ?first, at_time(0)) != ADMITTED) { ret 6; }
    if (retry(?set, ?second, at_time(0)) != QUEUED)  { ret 7; }
    if (snapshot(?set, index).active != 1 || snapshot(?set, index).waiting != 1) {
        ret 8;
    }
    ret 0;
}

test "budget: a failed release retains ownership for retry" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index: usize = define(?set, "api", 1, 0, 0, 0);
    var held:  Charge;
    if (charge(?set, index, 0, at_time(0), ?held, hedge_wake.no_waker()) != ADMITTED) { ret 1; }
    items[0].active = 0;
    if (release(?set, ?held) || !held.live) { ret 2; }
    items[0].active = 1;
    if (!release(?set, ?held) || held.live || items[0].active != 0) { ret 3; }
    ret 0;
}

test "budget: waiters are admitted in arrival order and each is woken" {
    var pages: A.Allocator;
    page.make(?pages);
    var wakes: hedge_wake.Queue;
    if (!hedge_wake.make(?wakes, ?pages)) { ret 1; }
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:   usize = define(?set, "app", 1, 2, 0, 0);
    var running: Charge;
    var first:   Charge;
    var second:  Charge;
    if (charge(?set, index, 0, at_time(0), ?running, hedge_wake.no_waker()) != ADMITTED)     { ret 2; }
    if (charge(?set, index, 0, at_time(0), ?first, hedge_wake.waker(?wakes, 11)) != QUEUED)  { ret 3; }
    if (charge(?set, index, 0, at_time(0), ?second, hedge_wake.waker(?wakes, 12)) != QUEUED) { ret 4; }
    if (hedge_wake.pending(?wakes))                                                          { ret 5; }
    var taken: [4]hedge_wake.Wake;
    if (!release(?set, ?running))                                           { ret 6; }
    if (first.outcome != ADMITTED || second.outcome != QUEUED)              { ret 7; }
    if (hedge_wake.take(?wakes, ?taken[0], 4) != 1 || taken[0].owner != 11) { ret 8; }
    if (!release(?set, ?first))                                             { ret 9; }
    if (second.outcome != ADMITTED)                                         { ret 10; }
    if (hedge_wake.take(?wakes, ?taken[0], 4) != 1 || taken[0].owner != 12) { ret 11; }
    if (!release(?set, ?second) || snapshot(?set, index).active != 0)       { ret 12; }
    hedge_wake.destroy(?wakes);
    ret 0;
}

test "budget: a small late charge waits behind a large early one" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:   usize = define(?set, "mem", 0, 2, 0, 100);
    var running: Charge;
    var large:   Charge;
    var small:   Charge;
    if (charge(?set, index, 60, at_time(0), ?running, hedge_wake.no_waker()) != ADMITTED) { ret 1; }
    if (charge(?set, index, 90, at_time(0), ?large, hedge_wake.no_waker()) != QUEUED)     { ret 2; }
    # there is room for it, but not ahead of the waiter already queued
    if (charge(?set, index, 10, at_time(0), ?small, hedge_wake.no_waker()) != QUEUED) { ret 3; }
    if (!release(?set, ?running))                                                     { ret 4; }
    if (large.outcome != ADMITTED || small.outcome != ADMITTED)                       { ret 5; }
    ret 0;
}

test "budget: an expiring head lets the waiters behind it in and wakes them" {
    var pages: A.Allocator;
    page.make(?pages);
    var wakes: hedge_wake.Queue;
    if (!hedge_wake.make(?wakes, ?pages)) { ret 1; }
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:   usize = define(?set, "mem", 0, 2, 1000000000, 100);
    var running: Charge;
    var large:   Charge;
    var small:   Charge;
    if (charge(?set, index, 60, at_time(0), ?running, hedge_wake.no_waker()) != ADMITTED)    { ret 2; }
    if (charge(?set, index, 90, at_time(0), ?large, hedge_wake.waker(?wakes, 21)) != QUEUED) { ret 3; }
    if (charge(?set, index, 10, at_time(0), ?small, hedge_wake.waker(?wakes, 22)) != QUEUED) { ret 4; }
    if (retry(?set, ?large, at_time(2)) != EXPIRED)                                          { ret 5; }
    if (small.outcome != ADMITTED)                                                           { ret 6; }
    var taken: [4]hedge_wake.Wake;
    if (hedge_wake.take(?wakes, ?taken[0], 4) != 1 || taken[0].owner != 22) { ret 7; }
    hedge_wake.destroy(?wakes);
    ret 0;
}

test "budget: a relocated waiter keeps its place and is still admitted" {
    var items: [1]Budget;
    var set:   Set;
    make(?set, ?items[0], 1);
    val index:   usize = define(?set, "app", 1, 3, 0, 0);
    var running: Charge;
    var first:   Charge;
    var middle:  Charge;
    var last:    Charge;
    var moved:   Charge;
    if (charge(?set, index, 0, at_time(0), ?running, hedge_wake.no_waker()) != ADMITTED) { ret 1; }
    if (charge(?set, index, 0, at_time(0), ?first, hedge_wake.no_waker()) != QUEUED)     { ret 2; }
    if (charge(?set, index, 0, at_time(0), ?middle, hedge_wake.no_waker()) != QUEUED)    { ret 3; }
    if (charge(?set, index, 0, at_time(0), ?last, hedge_wake.no_waker()) != QUEUED)      { ret 4; }
    relocate(?set, ?moved, ?middle);
    if (middle.live || !moved.live)                  { ret 5; }
    if (first.next != ?moved || last.prev != ?moved) { ret 6; }
    # the old storage owns nothing and cannot be released
    if (release(?set, ?middle))                                { ret 7; }
    if (!release(?set, ?running) || first.outcome != ADMITTED) { ret 8; }
    if (!release(?set, ?first) || moved.outcome != ADMITTED)   { ret 9; }
    if (!release(?set, ?moved) || last.outcome != ADMITTED)    { ret 10; }
    # moving the tail and the head keeps the ends right as well
    var tail: Charge;
    var head: Charge;
    var solo: Charge;
    if (charge(?set, index, 0, at_time(0), ?solo, hedge_wake.no_waker()) != QUEUED) { ret 11; }
    relocate(?set, ?tail, ?solo);
    if (set.items[0].head != ?tail || set.items[0].tail != ?tail) { ret 12; }
    relocate(?set, ?head, ?tail);
    if (set.items[0].head != ?head || set.items[0].tail != ?head) { ret 13; }
    if (!release(?set, ?head) || set.items[0].head != nil)        { ret 14; }
    ret 0;
}
